     338       double precision function ss (na, nb, la1, lb1, m1, ua, ub, r1, a
 0)
     339 !-----------------------------------------------
     340 !   M o d u l e s
     341 !-----------------------------------------------
     342       use overlaps_C, only : fact
     343 !-----------------------------------------------
     344 !   I n t e r f a c e   B l o c k s
     345 !-----------------------------------------------
     346       implicit none
     347 !-----------------------------------------------
     348 !   D u m m y   A r g u m e n t s
