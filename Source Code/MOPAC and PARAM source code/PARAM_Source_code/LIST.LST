       1       double precision function diagi (ialpha, ibeta, eiga, xy, nmos)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5 !**********************************************************************
 *
       6       implicit none
       7 !-----------------------------------------------
       8 !   G l o b a l   P a r a m e t e r s
       9 !-----------------------------------------------
      10 !-----------------------------------------------
      11 !   D u m m y   A r g u m e n t s
      12 !-----------------------------------------------
      13       integer , intent(in) :: nmos
      14       integer , intent(in) :: ialpha(nmos)
      15       integer , intent(in) :: ibeta(nmos)
      16       double precision , intent(in) :: eiga(*)
      17       double precision , intent(in) :: xy(nmos,nmos,nmos,nmos)
      18 !-----------------------------------------------
      19 !   L o c a l   P a r a m e t e r s
      20 !-----------------------------------------------
      21 !-----------------------------------------------
      22 !   L o c a l   V a r i a b l e s
      23 !-----------------------------------------------
      24       integer :: i, j
      25       double precision :: x
      26 !-----------------------------------------------
      27 !**********************************************************************
 *
      28 !
      29 !  CALCULATES THE ENERGY OF A MICROSTATE DEFINED BY IALPHA AND IBETA
      30 !
      31 !**********************************************************************
 *
      32       x = 0.0D0
      33       do i = 1, nmos
      34         if (ialpha(i) == 0) cycle
      35         x = x + eiga(i)
      36         do j = 1, nmos
      37           x = x + ((xy(i,i,j,j)-xy(i,j,i,j))*ialpha(j)*0.5D0+xy(i,i,j,j
 )*ibeta(&
      38             j))
      39         end do
      40       end do
      41       do i = 1, nmos
      42         if (ibeta(i) == 0) cycle
      43         x = x + eiga(i)
      44         do j = 1, i - 1
      45           x = x + (xy(i,i,j,j)-xy(i,j,i,j))*ibeta(j)
      46         end do
      47       end do
      48       diagi = x
      49       return
      50       end function diagi
 
