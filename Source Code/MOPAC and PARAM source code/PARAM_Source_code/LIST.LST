    1151 !   Do the hydrogen atom labels need to be re-done?
    1152 !  "Yes," if atoms are added or removed or shuffled.
    1153 !
    1154   if (index(keywrd," RESID") + index(keywrd," ADD-H") + &
    1155     index(keywrd," SITE=") + index(keywrd," RESEQ") /= 0 .or. output) t
 hen
    1156     H_Z = 1
    1157   else
    1158     H_Z = 0
    1159   end if
    1160   pdb = (index(keywrd, " PDBOUT") /= 0)
