      66      &          (1 - fracsi)*fracsj*f0(2, 1) + (1 - fracsi)*(1 - fracsj
 )*f0(2, 2)
      67             else
      68               gav = fracsi*f0(1, 1) + (1 - fracsi)*f0(2, 1)
