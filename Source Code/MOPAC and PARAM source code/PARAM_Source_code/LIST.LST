    2088   !
    2089     subroutine lnsrlb (n, l, u, nbd, x, f, fold, gd, gdold, g, d, r, t,
  z, &
    2090    & stp, dnorm, dtd, xstep, stpmx, iter, ifun, iback, nfgv, info, task
 , &
    2091    & boxed, cnstnd, csave, isave, dsave)
    2092     !
    2093       implicit none
    2094       double precision, parameter :: one = 1.0d0
    2095       double precision, parameter :: zero = 0.0d0
    2096       double precision, parameter :: big = 1.d-5
    2097       double precision, parameter :: ftol = 1.0d-3
    2098       double precision, parameter :: gtol = 0.9d0
