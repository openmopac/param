    1279 subroutine focd2z (iab, jba, fii, fjj, fij, pii, pjj, pij, wj, wk, &
    1280      & diagonal, kr)
    1281    !
    1282    !.. Implicit Declarations ..
    1283     implicit none
    1284    !
    1285    !.. Formal Arguments ..
    1286     logical, intent (in) :: diagonal
    1287     integer, intent (in) :: iab, jba
    1288     integer, intent (inout) :: kr
    1289     double precision, dimension ((iab*(iab+1))/2*(jba*(jba+1))/2), &
    1290          & intent (in) :: wj, wk
    1291     double precision, dimension ((iab*(iab+1))/2), intent (in) :: pii
    1292     double precision, dimension ((iab*(iab+1))/2), intent (inout) :: fi
 i
    1293     double precision, dimension ((jba*(jba+1))/2), intent (in) :: pjj
    1294     double precision, dimension ((jba*(jba+1))/2), intent (inout) :: fj
 j
    1295     double precision, dimension (iab*jba), intent (in) :: pij
    1296     double precision, dimension (iab*jba), intent (inout) :: fij
    1297 !.
    1298     integer :: i, ij, ik, il, j, jk, jl, k, ka, kc, kl, l, loop
    1299     double precision :: a, aa, bb
    1300    !*******************************************************************
 ****
    1301    !
    1302    ! FOCKD2 FORMS THE TWO-ELECTRON TWO-CENTER REPULSION PART OF THE FOC
 K
    1303    ! MATRIX
    1304    ! ON INPUT  PTOT = TOTAL DENSITY MATRIX.
    1305    !           P    = ALPHA OR BETA DENSITY MATRIX.
    1306    !           W    = TWO-ELECTRON INTEGRAL MATRIX.
    1307    !
    1308    !  ON OUTPUT F   = PARTIAL FOCK MATRIX
    1309    !*******************************************************************
 ****
    1310     loop = 0
    1311     do i = 1, iab
    1312       ka = (i*(i-1)) / 2
    1313       aa = 2.0d00
    1314       do j = 1, i
    1315         if (i == j) then
    1316           aa = 1.0d00
    1317         end if
    1318         ij = ka + j
    1319         do k = 1, jba
    1320           kc = (k*(k-1)) / 2
    1321           bb = 2.0d00
    1322           do l = 1, k
    1323             if (k == l) then
    1324               bb = 1.0d00
    1325             end if
    1326             kl = kc + l
    1327             loop = loop + 1
    1328             a = wj(loop)
    1329             fii(ij) = fii(ij) + bb * a * pjj(kl)
    1330             if ( .not. diagonal) then
    1331               fjj(kl) = fjj(kl) + aa * a * pii(ij)
 
 FORCHECK PC V13.5.13          FOCD2Z          2021-03-24 10:59:30   page:  4273
 fock2z.F90  /FF
 
    1332               a = wk(loop) * aa * bb * 0.125d0
    1333               ik = (i-1) * jba + k
    1334               il = (i-1) * jba + l
    1335               jk = (j-1) * jba + k
    1336               jl = (j-1) * jba + l
    1337               fij(ik) = fij(ik) - a * pij(jl)
    1338               fij(il) = fij(il) - a * pij(jk)
    1339               fij(jk) = fij(jk) - a * pij(il)
    1340               fij(jl) = fij(jl) - a * pij(ik)
    1341             end if
    1342           end do
    1343         end do
    1344       end do
    1345     end do
    1346     kr = kr + loop
    1347 end subroutine focd2z
 
