     568       subroutine elesn()
     569 !-----------------------------------------------
     570 !   M o d u l e s
     571 !-----------------------------------------------
     572       use molkst_C, only : numat, keywrd, nopen, fract, nclose
     573       use overlaps_C, only : allc, allz
     574       use parameters_C, only : tore, zs, zp
     575       use chanel_C, only : iesp, esp_fn
     576       use common_arrays_C, only : c, nat
     577       use esp_C, only : b_esp, ovl, fac, &
     578       & cespm2, esp_array, cesp, cespm, es, cespml, potpt, &
     579       & cc, dex, fv, ex, cen, iam, ind, temp, itemp, nesp, co, fc, indc
 , icd, &
     580       & npr, ncc, is_esp, ip, ipe, ipx, isc
     581       use funcon_C, only : a0
     582 !
     583       implicit none
     584 !
     585       integer :: j1, i, m, k, j, nqn, ipc,  in, l
     586       double precision :: norm
     587       double precision :: pi,  t, fval, sum, ra, rij
     588       logical :: potwrt, sto3g
     589       double precision, external :: dex2
     590       pi = 4.D0*atan(1.D0)
     591 !
     592 !     PUT STO-6G BASIS SET ON ATOM CENTERS
     593 !
     594       do i = -1, 10
     595         dex(i) = dex2(i)
     596       end do
     597       if (fac(4) > 1.D0) then
     598         fac(:7) = 1.D0/fac(:7)
     599       end if
     600       do m = 0, 8
     601         k = 1
     602         fv(m,1) = 1.D0/(2.D0*m + 1.D0)
     603         t = 0.D0
     604         do j1 = 1, int(41.D0/0.05D0)
     605           t = t + 0.05D0
     606           k = k + 1
     607           call fsub (m, t, fval)
     608           fv(m,k) = fval
     609         end do
     610         t = t + 0.05D0
     611       end do
     612 !
     613 !     LOAD BASIS FUNCTIONS INTO ARRAYS
     614 !
     615       sto3g = index(keywrd,'STO3G') /= 0
     616       if (sto3g) then
     617         icd = 3
     618         call setup3
     619       else
     620         icd = 6
     621         call setupg
     622       end if
     623       ncc = 0
     624       npr = 0
 
 FORCHECK PC V13.5.13          ELESN           2021-03-24 10:59:30   page:  3222
 esp.F90  /FF
 
     625       do i = 1, numat
     626         if (nat(i) <= 2) then
     627           cc(npr+1:icd+npr) = allc(:icd,1,1)
     628           ex(npr+1:icd+npr) = allz(:icd,1,1)*zs(1)**2
     629           cen(npr+1:icd+npr,1) = co(1,i)/a0
     630           cen(npr+1:icd+npr,2) = co(2,i)/a0
     631           cen(npr+1:icd+npr,3) = co(3,i)/a0
     632           iam(npr+1:icd+npr,1) = 0
     633           iam(npr+1:icd+npr,2) = 0
     634           fc(npr+1:icd+npr) = i
     635           ncc = ncc + 1
     636           npr = npr + icd
     637         else
     638 !        DETERMINE PRINCIPAL QUANTUM NUMBER(NQN)
     639 !        OF ORBITALS TO BE USED
     640 !
     641           nqn = 2
     642           if (nat(i)>10 .and. nat(i)<=18) nqn = 3
     643           if (nat(i)>18 .and. nat(i)<=36) nqn = 4
     644           if (nat(i)>36 .and. nat(i)<=54) nqn = 5
     645 !
     646           cc(npr+1:icd+npr) = allc(:icd,nqn,1)
     647           ex(npr+1:icd+npr) = allz(:icd,nqn,1)*zs(nat(i))**2
     648           cen(npr+1:icd+npr,1) = co(1,i)/a0
     649           cen(npr+1:icd+npr,2) = co(2,i)/a0
     650           cen(npr+1:icd+npr,3) = co(3,i)/a0
     651           iam(npr+1:icd+npr,1) = 0
     652           iam(npr+1:icd+npr,2) = 0
     653           ncc = ncc + 1
     654           npr = npr + icd
     655           do k = 1, 3
     656             cc(npr+1:icd+npr) = allc(:icd,nqn,2)
     657             ex(npr+1:icd+npr) = allz(:icd,nqn,2)*zp(nat(i))**2
     658             cen(npr+1:icd+npr,1) = co(1,i)/a0
     659             cen(npr+1:icd+npr,2) = co(2,i)/a0
     660             cen(npr+1:icd+npr,3) = co(3,i)/a0
     661             iam(npr+1:icd+npr,1) = 1
     662             iam(npr+1:icd+npr,2) = k
     663             ncc = ncc + 1
     664             npr = npr + icd
     665           end do
     666         end if
     667       end do
     668 !
     669 !     CALCULATE NORMALIZATION CONSTANTS AND INCLUDE
     670 !     THEM IN THE CONTRACTION COEFFICIENTS
     671 !
     672       do i = 1, npr
     673         norm = (2.D0*ex(i)/pi)**0.75D0*(4.D0*ex(i))**(iam(i,1)/2.D0)/sq
 rt(dex(2&
     674           *iam(i,1)-1))
     675         cc(i) = cc(i)*norm
     676       end do
     677 !
     678 !     PERFORM SORT OF PRIMITIVES BY ANGULAR MOMENTUM
     679 !
     680       is_esp = 0
     681       isc = 0
     682       j = 0
 
 FORCHECK PC V13.5.13          ELESN           2021-03-24 10:59:30   page:  3223
 esp.F90  /FF
 
     683       do i = 1, npr
     684         if (iam(i,1) /= 0) cycle
     685         is_esp = is_esp + 1
     686         ind(is_esp) = i
     687       end do
     688       ip = is_esp
     689       do i = 1, npr
     690         if (iam(i,1)/=1 .or. iam(i,2)/=1) cycle
     691         ip = ip + 1
     692         ind(ip) = i
     693       end do
     694       do i = 1, npr
     695         if (iam(i,1)/=1 .or. iam(i,2)/=2) cycle
     696         ip = ip + 1
     697         ind(ip) = i
     698       end do
     699       do i = 1, npr
     700         if (iam(i,1)/=1 .or. iam(i,2)/=3) cycle
     701         ip = ip + 1
     702         ind(ip) = i
     703       end do
     704       do i = 1, ncc
     705         in = i*icd - icd + 1
     706         if (iam(in,1) /= 0) cycle
     707         isc = isc + 1
     708         indc(isc) = i
     709       end do
     710       ipc = isc
     711       do i = 1, ncc
     712         in = i*icd - icd + 1
     713         if (iam(in,1)/=1 .or. iam(in,2)/=1) cycle
     714         ipc = ipc + 1
     715         indc(ipc) = i
     716       end do
     717       do i = 1, ncc
     718         in = i*icd - icd + 1
     719         if (iam(in,1)/=1 .or. iam(in,2)/=2) cycle
     720         ipc = ipc + 1
     721         indc(ipc) = i
     722       end do
     723       do i = 1, ncc
     724         in = i*icd - icd + 1
     725         if (iam(in,1)/=1 .or. iam(in,2)/=3) cycle
     726         ipc = ipc + 1
     727         indc(ipc) = i
     728       end do
     729       temp(:npr) = cc(ind(:npr))
     730       cc(:npr) = temp(:npr)
     731       temp(:npr) = ex(ind(:npr))
     732       ex(:npr) = temp(:npr)
     733       temp(:npr) = cen(ind(:npr),1)
     734       cen(:npr,1) = temp(:npr)
     735       temp(:npr) = cen(ind(:npr),2)
     736       cen(:npr,2) = temp(:npr)
     737       temp(:npr) = cen(ind(:npr),3)
     738       cen(:npr,3) = temp(:npr)
     739       itemp(:npr) = iam(ind(:npr),1)
     740       iam(:npr,1) = itemp(:npr)
     741       itemp(:npr) = iam(ind(:npr),2)
 
 FORCHECK PC V13.5.13          ELESN           2021-03-24 10:59:30   page:  3224
 esp.F90  /FF
 
     742       iam(:npr,2) = itemp(:npr)
     743 !     CALCULATE OVERLAP MATRIX OF STO-6G FUNCTIONS
     744 !
     745       do j = 1, ncc
     746         call ovlp (j)
     747       end do
     748 !
     749       do j = 1, ncc
     750         do k = 1, ncc
     751           cespm2(indc(j),indc(k)) = ovl(j,k)
     752         end do
     753       end do
     754       ovl(:ncc,:ncc) = cespm2(:ncc,:ncc)
     755       l = 0
     756       do i = 1, ncc
     757         if (i > 0) then
     758           cesp(l+1:i+l) = ovl(i,:i)
     759           l = i + l
     760         end if
     761       end do
     762 !
     763 !     DEORTHOGONALIZE THE COEFFICIENTS AND REFORM THE DENSITY MATRIX
     764 !
     765       call rsp (cesp, ncc, temp, cespml)
     766       do i = 1, ncc ! TODO: to be parallelized
     767         do j = 1, i
     768           sum = 0.D0
     769           do k = 1, ncc
     770             sum = sum + cespml(i+(k-1)*ncc)/dsqrt(temp(k))*cespml(j+(k-
 1)*ncc)
     771             cesp(i+(j-1)*ncc) = sum
     772             cesp(j+(i-1)*ncc) = sum
     773           end do
     774         end do
     775       end do
     776       call mult (c, cesp, cespml, ncc)
     777       call densit (cespml, ncc, ncc, nclose, 2.d0, nopen, fract, cesp,
 2)
     778
     779
     780 !
     781 !     NOW CALCULATE THE ELECTRONIC CONTRIBUTION TO THE ELECTROSTATIC PO
 T
     782 !
     783       l = 0
     784       do i = 1, ncc ! TODO: to be parallelized
     785         do j = 1, i
     786           l = l + 1
     787           cespm(i,j) = cesp(l)
     788           cespm(j,i) = cesp(l)
     789         end do
     790       end do
     791       ipx = (npr - is_esp)/3
     792       ipe = is_esp + ipx
     793       es(:nesp) = 0.D0
     794       call naicas () !TODO: to be parallelized
     795       call naicap () !TODO: to be parallelized
     796 !     CALCULATE TOTAL ESP AND FORM ARRAYS FOR ESPFIT
     797       b_esp = 0.d0
 
 FORCHECK PC V13.5.13          ELESN           2021-03-24 10:59:30   page:  3225
 esp.F90  /FF
 
     798       do i = 1, nesp
     799         esp_array(i) = 0.D0
     800         do j = 1, numat
     801           ra = sqrt((co(1,j)-potpt(1,i))**2+(co(2,j)-potpt(2,i))**2+(co
 (3,j) - potpt(3,i))**2)
     802           esp_array(i) = esp_array(i) + tore(nat(j))/(ra/a0)
     803         end do
     804         esp_array(i) = esp_array(i) - es(i)
     805         do j = 1, numat
     806           rij = sqrt((co(1,j)-potpt(1,i))**2+(co(2,j)-potpt(2,i))**2+(c
 o(3,j) - potpt(3,i))**2)/a0
     807           b_esp(j) = b_esp(j) + esp_array(i)*1.D0/rij
     808         end do
     809       end do
     810 !
     811 !     IF REQUESTED WRITE OUT ELECTRIC POTENTIAL DATA TO
     812 !     UNIT 21
     813 !
     814       potwrt = index(keywrd,'POTWRT') /= 0
     815       if (potwrt) then
     816         open(iesp, file=esp_fn, status='UNKNOWN', position='asis')
     817         write (iesp, '(I5)') nesp
     818         do i = 1, nesp
     819           write (iesp, 420) esp_array(i), potpt(1,i)/a0, potpt(2,i)/a0,
  potpt(3,i)/a0
     820         end do
     821         close(unit=iesp, status='KEEP')
     822       end if
     823   420 format(1x,4e16.7)
     824       return
     825       end subroutine elesn
 
