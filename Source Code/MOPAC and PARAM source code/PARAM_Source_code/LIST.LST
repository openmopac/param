       1       subroutine deri22(c, b, work, foc2, ab, minear, fci, w, diag, &
       2         scalar, ninear)
       3 !-----------------------------------------------
       4 !   M o d u l e s
       5 !-----------------------------------------------
       6       USE molkst_C, only : nopen, numat, norbs, n2elec
       7       use common_arrays_C, only : nfirst, nlast
       8       use meci_C, only : nmos, nbo, nelec
       9       implicit none
      10       integer , intent(in) :: minear
      11       integer , intent(in) :: ninear
      12       double precision :: c(norbs,norbs), work(norbs,norbs), foc2(norbs
 **2)
      13       double precision, allocatable  :: dp(:), dpa(:)
      14       double precision  :: b(minear)
      15       double precision  :: ab(minear)
      16       double precision  :: fci(ninear)
      17       double precision  :: w(n2elec)
      18       double precision , intent(in) :: diag(*)
      19       double precision , intent(in) :: scalar(*)
      20 !
      21       integer :: i, l, j, nend, loop, ninit, n1, n2, icount, ncol
      22       double precision :: wj(1) = 0.d0, wk(1) = 0.d0  ! Dummys - wj and
  wk are used by solids only.
      23       double precision, external :: ddot, dot
      24 !**********************************************************************
 *
      25 !  1) BUILD THE 2-ELECTRON FOCK MATRIX DEPENDING ON B AS FOLLOWS :
      26 !     DP = C * SCALE*B * C' ...  DP DENSITY MATRIX 'DERIVATIVE',
      27 !     FOC2 = 0.5 * TRACE ( DP * (2<J>-<K>) ) DONE IN FOCK2 & FOCK1.
      28 !  2) HALF-TRANSFORM ONTO M.O. BASIS : DPT =  FOC2 * C
      29 !     AND COMPUTE DIAGONAL BLOCKS ELEMENTS OF C' * FOC2, EXTRACTING
      30 !     IN FCI ELEMENTS OVER C.I-ACTIVE M.O ONLY.
      31 !  3) COMPUTE SUPERVECTOR AB = (DIAG + A) * B DEFINED BY THE MATRIX :
      32 !     AB(I,J)= ( DIAG(I,J)*B(I,J)+DPT(I,J) )*SCALAR(I,J)  WITH I.GT.J,
      33 !     DIAG(I,J)=(EIGS(I)-EIGS(J))/(O(J)-O(I)) >0, O OCCUPANCY NUMBERS,
      34 !     EIGS EIGENVALUES OF FOCK OPERATOR WITH EIGENVECTORS C IN A.O.
      35 !
      36 !   INPUT
      37 ! C(NORBS,NORBS)   : M.O. EIGENVECTORS (COLUMNWISE).
      38 ! B(*)             : B SUPERVECTOR PACKED BY OFF-DIAGONAL BLOCKS, SCALE
 D
      39 ! WORK(*)          : WORK AREA OF SIZE N*N.
      40 ! NORBS            : NUMBER OF M.O.S
      41 ! NELEC,NMOS       : LAST FROZEN CORE M.O. , C.I-ACTIVE BAND LENGTH.
      42 !           IN COMMON
      43 ! DIAG,SCALAR AS DEFINED IN 'DERI0'.
      44 !   OUTPUT
      45 ! FOC2(*)       : 2-ELECTRON FOCK MATRIX, PACKED CANONICAL.
      46 ! AB(*)         : ANTISYMMETRIC MATRIX PACKED IN SUPERVECTOR FORM WITH
      47 !                 THE CONSECUTIVE FOLLOWING BLOCKS:
      48 !              1) OPEN-CLOSED  I.E. B(IJ)=B(I,J) WITH I OPEN & J CLOSED
      49 !                 AND I RUNNING FASTER THAN J,
      50 !              2) VIRTUAL-CLOSED SAME RULE OF ORDERING,
      51 !              3) VIRTUAL-OPEN   SAME RULE OF ORDERING.
      52 ! FCI(*)        : FOCK DIAGONAL BLOCKS ELEMENTS OVER C.I-ACTIVE M.O.
      53 !            FOC2 CAN BE EQUIVALENCED WITH WORK IN THE CALLING SEQUENCE
 .
 
 FORCHECK PC V13.5.13          DERI22          2021-03-24 10:59:30   page:  1981
 deri22.F90  /FF
 
      54 !**********************************************************************
 *
      55 !
      56 !  NOTE: NORBS AND NORD ARE THE SAME ADDRESS.  THE NAME NORBD IS NOT
      57 !        USED HERE.
      58 !
      59 !
      60 !     DERIVATIVE OF THE DENSITY MATRIX IN DP (PACKED,CANONICAL).
      61 !     ----------------------------------------------------------
      62 !     DP = C * B * C' .
      63 !
      64 !     STEP 0 : UNSCALE VECTOR B.
      65       n2 = 0
      66       allocate (dp(norbs**2), dpa(norbs**2), stat=i)
      67       if (i /= 0) then
      68         call memory_error ("deri22")
      69         return
      70       end if
      71       b = b*scalar(:minear)
      72 !
      73 !     STEP 1 : WORK = C * B    .  DP TEMPORARY ARRAY.
      74       l = 1
      75       if (nbo(2)/=0 .and. nbo(1)/=0) then
      76 !        OPEN-CLOSED
      77         call mxm (c(1,nbo(1)+1), norbs, b(l), nbo(2), work, nbo(1))
      78 !       CLOSED-OPEN
      79         call mxmt (c, norbs, b(l), nbo(1), work(1,nbo(1)+1), nbo(2))
      80         l = l + nbo(2)*nbo(1)
      81       end if
      82       if (nbo(3)/=0 .and. nbo(1)/=0) then
      83 !       VIRTUAL-CLOSED
      84         if (l > 1) then
      85           call mxm (c(1,nopen+1), norbs, b(l), nbo(3), dp, nbo(1))
      86           icount = 0
      87         do j = 1, nbo(1)
      88           do i = 1, norbs
      89             icount = icount + 1
      90             work(i, j) = work(i, j) + dp(icount)
      91           end do
      92         end do
      93         else
      94           call mxm (c(1,nopen+1), norbs, b(l), nbo(3), work, nbo(1))
      95         end if
      96 !       CLOSED-VIRTUAL
      97         call mxmt (c, norbs, b(l), nbo(1), work(1,nopen+1), nbo(3))
      98         l = l + nbo(3)*nbo(1)
      99       end if
     100       if (nbo(3)/=0 .and. nbo(2)/=0) then
     101 !       VIRTUAL-OPEN
     102         call mxm (c(1,nopen+1), norbs, b(l), nbo(3), dp, nbo(2))
     103          icount = 0
     104       do j = nbo(1) + 1, nbo(1) + nbo(2)
     105         do i = 1, norbs
     106           icount = icount + 1
     107           work(i, j) = work(i, j) + dp(icount)
     108         end do
     109       end do
     110 !       OPEN-VIRTUAL
     111         call mxmt (c(1,nbo(1)+1), norbs, b(l), nbo(2), dp, nbo(3))
 
 FORCHECK PC V13.5.13          DERI22          2021-03-24 10:59:30   page:  1982
 deri22.F90  /FF
 
     112      icount = 0
     113       do j = nopen + 1, nopen + nbo(3)
     114         do i = 1, norbs
     115           icount = icount + 1
     116           work(i, j) = work(i, j) + dp(icount)
     117         end do
     118       end do
     119       end if
     120 !
     121 !     STEP 2 : DP= WORK * C'   WITH DP PACKED,CANONICAL.
     122       l = 0
     123       do i = 1, norbs
     124         do j = 1, i
     125           l = l + 1
     126           dp(l) = ddot(norbs,work(i,1),norbs,c(j,1),norbs)
     127         end do
     128       end do
     129 !
     130 !     2-ELECTRON FOCK MATRIX BUILD WITH THE DENSITY MATRIX DERIVATIVE.
     131 !     ----------------------------------------------------------------
     132 !     RETURNED IN FOC2 (PACKED CANONICAL).
     133       foc2 = 0.D0
     134       dpa(:l) = 0.5D0*dp(:l)
     135         call fock2 (foc2, dp, dpa, w, wj, wk, numat, nfirst, nlast, 2)
     136 !
     137 !     BUILD DP AND EXTRACT FCI.
     138 !     --------------------------
     139 !
     140 !     DP(NORBS,NEND) = FOC2(NORBS,NORBS) * C(NORBS,NEND).
     141       nend = max(nopen,nelec + nmos)
     142       l = 1
     143       do i = 1, nend
     144         call supdot (dp(l), foc2, c(1,i), norbs)
     145         l = l + norbs
     146       end do
     147 !     EXTRACT FCI
     148       l = 1
     149       nend = 0
     150       do loop = 1, 3
     151         ninit = nend + 1
     152         nend = nend + nbo(loop)
     153         n1 = max(ninit,nelec + 1)
     154         n2 = min(nend,nelec + nmos)
     155         if (n2 < n1) cycle
     156         do i = n1, n2
     157           if (i <= ninit) cycle
     158           ! TODO: GBR future modifications
     159           call mxm (c(1,i), 1, dp(norbs*(ninit-1)+1), norbs, fci(l), i
 - ninit)
     160           l = l + i - ninit
     161         end do
     162       end do
     163       ncol = n2 - ninit + 1
     164       if (ncol > 0 .and. n2 < norbs) then
     165         ! TODO: GBR future modifications
     166         call mtxm (c(1, n2+1), norbs-n2, dp(norbs*(ninit-1)+1), norbs,
 fci(l), ncol)
     167         l = l + ncol * (norbs-n2)
     168       end if
 
 FORCHECK PC V13.5.13          DERI22          2021-03-24 10:59:30   page:  1983
 deri22.F90  /FF
 
     169       do i = nelec + 1, nelec + nmos
     170         fci(l) = -dot(c(1,i),dp(norbs*(i-1)+1),norbs)
     171         l = l + 1
     172       end do
     173 !
     174 !     NEW SUPERVECTOR AB = (DIAG + C'* FOC2 * C) * B , SCALED.
     175 !     --------------------------------------------------------
     176 !
     177 !     PART 1 : AB(I,J) = (C' * DP)(I,J) DONE BY BLOCKS.
     178       l = 1
     179       if (nbo(2)/=0 .and. nbo(1)/=0) then
     180         ! TODO: GBR future modifications
     181         call mtxm (c(1,nbo(1)+1), nbo(2), dp, norbs, ab(l), nbo(1))
     182         l = l + nbo(2)*nbo(1)
     183       end if
     184       if (nbo(3)/=0 .and. nbo(1)/=0) then
     185         call mtxm (c(1,nopen+1), nbo(3), dp, norbs, ab(l), nbo(1))
     186         l = l + nbo(3)*nbo(1)
     187       end if
     188       if (nbo(3)/=0 .and. nbo(2)/=0) call mtxm (c(1,nopen+1), nbo(3), &
     189         dp(norbs*nbo(1)+1), norbs, ab(l), nbo(2))
     190 !
     191 !     PART 2 : AB = SCALE * (D * B + AB) AND RESCALE BASIS VECTOR B.
     192 !
     193       ab = (diag(:minear)*b+ab)*scalar(:minear)
     194       b = b/scalar(:minear)
     195       return
     196       end subroutine deri22
 
