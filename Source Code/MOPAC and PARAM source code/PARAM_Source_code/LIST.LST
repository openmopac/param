    1945         i = len_trim(line)
    1946         write(line(i + 1:),'(4x, a, f4.2, a)') num(1:3)//residue_name(j
 )(7:)//"(", min(sum1,9.99d0),")"
    1947         if (mod(k,5) == 0) then
    1948           write(iw,'(a)') trim(line)
    1949           line = " "
    1950         end if
    1951       end do
    1952     end if
    1953     deallocate (move, residue_motion, residue_name)
    1954     return
    1955   end subroutine geo_diff
 
