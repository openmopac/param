 ci.F90  /FF
 
     218               aa = c(i, mu + k3) * c(b, mu + k1) * gk
     219               k12 = k12 + c(a, mu + k4) * c(j, mu + k2) * aa
     220               j12 = j12 + c(a, mu + k2) * c(j, mu + k4) * aa
     221
     222 !             **** terms (k4, k3|k2, k1) ****
     223               aa = c(i, mu + k4) * c(b, mu + k1) * gk
     224               k12 = k12 + c(a, mu + k3) * c(j, mu + k2) * aa
     225               j12 = j12 + c(a, mu + k2) * c(j, mu + k3) * aa
     226             end if
     227
     228           end do
     229         end if
     230       end do
     231
     232 !     **** store matrix elements ****
     233
     234       if (ifstor == 1) then
     235         ee2(nmc) = sngl (j12)
     236         ee2(nme) = sngl (k12)
     237         j12 = ee2(nmc)
     238         k12 = ee2(nme)
     239       end if
     240
     241       return
     242       end
 
