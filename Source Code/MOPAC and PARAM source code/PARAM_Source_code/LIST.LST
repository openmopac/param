    1053       subroutine sqrsl(x, ldx, n, k, qraux, y, qy, qty, b, rsd, xb, job
 , info)
    1054 !-----------------------------------------------
    1055 !   I n t e r f a c e   B l o c k s
    1056 !-----------------------------------------------
    1057       implicit none
    1058 !-----------------------------------------------
    1059 !   D u m m y   A r g u m e n t s
    1060 !-----------------------------------------------
    1061       integer , intent(in) :: ldx
    1062       integer  :: n
    1063       integer  :: k
    1064       integer , intent(in) :: job
    1065       integer , intent(out) :: info
    1066       real  :: x(ldx,ldx)
    1067       real , intent(in) :: qraux(ldx)
    1068       real  :: y(ldx)
    1069       real  :: qy(ldx)
    1070       real  :: qty(ldx)
    1071       real  :: b(ldx)
    1072       real  :: rsd(ldx)
    1073       real  :: xb(ldx)
    1074 !-----------------------------------------------
    1075 !   L o c a l   V a r i a b l e s
    1076 !-----------------------------------------------
    1077       integer :: j, jj, ju, kp1
    1078       real :: t, temp
    1079       logical :: cb, cqy, cqty, cr, cxb
    1080       real , external :: sdot
    1081 !-----------------------------------------------
    1082 !
    1083 !     SQRSL APPLIES THE OUTPUT OF SQRDC TO COMPUTE COORDINATE
    1084 !     TRANSFORMATIONS, PROJECTIONS, AND LEAST SQUARES SOLUTIONS.
    1085 !     FOR K .LE. MIN(N,P), LET XK BE THE MATRIX
    1086 !
    1087 !            XK = (X(JPVT(1)),X(JPVT(2)), ... ,X(JPVT(K)))
    1088 !
    1089 !     FORMED FROM COLUMNNS JPVT(1), ... ,JPVT(K) OF THE ORIGINAL
    1090 !     N X P MATRIX X THAT WAS INPUT TO SQRDC (IF NO PIVOTING WAS
    1091 !     DONE, XK CONSISTS OF THE FIRST K COLUMNS OF X IN THEIR
    1092 !     ORIGINAL ORDER).  SQRDC PRODUCES A FACTORED ORTHOGONAL MATRIX Q
    1093 !     AND AN UPPER TRIANGULAR MATRIX R SUCH THAT
    1094 !
    1095 !              XK = Q * (R)
    1096 !                       (0)
    1097 !
    1098 !     THIS INFORMATION IS CONTAINED IN CODED FORM IN THE ARRAYS
    1099 !     X AND QRAUX.
    1100 !
    1101 !     ON ENTRY
    1102 !
    1103 !        X      REAL(LDX,P).
    1104 !               X CONTAINS THE OUTPUT OF SQRDC.
    1105 !
    1106 !        LDX    INTEGER.
    1107 !               LDX IS THE LEADING DIMENSION OF THE ARRAY X.
    1108 !
    1109 !        N      INTEGER.
 
 FORCHECK PC V13.5.13          SQRSL           2021-03-24 10:59:30   page:  1941
 esp_utilities.F90  /FF
 
    1110 !               N IS THE NUMBER OF ROWS OF THE MATRIX XK.  IT MUST
    1111 !               HAVE THE SAME VALUE AS N IN SQRDC.
    1112 !
    1113 !        K      INTEGER.
    1114 !               K IS THE NUMBER OF COLUMNS OF THE MATRIX XK.  K
    1115 !               MUST NNOT BE GREATER THAN MIN(N,P), WHERE P IS THE
    1116 !               SAME AS IN THE CALLING SEQUENCE TO SQRDC.
    1117 !
    1118 !        QRAUX  REAL(P).
    1119 !               QRAUX CONTAINS THE AUXILIARY OUTPUT FROM SQRDC.
    1120 !
    1121 !        Y      REAL(N)
    1122 !               Y CONTAINS AN N-VECTOR THAT IS TO BE MANIPULATED
    1123 !               BY SQRSL.
    1124 !
    1125 !        JOB    INTEGER.
    1126 !               JOB SPECIFIES WHAT IS TO BE COMPUTED.  JOB HAS
    1127 !               THE DECIMAL EXPANSION ABCDE, WITH THE FOLLOWING
    1128 !               MEANING.
    1129 !
    1130 !                    IF A.NE.0, COMPUTE QY.
    1131 !                    IF B,C,D, OR E .NE. 0, COMPUTE QTY.
    1132 !                    IF C.NE.0, COMPUTE B.
    1133 !                    IF D.NE.0, COMPUTE RSD.
    1134 !                    IF E.NE.0, COMPUTE XB.
    1135 !
    1136 !               NOTE THAT A REQUEST TO COMPUTE B, RSD, OR XB
    1137 !               AUTOMATICALLY TRIGGERS THE COMPUTATION OF QTY, FOR
    1138 !               WHICH AN ARRAY MUST BE PROVIDED IN THE CALLING
    1139 !               SEQUENCE.
    1140 !
    1141 !     ON RETURN
    1142 !
    1143 !        QY     REAL(N).
    1144 !               QY CONNTAINS Q*Y, IF ITS COMPUTATION HAS BEEN
    1145 !               REQUESTED.
    1146 !
    1147 !        QTY    REAL(N).
    1148 !               QTY CONTAINS TRANS(Q)*Y, IF ITS COMPUTATION HAS
    1149 !               BEEN REQUESTED.  HERE TRANS(Q) IS THE
    1150 !               TRANSPOSE OF THE MATRIX Q.
    1151 !
    1152 !        B      REAL(K)
    1153 !               B CONTAINS THE SOLUTION OF THE LEAST SQUARES PROBLEM
    1154 !
    1155 !                    MINIMIZE NORM2(Y - XK*B),
    1156 !
    1157 !               IF ITS COMPUTATION HAS BEEN REQUESTED.  (NOTE THAT
    1158 !               IF PIVOTING WAS REQUESTED IN SQRDC, THE J-TH
    1159 !               COMPONENT OF B WILL BE ASSOCIATED WITH COLUMN JPVT(J)
    1160 !               OF THE ORIGINAL MATRIX X THAT WAS INPUT INTO SQRDC.)
    1161 !
    1162 !        RSD    REAL(N).
    1163 !               RSD CONTAINS THE LEAST SQUARES RESIDUAL Y - XK*B,
    1164 !               IF ITS COMPUTATION HAS BEEN REQUESTED.  RSD IS
    1165 !               ALSO THE ORTHOGONAL PROJECTION OF Y ONTO THE
    1166 !               ORTHOGONAL COMPLEMENT OF THE COLUMN SPACE OF XK.
    1167 !
    1168 !        XB     REAL(N).
 
 FORCHECK PC V13.5.13          SQRSL           2021-03-24 10:59:30   page:  1942
 esp_utilities.F90  /FF
 
    1169 !               XB CONTAINS THE LEAST SQUARES APPROXIMATION XK*B,
    1170 !               IF ITS COMPUTATION HAS BEEN REQUESTED.  XB IS ALSO
    1171 !               THE ORTHOGONAL PROJECTION OF Y ONTO THE COLUMN SPACE
    1172 !               OF X.
    1173 !
    1174 !        INFO   INTEGER.
    1175 !               INFO IS ZERO UNLESS THE COMPUTATION OF B HAS
    1176 !               BEEN REQUESTED AND R IS EXACTLY SINGULAR.  IN
    1177 !               THIS CASE, INFO IS THE INDEX OF THE FIRST ZERO
    1178 !               DIAGONAL ELEMENT OF R AND B IS LEFT UNALTERED.
    1179 !
    1180 !     THE PARAMETERS QY, QTY, B, RSD, AND XB ARE NOT REFERENCED
    1181 !     IF THEIR COMPUTATION IS NOT REQUESTED AND IN THIS CASE
    1182 !     CAN BE REPLACED BY DUMMY VARIABLES IN THE CALLING PROGRAM.
    1183 !     TO SAVE STORAGE, THE USER MAY IN SOME CASES USE THE SAME
    1184 !     ARRAY FOR DIFFERENT PARAMETERS IN THE CALLING SEQUENCE.  A
    1185 !     FREQUENTLY OCCURING EXAMPLE IS WHEN ONE WISHES TO COMPUTE
    1186 !     ANY OF B, RSD, OR XB AND DOES NOT NEED Y OR QTY.  IN THIS
    1187 !     CASE ONE MAY IDENTIFY Y, QTY, AND ONE OF B, RSD, OR XB, WHILE
    1188 !     PROVIDING SEPARATE ARRAYS FOR ANYTHING ELSE THAT IS TO BE
    1189 !     COMPUTED.  THUS THE CALLING SEQUENCE
    1190 !
    1191 !          CALL SQRSL(X,LDX,N,K,QRAUX,Y,DUM,Y,B,Y,DUM,110,INFO)
    1192 !
    1193 !     WILL RESULT IN THE COMPUTATION OF B AND RSD, WITH RSD
    1194 !     OVERWRITING Y.  MORE GENERALLY, EACH ITEM IN THE FOLLOWING
    1195 !     LIST CONTAINS GROUPS OF PERMISSIBLE IDENTIFICATIONS FOR
    1196 !     A SINGLE CALLINNG SEQUENCE.
    1197 !
    1198 !          1. (Y,QTY,B) (RSD) (XB) (QY)
    1199 !
    1200 !          2. (Y,QTY,RSD) (B) (XB) (QY)
    1201 !
    1202 !          3. (Y,QTY,XB) (B) (RSD) (QY)
    1203 !
    1204 !          4. (Y,QY) (QTY,B) (RSD) (XB)
    1205 !
    1206 !          5. (Y,QY) (QTY,RSD) (B) (XB)
    1207 !
    1208 !          6. (Y,QY) (QTY,XB) (B) (RSD)
    1209 !
    1210 !     IN ANY GROUP THE VALUE RETURNED IN THE ARRAY ALLOCATED TO
    1211 !     THE GROUP CORRESPONDS TO THE LAST MEMBER OF THE GROUP.
    1212 !
    1213 !     LINPACK. THIS VERSION DATED 08/14/78 .
    1214 !     G.W. STEWART, UNIVERSITY OF MARYLAND, ARGONNE NATIONAL LAB.
    1215 !
    1216 !     SQRSL USES THE FOLLOWING FUNCTIONS AND SUBPROGRAMS.
    1217 !
    1218 !     BLAS SAXPY,SCOPY,SDOT
    1219 !     FORTRAN ABS,MIN0,MOD
    1220 !
    1221 !     INTERNAL VARIABLES
    1222 !
    1223 !
    1224 !
    1225 !     SET INFO FLAG.
    1226 !
    1227       info = 0
 
 FORCHECK PC V13.5.13          SQRSL           2021-03-24 10:59:30   page:  1943
 esp_utilities.F90  /FF
 
    1228 !
    1229 !     DETERMINE WHAT IS TO BE COMPUTED.
    1230 !
    1231       cqy = job/10000 /= 0
    1232       cqty = mod(job,10000) /= 0
    1233       cb = mod(job,1000)/100 /= 0
    1234       cr = mod(job,100)/10 /= 0
    1235       cxb = mod(job,10) /= 0
    1236       ju = min0(k,n - 1)
    1237 !
    1238 !     SPECIAL ACTION WHEN N=1.
    1239 !
    1240       if (ju == 0) then
    1241         if (cqy) qy(1) = y(1)
    1242         if (cqty) qty(1) = y(1)
    1243         if (cxb) xb(1) = y(1)
    1244         if (cb) then
    1245           if (x(1,1) == 0.0E0) then
    1246             info = 1
    1247           else
    1248             b(1) = y(1)/x(1,1)
    1249           end if
    1250         end if
    1251         if (cr) rsd(1) = 0.0E0
    1252       else
    1253         if (cqy) call scopy (n, y, 1, qy, 1)
    1254         if (cqty) call scopy (n, y, 1, qty, 1)
    1255         if (cqy) then
    1256 !
    1257 !           COMPUTE QY.
    1258 !
    1259           do jj = 1, ju
    1260             j = ju - jj + 1
    1261             if (qraux(j) == 0.0E0) cycle
    1262             temp = x(j,j)
    1263             x(j,j) = qraux(j)
    1264             t = -sdot(n - j + 1,x(j,j),1,qy(j),1)/x(j,j)
    1265             call saxpy (n - j + 1, t, x(j,j), 1, qy(j), 1)
    1266             x(j,j) = temp
    1267           end do
    1268         end if
    1269         if (cqty) then
    1270 !
    1271 !           COMPUTE TRANS(Q)*Y.
    1272 !
    1273           do j = 1, ju
    1274             if (qraux(j) == 0.0E0) cycle
    1275             temp = x(j,j)
    1276             x(j,j) = qraux(j)
    1277             t = -sdot(n - j + 1,x(j,j),1,qty(j),1)/x(j,j)
    1278             call saxpy (n - j + 1, t, x(j,j), 1, qty(j), 1)
    1279             x(j,j) = temp
    1280           end do
    1281         end if
    1282         if (cb) call scopy (k, qty, 1, b, 1)
    1283         kp1 = k + 1
    1284         if (cxb) call scopy (k, qty, 1, xb, 1)
    1285         if (cr .and. k<n) call scopy (n - k, qty(kp1), 1, rsd(kp1), 1)
    1286         if (.not.(.not.cxb .or. kp1>n)) then
 
