      60         if (index(keywrd,'RESTAR') /= 0) then
      61             open(unit=ires, file=restart_fn, status='UNKNOWN', &
      62                   & form='UNFORMATTED', position='asis')
      63             rewind ires
      64             read (ires, end=120, err=120) i, j
      65             if (norbs /= j .or. numat /= i) then
      66                 call mopend("Restart file read in does not match curren
 t data set")
      67                 goto 99
      68             end if
