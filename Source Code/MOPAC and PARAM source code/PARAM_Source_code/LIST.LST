     178 double precision function trunk (r)
     179 !
     180 !  In solids, change the apparent distance so that the Madelung sum can
  be
     181 !  solved.
     182 !
     183 !   r: Distance in Angstroms
     184 !
     185     use molkst_C, only: numcal, clower, cutofp, cupper
     186     implicit none
     187     double precision, intent (in) :: r
     188     integer, save :: icalcn = 0
     189     double precision, save :: bound1, bound2, c, clim, cr, cr2, range
     190     if (icalcn /= numcal) then
     191       bound1 = clower / cutofp
     192       !
     193       !   CUPPER = upper bound of truncation function, as a function of
  CUTOFP
     194       !
     195       cupper = cutofp + 0
     196       bound2 = cupper / cutofp
     197       range = bound2 - bound1
     198       !
     199       !   Truncation function = C+CR*R+CR2*R**2
     200       !
     201       c = -0.5d0 * bound1 ** 2 * cutofp / range
     202       cr = 1.0d0 + bound1 / range
     203       cr2 = -1 / (cutofp*2*range)
     204       !
     205       !   Above CUPPER function = constant
     206       !
     207       clim = c + cr * cupper + cr2 * cupper ** 2
     208       icalcn = numcal
     209     end if
     210    !
     211    !  Need a smooth function in the region of CUTOFP
     212    !
     213    !  Function has form:
     214    !    Up to CLOWER  R=R
     215    !    At CLOWER,  slope = 1.0
     216    !    Between CLOWER and CUPPER = Monotomic increase,
     217    !    with rate of increase dropping from 1.0 to 0.0
     218    !    At CUPPER, slope = 0
     219    !    Above CUTOFP   R=CUTOFP
     220     if (r > clower) then
     221       if (r > cupper) then
     222         trunk = clim
     223       else
     224         trunk = c + cr * r + cr2 * r ** 2
     225       end if
     226     else
     227       trunk = r
     228     end if
     229 end function trunk
 
