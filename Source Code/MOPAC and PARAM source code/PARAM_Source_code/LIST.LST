       1   subroutine set_up_MOZYME_arrays()
       2     use MOZYME_C, only : jopt, ncocc, ncvir, nncf, nnce, icocc, icvir,
 kopt, &
       3     noccupied, nvirtual, icocc_dim, icvir_dim, ncf, nce, cocc, cvir, &
       4     ipad2,  ipad4, cocc_dim, cvir_dim, numred, norred, nelred, &
       5     fmo_dim, part_dxyz, p1, p2, p3, ws, partf, parth, &
       6     partp, idiag, nfmo, fmo, ifmo, iorbs, mode, rapid
       7 !
       8     use molkst_C, only : n2elec, mpack, numat, nelecs, norbs, l123, &
       9     keywrd, id
      10 !
      11     use common_arrays_C, only : h, w, wk, p, f, ifact, q, &
      12     dxyz, eigs, nfirst, nlast, errfn
      13 !
      14     use iter_C, only : pold, pold2, pold3, pbold, pbold2
      15 !
      16     implicit none
      17     integer :: i, j
      18 !
      19 ! Deallocate arrays before use (not essential, but prevents possible er
 rors if a complicated
      20 ! job involving several calculations is run)
      21 !
      22   call delete_MOZYME_arrays()
      23   allocate (iorbs(numat), stat = i)
      24     if (i /= 0) then
      25
      26     end if
      27     iorbs = nlast - nfirst + 1
      28 !
      29 ! The sizes of the arrays used by MOZYME must be evaluated by a call to
  fillij.
      30 ! Once the sizes are known, the arrays can be created.
      31 !
      32
      33
      34
      35   call fillij(.true.)
      36   noccupied = nelecs/2
      37   nvirtual = norbs - noccupied
      38   ipad2 = min(numat + 10, nint((real(numat))**0.25*50))
      39   ipad4 = nint(real(ipad2*norbs)/numat)
      40   icocc_dim = ipad2*noccupied + 1000
      41   icvir_dim = ipad2*nvirtual + 1000
      42   cocc_dim = ipad4*noccupied + 1000 !  100 is a safety factor, in case
 no Lewis structure is possible
      43   cvir_dim = ipad4*nvirtual + 1000
      44 !
      45 !  The two main sizes are:
      46 !     mpack:  the number of elements in the density - one electron - Fo
 ck matrices,
      47 !     n2elec: the number of two-electron integrals that are stored
      48 !
      49
      50
      51 !
      52 !  Allocate the arrays.  If there is not enough memory, it's better to
 find out before
 
 FORCHECK PC V13.5.13   SET_UP_MOZYME_ARRAYS   2021-03-24 10:59:30   page:  3619
 set_up_MOZYME_arrays.F90  /FF
 
