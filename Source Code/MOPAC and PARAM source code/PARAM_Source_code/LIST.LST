     704       real function sdot (n, sx, incx, sy, incy)
     705       implicit none
     706 !-----------------------------------------------
     707 !   D u m m y   A r g u m e n t s
     708 !-----------------------------------------------
     709       integer , intent(in) :: n
     710       integer , intent(in) :: incx
     711       integer , intent(in) :: incy
     712       real , intent(in) :: sx(1)
     713       real , intent(in) :: sy(1)
     714 !-----------------------------------------------
     715 !   L o c a l   V a r i a b l e s
     716 !-----------------------------------------------
     717       integer :: ix, iy, m, mp1
     718       real :: temp
     719 !-----------------------------------------------
     720 !
     721 !     FORMS THE DOT PRODUCT OF TWO VECTORS.
     722 !     USES UNROLLED LOOPS FOR INCREMENTS EQUAL TO ONE.
     723 !     JACK DONGARRA, LINPACK, 3/11/78.
     724 !
     725 !
     726       sdot = 0.0E0
     727       temp = 0.0E0
     728       if (n <= 0) return
     729       if (incx/=1 .or. incy/=1) then
     730 !
     731 !        CODE FOR UNEQUAL INCREMENTS OR EQUAL INCREMENTS
     732 !          NOT EQUAL TO 1
     733 !
     734         ix = 1
     735         iy = 1
     736         if (incx < 0) ix = ((-n) + 1)*incx + 1
     737         if (incy < 0) iy = ((-n) + 1)*incy + 1
     738         temp = dot_product(sx(ix:(n-1)*incx+ix:incx),sy(iy:(n-1)*incy+i
 y:incy))
     739         sdot = temp
     740         return
     741       end if
     742 !
     743 !        CODE FOR BOTH INCREMENTS EQUAL TO 1
     744 !
     745 !
     746 !        CLEAN-UP LOOP
     747 !
     748       m = mod(n,5)
     749       if (m == 0) go to 40
     750       temp = dot_product(sx(:m),sy(:m))
     751       if (n < 5) go to 60
     752    40 continue
     753       mp1 = m + 1
     754       temp = temp + dot_product(sx(mp1:((n-mp1+5)/5)*5-1+mp1),sy(mp1:((
 n-mp1+5)&
     755         /5)*5-1+mp1))
     756    60 continue
     757       sdot = temp
     758       return
     759       end function sdot
 
