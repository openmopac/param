     100                   delzm = tvec(3,1)*mm + tvec(3,2)*nn + tvec(3,3)*kk +
 delz
     101                 end do
     102               end do
     103             end do
     104             delx = delxm
     105             dely = delym
     106             delz = delzm
     107           end if
     108           jf = nfirst(j)
     109           jl = nlast(j)
     110           jpq = jl - jf - 1
     111           jj = jpq + 2
     112           if (jj == 0) cycle
     113           if (jpq /= 2) jpq = min(max(jpq,1),3)
     114           pab = 0.D0
