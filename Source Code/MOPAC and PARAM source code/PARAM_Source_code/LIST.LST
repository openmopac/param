    1168   !
    1169     subroutine active (n, l, u, nbd, x, iwhere, iprint, prjctd, cnstnd,
  boxed)
    1170       use chanel_C, only: iw
    1171       implicit none
    1172       double precision, parameter :: zero = 0.0d0
    1173       logical, intent (out) :: boxed, cnstnd, prjctd
    1174       integer, intent (in) :: iprint, n
    1175       integer, dimension (n), intent (in) :: nbd
    1176       integer, dimension (n), intent (out) :: iwhere
    1177       double precision, dimension (n), intent (in) :: l, u
    1178       double precision, dimension (n), intent (inout) :: x
    1179       integer :: i, nbdd
    1180     !
    1181     !     Initialize nbdd, prjctd, cnstnd and boxed.
    1182     !
    1183       nbdd = 0
    1184       prjctd = .false.
    1185       cnstnd = .false.
    1186       boxed = .true.
    1187     !
    1188     !     Project the initial x to the easible set if necessary.
    1189     !
    1190       do i = 1, n
    1191         if (nbd(i) > 0) then
    1192           if (nbd(i) <= 2 .and. x(i) <= l(i)) then
    1193             if (x(i) < l(i)) then
    1194               prjctd = .true.
    1195               x(i) = l(i)
    1196             end if
    1197             nbdd = nbdd + 1
    1198           else if (nbd(i) >= 2 .and. x(i) >= u(i)) then
    1199             if (x(i) > u(i)) then
    1200               prjctd = .true.
    1201               x(i) = u(i)
    1202             end if
    1203             nbdd = nbdd + 1
    1204           end if
    1205         end if
    1206       end do
    1207     !
    1208     !     Initialize iwhere and assign values to cnstnd and boxed.
    1209     !
    1210       do i = 1, n
    1211         if (nbd(i) /= 2) then
    1212           boxed = .false.
    1213         end if
    1214         if (nbd(i) == 0) then
    1215           !                                this variable is always free
    1216           iwhere (i) = -1 !
    1217           !           otherwise set x(i)=mid(x(i), u(i), l(i)).
    1218         else
    1219           cnstnd = .true.
    1220           if (nbd(i) == 2 .and. u(i)-l(i) <= zero) then
    1221              !                   this variable is always fixed
    1222             iwhere(i) = 3
 
 FORCHECK PC V13.5.13          ACTIVE          2021-03-24 10:59:30   page:  2916
 lbfgs.F90  /FF
 
    1223           else
    1224             iwhere(i) = 0
    1225           end if
    1226         end if
    1227       end do
    1228     !
    1229       if (iprint >= 0) then
    1230         if (prjctd) then
    1231           write (iw,*) "The initial X is infeasible.  Restart with its
 projection."
    1232         end if
    1233         if ( .not. cnstnd) then
    1234           write (iw,*) "This problem is unconstrained."
    1235         end if
    1236       end if
    1237     !
    1238       if (iprint > 0) then
    1239        !
    1240 10000   format (/, "At X0 ", i9, " variables are exactly at the bounds"
 )
    1241         write (iw, 10000) nbdd
    1242       end if
    1243     !
    1244     end subroutine active
 
