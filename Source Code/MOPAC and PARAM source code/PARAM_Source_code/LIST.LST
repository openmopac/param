    1930         if (sum1 < 0.1d0) exit
    1931         residue_motion(j) = 0.d0
    1932         if (l_first) then
    1933           write(iw,'(/5x, a, /)')"Residues that move a lot and their (M
 ovement in Angstroms per atom)"
    1934           l_first = .false.
    1935         end if
    1936         do i = 1, 22
