       1       subroutine xxx(type, i, j, k, l, r)
       2       implicit none
       3 !-----------------------------------------------
       4 !   D u m m y   A r g u m e n t s
       5 !-----------------------------------------------
       6       integer , intent(in) :: i
       7       integer , intent(in) :: j
       8       integer , intent(in) :: k
       9       integer , intent(in) :: l
      10       character , intent(in) :: type
      11       character , intent(out) :: r*(*)
      12 !-----------------------------------------------
      13 !   L o c a l   V a r i a b l e s
      14 !-----------------------------------------------
      15       integer , dimension(4) :: ijk
      16       integer :: m, loop, ii, i2
      17 !-----------------------------------------------
      18 !**********************************************************************
 *
      19 !
      20 !    XXX WILL FORM A UNIQUE STRING LABEL 'R' FOR GAUSSIAN-TYPE INPUT
      21 !    THE LABEL WILL BE LETTER (EITHER R, P, OR F, NORMALLY), FOLLOWED
      22 !    BY THE CONNECTIVITY, IN THE ORDER I, J, K, L.
      23 !    'R' IS 13 CHARACTERS LONG IN ORDER TO ACCOMMODATE 3 DIGITS PER
      24 !    LABEL, WHEN NECESSARY
      25 !
      26 !**********************************************************************
 *
      27       r = type
      28       ijk(1) = i
      29       ijk(2) = j
      30       ijk(3) = k
      31       ijk(4) = l
      32       m = 1
      33       do loop = 1, 4
      34         ii = ijk(loop)
      35         if (ii == 0) cycle
      36 !
      37 !   IF LABELS GREATER THAN 99 ARE USED, UNCOMMENT THE FOLLOWING CODE
      38 !
      39 !#         I2=II/100
      40 !#         IF(I2.NE.0) THEN
      41 !#            M=M+1
      42 !#            R(M:M)=CHAR(ICHAR('0')+I2)
      43 !#            II=II-I2*100
      44 !#         ENDIF
      45         i2 = ii/10
      46         if (i2 /= 0) then
      47           m = m + 1
      48           r(m:m) = char(ichar('0') + i2)
      49           ii = ii - i2*10
      50         end if
      51         m = m + 1
      52         r(m:m) = char(ichar('0') + ii)
      53       end do
      54       return
      55       end subroutine xxx
 
