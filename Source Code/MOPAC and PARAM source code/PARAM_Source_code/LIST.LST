     111       prtden = (Index (keywrd, " DENS") /= 0 .and. debug)
     112       prtfok = (Index (keywrd, " FOCK") /= 0 .and. debug)
     113       debug = (Index (keywrd, " ITER") /= 0)
     114       idiagg = 0
     115       nocc1 = noccupied
     116       store_useps = useps
     117       if (Index (keywrd, " LEWIS") /= 0) then
     118         call makvec()
     119         return
     120       end if
     121       if (Index (keywrd, " OLDEN") /= 0) then
     122           call pinout(0, (index(keywrd, "SILENT") == 0))
     123           if (add_niter /= 0)  call l_control("OLDEN", len_trim("OLDEN"
 ), -1)
     124           if (add_niter /= 0)  call l_control("SILENT", len_trim("SILEN
 T"), -1)
     125           if (moperr) return
     126           call density_for_MOZYME (p, 0, noccupied, partp)
     127           partp = p
     128       else
     129         useps = .false.
     130         if (index(keywrd, "OLD_SCF") == 0) call makvec()
     131       end if
     132       if (moperr) return
     133       !
     134       !  A NEW MOLECULE, THEREFORE SEARCH FOR ALL WEAK INTERACTIONS.
     135       !
     136       nhb = 0
     137     else
     138       !
     139       !  A MODIFIED GEOMETRY, THEREFORE SEARCH ONLY FOR NEW
     140       !  OR VERY WEAK INTERACTIONS.
     141       !
     142       nhb = 3
     143     end if
     144     if (mod(nscf + 1, re_local) == 0) then
     145       write(iw,"(/10x,a,/)")"  LMOs being Re-Localized"
     146       call local_for_MOZYME("OCCUPIED")
     147       call local_for_MOZYME("VIRTUAL")
     148     end if
     149     useps = store_useps
     150     if (lpka) useps = .true.
     151     if (icalcn /= step_num) then
     152       istabl = 0
     153       eold = 0.d0
     154       ovmax = 0.d0
     155       call scfcri (selcon)
     156       idiagg = 0
     157       tiny = 0.d0
     158     end if
     159     if (index(keywrd," tighten")  /= 0) then
     160       call l_control("tighten", len_trim("tighten"), -1)
     161  !     selcon = selcon/1.5d0
     162     end if
     163    !
     164    ! Fill the array IDIAG pointing to the diagonal elements of P
     165    !
     166     l = 0
     167     do i = 1, numat
 
 FORCHECK PC V13.5.13     ITER_FOR_MOZYME      2021-03-24 10:59:30   page:  3074
 iter_for_MOZYME.F90  /FF
 
     168       j = ijbo (i, i)
     169       do k = 1, iorbs(i)
     170         l = l + 1
     171         j = j + k
     172         idiag(l) = j
     173       end do
     174     end do
     175    !
     176    !  Zero out POLD and P1 so that the new calculation is not affected
     177    !  by a previous one.
     178    !
     179     pold = 0.d0
     180     p1 = 0.d0
     181     nscf = nscf + 1
     182    !
     183    !  Force IDIAGG to be even - this is to ensure that DIAGG1
     184    !  re-builds the interaction list, in case the temporary space
     185    !  has been used between the calls to ITER.
     186    !
     187     if (Mod(idiagg, 2) == 1) idiagg = idiagg + 1
     188     iemin = 0
     189     iemax = 0
     190     niter = 0
     191     shift = 0.0d0
     192     use_three_point_extrap = .true.
     193     if (times) then
     194       call timer (" At start of ITER")
     195     end if
     196 !***********************************************************
     197 !
     198 !   Everything is now set up to allow the SCF to be run
     199 !
     200 !***********************************************************
     201     do  !  Big loop to run the SCF
     202 !----------------
     203       do
     204         call tidy (noccupied, ncf, icocc, icocc_dim, cocc, cocc_dim, nn
 cf, ncocc, lno, mn, 1)
     205         if (moperr) then
     206 !
     207 !  During a run of "tidy", the amount of expansion space for the LMO's
 to use had
     208 !  become small.  The LMOs were stored to disc.  The old arrays will no
 w be deleted
     209 !  and re-created 60% larger than before.  Then the LMOs are read off d
 isc
     210 !
     211           deallocate (icocc, cocc, icvir, cvir)
     212
     213 !
     214 !  Re-allocate more memory
     215 !
     216           icocc_dim = Nint(icocc_dim*1.6)
     217           cocc_dim = Nint(cocc_dim*1.6)
     218           icvir_dim = Nint(icvir_dim*1.6)
     219           cvir_dim = Nint(cvir_dim*1.6)
     220           allocate (icocc(icocc_dim), cocc(cocc_dim), &
     221                 & icvir(icvir_dim), cvir(cvir_dim), stat = i)
     222           if (i /= 0) then
 
 FORCHECK PC V13.5.13     ITER_FOR_MOZYME      2021-03-24 10:59:30   page:  3075
 iter_for_MOZYME.F90  /FF
 
     223             call memory_error(" iter_for MOZYME")
     224             return
     225           end if
     226 !
     227 !  Read in old density
     228 !
     229           call pinout (0, .false.)
     230           moperr = .false.
     231         else
     232           exit
     233         end if
     234       end do
     235       do
     236         call tidy (nvirtual, nce, icvir, icvir_dim, cvir, cvir_dim, nnc
 e, ncvir, lnv, mn, 2)
     237         if (moperr) then
     238 !  Delete old memory
     239 !
     240           deallocate (icocc, cocc, icvir, cvir)
     241
     242 !
     243 !  Re-allocate more memory
     244 !
     245           icocc_dim = Nint(icocc_dim*1.6)
     246           cocc_dim = Nint(cocc_dim*1.6)
     247           icvir_dim = Nint(icvir_dim*1.6)
     248           cvir_dim = Nint(cvir_dim*1.6)
     249           allocate (icocc(icocc_dim), cocc(cocc_dim), &
     250                 & icvir(icvir_dim), cvir(cvir_dim), stat = i)
     251           if (i /= 0) then
     252             call memory_error(" iter_for MOZYME")
     253             return
