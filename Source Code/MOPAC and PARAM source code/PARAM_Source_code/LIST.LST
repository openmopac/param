 the hydrogen atoms is incorrect.
    1002 !  To correct this, the sequence of hydrogen atoms is reversed.  This i
 s necessary in order to prevent
    1003 !  hydrogen atoms being swapped around by repeated calls to RESEQ.
    1004 !
    1005     do j = 1, new
    1006       if (nat(lused(j)) == 1) exit
    1007     end do
    1008     if (j > -new) return
    1009 !
    1010 ! Start of hydrogen atoms = j
    1011 !
    1012     k = j
    1013     do
    1014       do
    1015         k = k + 1
    1016         if (k == new) exit
    1017         if (ibonds(1,lused(k)) /= ibonds(1,lused(j))) then
    1018           k = k - 1
    1019           exit
    1020         end if
    1021       end do
    1022       if (k - j > 0) then
    1023 !
    1024 !  Two or three hydrogen atoms attached to the same atom
    1025 !  Swapping the atoms around is unusually simple!
    1026 !
    1027         i2 = lused(j)
