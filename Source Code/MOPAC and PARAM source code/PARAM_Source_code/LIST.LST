      40 subroutine convert_lmo_packed_to_square (c_square)
      41    !*******************************************************************
 ****
      42    !
    *
      43    !        Converts LMOs from the storage format used in MOZYME to tha
 t  *
      44    !        used in MOPAC.
      45    !
    *
      46    !*******************************************************************
 ****
      47     use molkst_C, only: norbs, nelecs
      48     use MOZYME_C, only: isort, nce, ncf, ncocc, ncvir, nnce, nncf, &
      49           icocc, icvir, cocc, cvir
      50     use common_arrays_C, only : nfirst, nlast
      51     implicit none
      52     double precision, dimension (norbs, norbs), intent (out) :: c_squar
 e
      53     integer :: i, ii, iunsrt, j, jj, k, ka, nocc, nvir, alloc_stat
      54     nocc = nelecs / 2
      55     nvir = norbs - nocc
      56     if (.not. Allocated (isort)) then
      57 !
      58 !  isort has not been assigned, therefore assume that eigenvectors are
 not wanted.
      59 !  in which case, use the LMOs in the order in which they occur
      60 !
      61       allocate (isort(norbs), stat=alloc_stat)
      62       if (alloc_stat /= 0) then
      63         call memory_error ("convert_lmo_packed_to_square")
      64         call mopend ("Error in converting storage format of orbitals")
      65       end if
      66       do i = 1, nocc
      67         isort(i) = i
      68       end do
      69       do i = 1,nvir
      70         isort(nocc+i) = i
      71       end do
      72     end if
      73       !
      74       !   Put occupied LMOs into conventional form
      75       !
      76       do iunsrt = 1, nocc
      77         i = isort(iunsrt)
      78         do j = 1, norbs
      79           c_square(j, iunsrt) = 0.d0
      80         end do
      81         ka = ncocc(i)
      82         do jj = nncf(i) + 1, nncf(i) + ncf(i)
      83           j = icocc(jj)
      84           do k = nfirst(j), nlast(j)
      85             ka = ka + 1
      86             c_square(k, iunsrt) = cocc(ka)
      87           end do
      88         end do
      89       end do
      90       !
 
 FORCHECK PC V13.5.13                          2021-03-24 10:59:30   page:  2515
 convert_storage.F90  /FF
 
      91       !   Put virtual LMOs into conventional form
      92       !
      93       do iunsrt = 1, nvir
      94         i = isort(iunsrt+nocc)
      95         ii = iunsrt + nocc
      96         do j = 1, norbs
      97           c_square(j, ii) = 0.d0
      98         end do
      99         ka = ncvir(i)
     100         do jj = nnce(i) + 1, nnce(i) + nce(i)
     101           j = icvir(jj)
     102           do k = nfirst(j), nlast(j)
     103             ka = ka + 1
     104             c_square(k, ii) = cvir(ka)
     105           end do
     106         end do
     107       end do
     108 end subroutine convert_lmo_packed_to_square
 
