     103       imin  = itim1(6)
     104       isec  = itim1(7)
     105       imsec = itim1(8)
     106       wall_clock_1 = float(3600*ihour + 60*imin + isec) + (float(imsec)
 /1.e3 )
     107       seconds = dble(wall_clock_1 - wall_clock_0) + shut
     108
     109       if (is_PARAM) return
     110  11   endfile (iw, iostat = i99)
     111       l = 0
     112       if (i99 /= 0) then
     113         l = l + 1
     114         write(0,"(i3,3a)")21 - l," File """,trim(output_fn),""" is unav
 ailable for use"
     115         write(0,"(a)")"    Correct fault (probably the output file is i
 n use elsewhere)"
     116         call sleep(5)
     117         inquire(unit=iw, opened=opend)
     118         if (opend) close (iw)
     119         open(unit=iw, file=output_fn, status='UNKNOWN', position='asis'
 )
     120         if (l < 20) goto 11
     121         write(0,"(a)") "Job abandoned due to output file being unavaila
 ble"
     122         call mopend("Job abandoned due to output file being unavailable
 ")
     123         call sleep(5)
     124         return
     125       end if
     126       if (l > 0) then
     127        write(0,"(a)")" Fault successfully corrected.  Job continuing"
     128       end if
     129       backspace (iw)
     130       return
     131       end function seconds
 
