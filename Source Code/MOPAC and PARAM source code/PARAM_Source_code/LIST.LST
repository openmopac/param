     318 !     *****************************************************************
 ********
     319
     320       subroutine veccou (nm, avec1, bvec1)
     321
     322 !     **** determins A and B coeffs for shells of Fock matrix using
  ****
     323 !     **** E&Z eqn 30c; closed shell terms are set to zero.
  ****
     324 !     **** nm = matrix element index, shell 0 is the total density
  ****
     325 !     **** the B vec has the half factor of eqn 30b included
  ****
     326       use reimers_C, only : vca, vcb, nshell, dd
     327
     328       implicit none
     329       double precision ::   avec1(0:4), bvec1(0:4)
     330       integer ::            ishell, jshell, nm
     331
     332       avec1(0) = dd(nm, 1)
     333       avec1(1) = 0.d0
     334       bvec1(1) = 0.d0
     335       do ishell = 2, nshell
     336         avec1(0) = avec1(0) + dd(nm, ishell)
     337         avec1(ishell) = 0.d0
     338         bvec1(ishell) = 0.d0
     339         do jshell = 2, nshell
     340           avec1(ishell) = avec1(ishell) + (1.d0 - vca(ishell, jshell))
 *&
     341      &                                dd(nm, jshell)
     342           bvec1(ishell) = bvec1(ishell) + (1.d0 - vcb(ishell, jshell))
 *&
     343      &                                dd(nm, jshell)
     344         end do
     345         bvec1(ishell) = bvec1(ishell) / 2.d0
     346       end do
     347       bvec1(0) = avec1(0) / 2.d0
     348
     349       return
     350       end subroutine veccou
 
