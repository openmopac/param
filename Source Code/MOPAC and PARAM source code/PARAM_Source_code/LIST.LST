    1190       name = hexose_aldose(i)
    1191     else
    1192       i = chiral(3) + 2*chiral(4) + 1
    1193       name = hexose_ketose(i)
    1194     end if
    1195     if (chiral(5) == 0) then
    1196       name = "D-"//trim(name)
    1197     else
    1198       name = "L-"//trim(name)
    1199     end if
    1200     if (aldose) then
    1201       if (chiral(1) == 0) then
    1202         name = "alpha-"//trim(name)
    1203       else
    1204         name = "beta-"//trim(name)
    1205       end if
    1206     else
    1207       if (chiral(2) == 0) then
    1208         name = "alpha-"//trim(name)
    1209       else
    1210         name = "beta-"//trim(name)
    1211       end if
    1212     end if
    1213     select case(name)
    1214       case("alpha-D-Allose")
    1215         nam = "ALO"
    1216       case("alpha-D-Altrose")
    1217         nam = "ALT"!
    1218       case("alpha-D-Glucose")
    1219         nam = "GLC"
    1220       case("alpha-D-Mannose")
    1221         nam = "MAN"!
 
 FORCHECK PC V13.5.13     IDENTIFY_HEXOSE      2021-03-24 10:59:30   page:  3196
 ligand.F90  /FF
 
    1222       case("alpha-D-Gulose")
    1223         nam = "GUL"!
    1224       case("alpha-D-Idose")
    1225         nam = "IDO"!
    1226       case("alpha-D-Galactose")
    1227         nam = "GAL"!
    1228       case("alpha-D-Talose")
    1229         nam = "TAL"!
    1230       case("beta-D-Allose")
    1231         nam = "BAL"
    1232       case("beta-D-Altrose")
    1233         nam = "BAT"!
    1234       case("beta-D-Glucose")
    1235         nam = "BGC"
    1236       case("beta-D-Mannose")
    1237         nam = "BMA"!
    1238       case("beta-D-Gulose")
    1239         nam = "BGU"!
    1240       case("beta-D-Idose")
    1241         nam = "BID"!
    1242       case("beta-D-Galactose")
    1243         nam = "BGA"!
    1244       case("beta-D-Talose")
    1245         nam = "BTA"!
    1246       case("alpha-D-Psicose")
    1247         nam = "ADP"!
    1248       case("alpha-D-Fructose")
    1249         nam = "ADF"!
    1250       case("alpha-D-Sorbose")
    1251         nam = "ADS"!
    1252       case("alpha-D-Tagatose")
    1253         nam = "ADT"!
    1254     end select
    1255   end subroutine identify_hexose
 
