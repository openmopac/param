       4
       5       subroutine upcas (s)
       6
       7       implicit none
       8       integer ::          i
       9       character*(*)    s
      10
      11 !     **** converts string to upper case ****
      12
      13       do i = 1, len(s)
      14         if (s(i:i) <= 'z' .and. s(i:i) >= 'a')&
      15      &          s(i:i) = char(ichar(s(i:i)) - 32)
      16       end do
      17
      18       return
      19       end subroutine upcas
 
