       1   subroutine Locate_TS_for_Proteins
       2 !
       3 ! Multi-step procedure for locating a transition state involving two st
 ationary points in a
       4 ! protein mechanism
       5 !
       6 ! Steps involved:
       7 ! A: Using lbfgs_TS, and two stationary points, locate an approximation
  to the transition state
       8 ! B: Using the TS option in ef and only those atoms involved in the act
 ive site, locate the transition state.
       9 !      (This uses gradient minimization)
      10 ! C: Using normal geometry optimization optimize the positions of all o
 ther atoms
      11 ! D: Repeat B and C until the geometry is stable
      12 !
      13     use common_arrays_C, only : xparam, loc, geoa, lopt, geo, grad
      14     USE molkst_C, only : nvar, keywrd, numcal, numat, density, use_ref_
 geo, mpack, n2elec, &
      15      line, step_num, escf, moperr, prt_coords, refkey
      16     use MOZYME_C, only : geo_1, geo_2
      17     use chanel_C, only : iw, iarc, input_fn, iden
      18     implicit none
      19     integer :: i, j, k, l, big_nvar, shell, loop, nloop, nset, store_mp
 ack, store_n2elec, ipdb = 14
      20     double precision :: stresses(100), gradients(100), gnorm_store
      21     double precision, allocatable :: big_xparam(:)
      22     integer :: ninsite(3)
      23     integer, allocatable :: active_site(:)
      24     logical :: extra_print, exists, l_refine = .true., opend
      25     character :: line1*200
      26     double precision, external :: reada
      27     character :: num
      28     allocate(active_site(200))
      29     if (.not. allocated(geoa)) allocate(geoa(3,numat))
      30     if (allocated(geo_1)) geoa(:,:numat) = geo_1(:,:numat)
      31     call build_active_site(active_site, ninsite)
      32     if (moperr) return
      33     nset = 1
      34     if (index(keywrd," LOCATE-TS(SET") /= 0) then
      35       shell = ninsite(1)
      36       deallocate(grad)
      37       allocate(grad(3*numat))
      38       goto 99
      39     end if
      40     gnorm_store = 0.d0
      41     i = index(keywrd, " GNORM=")
      42     if (i /= 0) gnorm_store = reada(keywrd, i)
      43     gradients = max(4.d0,min(20.d0,sqrt(numat*0.5d0)))
      44     i = index(keywrd,  " LOCATE-TS") + 11
      45     do j = i + 1, len_trim(keywrd)
      46       if (keywrd(j:j) == " ") exit
      47     end do
      48     k = index(keywrd(i:j), "C:")
      49     if (k > 0) then
      50       extra_print = .true.
      51       i = i + k + 1
      52       nloop = 0
 
