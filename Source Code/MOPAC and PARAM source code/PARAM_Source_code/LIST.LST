    2406       subroutine ffreq2(f, ptot, w)
    2407 !-----------------------------------------------
    2408 !   M o d u l e s
    2409 !-----------------------------------------------
    2410       USE molkst_C, only : numat, norbs
    2411       use common_arrays_C, only : nfirst, nlast
    2412 !**********************************************************************
 *
    2413       implicit none
    2414 !-----------------------------------------------
    2415 !   G l o b a l   P a r a m e t e r s
    2416 !-----------------------------------------------
    2417 !-----------------------------------------------
    2418 !   D u m m y   A r g u m e n t s
    2419 !-----------------------------------------------
    2420       double precision , intent(inout) :: f(norbs,norbs)
    2421       double precision , intent(in) :: ptot(norbs,norbs)
    2422       double precision , intent(in) :: w(*)
    2423 !-----------------------------------------------
    2424 !   L o c a l   P a r a m e t e r s
    2425 !-----------------------------------------------
    2426 !-----------------------------------------------
    2427 !   L o c a l   V a r i a b l e s
    2428 !-----------------------------------------------
    2429       integer :: ii, iim1, ia, ib, jj, ja, jb, i, j, k, l, kk
    2430       double precision :: fij, fkl, a, aint
    2431 !-----------------------------------------------
    2432 !*******************************************************************
    2433 !
    2434 !  TDHF FORMS TWO ELECTRON TWO CENTER REPULSION PART OF THE FOCK
    2435 !  MATRIX
    2436 ! ON INPUT PTOT = TOTAL DENSITY MATRIX
    2437 !          P    = ALPHA OR BETA DENSITY MATRIX
    2438 !          W    = TWO ELECTRON INTEGRAL MATRIX
    2439 !
    2440 !  ON OUTPUT F = PARTIAL FOCK MATRIX
    2441 !
    2442 !********************************************************************
    2443
    2444         kk = 0
    2445 !
    2446         do ii = 1, numat
    2447           iim1 = ii - 1
    2448           ia = nfirst(ii)
    2449           ib = nlast(ii)
    2450           do jj = 1, iim1
    2451             ja = nfirst(jj)
    2452             jb = nlast(jj)
    2453             do i = ia, ib
    2454               do j = ia, i
    2455                 fij = 1.0D00
    2456                 if (i == j) fij = 0.5D00
    2457                 do k = ja, jb
    2458                   do l = ja, k
    2459                     fkl = 1.0D00
    2460                     if (k == l) fkl = 0.5D00
    2461                     kk = kk + 1
    2462                     a = w(kk)
 
 FORCHECK PC V13.5.13          FFREQ2          2021-03-24 10:59:30   page:  2638
 polar.F90  /FF
 
    2463                     aint = a*fkl*fij
    2464                     f(i,j) = f(i,j) + aint*(ptot(k,l)+ptot(l,k))
    2465                     f(j,i) = f(j,i) + aint*(ptot(k,l)+ptot(l,k))
    2466                     f(k,l) = f(k,l) + aint*(ptot(i,j)+ptot(j,i))
    2467                     f(l,k) = f(l,k) + aint*(ptot(i,j)+ptot(j,i))
    2468                     aint = aint*0.5D00
    2469                     f(i,l) = f(i,l) - aint*ptot(j,k)
    2470                     f(l,i) = f(l,i) - aint*ptot(k,j)
    2471                     f(k,j) = f(k,j) - aint*ptot(l,i)
    2472                     f(j,k) = f(j,k) - aint*ptot(i,l)
    2473                     f(i,k) = f(i,k) - aint*ptot(j,l)
    2474                     f(k,i) = f(k,i) - aint*ptot(l,j)
    2475                     f(j,l) = f(j,l) - aint*ptot(i,k)
    2476                     f(l,j) = f(l,j) - aint*ptot(k,i)
    2477                   end do
    2478                 end do
    2479               end do
    2480             end do
    2481           end do
    2482           kk = kk + (((ib - ia +1 )*(ib - ia + 2))/2) **2
    2483         end do
    2484       return
    2485       end subroutine ffreq2
 
 FORCHECK PC V13.5.13          FFREQ2          2021-03-24 10:59:30   page:  2639
 polar.F90  /FF


