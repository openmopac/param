     381       do j = 1, nstate
     382         sum = 0.D0
     383         do k = 1, nstate
     384           sum = sum + conf(k+(istate-1)*nstate)*t4(j,k)
     385         end do
     386         work(j) = sum
     387       end do
     388       sum = ddot(nstate,work(:nstate),1,conf(1+(istate-1)*nstate:istate
 *nstate),1)
     389       charst = sum
     390       return
     391       end function charst
 
