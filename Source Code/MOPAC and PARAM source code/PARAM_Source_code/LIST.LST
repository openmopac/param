       1       subroutine deritr()
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE molkst_C, ONLY: norbs, nelecs, numcal, ndep, nvar, &
       6       & enuclr, keywrd, natoms, escf, elect, method_pm7, mozyme, moperr
       7       use common_arrays_C, only : loc, geo, p, pa, coord, errfn
       8       USE funcon_C, only : fpc_9
       9       USE chanel_C, only : iw
      10 !**********************************************************************
 *
      11 !-----------------------------------------------
      12 !   I n t e r f a c e   B l o c k s
      13 !-----------------------------------------------
      14       implicit none
      15 !-----------------------------------------------
      16 !   L o c a l   P a r a m e t e r s
      17 !-----------------------------------------------
      18 !-----------------------------------------------
      19 !   L o c a l   V a r i a b l e s
      20 !-----------------------------------------------
      21       integer :: icalcn, i, k, l, j
      22       double precision :: xderiv
      23       double precision, dimension(3*natoms) :: xparam
      24       double precision :: delta, const, aa, xstore, ee, escf_store, enu
 clr_store, &
      25       elect_store, sum
      26       double precision, external :: reada
      27       logical :: debug, PM6_H, precise
      28
      29       save icalcn, debug, xderiv, delta, const
      30 !-----------------------------------------------
      31 !**********************************************************************
 *
      32 !
      33 !    DERITR CALCULATES THE DERIVATIVES OF THE ENERGY WITH RESPECT TO TH
 E
      34 !          INTERNAL COORDINATES. THIS IS DONE BY FINITE DIFFERENCES
      35 !          USING FULL SCF CALCULATIONS.
      36 !
      37 !          THIS IS VERY TIME-CONSUMING, AND SHOULD ONLY BE USED WHEN
      38 !          NO OTHER DERIVATIVE CALCULATION WILL DO.
      39 !
      40 !    THE MAIN ARRAYS IN DERIV ARE:
      41 !        LOC    INTEGER ARRAY, LOC(1,I) CONTAINS THE ADDRESS OF THE ATO
 M
      42 !               INTERNAL COORDINATE LOC(2,I) IS TO BE USED IN THE
      43 !               DERIVATIVE CALCULATION.
      44 !        GEO    ARRAY \GEO\ HOLDS THE INTERNAL COORDINATES.
      45 !
      46 !**********************************************************************
 *
      47       data icalcn/ 0/
      48       precise = .false.
      49       PM6_H = .false.
      50       if (icalcn /= numcal) then
      51         debug = (index(keywrd,'DERITR') /= 0)
      52         precise = (index(keywrd,'PRECISE') /= 0)
 
 FORCHECK PC V13.5.13          DERITR          2021-03-24 10:59:30   page:  3608
 deritr.F90  /FF
 
      53         PM6_H = (method_pm7 .or. index(keywrd,'PM6-D') + index(keywrd,'
 PM6-H') /= 0)
      54 !
      55 !   DELTA IS A MACHINE-PRECISION DEPENDANT CONSTANT
      56 !
      57
      58         icalcn = numcal
      59 !
      60 !   CONST = 23.06... eV to KCAL
      61 !
      62         const = fpc_9
      63 !
      64         delta = 0.d0
      65         i = index(keywrd,' DELTA')
      66         if (i /= 0) delta = reada(keywrd,i)
      67         if (precise) then
      68           if (delta < 1.d-10) delta = 0.001D0
      69           xderiv = 0.5D0/delta
      70         else
      71           if (delta < 1.d-10) delta = 0.0002D0
      72           xderiv = 1.d0/delta
      73         end if
      74       end if
      75       do i = 1, nvar
      76         xparam(i) = geo(loc(2,i),loc(1,i))
      77       end do
      78       escf_store = escf
      79       enuclr_store = enuclr
      80       elect_store = elect
      81       if ( .not. precise) then
      82 !
      83 !  ESTABLISH THE ENERGY AT THE CURRENT POINT
      84 !
      85         if (ndep /= 0) call symtry
      86         call gmetry (geo, coord)
      87         if (norbs*nelecs > 0) then
      88           if (mozyme) then
      89             call hcore_for_MOZYME ()
      90             if (moperr) return
      91             aa = 0.d0
      92             call iter_for_MOZYME (aa)
      93           else
      94             call hcore ()
      95             call iter (aa, .TRUE., .TRUE.)
      96           end if
      97         else
      98           aa = 0.d0
      99         end if
     100         if (PM6_H) then
     101           call post_scf_corrections(sum, .false.)
     102           aa = aa + sum/const
     103         end if
     104         aa = aa + enuclr
     105       end if
     106 !
     107 !  RESTORE THE DENSITY MATRIX (WHY?)
     108 !
     109       if (allocated (pa)) p = pa*2.D0
     110       do i = 1, nvar
 
 FORCHECK PC V13.5.13          DERITR          2021-03-24 10:59:30   page:  3609
 deritr.F90  /FF
 
     111         k = loc(1,i)
     112         l = loc(2,i)
     113         xstore = xparam(i)
     114         do j = 1, nvar
     115           geo(loc(2,j),loc(1,j)) = xparam(j)
     116         end do
     117         if (precise) then
     118           geo(l,k) = xstore + delta
     119           if (ndep /= 0) call symtry
     120           call gmetry (geo, coord)
     121 !
     122 !   IF NEEDED, CALCULATE "EXACT" DERIVATIVES.
     123 !
     124           if (norbs*nelecs > 0) then
     125             if (mozyme) then
     126               call hcore_for_MOZYME ()
     127               if (moperr) return
     128               call iter_for_MOZYME (aa)
     129             else
     130               call hcore ()
     131               call iter (aa, .TRUE., .TRUE.)
     132             end if
     133             if (PM6_H) then
     134               call post_scf_corrections(sum, .false.)
     135               aa = aa + sum/const
     136             end if
     137           else
     138             aa = 0.d0
     139           end if
     140           aa = aa + enuclr
     141         end if
     142         geo(l,k) = xstore - delta
     143         if (ndep /= 0) call symtry
     144         call gmetry (geo, coord)
     145 !
     146 !   IF NEEDED, CALCULATE "EXACT" DERIVATIVES.
     147 !
     148         if (norbs*nelecs > 0) then
     149           if (mozyme) then
     150             call hcore_for_MOZYME ()
     151             if (moperr) return
     152             call iter_for_MOZYME (ee)
     153           else
     154             call hcore ()
     155             call iter (ee, .TRUE., .TRUE.)
     156           end if
     157           if (PM6_H) then
     158             call post_scf_corrections(sum, .false.)
     159             ee = ee + sum/const
     160           end if
     161         else
     162           ee = 0.d0
     163         end if
     164         ee = ee + enuclr
     165         errfn(i) = (aa - ee)*const*xderiv
     166       end do
     167       if (debug) then
     168         write (iw, '('' ERROR FUNCTION'')')
     169         write (iw, '(10F8.3)') (errfn(i),i=1,nvar)
 
 FORCHECK PC V13.5.13          DERITR          2021-03-24 10:59:30   page:  3610
 deritr.F90  /FF
 
     170       end if
     171       geo(loc(2,nvar),loc(1,nvar)) = xparam(nvar)
     172       escf = escf_store
     173       enuclr = enuclr_store
     174       elect = elect_store
     175       return
     176       end subroutine deritr
 
