     880 subroutine moiety (iopt, lused, istart, new)
     881     use molkst_C, only: numat, natoms
     882     use common_arrays_C, only : nat, nbonds, ibonds
     883     use chanel_C, only: iw
     884     use elemts_C, only: elemnt
     885 !
     886 !.. Implicit Declarations ..
     887     implicit none
     888 !
     889 !.. Formal Arguments ..
     890     integer, intent (in) :: istart
     891     integer, intent (inout) :: new
     892     logical, dimension (numat), intent (inout) :: iopt
     893     integer, dimension (natoms), intent (inout) :: lused
     894 !
     895 !.. Local Scalars ..
     896     integer :: i2, i3, iatom, j, j2, k, l, ninbit, nlive
     897 !
     898 !.. Local Arrays ..
     899     integer, allocatable :: live(:), inres(:)
     900 !
     901 ! ... Executable Statements ...
     902 !
     903    i2 = max(2000, natoms*2)
     904     allocate (live(i2), inres(i2))
     905     inres = 0
     906     iatom = istart
     907 !
     908 !   The first atom identified in the moiety is atom IATOM.
     909 !
     910     iopt(iatom) = .true.
     911 !
     912 !  NOW TO WORK OUT THE ATOMS IN THE MOIETY
     913 !
     914     nlive = nbonds(iatom)
     915     if (nlive == 0) then
     916       ninbit = 1
     917       inres(1) = iatom
     918     else
     919       ninbit = 0
     920       do i2 = 1, nlive
     921         live(i2) = ibonds(i2, iatom)
     922       end do
     923       do
     924         l = live(1)
     925         if (iopt(l) .or. l == iatom) then
     926           if (nlive < 1) exit
     927           live(1) = live(nlive)
     928           nlive = nlive - 1
     929         else
     930           iopt(l) = .true.
     931           ninbit = ninbit + 1
     932           if (ninbit > natoms) then
     933             write (iw, "(A,I4,A)") " There are more than", natoms, &
     934                  & " atoms in moiety "
     935             write (iw,*) " Atoms in moiety"
     936             write (iw, "(10(1X,A2,I5))") (elemnt(nat(inres(l))), inres(
 l), &
 
 FORCHECK PC V13.5.13          MOIETY          2021-03-24 10:59:30   page:  3188
