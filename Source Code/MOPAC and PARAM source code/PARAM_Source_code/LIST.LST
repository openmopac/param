 P
     165 !         DURING THIS CALL TO LOCMIN.
     166 !
     167         if (debug) write (iw, '('' F/FLAST'',F13.6)') f/flast
     168         if (lower .and. f/flast>0.995D0) then
     169           if (abs(t - tlast) <= eps*abs(t + tlast) + tee) then
     170             if (debug) write (iw, '('' EXIT AS STEP IS ABSOLUTELY SMALL
  '')')
     171             exit
