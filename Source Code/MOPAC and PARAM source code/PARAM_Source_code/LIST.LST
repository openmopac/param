    2427   subroutine bridge_H
    2428 !
    2429 !  Detect and print unusually short hydrogen bonds
    2430 !
    2431   use molkst_C,  only : numat, line
    2432   use common_arrays_C,  only : nat, nbonds,  ibonds, txtatm, &
    2433     breaks
    2434   use chanel_C, only : iw, log, ilog
    2435   use elemts_C, only: elemnt
    2436   implicit none
    2437   integer :: i,ii, j, k, l, kk, jj, nchain2
    2438   double precision :: bond_length, bond_length_2, sum
    2439   integer, allocatable :: h1(:), h2(:)
    2440   double precision, allocatable :: Rab1(:), Rab2(:)
    2441   double precision, external :: distance
    2442     allocate (h1(numat), h2(numat),Rab1(numat),Rab2(numat))
    2443     Rab1 = 100.d0
    2444     Rab2 = 100.d0
    2445     k = 0
    2446     ii = 0
    2447     do i = 1, numat
    2448       if (nat(i) /= 1) cycle
    2449       bond_length = 10.d0
    2450       bond_length_2 = 10.d0
    2451       nchain2 = 1
    2452       l = 0
    2453       k = 0
    2454       do j = 1, numat
    2455         if (j == breaks(nchain2)) nchain2 = nchain2 + 1
    2456         if (nat(j) == 1) cycle
    2457         sum = distance(i,j)
    2458 !
    2459 !  Exclude water
    2460 !
    2461         jj = 0
    2462         if (nat(j) == 8) then
    2463           jj = 0
    2464           do kk = 1, nbonds(j)
    2465             if (nat(ibonds(kk,j)) == 1) jj = jj + 1
    2466           end do
    2467         end if
    2468         if (sum < bond_length .and. jj < 2) then
    2469           if (bond_length < bond_length_2) then
    2470             l = k
