       2 subroutine density_for_GPU (c, fract, ndubl, nsingl, occ, mpack, norbs,
  mode, pp, iopc)
       3
       4       implicit none
       5       Integer :: ndubl, nsingl, mode, mpack, norbs, nl1, nl2, nu1, nu2,
  i, j, &
       6                    & nl21, nl11, iopc
       7       double precision,allocatable :: xmat(:,:)
       8       double precision :: c(norbs,norbs), pp(mpack)
       9       double precision :: cst, sign, fract, frac, occ
      10
      11       if (ndubl /= 0 .and. nsingl > (norbs/2) .and. mode /= 2) then
      12         !
      13         !    TAKE POSITRON EQUIVALENT
      14         !
      15         sign = -1.d0
      16         frac = occ - fract
      17         cst = occ
      18         nl2 = nsingl + 1
      19         nu2 = norbs
      20         nl1 = ndubl + 1
      21         nu1 = nsingl
      22       else
      23         !
      24         !    TAKE ELECTRON EQUIVALENT
      25         !
      26         sign = 1.d0
      27         frac = fract
      28         cst = 0.d0
      29         nl2 = 1
      30         nu2 = ndubl
      31         nl1 = ndubl + 1
      32         nu1 = nsingl
      33       end if
      34       Select case (iopc)
      35         case(2)   ! Option to use dgemm from CUBLAS
      36
      37         case(3)   ! Option to use dgemm from BLAS
      38
      39           nl21 = Min (norbs, nl2)
      40           nl11 = Min (norbs, nl1)
      41
      42           allocate(xmat(norbs,norbs),stat = i)
      43           if (norbs < 0) forall (j=1:norbs,i=1:norbs) xmat(i,j) = 0.d0
  ! Dummy statement to 'fool' FORTRAN checks
      44
      45           call dgemm ('N', 'T', norbs, norbs, nu2-nl2+1, 2.0d0*sign, c(
 1:norbs,nl21:norbs),&
      46                         &   norbs, c(1:norbs,nl21:norbs), norbs, 0.0d0,
  xmat, norbs)
      47           call dgemm ('N', 'T', norbs, norbs, nu1-nl1+1, frac*sign, c(1
 :norbs,nl11:norbs), &
      48                         &   norbs, c(1:norbs,nl11:norbs), norbs, 1.0d0,
  xmat, norbs)
      49
      50           forall (i=1:norbs)
      51              xmat(i,i) = xmat(i,i) + cst
      52           endforall
 
 FORCHECK PC V13.5.13     DENSITY_FOR_GPU      2021-03-24 10:59:30   page:   844
 density_for_GPU.F90  /FF
 
      53
      54           call dtrttp('u', norbs, xmat, norbs, pp, i )
      55
      56           deallocate (xmat,stat=i)
      57         case(4)   ! Option to use dsyrk from CUBLAS
      58
      59         case(5)   ! Option to use dsyrk from BLAS
      60
      61           allocate(xmat(norbs,norbs),stat = i)
      62           forall (j = 1:norbs, i=1:norbs) xmat(i, j) = 0.d0
      63           call dsyrk ('u', 'n', norbs, ndubl, occ, c(1:norbs,1:ndubl),
 norbs, 0.d0, xmat, norbs) ! For RHF
      64           call dtrttp('u', norbs, xmat, norbs, pp, i )
      65           deallocate (xmat,stat=i)
      66     End select
      67     continue
      68     return
      69 End subroutine density_for_GPU
 
