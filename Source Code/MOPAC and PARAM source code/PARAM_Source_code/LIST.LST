 vecprt_for_MOZYME.F90  /FF
 
      55             if (l_atom(k)) then
      56               l = l + 1
      57               a(l) = aa((i*(i - 1))/2 + k)
      58             end if
      59           end do
      60         end if
      61       end do
      62       numb = j
      63       linear = l
      64     else if (numat /= 0 .and. nlast(numat) == numm) then
      65       !
      66       !   OPTION (2): PRINT OVER ATOMIC ORBITALS.  Before
      67       !   printing, the array has to be put into standard form.
      68       !
      69       do i = 1, linear
      70         a(i) = 0.d0
      71       end do
      72       ij = 0
      73       do i = 1, numat
      74         do j = 1, i - 1
      75           if (ijbo(i, j) >= 0) then
      76             ij = ij + 1
      77             l = ijbo (i, j)
      78             do ii = nfirst(i), nlast(i)
      79               do jj = nfirst(j), nlast(j)
      80                 l = l + 1
      81                 ll = (ii*(ii-1)) / 2 + jj
      82                 if (ll <= linear) a(ll) = aa(l)
      83               end do
      84             end do
      85           end if
      86         end do
      87         ij = ij + 1
      88         l = ijbo (i, i)
      89         do ii = nfirst(i), nlast(i)
      90           do jj = nfirst(i), ii
      91             l = l + 1
      92             ll = (ii*(ii-1)) / 2 + jj
      93             if (ll <= linear)a(ll) = aa(l)
      94           end do
      95         end do
      96         if (ll == linear) exit
      97       end do
      98       outer_loop: do i = 1, numat
      99         jlo = nfirst(i)
     100         jhi = nlast(i)
     101         l = nat(i)
     102         k = 0
     103         do j = jlo, jhi
     104           k = k + 1
     105           itext(j) = atorbs(k)
     106           jtext(j) = elemnt(l)
     107           natom(j) = i
     108           if (j == numb) exit outer_loop
     109         end do
     110       end do outer_loop
     111     else
     112       !
     113       !    OPTION (3):  PRINT A GENERIC ARRAY.
 
 FORCHECK PC V13.5.13    VECPRT_FOR_MOZYME     2021-03-24 10:59:30   page:  2348
 vecprt_for_MOZYME.F90  /FF
 
     114       !
     115       do i = 1, numb
     116         itext (i) = "  "
     117         jtext (i) = "  "
     118         natom(i) = i
     119       end do
     120       do i = 1, linear
     121         a(i) = aa(i)
     122       end do
     123     end if
     124    !
     125    !   Scale diagonal terms so that they will always be printable.
     126    !
     127     sumax = 1.d0
     128     do i = 1, numb
     129       sumax = Max (Abs (a((i*(i+1))/2)), sumax)
     130     end do
     131     i = Int (Log10(sumax))
