     937                  & l=1, natoms)
     938             call mopend ("Too many atoms in moiety")
     939             return
     940           end if
     941           inres(ninbit) = l
     942           if (nbonds(l) /= 0) then
     943 !
     944 !  THERE IS AT LEAST ONE ATOM ATTACHED TO THE 'LIVE' ATOM
     945 !
     946             loop: do i2 = 2, nbonds(l)
     947               j = ibonds(i2, l)
     948               do i3 = 1, nlive
     949                 if (live(i3) == j) cycle loop
     950               end do
     951               nlive = nlive + 1
     952               live(nlive) = j
     953             end do loop
     954             live(1) = ibonds(1, l)
     955           else
     956             if (nlive == 0) exit
     957             live(1) = live(nlive)
     958             nlive = nlive - 1
     959           end if
     960         end if
     961       end do
     962     end if
     963 !
     964 !   Check that atoms are not counted twice
     965 !
     966     do j = 1, ninbit
     967       do k = j + 1, ninbit
     968         if (inres(j) == inres(k)) then
     969           inres(j) = 0
     970         end if
     971       end do
     972     end do
     973 !
     974 !  Put hydrogen atoms at the end of the list
     975 !
     976     k = ninbit
     977     do j = 1, ninbit
     978       l = inres(j)
     979       if (l /= 0) then
     980         if (nat(l) == 1) then
     981           k = k + 1
     982           inres(k) = l
     983           inres(j) = 0
     984         end if
     985       end if
     986     end do
