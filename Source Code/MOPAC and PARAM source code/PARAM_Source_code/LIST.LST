 script(jmolApplet0)""></a></TD></TABLE>"
     590     write(iprt,"(a)") "</BODY>"
     591     write(iprt,"(a)") "</HTML>"
     592 !
     593 !  Write out a simple script file
     594 !
     595     close (iprt)
     596     line = line(:len_trim(line) - 3)
