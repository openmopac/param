     412  subroutine CPE_QdepDipole_Contribution(N_qm, Id_qm, Crd_qm, Q_qm, Zeta
 _qm, E, Pot, C )
     413     implicit none
     414     integer, intent(in) :: N_qm          ! Number of qm atoms
     415     integer, intent(in) :: Id_qm( N_qm ) ! Parameter indices
     416     double precision, intent(in) :: Crd_qm( 3, N_qm ) ! qm coordinates
 (xyz)
     417     double precision, intent(in) :: Q_qm( N_qm )      ! qm electric par
 tial charges
     418     double precision, intent(in) :: Zeta_qm( N_qm )   ! qm aux slater e
 xponent
     419     double precision, intent(OUT) :: E                ! response energy
  contribution
     420     double precision, intent(OUT) :: Pot( N_qm )      ! effective monop
 olar potential correction to be mapped into the fock matrix
     421     double precision, intent(OUT) :: C( 3 * N_qm )    ! Response dipole
  coefs (zxy)
     422 !
     423 !  Local variables
     424 !
     425     integer :: N
     426     double precision, ALLOCATABLE :: Eta(:, :), dEtadQa(:, :), dEtadQb(
 :, :), EtaInv(:, :), &
     427       M(:), Mmat(:, :), dMdQa(:), Q0(:)
     428     integer :: i, i1, i2, j, j1, j2
     429     Pot = 0.d0
     430     N = 3 * N_qm
     431     allocate( Eta(N, N), dEtadQa(N, N), dEtadQb(N, N), EtaInv(N, N), M(
 N), Mmat( N, N_qm ) )
     432     allocate( dMdQa(N), Q0( N_qm) )
     433     Q0( 1:N_qm ) = Q_qm( 1:N_qm )
     434     call Cpt_SecondOrderMatrix( N_qm, Id_qm, Crd_qm, Q_qm, Eta, dEtadQa
 , dEtadQb )
     435     call Cpt_FirstOrderMatrix( N_qm, Id_qm, Crd_qm, Q_qm, Zeta_qm, Mmat
 , dMdQa )
     436     call Invert_Symmetric_Matrix( N, Eta, EtaInv )
     437     M = matmul( Mmat, Q0 )
     438     C = -matmul(EtaInv, M )
     439     E =  dot_product( C, M ) + 0.5d0 * dot_product( C, matmul( Eta, C )
  )
     440     do i=1, N_qm
     441        i1 = (i-1)*3 + 1
     442        i2 = i1 + 2
     443        Pot(i) = Pot(i) + dot_product( C, Mmat(:, i) )
     444        Pot(i) = Pot(i) + dot_product( C(i1:i2), dMdQa(i1:i2) )
     445     end do
     446     do i=1, N_qm
     447        i1 = (i-1)*3 + 1
     448        i2 = i1 + 2
     449        do j=1, N_qm
     450           j1 = (j-1)*3 + 1
     451           j2 = j1 + 2
     452           Pot(i) = Pot(i) + 0.5d0 * dot_product(C(i1:i2), matmul(dEtadQ
 a(i1:i2, j1:j2), C(j1:j2)))
     453           Pot(j) = Pot(j) + 0.5d0 * dot_product(C(i1:i2), matmul(dEtadQ
 b(i1:i2, j1:j2), C(j1:j2)))
     454        end do
     455     end do
 
 FORCHECK PC V13.5.13                          2021-03-24 10:59:30   page:  3724
 CPE_Energy.F90  /FF
 
     456   end subroutine CPE_QdepDipole_Contribution
 
