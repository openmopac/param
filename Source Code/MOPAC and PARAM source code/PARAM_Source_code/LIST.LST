    1824       subroutine betcom(u1, g1, u2, g2, nclose, norbs, term)
    1825 !-----------------------------------------------
    1826 !   M o d u l e s
    1827 !-----------------------------------------------
    1828 !
    1829 ! THIS SUBROUTINE CALCULATES TRACE OF UGU MATRICES
    1830 !
    1831 !-----------------------------------------------
    1832 !   I n t e r f a c e   B l o c k s
    1833 !-----------------------------------------------
    1834       implicit none
    1835 !-----------------------------------------------
    1836 !   D u m m y   A r g u m e n t s
    1837 !-----------------------------------------------
    1838       integer  :: nclose
    1839       integer  :: norbs
    1840       double precision , intent(out) :: term
    1841       double precision  :: u1(norbs,norbs)
    1842       double precision  :: g1(norbs,norbs)
    1843       double precision  :: u2(norbs,norbs)
    1844       double precision  :: g2(norbs,norbs)
    1845 !-----------------------------------------------
    1846 !   L o c a l   V a r i a b l e s
    1847 !-----------------------------------------------
    1848       double precision :: t1a, t2a, t3a, t1b, t2b, t3b
    1849       double precision, external :: trugud, trudgu, trugdu
    1850 !-----------------------------------------------
    1851       t1a = trudgu(u2,g1,u1,nclose,norbs,norbs)
    1852       t2a = trugud(u1,g1,u2,nclose,norbs,norbs)
    1853       t3a = trugdu(u1,g2,u1,nclose,norbs,norbs)
    1854       t1b = trudgu(u2,g1,u1,norbs,nclose,norbs)
    1855       t2b = trugud(u1,g1,u2,norbs,nclose,norbs)
    1856       t3b = trugdu(u1,g2,u1,norbs,nclose,norbs)
    1857       term = 2.0D0*(t1b - t1a + t2b - t2a + t3a - t3b)
    1858       return
    1859       end subroutine betcom
 
