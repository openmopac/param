 excite.F90  /FF
 
 n ****
     865 !         **** alpha beta alpha beta .... as used also in ALIGN functio
 n ****
     866 !         **** first, ensure that only 2 alpha orbs are different ****
     867           ndiff = 0
     868           do k = 1, nov
     869             if (ao1(k, i) .neqv. ao1(k, j)) ndiff = ndiff + 1
     870           end do
     871           s2(i, j) = 0.D0
     872           if (ndiff.eq.2) s2(i, j) = 1.D0
     873           s2(j, i) = s2(i, j)
     874         end do
     875       end do
     876
     877 !     **** if degenerate energy eigenvalues, then form S**2 in eigvec b
 asis ****
     878
     879       tol = 1.d-5
     880       il = 1
     881       do while (il < nperm)
     882         ih = il + 1
     883         do while (ih.le.nperm .and. abs(eval(il) - eval(ih))  <  tol)
     884           ih = ih + 1
     885         end do
     886         if (ih > nperm .or. abs(eval(il) - eval(ih))  >  tol) ih = ih -
  1
     887         ndeg = ih - il + 1
     888         if (ndeg > 1) then
     889 !         **** found NDEG degenerate eigenvalues, form S**2 in evec bas
 is ****
     890           i0 = il - 1
     891           do i = 1, ndeg
     892             do j = 1, i
     893               s2eig(i, j) = 0.D0
     894               do k1 = 1, nperm
     895                 s1 = 0.D0
     896                 do k2 = 1, nperm
     897                   s1 = s1 + s2(k1, k2) * h(k2, i0 + j)
     898                 end do
     899                 s2eig(i, j) = s2eig(i, j) + h(k1, i0 + i) * s1
     900               end do
     901             end do
     902           end do
     903 !         **** diagonalize S**2 in eigvec basis ****
     904           call tred2e (mspn, ndeg, s2eig, s2eval, wk, s2eig)
     905           call tql2e  (mspn, ndeg,      s2eval, wk, s2eig, ier)
     906 !         **** transform energy eigvecs to be eigvecs of S**2 also ****
     907           do j = 1, nperm
     908             do i = 1, ndeg
     909               wk(i) = 0.D0
     910               do k = 1, ndeg
     911                 wk(i) = wk(i) + s2eig(k, i) * h(j, i0 + k)
     912               end do
     913             end do
     914             do i = 1, ndeg
     915               h(j, i0 + i) = wk(i)
     916             end do
     917           end do
     918         end if
 
 FORCHECK PC V13.5.13          SPCLAS          2021-03-24 10:59:30   page:  2489
 excite.F90  /FF
 
     919
     920         il = il + ndeg
     921       end do
     922
     923 !     **** determine diag element of transformed S**2 matrix ****
     924
     925       tol = 1.d-5
     926       do i = 1, nperm
     927         wk(i) = 0.D0
     928         do j = 1, nperm
     929           s1 = 0.D0
     930           do k = 1, nperm
     931             s1 = s1 + s2(k, j) * h(k, i)
     932           end do
     933           wk(i) = wk(i) + h(j, i) * s1
     934         end do
     935 !       **** use S**2 = s(s + 1) and spin mult = 2s + 1 to get multipli
 city ****
     936         wk(i) = sqrt (1.D0 + 4.D0*wk(i))
     937       end do
     938
     939 !     **** check for non - integral multiplicity ****
     940
     941       do i = 1, nperm
     942         if (abs(mod(wk(i) + tol, 1.D0))  >  2*tol) then
     943           write (iw, *) 'ERROR in S^2 eigenvalue', (sngl(wk(j)), j=1, n
 perm)
     944           do k = 1, nperm
     945             write (iw, *) k, (ao1(j, k), j=1, nov), '  ', (bo1(j, k), j
 =1, nov)
     946           end do
     947           stop 'spin in SPCLAS'
     948         end if
     949       end do
     950
     951 500   continue
     952
     953 !     **** select only eigvecs of the correct multiplicity
  ****
     954 !     **** CI: store in mastor store, truncating by max nber and energy
  ****
     955 !     **** PM2: evaluate interactions with chosen states
  ****
     956       do ip = 1, nperm
     957         if (nint(wk(ip)) .eq. multci) then
     958
     959 !           *********** store the state in CI master index ***********
     960
     961             call sortst (jconf, eval(ip), e, ao1, bo1, aocc, bocc, nper
 m, &
     962      &        nspn, h(1, ip), spintr, irefd, krefd, iisym, istsym, isre
 fd)
     963
     964         end if
     965       end do
     966       return
     967       end subroutine spclas
 
