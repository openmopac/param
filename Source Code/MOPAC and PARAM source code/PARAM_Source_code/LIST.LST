     349 !       Update array geo
     350           do i = 1, nvar
     351             geo(loc(2,i) ,loc(1,i)) = xparam(i)
     352           end do
     353           call symtry
     354         else
     355 !
     356 !  Call compfg to re-set all calculated quantities
     357 !
     358           last = 1
     359           call compfg (xparam, .true., escf, .true., grad, .false.)
     360           write (iw, "(//10X,'CURRENT BEST VALUE OF HEAT OF FORMATION =
 '   ,F14.6)") escf - stress
     361           if ( prt_coords) then
     362             write(iw,*)
     363             call geout (iw)
     364             write(iw,*)
     365           end if
     366         end if
     367       else
     368         m = 0
     369         if (iflepo /= -1 .and. .not. mozyme ) then
     370 !
     371 ! Job did not run out of time.  The energy levels are incorrect - the S
 HIFT is still working
     372 ! so do a single SCF calculation to re-set the energy levels.
     373 !
     374           last = 1
     375           call compfg (xparam, .true., escf, .true., grad, .false.)
     376         end if
     377       end if
     378       if (iflepo == -1) then
 
 FORCHECK PC V13.5.13          LBFGS           2021-03-24 10:59:30   page:  2887
 lbfgs.F90  /FF
 
     379         if (m == 1) then
     380           write (iw, "(//10X,'CURRENT BEST VALUE OF HEAT OF FORMATION =
 '   ,F14.6)") escf - stress
     381         else
     382           write (iw, "(//10X,'CURRENT VALUE OF HEAT OF FORMATION ='   ,
 F14.6)") escf - stress
     383         end if
     384         if (prt_gradients .and. index(keywrd," GRADI") /= 0 .and. mozym
 e) then
     385           write (iw, '(3/7X,''CURRENT  POINT  AND  DERIVATIVES'',/)')
     386           call prtgra ()
     387         end if
     388         call geout (iw)
     389         write(iw,*)
     390       end if
     391       deallocate (best_xparam, best_gradients, best_nc, stat=alloc_stat
 )
     392       return
     393     end subroutine lbfgs
 
