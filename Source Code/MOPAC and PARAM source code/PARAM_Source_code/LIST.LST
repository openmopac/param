       1       subroutine symtrz(vects, eigs, itype, geteig)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE molkst_C, only : numat, norbs, keywrd, moperr
       6       use meci_C, only : lab, maxci
       7       use common_arrays_C, only : nfirst, nlast, coord, nat, atmass
       8       USE symmetry_C, only :  jndex, nclass, elem, namo, jelem
       9       USE chanel_C, only : iw
      10 !-----------------------------------------------
      11 !   I n t e r f a c e   B l o c k s
      12 !-----------------------------------------------
      13       implicit none
      14 !-----------------------------------------------
      15 !   D u m m y   A r g u m e n t s
      16 !-----------------------------------------------
      17       integer, intent (in)  :: itype
      18       logical, intent(in) :: geteig
      19       double precision  :: vects(*)
      20       double precision  :: eigs(*)
      21 !-----------------------------------------------
      22 !   L o c a l   V a r i a b l e s
      23 !-----------------------------------------------
      24       integer :: k, ierror, i, j, nvecs, nat_store(numat)
      25       double precision, dimension(3,numat) :: cotim
      26       double precision, dimension(3,3) :: r
      27 !-----------------------------------------------
      28 !**************************************************************
      29 !                                                             *
      30 !     DETERMINE POINT GROUP & SYMMETRIZE ORBITALS             *
      31 !                                                             *
      32 !**************************************************************
      33 !
      34 !    On input:   COORD  = Cartesian coordinates of atoms in system
      35 !                VECTS  = Eigenvectors
      36 !                ITYPE  = 1 for Molecular Orbitals
      37 !                         2 for vibrational normal coordinates
      38 !                         3 for State Functions.
      39 !                GETEIG = .TRUE. if eigenvector analysis wanted.
      40 !    On output   NAME   = Point Group Symbol as 4-character string
      41 !                NAMO   = Irreducible Representations of Eigenvectors
      42 !                         as 4-character strings
      43 !                JNDEX  = Principal Quantum Number of each I.R.
      44 !
      45 !
      46 !**************************************************************
      47 !
      48 !   Store cartesian geometry
      49 !
      50
      51       cotim(:,1:numat) = coord(:,1:numat)
      52 !
      53 !    Identify Molecular Point Group
      54 !
      55       nat_store(1:numat) = nat(1:numat)
      56 !
      57 !  Change the atomic number to a function of the isotope.
      58 !  The multiplier "20" was chosen so that an isotope that was different
 
 FORCHECK PC V13.5.13          SYMTRZ          2021-03-24 10:59:30   page:  3314
 symtrz.F90  /FF
 
  by
      59 !  0.05 amu would be considered a different type of atom.
      60 !  Do not make the multiplier much larger because a large value would u
 pset
      61 !  the detection of symmetry operations.
      62 !
      63       if (size(jelem) < numat*20) return
      64       do i = 1, numat
      65         nat(i) = nat(i)*20 + Nint(atmass(i)*20.d0)
      66       end do
      67       call molsym (cotim, ierror, r)
      68       nat(:numat) = nat_store
      69       if (moperr) return
      70       if (allocated(namo)) deallocate (namo)
      71       if (allocated(jndex)) deallocate (jndex)
      72       i = max(norbs, maxci + 20,3*numat, lab)
      73       allocate(namo(i), jndex(i))
      74       j = size(jndex)
      75       namo = ' '
      76       do i = 1, j
      77         jndex(i) = i
      78       end do
      79 !
      80 !   A Point-Group has been positively identified.  Now to
      81 !   make the symmetry-operations (as vectors in ELEM).
      82 !
      83       if ((geteig .or. itype == 2) .and. ierror == 0) call makopr (numa
 t, cotim, ierror, r)
      84 !
      85 !    Return to the user, if wanted, the symmetry operations for
      86 !    the system.  The operations are relative to the cartesian
      87 !    coordinate system supplied in COORD.
      88 !
      89       if (itype == 2 .and. .not.geteig) then
      90         if (index(keywrd,'SYMTRZ') /= 0) then
      91           write (iw, *) ' Symmetry Operations in SYMTRZ'
      92           do i = 1, nclass
      93             write (iw, *) ' Operation:', i
      94             write (iw, '(3F12.6)') ((elem(j,k,i),j=1,3),k=1,3)
      95           end do
      96           write (iw, *) ' Orientation Matrix'
      97           write (iw, '(3F12.6)') r
      98         end if
      99         do i = 2, nclass
     100           call mult33 (r, i)
     101         end do
     102         if (index(keywrd,'SYMTRZ') /= 0) then
     103           write (iw, *) ' Symmetry Operations for FORCE calculation'
     104           write (iw, *) ' Operation:', i
     105           do i = 1, nclass
     106             write (iw, '(3F12.6)') ((elem(j,k,i),j = 1,3),k = 1,3)
     107           end do
     108         end if
     109       end if
     110 !
     111 !    Characterize Eigenvectors
     112 !
     113       if (ierror == 0 .and. geteig) then
     114         if (itype == 2) then
 
 FORCHECK PC V13.5.13          SYMTRZ          2021-03-24 10:59:30   page:  3315
 symtrz.F90  /FF
 
     115 !
     116 !   In vibrational analyses, each atom has three modes, x, y, and z.
     117 !
     118       jndex(:numat) = 3
     119           nvecs = 3*numat
     120         else
     121 !
     122 !    In Molecular Orbital analyses, atoms have bases sets of
     123 !    atomic orbitals.
     124 !
     125           jndex(:numat) = nlast(:numat) - nfirst(:numat) + 1
     126           nvecs = norbs
     127         end if
     128         if (nvecs >= 1) then
     129           i = nvecs
     130           if (itype == 3) i = lab
     131           call symoir (itype, vects, eigs, nvecs, r, i)
     132         end if
     133       end if
     134       return
     135       end subroutine symtrz
 
