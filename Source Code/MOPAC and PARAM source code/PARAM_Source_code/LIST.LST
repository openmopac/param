       1       subroutine sp_two_electron
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use parameters_C, only : zsn, zpn, gss, gsp, gpp, gp2, hsp, &
       6       main_group
       7       use mndod_C, only : iii
       8 !-----------------------------------------------
       9 !   I n t e r f a c e   B l o c k s
      10 !-----------------------------------------------
      11       implicit none
      12 !-----------------------------------------------
      13 !   L o c a l   V a r i a b l e s
      14 !-----------------------------------------------
      15       integer :: ni, ns
      16       double precision :: es, ep, r033, r233
      17       double precision, external :: rsc
      18 !
      19       do ni = 1, 80
      20         ns = iii(ni)
      21         es = zsn(ni)
      22         ep = zpn(ni)
      23         if (es < 1.d-4 .or. ep < 1.d-4 .or. main_group(ni)) cycle
      24         gss(ni) = rsc(0,ns,es,ns,es,ns,es,ns,es)
      25         gsp(ni) = rsc(0,ns,es,ns,es,ns,ep,ns,ep)
      26         hsp(ni) = rsc(1,ns,es,ns,ep,ns,es,ns,ep)/3.D0
      27         r033 = rsc(0,ns,ep,ns,ep,ns,ep,ns,ep)
      28         r233 = rsc(2,ns,ep,ns,ep,ns,ep,ns,ep)
      29         gpp(ni) = r033 + 0.16D0*r233
      30         gp2(ni) = r033 - 0.08D0*r233
      31       end do
      32       return
      33       end subroutine sp_two_electron
 
