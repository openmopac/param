     290   function energy_corr_hh_rep(l_grad, dxyz)
     291     use common_arrays_C, only: nat, cell_ijk, Vab
     292     use molkst_C, only : numat, keywrd, e_hh, l123, l1u, l2u, l3u
     293     use chanel_C, only : iw
     294     use elemts_C, only: elemnt
     295     implicit none
     296     logical, intent (in) :: l_grad
     297     double precision, intent (inout) :: dxyz(3, numat*l123)
     298     double precision :: grad_hh(3, numat*l123)
     299     double precision :: e_corr, r, d_rad, g(3), energy_corr_hh_rep
     300     integer :: i, j, iii, jjj, i_cell, j_cell, kkkk
     301     double precision, external :: distance, poly
     302     e_hh = 0.d0
     303     grad_hh = 0.d0
     304 !
     305 ! Iterate over H atoms twice
     306 !
     307     do i = 1, numat
     308       if (nat(i) /= 1) cycle
     309       do j = 1, i - 1
     310         if (nat(j) /= 1) cycle
     311 !
     312 ! Calculate distance
     313 !
     314         r = distance(j, i)
     315         if (cell_ijk(1) /= 0) then
     316           continue
     317         end if
     318
     319         e_corr = poly(r, l_grad, d_rad)
     320         e_hh = e_hh + e_corr
     321         if (l_grad) then
     322 !
     323 ! Cartesian components of the gradient
     324 !
     325           g(:) = Vab(:)/r*d_rad
     326 !
     327 ! Add pair contribution to the global gradient
     328 !
     329           iii = l123*(i - 1)
     330           jjj = l123*(j - 1)
     331           kkkk = (l3u - cell_ijk(3)) + (2*l3u + 1)*(l2u - cell_ijk(2) +
  (2*l2u + 1)*(l1u - cell_ijk(1))) + 1
     332           i_cell = iii + kkkk
     333           j_cell = jjj + kkkk
     334           grad_hh(:,i_cell) = grad_hh(:,i_cell) - g(:)
     335           grad_hh(:,j_cell) = grad_hh(:,j_cell) + g(:)
     336         end if
     337       end do
     338     end do
     339     energy_corr_hh_rep = e_hh
     340     if (l_grad) then
     341       dxyz = dxyz + grad_hh
     342       if (index(keywrd, " DERIV") > 0) then
     343         write (iw, '(/25X,a)')"HH REPULSION"
     344         write (iw, '(" NUMBER  ATOM  ",5X,"X",12X,"Y",12X,"Z",/)')
     345         write (iw, '(I6,4x,a2,F13.6,2F13.6)') (i, elemnt(nat(i)), grad_
 hh(:,i), i = 1,numat)
 
 FORCHECK PC V13.5.13    ENERGY_CORR_HH_REP    2021-03-24 10:59:30   page:   667
 H_bonds4.F90  /FF
 
     346       end if
     347     end if
     348     return
     349   end function energy_corr_hh_rep
 
