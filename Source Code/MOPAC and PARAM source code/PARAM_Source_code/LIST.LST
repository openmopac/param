       1       subroutine deri0(e, n, scalar, diag, fract, nbo)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       implicit none
       6 !-----------------------------------------------
       7 !   D u m m y   A r g u m e n t s
       8 !-----------------------------------------------
       9       integer , intent(in) :: n
      10       double precision , intent(in) :: fract
      11       integer , intent(in) :: nbo(3)
      12       double precision , intent(in) :: e(n)
      13       double precision , intent(out) :: scalar(*)
      14       double precision , intent(inout) :: diag(*)
      15 !-----------------------------------------------
      16 !   L o c a l   V a r i a b l e s
      17 !-----------------------------------------------
      18       integer :: nopen, l, j, i
      19       double precision :: shift, const
      20 !-----------------------------------------------
      21 !
      22 !     COMPUTE THE DIAGONAL DOMINANT PART OF THE SUPER-MATRIX AND
      23 !     DEFINE THE SCALAR COEFFICIENTS APPLIED ON EACH ROW OF THE
      24 !     SUPER LINEAR SYSTEM IN ORDER TO REDUCE THE EIGENVALUE SPECTRUM OF
      25 !     THE ELECTRONIC HESSIAN,
      26 !     THUS SPEEDING CONVERGENCE OF RELAXATION PROCESS IN 'DERI2'.
      27 !  INPUT
      28 !     E(N)             : EIGENVALUES OF FOCK MATRIX.
      29 !     N                : NUMBER OF M.O.
      30 !     NBO(3)           : OCCUPANCY BOUNDARIES.
      31 !     FRACT            : PARTIAL OCCUPANCY OF 'OPEN' SHELLS.
      32 !     SCALAR(MINEAR)   : SCALE APPLIED ON EACH COLUMN AND ROW OF THE
      33 !                        SYMMETRIC SUPER SYSTEM.
      34 !
      35       shift = 2.36D0
      36 !
      37 !     DOMINANT DIAGONAL PART OF THE SUPER-MATRIX.
      38 !     -------------------------------------------
      39       nopen = nbo(1) + nbo(2)
      40       const = 1.D-3
      41       l = 1
      42       if (nbo(2)>0 .and. nbo(1)>0) then
      43 !        OPEN-CLOSED
      44         do j = 1, nbo(1)
      45           if (nopen - nbo(1) > 0) then
      46             diag(l:nopen-nbo(1)-1+l) = (e(nbo(1)+1:nopen)-e(j))/(2.D0 -
  fract&
      47                + const)
      48             l = nopen - nbo(1) + l
      49           end if
      50         end do
      51       end if
      52       if (nbo(3)>0 .and. nbo(1)>0) then
      53 !        VIRTUAL-CLOSED
      54         do j = 1, nbo(1)
      55           if (n - nopen > 0) then
      56             diag(l:n-nopen-1+l) = (e(nopen+1:n)-e(j))/2.D0
      57             l = n - nopen + l
 
 FORCHECK PC V13.5.13          DERI0           2021-03-24 10:59:30   page:   702
 deri0.F90  /FF
 
      58           end if
      59         end do
      60       end if
      61       if (nbo(3)/=0 .and. nbo(2)/=0) then
      62 !        VIRTUAL-OPEN
      63         do j = nbo(1) + 1, nopen
      64           if (n - nopen > 0) then
      65             diag(l:n-nopen-1+l) = (e(nopen+1:n)-e(j))/(fract + const)
      66             l = n - nopen + l
      67           end if
      68         end do
      69       end if
      70 !
      71 !     TAKE SCALE FACTORS AS (SHIFT-DIAG)**(-0.5) .
      72 !     ------------------------------------------
      73       do i = 1, l - 1
      74         scalar(i) = sqrt(1.D0/max(0.3D0*diag(i),diag(i)-shift))
      75       end do
      76       return
      77       end subroutine deri0
 
 FORCHECK PC V13.5.13          DERI0           2021-03-24 10:59:30   page:   703
