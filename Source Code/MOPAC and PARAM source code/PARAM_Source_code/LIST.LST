      84 subroutine find_H__Y_bonds(acc_a, nacc_a, acc_b, nacc_b, bonding_a_h, n
 b_a_h, hblist1, hblist2, hblist3, max_h_bonds, nrpairs)
      85 !
      86 !  Find all sets of three atoms that form a hydrogen bond
      87 !
      88 !   acc_a:       All O and N atoms
      89 !   bonding_a_h: Hydrogen atoms bonded to acc_a, not in any particular
 order
      90 !
      91   use chanel_C, only : iw
      92   use funcon_C, only : pi
      93   use molkst_C, only : keywrd, method_pm7
      94   implicit none
      95   integer :: nacc_a, nacc_b, nb_a_h, nrpairs, max_h_bonds
      96   integer :: acc_a(nacc_a), acc_b(nacc_b), bonding_a_h(nb_a_h), hblist1
 (max_h_bonds), hblist2(max_h_bonds), hblist3(max_h_bonds)
      97   integer:: ii, i, jj, j, kk, k, i1
      98   double precision :: RAH, cutoff
      99   logical, external :: connected
     100   double precision, external :: angle
     101   if (index(keywrd, "PM6-DH+") /= 0 ) then
     102       RAH = 1.4d0
     103       cutoff = 10.d0
     104     else if (method_PM7) then
     105       RAH = 1.4d0
     106       cutoff = 7.d0
     107     else
     108 !
     109 !  "cutoff" had been set to 7.0, but that had caused problems with the
 radial term "e_radial"
     110 !  in H_bonds4.F90.  "e_radial" increases sharply beyond 5.5 Angstroms.
     111 !
     112       RAH = 1.15d0
     113       cutoff = 5.5d0
     114     end if
     115     do ii = 1, nacc_a
     116       i = acc_a(ii)   !  i = Acceptor atom bonded to H
     117       do jj = 1, nb_a_h
     118         j = bonding_a_h(jj)   !  j = Hydrogen bond to acceptor atom
     119         if (connected(i, j, RAH**2)) then
     120           do kk = 1, nacc_b
     121             k = acc_b(kk)
     122             if (k /= i) then
     123               if (connected(k, i, cutoff**2)) then
     124                 if (angle(k,j,i) > pi*0.5d0) then
     125 !
     126 !  Eliminate bonds of type O(n) - H - O(m) if O(m) - H - O(n) exists
     127 !
     128                   do i1 = 1, nrpairs
     129                     if (hblist2(i1) /= j) cycle
     130                     if (hblist1(i1) /= k) cycle
     131                     if (hblist3(i1) /= i) cycle
     132                     exit
     133                   end do
     134                   if (i1 /= nrpairs + 1) cycle
     135                   do i1 = 1, nrpairs
     136                     if (hblist2(i1) /= j) cycle
     137                     if (hblist1(i1) /= i) cycle
 
 FORCHECK PC V13.5.13     FIND_H__Y_BONDS      2021-03-24 10:59:30   page:  3739
 H_bond_correction_bits.F90  /FF
 
     138                     if (hblist3(i1) /= k) cycle
     139                     exit
     140                   end do
     141                   if (i1 /= nrpairs + 1) cycle
     142                   nrpairs = nrpairs + 1 !  k = Distant acceptor atom
     143                   if (nrpairs > max_h_bonds) then
     144                     call mopend("The default array size for hydrogen bo
 nds is too small")
     145                     write(iw,'(9x,a,i6,a,i6)')" Array size:", max_h_bon
 ds,", estimated size needed:", &
     146                       nint(float(max_h_bonds)*float(nacc_a)/float(ii))
     147                     nrpairs = nrpairs - 1
     148                     return
     149                   end if
     150                   hblist3(nrpairs) = k ! O or N hydrogen-bonded to hydr
 ogen j
     151                   hblist2(nrpairs) = j ! H singly bonded to i
     152                   hblist1(nrpairs) = i ! O or N of single bond to H
     153                 end if
     154               end if
     155             end if
     156           end do
     157         end if
     158       end do
     159     end do
     160     return
     161   end subroutine find_H__Y_bonds
 
