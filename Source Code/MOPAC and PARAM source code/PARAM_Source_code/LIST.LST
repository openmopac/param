 cut)
       2       implicit none
       3       integer  :: nvar_nvo
       4       integer  :: minear
       5       integer , intent(in) :: ifirst
       6       integer  :: ncut
       7       double precision  :: a(minear,nvar_nvo)
       8       double precision  :: vnert(nvar_nvo)
       9       double precision  :: pnert(nvar_nvo)
      10       double precision  :: b(minear,nvar_nvo)
      11 !
      12       integer :: i, l
      13       double precision, dimension(4) :: work
      14       double precision :: cutoff, sum2, sum
      15 !**********************************************************************
 *
      16 !
      17 !     LEAST-SQUARE ANALYSIS OF A SET OF ANALYTICAL POINTS {A} :
      18 !
      19 !     PRODUCE A SUBSET OF NCUT ORTHONORMALIZED VECTORS B, OPTIMUM IN A
      20 !     LEAST-SQUARE SENSE WITH RESPECT TO THE INITIAL SPACE {A}.
      21 !     EACH NEW HIERARCHIZED VECTOR B EXTRACTS A MAXIMUM PERCENTAGE FROM
      22 !     THE REMAINING DISPERSION OF THE SET {A} OUT OF THE PREVIOUS
      23 !     {B} SUBSPACE.
      24 !   INPUT
      25 !     A(MINEAR,nvar_nvo): ORIGINAL SET {A}.
      26 !     ifirst        : MAXIMUM ALLOWED SIZE OF THE BASIS B.
      27 !   OUTPUT
      28 !     VNERT(nvar_nvo)   : LOWEST EIGENVECTOR OF A'* A.
      29 !     PNERT(nvar_nvo)     : SQUARE ROOT OF THE ASSOCIATED EIGENVALUES
      30 !                     IN DECREASING ORDER.
      31 !     B(MINEAR,NCUT): OPTIMUM ORTHONORMALIZED SUBSET {B}.
      32 !
      33 !**********************************************************************
 *
      34 !
      35 !     VNERT = A' * A
      36       cutoff = 0.85D0
      37       sum2 = 0.D0
      38       call mtxmc (a, nvar_nvo, a, minear, work)
      39       work(:(nvar_nvo*(nvar_nvo + 1))/2) = -work(:(nvar_nvo*(nvar_nvo +
  1))/2)
      40 !     DIAGONALIZE IN DECREASING ORDER OF EIGENVALUES
      41       if (abs(work(1))<1.D-28 .and. nvar_nvo==1) then
      42         pnert(1) = sqrt((-work(1)))
      43         work(1) = 1.D15
      44         vnert(1) = 1.D0
      45         ncut = 1
      46         go to 50
      47       else
      48         call rsp (work, nvar_nvo, pnert, vnert)
      49 !     FIND NCUT ACCORDING TO CUTOFF, BUILD WORK = VNERT * (PNERT)**-0.5
      50         sum = 0.D0
      51         do i = 1, nvar_nvo
      52           sum = sum - pnert(i)
      53         end do
      54         l = 1
 
 FORCHECK PC V13.5.13          DERI21          2021-03-24 10:59:30   page:    28
 deri21.F90  /FF
 
      55         do i = 1, ifirst
      56           sum2 = sum2 - pnert(i)/sum
      57           pnert(i) = sqrt(Abs(pnert(i)))
      58           if (nvar_nvo > 0) then
      59             work(l:nvar_nvo-1+l) = vnert(l:nvar_nvo-1+l)/pnert(i)
      60             l = nvar_nvo + l
      61           end if
      62           if (sum2 < cutoff) cycle
      63           ncut = i
      64           go to 50
      65         end do
      66         ncut = ifirst
      67 !     ORTHONORMALIZED BASIS
      68 !     B(MINEAR,NCUT) = A(MINEAR,nvar_nvo)*WORK(nvar_nvo,NCUT)
      69       end if
      70    50 continue
      71       call mxm (a, minear, work, nvar_nvo, b, ncut)
      72       return
      73       end subroutine deri21
 
