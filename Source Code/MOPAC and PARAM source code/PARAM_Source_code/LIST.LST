    1069 subroutine write_cell(iprt)
    1070   use molkst_C, only: mol_weight, escf, numat, keywrd, gnorm, &
    1071    line, mers, gui, density
    1072   use funcon_C, only: fpc_10
    1073   use common_arrays_C, only: nat, tvec
    1074   use ef_C, only : nstep
    1075   implicit none
    1076   integer, intent(in) :: iprt
    1077   integer :: i, j, k, l, z, m, old_nstep = -1
    1078   double precision :: ta, tb, tc, tab, tbc, tac, talpha, tbeta, tgamma,
  vol
    1079   integer, dimension (100) :: nel
    1080   double precision, external :: reada, volume
    1081   save :: old_nstep
    1082   if (iprt < 0 .or. gui) return
    1083   if (iprt == 0) then
    1084     if(old_nstep == nstep) return
    1085     old_nstep = nstep
    1086   end if
    1087
    1088 !
    1089 !  Write out unit cell lengths and angles
    1090 !
    1091   ta = Sqrt(tvec(1,1)**2 + tvec(2,1)**2 + tvec(3,1)**2)
    1092   tb = Sqrt(tvec(1,2)**2 + tvec(2,2)**2 + tvec(3,2)**2)
    1093   tc = Sqrt(tvec(1,3)**2 + tvec(2,3)**2 + tvec(3,3)**2)
    1094   tab = Sqrt((tvec(1,1)-tvec(1,2))**2 + (tvec(2,1)-tvec(2,2))**2 + (tve
 c(3,1)-tvec(3,2))**2)
    1095   tac = Sqrt((tvec(1,1)-tvec(1,3))**2 + (tvec(2,1)-tvec(2,3))**2 + (tve
 c(3,1)-tvec(3,3))**2)
    1096   tbc = Sqrt((tvec(1,3)-tvec(1,2))**2 + (tvec(2,3)-tvec(2,2))**2 + (tve
 c(3,3)-tvec(3,2))**2)
    1097   talpha = 57.295779513d0*Acos((tb**2 + tc**2 - tbc**2)/(2*tc*tb))
    1098   tbeta  = 57.295779513d0*Acos((ta**2 + tc**2 - tac**2)/(2*ta*tc))
    1099   tgamma = 57.295779513d0*Acos((ta**2 + tb**2 - tab**2)/(2*ta*tb))
    1100   tab = 1.d0
    1101   if (index(keywrd," BCC") /= 0) tab = 2.d0
    1102 !
    1103 !  Work out the empirical formula
    1104 !
    1105   i = Index(keywrd, " Z=")
    1106   if (i /= 0) then
    1107     i = Nint(reada(keywrd,i))
    1108     z = mers(1)*mers(2)*mers(3)*i
    1109     if (Index (keywrd, " BCC") /= 0) z = z/2
    1110   else
    1111     nel = 0
    1112     do i = 1, numat
    1113       nel(nat(i)) = nel(nat(i)) + 1
    1114     end do
    1115     j = 0
    1116     do i = 1, 100
    1117       if (nel(i) > 0) then
    1118         j = j + 1
    1119         nel(j) = nel(i)
    1120        end if
    1121     end do
    1122     k = 10000
 
 FORCHECK PC V13.5.13        WRITE_CELL        2021-03-24 10:59:30   page:  3871
 moldat.F90  /FF
 
    1123     do i = 1, j
    1124       if(nel(i) < k) k = nel(i)
    1125     end do
    1126 !
    1127 !  k is the smallest number of atoms of any element in the formula
    1128 !
    1129     do i = 1, 20
    1130       m = 0
    1131       do l = 1, j
    1132         if (Abs((i*nel(l))/k - (i*1.d0*nel(l))/k) > 1.d-5) m = 1
    1133       end do
    1134       if (m == 0) exit
    1135     end do
    1136 !
    1137 !  Number of empirical units  = k/i
    1138 !
    1139     z = k/i
    1140   end if
    1141   vol = volume (tvec, 3)
    1142   if (mers(1) > 0 .and. mers(2) > 0 .and. mers(3) > 0 .and. index(keywr
 d, " PRT ") == 0) then
    1143     if (gnorm > 1.d-20) then
    1144       write (line,'(i4,a,3f7.3,3f7.2,a,f8.2,a,f6.3,a,f10.3, a, f7.2)')n
 step + 1," a, b, c, alpha, beta, gamma:", &
    1145       & tab*ta/mers(1), tab*tb/mers(2), tab*tc/mers(3), talpha, tbeta,
 tgamma, &
    1146       " Vol:",vol/(mers(1)*mers(2)*mers(3))," Density:",mol_weight * 1.
 d24 / fpc_10 / vol, &
    1147       " HoF:",escf/z," Grad:",gnorm/sqrt(z*1.d0)
    1148       write(iprt,"(a)")line(:len_trim(line))
    1149     end if
    1150   end if
    1151   if (index(keywrd, " PRT ") /= 0) then
    1152     write (iprt, '(/10X,A,F15.3,A)') 'VOLUME OF UNIT CELL     =', &
    1153         vol/(max(1,mers(1))*max(1,mers(2))*max(1,mers(3))), ' CUBIC ANG
 STROMS'
    1154     write (iprt, '(/10X,A,F15.3,A)') 'DENSITY                 =', densi
 ty, ' GRAMS/CC'
    1155
    1156     write (iprt,'(28x, a, 8x, f7.3, a)')"  A   =", tab*ta/max(1,mers(1)
 ), " ANGSTROMS"
    1157     write (iprt,'(28x, a, 8x, f7.3, a)')"  B   =", tab*tb/max(1,mers(2)
 ), " ANGSTROMS"
    1158     write (iprt,'(28x, a, 8x, f7.3, a)')"  C   =", tab*tc/max(1,mers(3)
 ), " ANGSTROMS"
    1159     write (iprt,'(28x, a, 8x, f7.3, a)')"ALPHA =",talpha, " DEGREES"
    1160     write (iprt,'(28x, a, 8x, f7.3, a)')"BETA  =",tbeta , " DEGREES"
    1161     write (iprt,'(28x, a, 8x, f7.3, a)')"GAMMA =",tgamma, " DEGREES"
    1162     call l_control("PRT", 3, -1)
    1163   end if
    1164   return
    1165 end subroutine write_cell
 
