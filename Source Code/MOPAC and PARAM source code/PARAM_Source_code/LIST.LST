 FORCHECK PC V13.5.13          COSCAV          2021-03-24 10:59:30   page:  1602
 cosmo.F90  /FF
 
     413         area = area + ri2 * dirvec(4, j)
     414         din(j) = .true.
     415       end do loop
     416       if (narea /= 0) then
     417          !
     418          !  IF HYDROGEN, THEN USE THE SMALLER SET OF POINTS (NORMALLY
     419          !  12 POINTS), OTHERWISE, USE THE LARGER SET (NORMALLY 42 POIN
 TS)
     420          !
     421         i0 = 1
     422         if (nat(i) == 1) then
     423           i0 = 2
     424         end if
     425         jmax = n0(i0)
     426         i0 = (i0 - 1) * n0(1)
     427         do j = 1, jmax
     428           nps = nps + 1
     429           if (nps > lenabc) then
     430             call mopend ("NPS IS GREATER THAN LENABC - USE SMALLER NSPA
 ")
     431             go to 100
     432           else
     433             iatsp(nps) = i
     434             do ix = 1, 3
     435               xx(ix) = dirsm(ix, i0 + j)
     436             end do
     437             do ix = 1, 3
     438               cosurf(ix, nps) = xx(1) * tm(1, ix, i) + xx(2) * tm(2, ix
 , &
     439              & i) + xx(3) * tm(3, ix, i)
     440             end do
     441           end if
     442         end do
     443         niter = 0
     444         do
     445           niter = niter + 1
     446           do ips = nps0, nps
     447             nar_csm(ips) = 0
     448             phinet(ips, 1) = 0.d0
     449             phinet(ips, 2) = 0.d0
     450             phinet(ips, 3) = 0.d0
     451           end do
     452           do j = 1, 1082
     453             if (din(j)) then
     454               spm = -1.d0
     455               ipm = 0
     456               x1 = dirtm(1, j)
     457               x2 = dirtm(2, j)
     458               x3 = dirtm(3, j)
     459               do ips = nps0, nps
     460                 sp = x1 * cosurf(1, ips) + x2 * cosurf(2, ips) + x3 * c
 osurf &
     461                & (3, ips)
     462                 if (sp >= spm) then
     463                   spm = sp * (1.d0 + 1.d-14)
     464                   ipm = ips
     465                 end if
     466               end do
     467               iseg(j) = ipm
 
