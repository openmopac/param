     697       subroutine alphaf(iwfla, atol, maxita, u, f, g, uold, h1, d, da,
 w2, c, w)
     698 !-----------------------------------------------
     699 !   M o d u l e s
     700 !-----------------------------------------------
     701       use molkst_C, only : norbs, keywrd, nclose, numat
     702       use chanel_C, only : iw
     703       use funcon_C, only: a0, ev
     704       use common_arrays_C, only : eigs, nat, nfirst, nlast, coord
     705       USE polar_C, only : omega, alpavg
     706 !
     707 !  SUBROUTINE FOR THE CALCULATION OF THE FREQUENCY DEPENDENT FIRST-ORDE
 R
     708 !  RESPONCE MATRICIES UA AND DENSITIES DA.
     709 !  USED TO COMPUTE THE FREQUENCY DEPENDENT POLARIZABILITY AND FOR
     710 !  SOLVING THE SECOND-ORDER PROBLEM.
     711 !
     712 !-----------------------------------------------
     713 !   I n t e r f a c e   B l o c k s
     714 !-----------------------------------------------
     715       implicit none
     716 !-----------------------------------------------
     717 !   G l o b a l   P a r a m e t e r s
     718 !-----------------------------------------------
     719 !-----------------------------------------------
     720 !   D u m m y   A r g u m e n t s
     721 !-----------------------------------------------
     722       integer , intent(in) :: iwfla
     723       integer , intent(in) :: maxita
     724       double precision  :: atol
     725       double precision  :: u(norbs,norbs)
     726       double precision  :: f(norbs,norbs)
     727       double precision  :: g(norbs,norbs)
     728       double precision  :: uold(norbs,norbs)
     729       double precision  :: h1(norbs,norbs)
     730       double precision  :: d(norbs,norbs)
     731       double precision  :: da(norbs,norbs)
     732       double precision  :: w2(*)
     733       double precision  :: c(*)
     734       double precision  :: w(*)
     735 !-----------------------------------------------
     736 !   L o c a l   V a r i a b l e s
     737 !-----------------------------------------------
     738       integer :: nsqr, iposu, iposg, id, icount, ic, j, iexp
     739       double precision, dimension(3,3) :: allalp
     740       double precision :: cmptim, alpold, diff, alphaw, dela, &
     741       const
     742       logical :: last, debug
     743       character, dimension(3) :: alab
     744       double precision, external :: aval, pol_vol, seconds
     745
     746       save alab
     747 !-----------------------------------------------
     748 !
     749       data alab/ 'X', 'Y', 'Z'/
     750 !
     751       iexp = 0
     752       debug = index(keywrd,' DEBUG') /= 0
 
 FORCHECK PC V13.5.13          ALPHAF          2021-03-24 10:59:30   page:  2577
 polar.F90  /FF
 
     753       nsqr = norbs*norbs
     754       alpavg = 0.0D00
     755 ! COMPUTE OFFSETS FOR U AND G MATRICES
     756       iposu = 1 + 6*iwfla
     757       iposg = 4 + 6*iwfla
     758       write (iw, 10) omega
     759    10 format(/,' +++++ ALPHA AT ',1f13.5,' EV.')
     760 !
     761 !  CHOOSE A  COMPONENT
     762 !  X: ID=1   Y: ID=2   Z: ID=3
     763 !
     764       do id = 1, 3
     765         cmptim = seconds(1)
     766         last = .FALSE.
     767 !
     768 !  CALCULATE THE DIPOLE MATRIX.
     769 !
     770         call hmuf (h1, id, coord, nfirst, nlast, nat, norbs, numat)
     771         call copym (h1, f, norbs)
     772
     773 !
     774 !
     775 !  INITIALIZE UOLD TO ZERO
     776 !
     777         call zerom (uold, norbs)
     778 !.................................................................
     779 !  LOOP STARTS HERE
     780 !.................................................................
     781         icount = 0
     782         alpold = 0.0D00
     783         icount = icount + 1
     784         if (icount > maxita) last = .TRUE.
     785 !
     786 !  CREATE G MATRIX.
     787 !
     788         call transf (f, g, c, norbs)
     789 !
     790 !  FORM U MATRIX
     791 !
     792         call makeuf (u, uold, g, eigs, last, norbs, nclose, diff, atol)
     793 !
     794 !  FORM NEW DENSITY MATRIX
     795 !
     796         call densf (u, c, d, da, norbs, nclose, w2)
     797 !
     798 ! COMPUTE TEST ALPHA TO BE USED FOR A CONVERGENCE TEST
     799 !
     800         alphaw = aval(h1,d,norbs)
     801         dela = dabs(alpold - alphaw)
     802         alpold = alphaw
     803 !
     804 !  CREATE NEW FOCK MATRIX
     805 !
     806         f = 0.d0
     807         call ffreq2 (f, d, w)
     808         call ffreq1 (f, d, da, da, norbs)
     809         f = h1 + f/ev
     810         do while(.not.last)
     811           icount = icount + 1
 
 FORCHECK PC V13.5.13          ALPHAF          2021-03-24 10:59:30   page:  2578
 polar.F90  /FF
 
     812           if (icount > maxita) last = .TRUE.
     813 !
     814 !  CREATE G MATRIX.
     815 !
     816           call transf (f, g, c, norbs)
     817 !
     818 !  FORM U MATRIX
     819 !
     820           call makeuf (u, uold, g, eigs, last, norbs, nclose, diff, ato
 l)
     821 !
     822 !  FORM NEW DENSITY MATRIX
     823 !
     824           call densf (u, c, d, da, norbs, nclose, w2)
     825 !
     826 ! COMPUTE TEST ALPHA TO BE USED FOR A CONVERGENCE TEST
     827 !
     828           alphaw = aval(h1,d,norbs)
     829           dela = dabs(alpold - alphaw)
     830           alpold = alphaw
     831 !
     832 !  CREATE NEW FOCK MATRIX
     833 !
     834           call zerom (f, norbs)
     835           call ffreq2 (f, d, w)
     836           call ffreq1 (f, d, da, da, norbs)
     837           if (Abs(f(1,1)) > 1.d6) then
     838             call mopend("Calculation of polarizability failed (This par
 t of MOPAC is fragile)")
     839             return
     840           end if
     841           call hplusf (f, h1, norbs)
     842 !..............................................................
     843         end do
     844         cmptim = seconds(1) - cmptim
     845         if (debug) write (iw, 30) icount, cmptim, diff, dela
     846    30   format(/,' CONVERGED IN',i4,' ITERATIONS IN',f10.2,' SECONDS',/
 ,&
     847           '           DENSITY CONVERG. TO ',1p,d12.5,/,&
     848           '             ALPHA CONVERG. TO ',1p,d12.5,/)
     849 !
     850 ! COMPUTE ALPHA
     851 !
     852         alphaw = aval(h1,d,norbs)
     853         allalp(id,id) = alphaw
     854         if (debug) write (iw, 40) alab(id), alab(id), alphaw
     855    40   format('      ALPHA(',a1,',',a1,') = ',1p,d14.7)
     856         alpavg = alpavg + alphaw
     857 !
     858 !  WRITE OUT U AND G FOR FUTURE USE
     859 !
     860         call dawrit (u, nsqr, iposu + id)
     861         call dawrit (g, nsqr, iposg + id)
     862 !
     863 !  COMPUTE OTHER COMPONENTS
     864 !
     865         do ic = 1, 3
     866           if (ic == id) cycle
     867           call hmuf (h1, ic, coord, nfirst, nlast, nat, norbs, numat)
 
 FORCHECK PC V13.5.13          ALPHAF          2021-03-24 10:59:30   page:  2579
 polar.F90  /FF
 
     868           alphaw = aval(h1,d,norbs)
     869           allalp(ic,id) = alphaw
     870           if (debug) write (iw, 50) alab(ic), alab(id), alphaw
     871    50     format('      ALPHA(',a1,',',a1,') = ',1p,d14.7)
     872         end do
     873       end do
     874
     875       allalp(1,1) = pol_vol(allalp(1,1))
     876       allalp(2,2) = pol_vol(allalp(2,2))
     877       allalp(3,3) = pol_vol(allalp(3,3))
     878       alpavg = (allalp(1,1) + allalp(2,2) + allalp(3,3))/3.d0
     879       if (alpavg > 1.d6) then
     880         iexp = Nint (Log10(alpavg)) - 5
     881         const = 10.d0 ** (-iexp)
     882         write (iw, "(/27X, 'COMPONENTS OF ALPHA*10**(',I3,')',/)") - ie
 xp
     883       else
     884         const = 1.d0
     885         write (iw, "(/27X, 'COMPONENTS OF ALPHA',/)")
     886       end if
     887     write (iw, "(21X,'*X',11X,'*Y',11X,'*Z')")
     888     write (iw, "(10X,' *=X:',3F13.4)") (allalp(1, j)*const, j=1, 3)
     889     write (iw, "(10X,' *=Y:',3F13.4)") (allalp(2, j)*const, j=1, 3)
     890     write (iw, "(10X,' *=Z:',3F13.4)") (allalp(3, j)*const, j=1, 3)
     891      if (const < 0.9d0) then
     892       write (iw, 10035) - iexp, alpavg * const,alpavg * const*a0**3
     893 10035 format (/, "  ISOTROPIC AVERAGE ALPHA*10**(", I3, ") = ", f13.5,
