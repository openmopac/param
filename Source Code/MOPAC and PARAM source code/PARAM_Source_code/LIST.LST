       1 subroutine outer1 (ni_loc, nj, c1, c2, w, kr, e1b, e2a, enuc, mode, dir
 ect)
       2     use molkst_C, only: l1u, l2u, l3u, l_feather
       3     use parameters_C, only: natorb, tore, am
       4     use funcon_C, only: a0, ev
       5     use common_arrays_C, only: tvec
       6     implicit none
       7     logical, intent (in) :: direct
       8     integer, intent (in) :: mode, ni_loc, nj
       9     integer, intent (inout) :: kr
      10     double precision, intent (out) :: enuc
      11     double precision, dimension (*), intent (inout) :: w
      12     double precision, dimension (3), intent (in) :: c1, c2
      13     double precision, dimension (45), intent (out) :: e1b, e2a
      14 !
      15     integer :: i, j, k, l
      16     double precision :: aee, r, rij, ww, point, const
      17     double precision, dimension (3) :: c2s
      18     double precision, external :: trunk
      19     if (mode == 0) then
      20       !
      21       !                                            MOLECULAR TERM
      22       !
      23      e1b = 0
      24      e2a = 0
      25       !
      26       rij = Sqrt ((c1(1)-c2(1))**2+ (c1(2)-c2(2))**2+ (c1(3)-c2(3))**2)
      27       r = rij / a0
      28       !
      29       aee = 0.5d0 / am(ni_loc) + 0.5d0 / am(nj)
      30       aee = aee * aee
      31       ww = ev / Sqrt (r*r+aee)
      32       if (l_feather) then
      33         call to_point(rij, point, const)
      34         ww = ww*const + (1.d0 - const)*point
      35       end if
      36       e1b(1) = -ww * tore(nj)
      37       e1b(3) = -ww * tore(nj)
      38       e1b(6) = -ww * tore(nj)
      39       e1b(10) = -ww * tore(nj)
      40       e1b(15) = -ww * tore(nj)
      41       e1b(21) = -ww * tore(nj)
      42       e1b(28) = -ww * tore(nj)
      43       e1b(36) = -ww * tore(nj)
      44       e1b(45) = -ww * tore(nj)
      45       e2a(1) = -ww * tore(ni_loc)
      46       e2a(3) = -ww * tore(ni_loc)
      47       e2a(6) = -ww * tore(ni_loc)
      48       e2a(10) = -ww * tore(ni_loc)
      49       e2a(15) = -ww * tore(ni_loc)
      50       e2a(21) = -ww * tore(ni_loc)
      51       e2a(28) = -ww * tore(ni_loc)
      52       e2a(36) = -ww * tore(ni_loc)
      53       e2a(45) = -ww * tore(ni_loc)
      54       enuc = tore(ni_loc) * tore(nj) * ww
      55       !
      56       if ( .not. direct) then
      57         w(1) = ww
 
 FORCHECK PC V13.5.13          OUTER1          2021-03-24 10:59:30   page:  3602
 outer1.F90  /FF
 
      58         if (natorb(ni_loc)*natorb(nj) /= 0) then
      59           kr = kr + 1
      60         end if
      61       end if
      62     else
      63       !
      64       !                                            SOLID-STATE TERM
      65       !
      66       w(1) = 0.d0
      67       do i = 1, 10
      68         e1b(i) = 0.d0
      69         e2a(i) = 0.d0
      70       end do
      71       do i = -l1u, l1u
      72         do j = -l2u, l2u
      73           do k = -l3u, l3u
      74             do l = 1, 3
      75               c2s(l) = c2(l) + tvec(l, 1) * i + tvec(l, 2) * j + tvec(l
 , &
      76              & 3) * k - c1(l)
      77             end do
      78             r = Sqrt (c2s(1)**2+c2s(2)**2+c2s(3)**2)
      79             r = trunk (r)
      80                !
      81             w(1) = w(1) + a0 * ev / r
      82           end do
      83         end do
      84       end do
      85       e1b(1) = -w(1) * tore(nj)
      86       e1b(3) = -w(1) * tore(nj)
      87       e1b(6) = -w(1) * tore(nj)
      88       e1b(10) = -w(1) * tore(nj)
      89       e1b(15) = -w(1) * tore(nj)
      90       e1b(21) = -w(1) * tore(nj)
      91       e1b(26) = -w(1) * tore(nj)
      92       e1b(36) = -w(1) * tore(nj)
      93       e1b(45) = -w(1) * tore(nj)
      94       e2a(1) = -w(1) * tore(ni_loc)
      95       e2a(3) = -w(1) * tore(ni_loc)
      96       e2a(6) = -w(1) * tore(ni_loc)
      97       e2a(10) = -w(1) * tore(ni_loc)
      98       e2a(15) = -w(1) * tore(ni_loc)
      99       e2a(21) = -w(1) * tore(ni_loc)
     100       e2a(26) = -w(1) * tore(ni_loc)
     101       e2a(36) = -w(1) * tore(ni_loc)
     102       e2a(45) = -w(1) * tore(ni_loc)
     103       enuc = tore(ni_loc) * tore(nj) * w(1)
     104       if (natorb(ni_loc)*natorb(nj) /= 0) then
     105         kr = kr + 1
     106       end if
     107     end if
     108 !
     109 end subroutine outer1
 
