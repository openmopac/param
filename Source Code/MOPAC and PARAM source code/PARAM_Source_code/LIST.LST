     930       subroutine naicas()
     931 !-----------------------------------------------
     932 !   M o d u l e s
     933 !-----------------------------------------------
     934       use chanel_C, only : iw, iesr, restart_fn
     935       use funcon_C, only : a0
     936       use molkst_C, only : keywrd
     937       use esp_C, only : cen, exsr, ex, tf, fv, iam, cc, ip, npr, fac, &
     938       & ncc, ipe, cespm, espi, potpt, es, dx_array, dy_array, dz_array,
  f1, td, &
     939       & u_esp, expn, rnai, ewcx, ewcy, ewcz, f0, rnai1, ipx, is_esp, is
 c, &
     940       & icd, exs, ce, indc, nesp
     941 !**********************************************************************
 *
     942       implicit none
     943 !-----------------------------------------------
     944 !   L o c a l   V a r i a b l e s
     945 !-----------------------------------------------
     946       integer :: ipx2, i, jstart, iesps, np, ic, ipr, istart, j, iesp,
 iref, k, ips, jps
     947       double precision :: pi, potp1, potp2, potp3, ref, res, term, f, t
 s, term1, fi, ts1
     948 !-----------------------------------------------
     949       a0 = a0
     950 !
     951 !     CALCULATE DISTANCE ARRAYS
     952 !
     953       write (iw, *)
     954       pi = 4.D0*atan(1.D0)
     955       ipx2 = 2*ipx
     956 !     IF THIS IS A RESTART RUN, READ IN RESTART INFO
     957       if (index(keywrd,'ESPRST') /= 0) then
     958         open(unit=iesr, file=restart_fn, status='OLD', form=&
     959           'UNFORMATTED', position='asis')
     960         read (iesr) jstart, iesps
     961         if (jstart == isc*2) then
     962           close(iesr)
     963           return
     964         end if
     965         do i = 1, nesp
     966           read (iesr) es(i)
     967         end do
     968         close(iesr)
     969 !
     970         jstart = jstart + 1
     971       else
     972         jstart = 1
     973       end if
     974       np = is_esp + 1
     975       do ic = jstart, isc
     976         ipr = ic*icd - icd + 1
     977         istart = ipr
     978         dx_array(istart:ipe) = cen(ipr,1) - cen(istart:ipe,1)
     979         dy_array(istart:ipe) = cen(ipr,2) - cen(istart:ipe,2)
     980         dz_array(istart:ipe) = cen(ipr,3) - cen(istart:ipe,3)
     981         td(istart:ipe) = dx_array(istart:ipe)**2 + dy_array(istart:ipe)
 **2 + dz_array(istart:ipe)**2
 
 FORCHECK PC V13.5.13          NAICAS          2021-03-24 10:59:30   page:  3233
 esp.F90  /FF
 
     982 !
     983 !     CALCULATE EXPONENT SUM
     984 !
     985         do i = istart, ipe
     986           do j = 1, icd
     987             exsr(i,j) = ex(ipr+j-1) + ex(i)
     988             exs(i,j) = 1.D0/exsr(i,j)
     989             ce(i,j) = ex(ipr+j-1)*ex(i)*exs(i,j)
     990             expn(i,j) = exp((-ce(i,j)*td(i)))
     991           end do
     992         end do
     993 !
     994 !     CALCULATE EXPONENT WEIGHTED CENTERS
     995 !
     996         do i = istart, ipe
     997           ewcx(i,:icd) = (ex(i)*cen(i,1)+ex(ipr:icd-1+ipr)*cen(ipr:icd-
 1+ipr,1)&
     998             )*exs(i,:icd)
     999           ewcy(i,:icd) = (ex(i)*cen(i,2)+ex(ipr:icd-1+ipr)*cen(ipr:icd-
 1+ipr,2)&
    1000             )*exs(i,:icd)
    1001           ewcz(i,:icd) = (ex(i)*cen(i,3)+ex(ipr:icd-1+ipr)*cen(ipr:icd-
 1+ipr,3)&
    1002             )*exs(i,:icd)
    1003         end do
    1004 !
    1005 !     BEGIN LOOP OVER ESP POINTS
    1006 !
    1007         do iesp = 1, nesp
    1008           potp1 = potpt(1,iesp)/a0
    1009           potp2 = potpt(2,iesp)/a0
    1010           potp3 = potpt(3,iesp)/a0
    1011 !
    1012 !     BEGIN LOOP OVER COMPONENTS OF CONTRACTED FUNCTION IC
    1013 !
    1014           do j = 1, icd
    1015 !
    1016 !     CALCULATE DISTANCE BETWEEN EXPONENT WEIGHTED AND PROBE POINT
    1017 !
    1018             do i = istart, ipe
    1019               u_esp(i,j) = ((ewcx(i,j)-potp1)**2+(ewcy(i,j)-potp2)**2+(
 ewcz(i,j)-&
    1020                 potp3)**2)*exsr(i,j)
    1021               rnai(i,j) = sqrt(pi/u_esp(i,j))
    1022             end do
    1023 !
    1024 !     CALCULATE ESP INTEGRALS
    1025 !
    1026             do i = istart, ipe
    1027               if (u_esp(i,j) <= tf(0)) then
    1028                 iref = nint(u_esp(i,j)*20.D0)
    1029                 ref = 0.05D0*iref
    1030                 res = u_esp(i,j) - ref
    1031                 term = 1.D0
    1032                 f0(i,j) = 0.D0
