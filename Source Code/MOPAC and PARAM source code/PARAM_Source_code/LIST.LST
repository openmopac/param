    2338       subroutine elenuc(ia, ib, ja, jb, h)
    2339 !-----------------------------------------------
    2340 !   M o d u l e s
    2341 !-----------------------------------------------
    2342       use molkst_C, only : mpack
    2343       use mndod_C, only : sp, sd, pp, dp, d_d, cored, inddd, inddp, ind
 pp
    2344 !**********************************************************************
 *
    2345 !
    2346 !   ELENUC - Nuclear stabilization terms added to one-electron matrix
    2347 !
    2348 !**********************************************************************
 *
    2349       implicit none
    2350 !-----------------------------------------------
    2351 !   D u m m y   A r g u m e n t s
    2352 !-----------------------------------------------
    2353       integer , intent(in) :: ia
    2354       integer , intent(in) :: ib
    2355       integer , intent(in) :: ja
    2356       integer , intent(in) :: jb
    2357       double precision , intent(inout) :: h(mpack)
    2358 !-----------------------------------------------
    2359 !   L o c a l   V a r i a b l e s
    2360 !-----------------------------------------------
    2361       integer :: k, l, n, i, ind1, j, ind2, m, ipp, idp, idd
    2362 !-----------------------------------------------
    2363 !
    2364 !
    2365 !     (SS/)=1,   (SO/)=2,   (OO/)=3,   (PP/)=4
    2366 !
    2367 !     (D S/)=5,  (D P /)=6, (D D /)=7, (D+P+/)=8, (D+D+/)=9, (D#D#/)=10
    2368       k = ia
    2369       l = ib
    2370       n = 1
    2371 !
    2372    10 continue
    2373       do i = k, l
    2374         ind1 = i - k
    2375         if (ind1 == 0) then
    2376           do j = k, i
    2377             ind2 = j - k
    2378             m = (i*(i - 1))/2 + j
    2379             if (ind2 == 0) then
    2380 ! -- (SS/)
    2381               h(m) = h(m) + cored(1,n)
    2382 ! -- (SD/)
    2383             else
    2384               if (ind2 < 4) then
    2385 ! -- (PP/)
    2386                 ipp = indpp(ind1,ind2)
    2387                 h(m) = h(m) + cored(3,n)*pp(ipp,1,1) + cored(4,n)*(pp(i
 pp,2,2)+pp&
    2388                   (ipp,3,3))
    2389 ! -- (PD/)
    2390               else
    2391 ! -- (d_d/)
 
