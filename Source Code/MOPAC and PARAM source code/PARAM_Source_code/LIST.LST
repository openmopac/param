     452   subroutine fix_charges(ichrge)
     453   use molkst_C, only: refkey, keywrd, line
     454   implicit none
     455   integer, intent (in) :: ichrge
     456   integer :: i, j
     457 !
     458 !  Modify charges in keyword line so that the system will run using MOZ
 YME.
     459 !  Steps:
     460 !     If "old" CHARGE=n keyword exists in the reference keyword line, d
 elete it.
     461 !     Write new CHARGE keyword, if charge is non-zero
     462 !     Rewind the data set file.
     463 !     Write out the new data set.
     464 !     Rewind it again, so it is ready for reading.
     465 !     Rewind the output file, so the user does not see the faulty outpu
 t.
     466 !
     467       line = trim(refkey(1))
     468       call upcase(line,len_trim(line))
     469       i = Index(line," CHARGE=")
     470       if (i /= 0) then
     471         j = Index(refkey(1)(i+2:)," ")
     472         refkey(1)(i + 1:) = refkey(1)(i + j + 2:)
     473       end if
     474 !                 12345678901
     475       i = Index(refkey(1),"            ")
     476       if (ichrge /= 0) then
     477         if (ichrge > 99) then
     478           write(refkey(1)(i:i+11),'(" CHARGE=",i3)')ichrge
     479         else if (ichrge > 9) then
     480           write(refkey(1)(i:i+11),'(" CHARGE=",i2)')ichrge
     481         else if (ichrge > 0) then
     482           write(refkey(1)(i:i+11),'(" CHARGE=",i1)')ichrge
     483         else if (ichrge > -10) then
     484           write(refkey(1)(i:i+11),'(" CHARGE=",i2)')ichrge
     485         else
     486           write(refkey(1)(i:i+11),'(" CHARGE=",i3)')ichrge
     487         end if
     488       end if
     489        i = Index(keywrd," CHARGE=")
     490       if (i /= 0) then
     491         j = Index(keywrd(i+2:)," ")
     492         keywrd(i + 1:) = keywrd(i + j + 2:)
     493       end if
     494       i = Index(keywrd,"            ")
     495       if (ichrge /= 0) then
     496         if (ichrge > 99) then
     497           write(keywrd(i:i+11),'(" CHARGE=",i3)')ichrge
     498         else if (ichrge > 9) then
     499           write(keywrd(i:i+11),'(" CHARGE=",i2)')ichrge
     500         else if (ichrge > 0) then
     501           write(keywrd(i:i+11),'(" CHARGE=",i1)')ichrge
     502         else if (ichrge > -10) then
     503           write(keywrd(i:i+11),'(" CHARGE=",i2)')ichrge
     504         else
     505           write(keywrd(i:i+11),'(" CHARGE=",i3)')ichrge
     506         end if
 
 FORCHECK PC V13.5.13       FIX_CHARGES        2021-03-24 10:59:30   page:  4110
 geochk_bits_1.F90  /FF
 
     507       end if
     508 end subroutine fix_charges
 
