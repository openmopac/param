       1    subroutine dihed(xyz, i, j, k, l, angle)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5    use funcon_C, only : pi
       6    use common_arrays_C, only: tvec
       7    use molkst_C, only : id, l11, l21, l31
       8 !-----------------------------------------------
       9 !   I n t e r f a c e   B l o c k s
      10 !-----------------------------------------------
      11    implicit none
      12 !-----------------------------------------------
      13 !   D u m m y   A r g u m e n t s
      14 !-----------------------------------------------
      15    integer , intent(in) :: i
      16    integer , intent(in) :: j
      17    integer , intent(in) :: k
      18    integer , intent(in) :: l
      19    double precision, intent (out)  :: angle
      20    double precision , intent(in) :: xyz(3,*)
      21 !-----------------------------------------------
      22 !   L o c a l   V a r i a b l e s
      23 !-----------------------------------------------
      24    double precision :: xi1, xj1, xl1, yi1, yj1, yl1, zi1, zj1, zl1, dis
 t, cosa, &
      25      ddd, yxdist, xi2, xl2, yi2, yl2, costh, sinth, cosph, sinph, yj2,
 yi3, &
      26      yl3, rmin_ik, rmin_jk, rmin_lk, Vab_ik(3), Vab_jk(3), Vab_lk(3), V
 ab(3), &
      27      Rab
      28    integer :: ii, jj, kk
      29 !-----------------------------------------------
      30 !********************************************************************
      31 !
      32 !      DIHED CALCULATES THE DIHEDRAL ANGLE BETWEEN ATOMS I, J, K,
      33 !            AND L.  THE CARTESIAN COORDINATES OF THESE ATOMS
      34 !            ARE IN ARRAY XYZ.
      35 !
      36 !     DIHED IS A MODIFIED VERSION OF A SUBROUTINE OF THE SAME NAME
      37 !           WHICH WAS WRITTEN BY DR. W. THEIL IN 1973.
      38 !
      39 !********************************************************************
      40   if (id == 0) then
      41      xi1 = xyz(1,i) - xyz(1,k)
      42      xj1 = xyz(1,j) - xyz(1,k)
      43      xl1 = xyz(1,l) - xyz(1,k)
      44      yi1 = xyz(2,i) - xyz(2,k)
      45      yj1 = xyz(2,j) - xyz(2,k)
      46      yl1 = xyz(2,l) - xyz(2,k)
      47      zi1 = xyz(3,i) - xyz(3,k)
      48      zj1 = xyz(3,j) - xyz(3,k)
      49      zl1 = xyz(3,l) - xyz(3,k)
      50    else
      51      rmin_ik = 1.d8
      52      rmin_jk = 1.d8
      53      rmin_lk = 1.d8
      54      Vab_ik = 0.d0
      55      Vab_jk = 0.d0
 
 FORCHECK PC V13.5.13          DIHED           2021-03-24 10:59:30   page:  3614
 dihed.F90  /FF
 
      56      Vab_lk = 0.d0
      57      do ii = -l11, l11
      58        do jj = -l21, l21
      59          do kk = -l31, l31
      60            Vab = xyz(:,i) - xyz(:,k) + tvec(:,1)*ii + tvec(:,2)*jj + tv
 ec(:,3)*kk
      61            Rab = Vab(1)**2 + Vab(2)**2 + Vab(3)**2
      62            if (Rab < rmin_ik) then
      63              rmin_ik = Rab
      64              Vab_ik = Vab
      65            end if
      66            Vab = xyz(:,j) - xyz(:,k) + tvec(:,1)*ii + tvec(:,2)*jj + tv
 ec(:,3)*kk
      67            Rab = Vab(1)**2 + Vab(2)**2 + Vab(3)**2
      68            if (Rab < rmin_jk) then
      69              rmin_jk = Rab
      70              Vab_jk = Vab
      71            end if
      72            Vab = xyz(:,l) - xyz(:,k) + tvec(:,1)*ii + tvec(:,2)*jj + tv
 ec(:,3)*kk
      73            Rab = Vab(1)**2 + Vab(2)**2 + Vab(3)**2
      74            if (Rab < rmin_lk) then
      75              rmin_lk = Rab
      76              Vab_lk = Vab
      77            end if
      78          end do
      79        end do
      80      end do
      81      xi1 = Vab_ik(1)
      82      xj1 = Vab_jk(1)
      83      xl1 = Vab_lk(1)
      84      yi1 = Vab_ik(2)
      85      yj1 = Vab_jk(2)
      86      yl1 = Vab_lk(2)
      87      zi1 = Vab_ik(3)
      88      zj1 = Vab_jk(3)
      89      zl1 = Vab_lk(3)
      90    end if
      91 !      ROTATE AROUND Z AXIS TO PUT KJ ALONG Y AXIS
      92    dist = sqrt(xj1*xj1 + yj1*yj1 + zj1*zj1)
      93    cosa = zj1/dist
      94    cosa = min(1.0D0,cosa)
      95    cosa = dmax1(-1.0D0,cosa)
      96    ddd = 1.0D0 - cosa**2
      97    if (ddd <= 0.0D0) go to 10
      98    yxdist = dist*sqrt(ddd)
      99    if (yxdist > 1.0D-6) go to 20
     100     10 continue
     101    xi2 = xi1
     102    xl2 = xl1
     103    yi2 = yi1
     104    yl2 = yl1
     105    costh = cosa
     106    sinth = 0.D0
     107    go to 30
     108     20 continue
     109    cosph = yj1/yxdist
     110    sinph = xj1/yxdist
     111    xi2 = xi1*cosph - yi1*sinph
 
 FORCHECK PC V13.5.13          DIHED           2021-03-24 10:59:30   page:  3615
 dihed.F90  /FF
 
     112    xl2 = xl1*cosph - yl1*sinph
     113    yi2 = xi1*sinph + yi1*cosph
     114    yj2 = xj1*sinph + yj1*cosph
     115    yl2 = xl1*sinph + yl1*cosph
     116 !      ROTATE KJ AROUND THE X AXIS SO KJ LIES ALONG THE Z AXIS
     117    costh = cosa
     118    sinth = yj2/dist
     119     30 continue
     120    yi3 = yi2*costh - zi1*sinth
     121    yl3 = yl2*costh - zl1*sinth
     122    call dang (xl2, yl3, xi2, yi3, angle)
     123 !     6.2831853  IS 2 * 3.1415926535 = 180 DEGREE
     124    if (angle < 0.) angle = pi*2.d0 + angle
     125    if (angle >= 6.28318530717959D0) angle = 0.D0
     126    return
     127    end subroutine dihed
 
