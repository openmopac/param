    1225 !  UB CONTAINS UB(W)
    1226           jpu = 7 + ib
    1227           call daread (ub, maxsq, jpu)
    1228 !  GB CONTAINS GB(W)
    1229           jpg = 10 + ib
    1230           call daread (gb, maxsq, jpg)
