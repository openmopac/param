     622       subroutine rotat(coord, i, j, ix, rij, del1, idx)
     623 !-----------------------------------------------
     624 !   M o d u l e s
     625 !-----------------------------------------------
     626       USE analyt_C, only : tx, ty, tz,  tdx, tdy, tdz
     627       implicit none
     628 !-----------------------------------------------
     629 !   D u m m y   A r g u m e n t s
     630 !-----------------------------------------------
     631       integer , intent(in) :: i
     632       integer , intent(in) :: j
     633       integer , intent(in) :: ix
     634       integer , intent(in) :: idx
     635       double precision , intent(in) :: rij
     636       double precision , intent(in) :: del1
     637       double precision , intent(in) :: coord(3,25)
     638 !-----------------------------------------------
     639 !   L o c a l   V a r i a b l e s
     640 !-----------------------------------------------
     641       double precision :: xd, yd, zd, rxy, ryz, rzx, term, tmp
     642 !-----------------------------------------------
     643       xd = coord(1,i) - coord(1,j)
     644       yd = coord(2,i) - coord(2,j)
     645       zd = coord(3,i) - coord(3,j)
     646       rxy = sqrt(xd*xd + yd*yd)
     647       ryz = sqrt(yd*yd + zd*zd)
     648       rzx = sqrt(zd*zd + xd*xd)
     649       tx = 0.0D0
     650       ty = 0.0D0
     651       tz = 0.0D0
     652       tdx = 0.0D0
     653       tdy = 0.0D0
     654       tdz = 0.0D0
     655       if (rxy < 1.0D-4) then
     656 !   MOLECULAR Z AXIS IS PARALLEL TO DIATOMIC Z AXIS
     657         tx(3) = 1.0D0
     658         if (zd < 0.0D0) tx(3) = -1.0D0
     659         ty(2) = 1.0D0
     660         tz(1) = tx(3)
     661         if (idx == 1) return
     662         if (ix == 1) tdx(1) = 1.0D0/rij
     663         if (ix == 2) tdx(2) = 1.0D0/rij
     664         if (ix == 1) tdz(3) = -1.0D0/rij
     665         if (ix == 2) tdy(3) = -tx(3)/rij
     666       else if (ryz < 1.0D-4) then
     667 !   MOLECULAR X AXIS IS PARALLEL TO DIATOMIC Z AXIS
     668         tx(1) = 1.0D0
     669         if (xd < 0.0D0) tx(1) = -1.0D0
     670         ty(2) = tx(1)
     671         tz(3) = 1.0D0
     672         if (idx == 1) return
     673         if (ix == 2) tdx(2) = 1.0D0/rij
     674         if (ix == 3) tdx(3) = 1.0D0/rij
     675         if (ix == 2) tdy(1) = -1.0D0/rij
     676         if (ix == 3) tdz(1) = -tx(1)/rij
     677       else if (rzx < 1.0D-4) then
     678 !   MOLECULAR Y AXIS IS PARALLEL TO DIATOMIC Z AXIS
     679         tx(2) = 1.0D0
 
 FORCHECK PC V13.5.13          ROTAT           2021-03-24 10:59:30   page:  3692
 analyt.F90  /FF
 
     680         if (yd < 0.0D0) tx(2) = -1.0D0
     681         ty(1) = -tx(2)
     682         tz(3) = 1.0D0
     683         if (idx == 1) return
     684         if (ix == 1) tdx(1) = 1.0D0/rij
     685         if (ix == 3) tdx(3) = 1.0D0/rij
     686         if (ix == 1) tdy(2) = 1.0D0/rij
     687         if (ix == 3) tdz(2) = -tx(2)/rij
     688       else
     689         tx(1) = xd/rij
     690         tx(2) = yd/rij
     691         tx(3) = zd/rij
     692         tz(3) = rxy/rij
     693         ty(1) = -tx(2)*sign(1.0D0,tx(1))/tz(3)
     694         ty(2) = abs(tx(1)/tz(3))
     695         ty(3) = 0.0D0
     696         tz(1) = -tx(1)*tx(3)/tz(3)
     697         tz(2) = -tx(2)*tx(3)/tz(3)
     698         if (idx == 1) return
     699         term = del1/(rij*rij)
     700         select case (ix)
     701         case (1)
     702           tdx(1) = 1.0D0/rij - tx(1)*term
     703           tdx(2) = -tx(2)*term
     704           tdx(3) = -tx(3)*term
     705           tdz(3) = tx(1)/rxy - tz(3)*term
     706         case (2)
     707           tdx(1) = -tx(1)*term
     708           tdx(2) = 1.0D0/rij - tx(2)*term
     709           tdx(3) = -tx(3)*term
     710           tdz(3) = tx(2)/rxy - tz(3)*term
     711         case (3)
     712           tdx(1) = -tx(1)*term
     713           tdx(2) = -tx(2)*term
     714           tdx(3) = 1.0D0/rij - tx(3)*term
     715           tdz(3) = -tz(3)*term
     716         end select
     717         tmp = tdz(3)/tz(3)**2
     718         tdy(1) = (-tdx(2)/tz(3)) + tx(2)*tmp
     719         if (tx(1) < 0.0D0) tdy(1) = -tdy(1)
     720         tdy(2) = tdx(1)/tz(3) - tx(1)*tmp
     721         if (tx(1) < 0.0D0) tdy(2) = -tdy(2)
     722         tdy(3) = 0.0D0
     723         tdz(1) = tx(1)*tx(3)*tmp - (tx(3)*tdx(1)+tx(1)*tdx(3))/tz(3)
     724         tdz(2) = tx(2)*tx(3)*tmp - (tx(3)*tdx(2)+tx(2)*tdx(3))/tz(3)
     725       end if
     726       return
     727       end subroutine rotat
 
