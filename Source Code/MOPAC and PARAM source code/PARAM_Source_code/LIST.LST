    1131 subroutine update_txtatm(output, sort)
    1132 !
    1133 !  If "output" is true. and keyword RESIDUES is not present, then use i
 nput text in TXTATM1
    1134 !
    1135 !  if "sort" is true, then use the geometry in coorda to work out which
  atom is which.
    1136 !
    1137   use common_arrays_C, only : nat, txtatm, txtatm1, coorda, nbonds, ibo
 nds, coord, &
    1138     breaks
