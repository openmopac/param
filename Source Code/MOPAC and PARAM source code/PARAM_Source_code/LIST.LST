    2532     subroutine subsm (n, m, nsub, ind, l, u, nbd, x, d, ws, wy, theta,
 col, &
    2533    & head, iword, wv, wn, iprint, info)
    2534
    2535       use chanel_C, only: iw
    2536       implicit none
    2537       double precision, parameter :: one = 1.0d0
