     167               write (iw, "(f8.3)", advance="no") eigs(print_shift + &
     168                   & (i - 1) * print_columns_per_panel + j)
     169             end do
     170             write (iw, "(/)")
     171             !
     172             ! Print Eigenvectors
     173             k = 1
     174             do l = 1, numat
     175               do m = 1, 1 + nlast(l) - nfirst(l)
     176                 write (iw, "(' ',a2,' ',a2,' ',i5)", advance="no") &
     177                     & print_orbital_name(m), elemnt(nat(l)), l
     178                 do j = 1, print_ncolumns
     179                   write (iw, "(f8.4)", advance="no") c &
     180                  & (k, print_shift + (i - 1) * print_columns_per_panel
 + j)
     181                 end do
     182                 write (iw, "(' ')")
     183                 k = k + 1
     184               end do
     185             end do
     186           end do
     187         end do
     188       end if
     189     end if
     190 1100 continue
