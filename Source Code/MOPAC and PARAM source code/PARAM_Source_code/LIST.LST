    1022       double precision  :: c1(3,numat)
    1023 !-----------------------------------------------
    1024 !   L o c a l   V a r i a b l e s
    1025 !-----------------------------------------------
    1026       integer , dimension(numat) :: mx, my
    1027       integer :: need1, natm, icase, iback, i, nonzo, npx, npy, k, ip,
 &
    1028         m, n, imin, ny, minima, j
    1029       double precision, dimension(lm61) :: pp
    1030       double precision, dimension(3) :: w, r0
    1031       double precision, dimension(3,3) :: t
    1032       double precision, dimension(numat) :: ria, vmin
