 eigen.F90  /FF
 
     249       j1 = icxxx(jj)
     250       do jx = 1, iorbs(j1)
     251         ws(nfirst(j1)+jx-1) = 0.0d00
     252       end do
     253       kl = loopi
     254       !
     255       ! For each neighboring atom in the lmo do ...
     256       do kk = nncx(i) + 1, nncx(i) + ncx(i)
     257         k1 = icxxx(kk)
     258         if (lijbo) then
     259           kj = nijbo (k1, j1)
     260         else
     261           kj = ijbo (k1, j1)
     262         end if
     263         !
     264         ! If the neighbor contributes to the lmo then evaluate
     265         ! contribution to F * C
     266         if (kj >= 0) then
     267           if (ac(k1) > cutoff) then
     268             if (iorbs(k1) .eq. 1 .and. iorbs(j1) .eq. 1) then
     269               ws(nfirst(j1)) = ws(nfirst(j1)) + f(kj+1) * cxxx(kl+1)
     270             else
     271               if (k1 > j1) then
     272                 ii = kj
     273                 do i4 = 1, iorbs(k1)
     274                   do jx = 1, iorbs(j1)
     275                     ii = ii + 1
     276                     ws(nfirst(j1)+jx-1) = ws(nfirst(j1)+jx-1) + f(ii) &
     277                          & * cxxx(kl+i4)
     278                   end do
     279                 end do
     280               else if (k1 < j1) then
     281                 ii = kj
     282                 do jx = 1, iorbs(j1)
     283                   do i4 = 1, iorbs(k1)
     284                     ii = ii + 1
     285                     ws(nfirst(j1)+jx-1) = ws(nfirst(j1)+jx-1) + f(ii) &
     286                          & * cxxx(kl+i4)
     287                   end do
     288                 end do
     289               else
     290                 do jx = 1, iorbs(j1)
     291                   do i4 = 1, iorbs(j1)
     292                     ii = kj + (jx*(jx-1)) / 2 + i4
     293                     if (i4 .gt. jx) ii = kj + (i4*(i4-1)) / 2 + jx
     294                     ws(nfirst(j1)+jx-1) = ws(nfirst(j1)+jx-1) + f(ii) &
     295                          & * cxxx(kl+i4)
     296                   end do
     297                 end do
     298               end if
     299             end if
     300           end if
     301         end if
     302         kl = kl + iorbs(k1)
     303       end do
     304     end do
     305     !
     306     ! Evaluate C * (F * C)
     307     i1 = icxxx(nncx(i)+1)
 
 FORCHECK PC V13.5.13       FLMOFROMFAO        2021-03-24 10:59:30   page:   636
 eigen.F90  /FF
 
     308     if (ncx(i) > 1) then
     309       i2 = icxxx(nncx(i)+2)
     310     else
     311       i2 = i1
     312     end if
     313     !
     314     ! For each second orbital do ...
     315     do j = 1, i
     316         !
     317         ! FAST TEST TO SEE IF THE INTEGRAL IS WORTH EVALUATING
     318         j1 = icxxx(nncx(j)+1)
     319         if (ncx(j) > 1) then
     320           j2 = icxxx(nncx(j)+2)
     321         else
     322           j2 = j1
     323         end if
     324         if (lijbo) then
     325           i1j1 = nijbo (i1, j1)
     326           i1j2 = nijbo (i1, j2)
     327           i2j1 = nijbo (i2, j1)
     328           i2j2 = nijbo (i2, j2)
     329         else
     330           i1j1 = ijbo (i1, j1)
     331           i1j2 = ijbo (i1, j2)
     332           i2j1 = ijbo (i2, j1)
     333           i2j2 = ijbo (i2, j2)
     334         end if
     335         if (i1j1 >= 0 .or. i1j2 >= 0 .or. i2j1 >= 0 .or. i2j2 >= 0) &
     336              & then
     337           sum = 0.d0
     338           if (i1j1 >= 0) then
     339             sum = Abs (f(i1j1+1))
     340           end if
     341           if (i1j2 >= 0) then
     342             sum = sum + Abs (f(i1j2+1))
     343           end if
     344           if (i2j1 >= 0) then
     345             sum = sum + Abs (f(i2j1+1))
     346           end if
     347           if (i2j2 >= 0) then
     348             sum = sum + Abs (f(i2j2+1))
     349           end if
     350           !
     351           ! If test passed, build C * (F * C)
     352           if (sum >= flim) then
     353             loopj = ncxxx(j)
     354             sum = 0.d0
     355             kl = 0
     356             !
     357             ! For each atom in second lmo do ...
     358             do kk = nncx(j) + 1, nncx(j) + ncx(j)
     359               k1 = icxxx(kk)
     360               !
     361               ! If atom in first lmo, add contribution to C * (F * C)
     362               if (.not. latoms(k1)) then
     363                 kl = kl + iorbs(k1)
     364               else
     365                 do k = nfirst(k1), nlast(k1)
     366                   kl = kl + 1
 
 FORCHECK PC V13.5.13       FLMOFROMFAO        2021-03-24 10:59:30   page:   637
 eigen.F90  /FF
 
     367                   sum = sum + ws(k) * cxxx(kl+loopj)
     368                 end do
     369               end if
     370             end do
     371             !
     372             ! Store final integral
     373             fmo_expanded (k_fmo) = sum
     374           end if
     375         end if
     376         k_fmo = k_fmo + 1
     377     end do
     378   end do
     379 end subroutine FlmoFromFao
 
