      27       double precision, dimension(:), allocatable :: b
      28       double precision :: delx, dely, delz, rmin, r, delxm, delym, delz
 m, sum
      29       character , dimension(21) :: line*6
      30       character , dimension(9) :: atorbs*7
      31       character, dimension(norbs) :: itext*7, jtext*2
      32
      33       save irot, isp, atorbs
      34 !-----------------------------------------------
      35 !**********************************************************************
 *
      36 !
      37 ! DENROT PRINTS THE DENSITY MATRIX AS (S-SIGMA, P-SIGMA, P-PI) RATHER
      38 !        THAN (S, PX, PY, PZ).
      39 !
      40 !**********************************************************************
 *
      41       data atorbs/ 'S-SIGMA', 'P-SIGMA', '  P-PI ', '  P-PI ', 'D-SIGMA
 ', &
      42         '  D-PI ', '  D-PI ', ' D-DELL', ' D-DELL'/
      43 !**********************************************************************
      44 ! IROT IS A MAPPING LIST. FOR EACH ELEMENT OF AROT 5 NUMBERS ARE
      45 ! NEEDED. THESE ARE, IN ORDER, FIRST AND SECOND SUBSCRIPTS OF AROT,
      46 ! AND FIRST,SECOND, AND THIRD SUBSCRIPTS OF C, THUS THE FIRST
      47 ! LINE OF IROT DEFINES AROT(1,1)=C(1,3,3)
      48 !
      49 !**********************************************************************
      50       data irot/ 1, 1, 1, 3, 3, 2, 2, 2, 4, 3, 3, 2, 2, 2, 3, 4, 2, 2,
 3, 3, 2&
 
