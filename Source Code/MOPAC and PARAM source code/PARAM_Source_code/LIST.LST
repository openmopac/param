    2462       subroutine fbx
    2463 !-----------------------------------------------
    2464 !   M o d u l e s
    2465 !-----------------------------------------------
    2466       use mndod_C, only : fx, b
    2467 !     *
    2468 !     DEFINE FACTORIALS AND BINOMIAL COEFFICIENTS.
    2469 !     fx(30)     FACTORIALS.
    2470 !     B(30,30)      BINOMIAL COEFFICIENTS.
    2471 !     *
    2472       implicit none
    2473 !-----------------------------------------------
    2474 !   L o c a l   V a r i a b l e s
    2475 !-----------------------------------------------
    2476       integer :: i
    2477 !-----------------------------------------------
    2478       fx(1) = 1.D0
    2479       do i = 2, 30
    2480         fx(i) = fx(i-1)*dble(i - 1)
    2481       end do
    2482       b(:,1) = 1.D0
    2483       b(:,2:30) = 0.D0
    2484       do i = 2, 30
    2485         b(i,2:i) = b(i-1,:i-1) + b(i-1,2:i)
    2486       end do
    2487       return
    2488       end subroutine fbx
 
