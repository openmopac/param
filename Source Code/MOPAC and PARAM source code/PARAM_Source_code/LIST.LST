       1       subroutine axis(a, b, c, evec)
       2       use molkst_C, only : numcal, keywrd, mol_weight, numat
       3       use common_arrays_C, only : atmass, coord
       4       USE chanel_C, only : iw
       5       use to_screen_C, only : rot, xyzmom
       6       USE funcon_C, only : fpc_6, fpc_8, fpc_10, pi
       7       implicit none
       8       double precision , intent(out) :: a
       9       double precision , intent(out) :: b
      10       double precision , intent(out) :: c
      11       double precision  :: evec(3,3)
      12       integer :: icalcn, i, j
      13       double precision, dimension(6) :: t
      14       double precision, dimension(numat) :: x, y, z
      15       double precision, dimension(3) ::  eig
      16       double precision :: const1, const2, sumwx, sumwy, sumwz, sum
      17       logical :: first
      18       double precision, external :: ddot
      19       save t, eig, first, icalcn
      20 !**********************************************************************
 *
      21 !
      22 !  AXIS CALCULATES THE THREE MOMENTS OF INERTIA AND THE MOLECULAR
      23 !       WEIGHT.  THE MOMENTS OF INERTIA ARE RETURNED IN A, B, AND C.
      24 !       THE MOLECULAR WEIGHT IN mol_weight.
      25 !       THE UNITS OF INERTIA ARE 10**(-40)GRAM-CM**2,
      26 !       AND MOL.WEIGHT IN ATOMIC-MASS-UNITS. (AMU'S)
      27 !**********************************************************************
 *
      28       data t/ 6*0.D0/
      29       data icalcn/ 0/
      30       if (icalcn /= numcal) then
      31         icalcn = numcal
      32         first = .TRUE.
      33       end if
      34 !**********************************************************************
 *
      35 !     CONST1 =  10**40/(N*A*A)
      36 !               N = AVERGADRO'S NUMBER
      37 !               A = CM IN AN ANGSTROM
      38 !               10**40 IS TO ALLOW UNITS TO BE 10**(-40)GRAM-CM**2
      39 !
      40 !**********************************************************************
 *
      41       const1 = 10.d0**24/fpc_10
      42 !**********************************************************************
 *
      43 !
      44 !     CONST2 = CONVERSION FACTOR FROM ANGSTROM-AMU TO CM**(-1)
      45 !
      46 !            = (PLANCK'S CONSTANT*N*10**16)/(8*PI*PI*C)
      47 !            = H[ERG-SEC]*N*10**16/
      48 !              (8*PI**2*C[CM/SEC])
      49 !
      50 !**********************************************************************
 *
      51       const2 = fpc_6*fpc_10*1.D16/(8.D0*pi**2*fpc_8)
      52 !    FIRST WE CENTRE THE MOLECULE ABOUT THE CENTRE OF GRAVITY,
 
 FORCHECK PC V13.5.13           AXIS           2021-03-24 10:59:30   page:  3487
 axis.F90  /FF
 
      53 !    THIS DEPENDS ON THE ISOTOPIC MASSES, AND THE CARTESIAN GEOMETRY.
      54 !
      55       sumwx = 0.D0
      56       sumwy = 0.D0
      57       sumwz = 0.D0
      58 !
      59       if (mol_weight > 0) then
      60         do i = 1, numat
      61           sumwx = sumwx + atmass(i)*coord(1,i)
      62           sumwy = sumwy + atmass(i)*coord(2,i)
      63           sumwz = sumwz + atmass(i)*coord(3,i)
      64         end do
      65       else
      66         mol_weight = mol_weight + dble(numat)
      67         do i = 1, numat
      68           sumwx = sumwx + coord(1,i)
      69           sumwy = sumwy + coord(2,i)
      70           sumwz = sumwz + coord(3,i)
      71         end do
      72       end if
      73 !
      74       if (mol_weight>0 .and. first) &
      75       write (iw, '(/10X,''MOLECULAR WEIGHT ='',F8.2,/)') min(99999.99D0
 ,mol_weight)
      76       sumwx = sumwx/mol_weight
      77       sumwy = sumwy/mol_weight
      78       sumwz = sumwz/mol_weight
      79       x(:numat) = coord(1,:numat) - sumwx
      80       y(:numat) = coord(2,:numat) - sumwy
      81       z(:numat) = coord(3,:numat) - sumwz
      82 !**********************************************************************
 *
      83 !
      84 !    MATRIX FOR MOMENTS OF INERTIA IS OF FORM
      85 !
      86 !           |   Y**2+Z**2                         |
      87 !           |    -Y*X       Z**2+X**2             | -I =0
      88 !           |    -Z*X        -Z*Y       X**2+Y**2 |
      89 !
      90 !**********************************************************************
 *
      91       do i = 1, 6
      92         t(i) = dble(i)*1.0D-10
      93       end do
      94 !
      95       if (mol_weight > 0) then
      96         t(1) = t(1) + ddot(numat,atmass(:numat),1,y(:numat)**2+z(:numat
 )**2,1)
      97         t(2) = t(2) - ddot(numat,atmass(:numat)*x(:numat),1,y(:numat),1
 )
      98         t(3) = t(3) + ddot(numat,atmass(:numat),1,z(:numat)**2+x(:numat
 )**2,1)
      99         t(4) = t(4) - ddot(numat,atmass(:numat)*z(:numat),1,x(:numat),1
 )
     100         t(5) = t(5) - ddot(numat,atmass(:numat)*y(:numat),1,z(:numat),1
 )
     101         t(6) = t(6) + ddot(numat,atmass(:numat),1,x(:numat)**2+y(:numat
 )**2,1)
     102       else
 
 FORCHECK PC V13.5.13           AXIS           2021-03-24 10:59:30   page:  3488
 axis.F90  /FF
 
     103         do i = 1, numat
     104           t(1) = t(1) + (y(i)**2+z(i)**2)
     105           t(2) = t(2) - x(i)*y(i)
     106           t(3) = t(3) + (z(i)**2+x(i)**2)
     107           t(4) = t(4) - z(i)*x(i)
     108           t(5) = t(5) - y(i)*z(i)
     109           t(6) = t(6) + (x(i)**2+y(i)**2)
     110         end do
     111       end if
     112 !
     113       call rsp (t, 3, eig, evec)
     114       if (mol_weight>0 .and. first .and. index(keywrd,'RC=')==0) then
     115         write (iw,'(2/9X,'' ROTATIONAL CONSTANTS IN CM(-1)'',/)')
     116         where (eig < 3.D-4)
     117           eig = 0.D0
     118           rot = 0.D0
     119         elsewhere
     120           rot = const2/eig
     121         end where
     122         xyzmom = eig*const1
     123         write (iw, &
     124       '(10X,''A ='',F14.8,''   B ='',F14.8,''   C ='',F14.8,/)') (rot(i
 ),i=1,3)
     125         if (index(keywrd,'RC=') == 0) write (iw, &
     126       '(2/10X,'' PRINCIPAL MOMENTS OF INERTIA IN UNITS OF 10**(-40)*GRA
 M-CM**2'',/)')
     127         write (iw, &
     128       '(10X,''A ='',F14.4,''   B ='',F14.4,''   C ='',F14.4,/)') (xyzmo
 m(i),i=1,3)
     129         c = rot(1)
     130         b = rot(2)
     131         a = rot(3)
     132       end if
     133 !
     134 !     MAKE DIAGONAL TERMS OBLIGATE POSITIVE
     135 !
     136       do i = 1, 3
     137         if (evec(i,i) >= 0.D0) cycle
     138         evec(:,i) = -evec(:,i)
     139       end do
     140 !
     141 !   NOW TO ORIENT THE MOLECULE SO THE CHIRALITY IS PRESERVED
     142 !   CHIRALITY CAN ONLY BE LOST IF ONE OR MORE EVEC(I,I) ARE ZERO
     143 !
     144       sum = evec(1,1)*(evec(2,2)*evec(3,3)-evec(3,2)*evec(2,3)) + &
     145             evec(1,2)*(evec(2,3)*evec(3,1)-evec(2,1)*evec(3,3)) + &
     146             evec(1,3)*(evec(2,1)*evec(3,2)-evec(2,2)*evec(3,1))
     147       if (sum < 0) then
     148         sum = 1.D0
     149         do j = 1, 3
     150           if (evec(j,j) >= sum) cycle
     151           sum = evec(j,j)
     152           i = j
     153         end do
     154         evec(:,i) = -evec(:,i)
     155       end if
     156       if (index(keywrd,' NOREOR') + index(keywrd,' FORCETS') == 0) then
     157         coord(1,:numat) = x(:numat)
     158         coord(2,:numat) = y(:numat)
 
 FORCHECK PC V13.5.13           AXIS           2021-03-24 10:59:30   page:  3489
 axis.F90  /FF
 
     159         coord(3,:numat) = z(:numat)
     160       end if
     161       if (mol_weight > 0) first = .FALSE.
     162       return
     163       end subroutine axis
 
 FORCHECK PC V13.5.13           AXIS           2021-03-24 10:59:30   page:  3490
 axis.F90  /FF


