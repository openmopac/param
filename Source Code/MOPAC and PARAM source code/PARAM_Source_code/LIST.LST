     121   subroutine delete_MOZYME_arrays()
     122     use molkst_C, only : numat
     123     use MOZYME_C, only : jopt, ncocc, ncvir, nncf, nnce, icocc, icvir,
 kopt, &
     124     ncf, nce, cocc, cvir, ions, iopt, nijbo, &
     125     part_dxyz, p1, p2, p3, ws, partf, parth, &
     126     partp, idiag, nfmo, fmo, ifmo, iorbs
     127 !
     128     use common_arrays_C, only : h, w, wk, p, f, ifact, fb, q, &
     129     dxyz, eigs, errfn
     130 !
     131     use iter_C, only : pold, pold2, pold3, pbold, pbold2
     132     implicit none
     133     if (numat == 0) then
     134       if (allocated(ions))     deallocate(ions)
     135       if (allocated(iopt))     deallocate(iopt)
     136     end if
     137
