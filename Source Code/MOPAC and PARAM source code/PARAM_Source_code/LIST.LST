     127 !  4.50 -0.143     6.75   -1.531
     128 !  4.75 -0.056     7.00   -3.601
     129 !  5.00 -0.013     7.25   -7.527
     130 !  5.25 -0.001     7.50  -14.418
     131 !  5.50  0.000     7.75  -25.819
     132 !  5.75 -0.001     8.00  -43.815
     133 !  6.00 -0.026     8.25  -71.155
     134 !  6.25 -0.152     8.50 -111.391
     135 !  6.50 -0.550     8.75 -169.028
     136 !
     137 ! This is set in "cutoff" in find_H__Y_bonds
     138 !
     139 ! Angular term
     140 !
     141     a = angle/(M_PI/2.d0)
     142     x = -20.d0*a**7 + 70.d0*a**6 - 84.d0*a**5 + 35.d0*a**4
     143     e_angular = 1.d0 - x*x
     144 !
     145 ! Energy coefficient
     146 !
     147     e_para = 0.d0
     148     if (nat(d_i) == 8 .and. nat(a_i) == 8) e_para = para_oh_o
     149     if (nat(d_i) == 8 .and. nat(a_i) == 7) e_para = para_oh_n
     150     if (nat(d_i) == 7 .and. nat(a_i) == 8) e_para = para_nh_o
     151     if (nat(d_i) == 7 .and. nat(a_i) == 7) e_para = para_nh_n
     152 !
     153 ! Bond switching
     154 !
     155     if (rdh > 1.15d0) then
     156       rdhs = rdh - 1.15d0
     157       ravgs = 0.5d0*rdh + 0.5d0*rah - 1.15d0
     158       x = rdhs/ravgs
     159       e_bond_switch = 1.d0 - (-20.d0*x**7 + 70.d0*x**6 -84.d0*x**5 + 35
 .d0*x**4)
     160     else
     161 !
     162 ! No switching, no gradient
     163 !
     164       e_bond_switch = 1.d0
     165     end if
     166 !
     167 ! Water scaling
     168 !
     169     e_scale_w = 1.d0
     170     if (nat(d_i) == 8 .and. nat(a_i) == 8) then
     171       hydrogens = 0.d0
     172       others = 0.d0
     173       do k = 1, numat
     174         if (nat(k) == 1) then
     175           hydrogens = hydrogens + cvalence_contribution(d_i, k, d_list,
  nd_list)
     176         else
     177           others = others + cvalence_contribution(d_i, k, d_list, nd_li
 st)
     178         end if
     179       end do
     180 !
     181 ! If it is water
     182 !
 
 FORCHECK PC V13.5.13         H_BONDS4         2021-03-24 10:59:30   page:   662
 H_bonds4.F90  /FF
 
     183       if (hydrogens >= 1.d0) then
     184         slope = multiplier_wh_o -1.d0
     185         v = hydrogens
     186         fv = 0.d0
     187         if (v > 1.d0 .and. v <= 2.d0) then
     188           fv = v - 1.d0
     189         end if
     190         if (v > 2.d0 .and. v < 3.d0) then
     191           fv = 3.d0 -v
     192         end if
     193         fv2 = max(1.d0 - others, 0.d0)
     194         e_scale_w = 1.d0 + slope*fv*fv2
     195       end if
     196     end if
     197 !
     198 ! Charged groups
     199 !
     200     e_scale_chd = 1.d0
     201     e_scale_cha = 1.d0
     202 !
     203 ! Scaled groups: NR4+
     204 !
     205     if (nat(d_i) == 7) then
     206       slope = multiplier_nh4 - 1.d0
     207       v = 0.d0
     208       do k = 1, numat
     209         v = v + cvalence_contribution(d_i, k, d_list, nd_list)
     210       end do
     211       if (v > 3.d0) then
     212         v = v - 3.d0
     213       else
     214         v = 0.d0
     215       end if
     216       e_scale_chd = 1.d0 + slope*v
     217     end if
     218 !
     219 ! Scaled groups: COO-
     220 !
     221     f_o1 = 0.d0
     222     f_o2 = 0.d0
     223     f_cc = 0.d0
     224     o1 = a_i
     225     o2 = -1
     226     cc = -1
     227     if (nat(a_i) == 8) then
     228       slope = multiplier_coo - 1.d0
     229 !
     230 ! Search for closest C atom
     231 !
     232       cdist = 9.9d9
     233       cv_o1 = 0.d0
     234       do k = 1, numat
     235         v = cvalence_contribution(o1, k, d_list, nd_list)
     236         cv_o1 = cv_o1 + v! Sum O1 valence
     237         sum = distance(o1, k)
     238         if (v > 0.d0 .and. nat(k) == 6 .and. sum < cdist) then
     239           cdist =  sum
     240           cc = k
     241         end if
 
 FORCHECK PC V13.5.13         H_BONDS4         2021-03-24 10:59:30   page:   663
