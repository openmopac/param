       1       subroutine forsav(time, deldip, ipt, fmatrx, coord, nvar, refh, e
 vecs, &
       2         jstart, fconst)
       3 !-----------------------------------------------
       4 !   M o d u l e s
       5 !-----------------------------------------------
       6       USE chanel_C, only : iw, ires, restart_fn
       7       use molkst_C, only : numat, norbs
       8 !-----------------------------------------------
       9 !   I n t e r f a c e   B l o c k s
      10 !-----------------------------------------------
      11       implicit none
      12 !-----------------------------------------------
      13 !   D u m m y   A r g u m e n t s
      14 !-----------------------------------------------
      15       integer  :: ipt
      16       integer , intent(in) :: nvar
      17       integer  :: jstart
      18       double precision  :: time
      19       double precision  :: refh
      20       double precision  :: deldip(3,*)
      21       double precision  :: fmatrx((nvar*(nvar+1))/2)
      22       double precision  :: coord(nvar)
      23       double precision  :: evecs(nvar**2)
      24       double precision  :: fconst(nvar)
      25 !-----------------------------------------------
      26 !   L o c a l   V a r i a b l e s
      27 !-----------------------------------------------
      28       integer :: i, i99, j, linear, n33, old_numat, old_norbs
      29       logical :: opend, exists
      30 !-----------------------------------------------
      31 !**********************************************************************
 *
      32 !
      33 !  FORSAV SAVES AND RESTORES DATA USED IN THE FORCE CALCULATION.
      34 !
      35 ! ON INPUT TIME = TOTAL TIME ELAPSED SINCE THE START OF THE CALCULATION
 .
      36 !          IPT  = LINE OF FORCE MATRIX REACHED, IF IN WRITE MODE,
      37 !               = 0 IF IN READ MODE.
      38 !        FMATRX = FORCE MATRIX
      39 !**********************************************************************
 *
      40       i99 = 0
      41    10 continue
      42       j = i99
      43       inquire(unit=ires, opened=opend)
      44       if (opend) close(unit=ires, status='KEEP')
      45       if (ipt == 0) then
      46         inquire (file=restart_fn, exist = exists)
      47         if ( .not. exists) then
      48           call mopend ('RESTART file does not exist')
      49           return
      50         end if
      51       end if
      52       open(unit=ires, file=restart_fn, status='UNKNOWN', &
      53       form='UNFORMATTED', iostat=i99, position='asis')
      54       if (i99 /= 0) then
 
 FORCHECK PC V13.5.13          FORSAV          2021-03-24 10:59:30   page:  1560
 forsav.F90  /FF
 
      55         if (j /= 0) then
      56           call mopend ('Fatal error in trying to open RESTART file')
      57           return
      58         end if
      59 !
      60 !   A restart file exists, but cannot be mounted.  Delete it.
      61 !   If it can't be deleted, carry on regardless.
      62 !
      63         open(unit=ires, file=restart_fn, status='OLD', iostat=i99, &
      64           position='asis')
      65         close(ires, status='DELETE', iostat=i99)
      66         go to 10
      67       end if
      68       rewind ires
      69       if (ipt == 0) then
      70 !
      71 !   READ IN FORCE DATA
      72 !
      73         read (ires, iostat=i99) time, ipt, refh, old_numat, old_norbs
      74         if (norbs /= old_norbs .or. numat /= old_numat) then
      75               call mopend("Restart file read in does not match current
 data set")
      76               return
      77         end if
      78         linear = (nvar*(nvar + 1))/2
      79         read (ires, iostat=i99) (coord(i),i=1,nvar)
      80         read (ires, iostat=i99) (fmatrx(i),i=1,linear)
      81         read (ires, iostat=i99) ((deldip(j,i),j=1,3),i=1,ipt)
      82         n33 = nvar*nvar
      83         read (ires, iostat=i99) (evecs(i),i=1,n33)
      84         read (ires, iostat=i99) jstart, (fconst(i),i=1,nvar)
      85         if (i99 /= 0) then
      86           call mopend ('INSUFFICIENT DATA ON DISK FILES FOR A FORCE CAL
 CULATION RESTART.')
      87           write (iw, '(/10X,"PERHAPS THIS STARTED OFF AS A FORCE CALCUL
 ATION")')
      88           write (iw, '(10X,"BUT THE GEOMETRY HAD TO BE OPTIMIZED FIRST,
  IN WHICH CASE" &
      89       &,/10X,"REMOVE THE KEY-WORD ""FORCE"".")')
      90         end if
      91         return
      92       else
      93 !
      94 !    WRITE FORCE DATA
      95 !
      96         rewind ires
      97         if (time > 1.D7) time = time - 1.D7
      98         write (ires) time, ipt, refh, numat, norbs
      99         linear = (nvar*(nvar + 1))/2
     100         write (ires) (coord(i),i=1,nvar)
     101         write (ires) (fmatrx(i),i=1,linear)
     102         write (ires) ((deldip(j,i),j=1,3),i=1,ipt)
     103         n33 = nvar*nvar
     104         write (ires) (evecs(i),i=1,n33)
     105         write (ires) jstart, (fconst(i),i=1,nvar)
     106         call den_in_out(1)
     107         close(ires)
     108       end if
     109       return
 
 FORCHECK PC V13.5.13          FORSAV          2021-03-24 10:59:30   page:  1561
 forsav.F90  /FF
 
     110       end subroutine forsav
 
 FORCHECK PC V13.5.13          FORSAV          2021-03-24 10:59:30   page:  1562
 forsav.F90  /FF


