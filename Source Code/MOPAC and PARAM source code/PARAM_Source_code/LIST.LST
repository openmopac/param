     309 !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
     310
     311       subroutine eabh(n, A, B, H, coord, shortcut, cab, energy)
     312       implicit none
     313       integer :: A, B, H, n
     314       double precision  :: coord(3, n),  energy, shortcut, cab
     315
     316       double precision  :: rab, xy, cosabh, d2ij, d2ik, d2jk
     317       double precision  :: aterm, dampm, damps, dampl, xm, ym, zm, rhm,
  rab2
     318       double precision  :: longcut  =  7.50388d0 !  5 angstroem
     319       double precision  :: alp  =  20d0
     320
     321 ! AB distance
     322          rab2  =     ((coord(1, A)-coord(1, B))**2   +  (coord(2, A)-co
 ord(2, B))**2   +  (coord(3, A)-coord(3, B))**2)
     323          rab  =  sqrt(rab2)
     324 ! cos angle A-H-B
     325          D2IJ   =   (coord(1, A)-coord(1, H))**2  +   (coord(2, A)-coor
 d(2, H))**2  +   (coord(3, A)-coord(3, H))**2
     326          D2JK   =   (coord(1, H)-coord(1, B))**2  +   (coord(2, H)-coor
 d(2, B))**2  +   (coord(3, H)-coord(3, B))**2
     327          D2IK   =   (coord(1, A)-coord(1, B))**2  +   (coord(2, A)-coor
 d(2, B))**2  +   (coord(3, A)-coord(3, B))**2
     328          XY   =   SQRT(D2IJ*D2JK  +  1.d-14)
     329          cosabh   =   0.5D0 * (D2IJ  +  D2JK-D2IK) / XY
     330 ! angle term
     331          aterm   =   0.125d0*(cosabh-1.0d0)**4
     332 ! H-(AB) midpoint distance
     333          xm  =  0.5*(coord(1, A)  +  coord(1, B))
     334          ym  =  0.5*(coord(2, A)  +  coord(2, B))
     335          zm  =  0.5*(coord(3, A)  +  coord(3, B))
     336          rhm  =  sqrt((coord(1, H)-xm)**2   +  (coord(2, H)-ym)**2   +
  (coord(3, H)-zm)**2)
     337 ! H out of linear damping
     338          dampm  =  1.d0-1.d0/(1.d0  +  exp(-alp*(rhm/rab-1.d0)))
     339 ! short damping
     340          damps  =  1.d0/(1.d0  +  exp(-alp*(rab/shortcut-1.d0)))
     341 ! long  damping
     342          dampl  =  1.d0-1.d0/(1.d0  +  exp(-alp*(rab/longcut-1.d0)))
     343 ! all for this A-H-B
     344          energy  =  -dampl*damps*dampm*aterm*cab/rab2**2
     345
     346          end
 
