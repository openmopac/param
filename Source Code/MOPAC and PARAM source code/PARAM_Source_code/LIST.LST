      65 !     *********************************************************
      66 !     ******* general overlap code ****************************
      67 !     *********************************************************
      68
      69 !     **** n - factorial ****
      70       fact(1) = 1
      71       do i = 2, 30
      72         fact(i) = fact(i - 1) * (i - 1)
      73       end do
      74
      75 !
      76 !     ********* form binomial coeffecient *******
      77 !
      78 !      (n )
      79 !      (m )  index = n*(n + 1)/2 + m + 1
      80 !
      81       bincoe(1) = 1.d0
      82       ind = 2
      83       do 601 i = 1, 29
      84       i1 = i + 1
      85       do 602 j = 1, i1
      86       jj = i1 - j + 1
      87       if (j < 26)go to 66
      88       bin = 1.d0
      89       if (j >= jj)then
      90       do 62 k = j, i
      91       bin = bin*dfloat(k)
      92 62    continue
      93       bincoe(ind) = bin/fact(jj)
      94       else
      95       do 64 k = jj, i
      96       bin = bin*dfloat(k)
      97 64    continue
      98       bincoe(ind) = bin/fact(j)
      99       end if
     100       go to 60
     101 66    bincoe(ind) = fact(i1)/fact(j)/fact(jj)
     102 60    ind = ind + 1
