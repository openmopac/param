    1632   subroutine precond_aq_dir_int (ind1, n1, ind2, n2, c, nc, same, compu
 te, &
    1633                 & npos)
    1634     !
    1635     ! Computes block preconditioner
    1636     !
    1637     use cosmo_C, only : iatsp, cosurf, disex2
    1638     implicit none
    1639     integer, intent(in) :: n1, n2, nc
    1640     integer, intent(in), dimension(*) :: ind1, ind2
    1641     double precision, intent(in), dimension(nc, *) :: c
    1642     logical, intent(in) :: same, compute
    1643     integer, intent (inout) :: npos
    1644     integer :: i, j, ii, jj, i3, j3, ips, jps
    1645     double precision :: aa, d2
    1646     double precision xa(3), xb(3)
    1647 !
    1648 ! dummy statement to "use" compute and c
    1649 !
    1650     if (compute) aa = c(1,1)
    1651     m_vec = 0.d0
    1652     if (same) then
    1653       do i3=1, n1
    1654         ii = ind1(i3)
    1655         i = iatsp(ii)
    1656         xa(1:3) = cosurf(1:3, ii)
    1657
    1658         do j3 = 1, i3 -1
    1659           jj = ind1(j3)
    1660           j = iatsp(jj)
    1661           xb(1:3) = cosurf(1:3, jj)
    1662
    1663           d2 = (xb(1)-xa(1))**2 + (xb(2)-xa(2))**2 + &
    1664               & (xb(3)-xa(3))**2
    1665
    1666           if (d2 > disex2) then
    1667             aa = 1.d0 / Sqrt (d2)
    1668           else
    1669             npos = npos +1
    1670             aa = a_part(npos)
    1671           end if
    1672           if (i == j) then ! same atom
    1673             ips = ii - npoints(i) +1
    1674             jps = jj - npoints(i) +1
    1675
    1676             if (ips >= jps) then
    1677               m_vec(iblock_pos(i) -1 + (ips*(ips-1))/2 + jps) = aa
    1678             else
    1679               m_vec(iblock_pos(i) -1 + (jps*(jps-1))/2 + ips) = aa
    1680             end if
    1681
    1682           end if
    1683
    1684         end do
    1685       end do
    1686
    1687     else
    1688
 
 FORCHECK PC V13.5.13    PRECOND_AQ_DIR_INT    2021-03-24 10:59:30   page:  2274
 linear_cosmo.F90  /FF
 
    1689       do i3 = 1, n1
    1690         ii = ind1(i3)
    1691         i = iatsp(ii)
    1692         xa(1:3) = cosurf(1:3, ii)
    1693
    1694         do j3 = 1, n2
    1695           jj = ind2(j3)
    1696           j = iatsp(jj)
    1697           xb(1:3) = cosurf(1:3, jj)
    1698
    1699           d2 = (xb(1)-xa(1))**2 + (xb(2)-xa(2))**2 + &
