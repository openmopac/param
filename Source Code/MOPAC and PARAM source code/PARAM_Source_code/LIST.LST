     202           write (iw, '(/17X,10(1X,A7,3X))') (itext(n),n=na,m)
     203           write (iw, '( 17X,10(2X,A2,I3,4X))') (jtext(n),natom(n),n=na,
 m)
     204           write (iw, '(20A6)') (line(n),n=1,ma)
     205           kk = 4
     206           ll = 0
     207         end if
     208         write (iw, '(1X,A7,1X,A2,I3,10F11.6)') itext(i), jtext(i), nato
 m(i), (b&
     209           (n),n=k,l)
     210       end do
     211       if (l >= limit) go to 220
     212       kk = kk + ll + 4
     213       na = m + 1
 
 FORCHECK PC V13.5.13          DENROT          2021-03-24 10:59:30   page:  1688
