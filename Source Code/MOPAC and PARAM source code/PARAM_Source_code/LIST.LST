     263 !
     264 ! TEST TO EXIT FROM LINMIN IF NOT DROPPING IN VALUE OF FUNCTION FAST.
 
 FORCHECK PC V13.5.13          LINMIN          2021-03-24 10:59:30   page:   932
 linmin.F90  /FF
 
     265 !
     266           if (abs(funold - funct)<delta2 .and. okf) exit  l180
     267           alpold = alpha
     268           if (alpha>vt(right) .or. alpha>vt(center) .and. funct<phi(cen
 ter)&
     269              .or. alpha>vt(left) .and. alpha<vt(center) .and. funct>phi
 (center)&
     270             ) go to 140
     271 !
     272 !   IF SYSTEM IS CREEPING UP ON A DISTANT HIGH VALUE, DISCARD
     273 !   DISTANT HIGH VALUE.
     274 !
     275           if (nsame > 4) go to 140
     276           nsame = nsame + 1
     277           vt(right) = alpha
     278           phi(right) = funct
     279           go to 150
     280   140     continue
     281           vt(left) = alpha
     282           nsame = 0
     283           phi(left) = funct
     284   150     continue
     285           if (vt(center) >= vt(right)) then
     286             i = center
     287             center = right
     288             right = i
     289           end if
     290           if (vt(left) >= vt(center)) then
     291             i = left
     292             left = center
     293             center = i
     294           end if
     295           if (vt(center) < vt(right)) cycle  l180
     296           i = center
     297           center = right
     298           right = i
     299         end do l180
     300       end if
     301   190 continue
     302       ic = 2
     303       if (abs(estor - energy) < 1.D-12) ic = 1
     304       hlast = funct - fin
     305       drop = sqstor - fin
     306       call exchng (sqstor, funct, estor, energy, xstor, xparam, alfs, a
 lpha, &
     307         nvar)
     308 !
     309 !  Check that the density matrix is O.K., or almost O.K.
     310 !
     311       if (hlast /= 0.D0 .and. hlast > 0.5D0*drop) then
     312         call compfg (xparam, .TRUE., funct, .TRUE., grad, .FALSE.)
     313         if (moperr) return
     314       end if
     315       okf = funct < ssqlst .or. diis
     316       if (funct >= ssqlst) return
     317       if (alpha < 0.D0) then
     318         alpha = -alpha
     319         i = 1
     320         if (nvar > 0) then
 
 FORCHECK PC V13.5.13          LINMIN          2021-03-24 10:59:30   page:   933
 linmin.F90  /FF
 
     321           pvect(:nvar) = -pvect(:nvar)
     322           i = nvar + 1
     323         end if
     324       end if
     325       return
     326 !
     327 !
     328       end subroutine linmin
 
