     140 subroutine dgefa (a, lda, n, ipvt, info)
     141     implicit none
     142     integer, intent (in) :: lda, n
     143     integer, intent (out) :: info
     144     integer, dimension (n), intent (out) :: ipvt
     145     double precision, dimension (lda, n), intent (inout) :: a
     146     integer :: j, k, kp1, l, nm1
     147     double precision :: t
     148       integer, external :: idamax
     149 !
     150
     151    !
     152    ! ... Executable Statements ...
     153    !
     154    !     DGEFA FACTORS A DOUBLE PRECISION MATRIX BY GAUSSIAN ELIMINATIO
 N.
     155    !
     156    !     DGEFA IS USUALLY CALLED BY DGECO, BUT IT CAN BE CALLED
     157    !     DIRECTLY WITH A SAVING IN TIME IF  RCOND  IS NOT NEEDED.
     158    !     (TIME FOR DGECO) = (1 + 9/N)*(TIME FOR DGEFA) .
     159    !
     160    !     ON ENTRY
     161    !
     162    !        A       DOUBLE PRECISION(LDA, N)
     163    !                THE MATRIX TO BE FACTORED.
     164    !
     165    !        LDA     INTEGER
     166    !                THE LEADING DIMENSION OF THE ARRAY  A .
     167    !
     168    !        N       INTEGER
     169    !                THE ORDER OF THE MATRIX  A .
     170    !
     171    !     ON RETURN
     172    !
     173    !        A       AN UPPER TRIANGULAR MATRIX AND THE MULTIPLIERS
     174    !                WHICH WERE USED TO OBTAIN IT.
     175    !                THE FACTORIZATION CAN BE WRITTEN  A = L*U  WHERE
     176    !                L  IS A PRODUCT OF PERMUTATION AND UNIT LOWER
     177    !                TRIANGULAR MATRICES AND  U  IS UPPER TRIANGULAR.
     178    !
     179    !        IPVT    INTEGER(N)
     180    !                AN INTEGER VECTOR OF PIVOT INDICES.
     181    !
     182    !        INFO    INTEGER
     183    !                = 0  NORMAL VALUE.
     184    !                = K  IF  U(K,K) .EQ. 0.0 .  THIS IS NOT AN ERROR
     185    !                     CONDITION FOR THIS SUBROUTINE, BUT IT DOES
     186    !                     INDICATE THAT DGESL OR DGEDI WILL DIVIDE BY ZE
 RO
     187    !                     IF CALLED.  USE  RCOND  IN DGECO FOR A RELIABL
 E
     188    !                     INDICATION OF SINGULARITY.
     189    !
     190    !     LINPACK. THIS VERSION DATED 08/14/78 .
     191    !     CLEVE MOLER, UNIVERSITY OF NEW MEXICO, ARGONNE NATIONAL LAB.
     192    !
     193    !     SUBROUTINES AND FUNCTIONS
     194    !
 
 FORCHECK PC V13.5.13          DGEFA           2021-03-24 10:59:30   page:   374
 linpack.F90  /FF
 
     195    !     BLAS DAXPY,DSCAL,IDAMAX
     196    !
     197    !     GAUSSIAN ELIMINATION WITH PARTIAL PIVOTING
     198    !
     199     info = 0
     200     nm1 = n - 1
     201     if (nm1 >= 1) then
     202       do k = 1, nm1
     203         kp1 = k + 1
     204          !
     205          !        FIND L = PIVOT INDEX
     206          !
     207         l = idamax (n-k+1, a(k, k), 1) + k - 1
     208         ipvt(k) = l
     209          !
     210          !        ZERO PIVOT IMPLIES THIS COLUMN ALREADY TRIANGULARIZED
     211          !
     212         if (a(l, k) == 0.0d0) then
     213           info = k
     214         else
     215             !
     216             !           INTERCHANGE IF NECESSARY
     217             !
     218           if (l /= k) then
     219             t = a(l, k)
     220             a(l, k) = a(k, k)
     221             a(k, k) = t
     222           end if
     223             !
     224             !           COMPUTE MULTIPLIERS
     225             !
     226           t = -1.0d0 / a(k, k)
     227           call dscal (n-k, t, a(k+1, k), 1)
     228             !
     229             !           ROW ELIMINATION WITH COLUMN INDEXING
     230             !
     231           do j = kp1, n
     232             t = a(l, j)
     233             if (l /= k) then
     234               a(l, j) = a(k, j)
     235               a(k, j) = t
     236             end if
     237             call daxpy (n-k, t, a(k+1, k), 1, a(k+1, j), 1)
     238           end do
     239         end if
     240       end do
     241     end if
     242     ipvt(n) = n
     243     if (a(n, n) == 0.0d0) then
     244       info = n
     245     end if
     246 end subroutine dgefa
 
 FORCHECK PC V13.5.13          DGEFA           2021-03-24 10:59:30   page:   375
 linpack.F90  /FF


