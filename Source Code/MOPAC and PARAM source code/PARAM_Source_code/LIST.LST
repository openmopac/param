       1       subroutine bldsym(ioper, iplace)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE symmetry_C, only : elem, cub
       6 !**********************************************************************
 *
       7 !-----------------------------------------------
       8 !   I n t e r f a c e   B l o c k s
       9 !-----------------------------------------------
      10       implicit none
      11 !-----------------------------------------------
      12 !   G l o b a l   P a r a m e t e r s
      13 !-----------------------------------------------
      14 !-----------------------------------------------
      15 !   D u m m y   A r g u m e n t s
      16 !-----------------------------------------------
      17       integer , intent(in) :: ioper
      18       integer  :: iplace
      19 !-----------------------------------------------
      20 !   L o c a l   P a r a m e t e r s
      21 !-----------------------------------------------
      22 !-----------------------------------------------
      23 !   L o c a l   V a r i a b l e s
      24 !-----------------------------------------------
      25       integer , dimension(3,20) :: j
      26       integer :: i
      27       double precision :: twopi, angle
      28
      29       save j, twopi
      30 !-----------------------------------------------
      31 !**********************************************************************
 *
      32 !
      33 !   BLDSYM  constructs the point-group symmetry operations as
      34 !           3 by 3 matrices, 20 in all.  The operations are, in
      35 !           order
      36 !   1 C2(X)         6 Sigma(YZ)     11 C6      16 S8
      37 !   2 C2(Y)         7 inversion     12 C7      17 S10
      38 !   3 C2(Z)         8 C3            13 C8      18 S12
      39 !   4 Sigma(XY)     9 C4            14 S4      19 S(5) ?
      40 !   5 Sigma(XZ)    10 C5            15 S6      20 C(infinity)
      41 !
      42 !**********************************************************************
 *
      43       data j(1,1), j(2,1), j(3,1)/ 1, -1, -1/
      44       data j(1,2), j(2,2), j(3,2)/ -1, 1, -1/
      45       data j(1,3), j(2,3), j(3,3)/ -1, -1, 1/
      46       data j(1,4), j(2,4), j(3,4)/ 1, 1, -1/
      47       data j(1,5), j(2,5), j(3,5)/ 1, -1, 1/
      48       data j(1,6), j(2,6), j(3,6)/ -1, 1, 1/
      49       data j(1,7), j(2,7), j(3,7)/ -1, -1, -1/
      50       data j(1,8), j(2,8), j(3,8)/ 3, 0, 1/
      51       data j(1,9), j(2,9), j(3,9)/ 4, 0, 1/
      52       data j(1,10), j(2,10), j(3,10)/ 5, 0, 1/
      53       data j(1,11), j(2,11), j(3,11)/ 6, 0, 1/
      54       data j(1,12), j(2,12), j(3,12)/ 7, 0, 1/
      55       data j(1,13), j(2,13), j(3,13)/ 8, 0, 1/
 
 FORCHECK PC V13.5.13          BLDSYM          2021-03-24 10:59:30   page:   234
 bldsym.F90  /FF
 
      56       data j(1,14), j(2,14), j(3,14)/ 4, 0, -1/
      57       data j(1,15), j(2,15), j(3,15)/ 6, 0, -1/
      58       data j(1,16), j(2,16), j(3,16)/ 8, 0, -1/
      59       data j(1,17), j(2,17), j(3,17)/ 10, 0, -1/
      60       data j(1,18), j(2,18), j(3,18)/ 12, 0, -1/
      61       data j(1,19), j(2,19), j(3,19)/ 5, 0, -1/
      62       data j(1,20), j(2,20), j(3,20)/ 0, 0, -1/
      63       data twopi/ 6.2831853071796D0/
      64       do i = 1, 3
      65         elem(i,:,iplace) = 0.D0
      66         elem(i,i,iplace) = j(i,ioper)
      67       end do
      68       if (ioper /= 20) then
      69         if (j(1,ioper) >= 2) then
      70           angle = twopi/dble(j(1,ioper))
      71           elem(1,1,iplace) = cos(angle)
      72           elem(2,2,iplace) = elem(1,1,iplace)
      73           elem(2,1,iplace) = sin(angle)
      74           elem(1,2,iplace) = -elem(2,1,iplace)
      75         end if
      76         if (ioper==8 .or. ioper==15) call mult33 (cub, iplace)
      77         return
      78       end if
      79       elem(1,2,iplace) = 1.D0
      80       elem(2,1,iplace) = 1.D0
      81       return
      82       end subroutine bldsym
 
