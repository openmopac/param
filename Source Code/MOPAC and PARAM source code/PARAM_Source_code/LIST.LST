      23       subroutine summary(txt, ntxt)
      24 !
      25 !  Collect error messages and print them at the end of each calculation
      26 !
      27 !
      28         use chanel_C, only : iw, ir
      29         use molkst_C, only : line, job_no, natoms
      30         implicit none
      31         integer, intent (in) :: ntxt
      32         character, intent (in) :: txt*(*)
      33 !
      34 !  Local quantities
      35 !
      36         integer, parameter :: lim = 120
      37         character :: messages(20)*(lim), blank*(lim)
      38         integer :: nmessages = 0, i, j, max_txt
      39         logical :: first = .true.
      40         save
      41         if (first) then
      42            messages(1)(:18) = "JOB ENDED NORMALLY"
      43            first = .false.
      44         end if
      45         if (ntxt == 1) then
      46           if (natoms == 0 .and. job_no == 1) then
      47             write(iw,'(/10x, a)')"Job failed to run because no atoms we
 re detected in the system"
      48             write(iw,'(10x, a, /)')"The start of the data-set is as fol
 lows:"
      49             rewind (ir)
      50             max_txt = 0
      51             do i = 1, 9
      52               read(ir, '(a)', iostat = j)line
      53               if (j /= 0) exit
      54               max_txt = max(max_txt, len_trim(line))
      55             end do
      56             rewind (ir)
      57             do i = 1, 9
      58               read(ir, '(a)', iostat = j)line
      59               if (j /= 0) exit
      60               write(iw,'(a, i1, a)')" Line ", i, ": """//line(:max_txt)
 //""""
      61             end do
      62             if (i < 10) write(iw,'(/,a)')"          Then the end of the
  data-set was detected"
      63           end if
      64 !
      65 !   Write out messages
      66 !
      67           blank = " "
      68           blank(1:1) = "*"
      69           max_txt = 1
      70           do i = 1, nmessages
      71             max_txt = max(max_txt, len_trim(messages(i)))
      72           end do
      73           max_txt = min(lim, max(max_txt + 4, 22))
      74           if (messages(1)(1:18) /= "JOB ENDED NORMALLY" ) max_txt = max
 (max_txt, 78)
      75           write(iw,'(/1x,120a)')("*", i = 1, max_txt)
 
 FORCHECK PC V13.5.13         SUMMARY          2021-03-24 10:59:30   page:   173
 mopend.F90  /FF
 
      76           blank(max_txt:max_txt) = "*"
      77           write(iw,'(1x,a)')trim(blank)
      78           if (messages(1)(1:18) /= "JOB ENDED NORMALLY" ) then
      79             write(line,'(a)') "*     Error and normal termination messa
 ges reported in this calculation"
      80             line(max_txt:max_txt) = "*"
      81             write(iw,'(1x,a)')trim(line)
      82             write(iw,'(1x,a)')trim(blank)
      83             do i = 1, nmessages
      84               if (index(messages(i),"JOB ENDED NORMALLY") > 0) cycle
      85               write(line,'(a)')"* "//trim(messages(i))
      86               line(max_txt:max_txt) = "*"
      87               write(iw,'(1x,a)')trim(line)
      88             end do
      89           end if
      90           write(line,'(a)') "* JOB ENDED NORMALLY "
      91           line(max_txt:max_txt) = "*"
      92           write(iw,'(1x,a)')trim(line)
      93           write(iw,'(1x,a)')trim(blank)
      94           write(iw,'(1x,120a)')("*", i = 1, max_txt)
      95           nmessages = 0
      96           messages(1) = "JOB ENDED NORMALLY"
      97         else
      98 !
      99 !   Store current message
     100 !
     101           if (nmessages == 20) return
     102           nmessages = nmessages + 1
     103           i = min(ntxt, lim - 3)
     104           messages(nmessages) = txt(:i)
     105         end if
     106         return
     107       end subroutine summary
 
