       1       subroutine static_polarizability
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use molkst_C, only : keywrd, numat, natoms, nvar, escf, ndep
       6       use chanel_C, only : iw
       7       use common_arrays_C, only : geo, coord, nat, labels, na
       8       use elemts_C, only : elemnt
       9 !-----------------------------------------------
      10 !   I n t e r f a c e   B l o c k s
      11 !-----------------------------------------------
      12       implicit none
      13 !-----------------------------------------------
      14 !   L o c a l   V a r i a b l e s
      15 !-----------------------------------------------
      16       integer :: i, j, k, l
      17       double precision, dimension(1) :: grad
      18       double precision, dimension(3,3) :: rotvec
      19       double precision :: sum, sumx, sumy, sumz, summax
      20       logical :: let
      21 !-----------------------------------------------
      22 !**********************************************************************
      23 !
      24 !   POLAR SETS UP THE CALCULATION OF THE MOLECULAR ELECTRIC RESPONSE
      25 !   PROPERTIES BY FFHPOL.
      26 !
      27 !**********************************************************************
      28       let = index(keywrd,' LET') /= 0
      29       write (iw, 10)
      30    10 format(' ',20('*'),' FINITE-FIELD POLARIZABILITIES ',20('*'),/,/,
 &
      31         '    THE F-F METHOD IS PERFORMED USING BOTH AN ENERGY',/,&
      32         '    AND DIPOLE MOMENT EXPANSION.  THESE RESULTS ARE',/,&
      33         '    LISTED BELOW AS "H.o.F." AND "Dipole", RESPECTIVELY.')
      34       call gmetry (geo, coord)
      35 !
      36 !  Orient the molecule with the moments of inertia.
      37 !  This is done to ensure a unique, reproduceable set of directions.
      38 !  If LET is specified, the input orientation will be used.
      39 !
      40       if (.not.let) then
      41         call axis (sumx, sumy, sumz, rotvec)
      42         write (iw, 20)
      43    20   format(/,' ROTATION MATRIX FOR ORIENTATION OF MOLECULE:'/)
      44         do i = 1, 3
      45           write (iw, 30) (rotvec(i,j),j=1,3)
      46    30     format(5x,3f12.6)
      47         end do
      48 !
      49 !  ROTATE ATOMS
      50 !
      51         do i = 1, numat
      52           do j = 1, 3
      53             sum = 0.0D00
      54             do k = 1, 3
      55               sum = sum + coord(k,i)*rotvec(k,j)
      56             end do
      57             geo(j,i) = sum
 
 FORCHECK PC V13.5.13  STATIC_POLARIZABILITY   2021-03-24 10:59:30   page:  1832
 static_polarizability.F90  /FF
 
      58           end do
      59         end do
      60         coord(:,:numat) = geo(:,:numat)
      61         write (iw, '(2/10X,''CARTESIAN COORDINATES '',/)')
      62         write (iw, &
      63       '(4X,''NO.'',7X,''ATOM'',9X,''X'',                       9X,''Y''
 ,9X,''Z'&
      64       &',/)')
      65         l = 0
      66         do i = 1, numat
      67           if (nat(i)==99 .or. nat(i)==107) cycle
      68           l = l + 1
      69           write (iw, '(I6,8X,A2,4X,3F10.4)') l, elemnt(nat(i)), (coord(
 j,l),j=1,&
      70             3)
      71         end do
      72       end if
      73 !
      74 !
      75 !  SET UP THE VARIABLES IN XPARAM AND LOC, THESE ARE IN CARTESIAN
      76 !  COORDINATES.
      77 !
      78       numat = 0
      79       sumx = 0.D0
      80       sumy = 0.D0
      81       sumz = 0.D0
      82       do i = 1, natoms
      83         if (labels(i)==99 .or. labels(i)==107) cycle
      84         numat = numat + 1
      85         labels(numat) = labels(i)
      86         sumx = sumx + coord(1,numat)
      87         sumy = sumy + coord(2,numat)
      88         sumz = sumz + coord(3,numat)
      89         geo(:,numat) = coord(:,numat)
      90       end do
      91       sumx = sumx/numat
      92       sumy = sumy/numat
      93       sumz = sumz/numat
      94       summax = 0.D0
      95       do i = 1, numat
      96         geo(1,i) = geo(1,i) - sumx
      97         summax = dmax1(abs(geo(1,i)),summax)
      98         geo(2,i) = geo(2,i) - sumy
      99         summax = dmax1(abs(geo(2,i)),summax)
     100         geo(3,i) = geo(3,i) - sumz
     101         summax = dmax1(abs(geo(3,i)),summax)
     102       end do
     103 !
     104       ndep = 0
     105       natoms = numat
     106       nvar = 0
     107       na = 0
     108       call compfg (geo, .TRUE., escf, .TRUE., grad, .FALSE.)
     109       write (iw,"(/,/,' ENERGY OF ""REORIENTED"" SYSTEM WITHOUT FIELD:'
 ,f15.5,a)") &
     110       escf, " Kcal/mol"
     111 !
     112       call ffhpol ()
     113 !
 
 FORCHECK PC V13.5.13  STATIC_POLARIZABILITY   2021-03-24 10:59:30   page:  1833
 static_polarizability.F90  /FF
 
     114       return
     115       end subroutine static_polarizability
 
