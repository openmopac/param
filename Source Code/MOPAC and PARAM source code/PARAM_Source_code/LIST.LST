     249                               vt(center), phi(center), phi(center) - fi
 n, &
     250                               vt(right), phi(right), phi(right) - fin,
 &
     251                               alpha, funct, funct - fin, xparam(1)*sum
     252             else
     253               write(line,"(5x,'NEW    ...',f17.8,2f17.7)")alpha, funct,
  funct - fin
