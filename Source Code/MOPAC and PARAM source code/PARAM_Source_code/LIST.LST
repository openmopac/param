     211 !.......................................................
     212 !
     213 !     get phase for e transform
     214 !     phase (- 1)**(l - m) on la >= the other l value
     215 !
     216       if (la == jb) jm = jlp1
     217       if (la == kb) jm = klp1
     218       go to (27, 28, 29, 30), jm
     219 !
     220 !  f - orbs
     221 !
     222    30 ephi = one
     223       edel = -one
     224 !
     225 !  p - orbs
     226 !
     227    28 epi = one
     228       esig = -one
     229       go to 31
     230 !
 
 FORCHECK PC V13.5.13          OVLAP           2021-03-24 10:59:30   page:  2055
 ovlp.F90  /FF
 
     231 !  d-orbs
     232 !
     233    29 edel = one
     234       epi = -one
     235 !
     236 !  s - orbs
     237 !
     238    27 esig = one
     239    31 continue
     240 !.......................................................
     241       rij = abs (rij)
     242       if (atomk == atomkx.and.atomj == atomjx) go to 46
     243       atomkx = atomk
     244       atomjx = atomj
     245       ss = zero
     246       sp = zero
     247       sd = zero
     248       sf = zero
     249 !
     250 !     do double zeta for each atom.  when exponent is zero, quit.
     251 !
     252       issmax = 1
     253       if (nbt(i) > 3) issmax = 2
     254       jssmax = 1
     255       if (nbt(j) > 3) jssmax = 2
     256
     257       do 38 iss = 1, issmax
     258          if (nbt(i) > 3)  then
     259            acu = zetawt(iss, knat)
     260            amu = zetad(iss, knat)
     261          else
     262            acu = 1.d0
     263            amu = zeta(knat)
     264          end if
     265          if (amu < 1.0d-4) go to 38
     266
     267          do 32 jss = 1, jssmax
     268             if (nbt(j) > 3)  then
     269               bcu = zetawt(jss, jnat)
     270               bmu = zetad(jss, jnat)
     271             else
     272               bcu = 1.d0
     273               bmu = zeta(jnat)
     274             end if
     275             if (bmu < 1.0d-4) go to 32
     276
     277             abc = acu*bcu
     278             call ovlaap(knp, kl, amu, jnp, jl, bmu, rij, sss, ssp, ssd,
  ssf)
     279             ss = ss + sss*abc
     280             sp = sp + ssp*abc
     281             sd = sd + ssd*abc
     282             sf = sf + ssf*abc
     283    32       continue
     284    38    continue
     285
     286 !     **** this is some type of damping for low r, uses ZINDOs alt sing
 le STO set
     287       ggg = 0.d0
 
 FORCHECK PC V13.5.13          OVLAP           2021-03-24 10:59:30   page:  2056
 ovlp.F90  /FF
 
     288       if (kl /= jl) then
     289 !       **** set interaction factors to one for cross sp, sd, pd intera
 ctions ****
     290         sigg = one
     291         pig = one
     292         delg = one
     293         phig = one
     294       else
     295 !       **** ss, pp, or dd interaction, damped ****
     296         sigg = (fspdf(klp1, 1) + fspdf(jlp1, 1))/two
     297         pig = (fspdf(klp1, 2) + fspdf(jlp1, 2))/two
     298         delg = (fspdf(klp1, 3) + fspdf(jlp1, 3))/two
     299         phig = (fspdf(klp1, 4) + fspdf(jlp1, 4))/two
     300         sigg = sigg + (one - sigg)*ggg
     301         pig = pig + (one - pig )*ggg
     302         delg = delg + (one - delg)*ggg
     303         phig = phig + (one - phig)*ggg
     304       end if
     305
     306 !.......................................................
     307 !
     308 !  form sigma overlap
     309 !
     310  46   s(nm) = e(1)*d(1)*ss*esig*sigg
     311 !
     312 !  check how many terms in overlap
     313 !
     314       minkm = min0(kl, jl) + 1
     315       go to (50, 47, 48, 49), minkm
     316 !
     317 !  phi overlap
     318 !
     319    49 s(nm) = s(nm) + (e(6)*d(6) + e(7)*d(7))*sf*ephi*phig
     320 !
     321 !  delta overlap
     322 !
     323    48 s(nm) = s(nm) + (e(4)*d(4) + e(5)*d(5))*sd*edel*delg
     324 !
     325 !  pi overlap
     326 !
     327    47 s(nm) = s(nm) + (e(2)*d(2) + e(3)*d(3))*sp*epi*pig
     328 !
     329 !.......................................................
     330    50 continue
     331
     332 ! RMG - Ag overlap scaling
     333       if (agovlp) then
     334         if ((knat == 47.or.jnat == 47).and.knat /= jnat) then
     335           s(nm) = s(nm)*agfact
     336         end if
     337       end if
     338
     339    90 continue
     340   100 continue
     341
     342       return
     343
