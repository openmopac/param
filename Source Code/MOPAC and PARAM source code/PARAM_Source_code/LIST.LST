     189             l = ll + nmos - i - 1
     190             write (iw, '(A,5F12.6)') blank(:12*i), (fmoon(j),j=ll,l), f
 moon(k+i)
     191             ll = l + 1
     192           end do
     193         end if
     194       end if
     195 !        COMPUTE THE ELECTRONIC RELAXATION CONTRIBUTION.
     196 !
     197 !   DERNVO PROVIDES THE FOLLOWING SCRATCH AREAS TO DERI2: EIGB, WORK2,
     198 !          WORK3, CBETA.  THESE ARE DIMENSIONED ON ENTRY TO DERI2
     199 !          WHICH IS WHY THEY ARE NOT DECLARED THERE.  THEY ARE NOT USED
     200 !          AT ALL IN DERNVO.
     201 !
     202 !
     203 !  The following function was chosen as a guide to THROLD.  It is NOT
     204 !  intended to be hard-and-fast.
     205 !
     206 !     throld = max(0.001D0,min(thref,gnorm**3*0.00002D0))
     207       throld = 0.00001D0
     208       if (.not.relaxd) call deri2 (minear, fmooff, fmoon, eigbb &
     209         , ninear, ilast - ifirst + 1, dxyzr(ifirst) &
     210         , throld,  diag, scalar, work)
     211       if (moperr) goto 99
     212       if (ilast < nvax) go to 50
     213       if (debug) then
     214         sumx = 0.D0
     215         sumy = 0.D0
     216         sumz = 0.D0
     217         do i = 1, numat
     218           sumx = sumx + dxyz(i*3-2)
     219           sumy = sumy + dxyz(i*3-1)
     220           sumz = sumz + dxyz(i*3)
     221         end do
