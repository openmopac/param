    1872 subroutine prjfc (f, xparam, nvar, cof, p, atmass, x, rm, dx, coord)
    1873     use molkst_C, only: numat
    1874     use chanel_C, only: iw
    1875     implicit none
    1876     integer, intent (in) :: nvar
    1877     double precision, dimension (nvar), intent (in) :: xparam
    1878     double precision, dimension (nvar), intent (inout) :: dx, rm, x
    1879     double precision, dimension (numat), intent (in) :: atmass
    1880     double precision, dimension (3, numat), intent (inout) :: coord
    1881     double precision, dimension (nvar, nvar), intent (inout) :: cof, f,
  p
    1882     double precision, parameter :: zero = 0.0d+00
    1883     double precision, parameter :: one = 1.0d+00
    1884     double precision, parameter :: cut8 = 1.0d-08
    1885     integer :: i, ia, ib, ic, ii, ij, indx, info, ip, j, ja, jb, jc, &
    1886          & jend, jj, jndx, jp, l, natm_loc, nc1
    1887     double precision :: chk, det, sum, tmp, totm, trp
    1888     integer, dimension (6) :: iscr_loc
    1889     double precision, dimension (2) :: det2
    1890     double precision, dimension (3) :: cmass
    1891     double precision, dimension (3, 3) :: rot, scr
    1892     double precision, dimension (3, 3, 3), save :: tens
    1893     intrinsic Abs, Sqrt
    1894     data tens / 0.0d0, 0.0d0, 0.0d0, 0.0d0, 0.0d0, -1.0d0, &
    1895    & 0.0d0, 1.0d0, 0.0d0, 0.0d0, 0.0d0, 1.0d0, 0.0d0, 0.0d+0, &
    1896    & 0.0d0, -1.0d0, 0.0d0, 0.0d0, 0.0d0, -1.0d0, 0.0d0, &
    1897    & 1.0d0, 0.0d0, 0.0d0, 0.0d0, 0.0d0, 0.0d0 /
    1898     natm_loc = nvar / 3
    1899     nc1 = nvar
    1900     ij = 1
    1901     do i = 1, natm_loc
    1902       coord(1, i) = xparam(ij)
    1903       coord(2, i) = xparam(ij+1)
    1904       coord(3, i) = xparam(ij+2)
    1905       ij = ij + 3
    1906     end do
    1907    !     CALCULATE 1/SQRT(MASS)
    1908     l = 0
    1909     do i = 1, natm_loc
    1910       tmp = one / Sqrt (atmass(i))
    1911       do j = 1, 3
    1912         l = l + 1
    1913         rm(l) = tmp
    1914       end do
    1915     end do
    1916    !     PREPARE GRADIENT
    1917     do i = 1, nc1
    1918       dx(i) = zero
    1919     end do
    1920    !     FIND CMS AND CALCULATED MASS WEIGHTED COORDINATES
    1921     totm = zero
    1922     cmass(1) = zero
    1923     cmass(2) = zero
    1924     cmass(3) = zero
    1925     do i = 1, natm_loc
    1926       totm = totm + atmass(i)
    1927       do j = 1, 3
    1928         cmass(j) = cmass(j) + atmass(i) * coord(j, i)
 
 FORCHECK PC V13.5.13          PRJFC           2021-03-24 10:59:30   page:  2136
 ef.F90  /FF
 
    1929       end do
    1930     end do
    1931     do j = 1, 3
    1932       cmass(j) = cmass(j) / totm
    1933     end do
    1934     l = 0
    1935     do i = 1, natm_loc
    1936       do j = 1, 3
    1937         tmp = Sqrt (atmass(i))
    1938         l = l + 1
    1939         x(l) = tmp * (coord(j, i)-cmass(j))
    1940       end do
    1941     end do
    1942    ! 2. COMPUTE INERTIA TENSOR.
    1943     do i = 1, 3
    1944       do j = 1, 3
    1945         rot(i, j) = zero
    1946       end do
    1947     end do
    1948     do i = 1, natm_loc
    1949       l = 3 * (i-1) + 1
    1950       rot(1, 1) = rot(1, 1) + x(l+1) ** 2 + x(l+2) ** 2
    1951       rot(1, 2) = rot(1, 2) - x(l) * x(l+1)
    1952       rot(1, 3) = rot(1, 3) - x(l) * x(l+2)
    1953       rot(2, 2) = rot(2, 2) + x(l) ** 2 + x(l+2) ** 2
    1954       rot(2, 3) = rot(2, 3) - x(l+1) * x(l+2)
    1955       rot(3, 3) = rot(3, 3) + x(l) ** 2 + x(l+1) ** 2
    1956     end do
    1957     rot(2, 1) = rot(1, 2)
    1958     rot(3, 1) = rot(1, 3)
    1959     rot(3, 2) = rot(2, 3)
    1960    !
    1961    !CHECK THE INERTIA TENSOR.
    1962     chk = rot(1, 1) * rot(2, 2) * rot(3, 3)
    1963     if (Abs (chk) > cut8) then
    1964       !
    1965       ! 4. COMPUTE INVERSION MATRIX OF ROT.
    1966       !     CALL MXLNEQ(ROT,3,3,DET,JRNK,EPS,SCR,+0)
    1967       !     IF(JRNK.LT.3) CALL MOPEND
    1968       !      IF(JRNK.LT.3) RETURN
    1969       info = 0
    1970       call dgefa (rot, 3, 3, iscr_loc, info)
    1971       if (info /= 0) then
    1972         if (numat == 3 .and. natm_loc == 3) then
    1973           call mopend ("ERROR DETECTED IN EF: SYSTEM IS TRIATOMIC AND A
 LMOST LINEAR")
    1974           write(iw,'(/10x,a)')"Nine geometric parameters marked for opt
 imization."
    1975           write(iw,'(10x,a)')"Reduce this to three or four."
    1976         else
    1977           call mopend ("ERROR DETECTED IN EF: SYSTEM IS ALMOST BUT NOT
 EXACTLY LINEAR")
    1978           write(iw,'(/10x,a)')"Either define it as being linear or defi
 ne it as being non-linear."
    1979         end if
    1980       end if
    1981       if (info /= 0) return
    1982       det = zero
    1983       call dgedi (rot, 3, 3, iscr_loc, det2, scr, 1)
 
 FORCHECK PC V13.5.13          PRJFC           2021-03-24 10:59:30   page:  2137
 ef.F90  /FF
 
    1984     else if (Abs (rot(1, 1)) > cut8) then
    1985       ! X.NE.0
    1986       if (Abs (rot(2, 2)) > cut8) then
    1987          !* 4. X,Y.NE.0 BUT Z=0
    1988         det = rot(1, 1) * rot(2, 2) - rot(1, 2) * rot(2, 1)
    1989         trp = rot(1, 1)
    1990         rot(1, 1) = rot(2, 2) / det
    1991         rot(2, 2) = trp / det
    1992         rot(1, 2) = -rot(1, 2) / det
    1993         rot(2, 1) = -rot(2, 1) / det
    1994       else if (Abs (rot(3, 3)) > cut8) then
    1995          !* 5. X,Z.NE.0 BUT Y=0
    1996         det = rot(1, 1) * rot(3, 3) - rot(1, 3) * rot(3, 1)
    1997         trp = rot(1, 1)
    1998         rot(1, 1) = rot(3, 3) / det
    1999         rot(3, 3) = trp / det
    2000         rot(1, 3) = -rot(1, 3) / det
    2001         rot(3, 1) = -rot(3, 1) / det
    2002       else
    2003          !* 3. Y,Z=0 BUT X.NE.0
    2004         rot(1, 1) = one / rot(1, 1)
    2005       end if
    2006    ! X=0
    2007     else if (Abs (rot(2, 2)) > cut8) then
    2008       ! Y.NE.0
    2009       if (Abs (rot(3, 3)) > cut8) then
    2010          !* 6. Y,Z.NE.0 BUT X=0
    2011         det = rot(3, 3) * rot(2, 2) - rot(3, 2) * rot(2, 3)
    2012         trp = rot(3, 3)
    2013         rot(3, 3) = rot(2, 2) / det
    2014         rot(2, 2) = trp / det
    2015         rot(3, 2) = -rot(3, 2) / det
    2016         rot(2, 3) = -rot(2, 3) / det
    2017       else
    2018          !* 2. X,Z=0 BUT Y.NE.0
    2019         rot(2, 2) = one / rot(2, 2)
    2020       end if
    2021    ! X,Y=0
    2022     else if (Abs (rot(3, 3)) > cut8) then
    2023       !
    2024       !* 1. X,Y=0 BUT Z.NE.0
    2025       rot(3, 3) = one / rot(3, 3)
    2026     else
    2027 10000 format (1 x, "EVERY DIAGONAL ELEMENTS ARE ZERO ?", 3 f20.10)
    2028       write (iw, 10000) rot(1, 1), rot(2, 2), rot(3, 3)
    2029       return
    2030     end if
    2031    !
    2032    ! 5. TOTAL MASS ---> TOTM.
    2033    !
    2034    ! 6. COMPUTE P MATRIX
    2035    !    ----------------
    2036     do ip = 1, natm_loc
    2037       indx = 3 * (ip-1)
    2038       do jp = 1, ip
    2039         jndx = 3 * (jp-1)
    2040         do ic = 1, 3
    2041           jend = 3
    2042           if (jp == ip) then
 
 FORCHECK PC V13.5.13          PRJFC           2021-03-24 10:59:30   page:  2138
 ef.F90  /FF
 
    2043             jend = ic
    2044           end if
    2045           do jc = 1, jend
    2046             sum = zero
    2047             do ia = 1, 3
    2048               do ib = 1, 3
    2049                 if (tens(ia, ib, ic) /= 0.d0) then
    2050                   do ja = 1, 3
    2051                     do jb = 1, 3
    2052                       if (tens(ja, jb, jc) /= 0.d0) then
    2053                         sum = sum + tens(ia, ib, ic) * tens(ja, jb, jc)
  * &
    2054                        & rot(ia, ja) * x(indx+ib) * x(jndx+jb)
    2055                       end if
    2056                     end do
    2057                   end do
    2058                 end if
    2059               end do
    2060             end do
    2061             ii = indx + ic
    2062             jj = jndx + jc
    2063             p(ii, jj) = sum + dx(ii) * dx(jj)
    2064             if (ic == jc) then
    2065               p(ii, jj) = p(ii, jj) + one / (rm(ii)*rm(jj)*totm)
    2066             end if
    2067           end do
    2068         end do
    2069       end do
    2070     end do
    2071    !
    2072    ! 7. COMPUTE DELTA(I,J)-P(I,J)
    2073     do i = 1, nc1
    2074       do j = 1, i
    2075         p(i, j) = -p(i, j)
    2076         if (i == j) then
    2077           p(i, j) = one + p(i, j)
    2078         end if
    2079       end do
    2080     end do
    2081    !
    2082    ! 8. NEGLECT SMALLER VALUES THAN 10**-8.
    2083     do i = 1, nc1
    2084       do j = 1, i
    2085         if (Abs (p(i, j)) < cut8) then
    2086           p(i, j) = zero
    2087         end if
    2088         p(j, i) = p(i, j)
    2089       end do
    2090     end do
    2091
    2092 ! For GPU MOPAC
    2093 ! GBR_new_addition
    2094    !     USE COF FOR SCRATCH.
    2095     call dgemm ("N", "N", nc1, nc1, nc1, 1.0d0, f, nvar, p, nvar, &
    2096          & 0.0d0, cof, nvar)
    2097    !
    2098    ! 11. COMPUTE P*F*P.
    2099    !
    2100     call dgemm ("N", "N", nc1, nc1, nc1, 1.0d0, p, nvar, cof, nvar, &
 
 FORCHECK PC V13.5.13          PRJFC           2021-03-24 10:59:30   page:  2139
 ef.F90  /FF
 
    2101          & 0.0d0, f, nvar)
    2102     continue
    2103     return
    2104 !
    2105 end subroutine prjfc
 
