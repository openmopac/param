     322 !     *****************************************************************
 *****
     323
     324       subroutine cimat (c, gamma, beta, nbtmo, istsym, e, aocc, bocc, &
     325      &                spintr, nspn, ci, ndump)
     326       use reimers_C, only : n, nb2, matind, nconf, multci, ncore, nol,
 nvl, &
     327            nvh, nov, fastci, edef, eec, ee2, iwk, wk0, nex, cc0, mspn
     328       use cosmo_C, only : ffact, diagsl
     329
     330       implicit none
     331       double precision ::  e(nconf), beta(nb2), ci(nconf*(nconf + 1)/2)
 , &
     332                         c(n, n), gamma(n, n), spintr(mspn, nconf), &
     333                         ciener, e1, e2, xxx, edefs
     334       integer ::      istsym(nconf), nspn(nconf), io(nconf), b, &
     335                         iv(nconf), i, j, k, iout, ioutt, iw = 0, &
     336                         k1, k2, ndump, nm, nxs, nxss
     337       double precision ::  j12, k12
     338       logical*1 ::         aocc(nov, mspn, nex), bocc(nov, mspn, nex),
 same
     339       integer ::           a, nbtmo(n)
     340
     341 !     ****  RHF: generates singlet or triplet CI matrix h ****
     342 !     **** ROHF: generates CI matrix in (S) with spin Sz = MULTCI   ***
 *
     343 !     ****       and hence S**2 components > = Sz.  The S**2 matrix ***
 *
     344 !     ****       is written into matrix (T).                       ****
     345
     346 !     **** zero entire matrix ****
     347       do i = 1, matind(nconf) + nconf
     348         ci(i) = 0.d0
     349       end do
     350
     351       if (fastci) then
     352 !       ************ RHF calc, singles excitations only ***************
 *
     353
     354 !       **** CI matrix element of excitn i - >a with excitn j - >b ****
     355         do k2 = 2, nconf
     356 !         **** first, determine occ and vir levels in excitation ****
     357           io(k2) = 1
     358           do while (aocc(io(k2), 1, k2))
     359             io(k2) = io(k2) + 1
     360           end do
     361           iv(k2) = nvl - ncore
     362           do while (.not.aocc(iv(k2), 1, k2))
     363             iv(k2) = iv(k2) + 1
     364           end do
     365
     366           nm = matind(k2) + k2
     367           ci(nm) = ci(nm) + e(k2)
     368           do k1 = 2, k2 - 1
     369             if (istsym(k2) == istsym(k1)) then
     370 !             **** matrix elements, J = [ij|ab], K = [ia|jb] ****
     371               call inttr (ncore + io(k2), ncore + io(k1), ncore + iv(k2
 ), &
 
 FORCHECK PC V13.5.13          CIMAT           2021-03-24 10:59:30   page:  3975
 ci.F90  /FF
 
     372      &                    ncore + iv(k1), c, gamma, nbtmo, j12, k12, 0)
     373               nm = matind(k2) + k1
     374               ci(nm) = ci(nm) - j12
     375               if (multci == 1) ci(nm) = ci(nm) + 2.d0 * k12
     376             end if
     377           end do
     378
     379         end do
     380       else
     381
     382 !       **************** General open shell matrix elements ***********
 **
     383
     384         do k2 = 1, nconf
     385           nm = matind(k2) + k2
     386           ci(nm) = ci(nm) + e(k2)
     387           do k1 = 1, k2 - 1
     388             e1 = 0.d0
     389             if (istsym(k2) == istsym(k1)) then
     390
     391
     392 !             **** each config is a spin-adapted linear combs of dets
  ****
     393 !             **** if both sets of dets are the same, then E = 0 as the
 se ****
     394 !             **** are both eigenvectors of the same orb class in SPCLA
 S ***
     395               same = nspn(k1)  ==  nspn(k2)
     396               i = 0
     397               do while (same .and. i < nov)
     398                 i = i + 1
     399                 same = (aocc(i, 1, k1) .eqv. aocc(i, 1, k2)) .and.&
     400      &                (bocc(i, 1, k1) .eqv. bocc(i, 1, k2))
     401               end do
     402               if (.not. same) then
     403                 do i = 1, nspn(k1)
     404                   e2 = 0.d0
     405                   do j = 1, nspn(k2)
     406                     xxx = ciener (aocc(1, i, k1), &
     407      &                 bocc(1, i, k1), aocc(1, j, k2), bocc(1, j, k2),
 &
     408      &                 c, gamma, nbtmo, beta)
     409                     e2 = e2 + spintr(j, k2) * xxx
     410                   end do
     411                   e1 = e1 + spintr(i, k1) * e2
     412                 end do
     413               end if
     414               nm = matind(k2) + k1
     415               ci(nm) = ci(nm) + e1
     416
     417             end if
     418           end do
     419         end do
     420
     421       end if
     422
     423 ! RMG - add COSMO correction to CI diagonal matrix elements
     424       if (ffact > 0.d0) then
     425         do i = 1, n
 
 FORCHECK PC V13.5.13          CIMAT           2021-03-24 10:59:30   page:  3976
 ci.F90  /FF
 
     426           do j = 1, n
     427             cc0(i, j) = c(i, j)
     428           end do
     429         end do
     430         if (.not. allocated(diagsl)) allocate(diagsl(nconf))
     431         call diagci(ci, aocc, bocc, diagsl)
     432       end if
     433
     434 !     ********************** dump output ******************
     435
     436       i = 4
     437       if (ndump > 0) i = 3
     438       nxs = nov*(nov + 1)/2
     439       nxss = nxs*(nxs + 1)/2
     440       edefs = edef / 2.d0
     441
     442       if (ndump >= 2) then
     443 !       **** dump matrix elements differing by 1 electron ****
     444         write (iw, "(/' Contributions to integrals differing by 1 elect
 ron:', &
     445      &         ' from BETA, from sum over CI core, and total'/)")
     446         iout = 0
     447         ioutt = 0
     448         nm = 0
     449         do i = nol, nvh
     450           do a = nol, i
     451             nm = nm + 1
