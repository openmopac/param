 *3)
     226         end do
     227         write (iw, '(/10X,''RESIDUAL ERROR'')')
     228         write (iw, '(4X,3F12.7)') sumx, sumy, sumz
     229         write (iw, *)
     230         sumx = 0.D0
     231         sumy = 0.D0
     232         sumz = 0.D0
     233         do i = 1, numat
     234           sumx = sumx + dxyzr(i*3-2)
     235           sumy = sumy + dxyzr(i*3-1)
     236           sumz = sumz + dxyzr(i*3)
