       1 subroutine addfck (f, p)
       2     use molkst_C, only : lm61, numat, mpack
       3     use funcon_C, only : a0, ev
       4     use cosmo_C, only : ediel, fepsi, nps, &
       5      amat, bmat, iatsp, nsetf, phinet, qscnet, qdenet, ipiden, gden, qs
 cat
       6     implicit none
       7     double precision, dimension(mpack), intent(in) :: p
       8     double precision, dimension(mpack), intent(inout) :: f
       9     integer :: i, iat, im, j
      10     double precision :: fcon, fim, phi, qsc3, s1, s3
      11     fcon = a0 * ev
      12     do i = 1, numat
      13       qscat(i) = 0.d0
      14     end do
      15    ! FIRST CALCULATE QDENEL FROM DENSITY MATRIX
      16     do i = 1, lm61
      17       qdenet(i, 2) = gden(i) * p(ipiden(i))
      18       qdenet(i, 3) = qdenet(i, 2) + qdenet(i, 1)
      19     end do
      20    !  NOW CALCULATE PHIEL FROM BMAT*QDENEL
      21     do i = 1, nps
      22       phi = 0.d0
      23       do j = 1, lm61
      24         phi = phi + bmat(j, i) * qdenet(j, 2)
      25       end do
      26       phinet(i, 2) = phi
      27       phinet(i, 3) = phinet(i, 1) + phi
      28     end do
      29    !  NOW CALCULATE QSCEL FROM A*QSCEL = -PHIEL
      30     call coscl2 (amat, nsetf, qscnet(1, 2), phinet(1, 2), nps)
      31     ediel = 0.d0
      32     s1 = 0.0d0
      33     s3 = 0.0d0
      34     do i = 1, nps
      35       iat = iatsp(i)
      36       qscnet(i, 2) = -fepsi * qscnet(i, 2)
      37       qsc3 = qscnet(i, 1) + qscnet(i, 2)
      38       qscnet(i, 3) = qsc3
      39       ediel = ediel + qsc3 * phinet(i, 3)
      40       s1 = s1 + qscnet(i, 1)
      41       s3 = s3 + qsc3
      42       qscat(iat) = qscat(iat) + qsc3
      43     end do
      44     ediel = ediel * fcon / 2
      45    ! NOW ADD BMAT*QSCEL TO FOCK MATRIX
      46     do i = 1, lm61
      47       im = ipiden(i)
      48       fim = 0.d0
      49       do j = 1, nps
      50         fim = fim + bmat(i, j) * qscnet(j, 2)
      51       end do
      52       f(im) = f(im) - fcon * fim
      53     end do
      54 end subroutine addfck
 
