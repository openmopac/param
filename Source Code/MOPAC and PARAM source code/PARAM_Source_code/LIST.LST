       1 subroutine picopt (loop)
       2     use molkst_C, only: natoms, numat, nvar, ndep, numcal
       3     use common_arrays_C, only: loc, nbonds, ibonds, labels
       4     use symmetry_C, only : locdep
       5     use MOZYME_C, only : jopt, numred
       6     implicit none
       7     integer, intent (in) :: loop
       8     integer, allocatable :: iopt_loc(:)
       9 !
      10     integer :: i, j, imol = 0
      11    !*******************************************************************
 ****
      12    !
    *
      13    !   PICOPT DETERMINES WHICH ATOMS ARE TO BE USED IN THE SCF.
    *
      14    !
    *
      15    !   THIS DETERMINATION IS BASED ON THE FOLLOWING:
    *
      16    !
    *
      17    !     LOOP=-1:     USE ALL ATOMS
    *
      18    !                  ELSE USE ATOMS MARKED FOR OPTIMIZATION IN LOC.
    *
      19    !                  PLUS ANY ATOMS DEFINED BY SYMMETRY
    *
      20    !
    *
      21    !    ON EXIT, JOPT   = ATOM NUMBERS OF ATOMS TO BE USED IN SCF
    *
      22    !             NUMRED = NUMBER OF ATOMS IN JOPT
    *
      23    !
    *
      24    !   iopt is scratch,
    *
      25    !   LOC, NBONDS, IBONDS, LABELS, and LOCDEP are reference arrays
    *
      26    !
    *
      27    !*******************************************************************
 ****
      28     allocate (iopt_loc(natoms))
      29     if (loop ==-1) then
      30       iopt_loc = 1
      31     else
      32       iopt_loc = 0
      33       !
      34       !   USE THE GEOMETRY SUPPLIED
      35       !
      36       iopt_loc = 0
      37       do i = 1, nvar
      38         iopt_loc(loc(1, i)) = 2
      39       end do
      40       do i = 1, ndep
      41         iopt_loc(locdep(i)) = 2
 
 FORCHECK PC V13.5.13          PICOPT          2021-03-24 10:59:30   page:  2358
 picopt.F90  /FF
 
      42       end do
      43       !
      44       !   AT THIS POINT, iopt_loc REFERS TO ALL ATOMS, INCLUDING DUMMIE
 S.
      45       !   IN THE FOLLOWING SECTION, WE NEED TO WORK WITH REAL ATOMS
      46       !   ONLY
      47       !
      48       j = 0
      49       do i = 1, natoms
      50         if (labels(i) /= 99) then
      51           j = j + 1
      52           iopt_loc(j) = iopt_loc(i)
      53         end if
      54       end do
      55       !
      56       !   IOPT IS NOW OVER REAL ATOMS ONLY
      57       !
      58       if (imol == numcal) then
      59         do i = 1, numat
      60           if (iopt_loc(i) == 2) then
      61             do j = 1, nbonds(i)
      62               if (iopt_loc(ibonds(j, i)) == 0) then
      63                 iopt_loc(ibonds(j, i)) = 1
      64               end if
      65             end do
      66           end if
      67         end do
      68       end if
      69     end if
      70     imol = numcal
      71     numred = 0
      72     jopt = 0
      73     do i = 1, numat
      74       if (iopt_loc(i) /= 0) then
      75         numred = numred + 1
      76         jopt(numred) = i
      77       end if
      78     end do
      79     return
      80 end subroutine picopt
 
 FORCHECK PC V13.5.13          PICOPT          2021-03-24 10:59:30   page:  2359
 picopt.F90  /FF


