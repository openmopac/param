     468   subroutine memory_error(txt)
     469     USE chanel_C, only : iw
     470     character (len=*) :: txt
     471     write(iw,'(/10x,a,/)')"Unable to allocate memory in subroutine "//t
 xt(:len_trim(txt))
     472     call mopend(txt(:len_trim(txt)))
     473     return
     474   end subroutine memory_error
 
