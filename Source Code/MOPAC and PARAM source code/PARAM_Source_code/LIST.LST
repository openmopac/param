     363     subroutine fockdorbs (ia, ib, ja, jb, f, p, ptot, w, kr, ifact)
     364       use molkst_C, only: norbs, mpack
     365       implicit none
     366       integer, intent (in) :: ia, ib, ja, jb
     367       integer, intent (inout) :: kr
     368       integer, dimension (norbs), intent (in) :: ifact
     369       double precision, dimension (mpack), intent (in) :: p, ptot
     370       double precision, dimension (*), intent (inout) :: f
     371       double precision, dimension (*), intent (in) :: w
     372       integer :: i, ij, ik, il, j, jk, jl, k, ka, kb, kc, kl, l, n1, n2
 , nn, kref
     373       double precision :: a, aa, bb
     374       if (ia > ja) then
     375         do i = ia, ib
     376           ka = ifact(i)
     377           aa = 2.0d00
     378           do j = ia, i
     379             if (i == j) then
     380               aa = 1.0d00
     381             end if
     382             kb = ifact(j)
     383             ij = ka + j
     384             do k = ja, jb
     385               kc = ifact(k)
     386               ik = ka + k
     387               jk = kb + k
     388               bb = 2.0d00
     389               do l = ja, k
     390                 if (k == l) then
     391                   bb = 1.0d00
     392                 end if
     393                 il = ka + l
     394                 jl = kb + l
     395                 kl = kc + l
     396                 kr = kr + 1
     397                 a = w(kr)
     398                 f(ij) = f(ij) + bb * a * ptot(kl)
     399                 f(kl) = f(kl) + aa * a * ptot(ij)
     400                 a = a * aa * bb * 0.25d0
     401                 f(ik) = f(ik) - a * p(jl)
     402                 f(il) = f(il) - a * p(jk)
     403                 f(jk) = f(jk) - a * p(il)
     404                 f(jl) = f(jl) - a * p(ik)
     405               end do
     406             end do
     407           end do
     408         end do
     409       else
     410         kref = kr
     411         nn = jb - ja + 1
     412         nn = (nn*(nn+1)) / 2
     413         n1 = 0
     414         do i = ja, jb
     415           ka = ifact(i)
     416           aa = 2.0d00
     417           do j = ja, i
     418             n1 = n1 + 1
     419             if (i == j) then
 
 FORCHECK PC V13.5.13        FOCKDORBS         2021-03-24 10:59:30   page:  4428
 fock2.F90  /FF
 
     420               aa = 1.0d00
     421             end if
     422             kb = ifact(j)
     423             ij = ka + j
     424             n2 = 0
     425             do k = ia, ib
     426               kc = ifact(k)
     427               ik = ka + k
     428               jk = kb + k
     429               bb = 2.0d00
     430               do l = ia, k
     431                 n2 = n2 + 1
     432                 if (k == l) then
     433                   bb = 1.0d00
     434                 end if
     435                 il = ka + l
     436                 jl = kb + l
     437                 kl = kc + l
     438                 kr = kr + 1
     439                 a = w(kref+(n2-1)*nn+n1)
     440                 f(ij) = f(ij) + bb * a * ptot(kl)
     441                 f(kl) = f(kl) + aa * a * ptot(ij)
     442                 a = a * aa * bb * 0.25d0
     443                 f(ik) = f(ik) - a * p(jl)
     444                 f(il) = f(il) - a * p(jk)
     445                 f(jk) = f(jk) - a * p(il)
     446                 f(jl) = f(jl) - a * p(ik)
     447               end do
     448             end do
     449           end do
     450         end do
     451       end if
     452     end subroutine fockdorbs
 
