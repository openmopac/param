    1050 subroutine identify_hexose(ninres, inres, nam, name)
    1051   use common_arrays_C, only : nat, nbonds, ibonds, coord
    1052   use funcon_C, only : pi
    1053   implicit none
    1054   integer, intent (in) :: ninres, inres(ninres)
    1055   character, intent (inout) :: nam*3, name*60
    1056 !
    1057 !  Identify hexose by looking at the five chiral sites, C1 - C5
    1058 !  Assume that hexose exists as hemi-acetal
    1059 !
    1060   double precision :: torsion
    1061   integer :: i, j, k, l, m, backbone(6), C1, Cn, Cm, Cp, On, Hn, chiral
 (6)
    1062   integer, external :: nheavy
    1063   character :: hexose_aldose(8)*9, hexose_ketose(4)*9
    1064   logical :: aldose
    1065   data hexose_aldose /"Allose   ", "Altrose  ", "Glucose  ", "Mannose
 ", &
    1066     "Gulose   ", "Idose    ", "Galactose", "Talose   "/
    1067    data hexose_ketose /"Psicose  ", "Fructose ", "Sorbose ", "Tagatose
 "/
    1068    C1 = 0
    1069    l = 0
    1070    m = 0
    1071 !
    1072 ! First, check that all carbon atoms have four ligands
    1073 !
    1074     do i = 1, ninres
    1075       if (nat(inres(i)) == 6) then
    1076         if (nbonds(inres(i)) /= 4) then
    1077           if (nbonds(inres(i)) < 3) return
    1078           j = inres(i)
    1079           k = ibonds(4,j)
    1080           if (k == 0) return
    1081           if (nat(k) /= 8) return
    1082         end if
    1083       end if
    1084     end do
    1085     aldose = .true.
    1086 !
    1087 !  Locate C1
    1088 !
    1089     do i = 1, ninres
    1090       if (nat(inres(i)) == 6) then
    1091         C1 = inres(i)
    1092         k = 0
    1093         do j = 1, 4
    1094           if (nat(ibonds(j,C1)) == 8) k = k + 1
    1095         end do
    1096         if (k == 2) exit
    1097       end if
    1098     end do
    1099     do i = 1, nbonds(C1)
    1100       if (nat(ibonds(i,C1)) == 6) then
    1101         j = ibonds(i,C1)
    1102         if (nheavy(j) == 2) then
    1103           l = 0
    1104           do k = 1, nbonds(j)
 
 FORCHECK PC V13.5.13     IDENTIFY_HEXOSE      2021-03-24 10:59:30   page:  3194
 ligand.F90  /FF
 
    1105             if (nat(ibonds(k,j)) == 8) l = l + 1
    1106           end do
    1107           if (l == 1) then
    1108             C1 = j
    1109             aldose = .false.
    1110             exit
    1111           end if
    1112         end if
    1113       end if
    1114     end do
    1115     backbone(1) = C1
    1116     Cn = C1
    1117     Cm = Cn
    1118 !
    1119 !  Now locate C2 - C6
    1120 !
    1121     do i = 2, 6
    1122       do j = 1, 4
    1123         l = ibonds(j,Cn)
    1124         if (l == 0) return
    1125         if (nat(l) == 6 .and. l /= Cm) exit
    1126       end do
    1127       backbone(i) = l
    1128       Cm = backbone(i - 1)
    1129       Cn = l
    1130     end do
    1131     chiral = 0
    1132 !
    1133 !  Work out chirality of C1
    1134 !
    1135     On = 0
    1136     do i = 1, 4
    1137       j = ibonds(i,C1)
    1138        if (j == 0) return
    1139       if (nat(j) == 8 .and. nheavy(j) == 2) then
    1140 !
    1141 !   Make sure that the atom the oxygen is attached to is not in the rin
 g
    1142 !
    1143         do l = 1, nbonds(j)
    1144           m = ibonds(l,j)
    1145            if (m == 0) return
    1146            if (nat(m) > 1 .and. m /= C1) exit
    1147         end do
    1148         do l = 1, ninres
    1149           if (inres(l) == m) exit
    1150         end do
    1151         if (l > ninres) On = j
    1152       end if
    1153       if (nat(j) == 8 .and. nheavy(j) == 1) On = j
    1154       if (nat(j) == 1                     ) Hn = j
    1155     end do
    1156     if (On == 0) return!  Failed to find oxygen
    1157     Cp = backbone(2)
    1158     call dihed (coord, Hn, Cp, C1, On, torsion)
    1159     if (torsion > pi) torsion = torsion - 2*pi
    1160     if (torsion < 0) chiral(1) = 1
    1161 !
    1162 !  Work out chirality of C2 - C5
 
 FORCHECK PC V13.5.13     IDENTIFY_HEXOSE      2021-03-24 10:59:30   page:  3195
 ligand.F90  /FF
 
    1163 !
    1164     do k = 2, 5
    1165       Cn = backbone(k)
    1166       Cp = backbone(k + 1)
    1167       l = 0
    1168       do i = 1, 4
    1169         if (nat(ibonds(i,Cn)) == 8) l = l + 1
    1170       end do
    1171       do i = 1, 4
    1172         j = ibonds(i,Cn)
    1173         if (l == 1) then
    1174           if (nat(j) == 8) On = j
    1175           if (nat(j) == 1) Hn = j
    1176         else
    1177           if (nat(j) == 8 .and. nheavy(j) == 2) Hn = j
    1178           if (nat(j) == 8 .and. nheavy(j) == 1) On = j
    1179         end if
    1180       end do
    1181       call dihed (coord, Hn, Cn, Cp, On, torsion)
    1182       if (torsion > pi) torsion = torsion - 2*pi
    1183       if (torsion > 0) chiral(k) = 1
    1184     end do
    1185 !
    1186 !  Determine the hexose
    1187 !
    1188     if (aldose) then
