       1     subroutine geo_ref
       2 !
       3 ! geo_ref reads in the geometry reference file, and makes it as similar
       4 ! as possible to the current geometry.  It does this by:
       5 !
       6 ! Requiring files to include PDB-type information
       7 !
       8 ! The atoms of the reference geometry are put into the same sequence as
  in the current geometry.
       9 !
      10 ! If any atoms cannot be mapped from reference to current geometry, the
 n put those
      11 ! atoms at the end of the data sets.
      12 !
      13 ! Rotate and translate the geometries to put them into maximum coincide
 nce,
      14 ! i.e., minimize the RMS difference between the two geometries.
      15 !
      16 ! During this process, swap pairs of atoms, if that will lower the RMS
 difference.
      17 !
      18 !
      19       use chanel_C, only : ir, iw, output_fn, job_fn, iarc, archive_fn
      20 !
      21       use molkst_C, only : numat, keywrd, nvar, id, natoms, moperr, lin
 e, refkey, density, &
      22         maxtxt, numat_old, koment, title, geo_ref_name, geo_dat_name, a
 rc_hof_2, arc_hof_1, &
      23         keywrd_txt, pdb_label, ncomments, refkey_ref, backslash
      24 !
      25       use parameters_C, only : ams
      26 !
      27       use common_arrays_C, only : geo, coord, xparam, na, nb, nc, nat,
 c, labels, txtatm, lopt, &
      28         txtatm1, geoa, atmass, loc
      29 !
      30       use elemts_C, only: atom_names
      31       implicit none
      32 !
      33       integer :: i, j, k, l, ii, jj, i4, j4, k4, iquit, numat_dat, numa
 t_ref, ub
      34       integer, allocatable :: map_atoms_A(:), atom_no(:)
      35       character, allocatable :: tmp_txt(:)*27, diffs(:)*80
      36       double precision, allocatable :: tmp_geoa(:,:)
      37       double precision :: dum1, dum2, sum, rms, rms_min, sum1, sum2, su
 m3, &
      38         toler, xmin, sum4
      39       double precision, external :: reada
      40       logical :: intern = .true., exists, bug, any_bug, swap, first, le
 t, l_0SCF_HTML, opend
      41       logical, allocatable :: same(:), ok(:)
      42       character :: line_1*1000, line_2*1000, num*2, geo_dat*7
      43 !
      44 !   For Geo-Ref to work, some very specific conditions must be satisfie
 d.
      45 !   So before attempting a GEO_REF calculation, check that the data are
  okay
      46 !
 
 FORCHECK PC V13.5.13         GEO_REF          2021-03-24 10:59:30   page:  3102
