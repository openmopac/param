       1       double precision function volume (vecs, ndim)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       implicit none
       6 !-----------------------------------------------
       7 !   D u m m y   A r g u m e n t s
       8 !-----------------------------------------------
       9       integer , intent(in) :: ndim
      10       double precision , intent(in) :: vecs(3,ndim)
      11 !-----------------------------------------------
      12 !   L o c a l   V a r i a b l e s
      13 !-----------------------------------------------
      14       double precision :: a, b, gamma, sing
      15 !-----------------------------------------------
      16 !**********************************************************************
      17 !
      18 ! VOLUME RETURNS (A) THE VOLUME OF A UNIT CELL IF NDIM=3
      19 !                (B) THE AREA   OF A UNIT CELL IF NDIM=2
      20 !                (C) THE LENGTH OF A UNIT CELL IF NDIM=1
      21 !
      22 !  ON INPUT VECS = ARRAY OF POINTS MARKING THE ENDS OF UNIT CELL VECTOR
 S
      23 !                  THE ORIGIN BEING (0.0, 0.0, 0.0)
      24 !
      25 !**********************************************************************
      26       a = sqrt(vecs(1,1)**2+vecs(2,1)**2+vecs(3,1)**2)
      27 !
      28 !    CASE 1: SYSTEM IS A POLYMER
      29 !
      30       if (ndim == 1) then
      31         volume = a
      32         return
      33       end if
      34       b = sqrt(vecs(1,2)**2+vecs(2,2)**2+vecs(3,2)**2)
      35       gamma = sqrt((vecs(1,1)-vecs(1,2))**2+(vecs(2,1)-vecs(2,2))**2+(v
 ecs(3,1)&
      36         -vecs(3,2))**2)
      37 !
      38 !     SING = SIN OF ANGLE BETWEEN FIRST AND SECOND VECTORS
      39 !            OBTAINED FROM COSINE RULE C**2=A**2+B**2-2*A*B*COS(C)
      40 !
      41       sing = sqrt(1.D0 - ((a*a + b*b - gamma*gamma)/(2.D0*a*b))**2)
      42 !
      43 !    CASE 2: SYSTEM IS A LAYER STRUCTURE
      44 !
      45       if (ndim == 2) then
      46 !
      47 !   AREA OF A PARALLELOGRAM = BASE * HEIGHT
      48 !
      49         volume = a*b*sing
      50         return
      51       end if
      52 !
      53 !    CASE 3: SYSTEM IS A SOLID
      54 !
      55          !
      56          !      VOLUME = A.(B x C) IN VECTOR NOTATION
 
 FORCHECK PC V13.5.13          VOLUME          2021-03-24 10:59:30   page:   331
 volume.F90  /FF
 
      57          !
      58         volume = Abs (((vecs(2, 1)*vecs(3, 2)-vecs(3, 1)*vecs(2, 2))*ve
 cs(1, 3) + &
      59                        (vecs(3, 1)*vecs(1, 2)-vecs(1, 1)*vecs(3, 2))*ve
 cs(2, 3) + &
      60                        (vecs(1, 1)*vecs(2, 2)-vecs(2, 1)*vecs(1, 2))*ve
 cs(3, 3)))
      61       return
      62       end function volume
 
