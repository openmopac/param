       1 subroutine outer2 (ni, nj, xi, xj, w, kr, e1b, e2a, enuc, mode, direct)
       2     use molkst_C, only: numcal, l1u, l2u, l3u, clower
       3     use parameters_C, only: natorb, tore
       4     use common_arrays_C, only: tvec
       5     implicit none
       6     logical, intent (in) :: direct
       7     integer, intent (in) :: mode, ni, nj
       8     integer, intent (inout) :: kr
       9     double precision, intent (out) :: enuc
      10     double precision, dimension (3), intent (in) :: xi, xj
      11     double precision, dimension (7), intent (inout) :: w
      12     double precision, dimension (45), intent (out) :: e1b, e2a
      13 !
      14     logical :: si, sj
      15     integer :: icalcn = 0, i, j, k, ki, l
      16     double precision :: a, rij, rijx, w1, w2, w3, w4, w5, w6, w7, cutof
 2, enubit
      17     double precision, save :: gab
      18     double precision, dimension (3) :: x
      19     double precision, dimension (7) :: wb
      20     double precision, dimension (22) :: ri
      21     double precision, dimension(45) :: e1bits, e2bits
      22     save icalcn, cutof2
      23     if (mode == 0) then
      24 !
      25 !   Simple di-atomic
      26 !
      27       x(1) = xi(1) - xj(1)
      28       x(2) = xi(2) - xj(2)
      29       x(3) = xi(3) - xj(3)
      30       rij = x(1) * x(1) + x(2) * x(2) + x(3) * x(3)
      31       rijx = Sqrt (rij)
      32       rij = rijx
      33 !
      34 ! *** COMPUTE INTEGRALS IN DIATOMIC FRAME
      35 !
      36 !   The last argument should be QS if the Tomasi model is
      37 !   supported
      38 !
      39       call reppd (ni, nj, rij, ri, gab)
      40       a = 1.d0 / rijx
      41       x(1) = x(1) * a
      42       x(2) = x(2) * a
      43       x(3) = x(3) * a
      44       if (Abs (x(3)) > 0.99999999d0) then
      45         x(3) = Sign (1.d0, x(3))
      46       end if
      47       si = (natorb(ni) > 1)
      48       sj = (natorb(nj) > 1)
      49       w1 = ri(1)
      50       ki = 1
      51         e1b = 0.d0
      52         e2a = 0.d0
      53       e1b(1) = -w1 * tore(nj)
      54       e2a(1) = -w1 * tore(ni)
      55 !
      56       if ( .not. direct) then
      57         w(1) = w1
 
 FORCHECK PC V13.5.13          OUTER2          2021-03-24 10:59:30   page:  3520
 outer2.F90  /FF
 
      58       end if
