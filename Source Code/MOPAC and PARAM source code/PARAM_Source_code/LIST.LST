 im(line)// &
     498     """  target=""_blank"">"//trim(line)//"</a>"")</TD>"
     499     write(iprt,"(a)")"</TR></TABLE>"
     500 !
     501 !  The second entry in the first cell is a table of size (nres/5) rows,
  ncol columns.
     502 !  Write all residues in table form
     503 !
 
