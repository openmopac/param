     121
     122         SecondReactionStep: if (iloop == 1) then
     123             x0 = react(1)
     124             x1 = x0
     125             x2 = react(2)
     126             if (x2 < (-100.D0)) call mopend ('Error in PATHS')
     127             if (x2 < (-100.D0)) goto 99
     128             alparm(2,:nvar) = xparam(:nvar)
