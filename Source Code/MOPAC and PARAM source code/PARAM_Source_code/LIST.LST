       1 subroutine set_up_rapid (txt)
       2 !
       3 !  set_up_rapid creates the environment where SCF and gradient calculat
 ions can be run
       4 !  using a small number of atoms instead of the whole set.  When first
 called (option ON)
       5 !  a full SCF is done, then the atoms of interest are selected and move
 d to the start.
       6 !
       7 !  Until OFF is specified, the SCF and gradient calculations use the re
 sults of the sub-set plus
       8 !  "depleted" arrays - arrays representing the atoms not used in the SC
 F.
       9 !
      10 !  txt has three setting:
      11 !      ON    - turn on the RAPID option
      12 !      OFF   - turn off the RAPID option
      13 !      RESET - reverse the OFF option, i.e., turn RAPID on but don't do
  work such as SCF calculations
      14 !
      15   use common_arrays_C, only : xparam, grad, coord, dxyz
      16   use molkst_C, only : escf, step_num, iflepo, moperr, nelecs, numat, u
 se_ref_geo, keywrd
      17   use MOZYME_C, only : mode, nelred, numred
      18   implicit none
      19   character :: txt*2
      20   logical :: store_use_ref_geo
      21   integer, save :: store_numred, store_nelred, store_mode
      22   if (txt == "OF") then
      23 !
      24 !  Turn off the RAPID method
      25 !
      26       store_numred = numred
      27       store_mode = mode
      28       store_nelred = nelred
      29       numred = numat
      30       mode = 0
      31       nelred = nelecs
      32       return
      33   else if (txt == "RE") then
      34 !
      35 !  Turn off the RAPID method
      36 !
      37       numred = store_numred
      38       mode = store_mode
      39       nelred = store_nelred
      40       return
      41   end if
      42   if (txt /= "ON") then
      43     continue ! panic
      44   end if
      45   store_use_ref_geo = use_ref_geo
      46   use_ref_geo = .false.
      47   numred = numat
      48   mode = 0
      49   nelred = nelecs
      50 !
      51 !  When RAPID is used, do a full SCF + derivatives.  Then
 
 FORCHECK PC V13.5.13       SET_UP_RAPID       2021-03-24 10:59:30   page:  2416
 set_up_RAPID.F90  /FF
 
      52 !  identify those atoms that move.  Subsequent SCFs and derivatives
      53 !  only involve those atoms that move.
      54 !
      55 !  First, run a normal, single-point SCF calculation.  This fills all
      56 !  the arrays that will be used in future SCF calculations.
      57 !  In particular, the arrays P, H, F, and dxyz are filled.
      58 !
      59   call picopt(-1)
      60   mode = 0
      61   grad = 0.d0
      62   call compfg (xparam, .true., escf, .true., grad, (index(keywrd," RAPI
 D") /= 0))
      63 !  From here on, any call to COMPFG will use the subset of atoms.
      64 !
      65   call pinout (1, .true.)
      66 !
      67 !  Identify all the atoms that move.  The number of moving atoms is
      68 !  NUMRED
      69 !
      70   call picopt (1)
      71 !
      72   iflepo = 1
      73 !
      74 !  Increment step_num: this indicates that startup in the SCF should
      75 !  be re-done.
      76 !
      77   step_num = step_num + 1
      78 !
      79 !  The RAPID technique uses "depleted arrays"  - normal arrays that
      80 !  would be used in a full SCF, but with all terms that refer to the
      81 !  moving atoms deleted.  This is done in the following steps:
      82 ! 1.  The array is multipled by -1.
      83 ! 2.  The terms arising from the moving atoms are added to the array.
      84 ! 3.  The resulting array is again multiplied by -1.
      85 !
      86 !  That is, each array = the normal array - terms due to the moving ato
 ms.
      87 !  Each "depleted array" has the same "part<x>" where <x> refers to the
      88 !  name of the normal array.
      89 !
      90 !  Second, recalculate the one-electron matrix, but this time build the
  array parth
      91 !
      92   mode = -1
      93   call hcore_for_MOZYME ()
      94   if (moperr) return
      95 !  Build the depleted array part_dxyz if RAPID is used
      96   if (index(keywrd," RAPID") /= 0)  call dcart(coord, dxyz)
      97 !  Finally, set mode to +1.  The first time COMPFG is run, the followin
 g arrays will be built:
      98 !    partp
      99 !    partf
     100 !
     101   mode = 1
     102   use_ref_geo = store_use_ref_geo
     103   return
     104 end subroutine set_up_rapid
 
