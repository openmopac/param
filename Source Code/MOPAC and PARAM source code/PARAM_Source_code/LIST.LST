      42         arg = r(3,2)/sina
      43         if (abs(arg) > one) arg = sign(one,arg)
      44         g = asin(arg)
      45         arg = r(2,3)/sina
      46         if (abs(arg) > one) arg = sign(one,arg)
      47         a = asin(arg)
