       1    subroutine bonds_for_MOZYME ()
       2     use molkst_C, only: numat, keywrd, nl_atoms, maxtxt
       3     use chanel_C, only: iw
       4     use common_arrays_C, only : p, nat, l_atom
       5     use MOZYME_C, only : iorbs
       6     implicit none
       7     logical :: lall, mozyme_style
       8     integer :: i, io, j, jo, k, kk, kl, ku, l, newl, j_lim
       9     double precision :: sum, sumlim, valenc
      10     integer, allocatable, dimension (:) :: ibab
      11     logical, allocatable, dimension (:) :: l_atom_store
      12     double precision, allocatable, dimension (:) :: bab
      13     intrinsic Index
      14     integer, external :: ijbo
      15   !
      16     lall = (Index (keywrd, " ALLBOND") /= 0)
      17     sumlim = 0.01d0                  !  Report all bonds greater than 0
 .01 not involving hydrogen
      18     if (lall) sumlim = sumlim*0.1d0  !  Report all bonds greater than 0
 .001
      19     mozyme_style = .true.
      20     if (index(keywrd, " IRC") + index(keywrd, " DRC") + index(keywrd, "
  MINI") /= 0) mozyme_style = .false.
      21     if (mozyme_style) then
      22       if (maxtxt > 25) then
      23         write (iw, '(1X,2/37X,"(VALENCIES)",1x,"BOND ORDER       TO",/)
 ')
      24       else
      25         write (iw, '(1X,2/12X,"(VALENCIES)   BOND ORDERS",/)')
      26       end if
      27       allocate (bab(100), ibab(100))
      28     else
      29       write (iw, '(1X,2/20X,''BOND ORDERS AND VALENCIES'')')
      30       sumlim = -1.d0
      31       i = (nl_atoms*(nl_atoms + 1))/2
      32       allocate (bab(i), l_atom_store(nl_atoms))
      33     end if
      34     newl = 0
      35     l = 0
      36     do i = 1, numat
      37     if ( .not. mozyme_style .and.  .not. l_atom(i)) cycle
      38       newl = newl + 1
      39       valenc = 0.d0
      40       io = iorbs(i)
      41       if (mozyme_style) then
      42           j_lim = numat
      43           l = 0
      44         else
      45           j_lim = i - 1
      46         end if
      47       if (nat(i) /= 1 .or. lall) then
      48         if (io == 1) then
      49           kk = ijbo (i, i) + 1
      50           valenc = 2.d0 * p(kk) - p(kk) ** 2
      51         else
      52           kk = ijbo (i, i)
      53           do j = 1, iorbs(i)
      54             do k = 1, j
 
 FORCHECK PC V13.5.13     BONDS_FOR_MOZYME     2021-03-24 10:59:30   page:  3501
 bonds_for_MOZYME.F90  /FF
 
      55               kk = kk + 1
      56               valenc = valenc - 2.d0*p(kk) * p(kk)
      57             end do
      58             valenc = valenc + p(kk) * p(kk)
      59             valenc = valenc + 2.d0 * p(kk)
      60           end do
      61         end if
      62         do j = 1, j_lim
      63           if ( .not. mozyme_style .and.  .not. l_atom(j)) cycle
      64           if (nat(j) /= 1 .or. lall) then
      65             jo = iorbs(j)
      66             if (i /= j .and. ijbo (i, j) >= 0) then
      67               kl = ijbo (i, j) + 1
      68               ku = kl + io * jo - 1
      69               sum = 0.d0
      70               do k = kl, ku
      71                 sum = sum + p(k) ** 2
      72               end do
      73               if (sum > sumlim) then
      74                 l = l + 1
      75                 bab(l) = sum
      76                 if (mozyme_style) ibab(l) = j
      77               end if
      78             else
      79               if ( .not. mozyme_style) then
      80                 l = l + 1
      81                 bab(l) = 0.d0
      82               end if
      83             end if
      84           end if
      85         end do
      86         if (mozyme_style) then
      87           call print_bonds_compact(i,l, valenc, bab, ibab)
      88         else
      89           l = l + 1
      90           bab(l) = valenc
      91         end if
      92       end if
      93     end do
      94     if ( .not. mozyme_style) then
      95       l_atom_store = l_atom(:nl_atoms)
      96       l_atom(:nl_atoms) = .true.
      97       call vecprt (bab, newl)
      98       l_atom(:nl_atoms) = l_atom_store
      99       deallocate (l_atom_store, bab)
     100     end if
     101   end subroutine bonds_for_MOZYME
 
