     451   subroutine coscanz (srad, coord, nat, cosurf, iatsp, nar_loc, nsetf,
 &
     452        & phinet, arat)
     453     !******************************************************************
 *****
     454     !
     455     ! THIS ROUTINE CONSTRUCTS OR UPDATES THE SOLVENT-ACCESSIBLE
     456     ! SURFACE (SAS)
     457     ! (Linear-scaling version of the coscan routine from Cosmo)
     458     !
     459     !******************************************************************
 *****
     460     use molkst_C, only: numat
     461     use cosmo_C, only : lenabc, nps, area, cosvol, rsolv, ioldcv, dirve
