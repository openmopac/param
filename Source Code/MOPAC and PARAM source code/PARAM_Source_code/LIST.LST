     350       dipe4t = sqrt(dipe4(1)*dipe4(1)+dipe4(2)*dipe4(2)+dipe4(3)*dipe4(
 3))
     351       dipe4d = dipe4t*autodb
     352       dipdpt = sqrt(dipdp(1)*dipdp(1)+dipdp(2)*dipdp(2)+dipdp(3)*dipdp(
 3))
     353       dipdpd = dipdpt*autodb
