    2779     if(same) then         ! --- Atoms vs. points in the same box
    2780       do i3 = 1, n1
    2781         i = ind1(i3)
    2782         nao = nlast(i)-nfirst(i)
    2783         nnn = ((nao+2)*(nao+1)) / 2
    2784         v(1:nnn) = 0
    2785         ii = iatom_pos(i)
    2786
    2787         do j3 = 1, n1
    2788           jj = ind1(j3)
    2789
    2790           do j = npoints(jj), npoints(jj+1) - 1
    2791             call get_bvec (cosurf(1, j), c(1, i), nao, nat(i), w)
    2792             v(1:nnn) = v(1:nnn) + w(1:nnn) * qscnet(j, 2)
    2793           end do
    2794         end do
    2795
