     632       subroutine phase_lock(vecs,n)
     633       implicit none
     634    !
     635       integer :: n
     636       double precision, dimension (n,n) :: vecs
     637 !  Local
     638       integer :: i, j
     639       double precision :: asum, ssum
     640 !
     641 !  The convention used in MOPAC is that the phase of an eigenvector is
     642 !  defined such that the largest coefficient is positive.
     643 !
     644       do i = 1, n
     645         asum = 0.d0
     646         ssum = 0.d0
     647         do j = 1, n
     648           if (Abs(vecs(j,i)) > asum) then
     649             asum = Abs(vecs(j,i))
     650             ssum = vecs(j,i)
     651           end if
     652         end do
     653         if (ssum < 0.d0) then
     654 !
     655 !  The largest coefficient was negative - therefore reverse the phase o
 f the eigenvector
     656 !
     657           vecs(1:n,i) = -vecs(1:n,i)
     658         end if
     659       end do
     660       return
     661       end subroutine phase_lock
 
 FORCHECK PC V13.5.13        PHASE_LOCK        2021-03-24 10:59:30   page:  3840
 force.F90  /FF


