       1       subroutine symr
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use molkst_C, only : numat
       6       use common_arrays_C, only : coord
       7       use chanel_C, only : iw
       8       use symmetry_C, only : nclass, r, ipo, elem, nsym, nent
       9 !**********************************************************************
 *
      10 !-----------------------------------------------
      11 !   I n t e r f a c e   B l o c k s
      12 !-----------------------------------------------
      13       implicit none
      14 !-----------------------------------------------
      15 !   L o c a l   P a r a m e t e r s
      16 !-----------------------------------------------
      17       integer, parameter :: maxent = 6
      18 !-----------------------------------------------
      19 !   L o c a l   V a r i a b l e s
      20 !-----------------------------------------------
      21       integer :: nvalue, i, ndflt, k, j, n
      22       double precision :: x, y, z, xa, ya, za, dist
      23       logical :: prob
      24 !-----------------------------------------------
      25 !
      26 !     R(9,*):   The 9 elements of each record are a packed 3 by 3
      27 !          array of a given symmetry operations.
      28 !    IPO(n,*):  A vector that contains the symmetry mapping of atomic c
 e
      29 !
      30       if (allocated(ipo)) deallocate(ipo)
      31       allocate(ipo(numat,120))
      32       prob = .FALSE.
      33       nvalue = 0
      34 !  Get the symmetry functions: (NOTE: THE FIRST IS ALWAYS E)
      35       r(1,1) = 1.D0
      36       r(2,1) = 0.D0
      37       r(3,1) = 0.D0
      38       r(4,1) = 0.D0
      39       r(5,1) = 1.D0
      40       r(6,1) = 0.D0
      41       r(7,1) = 0.D0
      42       r(8,1) = 0.D0
      43       r(9,1) = 1.D0
      44 !
      45 !  CENTER THE MOLECULE
      46 !
      47       x = 0.D0
      48       y = 0.D0
      49       z = 0.D0
      50       do i = 1, numat
      51         x = x + coord(1,i)
      52         y = y + coord(2,i)
      53         z = z + coord(3,i)
      54         ipo(i,1) = i
      55       end do
      56       xa = x/dble(numat)
 
 FORCHECK PC V13.5.13           SYMR           2021-03-24 10:59:30   page:  1162
 symr.F90  /FF
 
      57       ya = y/dble(numat)
      58       za = z/dble(numat)
      59       coord(1,:numat) = (-xa) + coord(1,:numat)
      60       coord(2,:numat) = (-ya) + coord(2,:numat)
      61       coord(3,:numat) = (-za) + coord(3,:numat)
      62 !
      63       nent = 1
      64       nsym = 0
      65       ndflt = 1
      66    30 continue
      67       nsym = nsym + 1
      68       ndflt = ndflt + 1
      69       if (ndflt <= nclass) then
      70 !
      71 !   Copy Symmetry Operation from ELEM
      72 !
      73         k = 0
      74         nvalue = 1
      75         do i = 1, 3
      76           r(k+1:3+k,1+nent) = elem(i,:,ndflt)
      77           k = 3 + k
      78         end do
      79 !  NOW, TO CALCULATE THE IPO OF THIS FUNCTION
      80         nent = 1 + nent
      81         n = nent
      82 !  Now, to initialize IPO(n) and
      83 !  Perform R on each atomic center and determine where it maps to.
      84         l80: do i = 1, numat
      85           x = coord(1,i)*r(1,n) + coord(2,i)*r(2,n) + coord(3,i)*r(3,n)
      86           y = coord(1,i)*r(4,n) + coord(2,i)*r(5,n) + coord(3,i)*r(6,n)
      87           z = coord(1,i)*r(7,n) + coord(2,i)*r(8,n) + coord(3,i)*r(9,n)
      88           ipo(i,n) = 0
      89           do j = 1, numat
      90             dist = abs(x - coord(1,j)) + abs(y - coord(2,j)) + abs(z -
 coord(3,&
      91               j))
      92             if (dist >= 0.6D0) cycle
      93             if (ipo(i,n) == 0) then
      94               ipo(i,n) = j
      95             else
      96               write (iw, 50)
      97               prob = .TRUE.
      98               exit  l80
      99    50         format('  ONE ATOM MAPS ONTO TWO DIFFERENT ATOMIC C','ENT
 ERS',/,&
     100                 '  ADD KEYWORD '' NOSYM'' AND RE-RUN')
     101             end if
     102           end do
     103           if (ipo(i,n) /= 0) cycle  l80
     104           write (iw, 70)
     105    70     format('  ONE ATOM MAPS ONTO NO OTHER ATOM ',/,&
     106             '  ADD KEYWORD '' NOSYM'' AND RE-RUN')
     107           prob = .TRUE.
     108           exit  l80
     109         end do l80
     110 !
     111 !
     112       end if
     113       if (nvalue/=0 .and. nsym<maxent) go to 30
 
 FORCHECK PC V13.5.13           SYMR           2021-03-24 10:59:30   page:  1163
 symr.F90  /FF
 
     114 !
     115 !  If a problem exists.  Stop the program.
     116 !
     117       if (prob) then
     118         write (iw, *) ' PROBLEM IN SYMR'
     119         call mopend ('PROBLEM IN SYMR')
     120         return
     121       end if
     122       nsym = nent
     123 !
     124 !  NEXT, EXPAND THE EXISTING OPERATORS TO THE FULL SET
     125 !
     126       call symp
     127 !
     128       return
     129       end subroutine symr
 
