       1       subroutine diat(ni, nj, xj, di)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5 !-----------------------------------------------
       6 !   I n t e r f a c e   B l o c k s
       7 !-----------------------------------------------
       8       use molkst_C, only : numcal
       9       use funcon_C, only : a0
      10       use overlaps_C, only : cutof1
      11       use parameters_C, only : natorb, zs, zp, zd, npq
      12       implicit none
      13 !-----------------------------------------------
      14 !   D u m m y   A r g u m e n t s
      15 !-----------------------------------------------
      16       integer, intent(in)  :: ni
      17       integer, intent(in)  :: nj
      18       double precision, intent(in)  :: xj(3)
      19       double precision, intent(out)  :: di(9,9)
      20 !-----------------------------------------------
      21 !   L o c a l   V a r i a b l e s
      22 !-----------------------------------------------
      23       integer :: a, pq2, b, pq1
      24       integer , dimension(3,5) :: ival
      25       integer :: icalcn
      26       integer :: i, j, ia, ib, newk, nk1, iss, jss, k, kss, kmin, kmax,
  lmin, &
      27         lmax, l, ii, jj, pi, pj
      28       double precision, dimension(3,3,3) :: s
      29       double precision, dimension(3) :: ul1, ul2
      30       double precision, dimension(3,5,5) :: c
      31       double precision, dimension(27) :: slin
      32       double precision, dimension(3,5) :: c1, c2, c3, c4, c5
      33       double precision, dimension(3,3) :: s1, s2, s3
      34       double precision :: x2, y2, z2, r, aa, bb
      35       double precision, external :: ss
      36       logical :: use_diat2(107)
      37
      38       save ival, icalcn, use_diat2
      39 !-----------------------------------------------
      40 !**********************************************************************
 *
      41 !
      42 !   DIAT CALCULATES THE DI-ATOMIC OVERLAP INTEGRALS BETWEEN ATOMS
      43 !        OF ATOMIC NUMBER NI AND NJ, WHERE NJ IS AT POSITION
      44 !        XJ RELATIVE TO NI.
      45 !
      46 !   ON INPUT NI  = ATOMIC NUMBER OF THE FIRST ATOM.
      47 !            NJ  = ATOMIC NUMBER OF THE SECOND ATOM.
      48 !            XJ  = CARTESIAN COORDINATES OF THE SECOND ATOM,
      49 !                  RELATIVE TO THE FIRST ATOM.
      50 !
      51 !  ON OUTPUT DI  = DIATOMIC OVERLAP, IN A 9 * 9 MATRIX. LAYOUT OF
      52 !                  ATOMIC ORBITALS IN DI IS
      53 !                  1   2   3   4   5            6     7       8     9
      54 !                  S   PX  PY  PZ  D(X**2-Y**2) D(XZ) D(Z**2) D(YZ)D(XY
 )
      55 !
 
 FORCHECK PC V13.5.13           DIAT           2021-03-24 10:59:30   page:  1213
 diat.F90  /FF
 
      56 !   LIMITATIONS:  IN THIS FORMULATION, NI AND NJ MUST BE LESS THAN 107
      57 !         EXPONENTS ARE ASSUMED TO BE PRESENT IN COMMON BLOCK EXPONT.
      58 !
      59 !**********************************************************************
 *
      60       equivalence (slin(1), s(1,1,1))
      61       equivalence (c1(1,1), c(1,1,1)), (c2(1,1), c(1,1,2)), (c3(1,1), c
 (1,1,3)), &
      62         (c4(1,1), c(1,1,4)), (c5(1,1), c(1,1,5)), (s1(1,1), s(1,1,1)),
 (s2(1,1), &
      63         s(1,1,2)), (s3(1,1), s(1,1,3))
      64       data ival/ 1, 0, 9, 1, 3, 8, 1, 4, 7, 1, 2, 6, 0, 0, 5/
      65       data icalcn/ 0/
      66       if (icalcn /= numcal) then
      67         icalcn = numcal
      68         use_diat2 = .false.
      69         do i = 1, 17
      70           use_diat2(i) = (natorb(i) < 5)
      71         end do
      72         use_diat2(2)  = .false.
      73         use_diat2(10) = .false.
      74       end if
      75       x2 = xj(1)
      76       y2 = xj(2)
      77       z2 = xj(3)
      78       pq1 = npq(ni,1)
      79       pq2 = npq(nj,1)
      80       di = 0.0D0
      81       r = x2**2 + y2**2 + z2**2
      82       if (pq1==0 .or. pq2==0 .or. r>=cutof1) return
      83       if (natorb(ni)==0 .or. natorb(nj)==0) return
      84       call coe (x2, y2, z2, natorb(ni), natorb(nj), c, r)
      85       if (r < 0.001D0) return
      86       ia = min(pq1 + 1,3)
      87       ib = min(pq2 + 1,3)
      88       a = ia - 1
      89       b = ib - 1
      90       if (use_diat2(ni) .and. use_diat2(nj)) then
      91         call diat2 (ni, zs(ni), zp(ni), r, nj, zs(nj), zp(nj), s, a0)
      92       else
      93         ul1(1) = zs(ni)
      94         ul2(1) = zs(nj)
      95         ul1(2) = zp(ni)
      96         ul2(2) = zp(nj)
      97         ul1(3) = max(zd(ni),0.3D0)
      98         ul2(3) = max(zd(nj),0.3D0)
      99         slin = 0.0D0
     100         newk = min(a,b)
     101         nk1 = newk + 1
     102         do i = 1, ia
     103           iss = i
     104           ib = b + 1
     105           pq1 = npq(ni,i)
     106           do j = 1, ib
     107             jss = j
     108             pq2 = npq(nj,j)
     109             do k = 1, nk1
     110               if (k>i .or. k>j) cycle
     111               kss = k
 
 FORCHECK PC V13.5.13           DIAT           2021-03-24 10:59:30   page:  1214
 diat.F90  /FF
 
     112               pi = max(pq1,iss)
     113               pj = max(pq2,jss)
     114               s(i,j,k) = ss(pi,pj,iss,jss,kss,ul1(i),ul2(j),r,a0)
     115             end do
     116           end do
     117         end do
     118       end if
     119       do i = 1, ia ! i goes over  L = s, p, d for atom a
     120         kmin = 4 - i
     121         kmax = 2 + i
     122         do j = 1, ib ! j goes over  L = s, p, d for atom b
     123           if (j == 2) then
     124             aa = -1.D0
     125             bb = 1.D0
     126           else
     127             aa = 1.D0
     128             if (j == 3) then
     129               bb = -1.D0
     130             else
     131               bb = 1.D0
     132             end if
     133           end if
     134           lmin = 4 - j
     135           lmax = 2 + j
     136           do k = kmin, kmax   ! k goes over M_L = -del, -pi, sigma, pi,
  del for atom a
     137             do l = lmin, lmax ! l goes over M_L = -del, -pi, sigma, pi,
  del for atom b
     138               ii = ival(i,k)  !                     1    2     3     4
   5
     139               jj = ival(j,l)
     140               di(ii,jj) = s1(i,j)*(c3(i,k)*c3(j,l))*aa + &
     141                           s2(i,j)*(c4(i,k)*c4(j,l)+c2(i,k)*c2(j,l))*bb
 + &
     142                           s3(i,j)*(c5(i,k)*c5(j,l)+c1(i,k)*c1(j,l))
     143             end do
     144           end do
     145         end do
     146       end do
     147       return
     148       end subroutine diat
 
 FORCHECK PC V13.5.13           DIAT           2021-03-24 10:59:30   page:  1215
 diat.F90  /FF


