       2       subroutine mtxm(a, nar, b, nbr, c, ncc)
       3       implicit none
       4       integer  :: nar
       5       integer  :: nbr
       6       integer  :: ncc
       7       double precision  :: a(nbr,nar)
       8       double precision  :: b(nbr,ncc)
       9       double precision  :: c(nar,ncc)
      10 !-----------------------------------------------
      11 !     MATRIX PRODUCT C(NAR,NCC) = (A(NBR,NAR))' * B(NBR,NCC)
      12 !     ALL MATRICES RECTANGULAR , PACKED.
      13
      14       call dgemm ('T', 'N', nar, ncc, nbr, 1.0D0, a, nbr, b, nbr, 0.0D0
 , c, nar)
      15       return
      16       end subroutine mtxm
 
