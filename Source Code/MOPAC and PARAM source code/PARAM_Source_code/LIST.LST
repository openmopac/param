    1039     end interface
    1040     double precision :: t, tt
    1041     integer :: i, j, j1
    1042     intrinsic Present
    1043     !
    1044     ! ... Executable Statements ...
    1045
    1046     res = 0
    1047
    1048     if (Present (tricky_multipoles)) then
    1049       call afmm_step1 (coord, nc, n, q, tricky_multipoles)
    1050     else
    1051       call afmm_step1 (coord, nc, n, q)
    1052     end if
    1053
    1054     call afmm_step2
    1055
    1056     !
    1057     !       Step 3. Compute far interactions
    1058     !
    1059     do i = level(2), nbox
    1060       do j1 = 1, b(i)%n_l2
    1061         j = b(i)%l2(j1)
    1062         call far_int (points_index(b(i)%p_start), b(i)%n_p, &
    1063              & b(j)%phi, p, b(j)%x0, b(j)%y0, b(j)%z0, &
    1064              & y_norm, pmn, coord, nc, q, res)
    1065       end do
    1066     end do
    1067
    1068
    1069     !
    1070     !       Step 4. Calculate the potential at each charge in a box fro
 m
    1071     !       ======  direct interactions
    1072     !
    1073
    1074
    1075     t = 0
    1076     tt = n
    1077     tt = tt*(tt-1.d0) * 0.5d0
    1078     do i = 1, nbox
    1079       if (b(i)%n_childs == 0) then
    1080         call dir_int (points_index(b(i)%p_start), b(i)%n_p, &
    1081              & points_index(b(i)%p_start), b(i)%n_p, &
    1082              & coord, nc, q, res, .true.)
    1083
    1084         t = t + (b(i)%n_p * (b(i)%n_p - 1)) /2
    1085
    1086         do j1 = 1, b(i)%n_l1
    1087           j = b(i)%l1(j1)
    1088           call dir_int (&
    1089                & points_index(b(i)%p_start), b(i)%n_p, &
    1090                & points_index(b(j)%p_start), b(j)%n_p, &
    1091                & coord, nc, q, res, .false.)
    1092
    1093           t = t + b(i)%n_p * b(j)%n_p
    1094         end do
    1095       end if
    1096     end do
 
