     344       logical function collis (cw, rw, cnbr, rnbr, nnbr, ishape)
     345 !-----------------------------------------------
     346 !   M o d u l e s
     347 !-----------------------------------------------
     348 !****************************************************************
     349 !     COLLISION CHECK OF PROBE WITH NEIGHBORING ATOMS
     350 !     FOR CONNOLLY SURFACE ONLY.
     351 !****************************************************************
     352       implicit none
     353 !-----------------------------------------------
     354 !   D u m m y   A r g u m e n t s
     355 !-----------------------------------------------
     356       integer , intent(in) :: nnbr
     357       integer , intent(in) :: ishape
     358       double precision , intent(in) :: rw
     359       double precision , intent(in) :: cw(3)
     360       double precision , intent(in) :: cnbr(3,200)
     361       double precision , intent(in) :: rnbr(200)
     362 !-----------------------------------------------
     363 !   L o c a l   V a r i a b l e s
     364 !-----------------------------------------------
     365       integer :: i
     366       double precision :: sumrad, vect1, vect2, vect3, sr2, dd2
     367 !-----------------------------------------------
     368 !
     369       collis = .FALSE.
     370       if (nnbr <= 0) return
     371 !                 CHECK WHETHER PROBE IS TOO CLOSE TO ANY NEIGHBOR
     372       if (ishape == 3) then
     373       else
     374         do i = 1, nnbr
     375           sumrad = rw + rnbr(i)
     376           vect1 = dabs(cw(1)-cnbr(1,i))
     377           if (vect1 >= sumrad) cycle
     378           vect2 = dabs(cw(2)-cnbr(2,i))
     379           if (vect2 >= sumrad) cycle
     380           vect3 = dabs(cw(3)-cnbr(3,i))
     381           if (vect3 >= sumrad) cycle
     382           sr2 = sumrad**2
     383           dd2 = vect1**2 + vect2**2 + vect3**2
     384           if (dd2 < sr2) go to 20
     385         end do
     386       end if
     387       return
     388    20 continue
     389       collis = .TRUE.
     390       return
     391       end function collis
 
