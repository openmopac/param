       1       subroutine dfield()
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE parameters_C, only : tore
       6       USE molkst_C, only :numat, efield
       7       USE funcon_C, only : ev, a0, fpc_9
       8       use common_arrays_C, only : nat, p, dxyz
       9 !**********************************************************************
 *
      10 !-----------------------------------------------
      11 !   I n t e r f a c e   B l o c k s
      12 !-----------------------------------------------
      13       implicit none
      14 !-----------------------------------------------
      15 !   G l o b a l   P a r a m e t e r s
      16 !-----------------------------------------------
      17 !-----------------------------------------------
      18 !   D u m m y   A r g u m e n t s
      19 !-----------------------------------------------
      20 !-----------------------------------------------
      21 !   L o c a l   P a r a m e t e r s
      22 !-----------------------------------------------
      23 !-----------------------------------------------
      24 !   L o c a l   V a r i a b l e s
      25 !-----------------------------------------------
      26       integer :: i
      27       double precision, dimension(numat) :: q2
      28       double precision :: fldcon
      29 !-----------------------------------------------
      30       call chrge (p, q2)
      31       q2(:numat) = tore(nat(:numat)) - q2(:numat)
      32 !
      33 !   FLDCON=(h/Ao)*(eV to Kcal/mol)
      34 !
      35       fldcon = ev/a0*fpc_9
      36       do i = 1, numat
      37         dxyz(3*(i-1) + 1) = dxyz(3*(i-1) + 1) + efield(1)*q2(i)*fldcon
      38         dxyz(3*(i-1) + 2) = dxyz(3*(i-1) + 2) + efield(2)*q2(i)*fldcon
      39         dxyz(3*(i-1) + 3) = dxyz(3*(i-1) + 3) + efield(3)*q2(i)*fldcon
      40       end do
      41       return
      42       end subroutine dfield
 
