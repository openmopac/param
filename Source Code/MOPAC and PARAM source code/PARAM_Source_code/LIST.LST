     433 !     *****************************************************************
 ********
     434
     435       subroutine gsdip (xz, d, zcore, dm)
     436
     437 !     **** calculates ground-state dipole moment and Mulliken charges *
 ***
     438       use reimers_C, only : na, nb2, matind, debye, nbf, ibf, nbt, &
     439           qgs, dipgs, ndtype
     440       implicit none
     441       double precision ::  d(nb2), dm(nb2, 3), xz(na, 3), zcore(na), cm
 (3), &
     442                         pt(4), pm(3)
     443       integer ::           ind(0:8), i, j, k, ib, mu, nm, nu
     444
     445 !     ****              identify AO as s, p, d(eg) or d(t2g) ****
     446       data ind          /1, 2, 2, 2, 3, 3, 4, 4, 4/
     447
     448
     449       ndtype = 1
     450
     451       if (allocated(qgs))  deallocate(qgs)
     452       if (allocated(dipgs))  deallocate(dipgs)
     453       allocate(qgs(na))
     454       allocate(dipgs(na, 3))
     455
     456 !     **** zero counters for atomic and hybridization contributions ***
 *
     457       do i = 1, 3
     458         cm(i) = 0.d0
     459         pm(i) = 0.d0
     460       end do
     461
     462       do i = 1, na
     463         qgs(i) = zcore(i)
     464         dipgs(i, 1) = 0.d0
     465         dipgs(i, 2) = 0.d0
     466         dipgs(i, 3) = 0.d0
     467
     468 !       **** break charge up into s, p, d(eg) and d(t2g) contributions
 ****
     469         do j = 1, 4
     470           pt(j) = 0.d0
     471         end do
     472         do ib = ibf(i), ibf(i) + nbf(i) - 1
     473           nm = matind(ib) + ib
     474           j = ind(nbt(ib))
     475           pt(j) = pt(j) + d(nm)
     476         end do
     477
     478 !       **** atomic charge and its contribution to dipole moment ****
     479         qgs(i) = qgs(i) - pt(1) - pt(2) - pt(3) - pt(4)
     480         do j = 1, 3
     481           cm(j) = cm(j) + qgs(i) * xz(i, j)
     482         end do
     483
     484         if (ndtype /= 1 .or. nbf(i) <= 1) then
     485 !         **** no hybridization contribution from this atom ****
 
 FORCHECK PC V13.5.13          GSDIP           2021-03-24 10:59:30   page:   198
 scf.F90  /FF
 
     486         else
     487 !         **** determine hybridization contribution ****
     488           do mu = ibf(i), ibf(i) + nbf(i) - 1
     489             do nu = ibf(i), mu - 1
     490               nm = matind(mu) + nu
     491               do k = 1, 3
     492                 dipgs(i, k) = dipgs(i, k) + d(nm) * dm(nm, k)
     493               end do
     494             end do
     495           end do
     496           do j = 1, 3
     497             dipgs(i, j) = dipgs(i, j) * debye * 2.d0
     498             pm(j) = pm(j) + dipgs(i, j)
     499           end do
     500         end if
     501
     502       end do
     503
     504       do j = 1, 3
     505         cm(j) = cm(j) * debye
     506       end do
     507       return
     508       end subroutine gsdip
 
 FORCHECK PC V13.5.13          GSDIP           2021-03-24 10:59:30   page:   199
 scf.F90  /FF


