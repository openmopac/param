       1 double precision function disp_DnX(l_grad)
       2    use common_arrays_C, only: nat, dxyz, cell_ijk, vab
       3    use molkst_C, only : numat, l123, l1u, l2u, l3u, method_PM6_DH2X, e_
 disp
       4    implicit none
       5    logical, intent (in) :: l_grad
       6 !
       7 !  Local variables
       8 !
       9    integer :: i, j, k, l, iii, jjj, kkkk, i_cell, j_cell, iX(100), jOor
 N(100)
      10    double precision :: Rab, sum, sum2, sum3,  a_X(3,3), b_X(3,3)
      11    logical :: first = .true.
      12    logical, external :: connected
      13    double precision, external :: distance
      14    save
      15       if (first) then
      16           first = .false.
      17           if (method_PM6_DH2X) then
      18 !
      19 ! Add in Rezac and Hobza's correction: "A halogen-bonding correction fo
 r the semiempirical PM6 method"
      20 ! Chem. Phys. Lett. 506 286-289 (2011)
      21 !
      22             a_X(1,1) = 1.0489d12  ! Cl - N
      23             a_X(2,1) = 1.0226d5   ! Br - N
      24             a_X(3,1) = 1.2751d12  !  I - N
      25             a_X(1,2) = 4.6783d8   ! Cl - O
      26             a_X(2,2) = 9.6021d3   ! Br - O
      27             a_X(3,2) = 6.0912d5   !  I - O
      28             b_X(1,1) = -9.946d0   ! Cl - N
      29             b_X(2,1) = -3.236d0   ! Br - N
      30             b_X(3,1) = -9.534d0   !  I - N
      31             b_X(1,2) = -6.867d0   ! Cl - O
      32             b_X(2,2) = -2.900d0   ! Br - O
      33             b_X(3,2) = -4.154d0   !  I - O
      34           else
      35 !
      36 ! Parameters for the "X" part in the "D3H4X" method
      37 !
      38 ! Use Brahmkshatriya, et al.: "Quantum Mechanical Scoring: Structural a
 nd Energetic Insights into
      39 ! Cyclin-Dependent Kinase 2 Inhibition by Pyrazolo[1,5-a]pyrimidines" C
 urrent Computer-Aided Drug Design, 2013, 9, 118-129
      40 ! Table 2
      41             a_X(1,1) = 1.049d12   ! Cl - N
      42             a_X(2,1) = 5.560d4    ! Br - N
      43             a_X(3,1) = 5.237d8    !  I - N
      44             a_X(1,2) = 1.871d9    ! Cl - O
      45             a_X(2,2) = 2.160d4    ! Br - O
      46             a_X(3,2) = 2.436d6    !  I - O
      47             a_X(3,3) = 1.051d6    !  I - S
      48             b_X(1,1) = -9.95d0    ! Cl - N
      49             b_X(2,1) = -3.04d0    ! Br - N
      50             b_X(3,1) = -6.77d0    !  I - N
      51             b_X(1,2) = -7.44d0    ! Cl - O
      52             b_X(2,2) = -3.30d0    ! Br - O
      53             b_X(3,2) = -4.71d0    !  I - O
 
 FORCHECK PC V13.5.13         DISP_DNX         2021-03-24 10:59:30   page:  2353
 disp_DnX.F90  /FF
 
      54             b_X(3,3) = -3.82d0    !  I - S
      55           end if
      56           iX(17) = 1
      57           iX(35) = 2
      58           iX(53) = 3
      59           jOorN(7)  = 1
      60           jOorN(8)  = 2
      61           jOorN(16) = 3
      62       end if
      63       sum = 0.d0
      64       do i = 1, numat
      65         if (nat(i) /= 17 .and. nat(i) /= 35 .and. nat(i) /= 53) cycle !
  crude, but fast
      66         k = nat(i)
      67         do j = 1, numat
      68           select case (nat(j))
      69           case (7, 8, 16)
      70             if (k /= 53 .and. nat(j) == 16) cycle  ! If sulfur, only se
 lect iodine
      71             l = nat(j)
      72             Rab = distance(i, j)
      73             sum2 = a_X(iX(k),jOorN(l))
      74             sum3 = b_X(iX(k),jOorN(l))
      75             sum = sum + sum2*exp(sum3*Rab)
      76             if (l_grad) then
      77               if (connected(i,j, 8.d0**2)) then
      78   !
      79   !   kkkk is the cell that atom j is in, relative to atom i
      80   !
      81                 iii = l123*(i - 1)
      82                 jjj = l123*(j - 1)
      83                 kkkk = (l3u - cell_ijk(3)) + (2*l3u + 1)*(l2u - cell_ij
 k(2) + (2*l2u + 1)*(l1u - cell_ijk(1)))
      84                 i_cell = iii + kkkk
      85                 j_cell = jjj - kkkk
      86                 do l = 1,3
      87                   dxyz(i_cell*3 + l) = dxyz(i_cell*3 + l) + Vab(l)*sum2
 *sum3*exp(sum3*Rab)/Rab
      88                   dxyz(j_cell*3 + l) = dxyz(j_cell*3 + l) - Vab(l)*sum2
 *sum3*exp(sum3*Rab)/Rab
      89                 end do
      90               end if
      91             end if
      92           end select
      93         end do
      94       end do
      95       disp_DnX = sum
      96       e_disp = e_disp + sum
      97       return
      98   end function disp_DnX
 
