 chkion.F90  /FF
 
     340             if (ib(jj) <= 0) exit
     341             call add_Lewis_element(0,jj,0, dummy)  ! Virtual lone pair
     342           end do
     343           exit
     344         end if
     345       end do
     346     end do
     347 !
     348 !   Convert all remaining undetermined charged carbon atoms into anions
     349 !
     350     do j = 1, Lewis_tot
     351       jj = Lewis_elem(1,j)
     352       if (jj < 0) then
     353         jj = -jj
     354         Lewis_elem(1,j) = jj
     355         n_lone_pairs = n_lone_pairs + 1
     356         if (iz(jj) == 1) iz(jj) = 0
     357         if (ib(jj) == 1) then
     358 !
     359 ! create a virtual lone pair
     360 !
     361           write (iw,'(/10x,a,i6,a)') " WARNING: Carbon atom ", jj, " ha
 s an unexpected valency!   PDB Label: """// &
     362             txtatm(jj)//""""
     363           if (nbonds(jj) > 0) then
     364             num = "1"
     365             do k = 1, nbonds(jj)
     366               num(k) = char(ichar("1") +int(log10(ibonds(k,jj) + 0.05))
 )
     367             end do
     368             line = '(10x,a,a,i'//num(1)//',3x,a,i'//num(2)//',3x,a,i'//
 num(3)//',3x,a,i'//num(4)//',3x,a,i'
     369             line = trim(line)//num(5)//',3x,a,i'//num(6)//',3x,a,i'//nu
 m(7)//',3x,a,i'//num(8)
     370             line = trim(line)//',3x,a,i'//num(9)//',3x,a,i'//num(10)//'
 ,a)'
     371             write (iw,trim(line))" It is connected to:  ",(elemnt(nat(i
 bonds(k,jj))),ibonds(k,jj), k = 1, nbonds(jj)), "only"
     372           else
     373             write (iw,'(a)')" It is not connected to any other atom."
     374           end if
     375           write(iw,"(/)")
     376           call add_Lewis_element(0,jj,0, dummy)  ! Virtual lone pair
     377           ib(jj) = 0
     378         end if
     379       end if
     380     end do
     381
     382     return
     383 1040 write (iw,*) " CHARGE ON ATOM", i, " UNREASONABLE"
     384     call mopend ("Charge on an atom is unreasonable")
     385 end subroutine chkion
 
