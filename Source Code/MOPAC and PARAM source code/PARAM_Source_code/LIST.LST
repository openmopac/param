    2490       subroutine fordd
    2491 !-----------------------------------------------
    2492 !   M o d u l e s
    2493 !-----------------------------------------------
    2494       USE mndod_C, only : indx, indexd, ch, ind2, isym, inddd, inddp, i
 ndpp
    2495 !     *
    2496 !     DEFINITION OF INDICES AND LOGICAL VARIABLES.
    2497 !     *
    2498       implicit none
    2499 !-----------------------------------------------
    2500 !   L o c a l   V a r i a b l e s
    2501 !-----------------------------------------------
    2502       integer :: i, j, l
    2503 !-----------------------------------------------
    2504 !     *
    2505 !     INDEX(I,J) AND INDX(I,J) DEFINE ADDRESSES IN LOWER TRIANGLE
    2506 !     BY DIFFERENT CONVENTIONS.
    2507 !     INDEX(I,J) = 1,2,3 ..  FOR (I,J)=(1,1),(2,1),(3,1),..,(2,2),(3,2)
    2508 !     INDX(I,J)  = 1,2,3 ..  FOR (I,J)=(1,1),(2,1),(2,2),(3,1),(3,2) ..
    2509 !     INDX(I,J)    CORRESPONDS TO THE USUAL PAIR INDEX.
    2510 !     INDEX(J,I) = INDEX(I,J)
    2511 !     INDX(J,I)  = INDX(I,J)
    2512 !     *
    2513 !     *
    2514 !     COEFFICIENTS RELATING ANALYTICAL AND POINT-CHARGE MULTIPOLE
    2515 !     MOMENTS, SEE EQUATION (17) AND TABLE 2 OF TCA PAPER.
    2516 !     *
    2517 !     FIRST  INDEX          STANDARD PAIR INDEX (SPD BASIS)
    2518 !     SECOND INDEX          L QUANTUM NUMBER FOR MULTIPOLE MOMENT
    2519 !     THIRD  INDEX          M QUANTUM NUMBER FOR MULTIPOLE MOMENT
    2520 !     *
    2521 !
    2522       do i = 1, 9
    2523         do j = 1, i
    2524           indexd(i,j) = (-(j*(j - 1))/2) + i + 9*(j - 1)
    2525           indx(i,j) = (i*(i - 1))/2 + j
    2526           indexd(j,i) = indexd(i,j)
    2527           indx(j,i) = indx(i,j)
    2528         end do
    2529       end do
    2530 !
    2531       ind2 = 0
    2532 !
    2533 !   SP-SP
    2534       ind2(1,1) = 1
    2535       ind2(1,2) = 2
    2536       ind2(1,10) = 3
    2537       ind2(1,18) = 4
    2538       ind2(1,25) = 5
