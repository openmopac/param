       1 double precision function pardip (coord, nat)
       2   !********************************************************************
 **
       3   !
       4   !   PARDIP  1:  Computes the dipole moment.
       5   !
       6   !********************************************************************
 **
       7     use molkst_C, only : numat
       8     use parameters_c, only : tore
       9     use common_arrays_C, only : p, q
      10   !
      11   !.. Implicit Declarations ..
      12     implicit none
      13   !
      14   !.. Formal Arguments ..
      15     double precision, dimension (3, numat), intent (inout) :: coord
      16     integer, dimension (numat), intent (in) :: nat
      17   !
      18   !.. Local Scalars ..
      19     integer :: i, l
      20   !
      21   !.. Local Arrays ..
      22     double precision, dimension (3) :: dumy
      23   !
      24   !.. External Calls ..
      25     external chrge
      26   !
      27   !.. External Functions ..
      28     double precision, external :: dipole
      29   !
      30   ! ... Executable Statements ...
      31   !
      32   !
      33   !  Calculate the total number of electrons on each atom
      34   !
      35     call chrge (p, q)
      36   !
      37   !  Calculate the charge on each atom
      38   !
      39     do i = 1, numat
      40       l = nat(i)
      41       q(i) = tore(l) - q(i)
      42     end do
      43   !
      44   !  Calculate the dipole
      45   !
      46     pardip = dipole (p, coord, dumy, 1)
      47 end function pardip
 
