    2730 ! IGAM=1 (THIRD HARMONIC GENERATION)
    2731 !
    2732       jgarc = 22
    2733       juarc = 19
    2734       jurec = 7
    2735       jgrec = 10
    2736       jg2rec = 55
    2737       ju2rec = 49
    2738       ju2mrc = 67
    2739       jeprec = 61
    2740 !
    2741 ! LOOP BEGINS FOR THE CALCULATION OF GAMMA(ABCD)
    2742 !
    2743       gav = 0.0D+00
    2744       do ie = 1, 9
    2745 !
    2746         ia = ida(ie)
    2747         ib = idb(ie)
    2748         ic = idc(ie)
    2749         id = idd(ie)
    2750         icd = ipair(ic,id)
    2751         ibd = ipair(ib,id)
    2752         ibc = ipair(ib,ic)
    2753 !
    2754 !  READ IN THE FIRST ORDER U3 OMEGA AND G3 OMEGA IN THE DIRECTION A
    2755 !
    2756 ! MAKE GD3 OMEGA MATRIX FROM G3 MATRIX
    2757 !
    2758         call daread (x, msq, jgarc + ia)
    2759         call fhpatn (gd3, x, norbs, 2, one)
    2760 !
    2761 ! MAKE UD3 OMEGA MATRIX FROM U3 OMEGA MATRIX
    2762 !
    2763         call daread (x, msq, juarc + ia)
    2764         call fhpatn (ud3, x, norbs, 2, (-one))
    2765 !
    2766         yy = 0.0D00
    2767         imove = 1
    2768    30   continue
    2769 !
    2770         select case (imove)
    2771 !
    2772         case default
    2773           j2 = ib
    2774           j34 = icd
    2775         case (2)
    2776           j2 = ic
    2777           j34 = ibd
    2778         case (3)
    2779           j2 = id
    2780           j34 = ibc
    2781         end select
    2782 !
    2783 !  READ IN G1,U1,GS,US,UMS,EPS
    2784 !
    2785 !  GET  UB
