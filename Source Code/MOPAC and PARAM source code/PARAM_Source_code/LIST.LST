       1       subroutine intfc(fmatrx, xparam, georef, nar, nbr, ncr)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use molkst_C, only : natoms, nvar, numat, l123, l1u, l2u, l3u
       6       use common_arrays_C, only : na, nb, nc, geo, loc, labels, nat
       7       use chanel_C, only : iw
       8       use elemts_C, only : elemnt
       9       use to_screen_C, only : fcint
      10 !**********************************************************************
 *
      11 !-----------------------------------------------
      12 !   I n t e r f a c e   B l o c k s
      13 !-----------------------------------------------
      14       implicit none
      15 !-----------------------------------------------
      16 !   D u m m y   A r g u m e n t s
      17 !-----------------------------------------------
      18       integer , intent(in) :: nar(natoms)
      19       integer , intent(in) :: nbr(natoms)
      20       integer , intent(in) :: ncr(natoms)
      21       double precision , intent(in) :: fmatrx((3*numat*(3*numat + 1))/2
 )
      22       double precision  :: xparam(nvar)
      23       double precision , intent(in) :: georef(3,natoms)
      24 !-----------------------------------------------
      25 !   L o c a l   P a r a m e t e r s
      26 !-----------------------------------------------
      27 !-----------------------------------------------
      28 !   L o c a l   V a r i a b l e s
      29 !-----------------------------------------------
      30       integer :: j, i, ilim, n3, k, ncol
      31       double precision :: step, stepi, sum, dumy(3*numat*l123)
      32       logical :: precis, lxyz
      33 !-----------------------------------------------
      34       nvar = 0
      35       numat = 0
      36       l1u = 0
      37       l2u = 0
      38       l3u = 0
      39       j = 0
      40       do i = 1, natoms
      41       if (nar(i) /= 0) j = j + 1
      42       end do
      43       lxyz = (j == 0) ! All coordinates are Cartesian
      44       na(:natoms) = nar
      45       nb(:natoms) = nbr
      46       nc(:natoms) = ncr
      47       if (allocated(fcint)) deallocate (fcint)
      48       allocate(fcint(3,natoms))
      49       fcint(:,:natoms) = 0.D0
      50       geo(:,:natoms) = georef
      51       do i = 1, natoms
      52         if (labels(i) == 99) cycle
      53         numat = numat + 1
      54         if (lxyz) then
      55           ilim = 3
      56         else
 
 FORCHECK PC V13.5.13          INTFC           2021-03-24 10:59:30   page:  2215
 intfc.F90  /FF
 
      57           ilim = min(3,i - 1)
      58         end if
      59         do j = 1, ilim
      60           nvar = nvar + 1
      61           loc(1,nvar) = i
      62           loc(2,nvar) = j
      63           xparam(nvar) = geo(j,i)
      64         end do
      65       end do
      66       n3 = 3*numat
      67 !
      68 !   Calculate force constants over internal coordinates
      69 !
      70       step = 1.D-7
      71       stepi = 0.5D0/step
      72       precis = .TRUE.
      73       if (lxyz) then
      74         write (iw, '(/,10X,A,/)') &
      75           ' FORCE CONSTANT IN CARTESIAN COORDINATES (Millidynes/A)'
      76         write (iw, '(A)') &
      77           '    ATOM   CHEMICAL       X               Y               Z'
      78         write (iw, '(A)') &
      79           '   NUMBER   SYMBOL  FORCE CONSTANT  FORCE CONSTANT  FORCE CO
 NSTANT'
      80       else
      81         write (iw, '(/,10X,A,/)') &
      82           ' FORCE CONSTANT IN INTERNAL COORDINATES (Millidynes/A)'
      83         write (iw, '(A)') &
      84           '    ATOM   CHEMICAL  BOND LENGTH      BOND ANGLE     TWIST A
 NGLE'
      85         write (iw, '(A)') &
      86           '   NUMBER   SYMBOL  FORCE CONSTANT  FORCE CONSTANT  FORCE CO
 NSTANT'
      87       end if
      88       write (iw, '(A)')
      89       l123 = 1
      90       do i = 1, nvar
      91         j = i
      92         call jcarin (xparam, step, precis, dumy, ncol, i, j)
      93         dumy(:n3) = dumy(:n3)*stepi
      94 !
      95 !   Calculate internal force constant
      96 !
      97         sum = 0.D0
      98         do j = 1, n3
      99           do k = 1, n3
     100             if (j >= k) then
     101               sum = sum + dumy(j)*fmatrx((j*(j-1))/2+k)*dumy(k)
     102             else
     103               sum = sum + dumy(j)*fmatrx((k*(k-1))/2+j)*dumy(k)
     104             end if
     105           end do
     106         end do
     107 !
     108 !   1.D-5 is to correct the multiplier in FREQCY of the force constants
     109 !
     110         fcint(loc(2,i),loc(1,i)) = sum*1.d-5
     111       end do
     112       if (ncol < 0) return ! dummy statement, just to use ncol
 
 FORCHECK PC V13.5.13          INTFC           2021-03-24 10:59:30   page:  2216
 intfc.F90  /FF
 
     113       write (iw, '(I7,6X,A2,3F16.6)') (i,elemnt(nat(i)),(fcint(j,i),j=1
 ,3),i=1,&
     114         numat)
     115       call to_screen("To_file: Internal Force Constants")
     116       deallocate(fcint)
     117       return
     118       end subroutine intfc
 
