     241 !
     242 !
     243 !
     244    double precision function Si_O_H_Correction()
     245 !
     246 !   If an Si-O-H structure, add in a bending perturbation
     247 !
     248       use common_arrays_C, only : nat, nbonds, ibonds, coord
     249 !
     250       use molkst_C, only : numat
     251 !
     252       implicit none
     253       integer :: i, j, k, Si, O, H
     254       double precision :: sum
     255       double precision, external :: Si_O_H_bond_correction
     256 !
     257       sum = 0.d0
     258       do i = 1, numat
     259         if (nat(i) == 8) then
     260           O = i
     261           Si = 0
     262           H = 0
     263           do j = 1, nbonds(i)
     264             k = ibonds(j,i)
     265             if (nat(k) == 14) Si = k
     266             if (nat(k) == 1) H = k
     267           end do
     268           if (Si /= 0 .and. H /= 0) then
     269           sum = sum + Si_O_H_bond_correction(coord, Si, O, H)
     270           end if
     271         end if
     272       end do
     273       Si_O_H_Correction = sum
     274       return
     275     end function Si_O_H_Correction
 
