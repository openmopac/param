    2999   subroutine sphere_f_multipoles (x0, y0, z0, ind, n, pmn, y_norm, &
    3000        & c, nc, q, psi, p)
    3001     !
    3002     ! Computes multipole expansions of surface charges
    3003     !
    3004
    3005     use cosmo_C, only: qscnet, cosurf
    3006
    3007     !
    3008     !.. Implicit Declarations ..
    3009     implicit none
    3010     !
    3011     !.. Formal Arguments ..
    3012     double precision, intent(in) :: x0, y0, z0
    3013     integer, intent(in) :: n, nc, p
    3014     integer, dimension(*), intent(in) :: ind
    3015     double precision, dimension(nc, *), intent(in) :: c
    3016     double precision, dimension(*), intent(in) :: q
    3017     double precision, dimension(-p:p, 0:p), intent(in) :: y_norm
    3018     double precision, dimension(-p:p, 0:p), intent(inout) :: pmn
    3019
    3020     complex (kind=dcmplx_kind), dimension(-p:p, 0:p), intent(inout) ::
 psi
    3021     !
    3022     !.. Local Scalars ..
    3023     double precision :: dx, dy, dz, t, tt, r, cos_t, phi, qq
    3024     complex (kind=dcmplx_kind) :: tc, tc1
    3025     integer :: j, j1, k, n1, m1
    3026     !
    3027     !.. Intrinsic Functions ..
    3028     intrinsic Sqrt, Atan2, Cmplx, Exp, Conjg
    3029     !
    3030     ! ... Executable Statements ...
    3031
    3032 !
    3033 ! Dummy statement to "use" q and c
    3034 !
    3035     t = q(1) + c(1,1)
    3036     do j = 1, n
    3037       j1 = ind(j)   ! atom number
    3038       do k = npoints(j1), npoints(j1+1) - 1
    3039         dx = cosurf(1, k) - x0
    3040         dy = cosurf(2, k) - y0
    3041         dz = cosurf(3, k) - z0
    3042         qq = qscnet(k, 2)
    3043         r = Sqrt (dx**2 + dy**2 + dz**2)
    3044         cos_t = dz / r
    3045         phi = Atan2 (dy, dx)
    3046
    3047         call get_legendre (p, cos_t, pmn)
    3048
    3049         psi(0, 0) = psi(0, 0) + Cmplx(qq, 0.d0, dcmplx_kind)
    3050
    3051         t = 1.d0
    3052         do n1 = 1, p
    3053           t = t * r
    3054           do m1 = 0, n1
    3055             tc = Exp (Cmplx (0.d0, -m1*phi, dcmplx_kind))
 
 FORCHECK PC V13.5.13   SPHERE_F_MULTIPOLES    2021-03-24 10:59:30   page:  2324
 linear_cosmo.F90  /FF
 
    3056             tt = y_norm(-m1, n1) * pmn(-m1, n1) * t * qq
    3057             tc1 = tc * tt
    3058             psi(m1, n1) = psi(m1, n1) + tc1
    3059           end do
    3060         end do
    3061
    3062         do n1 = 1, p
    3063           do m1 = 1, n1
    3064             psi(-m1, n1) = Conjg (psi(m1, n1))
    3065           end do
    3066         end do
    3067
    3068       end do
    3069     end do
    3070
    3071   end subroutine sphere_f_multipoles
 
