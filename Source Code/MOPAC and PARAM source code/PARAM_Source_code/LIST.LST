       1       subroutine timer(a)
       2 !
       3 !  Write out CPU and wall-clock times for the current step, and total t
 imes
       4 !
       5       Use molkst_C, only : wall_clock_0, wall_clock_1, CPU_1, CPU_0
       6       USE chanel_C, only : iw
       7       implicit none
       8       character , intent(in) :: a*(*)
       9       character :: b*20
      10       double precision :: CPU_start, CPU_last, CPU_now
      11       real :: wall_clock_last, dummy
      12       logical :: first
      13       double precision, external :: seconds
      14       save first, CPU_start, CPU_last, wall_clock_last
      15       data first/ .TRUE./
      16       if (first) then
      17 !
      18 !  DEFINE THE ZERO OF TIME
      19 !
      20         CPU_start = seconds(1)
      21         CPU_start = CPU_0
      22         CPU_last = CPU_start
      23         wall_clock_last = wall_clock_1
      24         wall_clock_0 = wall_clock_last
      25         first = .FALSE.
      26       end if
      27 !
      28 ! "dummy" call: wall_clock_1 is set in seconds(1), but call needed to s
 et CPU_1
      29 !
      30       dummy = real(seconds(1))
      31       if (dummy < -300.0) return
      32       CPU_now = CPU_1
      33       b = a
      34       write (iw, '(2x, a20, a, f7.2,  a, f11.2, a, f7.2, a, f9.2)') b,
 'CPU INTERVAL:', &
      35       CPU_now - CPU_last, ', INTEGRAL:', CPU_now - CPU_start, &
      36       '    WALL-CLOCK INTERVAL:', wall_clock_1 - wall_clock_last, ', IN
 TEGRAL:', &
      37       wall_clock_1 - wall_clock_0
      38       CPU_last = CPU_now
      39       wall_clock_last = wall_clock_1
      40       return
      41       end subroutine timer
 
