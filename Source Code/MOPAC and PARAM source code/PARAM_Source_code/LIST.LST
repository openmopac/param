       1       SUBROUTINE FINISH
       2 !
       3 !   MOPEND SHUTS ALL FILES WHICH MAY HAVE BEEN OPENED
       4 !        AND THEN STARTS A RAPID RETURN TO THE MAIN SEGMENT
       5 !
       6       use chanel_C, only: iend, end_fn
       7       use param_global_C, only : ifiles_8
       8       implicit none
       9       logical :: exists
      10       integer :: i
      11       inquire (file = end_fn, exist = exists)
      12       if (exists) then
      13         open(unit=iend, file=end_fn, status='UNKNOWN', position='asis',
  iostat=i)
      14         if (i == -100) return
      15         close(iend, status = 'delete', iostat=i)
      16         if (i == -100) return
      17       end if
      18       end_fn = end_fn(:len_trim(end_fn) - 3)//"res"
      19       inquire (file = end_fn, exist = exists)
      20       if (exists) then
      21         open(unit=iend, file=end_fn, status='UNKNOWN', position='asis',
  iostat=i)
      22         if (i == -100) return
      23         close(iend, status = 'delete', iostat=i)
      24         if (i == -100) return
      25       end if
      26       write (ifiles_8, '(/,'' == PARAM DONE =='')')
      27       stop
      28       END
 
