     251   double precision function distance(a, b)
     252     use common_arrays_C, only: coord, tvec, cell_ijk, Vab
     253     use molkst_C, only : id, l1u, l2u, l3u, temp_1, temp_2, temp_3
     254     implicit none
     255       integer :: a,  b
     256       integer :: ik, jk, kl
     257       double precision :: coord1(3), sum
     258       if (id == 0) then
     259         temp_1 = coord(1, a)-coord(1, b)
     260         temp_2 = coord(2, a)-coord(2, b)
     261         temp_3 = coord(3, a)-coord(3, b)
     262         distance = sqrt(temp_1**2 + temp_2**2 + temp_3**2)
     263         Vab(:) = coord(:, a) - coord(:, b)
     264       else
     265         distance = 1.d6
     266         do ik = -l1u, l1u
     267           do jk = -l2u, l2u
     268             do kl = -l3u, l3u
     269               coord1(:) = coord(:, a) + tvec(:, 1)*ik + tvec(:, 2)*jk +
  tvec(:, 3)*kl
     270               sum =  (coord1(1)-coord(1, b))**2 &
     271                    + (coord1(2)-coord(2, b))**2 &
     272                    + (coord1(3)-coord(3, b))**2
     273               if (sum < distance) then
     274                 distance = sum
     275                 temp_1 = coord1(1)-coord(1, b)
     276                 temp_2 = coord1(2)-coord(2, b)
     277                 temp_3 = coord1(3)-coord(3, b)
     278                 Vab(:) = coord1(:)-coord(:, b)
     279                 cell_ijk(1) = ik
     280                 cell_ijk(2) = jk
     281                 cell_ijk(3) = kl
     282               end if
     283             end do
     284           end do
     285         end do
     286         distance = sqrt(distance)
     287       end if
     288   end function distance
 
