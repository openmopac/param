       1       subroutine repp(ni, nj, rij, ri, core, cutoff, a0, ev, ev1, ev2,
 ev3, ev4)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use parameters_C, only : natorb, am, ad, aq, dd, qq, tore
       6
       7 !**********************************************************************
 *
       8 !
       9 !..VECTOR VERSION WRITTEN BY ERNEST R. DAVIDSON, INDIANA UNIVERSITY
      10 !
      11 !
      12 !  REPP CALCULATES THE TWO-ELECTRON REPULSION INTEGRALS AND THE
      13 !       NUCLEAR ATTRACTION INTEGRALS.
      14 !
      15 !     ON INPUT RIJ     = INTERATOMIC DISTANCE
      16 !              NI      = ATOM NUMBER OF FIRST ATOM
      17 !              NJ      = ATOM NUMBER OF SECOND ATOM
      18 !    (REF)     ADD     = ARRAY OF GAMMA, OR TWO-ELECTRON ONE-CENTER,
      19 !                        INTEGRALS.
      20 !    (REF)     TORE    = ARRAY OF NUCLEAR CHARGES OF THE ELEMENTS
      21 !    (REF)     DD      = ARRAY OF DIPOLE CHARGE SEPARATIONS
      22 !    (REF)     QQ      = ARRAY OF QUADRUPOLE CHARGE SEPARATIONS
      23 !              CUTOFF  = MAXIMUM DISTANCE FOR 'NORMAL' INTERACTION.
      24 !                        BEYOND CUTOFF ALL INTERACTIONS BECOME
      25 !                        POINT-CHARGE, AND ARE BROUGHT IN TO
      26 !                        CUTOFF.
      27 !
      28 !
      29 !    ON OUTPUT RI      = ARRAY OF TWO-ELECTRON REPULSION INTEGRALS
      30 !              CORE    = 4 X 2 ARRAY OF ELECTRON-CORE ATTRACTION
      31 !                        INTEGRALS
      32 !
      33 !
      34 ! *** THIS ROUTINE COMPUTES THE TWO-CENTRE REPULSION INTEGRALS AND THE
      35 ! *** NUCLEAR ATTRACTION INTEGRALS.
      36 ! *** THE TWO-CENTRE REPULSION INTEGRALS (OVER LOCAL COORDINATES) ARE
      37 ! *** STORED AS FOLLOWS (WHERE P-SIGMA = O,  AND P-PI = P AND P* )
      38 !     (SS/SS)=1,   (SO/SS)=2,   (OO/SS)=3,   (PP/SS)=4,   (SS/OS)=5,
      39 !     (SO/SO)=6,   (SP/SP)=7,   (OO/SO)=8,   (PP/SO)=9,   (PO/SP)=10,
      40 !     (SS/OO)=11,  (SS/PP)=12,  (SO/OO)=13,  (SO/PP)=14,  (SP/OP)=15,
      41 !     (OO/OO)=16,  (PP/OO)=17,  (OO/PP)=18,  (PP/PP)=19,  (PO/PO)=20,
      42 !     (PP/P*P*)=21,   (P*P/P*P)=22.
