    3265         yy = yy + trsub(u1,gd3,us,nclose,norbs,norbs)
    3266         yy = yy - trsub(usmd,gd3,u1,nclose,norbs,norbs)
    3267         yy = yy - trsub(u1,gd3,us,norbs,nclose,norbs)
    3268         yy = yy + trsub(usmd,gd3,u1,norbs,nclose,norbs)
