 2,j) - &
    1076             (ewcz(ipe+1+ipx-ipx2:npr-ipx2,j)-potp3)*rnai1(ipe+1+ipx-ipx
 2:npr-ipx2,j)
    1077           end do
    1078           ips = ic*icd - icd + 1
    1079           do i = ic, ncc
    1080             jps = i*icd - icd + 1
    1081             espi(i,ic) = 0.D0
    1082             do j = jps, jps + icd - 1
    1083               espi(i,ic) = espi(i,ic) + sum(cc(j)*cc(ips:icd-1+ips)*u_e
 sp(j,:icd))
    1084             end do
    1085             es(iesp) = es(iesp) + 2.D0*cespm(indc(i),indc(ic))*espi(i,i
 c)
 
