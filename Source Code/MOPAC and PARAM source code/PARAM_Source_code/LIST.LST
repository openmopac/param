      84             end do
      85             do i1 = 1, 10
      86               arot(irot(1, i1), irot(2, i1)) = c(irot(3, i1), irot(4, i
 1), &
      87              & irot(5, i1))
      88             end do
      89             do i1 = 1, io
      90               do j1 = 1, jo
      91                 vect(i1, j1) = 0.d0
      92               end do
      93             end do
      94             if (i /= j) then
      95               ij = Max (io, jo)
      96               do i1 = 1, io
      97                 do j1 = 1, jo
      98                   sum = 0.d0
      99                   do l1 = 1, ij
     100                     do l2 = 1, ij
     101                       sum = sum + arot(l1, i1) * pab(l1, l2) * arot(l2,
  j1)
     102                     end do
     103                   end do
     104                   vect(isp(i1), isp(j1)) = vect(isp(i1), isp(j1)) + sum
  ** 2
     105                 end do
     106               end do
     107             end if
     108             sigpi(2) = 0.d0
 
