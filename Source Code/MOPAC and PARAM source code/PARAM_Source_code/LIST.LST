     288             call mopend(trim(line))
     289             write(iw,"(10x,a,i"//num1//",a,/)")"(Label for atom ", i, "
 : """//trim(txtatm(i))//""")"
     290             inquire(unit=ilog, opened=opend)
     291             if (log) write (ilog, "(a)")trim(line)
     292             ibad = ibad + 1
     293           end if
     294           cycle
     295         else if (nbonds(i) == 1) then
     296 !
     297 !  The normal case
     298 !
     299           r = distance(i, ibonds(1,i))
     300         else
     301 !
     302 !  Find the heavy atom, k, nearest to hydrogen atom i
     303 !
     304           rmin = 1.d12
     305           m = 0
     306           k = 0
     307           do j = 1, nbonds(i)
