       1 subroutine psort (refers, mode, nmols, reftxt, allref, ifile, l, lp)
       2     use param_global_C, only : source, maxrfs, contrl
       3     implicit none
       4     logical, intent (in) :: lp
       5     integer, intent (in) :: ifile, mode, nmols
       6     integer, intent (out) :: l
       7     character (len=5), dimension (nmols), intent (out) :: reftxt
       8     character (len=8), dimension (nmols), intent (in) :: refers
       9     character (len=13), dimension (maxrfs), intent (inout) :: allref
      10     integer, parameter :: nrefs = 2
      11     character :: line*120, iw*300, location_of_references(nrefs)*22
      12     integer :: i, ii, j, m
      13     logical :: first = .true., exists
      14     intrinsic :: Index
      15     data location_of_references / &
      16     "./REFERENCES.txt     ", &
      17     "M:/utility/REFERENCES" /
      18 !----------------------------------------------------------------------
      19     if (mode /= 1) then
      20       l = 0
      21       do i = 1, nmols
      22         if (refers(i) == " ") then
      23           reftxt (i) = "  "
      24         else
      25           do j = 1, l
      26             if (allref(j) (6:13) == refers(i)) go to 1000
      27           end do
      28           l = l + 1
      29           j = l
      30           allref(j) (6:13) = refers(i)
      31 1000      reftxt(i) = " "
      32           write(reftxt(i),'(i5)')j
      33           allref(j) (1:5) = reftxt(i)
      34         end if
      35       end do
      36       if ( .not. lp) return
      37     end if
      38     i = index(contrl, 'REFERENCES="') + 12
      39     if (i /= 12) then
      40       j = index(contrl(i:), '"') + i - 2
      41       iw = trim(contrl(i:j))
      42       call add_path(iw)
      43       inquire (file=trim(iw), exist = exists)
      44     else
      45       do i = 1, nrefs
      46         inquire (file=trim(location_of_references(i)), exist = exists)
      47         if (exists) then
      48           iw = trim(location_of_references(i))
      49           exit
      50         end if
      51       end do
      52     end if
      53     if (exists) then
      54       open (14, status="UNKNOWN", file=trim(iw), blank="ZERO")
      55       rewind (14)
      56     end if
      57     m = l
      58     do i = 1, l
 
 FORCHECK PC V13.5.13          PSORT           2021-03-24 10:59:30   page:  1666
 psort.F90  /FF
 
      59       source (3, i) = "      *+*+*+*+*+*+*+*+*+*+*+*+*+*+*+*+*+*+*+*+*+
 *+*+* +&
      60      &* "
      61       source (2, i) = "      *+*+*+*+*+*+*+*+*+*+*+*+*+*+*+*+*+*+*+*+*+
 *+*+* +&
      62      &* "
      63       source (1, i) = " " // allref (i) (5:12) // " NO REFERENCE *+*+*+
 *+" // &
      64      & "*+*+*+*+*+*+*+*+*+*"
      65     end do
      66     do ii = 1, 10000
      67       read (14, "(A)", end=1200, err=1200) line
      68 !
      69 ! Having read in one reference, is that reference used by this run?
      70 ! Check mnemonics only
      71 !
      72       do j = 1, l
      73         i = Index(line, " "//allref(j) (6:13))
      74         if (i /= 0) go to 1100
      75       end do
      76 !
      77 ! Have references become messed up?  References mnemonics should have l
 ess than 10 characters
      78 !
      79       if (line(11:) /= " ") then
      80         if(first) then
      81           first = .false.
      82           write(ifile,*)" Some mnemonics apear to be out-of sequence.
 These include:"
      83         end if
      84         write(ifile,"(a)")line
      85       end if
      86 !
      87 ! Reference is NOT used, therefore skip over next three lines
      88 !
      89       read (14, "(A)", end=1200, err=1200) line, line, line
      90       cycle
      91 1100  read (14, "(A)", end=1200, err=1200) source (1, j), source (2, j)
 , &
      92      & source(3, j)
      93       m = m - 1
      94     end do
      95 1200 close (14)
      96     do i = 1, l
      97       write (ifile,*)
      98       iw = source(1, i)
      99       if (source(2, i) /= " ") then
     100         iw(len_trim(iw) + 2:) = source(2, i)
     101         if (source(3, i) /= " ") then
     102           iw(len_trim(iw) + 2:) = source(3, i)
     103         end if
     104       end if
     105       if (index(iw, " NO REFERENCE") == 0) then
     106         write (ifile, "(A)")  allref (i) (1:5) // ":" // trim(iw)
     107       else
     108         write (ifile, "(A)")  allref (i) (1:5) // ": " // trim(iw(3:))
     109       end if
     110     end do
     111 end subroutine psort
 
