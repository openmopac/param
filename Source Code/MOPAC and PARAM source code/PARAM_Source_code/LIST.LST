     617 subroutine coscl1 (a, id, n, info)
     618    ! THIS ROUTINE PERFORMS A CHOLESKY FACTORIZATION
     619    ! INPUT:   A = PACKED LOWER TRIANGLE OF A
     620    !               SYMMETRIC POSITIVE DEFINITE N*N MATRIX
     621    ! OUTPUT:  A = LOWER TRIANGLE OF CHOLESKY MATRIX (INVERSE PIVOT ELEM
 EN
     622    !         ID = INTEGER VECTOR OF LENGTH N CONTAINING THE INDICES I(I
  - 1)
     623    !
     624     implicit none
     625     integer, intent (in) :: n
     626     double precision, dimension (*), intent (inout) :: a
     627     integer, dimension (n), intent (inout) :: id
     628     integer, intent (out) :: info
     629     integer :: i, indi, indk, j, k, kk
     630     double precision :: summe
     631     indi = 0
     632     do i = 1, n
     633       id(i) = indi
     634       indi = indi + i
     635     end do
     636     info = 0
     637     do k = 1, n
     638       indk = id(k)
     639       kk = k + indk
     640       do i = k, n
     641         indi = id(i)
     642         summe = 0.d0
     643         do j = 1, k - 1
     644           summe = summe + a(j + indi) * a(j + indk)
     645         end do
     646         summe = a(k + indi) - summe
     647         if (i == k) then
     648           if (summe < 0.0d0) then
     649             info = -1
     650             summe = a(kk)
     651           end if
     652           a(kk) = 1.d0 / Sqrt (summe)
     653         else
     654           a(k + indi) = summe * a(kk)
     655         end if
     656       end do
     657     end do
     658 end subroutine coscl1
 
