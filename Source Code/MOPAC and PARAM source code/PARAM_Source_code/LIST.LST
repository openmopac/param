     155                 r = (x1-coord(1, j)) ** 2 + (x2-coord(2, j)) ** 2 &
     156                      & + (x3-coord(3, j)) ** 2
     157               else
     158                 r = 1.d10
     159                 do ip = -l1u, l1u
     160                   do jp = -l2u, l2u
     161                     do kp = -l3u, l3u
     162                       do lp = 1, 3
     163                         xj(lp) = coord(lp, j) + tvec(lp, 1) * ip &
     164                              & + tvec(lp, 2) * jp + tvec(lp, 3) * kp
     165                       end do
 
 FORCHECK PC V13.5.13          FILLIJ          2021-03-24 10:59:30   page:  3596
 fillij.F90  /FF
 
     166                       rr = (x1-xj(1)) ** 2 + (x2-xj(2)) ** 2 + (x3-xj(3
 )) ** 2
     167                       r = Min (r, rr)
     168                     end do
     169                   end do
     170                 end do
     171               end if
     172
     173               if (r < cutof2) then
     174                 ix = ix + 1
     175                 if (.not. count) then
     176                   if (lijbo) then
     177                     if (first .or. nijbo(i,j) < 0) then
     178                       nijbo(i, j) = mpack
     179                       nijbo(j, i) = mpack
     180                     else
     181                       mpack = mpack - io * jo  !  prevent mpack from be
 ing incremented - the element of
     182                                                  !  nijbo was already s
 et.
     183                     end if
     184                   else
     185                     iijj(ix) = mpack
     186                     ijall(ix) = j
     187                   end if
     188                 end if
     189                 mpack = mpack + io * jo
     190                 !
     191                 if ( .not. direct) then
     192                   n2elec = n2elec + (jo*(jo+1)) / 2 * ii
     193                 end if
     194                 if (r < rmin) then
     195                   rmin = r
     196                 end if
     197               else if (r < cutof1) then
     198                 !
     199                 !   USE CHARGES AND DIPOLES
     200                 !
     201                 if ( .not. semidr) then
     202                   !
     203                   if (io > 1) then
     204                     if (jo > 1) then
     205                       n2elec = n2elec + 7
     206                     else
     207                       n2elec = n2elec + 4
     208                     end if
     209                   else if (jo > 1) then
     210                     n2elec = n2elec + 4
     211                   else
     212                     n2elec = n2elec + 1
     213                   end if
     214                 end if !#aab - end
     215                 !
     216                 if (lijbo .and. (.not. count)) then
     217                   if (first .or. nijbo(i,j) == -1) then
     218                     nijbo(i, j) = -2
     219                     nijbo(j, i) = -2
     220                   end if
     221                 end if
 
 FORCHECK PC V13.5.13          FILLIJ          2021-03-24 10:59:30   page:  3597
 fillij.F90  /FF
 
     222                 !#aab
     223               else
     224                 !
     225                 !  USE POINT CHARGE APPROXIMATION
     226                 !
     227                 if ( .not. semidr) then
     228                   n2elec = n2elec + 1
     229                 end if
     230                 !
     231                 if (lijbo .and. (.not. count)) then
     232                   if (first) then
     233                     nijbo(i, j) = -1
     234                     nijbo(j, i) = -1
     235                   end if
     236                 end if
     237                 !#aab
     238             end if
     239           end do
