    2749   subroutine fock_dir_int (ind1, n1, ind2, n2, c, nc, q, r, same)
    2750     !
    2751     ! Adds correction to the Fock matrix due to near charges on surface
    2752     !
    2753
    2754     use common_arrays_C, only: nfirst, nlast, nat
    2755     use cosmo_C, only : qscnet, cosurf
    2756
    2757     !
    2758     !.. Implicit Declarations ..
    2759     implicit none
    2760     !
    2761     !.. Formal Arguments ..
    2762     integer, intent(in) :: n1, n2, nc
    2763     integer, intent(in), dimension(*) :: ind1, ind2
    2764     double precision, intent(in), dimension(nc, *) :: c
    2765     double precision, intent(in), dimension(*) :: q
    2766     double precision, intent(inout), dimension(*) :: r
    2767     logical, intent(in) :: same
    2768     !
