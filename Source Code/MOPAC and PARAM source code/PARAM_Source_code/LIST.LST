       1     subroutine calpar
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE parameters_C, only : ios, iop, iod, qq, am, ad, aq, dd, &
       6       gpp, gp2, hsp, gss, gsp, &
       7       zs, zp, uss, upp, udd, eisol, &
       8       f0sd, g2sd, f0sd_store, g2sd_store, &
       9          dsd, dpd, ddd, zd
      10       USE funcon_C, only : ev
      11       USE molkst_C, only : keywrd, method_indo
      12       USE reimers_C, only: zetad, zetawt, nbfa
      13       USE chanel_C, only : iw
      14       implicit none
      15 !-----------------------------------------------
      16 !   L o c a l   V a r i a b l e s
      17 !-----------------------------------------------
      18
      19       integer , dimension(107) :: nspqn
      20       integer :: i, k, l, jmax, j
      21       character :: num*1, file_name*120
      22       double precision, dimension(107) :: gssc, gspc, hspc, gp2c, gppc
      23       double precision :: p, p4,  hpp, qn, gdd1, d1, d2, df, hsp1, hsp2
 , d3, &
      24         gqq, q1, q2, qf, hpp1, hpp2, q3
      25       double precision :: zda, zdb, zwa, zwb, dsda, dsdb, dpda, dpdb, d
 dda, dddb
      26       double precision, external :: reada
      27       save nspqn
      28 !-----------------------------------------------
      29       data nspqn/ 2*1, 8*2, 8*3, 18*4, 18*5, 32*6, 21*0/
      30 !
      31       if (method_indo) then
      32         do i = 1, 107
      33           if (isnan(zs(i))) zs(i) = 0.d0
      34           if (isnan(zp(i))) zp(i) = 0.d0
      35           if (isnan(zd(i))) zd(i) = 1.d-6
      36           if(zd(i) == 0.d0) zd(i) = 1.d-6
      37         end do
      38       end if
      39 !
      40 !
      41 !     SET SCALING PARAMETER.
      42       p = 2.D0
      43       p4 = p**4
      44       call sp_two_electron
      45       am = 0.d0
      46       ad = 0.d0
      47       aq = 0.d0
      48       dd = 0.d0
      49       qq = 0.d0
      50       do i = 2, 97
      51 !
      52 !  GSSC is the number of two-electron terms of type <SS|SS>
      53 !
      54         gssc(i) = max(ios(i)-1,0)
      55         k = iop(i)
      56 !
 
 FORCHECK PC V13.5.13          CALPAR          2021-03-24 10:59:30   page:  3425
 calpar.F90  /FF
 
      57 !  GSPC is the number of two-electron terms of type <SS|PP>
      58 !
      59         gspc(i) = ios(i)*k
      60         l = min(k,6 - k)
      61 !
      62 !  GP2C is the number of two-electron terms of type <PP|PP>
      63 !       plus 0.5 of the number of HPP integrals.
      64 !  (HPP is not used; instead it is replaced by 0.5(GPP-GP2))
      65 !
      66         gp2c(i) = (k*(k - 1))/2 + 0.5D0*(l*(l - 1))/2
      67 !
      68 !  GPPC is minus 0.5 times the number of HPP integrals.
      69 !
      70         gppc(i) = -0.5D0*(l*(l - 1))/2
      71 !
      72 !  HSPC is the number of two-electron terms of type <SP|SP>.
      73 !       (S and P must have the same spin.  In all cases, if
      74 !  P is non-zero, there are two S electrons)
      75 !
      76         hspc(i) = -k*ios(i)*0.5d0
      77 !
      78 !
      79         if (zp(i)<1.D-4 .and. zs(i)<1.D-4) cycle
      80 !*********************************************************************
      81 !
      82 !   CONSTRAINTS ON THE POSSIBLE VALUES OF PARAMETERS
      83 !
      84 !*********************************************************************
      85         zp(i) = dmax1(0.3D0,zp(i))
      86 !  PUT IN ANY CONSTRAINTS AT THIS POINT
      87 !*********************************************************************
      88         hpp = 0.5D0*(gpp(i)-gp2(i))
      89         hpp = max(0.1D0,hpp)
      90         hsp(i) = max(1.D-7,hsp(i))
      91         eisol(i) = uss(i)*ios(i) + upp(i)*iop(i) + udd(i)*iod(i) + gss(
 i)*gssc(i) + &
      92           gpp(i)*gppc(i) + gsp(i)*gspc(i) + gp2(i)*gp2c(i) + hsp(i)*hsp
 c(i)
      93         qn = nspqn(i)
      94         dd(i) = (2.D0*qn + 1)*(4.D0*zs(i)*zp(i))**(qn + 0.5D0)/(zs(i)+z
 p(i))**(2.D0*qn + 2)/sqrt(3.D0)
      95         qq(i) = sqrt((4.D0*qn*qn + 6.D0*qn + 2.D0)/20.D0)/zp(i)
      96         if (method_indo .and. i<=80) then
      97           if (nbfa(i) > 4) then
      98 !           INDO d orbitals - since two Slater basis functions, calcula
 te two
      99 !           terms and weights based on the coefficients
     100             zda = zetad(1,i)
     101             zdb = max(zetad(2,i), 1.d-8)
     102             zwa = zetawt(1,i)
     103             zwb = zetawt(2,i)
     104
     105             dsda = (2.D0*zs(i))**(qn + 0.5D0) * (2.D0*zda)**(qn - 0.5D0
 ) / (zs(i) + zda)**(2.D0*qn + 2)
     106             dsda = dsda * (2.D0*qn + 1) * sqrt(2.D0*qn*(2.D0*qn - 1))
     107
     108             dsdb = (2.D0*zs(i))**(qn + 0.5D0) * (2.D0*zdb)**(qn - 0.5D0
 ) / (zs(i) + zdb)**(2.D0*qn + 2)
     109             dsdb = dsdb * (2.D0*qn + 1) * sqrt(2.D0*qn*(2.D0*qn - 1))
 
 FORCHECK PC V13.5.13          CALPAR          2021-03-24 10:59:30   page:  3426
 calpar.F90  /FF
 
     110
     111             dsd(i) = sqrt((dsda*zwa + dsdb*zwb) / sqrt(15.D0))
     112
     113
     114             dpda = (2.D0*zp(i))**(qn + 0.5D0) * (2.D0*zda)**(qn - 0.5D0
 ) / (zp(i) + zda)**(2.D0*qn + 1)
     115             dpda = dpda * sqrt(2.D0*qn*(2.D0*qn-1))
     116
     117             dpdb = (2.D0*zp(i))**(qn + 0.5D0) * (2.D0*zdb)**(qn - 0.5D0
 ) / (zp(i) + zdb)**(2.D0*qn + 1)
     118             dpdb = dpdb * sqrt(2.D0*qn*(2.D0*qn-1))
     119
     120             dpd(i)= (dpda*zwa + dpdb*zwb) / sqrt(5.D0)
     121
     122
     123             ddda = (4.D0*qn*qn - 2.D0*qn) / (2*zda)**2
     124             dddb = (4.D0*qn*qn - 2.D0*qn) / (2*zdb)**2
     125
     126             ddd(i)= sqrt((ddda*zwa + dddb*zwb) / 7.D0)
     127           else
     128 ! Single-Slater d orbitals
     129             dsd(i) = sqrt( (2.D0*zs(i))**(qn + 0.5D0) * (2.D0*zd(i))**(
 qn - 0.5D0) &
     130                      / (zs(i) + zd(i))**(2.D0*qn + 2) &
     131                      * (2.D0*qn + 1) * sqrt(2.D0*qn*(2.D0*qn - 1)) / sq
 rt(15.0))
     132             dpd(i) = (2.D0*zp(i))**(qn + 0.5D0) * (2.D0*zd(i))**(qn - 0
 .5D0) &
     133                      / (zp(i) + zd(i))**(2.D0*qn + 1) * sqrt(2.D0*qn*(2
 .D0*qn-1)) / sqrt(5.D0)
     134             ddd(i) = sqrt( (4.D0*qn*qn - 2.D0*qn) / (2*zd(i))**2 / 7.D0
 )
     135           end if
     136         end if
     137 !     CALCULATE ADDITIVE TERMS, IN ATOMIC UNITS.
     138         jmax = 5
     139         gdd1 = (hsp(i)/(ev*dd(i)**2))**(1.D0/3.D0)
     140         d1 = gdd1
     141         d2 = gdd1 + 0.04D0
     142         do j = 1, jmax
     143           df = d2 - d1
     144           hsp1 = 0.5D0*d1 - 0.5D0/sqrt(4.D0*dd(i)**2+1.D0/d1**2)
     145           hsp2 = 0.5D0*d2 - 0.5D0/sqrt(4.D0*dd(i)**2+1.D0/d2**2)
     146           if (abs(hsp2 - hsp1) < 1.D-25) exit
     147           d3 = d1 + df*(hsp(i)/ev-hsp1)/(hsp2 - hsp1)
     148           d1 = d2
     149           d2 = d3
     150         end do
     151         gqq = (p4*hpp/(ev*48.D0*qq(i)**4))**0.2D0
     152         q1 = gqq
     153         q2 = gqq + 0.04D0
     154         do j = 1, jmax
     155           qf = q2 - q1
     156           hpp1 = 0.25D0*q1 - 0.5D0/sqrt(4.D0*qq(i)**2+1.D0/q1**2) + 0.2
 5D0/&
     157             sqrt(8.D0*qq(i)**2+1.D0/q1**2)
     158           hpp2 = 0.25D0*q2 - 0.5D0/sqrt(4.D0*qq(i)**2+1.D0/q2**2) + 0.2
 5D0/&
     159             sqrt(8.D0*qq(i)**2+1.D0/q2**2)
 
 FORCHECK PC V13.5.13          CALPAR          2021-03-24 10:59:30   page:  3427
 calpar.F90  /FF
 
     160           if (abs(hpp2 - hpp1) < 1.D-25) exit
     161           q3 = q1 + qf*(hpp/ev - hpp1)/(hpp2 - hpp1)
     162           q1 = q2
     163           q2 = q3
     164         end do
     165         am(i) = gss(i)/ev
     166         ad(i) = d2
     167         aq(i) = q2
     168       end do
     169       do i = 1, 107
     170         if (am(i) < 1.d-20) then
     171           if (gss(i) > 1.d-20) then
     172             am(i) = gss(i)/ev
     173           else
     174             am(i) = 1.d0
     175           end if
     176         end if
     177       end do
     178       eisol(1) = uss(1)
     179       am(1) = gss(1)/ev
     180       ad(1) = am(1)
     181       aq(1) = am(1)
     182       do i = 1, 100
     183         if (f0sd_store(i) < 1.d-20) f0sd(i) = 0.d0 ! Force f0sd and g2s
 d to zero if not already defined
     184         if (g2sd_store(i) < 1.d-20) g2sd(i) = 0.d0
     185       end do
     186
     187       call inid        ! Calculate derived parameters for "d" orbital w
 ork
     188 !
     189 !   Atomic number 102 is the capped bond.  It should have a very
     190 !   small AM to prevent division by zero in REPPD, and to avoid
     191 !   spurious effects due to normal AM values.
     192 !
     193       am(102) = 1.D-10
     194 !
     195 !     DEBUG PRINTING.
     196 !     THIS IS FORMATTED FOR DIRECT INSERTION INTO 'PARAM'
     197 !
     198       if (index(keywrd,' DEP ') == 0) return
     199       num = "8"
     200     !  if (method_pm7) num = "7"
     201       file_name = "parameters_for_PM"//num//"_C.F90"
     202       i = index(keywrd, "ifiles_8")
     203       if (i > 0) then
     204         i = nint(reada(keywrd, i))
     205       else
     206         i = iw
     207       end if
     208       write (i, '(//10x, a, /)')" A new file called '"//trim(file_name)
 //"' will be written"
     209       call add_path(file_name)
     210       call create_parameters_for_PMx_C(file_name, num)
     211       return
     212     end subroutine calpar
 
 FORCHECK PC V13.5.13          CALPAR          2021-03-24 10:59:30   page:  3428
 calpar.F90  /FF


