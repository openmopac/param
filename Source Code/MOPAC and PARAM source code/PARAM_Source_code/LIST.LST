       1 subroutine cnvgz (pnew, p, p1, p2, p3, niter, idiag)
       2     use molkst_C, only: norbs, mpack
       3     use MOZYME_C, only : use_three_point_extrap, pmax
       4     implicit none
       5     integer, intent (in) :: niter
       6     integer, dimension (norbs), intent (in) :: idiag ! Pointers to diag
 onal elements
       7     double precision, dimension (norbs), intent (inout) :: p1, p2, p3
       8     double precision, dimension (mpack), intent (inout) :: p, pnew
       9     integer :: i, j
      10     double precision :: damp, fac, faca, facb, sa
      11     intrinsic Abs, Max, Min, Mod, Sign, Sqrt
      12    !
      13    ! Save the diagonal of the current and previous density for later us
 e
      14    !
      15     do i = 1, norbs
      16       j = idiag(i)
      17       p3(i) = pnew(j)
      18       p2(i) = p(j)
      19     end do
      20 !
      21 !   Calculate the maximum and RMS change in the density matrix
      22 !
      23     pmax = 0.0d0
      24     do i = 1, mpack
      25       sa = Abs (pnew(i) - p(i))
      26       pmax = Max (pmax, sa)
      27     end do
      28     if (use_three_point_extrap) then
      29 !
      30 !   Three-point extrapolation in use. Extrapolation is used on
      31 !   every third SCF cycle
      32 !
      33       if (Mod (niter, 3) == 0) then
      34         faca = 0.0d0
      35         facb = 0.0d0
      36         do i = 1, norbs
      37           sa = Abs (p3(i) - p2(i))
      38           faca = faca + sa ** 2
      39           facb = facb + (p3(i)-2.0d0*p2(i)+p1(i)) ** 2
      40         end do
      41 !
      42         if (facb > 0.d0 .and. faca < (100.d0*facb)) then
      43           fac = Sqrt (faca/facb)
      44           pnew = pnew + fac * (pnew-p)
      45         end if
      46 !
      47       end if
      48 !
      49 !   From iteration 4 on, the change in the diagonal elements is
      50 !   limited to 'damp'
      51 !
      52       if (niter > 3) then
      53         damp = 0.05d0
      54         if (pmax > damp) then
      55           do i = 1, norbs
      56             j = idiag(i)
 
 FORCHECK PC V13.5.13          CNVGZ           2021-03-24 10:59:30   page:  3959
 cnvgz.F90  /FF
 
      57             if (Abs (p3(i)-p2(i)) > damp) then
      58               pnew(j) = p2(i) + Sign (damp, p3(i)-p2(i))
      59               pnew(j) = Min (2.0d0, Max (pnew(j), 0.0d0))
      60             end if
      61           end do
      62         end if
      63       end if
      64     end if ! three-point extrapolation
      65 !
      66 !  Save the density for use in the next iteration
      67 !
      68     p1 = p2
      69     p = pnew
      70 end subroutine cnvgz
 
