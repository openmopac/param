     178         !
     179         !    VECT1 HOLDS THE MOLECULAR ORBITALS IN THE COORDINATE SYSTE
 M OF
     180         !          SYMTRZ.
     181         !    VECT2 HOLDS THE SAME ORBITALS, AFTER BEING OPERATED ON BY
 THE
     182         !          DIPOLE OPERATORS 'X', 'Y', AND 'Z'.
     183         !
     184         !     T2 HOLD THE UNITARY TRANSFORM FOR THE SET OF M.O.S
     185         !        <VECT1|IOPER|VECT2>
     186         !
     187         do i = 1, nmos
     188           t2(i, i) = 0.d0
     189           do j = 1, i - 1
     190             if (i /= j) then
     191               sum = 0.d0
     192               do k = 1, norbs
     193                 sum = sum + vect1(k, i) * vect2(k, j)
     194               end do
