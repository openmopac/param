       1 subroutine diagg (fao, nocc, nvir, idiagg, partp, indi)
       2 !**********************************************************************
       3 !
       4 !  This is the most important operation of MOZYME - the matrix elements
       5 !  involving occupied and virtual LMO's are annihilated by a single pas
 s
       6 !  Euler rotation.
       7 !
       8 !**********************************************************************
       9     use MOZYME_C, only: icocc_dim, fmo, ifmo, fmo_dim
      10     use common_arrays_C, only: eigs, p
      11     use molkst_C, only : mpack, norbs, numat
      12 !
      13     implicit none
      14     integer, intent (in) :: idiagg, nocc, nvir, indi
      15     double precision, dimension (mpack), intent (inout) :: partp
      16     double precision, dimension (mpack), intent (in) :: fao
      17 !
      18     integer :: nij, alloc_stat
      19     logical, dimension (:), allocatable :: latoms
      20     integer, dimension (:), allocatable :: iused
      21     double precision, dimension(:), allocatable :: storei, storej, ws,
 aov, aocc, avir
      22     allocate (storei(norbs), storej(norbs), ws(norbs), aov(numat), &
      23          & avir(norbs), aocc(Max(1, icocc_dim)), iused(numat), latoms(n
 umat), &
      24          & stat=alloc_stat)
      25     if (alloc_stat /= 0) then
      26       call mopend("Insufficient memory to run DIAGG")
      27       return
      28     end if
      29     nij = fmo_dim
      30 !**********************************************************************
      31 !
      32 !  In diagg1, all significant matrix elements are constructed.  These
      33 !  nij elements are stored in fmo, and their indices are stored in ifmo
 .
      34 !
      35 !**********************************************************************
      36
      37 !
      38     call diagg1 (fao, nocc, nvir,  eigs(nocc+1:), ws, latoms,  ifmo, fm
 o, &
      39      & fmo_dim, nij, idiagg, avir, aocc, aov)
      40 !
      41 !**********************************************************************
      42 !
      43 !  In diagg2, the significant matrix elements are annihilated by a two
 by
      44 !  two rotation.
      45 !
      46 !**********************************************************************
      47
      48     call diagg2 (nocc, nvir, eigs(nocc+1:), iused, latoms, nij, idiagg,
  storei, storej)
      49 !
      50     call density_for_MOZYME (p, indi, nocc, partp)
      51 !
 
 FORCHECK PC V13.5.13          DIAGG           2021-03-24 10:59:30   page:   895
 diagg.F90  /FF
 
      52     deallocate (storei, storej, ws, aov, avir, aocc, iused, latoms)
      53     return
      54 end subroutine diagg
 
