 bond_correction
      55       logical :: debug, force, large, refeps, point
      56       integer, external :: ijbo
      57       save debug, force, large, chnge, chnge2, icalcn, ione, const
      58 !**********************************************************************
 *
      59 !
      60 !    DCART CALCULATES THE DERIVATIVES OF THE ENERGY WITH RESPECT TO THE
      61 !          CARTESIAN COORDINATES. THIS IS DONE BY FINITE DIFFERENCES.
      62 !
      63 !    THE MAIN ARRAYS IN DCART ARE:
      64 !        DXYZ   ON EXIT CONTAINS THE CARTESIAN DERIVATIVES.
      65 !
      66 !**********************************************************************
 *
      67       data icalcn/ 0/
      68       data chnge/ 1.D-4/
      69       chnge2 = chnge*0.5D0
