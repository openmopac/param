       1       subroutine dijkl1(c, n, nati, w, cij, wcij, ckl, xy)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use molkst_C, only : numat, norbs
       6       use common_arrays_C, only : nfirst, nlast
       7       use meci_C, only : nmos
       8 !**********************************************************************
 *
       9 !-----------------------------------------------
      10 !   I n t e r f a c e   B l o c k s
      11 !-----------------------------------------------
      12       implicit none
      13 !-----------------------------------------------
      14 !   D u m m y   A r g u m e n t s
      15 !-----------------------------------------------
      16       integer , intent(in) :: n
      17       integer , intent(in) :: nati
      18       double precision , intent(in) :: c(n,*)
      19       double precision  :: w(*)
      20       double precision  :: cij(10*norbs)
      21       double precision  :: wcij(10*norbs)
      22       double precision , intent(inout) :: ckl(10*norbs)
      23       double precision , intent(out) :: xy(nmos,nmos,nmos,nmos)
      24 !-----------------------------------------------
      25 !   L o c a l   P a r a m e t e r s
      26 !-----------------------------------------------
      27 !-----------------------------------------------
      28 !   L o c a l   V a r i a b l e s
      29 !-----------------------------------------------
      30       integer , dimension(0:8) :: nb
      31       integer :: na, i, j, ipq, ii, ip, i77, kr, js, nbj, nbi, k, ll, l
      32       double precision :: sum
      33
      34       save nb
      35 !-----------------------------------------------
      36 !**********************************************************************
 *
      37 !
      38 !   DIJKL1 IS SIMILAR TO IJKL.  THE MAIN DIFFERENCES ARE THAT
      39 !   THE ARRAY W CONTAINS THE TWO ELECTRON INTEGRALS BETWEEN
      40 !   ONE ATOM (NATI) AND ALL THE OTHER ATOMS IN THE SYSTEM.
      41 !
      42 !           ON EXIT
      43 !
      44 !   THE ARRAY XY IS FILLED WITH THE DIFFERENTIALS OF THE
      45 !   TWO-ELECTRON INTEGRALS OVER ACTIVE-SPACE M.O.S W.R.T. MOTION
      46 !   OF THE ATOM NATI.
      47 !**********************************************************************
 *
      48       data nb/ 1, 0, 0, 10, 0, 0, 0, 0, 45/
      49       na = nmos
      50       do i = 1, na
      51         do j = 1, i
      52           ipq = 0
      53           do ii = 1, numat
      54             if (ii == nati) cycle
      55             do ip = nfirst(ii), nlast(ii)
 
 FORCHECK PC V13.5.13          DIJKL1          2021-03-24 10:59:30   page:  2790
 dijkl1.F90  /FF
 
      56               if (ip - nfirst(ii) + 1 > 0) then
      57                 cij(ipq+1:ip-nfirst(ii)+1+ipq) = c(ip,i)*c(nfirst(ii):i
 p,j) + c&
      58                   (ip,j)*c(nfirst(ii):ip,i)
      59                 ipq = ip - nfirst(ii) + 1 + ipq
      60               end if
      61             end do
      62           end do
      63           i77 = ipq + 1
      64           do ip = nfirst(nati), nlast(nati)
      65             if (ip - nfirst(nati) + 1 > 0) then
      66               cij(ipq+1:ip-nfirst(nati)+1+ipq) = c(ip,i)*c(nfirst(nati)
 :ip,j)&
      67                  + c(ip,j)*c(nfirst(nati):ip,i)
      68               ipq = ip - nfirst(nati) + 1 + ipq
      69             end if
      70           end do
      71           wcij(:ipq) = 0.D0
      72           kr = 1
      73           js = 1
      74           nbj = nlast(nati) - nfirst(nati)
      75           if (nbj >= 0) then
      76             do ii = 1, numat
      77               if (ii == nati) cycle
      78               nbi = nlast(ii) - nfirst(ii)
      79               if (nbi < 0) cycle
      80               call formxy (w(kr), kr, wcij(i77), wcij(js), cij(i77),nb(
 nbj), cij(&
      81                 js), nb(nbi))
      82               js = js + nb(nbi)
      83             end do
      84           end if
      85           do k = 1, i
      86             if (k == i) then
      87               ll = j
      88             else
      89               ll = k
      90             end if
      91             do l = 1, ll
      92               ipq = 0
      93               do ii = 1, numat
      94                 if (ii == nati) cycle
      95                 do ip = nfirst(ii), nlast(ii)
      96                   if (ip - nfirst(ii) + 1 > 0) then
      97                     ckl(ipq+1:ip-nfirst(ii)+1+ipq) = c(ip,k)*c(nfirst(i
 i):ip,l)&
      98                        + c(ip,l)*c(nfirst(ii):ip,k)
      99                     ipq = ip - nfirst(ii) + 1 + ipq
     100                   end if
     101                 end do
     102               end do
     103               do ip = nfirst(nati), nlast(nati)
     104                 if (ip - nfirst(nati) + 1 > 0) then
     105                   ckl(ipq+1:ip-nfirst(nati)+1+ipq) = c(ip,k)*c(nfirst(n
 ati):ip,&
     106                     l) + c(ip,l)*c(nfirst(nati):ip,k)
     107                   ipq = ip - nfirst(nati) + 1 + ipq
     108                 end if
     109               end do
 
 FORCHECK PC V13.5.13          DIJKL1          2021-03-24 10:59:30   page:  2791
 dijkl1.F90  /FF
 
     110               sum = 0.D0
     111               do ii = 1, ipq
     112                 sum = sum + ckl(ii)*wcij(ii)
     113               end do
     114               xy(i,j,k,l) = sum
     115               xy(i,j,l,k) = sum
     116               xy(j,i,k,l) = sum
     117               xy(j,i,l,k) = sum
     118               xy(k,l,i,j) = sum
     119               xy(k,l,j,i) = sum
     120               xy(l,k,i,j) = sum
     121               xy(l,k,j,i) = sum
     122             end do
     123           end do
     124         end do
     125       end do
     126       return
     127       end subroutine dijkl1
 
