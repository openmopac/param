     445       subroutine chi(toler, coord, ioper, iqual)
     446 !-----------------------------------------------
     447 !   M o d u l e s
     448 !-----------------------------------------------
     449       use symmetry_C, only : ielem, elem, jelem
     450       use molkst_C, only : numat
     451       use common_arrays_C, only : nat
     452 !**********************************************************************
 *
     453       implicit none
     454 !-----------------------------------------------
     455 !   G l o b a l   P a r a m e t e r s
     456 !-----------------------------------------------
     457 !-----------------------------------------------
     458 !   D u m m y   A r g u m e n t s
     459 !-----------------------------------------------
     460       integer , intent(in) :: ioper
     461       integer , intent(out) :: iqual
     462       double precision , intent(in) :: toler
     463       double precision , intent(in) :: coord(3,numat)
     464 !-----------------------------------------------
     465 !   L o c a l   P a r a m e t e r s
     466 !-----------------------------------------------
     467 !-----------------------------------------------
     468 !   L o c a l   V a r i a b l e s
     469 !-----------------------------------------------
     470       integer :: iresul, i, j
     471       double precision, dimension(3) :: help
     472 !-----------------------------------------------
     473 !**********************************************************************
 *
     474 !
     475 !   CHI RETURNS A '1' IN IELEM(IOPER) IF THE SYMMETRY OPERATION ELEM(IO
 P
     476 !       LEAVES THE SYSTEM UNCHANGED.  OTHERWISE CHI RETURNS '0' IN IELE
 M
     477 !
     478 !   ON INPUT: COORD        = CARTESIAN COORDINATES
     479 !             IOPER        = SYMMETRY OPERATION TO BE PERFORMED
     480 !             ELEM         = SYMMETRY OPERATORS AS 3*3 MATRICES
     481 !   ON OUTPUT IELEM(IOPER) = 1 OR 0.
     482 !
     483 !**********************************************************************
 *
     484       iresul = 1
     485       iqual = 0
     486       l20: do i = 1, numat
     487         help(1) = coord(1,i)*elem(1,1,ioper) + &
     488                   coord(2,i)*elem(1,2,ioper) + &
     489                   coord(3,i)*elem(1,3,ioper)
     490         help(2) = coord(1,i)*elem(2,1,ioper) + &
     491                   coord(2,i)*elem(2,2,ioper) + &
     492                   coord(3,i)*elem(2,3,ioper)
     493         help(3) = coord(1,i)*elem(3,1,ioper) + &
     494                   coord(2,i)*elem(3,2,ioper) + &
     495                   coord(3,i)*elem(3,3,ioper)
     496         do j = 1, numat
     497           if (nat(i) /= nat(j)) cycle
 
 FORCHECK PC V13.5.13           CHI            2021-03-24 10:59:30   page:  3563
 molsym.F90  /FF
 
     498           if (abs(coord(1,j)-help(1)) > toler) cycle
     499           if (abs(coord(2,j)-help(2)) > toler) cycle
     500           if (abs(coord(3,j)-help(3)) > toler) cycle
     501           jelem(ioper,i) = j
     502           if (i == j) iqual = iqual + 1
     503           cycle  l20
     504         end do
     505         iresul = 0
     506       end do l20
     507       ielem(ioper) = iresul
     508       return
     509       end subroutine chi
 
 FORCHECK PC V13.5.13           CHI            2021-03-24 10:59:30   page:  3564
 molsym.F90  /FF


