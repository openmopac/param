    2068       subroutine aijm(ni)
    2069 !-----------------------------------------------
    2070 !   M o d u l e s
    2071 !-----------------------------------------------
    2072       USE mndod_C, only : aij,  iii, iiid, fx
    2073       use parameters_C, only : zs, zp, zd, dorbs
    2074 !     *
    2075 !     AIJ-VALUES FOR EVALUATION OF TWO-CENTER TWO-ELECTRON INTEGRALS
    2076 !     AND OF HYBRID CONTRIBUTION TO DIPOLE MOMENT IN MNDO-D.
    2077 !     DEFINITION SEE EQUATION (7) OF TCA PAPER.
    2078 !     *
    2079 !     RESULTS ARE STORED IN ARRAY AIJ(6,5,107). CONVENTIONS:
    2080 !     FIRST  INDEX      1 SS, 2 SP, 3 PP, 4 SD, 5 PD, 6 DD.
    2081 !     SECOND INDEX      L+1 FROM DEFINITION OF MULTIPOLE.
    2082 !     THIRD  INDEX      ATOMIC NUMBER.
    2083 !     *
    2084       implicit none
    2085 !-----------------------------------------------
    2086 !   D u m m y   A r g u m e n t s
    2087 !-----------------------------------------------
    2088       integer , intent(in) :: ni
    2089 !-----------------------------------------------
    2090 !   L o c a l   V a r i a b l e s
    2091 !-----------------------------------------------
    2092       integer :: nsp, nd
    2093       double precision :: z1, z2, z3, zz
    2094 !-----------------------------------------------
    2095 !     *
    2096 !
    2097 !
    2098       z1 = zs(ni)
    2099       z2 = zp(ni)
    2100       z3 = zd(ni)
    2101       nsp = iii(ni)
    2102       if (ni < 3) return
    2103       zz = z1*z2
    2104       if (zz < 0.01d0) return
    2105       aij(2,ni) = aijl(z1,z2,nsp,nsp,1)
    2106       aij(3,ni) = aijl(z2,z2,nsp,nsp,2)
    2107       if (dorbs(ni)) then
    2108         nd = iiid(ni)
    2109         aij(4,ni) = aijl(z1,z3,nsp,nd,2)
    2110         aij(5,ni) = aijl(z2,z3,nsp,nd,1)
    2111         aij(6,ni) = aijl(z3,z3,nd,nd,2)
    2112       end if
    2113       return
    2114       contains
 
 FORCHECK PC V13.5.13  CVF compiler emulation  2021-03-24 10:59:30   page:  1499
 mndod.F90  /FF


    2117       double precision function aijl (z1, z2, n1, n2, l)
    2118       double precision, intent(in) :: z1
    2119       double precision, intent(in) :: z2
    2120       integer, intent(in) :: n1
    2121       integer, intent(in) :: n2
    2122       integer, intent(in) :: l
    2123       double precision :: zz
    2124       zz = z1 + z2 + 1.d-20
    2125       aijl = fx(n1+n2+l+1)/sqrt(fx(2*n1+1)*fx(2*n2+1))*(2*z1/zz)**n1*sq
 rt(2&
    2126         *z1/zz)*(2*z2/zz)**n2*sqrt(2*z2/zz)*2**l/zz**l
    2127       return
    2128       end function aijl
 
