     570       subroutine orient(numat, coord, r)
     571 !-----------------------------------------------
     572 !   M o d u l e s
     573 !-----------------------------------------------
     574       use symmetry_C, only : cub, ielem
     575 !**********************************************************************
 *
     576 !-----------------------------------------------
     577 !   I n t e r f a c e   B l o c k s
     578 !-----------------------------------------------
     579       implicit none
     580 !-----------------------------------------------
     581 !   G l o b a l   P a r a m e t e r s
     582 !-----------------------------------------------
     583 !-----------------------------------------------
     584 !   D u m m y   A r g u m e n t s
     585 !-----------------------------------------------
     586       integer  :: numat
     587       double precision  :: coord(3,numat)
     588       double precision  :: r(3,3)
     589 !-----------------------------------------------
     590 !   L o c a l   P a r a m e t e r s
     591 !-----------------------------------------------
     592 !-----------------------------------------------
     593 !   L o c a l   V a r i a b l e s
     594 !-----------------------------------------------
     595       integer :: i, jota, iqual, j
     596       double precision, dimension(2) :: wink
     597       double precision :: toler, wink2, sina, cosa, sinb, cosb
     598
     599       save wink, toler
