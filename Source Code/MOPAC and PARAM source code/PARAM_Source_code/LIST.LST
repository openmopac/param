     187   subroutine divide_box (coord, n1, n, min_d, min_p, max_tes, handle, i
 err)
     188     implicit none
     189     integer, intent (in) :: n1, n, handle
     190     double precision, intent (in), dimension(n1, n) :: coord
     191     double precision, intent (in) :: min_d   ! Minimum box size
     192     integer, intent (in) :: min_p   ! Minimum points in cell
     193     integer, intent (in) :: max_tes ! Max tesselation size
     194                                     ! (if < 3, then compute)
     195
     196     integer, intent(out) :: ierr  ! error, 0 if everything OK
     197     double precision :: xmax, xmin, ymax, ymin, zmax, zmin, &
     198          &  dx, dy, dz, x0, y0, z0, t, r
     199     integer :: max_boxs, max_lev
     200     integer :: i, i0, i1, j, j0, k, m, status
     201     logical :: division
     202     intrinsic Sqrt, Abs, Dble, Int, Log, Max, Min
     203     !
     204     !       Step -1. Find initial box
     205     !       ======
     206     !
     207     if (n1 < 3) then
     208       ierr = -10
     209       return
     210     end if
     211
     212     xmax = coord(1, 1)
     213     xmin = coord(1, 1)
     214     ymax = coord(2, 1)
     215     ymin = coord(2, 1)
     216     zmax = coord(3, 1)
     217     zmin = coord(3, 1)
     218
     219     do i = 2, n
     220       if (xmax < coord(1, i)) then
     221         xmax = coord(1, i)
     222       elseif (xmin > coord(1, i)) then
     223         xmin = coord(1, i)
     224       end if
     225
     226       if (ymax < coord(2, i)) then
     227         ymax = coord(2, i)
     228       elseif (ymin > coord(2, i)) then
     229         ymin = coord(2, i)
     230       end if
     231
     232       if (zmax < coord(3, i)) then
     233         zmax = coord(3, i)
     234       elseif (zmin > coord(3, i)) then
     235         zmin = coord(3, i)
     236       end if
     237     end do
     238
     239     dx = xmax - xmin
     240     dy = ymax - ymin
     241     dz = zmax - zmin
     242
     243     t = dx
 
 FORCHECK PC V13.5.13        DIVIDE_BOX        2021-03-24 10:59:30   page:  1111
 afmm_mod.F90  /FF
 
     244     if (t < dy) then
     245       t = dy
     246     end if
     247     if (t < dz) then
     248       t = dz
     249     end if
     250
     251     ! --- adjust the initial box
     252
     253     x0 = (xmax + xmin) /2
     254     y0 = (ymax + ymin) /2
     255     z0 = (zmax + zmin) /2
     256     t = t /2
     257
     258     xmin = x0 - t
     259     xmax = x0 + t
     260     ymin = y0 - t
     261     ymax = y0 + t
     262     zmin = z0 - t
     263     zmax = z0 + t
     264
     265     if (DEBUG) then
     266       write (iw, *) " Adjusted, t = ", t
     267       write (iw, *) "xmax, xmin", xmax, xmin
     268       write (iw, *) "ymax, ymin", ymax, ymin
     269       write (iw, *) "zmax, zmin", zmax, zmin
     270     end if
     271
     272     if (max_tes < 3) then
     273       max_lev = Int (Min (Log(t / min_d) / Log(2.d0) + 1.d0, &
     274            & Log(n / Dble (min_p)) / Log(8.d0) + 2.d0))
     275     else
     276       max_lev = max_tes
     277     end if
     278
     279     if (max_lev < 3) max_lev = 3
     280
     281     max_boxs = 0
     282     j = 1
     283     do i = 1, max_lev
     284       max_boxs = max_boxs + j*8
     285       j = j * 8
     286     end do
     287
     288     if (PRINT) then
     289       write (iw, *) " Estimated number of splits =", max_lev
     290       write (iw, *) " Estimated number of boxes =", max_boxs
     291     end if
     292
     293     allocate (b(max_boxs), d(max_lev), level(max_lev+1), &
     294          & ind(n+1), ind1(Max(n+1, 189*6)), stat = status)
     295
     296     if (status /= 0) then
     297       ierr = -2
     298       return
     299     end if
     300
     301     !
     302     !       Step 0. Split the initial box
 
 FORCHECK PC V13.5.13        DIVIDE_BOX        2021-03-24 10:59:30   page:  1112
 afmm_mod.F90  /FF
 
     303     !       ======
     304     !
     305     do i = 1, n
     306       ind(i) = i
     307     end do
     308
     309     call split_box (0, 1, x0, y0, z0, t*0.5, coord, n1, n, 0, 0, m)
     310
     311     d(1) = t
     312     level(1) = 1
     313     level(2) = m + 1
     314     nbox = m
     315
     316     do i = 1, max_lev - 1
     317       division = .false.
     318       t = t / 2
     319       do j = level(i), level(i+1) - 1
     320         if (b(j)%n_p > min_p) then
     321           call split_box (j, i+1, b(j)%x0, b(j)%y0, b(j)%z0, &
     322                &    t*0.5, coord, n1, b(j)%n_p, nbox, b(j)%p_start - 1,
  m)
     323           division = .true.
     324           b(j)%n_childs = m
     325           do k = 1, m
     326             b(j)%childs(k) = nbox + k
     327           end do
     328           nbox = nbox + m
     329         end if
     330       end do
     331
     332       if (division) then
     333         nlev = i+1
     334         d(i+1) = t
     335         level(i+2) = nbox + 1
     336
     337         do j = level(i+1), level(i+2) - 1
     338           b(j)%p_start = b(j)%p_start + b(b(j)%parent)%p_start - 1
     339         end do
     340       else
     341         nlev = i
     342         exit
     343       end if
     344     end do
     345
     346     if (PRINT) then
     347       write (iw, *) " Actual number of splits =", nlev
     348       write (iw, *) " Actual number of boxes =", nbox
     349       do i=1, nlev
     350         write (iw, *) " Level ", i, "Size = ", d(i)
     351       end do
     352     end if
     353
     354     !
     355     !       Create lists for each box
     356     !
     357     !       l1(b) - set consisting of all boxes adjustent to b.
     358     !       Let c be in l1(b). Then
     359     !               if c has children it will be in l1(b)
     360     !               if c is childless, then only c with numbers < b
 
 FORCHECK PC V13.5.13        DIVIDE_BOX        2021-03-24 10:59:30   page:  1113
 afmm_mod.F90  /FF
 
     361     !                       will be in the l1 list of b.
     362     !       This is done to avoid double counting on step 7.
     363     !       List l1 is computed for parent boxes, and contains all the
 boxes
     364     !       (Note 1. So the list 1 has boxes on the same split level,
     365     !               as box b, similar to list 2).
     366     !       (Note 2. in this version the definition of list 1 includes
     367     !               lists 1 and 3 of the original paper)
     368     !
     369
     370     do i = 1, nlev
     371       t = d(i) + small
     372       do j = level(i), level(i+1) - 1
     373         do k = level(i), level(i+1) - 1
     374
     375           if (j == k) cycle
     376
     377           dx = Abs (b(j)%x0 - b(k)%x0)
     378           dy = Abs (b(j)%y0 - b(k)%y0)
     379           dz = Abs (b(j)%z0 - b(k)%z0)
     380
     381           if (dx < t .and. dy < t .and. dz < t) then
     382             if (b(j)%n_childs /= 0) then
     383               b(j)%n_l1 = b(j)%n_l1 + 1
     384               b(j)%l1(b(j)%n_l1) = k
     385             elseif (j > k .or. b(k)%n_childs /= 0) then
     386               b(j)%n_l1 = b(j)%n_l1 + 1
     387               b(j)%l1(b(j)%n_l1) = k
     388             end if
     389           end if
     390         end do
     391       end do
     392     end do
     393     !
     394     !       l2(b) - set consisting of all children of boxes
     395     !       adjustent to parent of b, but separated from b.
     396     !       (Note. The list 2 is empty for boxes on level 1)
     397     !
     398     do i = level(2), nbox
     399       t = d(b(i)%level) + small
     400
     401       i0 = b(i)%parent
     402       do j = 1, b(i0)%n_l1
     403         j0 = b(i0)%l1(j)
     404         do k = 1, b(j0)%n_childs
     405           i1 = b(j0)%childs(k)
     406
     407           dx = Abs (b(i)%x0 - b(i1)%x0)
     408           dy = Abs (b(i)%y0 - b(i1)%y0)
     409           dz = Abs (b(i)%z0 - b(i1)%z0)
     410
     411           if (.not. (dx < t .and. dy < t .and. dz < t)) then
     412             b(i)%n_l2 = b(i)%n_l2 + 1
     413             b(i)%l2(b(i)%n_l2) = i1
     414           end if
     415         end do
     416       end do
     417     end do
     418
 
 FORCHECK PC V13.5.13        DIVIDE_BOX        2021-03-24 10:59:30   page:  1114
 afmm_mod.F90  /FF
 
     419     if (DEBUG) then
