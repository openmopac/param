     192 subroutine FlmoFromFao (nlmo, ncx, nncx, ncxxx, n_dim, &
     193      & latoms, ws, icxxx, icxxx_dim, cxxx, cxxx_dim, &
     194      & ac, fmo_expanded)
     195   use molkst_C, only: numat, norbs
     196   use common_arrays_C, only : f, nfirst, nlast
     197   use MOZYME_C, only : lijbo, nijbo, iorbs
     198   !
     199   !.. Implicit Declarations ..
     200   implicit none
     201   !
     202   !.. Formal Arguments ..
     203   integer, intent (in) :: nlmo, icxxx_dim, cxxx_dim, n_dim
     204   logical, dimension (numat), intent (out) :: latoms
     205   integer, dimension (n_dim), intent (in) :: ncx, ncxxx, nncx
     206   integer, dimension (icxxx_dim), intent (in) :: icxxx
     207   double precision, dimension (nlmo * nlmo), intent (out) :: fmo_expand
 ed
     208   double precision, dimension (norbs), intent (out) :: ws
     209   double precision, dimension (cxxx_dim), intent (in) :: cxxx
     210   double precision, dimension (numat), intent (out) :: ac
     211   integer :: i, i1, i2, i4, ii, j, j1, j2, &
     212        & jj, jx, k, k1, kk, kl, l, loopi, loopj, kj
     213   integer :: i1j1, i1j2, i2j1, i2j2
     214   integer :: k_fmo
     215   double precision :: flim, sum, cutoff
     216   integer, external :: ijbo
     217
     218   ! Tolerance parameters
     219   flim = 1.0d-8
     220   cutoff = 1.0d-8
     221   !
     222   ! For each lmo do ...
     223   fmo_expanded = 0.0d0
     224   k_fmo = 1
     225   do i = 1, nlmo
     226     loopi = ncxxx(i)
     227     !
     228     ! Evaluate weight on each atom from lmo and build list of flags
     229     ! indicating if atoms exist in the lmo
     230     do j = 1, numat
     231       latoms(j) = .false.
     232     end do
     233     l = 0
     234     do j = nncx(i) + 1, nncx(i) + ncx(i)
     235       j1 = icxxx(j)
     236       sum = 0.d0
     237       do k = l + 1, l + iorbs(j1)
     238         sum = sum + cxxx(k+loopi) ** 2
     239       end do
     240       ac(j1) = sum
     241       latoms(j1) = .true.
     242       l = l + iorbs(j1)
     243     end do
     244     !
     245     ! Evaluate F * C
     246     !
     247     ! For each atom in the lmo do ...
     248     do jj = nncx(i) + 1, nncx(i) + ncx(i)
 
