     848     implicit none
     849     double precision :: dx, dy, dz, tt, r, cos_t, phi
     850     complex (kind=dcmplx_kind) :: tc, tc1
     851     integer :: i, j, j1, m, n1, m1, n2, m2
     852     intrinsic Sqrt, Cmplx, Conjg, Exp, Atan2, Abs
     853     !
     854     ! ... Executable Statements ...
     855
     856     !
     857     !       Steps 3 and 8. Interaction of not very well separated point
 s
     858     !       =============
     859     !
     860     !       These step is now combined into step 7 due to different
     861     !       definition of the list 1.
     862     !
     863
     864     !
     865     !       Step 4. Move multipole expansion to boxes in l2 list.
     866     !       ======
     867     !
     868
     869     do i = level(2), nbox
     870       do j1 = 1, b(i)%n_l2
     871         j = b(i)%l2(j1)
     872
     873         dx = b(i)%x0 - b(j)%x0
     874         dy = b(i)%y0 - b(j)%y0
     875         dz = b(i)%z0 - b(j)%z0
     876
     877         r = Sqrt (dx**2 + dy**2 + dz**2)
     878         cos_t = dz / r
     879         if( Abs( dx ) < 1.d-6 .and. Abs( dy ) < 1.d-6 ) then
     880            phi = 0.d0
     881         else
     882            phi = Atan2 (dy, dx)
     883         end if
     884
     885
     886         call get_legendre (p, cos_t, pmn)
     887
     888         do n1 = 0, p
     889           do m1 = 0, n1
     890
     891             tc = (0.d0, 0.d0)
     892
     893             do n2 = 0, p
     894
     895               if (n1+n2 > p) then
     896                 cycle
     897               end if
     898
     899               do m2 = -n2, n2
     900
     901                 if (Abs (m2-m1) > n1+n2) then
     902                   cycle
     903                 end if
 
