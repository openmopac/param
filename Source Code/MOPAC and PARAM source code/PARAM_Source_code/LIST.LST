     390   character(LEN=300) function get_a_name(input, len)
     391 !
     392 ! Given a string of the type "aaa;bbb;ccc" separate
     393 ! off the first string, here "aaa"
     394 !
     395 ! Note: In input, the first character MUST be the first character of th
 e name or
     396 !       a quotation mark
     397 !
     398   integer, intent (in) :: len
     399   character, intent (in) :: input*(len)
     400 !
     401 ! Local variables
     402 !
     403   integer :: istart, istop
     404   logical :: quotation_marks
     405   istart = 1
     406   quotation_marks = (input(istart:istart) == '"')
     407   if (quotation_marks) then
     408 !
     409 !    name starts and ends with quotation marks
     410 !
     411     istart = istart + 1
     412     istop = index(input(istart:), '"') + istart - 2
     413   else
     414     do istop = istart + 1, len
     415       if (input(istop:istop)== " " .or. input(istop:istop) == ";") exit
     416     end do
     417     istop = istop - 1
     418   end if
     419   get_a_name = input(istart:istop)
     420   return
     421   end function get_a_name
 
