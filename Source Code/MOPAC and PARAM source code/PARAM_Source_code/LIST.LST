       1 double precision function helecz ()
       2 !
       3 !   Return the total electronic energy,
       4 !   from e = 0.5P(H + F)
       5 !
       6     use molkst_C, only: numat
       7     use MOZYME_C, only : iorbs
       8     use common_arrays_C, only : p, h, f
       9     implicit none
      10     integer :: i, j, k, l, l1, l2, m
      11     double precision :: ed, ee
      12     integer, external :: ijbo
      13     ed = 0.0d00
      14     ee = 0.0d00
      15     do i = 1, numat
      16       do j = 1, i - 1
      17           k = ijbo (i, j)
      18           if (k >= 0) then
      19             l = k + iorbs(i) * iorbs(j)
      20             do m = k + 1, l
      21               ee = ee + p(m) * (h(m)+f(m))
      22             end do
      23           end if
      24       end do
      25         k = ijbo (i, i)
      26         do l1 = 1, iorbs(i)
      27           do l2 = 1, l1 - 1
      28             k = k + 1
      29             ee = ee + p(k) * (h(k)+f(k))
      30           end do
      31           k = k + 1
      32           ed = ed + p(k) * (h(k)+f(k))
      33         end do
      34     end do
      35     ee = ee + .5d00 * ed
      36     helecz = ee
      37 end function helecz
 
