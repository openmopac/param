      49 subroutine localize_for_MOZYME (c, n289, ic, n267, nc, ncstrt, nmos_loc
 , iorbs, psi1, &
      50      & psi2, axiiii, nf, nl, ioc, nnc_loc, totij, total)
      51     use molkst_C, only: numat, norbs, natoms
      52     implicit none
      53     integer, intent (in) :: n267, n289, nmos_loc
      54     double precision, intent (out) :: totij, total
      55     integer, dimension (n267), intent (in) :: ic
      56     integer, dimension (nmos_loc), intent (in) :: nc, ncstrt, nnc_loc
      57     integer, dimension (numat), intent (inout) :: nf, nl
      58     integer, dimension (numat), intent (in) :: iorbs
      59     integer, dimension (2, numat), intent (inout) :: ioc
      60     double precision, dimension (n289), intent (inout) :: c
      61     double precision, dimension (nmos_loc), intent (inout) :: axiiii
      62     double precision, dimension (norbs), intent (inout) :: psi1, psi2
      63     integer :: i, i1, i5, i8, ii, ij, ijorb, il, il1, iloop, j, j1, j5,
  j8, &
      64    & jl, jl1, jloop, k, k1, l, m
      65     double precision :: aij, bij, ca, dii, dij, djj, sa, xiiii, xiijj,
 &
      66    & xijij, xijjj, xjiii, xjjjj
      67    !
      68    !*******************************************************************
 ***
      69    !
      70    !   LOCALISATION SUBROUTINE
      71    ! ON INPUT
      72    !        C      = EIGENVECTORS IN AN MDIM*MDIM MATRIX
      73    !        NCSTRT = STARTING ADDRESS FOR ATOMIC ORBITALS IN LMO'S
      74    !        NMOS = NUMBER OF LMO'S TO BE USED
      75    !        NNC    = STARTING ADDRESS OF ATOMS IN LMO'S
      76    !        NLAST   = INTEGER ARRAY OF ATOM ORBITAL COUNTERS
      77    !        NFIRST   = INTEGER ARRAY OF ATOM ORBITAL COUNTERS
      78    !
      79    !       SUBROUTINE MAXIMIZES (PSI)**4
      80    !
      81    !*******************************************************************
 ***
      82    !  DUMMY STATEMENT TO USE COMMON BLOCK
      83     i = natoms
      84    !
      85    !   Build all the DII
      86    !
      87     l = 0
      88     xiiii = 0.d0
      89     do k = 1, nmos_loc
      90       l = nnc_loc(k)
      91       m = ncstrt(k)
      92       axiiii(k) = 0.d0
      93       do i = 1, nc(k)
      94         l = l + 1
      95         i1 = ic(l)
      96         dii = 0.d0
      97         do j = 1, iorbs(i1)
      98           m = m + 1
      99           dii = dii + c(m) ** 2
     100         end do
     101         axiiii(k) = axiiii(k) + dii * dii
 
 FORCHECK PC V13.5.13   LOCALIZE_FOR_MOZYME    2021-03-24 10:59:30   page:  4091
 local_for_MOZYME.F90  /FF
 
     102       end do
     103     end do
     104     total = 0.d0
     105     totij = 0.d0
     106     do iloop = 1, nmos_loc
     107       i5 = ncstrt(iloop)
     108       i8 = nnc_loc(iloop)
     109       do jloop = 1, nmos_loc
     110         j8 = nnc_loc(jloop)
     111         j5 = ncstrt(jloop)
     112         if (jloop /= iloop) then
     113           do i = 1, 2
     114             do j = 1, 2
     115               if (ic(i+i8) == ic(j+j8)) go to 1000
     116             end do
     117           end do
     118           cycle
     119 1000      ij = 0
     120           ijorb = 0
     121           il = 0
     122           do i = 1, nc(iloop)
     123             i1 = ic(i+i8)
     124             jl = 0
     125             do j = 1, nc(jloop)
     126               j1 = ic(j+j8)
     127               if (i1 == j1) then
     128                 ij = ij + 1
     129                 nf(ij) = ijorb + 1
     130                 nl(ij) = ijorb + iorbs(i1)
     131                 ioc(1, ij) = il
     132                 ioc(2, ij) = jl
     133                 jl1 = jl
     134                 il1 = il
     135                 do k = 1, iorbs(i1)
     136                   ijorb = ijorb + 1
     137                   il1 = il1 + 1
     138                   jl1 = jl1 + 1
     139                   psi1(ijorb) = c(il1+i5)
     140                   psi2(ijorb) = c(jl1+j5)
     141                 end do
     142               end if
     143               jl = jl + iorbs(j1)
     144             end do
     145             il = il + iorbs(i1)
     146           end do
     147           xijjj = 0.d0
     148           xjiii = 0.d0
     149           xijij = 0.d0
     150           xiijj = 0.d0
     151           do k1 = 1, ij
     152             dij = 0.d0
     153             dii = 0.d0
     154             djj = 0.d0
     155             do k = nf(k1), nl(k1)
     156               dij = dij + psi1(k) * psi2(k)
     157               dii = dii + psi1(k) * psi1(k)
     158               djj = djj + psi2(k) * psi2(k)
     159             end do
     160             xijjj = xijjj + dij * djj
 
 FORCHECK PC V13.5.13   LOCALIZE_FOR_MOZYME    2021-03-24 10:59:30   page:  4092
 local_for_MOZYME.F90  /FF
 
     161             xjiii = xjiii + dij * dii
     162             xijij = xijij + dij * dij
     163             xiijj = xiijj + dii * djj
     164           end do
     165           if (xiijj >= 0.001d0) then
     166             xiiii = axiiii(iloop)
     167             xjjjj = axiiii(jloop)
     168             aij = xijij - (xiiii+xjjjj-2.0d0*xiijj) / 4.0d0
     169             bij = xjiii - xijjj
     170             ca = Sqrt (aij*aij+bij*bij)
     171             sa = aij + ca
     172             if (sa > 1.d-14) then
     173               ca = (1.0d0+Sqrt((1.0d0-aij/ca)/2.0d0)) / 2.0d0
     174               sa = Sqrt (1.0d0-ca)
     175               ca = Sqrt (ca)
     176               totij = totij + sa
     177               ii = 0
     178               do k = 1, ij
     179                 il = 0
     180                 do i = nf(k), nl(k)
     181                   il = il + 1
     182                   ii = ii + 1
     183                   c(ioc(1, k)+il+i5) = ca * psi1(ii) + sa * psi2(ii)
     184                   c(ioc(2, k)+il+j5) = -sa * psi1(ii) + ca * psi2(ii)
     185                 end do
     186               end do
     187             end if
     188           end if
     189         end if
     190       end do
     191       total = total + xiiii
     192     end do
     193     return
     194 end subroutine localize_for_MOZYME
 
