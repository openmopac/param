      73 subroutine addnuc
      74     use molkst_C, only : numat, lm61, enuclr
      75     use funcon_C, only : a0, ev
      76     use common_arrays_c, only : nat
      77     use cosmo_C, only : nps, fepsi, &
      78     amat, bmat, nsetf, phinet, qscnet, qdenet, idenat
      79     use parameters_C, only : tore
      80     implicit none
      81     integer :: i, j
      82     double precision :: enclr, fcon, phi
      83    !
      84    ! FIRST CALCULATE QDENNUC
      85     fcon = a0 * ev
      86     do i = 1, lm61
      87       qdenet(i, 1) = 0
      88     end do
      89     do i = 1, numat
      90       qdenet(idenat(i), 1) = tore(nat(i))
      91     end do
      92    !  NOW CALCULATE PHINUC AS BMAT*QDENUC
      93     do i = 1, nps
      94       phi = 0.d0
      95       do j = 1, lm61
      96         phi = phi + bmat(j, i) * qdenet(j, 1)
      97       end do
      98       phinet(i, 1) = phi
      99     end do
     100    !  NOW CALCULATE QSCNUC FROM  AMAT*QSCNUC = PHINUC
     101     call coscl2 (amat, nsetf, qscnet(1, 1), phinet(1, 1), nps)
     102    ! SCALE QSCNUC AND CALCULATE INTERATION ENERGY
     103     enclr = 0.d0
     104     do i = 1, nps
     105       qscnet(i, 1) = -fepsi * qscnet(i, 1)
     106       enclr = enclr + qscnet(i, 1) * phinet(i, 1)
     107     end do
     108     enuclr = enuclr + fcon * enclr / 2
