       1 subroutine pinout (mode, l_use_disk)
       2    !*******************************************************************
 ***
       3    !
       4    !   PINOUT WRITES ALL INFORMATION REGARDING THE LMO'S TO DISK
       5    !
       6    !  mode = 1             - Write LMO's to disk
       7    !  mode = 0             - Read LMO's from disk
       8    !  l_use_disk = .true.  - Use a disk
       9    !  l_use_disk = .false. - Use a scratch disk
      10    !
      11    !*******************************************************************
 ***
      12     use molkst_C, only: numat, keywrd, nelecs, norbs, line
      13     use MOZYME_C, only : icocc_dim, iorbs, &
      14     nce, ncf, ncvir, nncf, nnce, ncocc, &
      15        & icvir_dim, cocc_dim, cvir_dim, icocc, icvir, cocc, cvir
      16     use chanel_C, only: iw, iden, density_fn
      17     use common_arrays_C, only : nbonds, ibonds
      18     implicit none
      19     integer, intent (in) :: mode
      20     logical, intent (in) :: l_use_disk
      21 !
      22     logical :: opend, exists
      23     integer :: i, j, k, l, nocc, nvir
      24 !
      25     nocc = nelecs / 2
      26     nvir = norbs - nocc
      27     inquire (unit=iden, opened=opend)
      28     if (opend) then
      29       if (l_use_disk) then
      30 !
      31 ! Unconditionally close the file so it can be opened later on.
      32 !
      33         close (unit = iden, status="KEEP", iostat = i)
      34         if (i /= 0) then
      35           inquire (unit=iden, opened=opend)
      36           if (opend) then
      37             close (unit=iden,  iostat = i)
      38             if (i /= 0) return
      39           end if
      40         end if
      41       else
      42 !
      43 !  The scratch file exists, so close it because it is going to be writt
 en to later on.
      44 !
      45         if (mode == 1) close (unit = iden, iostat = i)
      46       end if
      47     end if
      48     if (l_use_disk) then
      49       if (mode == 0) then
      50         inquire (file=density_fn, exist = exists)
      51         if ( .not. exists) then
      52           write (line,"(10x,a)") " FILE " // trim(density_fn) // " IS M
 ISSING"
      53           write(iw,'(//,a)')trim(line)
      54           call to_screen(line)
 
 FORCHECK PC V13.5.13          PINOUT          2021-03-24 10:59:30   page:  1765
 pinout.F90  /FF
 
      55           call mopend ("DENSITY file is missing")
      56           return
      57         end if
      58       end if
      59     end if
      60     if (l_use_disk) then
      61       open (unit=iden, file=density_fn, status="UNKNOWN", form="UNFORMA
 TTED")
      62     else
      63       open (unit=iden, status="SCRATCH", form="UNFORMATTED")
      64     end if
      65     rewind (iden)
      66     if (mode == 1) then
      67       !
      68       !   OUTPUT ALL DATA FOR LMO'S
      69       !
      70       write (iden, err=1030) (ncf(i), i=1, nocc)
      71       write (iden) (nce(i), i=1, nvir)
      72       do i = 1, nocc
      73         write (iden) (icocc(j), j=nncf(i)+1, nncf(i)+ncf(i))
      74       end do
      75       do i = 1, nvir
      76         write (iden) (icvir(j), j=nnce(i)+1, nnce(i)+nce(i))
      77       end do
      78       write (iden) (iorbs(i), i=1, numat)
      79       write (iden) (nbonds(i), i=1, numat)
      80       write (iden) ((ibonds(j, i), j=1, 9), i=1, numat)
      81       !
      82       !  NOW TO WRITE THE LMOS
      83       !
      84       do i = 1, nocc
      85         l = 0
      86           do j = nncf(i) + 1, nncf(i) + ncf(i)
      87             l = l + iorbs(icocc(j))
      88         end do
      89         write (iden) (cocc(j), j=ncocc(i)+1, ncocc(i)+l)
      90       end do
      91       do i = 1, nvir
      92         l = 0
      93         do j = nnce(i) + 1, nnce(i) + nce(i)
      94           l = l + iorbs(icvir(j))
      95         end do
