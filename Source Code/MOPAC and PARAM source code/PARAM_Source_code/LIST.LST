     245                 !
     246                 !   Two microstates differing in two ALPHA electrons
     247                 !
     248                 ii = ll(1)
     249                 !
     250                 !   Add in MICROA(II,I) to allow for the fact that M.O.
  LL(1)
     251                 !   is ALWAYS less than M.O. LL(2).
     252                 !
     253                 !   Step over MICROB(II,I)
     254                 !
 
 FORCHECK PC V13.5.13          CIOSCI          2021-03-24 10:59:30   page:  3511
 ciosci.F90  /FF
 
     255                 ij = microb(ii, i) + microa(ii, i)
