       1 subroutine check (nvec, nnc, nc, icvec, ic_dim, iorbs, ncvec, cvec, c_d
 im)
       2    !*******************************************************************
 ****
       3    !   CHECK corrects very small normalization errors in the LMOs.
       4    !   If the errors are large, greater than 0.1, then a diagnostic
       5    !   message is printed, and the run stopped.  In practice, the error
 s
       6    !   are either (a) very small, in which case correcting them is
       7    !   appropriate, or (b) very large, in which case there is a bug in
 the
       8    !   program.
       9    !
      10    !*******************************************************************
 ****
      11     use molkst_C, only: numat
      12     use chanel_C, only: iw
      13     use MOZYME_C, only : ws
      14    !
      15    !.. Implicit Declarations ..
      16     implicit none
      17    !
      18    !.. Formal Arguments ..
      19     integer, intent (in) :: ic_dim, c_dim, nvec
      20     integer, dimension (ic_dim), intent (in) :: icvec
      21     integer, dimension (nvec+1), intent (in) :: nc, ncvec, nnc
      22     integer, dimension (numat), intent (in) :: iorbs
      23     double precision, dimension (c_dim), intent (inout) :: cvec
      24    !
      25    !.. Local Scalars ..
      26     integer :: i, j, k, l, m, mm, n
      27     double precision :: error, sum
      28    !
      29    !.. Intrinsic Functions ..
      30     intrinsic Abs, Sqrt
      31    !
      32    ! ... Executable Statements ...
      33    !
      34     error = 0.d0
      35    !
      36    !   RENORMALIZE L.M.O.s
      37    !
      38     do i = 1, nvec
      39       m = nnc(i)
      40       sum = 0.d0
      41       n = 0
      42       do j = 1, nc(i)
      43         m = m + 1
      44         k = icvec(m)
      45         do mm = 1, iorbs(k)
      46           n = n + 1
      47           sum = sum + cvec(ncvec(i)+n) ** 2
      48         end do
      49       end do
      50       error = error + Abs (1.d0-sum)
      51       ws(i) = sum
      52     end do
      53     do i = 1, nvec
 
 FORCHECK PC V13.5.13          CHECK           2021-03-24 10:59:30   page:  3541
 check.F90  /FF
 
      54       m = nnc(i)
      55       sum = 1.d0 / Sqrt (ws(i))
      56       n = 0
      57       do j = 1, nc(i)
      58         m = m + 1
      59         k = icvec(m)
      60         do mm = 1, iorbs(k)
      61           n = n + 1
      62           cvec(ncvec(i)+n) = cvec(ncvec(i)+n) * sum
      63         end do
      64       end do
      65     end do
      66     if (error <= 0.1d0) return
      67    !
      68    !   SEVERE ERROR IN LMO's.  QUIT THE JOB
      69    !
      70     call mopend(" ERROR DETECTED IN SUBROUTINE CHECK")
      71     write (iw, "(/,A,F12.6,/)") " MAGNITUDE OF ERROR:", error
      72     write (iw,*) " NUMBER OF VECTORS:", nvec
      73     write (iw, "(/,A,/)") " L.M.O.s WERE NORMALIZED TO"
      74     write (iw, "(5F16.12)") (ws(i), i=1, nvec)
      75     write (iw,*)
      76     do i = 1, nvec
      77       if (Abs (ws(i)-1.d0) > 0.1d0) then
      78         write (iw, "(/,A,I6,A,F12.6/)") "  DETAILS OF LMO", i, " N:", w
 s (i)
      79         write (iw,*) " NUMBER OF ATOMS IN LMO:         ", nc (i)
      80         write (iw,*) " STARTING ADDRESS OF LMO ATOMS:  ", nnc (i)
      81         write (iw,*) " STARTING ADDRESS OF LMO COEFFS.:", ncvec (i)
      82         write (iw,*) " ATOM NUMBERS OF ATOMS IN LMO"
      83         write (iw, "(10I7)") (icvec(j), j=nnc(i)+1, nnc(i)+nc(i))
      84         write (iw,*) " NNC(I+1):", nnc (i+1)
      85         write (iw,*) " NCVEC(I+1):", ncvec (i+1)
      86         l = 0
      87         write (iw,*) " ORBITAL COEFFICIENTS"
      88         sum = Sqrt (ws(i))
      89         do j = 1, nc(i)
      90           k = icvec(nnc(i)+j)
      91           write (iw, "(2I6,9F12.6)") j, k, (cvec(m)*sum, m=ncvec(i)+l+1
 , &
      92          & ncvec(i)+l+iorbs(k))
      93           l = l + iorbs(k)
      94         end do
      95         write (iw,*) " NUMBER OF ORBITALS IN LMO:", l
      96       end if
      97     end do
      98 end subroutine check
 
