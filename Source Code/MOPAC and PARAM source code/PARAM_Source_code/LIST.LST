       1 subroutine density_for_MOZYME (p, mode, nclose_loc, partp)
       2    !*******************************************************************
 ****
       3    !
       4    !   DENSIT COMPUTES THE DENSITY MATRIX GIVEN THE EIGENVECTOR MATRIX,
  AND
       5    !          INFORMATION ABOUT THE M.O. OCCUPANCY.
       6    !
       7    !  INPUT:  COCC  = COMPRESSED OCCUPIED EIGENVECTOR MATRIX
       8    !
