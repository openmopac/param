       1 subroutine wrtkey
       2   use molkst_C, only : moperr, allkey
       3   implicit none
       4 !**********************************************************************
       5 !
       6 !  WRTKEY CHECKS ALL KEY-WORDS AND PRINTS THOSE IT RECOGNIZES.  IF IT
       7 !  FINDS A WORD IT DOES NOT RECOGNIZE THE PROGRAM WILL BE STOPPED.
       8 !
       9 !**********************************************************************
      10 !
      11 !   Write out the control keywords
      12 !
      13   call wrtcon (allkey)
      14   if (moperr) return
      15 !
      16 !   Write out the keywords controlling the working
      17 !
      18   call wrtwor (allkey)
      19 !
      20 !   Write out the keywords controlling the output
      21 !
      22   call wrtout (allkey)
      23 !
      24 !   Check the keywords to see if two or more conflict
      25 !
      26   call wrtchk (allkey)
      27 end subroutine wrtkey
 
 FORCHECK PC V13.5.13          WRTKEY          2021-03-24 10:59:30   page:  4010
 wrtkey.F90  /FF


