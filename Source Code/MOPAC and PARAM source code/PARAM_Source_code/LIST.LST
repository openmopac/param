      71   subroutine ini_linear_cosmo
      72
      73     use molkst_C, only: numat
      74     use cosmo_C, only : lenabc, solv_energy
      75     use common_arrays_C, only: nfirst, nlast
      76     implicit none
      77     integer :: maxrs, i, nnn
      78     intrinsic Allocated
      79     integer, external :: ijbo
      80     !
      81     !       Allocate Linear-Cosmo specific arrays
      82     !
      83     maxrs = 70 * numat
      84     if (Allocated (rsc)) then
      85       deallocate (rsc, tm, iatom_pos, nipsrs, nset, npoints, &
      86                 & ijbo_diag, stat = i)
      87
      88       if (i /= 0) then
      89         call mopend ("CosmoZ (1):  Deallocate error")
      90       end if
      91     end if
      92
      93     allocate (rsc (4, maxrs), tm(3, 3, numat), iatom_pos(numat), &
      94          & nipsrs(lenabc), nset(1082*numat), npoints(numat+1), &
      95          ijbo_diag(numat), stat=i)
      96
      97     if (i /= 0) then
      98       call mopend ("CosmoZ (2):  Allocate error ")
      99     end if
     100
     101     iatom_pos(1) = 0
     102     ijbo_diag(1) = ijbo(1, 1)
     103     do i = 2, numat
     104       nnn = nlast(i-1) - nfirst(i-1) + 1
     105       nnn = ((nnn+1)*nnn)/2
     106       iatom_pos(i) = iatom_pos(i-1) + nnn
     107       ijbo_diag(i) = ijbo(i, i)
     108     end do
     109
     110     solv_energy = 0.d0
     111
     112     call afmm_ini
     113
     114   end subroutine ini_linear_cosmo
 
