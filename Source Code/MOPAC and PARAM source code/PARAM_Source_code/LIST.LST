       1       subroutine mpcsyb(chr, kchrge, eionis, dip)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use molkst_C, only : numat, norbs, nclose, nalpha, nbeta, escf, &
       6       keywrd
       7       use common_arrays_C, only : coord, eigs
       8       use chanel_C, only : isyb, syb_fn
       9       implicit none
      10 !-----------------------------------------------
      11 !   D u m m y   A r g u m e n t s
      12 !-----------------------------------------------
      13       integer , intent(in) :: kchrge
      14       double precision , intent(in) :: eionis, chr(numat)
      15       double precision , intent(inout) :: dip
      16 !-----------------------------------------------
      17 !   L o c a l   V a r i a b l e s
      18 !-----------------------------------------------
      19       integer :: i, j, i1, i2, nfilled
      20 !-----------------------------------------------
      21    open(unit = isyb, file = syb_fn)
      22 !  Write out the charge flag and number of atoms
      23       write (16, '(2I4)', err=30) 1, numat
      24 !  Write out the coordinates and charges
      25       do i = 1, numat
      26         write (16, '(4F12.6)', err=30) (coord(j,i),j=1,3), chr(i)
      27       end do
      28       nfilled = max(nclose, nalpha, nbeta)
      29       i1 = max(1,nfilled - 1)
      30       i2 = min(norbs,nfilled + 2)
      31 !
      32 !  Write out the 2 highest and 2 lowest orbital energies
      33 !
      34       write (16, 20, err=30) (eigs(j),j=i1,i2), nfilled
      35    20 format(4f12.6,2x,i4,2x,'HOMOs,LUMOs,# of occupied MOs')
      36 !
      37 !  Write out the Heat of Formation and Ionisation Potential
      38 !
      39       write (16, '(2F12.6,4X,''HF and IP'')', err=30) escf, eionis
      40 !
      41 !  Write out the Dipole Moment
      42 !
      43       if (kchrge /= 0) dip = 0.0
      44       write (16, '(I4,F10.3,''  Charge,Dipole Moment'')', err=30) kchrg
 e, dip
      45       if (index(keywrd," MULL") /= 0) then
      46         call mpcpop(1)
      47       else
      48         call mpcpop(0)
      49       end if
      50       close(unit = isyb, status = "keep")
      51       return
      52    30 continue
      53       write (6, '(A)') 'Error writing SYBYL MOPAC output'
      54       return
      55       end subroutine mpcsyb
 
