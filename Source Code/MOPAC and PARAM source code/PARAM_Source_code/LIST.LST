    1334       subroutine scopy(n, sx, incx, sy, incy)
    1335       implicit none
    1336 !-----------------------------------------------
    1337 !   D u m m y   A r g u m e n t s
    1338 !-----------------------------------------------
    1339       integer , intent(in) :: n
    1340       integer , intent(in) :: incx
    1341       integer , intent(in) :: incy
    1342       real , intent(in) :: sx(1)
    1343       real , intent(out) :: sy(1)
    1344 !-----------------------------------------------
    1345 !   L o c a l   V a r i a b l e s
    1346 !-----------------------------------------------
    1347       integer :: ix, iy, m, mp1
    1348 !-----------------------------------------------
    1349 !
    1350 !     COPIES A VECTOR, X, TO A VECTOR, Y.
    1351 !     USES UNROLLED LOOPS FOR INCREMENTS EQUAL TO 1.
    1352 !     JACK DONGARRA, LINPACK, 3/11/78.
    1353 !
    1354 !
    1355       if (n <= 0) return
    1356       if (incx/=1 .or. incy/=1) then
    1357 !
    1358 !        CODE FOR UNEQUAL INCREMENTS OR EQUAL INCREMENTS
    1359 !          NOT EQUAL TO 1
    1360 !
    1361         ix = 1
    1362         iy = 1
    1363         if (incx < 0) ix = ((-n) + 1)*incx + 1
    1364         if (incy < 0) iy = ((-n) + 1)*incy + 1
    1365         sy(iy:(n-1)*incy+iy:incy) = sx(ix:(n-1)*incx+ix:incx)
    1366         return
    1367       end if
    1368 !
    1369 !        CODE FOR BOTH INCREMENTS EQUAL TO 1
    1370 !
    1371 !
    1372 !        CLEAN-UP LOOP
    1373 !
    1374       m = mod(n,7)
    1375       if (m /= 0) then
    1376         sy(:m) = sx(:m)
    1377         if (n < 7) return
    1378       end if
    1379       mp1 = m + 1
    1380       sy(mp1:((n-mp1+7)/7)*7-1+mp1) = sx(mp1:((n-mp1+7)/7)*7-1+mp1)
    1381       return
    1382       end subroutine scopy
 
