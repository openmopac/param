       1 double precision function pargeo (grad, wtgeo, refgeo, loc, diffs, ndif
 )
       2   !********************************************************************
 ***
       3   !
       4   !   PARGEO  1:  Computes the gradient error.
       5   !
       6   !********************************************************************
 ***
       7     use molkst_C, only : nvar
       8     use param_global_C, only : power, wtz
       9     implicit none
      10     double precision, dimension (300), intent (in) :: grad
      11     double precision, intent (in) :: wtgeo
      12     character (len=12), dimension (300), intent (in) :: refgeo
      13     integer, dimension (2, 300), intent (in) :: loc
      14     double precision, dimension (300), intent (inout) :: diffs
      15     integer, intent (out) :: ndif
      16     integer :: i, lim
      17     double precision :: relative_weight, sum
      18     intrinsic Min
      19 !----------------------------------------------------------------------
 --
      20     lim = Min (100, nvar)
      21     ndif = 0
      22     sum = 0.d0
      23     do i = 1, lim
      24       if (refgeo(i) /= " ") then
      25         ndif = ndif + 1
      26         if (loc(2, i) == 1) then
      27                                       !
      28           relative_weight = 1.d0      !  Relative weight of bond-length
      29                                       !
      30         else if (loc(2, i) == 2) then !
      31                                       !
      32           relative_weight = 1.d0      !  Relative weight of bond-angle
      33                                       !
      34         else if (loc(2,i) == 3) then  !
      35                                       !
      36           relative_weight = 1.d0      !  Relative weight of dihedral
      37                                       !
      38         end if
      39         diffs(ndif) = grad(i) * wtgeo * relative_weight * wtz
      40         sum = sum + Abs(diffs(ndif)) ** power
      41       end if
      42     end do
      43     pargeo = sum
      44 end function pargeo
 
