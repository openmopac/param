     394 !
     395       subroutine drepp2(ni, rij, ri, core)
     396 !-----------------------------------------------
     397 !   M o d u l e s
     398 !-----------------------------------------------
     399       USE parameters_C, only : natorb, tore, am, ad, aq, dd, qq
     400       USE funcon_C, only : a0, ev
     401 !*********************************************************************
     402 ! DREPP2 CALCULATES THE INTEGRAL FOR PMEP.
     403 ! REFERENCE G.P.FORD AND B.WANG, J.COMPUT.CHEM. 14 (1993)1101.
     404 !                            WRITTEN BY BINGZE WANG, 10 OCTOBER 1991.
     405 !*********************************************************************
     406       implicit none
     407 !-----------------------------------------------
     408 !   D u m m y   A r g u m e n t s
     409 !-----------------------------------------------
     410       integer , intent(in) :: ni
     411       double precision , intent(in) :: rij
     412       double precision , intent(out) :: ri(22)
     413       double precision , intent(out) :: core(4,2)
     414 !-----------------------------------------------
     415 !   L o c a l   V a r i a b l e s
     416 !-----------------------------------------------
     417       integer :: i
     418       double precision, dimension(72) :: arg, sqr
     419       double precision ::  ev1, ev2, pp, r, aee, da, qa, ade, aqe, rsq,
  xxx&
     420         , ee
     421 !-----------------------------------------------
     422       ev1 = ev*0.5D0
     423       ev2 = ev1*0.5D0
     424       data pp/ 0.5D00/
     425       r = rij/a0
     426       if (natorb(ni) < 3) then
     427 !                                           HYDROGEN - HYDROGEN (SS/SS)
     428         aee = pp/am(ni)
     429         aee = aee*aee
     430         ri(1) = ev/dsqrt(r*r + aee)
     431         core(1,1) = ri(1)
     432         core(1,2) = tore(ni)*ri(1)
     433       else
     434 !                                                 HEAVY ATOM - HYDROGEN
     435         aee = pp/am(ni)
     436         aee = aee*aee
     437         da = dd(ni)
     438         qa = qq(ni)*2.0D0
     439         ade = pp/ad(ni)
     440         ade = ade*ade
     441         aqe = pp/aq(ni)
     442         aqe = aqe*aqe
     443         rsq = r*r
     444         arg(1) = rsq + aee
     445         xxx = r + da
     446         arg(2) = xxx*xxx + ade
     447         xxx = r - da
     448         arg(3) = xxx*xxx + ade
     449         xxx = r + qa
     450         arg(4) = xxx*xxx + aqe
 
 FORCHECK PC V13.5.13          DREPP2          2021-03-24 10:59:30   page:  3032
 pmep.F90  /FF
 
     451         xxx = r - qa
     452         arg(5) = xxx*xxx + aqe
     453         arg(6) = rsq + aqe
     454         arg(7) = arg(6) + qa*qa
     455         do i = 1, 7
     456           sqr(i) = dsqrt(arg(i))
     457         end do
     458         ee = ev/sqr(1)
     459         ri(1) = ee
     460         ri(2) = ev1/sqr(2) - ev1/sqr(3)
     461         ri(3) = ee + ev2/sqr(4) + ev2/sqr(5) - ev1/sqr(6)
     462         ri(4) = ee + ev1/sqr(7) - ev1/sqr(6)
     463         core(1,1) = ri(1)
     464         core(2,1) = ri(2)
     465         core(3,1) = ri(3)
     466         core(4,1) = ri(4)
     467         core(1,2) = tore(ni)*ri(1)
     468       end if
     469       return
     470       end subroutine drepp2
 
