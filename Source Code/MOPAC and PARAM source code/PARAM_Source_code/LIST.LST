       1       subroutine wrttxt(iprt)
       2       use molkst_C, only : koment, title, refkey, keywrd, line
       3       implicit none
       4       integer , intent(in) :: iprt
       5       integer :: i, j, k
       6       logical :: l_chains = .false., l_start = .false.
       7 !-----------------------------------------------
       8 !
       9 ! Is CHAINS or START_RES present in the data set?
      10 !
      11       do i = 1, 6
      12         if (index(refkey(i), " NULL") /= 0) exit
      13         line = " "//trim(refkey(i))
      14         call upcase(line, len_trim(line))
      15         if (.not. l_chains) l_chains = (index(line, " CHAINS") /= 0)
      16         if (.not. l_start)  l_start  = (index(line, " START_RES") /= 0)
      17       end do
      18 !
      19 !  Is CHAINS present in the keyword?
      20 !
      21       i = index(keywrd," CHAINS")
      22       if(i /= 0 .and. .not. l_chains) then
      23 !
      24 !  CHAINS is present in keyword, but was not present in the data-set,
      25 !  so add CHAINS keyword to refkey(1)
      26 !
      27         j = index(keywrd(i + 7:), ")") + i + 7
      28         refkey(1) = keywrd(i:j)//trim(refkey(1))
      29       end if
      30 !
      31 !  Is START_RES present in the keyword?
      32 !
      33       i = index(keywrd," START_RES")
      34       if(i /= 0 .and. .not.l_start) then
      35 !
      36 !  START_RES is present in keyword, but was not present in the data-set
 ,
      37 !  so add START_RES keyword to refkey(1)
      38 !
      39         j = index(keywrd(i + 10:), ")") + i + 10
      40         refkey(1) = keywrd(i:j)//trim(refkey(1))
      41       end if
      42       if (refkey(2) == " ") then
      43         i = index(refkey(1), " +")
      44         if (i /= 0) then
      45           refkey(1)(i:i + 1) = " "
      46           refkey(2) = " NULL"
      47         end if
      48       end if
      49       k = 0
      50       do i = 1, 6
      51         if (index(refkey(i), " NULL") /= 0) exit
      52         if (index(refkey(i), " +") == 0) k = k + 1
      53         write(iprt,'(a)', iostat = j)trim(refkey(i))
      54         if (j /= 0) then
      55           call mopend("ERROR DETECTED WHILE TRYING TO WRITE KEYWORDS TO
  A FILE")
      56           return
 
 FORCHECK PC V13.5.13          WRTTXT          2021-03-24 10:59:30   page:  1295
 wrttxt.F90  /FF
 
      57         end if
      58       end do
      59       if (index(koment, " NULL") == 0 .and. k < 3) write (iprt, '(A)')
 trim(koment)
      60       if (index(koment, " NULL") == 0 .and. k < 4) write (iprt, '(A)')
 trim(title)
      61       return
      62       end subroutine wrttxt
 
