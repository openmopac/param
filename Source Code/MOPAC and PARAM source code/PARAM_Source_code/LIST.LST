       1 subroutine depfn (fns, diffns, loop, loch, ndep, ihref, nfns, numvar)
       2     use param_global_C, only : weight, hofcal
       3     implicit none
       4     integer, intent (in) :: loop, ndep, nfns, numvar
       5     integer, dimension (loop), intent (in) :: loch
       6     integer, dimension (ndep), intent (in) :: ihref
       7     double precision, dimension (nfns), intent (inout) :: fns
       8     double precision, dimension (numvar, nfns), intent (inout) :: diffn
 s
       9     integer :: i, iref, j, k, l
      10   !
      11   ! ... Executable Statements ...
      12   !
      13   !
      14   !   Modify FNS and DIFFNS to allow for dependent molecules
      15   !
      16   !
      17   !    LOOP = Current molecule number (The H.o.F. of this molecule
      18   !           depends on the H.o.F. os the molecules in IHREF)
      19   !
      20   !    IREF = Address of current molecule in FNS and in DIFFNS
      21   !
      22   !    J    = Index of the dependent molecule.
      23   !
      24   !    K    = Address of dependent molecule in FNS and in DIFFNS.
      25     iref = loch(loop)
      26     do i = 1, ndep
      27       j = ihref(i)
      28       k = loch(j)
      29     !
      30     !  Calculate the new error in the H.o.F in one step.
      31     !
      32       fns(iref) = fns(iref) - hofcal(j) * weight(1, loop)
      33     !
      34     !  Calculate the new derivatives:
      35     !
      36       do l = 1, numvar
      37         diffns(l, iref) = diffns(l, iref) - diffns(l, k) / weight(1, j)
  * &
      38        & weight(1, loop)
      39       end do
      40     end do
      41 end subroutine depfn
 
