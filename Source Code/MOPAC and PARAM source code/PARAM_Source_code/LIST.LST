 )))
    2343           write (iw, 10010) "X =", (x(i), i=1, n)
    2344           write (iw, 10010) "G =", (g(i), i=1, n)
    2345         end if
    2346       else if (iprint > 0) then
    2347         imod = Mod (iter, iprint)
