       1 subroutine isitsc (escf, selcon, emin, iemin, iemax, okscf, niter, itrm
 ax)
       2     use molkst_C, only: iscf
       3     use MOZYME_C, only : ovmax, energy_diff
       4     implicit none
       5     logical, intent (out) :: okscf
       6     integer, intent (in) :: itrmax, niter
       7     integer, intent (inout) :: iemax, iemin
       8     double precision, intent (in) :: emin, escf, selcon
       9     logical :: scf1 = .false.
      10     integer :: i, iemax1, iemin1
      11     double precision :: energy_test, fmo_test
      12     double precision, dimension (10) :: escf0
      13     data escf0 / 10 * 0.d0 /
      14     save
      15    !
      16    ! Test the change in energy on successive iterations and the maximum
      17    ! element of the occ-vir block of the Fock matrix in the LMO basis
      18    !
      19     energy_test = selcon
      20     fmo_test = selcon * 5.0d0
      21
      22     if (ovmax < fmo_test .and. Abs (energy_diff) < energy_test &
      23          & .and. scf1 .or. niter > itrmax) then
      24       okscf = .true.
      25       iscf = 2
      26       if (scf1) iscf = 1
      27     else
      28       scf1 = (ovmax < fmo_test .and. Abs (energy_diff) < energy_test)
      29       if (emin /= 0.d0) then
      30         !**************************************************************
 ***
      31         !
      32         !  THE FOLLOWING TESTS ARE INTENDED TO ALLOW A FAST EXIT FROM
      33         !  ITER IF THE RESULT IS 'GOOD ENOUGH' FOR THE CURRENT STEP IN
      34         !  THE GEOMETRY OPTIMIZATION
      35         !
      36         if (escf < emin) then
      37           !
      38           !  THE ENERGY IS LOWER THAN THE PREVIOUS MINIMUM.
      39           !  NOW CHECK THAT IT IS CONSISTENTLY LOWER.
      40           !
      41           iemax = 0
      42           iemin1 = iemin
      43           iemin = Min (5, iemin+1)
      44           if (iemin1 == 5) then
      45             do i = 2, 5
      46               escf0(i-1) = escf0(i)
      47             end do
      48           end if
      49           escf0(iemin) = escf
      50           !
      51           !  IS THE DIFFERENCE IN ENERGY BETWEEN TWO ITERATIONS LESS TH
 AN 10%
      52           !  OF THE ENERGY GAIN FOR THIS GEOMETRY RELATIVE TO THE PREVI
 OUS
      53           !  MINIMUM.
      54           !
 
 FORCHECK PC V13.5.13          ISITSC          2021-03-24 10:59:30   page:  3438
 isitsc.F90  /FF
 
      55           if (iemin > 3) then
      56             do i = 2, iemin
      57               if (Abs (escf0(i)-escf0(i-1)) > 0.1d0*(emin-escf)) go to
 1000
      58             end do
      59                !
      60                ! IS GOOD ENOUGH -- RAPID EXIT
      61                !
      62             okscf = .true.
      63             iscf = 1
      64             return
      65           end if
      66         else
      67             !
      68             !  THE ENERGY HAS RISEN ABOVE THAT OF THE PREVIOUS MINIMUM.
      69             !  WE NEED TO CHECK WHETHER THIS IS A FLUKE OR IS THIS REAL
 LY
      70             !  A BAD GEOMETRY.
      71             !
      72           iemin = 0
      73           iemax1 = iemax
      74           iemax = Min (5, iemax+1)
      75           if (iemax1 == 5) then
      76             do i = 2, 5
      77               escf0(i-1) = escf0(i)
      78             end do
      79           end if
      80           escf0(iemax) = escf
      81           !
      82           !  IS THE DIFFERENCE IN ENERGY BETWEEN TWO ITERATIONS LESS TH
 AN 10%
      83           !  OF THE ENERGY LOST FOR THIS GEOMETRY RELATIVE TO THE PREVI
 OUS
      84           !  MINIMUM.
      85           !
      86           if (iemax > 3) then
      87             do i = 2, iemax
      88               if (Abs (escf0(i)-escf0(i-1)) > 0.1d0*(escf-emin)) go to
 1000
      89             end do
      90                !
      91                ! IS GOOD ENOUGH -- RAPID EXIT
      92                !
      93             okscf = .true.
      94             iscf = 1
      95             return
      96           end if
      97         end if
      98       end if
      99 1000  okscf = .false.
     100     end if
     101   end subroutine isitsc
 
