       1       subroutine inid
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE parameters_C, only : am, ad, aq, dd, qq, dorbs, po, ddp, poco
 rd, &
       6       zdn, natorb, main_group
       7       use mndod_C, only : repd, aij
       8 !     *
       9 !     DEFINE SEVERAL PARAMETERS FOR D-ORBITAL CALCULATIONS.
      10 !     *
      11 !-----------------------------------------------
      12 !   I n t e r f a c e   B l o c k s
      13 !-----------------------------------------------
      14       implicit none
      15 !-----------------------------------------------
      16 !   L o c a l   V a r i a b l e s
      17 !-----------------------------------------------
      18       integer :: ni, i
      19 !-----------------------------------------------
      20       repd = 0.d0
      21       aij = 0.d0
      22       do ni = 1, 107
      23         if (.not.dorbs(ni)) cycle
      24         call aijm (ni)
      25         if (zdn(ni) > 1.d-4) call inighd (ni)
      26         call ddpo (ni)
      27       end do
      28       do i = 1, 106
      29         if( natorb(i) < 6 .or. main_group(i)) then
      30           if (am(i) < 1.D-4) am(i) = 1.D0
      31           po(1,i) = 0.5D0/am(i)
      32           if (ad(i) > 1.D-5) po(2,i) = 0.5D0/ad(i)
      33           if (aq(i) > 1.D-5) po(3,i) = 0.5D0/aq(i)
      34           po(7,i) = po(1,i)
      35           ddp(2,i) = dd(i)
      36           ddp(3,i) = qq(i)*sqrt(2.D0)
      37         end if
      38         po(9,i) = po(1,i)
      39         if (pocord(i) > 1.D-5) po(9,i) = pocord(i)
      40       end do
      41       po(2,1) = 0.D0
      42       po(3,1) = 0.D0
      43       return
      44       end subroutine inid
 
