     299       else
     300         step = 1.0D0/step
     301       end if
     302       gradnt(:nvar) = gradnt(:nvar)*step
     303 !
     304 !  NOW TO ENSURE THAT INTERNAL DERIVATIVES ACCURATELY REFLECT CARTESIAN
     305 !  DERIVATIVES
     306 !
     307       if (geochk) then
     308         sum = dot(gradnt,gradnt,nvar)
     309         if (sum<2.D0 .and. dot(dxyz,dxyz,3*numat)>max(4.D0,sum*4.D0)) t
 hen
     310 !
     311 ! OOPS, LOOKS LIKE AN ERROR.
     312 !
     313           do i = 1, nvar
     314             j = int(xparam(i)/3.141D0)
     315             if (.not.(loc(2,i)==2 .and. loc(1,i)>3 .and. abs(xparam(i)-
 j*pi)<0.005D0)) cycle
     316 !
     317 !  ERROR LOCATED, BUT CANNOT CORRECT IN THIS RUN
     318 !
     319             write (iw, '(2/,3(A,/),I3,A)') &
     320               ' INTERNAL COORDINATE DERIVATIVES DO NOT REFLECT', &
 
 FORCHECK PC V13.5.13          DERIV           2021-03-24 10:59:30   page:  1082
 deriv.F90  /FF
 
     321               ' CARTESIAN COORDINATE DERIVATIVES', &
     322               ' TO CORRECT ERROR, INCREASE DIHEDRAL OF ATOM', loc(1,i),
  &
     323               ' BY 90 DEGREES'
     324             write (iw, '(2/,A)') '     CURRENT GEOMETRY'
     325             call geout (iw)
     326             call mopend (&
     327        ' INTERNAL COORDINATE DERIVATIVES DO NOT REFLECT CARTESIAN COORD
 INATE DERIVATIVES')
     328             return
     329           end do
     330         end if
     331       end if
     332 !
     333 !  THIS CODE IS ONLY USED IF THE KEYWORD NOANCI IS SPECIFIED
     334       if (slow) then
     335         if (debug) write (iw, *) 'DOING FULL SCF DERIVATIVES'
     336         call deritr ()
     337         icalcn = numcal
     338 !
     339 ! THE ARRAY ERRFN HOLDS THE EXACT DERIVATIVES MINUS THE APPROXIMATE
     340 ! DERIVATIVES
     341         errfn(:nvar) = errfn(:nvar) - gradnt(:nvar)
     342       end if
     343 !
     344 !  AT THIS POINT, THE INTERNAL DERIVATIVES ARE KNOWN, AND ARE IN GRADNT
 .
     345 !
     346       cosine = dot(gradnt,gold,nvar)/sqrt(dot(gradnt,gradnt,nvar)*dot(g
 old,gold,nvar)&
     347          + 1.D-20)
     348       if (slow) gradnt(:nvar) = gradnt(:nvar) + errfn(:nvar)
     349       if (aic) then
     350         if (aifrst) then
     351           aifrst = .FALSE.
     352           aicorr(:nvar) = (-aidref(:nvar)) - gradnt(:nvar)
     353         end if
     354         gradnt(:nvar) = gradnt(:nvar) + aicorr(:nvar)
     355       end if
     356       if (debug) then
     357         write (iw, '('' GRADIENTS'')')
     358         write (iw, '(8F10.3)') (gradnt(i),i=1,nvar)
     359         write (iw, '('' XPARAM'')')
     360         write (iw, '(8F10.3)') (xparam(i),i=1,nvar)
     361         if (slow) then
     362           write (iw, '('' ERROR FUNCTION'')')
     363           write (iw, '(8F10.3)') (errfn(i),i=1,nvar)
     364         end if
     365       end if
     366       if (debug) write (iw, '('' COSINE OF SEARCH DIRECTION ='',F30.6)'
 ) cosine
     367       return
     368       end subroutine deriv
 
