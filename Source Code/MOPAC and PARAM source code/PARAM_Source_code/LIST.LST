 /line(:3)//&
     850       !      &' is used, then keyword "MMOK" or "NOMM" must be used'
     851       !      call mopend("Keyword MMOK or NOMM must be used with "//lin
 e(:3)//" for this system")
     852       !      return
     853           end if
     854       end if
     855       if (mode /= 1 .and. index(keywrd,'PRTINT') /= 0) then
     856         write (iw, '(2/10X,''  INTERATOMIC DISTANCES'')')
     857         call vecprt (rxyz, numat)
     858       end if
     859       if (rmin < 0.9D0 .and. index(keywrd,'CHECK') /= 0 .or. &
     860           rmin < 0.2D0 .and. index(keywrd,'GEO-OK') == 0 .or. &
     861           rmin < 1.d-4) then
     862         icount = 0
     863         ireal = iminr
     864         jreal = jminr
     865         do i = 1, natoms
     866           if (labels(i)==99 .or. labels(i)==107) cycle
     867           icount = icount + 1
     868           if (icount == iminr) ireal = i
     869           if (icount /= jminr) cycle
     870           jreal = i
     871         end do
     872         if (index(keywrd,' 0SCF') == 0) then
     873           write(line,"('ATOMS',i6,' AND',i6,' ARE SEPARATED BY',f7.4,'
 ANGSTROMS.')")ireal, jreal, rmin
     874           if (index(keywrd,'CHECK') /= 0) then
     875             call mopend(trim(line))
     876             write(iw,'(/10x,a)')'FAULT DETECTED BY KEYWORD "CHECK'
     877             if (log) write (ilog, '(//10x,a,//10x,a)')trim(line), 'FAUL
 T DETECTED BY KEYWORD "CHECK'
     878           else
     879             call mopend(trim(line))
     880             write(iw,'(/10x,a)')'TO CONTINUE CALCULATION SPECIFY "GEO-O
 
