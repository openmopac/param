    1265       do ii = 1, numat
    1266           iab = iorbs(ii)
    1267           if (iab /= 0) then
    1268             i = nijbo (ii, ii) + 1
    1269             ilim = (iab*(iab+1)) / 2
    1270             call fock1_for_MOZYME (f(i), ptot(i), wj(kr+1), kr, iab, il
 im)
    1271           end if
    1272       end do
    1273     end if
    1274    !
    1275     if (mode == -1) f = -f
    1276    ! The following routine adds the dielectric correction to F.
    1277     if (useps .and. mode == 0) call addfckz()
 
