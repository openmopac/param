     276 !
     277 !
     278 !
     279     double precision function Si_O_H_bond_correction(coord, Si, O, H)
     280       use funcon_C, only : pi
     281       implicit none
     282       integer :: Si, O, H
     283       double precision :: coord(3,*)
     284       double precision :: r_Si_O, r_O_H, ref_angle, angle
     285 !
     286 !  Assuming that a Si - O - H structure has been identified, now apply
 a correction.
     287 !  The angle should be 115 degrees
     288 !  Apply a Gaussian when Si - O > 1.7 Angstroms and when O - H > 1.0 An
 gstroms
     289 !  Gaussian drops to 0.05 when atoms are no longer considered connected
     290 !  = 2.02 A for Si -O, and 1.21 A for O - H
     291 !
     292         r_Si_O = (coord(1,O) - coord(1,Si))**2 + (coord(2,O) - coord(2,
 Si))**2 + (coord(3,O) - coord(3,Si))**2 - &
     293               1.7d0**2
     294         r_O_H  = (coord(1,O) - coord(1,H ))**2 + (coord(2,O) - coord(2,
 H ))**2 + (coord(3,O) - coord(3,H ))**2 - &
     295               1.d0
     296         ref_angle = 125.d0*pi/180.d0
     297         call bangle (coord, Si, O, H, angle)
     298         Si_O_H_bond_correction = 15.d0*(angle - ref_angle)**2*exp(-33.d
 0*max(0.d0, r_Si_O))*exp(-68.d0*max(0.d0, r_O_H ))
     299         return
     300       end function Si_O_H_bond_correction
 
