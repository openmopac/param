    1507   subroutine write_screen_bonds(compressed, orbs2, hook, fmt9p4)
    1508   use common_arrays_C, only : bondab
    1509   use molkst_C, only : numat
    1510   use chanel_C, only : iw
    1511   implicit none
    1512   integer, intent (in) :: hook
    1513   logical, intent (in) :: compressed
    1514   character, intent (in) :: orbs2*3, fmt9p4*5
    1515   character :: fmt*3, fmt1*5
    1516   integer :: i, j, ic
    1517   double precision :: sum
    1518   double precision, allocatable :: comp(:)
    1519   integer, allocatable :: icomp(:)
    1520     if (.not. allocated(bondab))  then
    1521       i = iw
    1522       iw = 88
    1523       open(unit=iw, status='SCRATCH')
    1524       call bonds ()
    1525       close(iw)
    1526       iw = i
    1527     end if
    1528     if (compressed) then
    1529       i = (numat*(numat + 1))/2
    1530       allocate(comp(i), icomp(i))
    1531       ic = 0
    1532       do i = 1, numat
    1533 !
    1534 !  Work out all bond orders involving atom i
    1535 !
    1536         do j = 1, i - 1
    1537           sum = bondab((i*(i - 1))/2 + j)
    1538           if (sum > 0.05d0) then
    1539             ic = ic + 1
    1540             comp(ic) = sum
    1541             icomp(ic) = (i*(i - 1))/2 + j
    1542           end if
    1543         end do
    1544       end do
    1545       if (ic < 999) then
    1546         fmt = "3.3"
    1547       else
    1548         fmt = "6.6"
    1549       end if
    1550       j = int(log10((numat*(numat + 1))/2*1.0001)) + 2
    1551       write(fmt1,'(i2,a,i1)')120/j, "i", j
    1552       write(hook,"(1x,a,i"//fmt//",a)")" COMPRESSED_BOND_ORDERS_INDICES
 [",ic,"]="
    1553       write(hook,"("//fmt1//")") (icomp(i),i=1,ic)
    1554       write(hook,"(1x,a,i"//fmt//",a)")" COMPRESSED_BOND_ORDERS_VALUES[
 ",ic,"]="
    1555       write(hook,"(10f"//fmt9p4//")") (comp(i),i=1,ic)
    1556     else
    1557       write(hook,"(a,i"//orbs2//",a)")" BOND_ORDERS[",(numat*(numat + 1
 ))/2,"]="
    1558       write(hook,"(a)")" #  Lower half triangle only"
    1559       write(hook,"(10f"//fmt9p4//")") (bondab(i), i=1,(numat*(numat + 1
 ))/2)
    1560     end if
 
