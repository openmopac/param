    1219     if (time0 > 1.d0 .and. job_no < 4) then
    1220 !
    1221 !  Deliberately run a time-consuming calculation to work out CPU speed
    1222 !  The "j" index is set to use up 1.0 seconds on the development comput
 er.
    1223 !  Do NOT change this quantity!
    1224 !
    1225       bk = seconds(2)
    1226       bi = 0.d0
    1227       do j = 1,142083
    1228         do i = 1,1000
    1229           bi = bi + 1.d0/i
    1230         end do
    1231       end do
    1232       bk = seconds(2) - bk
    1233       write(hook,"(a,f12.2)")" CPU_TIME:ARBITRARY_UNITS[1]=",time0/bk
    1234     end if
    1235     write(hook,"(a)")" END OF MOPAC FILE"
    1236     new_calcn = .true.
    1237   end if
    1238   return
    1239 end subroutine current_version
 
