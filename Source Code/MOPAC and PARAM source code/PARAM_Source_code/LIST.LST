     334       subroutine spline(x, f, df, xhigh, xlow,  xmin, npnts)
     335 !-----------------------------------------------
     336 !   M o d u l e s
     337 !-----------------------------------------------
     338 !**********************************************************************
 *
     339       implicit none
     340       integer :: npnts
     341       double precision, dimension(12) :: x, f, df
     342       double precision :: xlow, xhigh, xmin, fmin, dfmin
     343 !-----------------------------------------------
     344 !   L o c a l   V a r i a b l e s
     345 !-----------------------------------------------
     346       integer :: k1, j2, n1, k
     347       double precision :: close, big, huge, ustep, dstep, step, xstart,
  xstop, dx, &
     348         x1, x2, dum, a, b, c, bb, ac3, xk, r, fm
     349       logical :: skip1, skip2
     350
     351       save close, big, huge, ustep, dstep
     352 !-----------------------------------------------
     353 !
     354 !     FIT F(X) BY A CUBIC SPLINE GIVEN VALUES OF THE FUNCTION
     355 !     AND ITS FIRST DERIVATIVE AT npnts PNTS.
     356 !     SUBROUTINE RETURNS VALUES OF XMIN,FMIN, AND DFMIN
     357 !     AND MAY REORDER THE DATA.
     358 !     XLOW AND XHIGH SET LIMITS ON THE INTERVAL WITHIN WHICH
     359 !     TO SEARCH.  SUBROUTINE MAY FURTHER REDUCE THIS INTERVAL.
     360 !
     361       data close, big, huge, ustep, dstep/ 1.0D-8, 500.0D0, 1.0D+10, 1.
 0D0, &
     362         2.0D0/
     363 !
     364 !     SUBROUTINE ASSUMES THAT THE FIRST npnts-1 DATA PNTS HAVE BEEN
     365 !     PREVIOUSLY ORDERED,  X(I).LT.X(I+1) FOR I=1,2,...,npnts-2
     366 !     NOW MOVE NTH POINT TO ITS PROPER PLACE.
     367 !
     368       xmin = x(npnts)
     369       fmin = f(npnts)
     370       dfmin = df(npnts)
     371       n1 = npnts - 1
     372       k = n1
     373       k1 = k
     374       j2 = min0(1,k1)
     375       do k = k1, j2, -1
     376         if (x(k) < xmin) go to 20
     377         x(k+1) = x(k)
     378         f(k+1) = f(k)
     379         df(k+1) = df(k)
     380       end do
     381    20 continue
     382       x(k+1) = xmin
     383       f(k+1) = fmin
     384       df(k+1) = dfmin
     385       if (df(1) > 0.0D0) then
     386 !
     387 !     DEFINE THE INTERVAL WITHIN WHICH WE TRUST THE SPLINE FIT.
     388 !     USTEP =  UP HILL STEP SIZE FACTOR
 
 FORCHECK PC V13.5.13          SPLINE          2021-03-24 10:59:30   page:  3410
 interp.F90  /FF
 
     389 !     DSTEP = DOWN HILL STEP SIZE FACTOR
     390 !
     391         step = dstep
     392       else
     393         step = ustep
     394       end if
     395       xstart = x(1) - step*(x(2)-x(1))
     396       xstart = max(xstart,xlow)
     397       if (df(npnts) > 0.0D0) then
     398         step = ustep
     399       else
     400         step = dstep
     401       end if
     402       xstop = x(npnts) + step*(x(npnts)-x(n1))
     403       xstop = min(xstop,xhigh)
     404 !
     405 !     SEARCH FOR MINIMUM
     406 !
     407       do k = 1, n1
     408         skip1 = k /= 1
     409         skip2 = k /= n1
     410         if (f(k) < fmin) then
     411           xmin = x(k)
     412           fmin = f(k)
     413           dfmin = df(k)
     414         end if
     415         dx = x(k+1) - x(k)
     416 !
     417 !     SKIP INTERVAL IF PNTS ARE TOO CLOSE TOGETHER
     418 !
     419         if (dx <= close) cycle
     420         x1 = 0.0D0
     421         if (k == 1) x1 = xstart - x(1)
     422         x2 = dx
     423         if (k == n1) x2 = xstop - x(n1)
     424 !
     425 !     (A,B,C)=COEF OF (CUBIC,QUADRATIC,LINEAR) TERMS
     426 !
     427         dum = (f(k+1)-f(k))/dx
     428         a = (df(k)+df(k+1)-dum-dum)/(dx*dx)
     429         b = (dum + dum + dum - df(k)-df(k)-df(k+1))/dx
     430         c = df(k)
     431 !
     432 !     XK = X-X(K) AT THE MINIMUM WITHIN THE KTH SUBINTERVAL
     433 !     TEST FOR PATHOLOGICAL CASES.
     434 !
     435         bb = b*b
     436         ac3 = (a + a + a)*c
     437         if (bb < ac3) go to 90
     438         if (b <= 0.0D0) then
     439           if (abs(b) > huge*abs(a)) go to 90
     440         else
     441           if (bb > big*abs(ac3)) go to 60
     442         end if
     443 !
     444 !     WELL BEHAVED CUBIC
     445 !
     446         xk = ((-b) + sqrt(bb - ac3))/(a + a + a)
     447         go to 70
 
 FORCHECK PC V13.5.13          SPLINE          2021-03-24 10:59:30   page:  3411
 interp.F90  /FF
 
     448 !
     449 !     CUBIC IS DOMINATED BY QUADRATIC TERM
     450 !
     451    60   continue
     452         r = ac3/bb
     453         xk = -(((0.039063D0*r + 0.0625D0)*r + 0.125D0)*r + 0.5D0)*c/b
     454    70   continue
     455         if (xk<x1 .or. xk>x2) go to 90
     456    80   continue
     457         fm = ((a*xk + b)*xk + c)*xk + f(k)
     458         if (fm <= fmin) then
     459           xmin = xk + x(k)
     460           fmin = fm
     461           dfmin = ((a + a + a)*xk + b + b)*xk + c
     462 !
     463 !     EXTRAPOLATE TO END OF INTERVAL IF K=1 AND/OR K=N1
     464 !
     465         end if
     466    90   continue
     467         if (skip1) go to 100
     468         skip1 = .TRUE.
     469         xk = x1
     470         go to 80
     471   100   continue
     472         if (skip2) cycle
     473         skip2 = .TRUE.
     474         xk = x2
     475         go to 80
     476       end do
     477       return
     478       end subroutine spline
 
