     906       double precision function aval (h, d, norbs)
     907 !-----------------------------------------------
     908 !   M o d u l e s
     909 !-----------------------------------------------
     910       implicit none
     911 !-----------------------------------------------
     912 !   D u m m y   A r g u m e n t s
     913 !-----------------------------------------------
     914       integer , intent(in) :: norbs
     915       double precision , intent(in) :: h(norbs,norbs)
     916       double precision , intent(in) :: d(norbs,norbs)
     917 !-----------------------------------------------
     918 !   L o c a l   V a r i a b l e s
     919 !-----------------------------------------------
     920       integer :: i, j
     921       double precision :: sum
     922 !-----------------------------------------------
     923 !.................................................................
     924 !  COMPUTE POLARIZABILITY AS TRACE OF H*D
     925 !.................................................................
     926       sum = 0.0D00
     927       do i = 1, norbs
     928         do j = 1, norbs
     929           sum = sum + h(i,j)*d(j,i)
     930         end do
     931       end do
     932       aval = -sum
     933       return
     934       end function aval
 
