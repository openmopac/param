     533           call GGJPP_IntQ(Rab, 1, (/1.d0/), (/Za/), (/dZadQa/), 1, (/1.
 d0/), (/Zb/), (/dZbdQb/), X, Xa, Xb)
     534           Eta( i1:i2, j1:j2 ) = X
