     256 !     *****************************************************************
 ********
     257
     258       subroutine scfirr (v, mu, g, k1, k2, k3, k4)
     259
     260       use reimers_C, only : nshell, avec1, bvec1, avec2, bvec2, matind,
  ff, dd
     261
     262       implicit none
     263       double precision ::   g, q, v, hg, v1
     264       integer ::            is, k1, k2, k3, k4, mu, nm
     265
     266 !     **** inserts Zerners irregular ints into atomic Fock matrix block
  ****
     267 !     **** add and contribution to total energy v
   ****
     268 !     **** mu = nber of first basis function of this atom
   ****
     269
     270       if (k2 >= k1) then
     271 !       **** Coulomb integral, use A vec ****
     272
     273 !       **** mixing of dens(3, 4) ****
     274         nm = matind(mu + max(k3, k4)) + mu + min(k3, k4)
     275         call veccou (nm, avec1, bvec1)
     276
     277 !       **** mixing of dens(1, 2) ****
     278         nm = matind(mu + k2) + mu + k1
     279         call veccou (nm, avec2, bvec2)
     280
     281         hg = avec1(0) * g
     282         v1 = avec2(0) * hg
     283         do is = 1, nshell
     284           q = avec1(is) * g
     285           ff(nm, is) = ff(nm, is) + hg - q
     286           v1 = v1 - q * dd(nm, is)
     287         end do
     288         if (k2 == k1) v1 = 0.5d0 * v1
     289         v = v + v1
     290       end if
     291
     292       if (k3 >= k1) then
     293 !       **** Exchange integral, use - B vec ****
     294
     295 !       **** mixing of dens(2, 4) ****
     296         nm = matind(mu + max(k2, k4)) + mu + min(k2, k4)
     297         call veccou (nm, avec1, bvec1)
     298
     299 !       **** mixing of dens(3, 1) ****
     300         nm = matind(mu + k3) + mu + k1
     301         call veccou (nm, avec2, bvec2)
     302
     303         hg = -bvec1(0) * g
     304         v1 = avec2(0) * hg
     305         nm = matind(mu + k3) + mu + k1
     306         do is = 1, nshell
     307           q = -bvec1(is) * g
     308           ff(nm, is) = ff(nm, is) + hg - q
 
 FORCHECK PC V13.5.13          SCFIRR          2021-03-24 10:59:30   page:   190
 scf.F90  /FF
 
     309           v1 = v1 - q * dd(nm, is)
     310         end do
     311         if (k3 == k1) v1 = 0.5d0 * v1
     312         v = v + v1
     313       end if
     314
     315       return
     316       end subroutine scfirr
 
 FORCHECK PC V13.5.13          SCFIRR          2021-03-24 10:59:30   page:   191
 scf.F90  /FF


