 geochk_bits_1.F90  /FF
 
  residue name"
     652             end if
     653             first = .false.
     654             line="XENO=("
     655           end if
     656           do i = 1, 20
     657             if (old == tyres(i)) exit
     658           end do
     659           num = tyr(i)
     660           if (i == 21) num = " "
     661           write(iw,'(i14,a, 2x,a3,3x, 11x,i5,a,2x,a3)')old_res, " "//ch
 ains(mbreaks), old, &
     662             new_res, " "//chains(mbreaks), new
     663           if (log) write(ilog,'(i14,a, 2x,a3,3x, a1, 11x,i5,a,2x,a3)')o
 ld_res, " "//chains(mbreaks), &
     664             old, num, new_res, " "//chains(mbreaks), new
     665           if (i < 21) then
     666             j = len_trim(line) + 1
     667             if (j > 200) exit
     668             if (old_res > -1) then
     669               num = char(ichar("1") + int(log10(old_res + 0.05)))
     670               write(line(j:),'(a1,i'//num//',a1,a1,a1)')chains(mbreaks)
 , old_res, "=", tyr(i),","
     671             else
     672               num = char(ichar("1") + int(log10(-old_res + 0.05)) + 1)
     673               write(line(j:),'(a1,i'//num//',a1,a1,a1)')chains(mbreaks)
 , old_res, "=", tyr(i),","
     674             end if
     675           end if
     676         end if
     677       end if
     678       previous = new_res
     679     end if
     680   end do
     681   call l_control("CHANGED ALREADY PRINTED", len("CHANGED ALREADY PRINTE
 D"), 1)
     682   if (first .and. n_new == 0) then
     683   else
     684     j = len_trim(line)
