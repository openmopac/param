    1174       logical function symdec (n1, ielem)
    1175       implicit none
    1176 !-----------------------------------------------
    1177 !   D u m m y   A r g u m e n t s
    1178 !-----------------------------------------------
    1179       integer , intent(in) :: n1
    1180       integer , intent(in) :: ielem(20)
    1181 !-----------------------------------------------
    1182 !   L o c a l   V a r i a b l e s
    1183 !-----------------------------------------------
    1184       integer :: in1, i, ibin
    1185 !-----------------------------------------------
    1186 !
    1187 !*********************************************************************
    1188 !
    1189 !   SYMDEC matches up a set of symmetry operations for the system
    1190 !          with a point-group.  The set of symmetry operations are
    1191 !          stored in IELEM.  Point-groups are represented by a
    1192 !          number, N1, which is expanded into binary.
    1193 !
    1194 !          A system has the symmetry of a specific point-group if
    1195 !          every operation of the point-group is present in the
    1196 !          system.  Extra operations may also be present, but are
    1197 !          ignored.  This allows a controlled descent in symmetry.
    1198 !          The symmetry groups in the calling routine, CARTAB, are
    1199 !          stored in order of symmetry - C1 to R3.
    1200 !  SYMDEC  returns a .TRUE. if the system matches point-group N1.
    1201 !
    1202 !*********************************************************************
    1203       in1 = n1
    1204       do i = 1, 20
    1205         ibin = mod(in1,2)
    1206         if (ielem(i)/=1 .and. ibin==1) go to 20
    1207         in1 = in1/2
    1208       end do
    1209       symdec = .TRUE.
    1210       return
    1211    20 continue
    1212       symdec = .FALSE.
    1213       return
    1214       end function symdec
 
