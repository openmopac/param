    1980 subroutine extvdw (vdw, refvdw)
    1981     use molkst_C, only : numat, keywrd, line
    1982     use chanel_C, only : iw
    1983     use common_arrays_C, only : nat
    1984     use elemts_C, only : cap_elemnt, elemnt
    1985     implicit none
    1986     double precision, dimension (107), intent (out) :: vdw
    1987     double precision, dimension (107), intent (in) :: refvdw
    1988     integer :: i, j, k
    1989     double precision, external :: reada
    1990    !
    1991    ! ... Executable Statements ...
    1992    !
    1993    !  Modify Van der Waal's radii of various atoms.  The format of
    1994    ! the keyword is: VDW(chemical symbol = n.nn:chemical symbol = n.nn
 ...)
    1995    ! e.g. VDW(:H = 1.0:Cl = 1.7)
    1996    !
    1997    i = index(keywrd, " VDW(")
    1998     if (i == 0) then
    1999       line = " "
    2000     else
    2001       if (keywrd(i + 5:i + 5) /= ";") keywrd(i + 5:) = ";"//keywrd(i +
 5:)
    2002       j = index(keywrd(i + 5:), ")") + i + 5
    2003       do k = i + 5, j
    2004          if (keywrd(k:k) == ":") keywrd(k:k) = ";"
    2005          if (keywrd(k:k) == ", ") keywrd(k:k) = ";"
    2006       end do
    2007       line = keywrd(i + 5:j - 1)
    2008     end if
    2009     vdw(:107) = refvdw(:107)
    2010     if (line /= " ") then
    2011       do i = 1, 107
    2012         j = 2
    2013         if (cap_elemnt(i) (2:2) == " ") j = 1
    2014         j = index(line, ";"//cap_elemnt(i)(:j)//"=")
    2015         if (j > 0) vdw(i) = reada(line, j)
    2016       end do
    2017     end if
    2018     !
    2019     !  Verify that all radii that will be used are, in fact, set correc
 tly
    2020     !
    2021     do i = 1, numat
    2022       if (nat(i) > 102) cycle
    2023       if (vdw(nat(i)) > 900.d0) then
    2024         write (line, *) "MISSING VAN DER WAALS RADIUS " // elemnt (nat(
 i))
    2025         call mopend (trim(line))
    2026         j = 2
    2027         if (elemnt(nat(i)) (2:2) == " ") j = 1
    2028         write (iw, "(2x, 3a)") "To correct this, add keyword 'VDW(", &
    2029        & elemnt (nat(i)) (1:j), " = n.nn)'"
    2030         return
    2031       end if
    2032     end do
    2033 end subroutine extvdw
 
