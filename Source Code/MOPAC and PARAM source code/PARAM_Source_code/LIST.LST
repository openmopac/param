       1 double precision function invfn (x, qn, mode)
       2     implicit none
       3     integer, intent (in) :: qn, mode
       4     double precision, intent (in) :: x
       5     double precision :: x0, x1, ans0, ans1, new
       6     intrinsic Abs
       7     ans0 = 2.0d0
       8     x0 = fn(ans0, qn, mode) - x
       9     ans1 = ans0 * 1.1d0
      10     do
      11       x1 = fn(ans1, qn, mode) - x
      12       if (Abs (x0-x1) < 1.d-10) exit
      13       new = ans0 + x0 * (ans1-ans0) / (x0-x1)
      14       if (Abs(x1) < 1.d-10) exit
      15       x0 = x1
      16       ans0 = ans1
      17       ans1 = new
      18     end do
      19     invfn = new
      20 contains
 
