     987       integer , intent(in) :: kl
     988       integer , intent(in) :: li
     989       integer , intent(in) :: lj
     990       integer , intent(in) :: lk
     991       integer , intent(in) :: ll
     992       integer , intent(in) :: ic
     993       double precision  :: r
