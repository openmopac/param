     779   subroutine txt_to_atom_no(text, j_in, let)
     780 !
     781 !  Convert atom number from text to a number.  Text can be PDB or Jmol
     782 !
     783 !  On input, "text": Line of text containing PDB or Jmol
     784 !            j_in: Start of text (location of the character after the l
 eading '"')
     785 !            let:  TRUE if the job is to continue even if a fault is fo
 und.
     786 !
     787 ! On exit, "text": PDB or Jmol text has been replaced by numbers
     788 !
     789   use molkst_C, only: natoms, pdb_label
     790   use common_arrays_C, only: txtatm
     791   use chanel_C, only: iw
     792   implicit none
     793   character :: text*(*)
     794   integer, intent (in) :: j_in
     795   logical, intent (in) :: let
     796   integer :: i, j, l, n, k, m
     797   character :: line*80, txt*30, num*1, txt2*30
     798   if (.not. pdb_label) then
     799     call mopend("Labeled atoms can only be used when atoms have labels"
 )
     800     m = 0
     801     return
     802   end if
     803   j = j_in + 1
     804   l = index(text(j:),"""") + j
     805   call upcase(text, len_trim(text))
     806   line = text(j:l - 2)
     807   if (j > 2) then
     808     num = text(j - 2:j - 2)
     809     if (num >= "0" .and. num <= "9") call mopend("ERROR DETECTED IN CVB
  KEYWORD IMMEDIATELY BEFORE """//trim(line)//"""")
     810   end if
     811   txt2 = trim(line)
     812   if (line(1:1) == "[") then
     813     k = len_trim(line)
     814     if (k > 16) then
     815       write(line,'(a)')"Atom defined by '"//trim(line)//"' is not in JS
 mol format"
     816       call mopend(trim(line))
     817       return
     818     end if
     819 !
     820 ! Atom defined using Jmol format
     821 !
     822     n = index(text(j:l - 2),".") + j
     823     k = index(text(j:l - 2),":") + j
     824     m = index(text(j:l - 2),"]") + j
     825     if (n == j .or. m == j) then
     826       write(line,'(a)')"Atom defined by '"//trim(line)//"' is not in JS
 mol format"
     827       call mopend(trim(line))
     828       if (n == j) call mopend("(The dot separator, ""."", is missing.)"
 )
     829       if (m == j) call mopend("(The close square bracket, ""]"", is mis
 
 FORCHECK PC V13.5.13      TXT_TO_ATOM_NO      2021-03-24 10:59:30   page:  3783
 lewis.F90  /FF
 
 sing.)")
     830       return
     831     end if
     832     if (k == j) then
     833       line = text(n:l - 2)//text(j + 1:m - 2)//text(m:n - 2)
     834     else
     835       line = text(n:l - 2)//text(j + 1:m - 2)//text(k:k)//text(m:k - 2)
     836     end if
     837   end if
     838   m = 0
     839   do k = 1, len_trim(line)
     840     if (line(k:k) /= " ") then
     841       m = m + 1
     842       line(m:m) = line(k:k)
     843     end if
     844   end do
     845   line(m + 1:) = " "
     846   if (m > 12) then
     847      write(line,'(a)')"Atom defined by '"//trim(line)//"' is not in PDB
  format"
     848      call mopend(trim(line))
     849      return
     850   end if
     851   line(m + 1:m + 5) = " "
     852   do i = 1, natoms
     853     txt = txtatm(i)
     854     call upcase(txt, len_trim(txt))
     855     n = 0
     856     do k = 13, 27
     857       if (txt(k:k) /= " ") then
     858         n = n + 1
     859         txt(n:n) = txt(k:k)
     860       end if
     861     end do
     862     txt(n + 1:m ) = "?"
     863     n = max(n, m)
     864     do k = 1, n
     865       if (txt(k:k) /= line(k:k) .and. line(k:k) /= "*") exit
     866     end do
     867     if (k > n) then
     868       num = char(ichar("1") + int(log10(i*1.0001)))
     869       write(line,'(i'//num//')')i
     870       text(j - 1:) = trim(line)//text(l:)
     871       exit
     872     end if
     873   end do
     874   if (i > natoms) then
     875     k = len_trim(line)
     876     if (index(txt2,"[") /= 0) then
     877       write(line,'(a)')"Atom defined by JSmol label '"//trim(txt2)//"'
 was not found in the data set"
     878     else
     879       write(line,'(a)')"Atom defined by PDB label '"//trim(txt2)//"' wa
 s not found in the data set"
     880     end if
     881     if(.not. let) then
     882       call mopend(trim(line))
     883       write(iw,'(10x,a)') &
     884       "(Hint: Check that the atom-label in the data set matches the ato
 
 FORCHECK PC V13.5.13      TXT_TO_ATOM_NO      2021-03-24 10:59:30   page:  3784
 lewis.F90  /FF
 
 m-label in the PDB file.)"
     885       write(iw,'(10x,a)')"(Hint: Atom-labels used in connectivity can o
 nly use atoms that have already been defined.)"
     886       return
     887     end if
     888   end if
     889   return
     890   end subroutine txt_to_atom_no
 
