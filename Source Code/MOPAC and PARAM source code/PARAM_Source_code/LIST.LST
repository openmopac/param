    2621   subroutine find_polar_atom(O1, C, O2, Rab)
    2622 !
    2623 ! Given a -COO group, -(C)(O1)(O2), find the nearest polar oxygen.
    2624 ! If it's O1, set Rab large
    2625 ! If it's O2, set Rab small
    2626 ! If there isn't one, set Rab very small
    2627 !
    2628   use molkst_C,  only : numat
    2629   use common_arrays_C,  only : nat,  coord,  nbonds,  ibonds
    2630   implicit none
    2631   integer, intent (in) :: O1, C, O2
    2632   double precision, intent (inout) :: Rab
    2633   integer :: i, j, k, n1, n2, n1_near(10), n2_near(10)
    2634   double precision :: RO1, RO2, angle, RO1_near(10), RO2_near(10)
    2635   double precision, external :: distance
    2636     n1 = 0
    2637     n2 = 0
    2638     RO1 = 0.d0
    2639     do i = 1, numat
    2640       if (nat(i) == 8) then
    2641         if (i /= O1) then
    2642           do j = 1, nbonds(i)
    2643             k = ibonds(j,i)
    2644             if (nat(k) == 6) then
    2645               RO1 = distance(O1, i)
    2646               if (RO1 < 4.d0) then
    2647                 call bangle(coord, C, O1, i, angle)
    2648                 if (angle > 1.570796d0) then ! 90 degrees
    2649                   call dihed (coord, i, O1, C, O2, angle)
    2650                   if (angle < 1.570796d0 .or. angle > 4.71239d0) then
    2651                     n1 = n1 + 1
    2652                     n1_near(n1) = i
    2653                     RO1_near(n1) = RO1
    2654                   end if
    2655                 end if
    2656               end if
    2657             end if
    2658           end do
    2659         end if
    2660         if (i /= O2) then
    2661           do j = 1, nbonds(i)
    2662             k = ibonds(j,i)
    2663             if (nat(k) == 6) then
    2664               RO2 = distance(O2, i)
    2665               if (RO2 < 4.d0) then
    2666                 call bangle(coord, C, O2, i, angle)
    2667                 if (angle > 1.570796d0) then ! 90 degrees
    2668                   call dihed (coord, i, O2, C, O1, angle)
    2669                   if (angle < 1.570796d0 .or. angle > 4.71239d0) then
    2670                     n2 = n2 + 1
    2671                     n2_near(n2) = i
    2672                     RO2_near(n2) = RO1
    2673                   end if
    2674                 end if
    2675               end if
    2676             end if
    2677           end do
    2678         end if
 
 FORCHECK PC V13.5.13     FIND_POLAR_ATOM      2021-03-24 10:59:30   page:   790
 add_hydrogen_atoms.F90  /FF
 
    2679       end if
    2680     end do
    2681     if (n1 == 0) then
    2682       if (n2 == 0) return
    2683 !
    2684 !  There is an oxygen near to O2.  Set Rab small, so that the hydrogen
 is put on O2
    2685 !
    2686       Rab = 0.52d0
    2687     else
    2688       if (n2 == 0) then
    2689 !
    2690 !  There is an oxygen near to O1.  Set Rab large, so that the hydrogen
 is put on O1
    2691 !
    2692         Rab = 4.02d0
    2693       else
    2694 !
    2695 !  There are no oxygen atoms near tp O1 or O2.  Set Rab large, so that
 the C-O1 and C-O2
    2696 !  distances will be used in deciding which oxygen atom has the hydroge
 n
    2697 !
    2698         RO1 = 10.d0
    2699         if (O1 == 814 .or. O1 == 815) then
    2700                       continue
    2701                     end if
    2702         do i = 1, n1
    2703           if (RO1 > RO1_near(i)) then
    2704             RO1 = RO1_near(i)
    2705             j = n1_near(i)
    2706           end if
    2707         end do
    2708         RO2 = 10.d0
    2709         do i = 1, n2
    2710           if (RO2 > RO2_near(i)) then
    2711             RO2 = RO2_near(i)
    2712             k = n2_near(i)
    2713           end if
    2714         end do
    2715         if (RO1 < RO2) then
    2716 !
    2717 !  There is an oxygen near to both O1 and O2.  Use the O1-O and O2-O di
 stances
    2718 !  in deciding where to put the hydrogen atom.
    2719 !
    2720            Rab = 4.1d0
    2721         else
    2722            Rab = 0.5d0
    2723         end if
    2724       end if
    2725     end if
    2726     return
    2727   end subroutine find_polar_atom
 
