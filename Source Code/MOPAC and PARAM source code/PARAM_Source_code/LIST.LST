       1   module Parameters_for_INDO_C
       2     integer      :: isoki(80),nbfai(80)
       3     double precision :: zetai(80),zetadi(2,80),zetawti(2,80), &
       4                     zcoreai(80),betaai(3,80), fgi(24,80)
       5
       6 ! INDO parameter structure:
       7 ! isok      = 1 (full parameter set exists for element) or 0 (otherwise
 )
       8 ! nfba      = # basis functions on atom (corresponds to natorb)
       9 ! zcorea    = nuclear charge (corresponds to tore)
      10 !
      11 ! zeta      = sp Slater orbital exponent
      12 ! zetad(1)  =  d Slater orbital exponent 1 (d orbitals are a linear com
 bination
      13 !              of two Slater functions)
      14 ! zetad(2)  =  d Slater orbital exponent 2
      15 ! zetawt(1) =  d Slater orbital coefficient 1
      16 ! zetawt(2) =  d Slater orbital coefficient 2
      17 !
      18 ! betaa(1)  = Resonance integral for s orbitals
      19 ! betaa(2)  = Resonance integral for p orbitals
      20 ! betaa(3)  = Resonance integral for d orbitals
      21 !
      22 ! fg(1)     = s ioniz pot from d(n-2)s2 or from sp
      23 ! fg(2)     = s ioniz pot from d(n-1)s1
      24 ! fg(3)     = p ioniz pot from d(n-2)s2 or sp
      25 ! fg(4)     = p ioniz pot from d(n-1)s1
      26 ! fg(5)     = d ioniz pot from d(n-2)s2 or sp
      27 ! fg(6)     = d ioniz pot from d(n-1)s1
      28 ! fg(7)     = d ioniz pot from dns0
      29 ! fg(8)     = Probability of d(n-2)s2 or sp
      30 ! fg(9)     = Probability of d(n-1)s1
      31 ! fg(10)    = Probability of dns0
      32 !
      33 ! fg(11)    = F0(s,s) (=F0sp,F0pp) Slater-Condon one-center-two-electro
 n integral
      34 ! fg(12)    = F0(s,d)
      35 ! fg(13)    = F0(d,d)
      36 ! fg(14)    = G1(s,p) [Higher-order Slater-Condon factors]
      37 ! fg(15)    = F2(p,p)
      38 ! fg(16)    = G2(s,d)
      39 ! fg(17)    = G1(p,d)
      40 ! fg(18)    = F2(p,d)
      41 ! fg(19)    = G3(p,d)
      42 ! fg(20)    = F2(d,d)
      43 ! fg(21)    = F4(d,d)
      44 ! fg(22)    = R1(sppd)
      45 ! fg(23)    = R3(sddd)
      46 ! fg(24)    = R2(sdpp)
      47
      48 !
      49 !                    Data for Element   1
      50 !uu
      51       data        isoki(  1)/    1         /
      52       data        nbfai(  1)/    1         /
      53       data      zcoreai(  1)/    1.000000d0/
      54       data        zetai(  1)/    1.200000d0/
      55       data   betaai(  1,  1)/  -12.000000d0/
 
