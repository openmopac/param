     495               iout = 0
     496             end if
     497            end do
     498           end do
     499          end do
     500         end do
     501         write (iw, "(1x, a3, ' used = ', i6, ' maximum = ', i6, ' fract
 ion = ', f6.2)") &
     502           'ee2', ioutt, nxss, ioutt/float(nxss)
     503       end if
