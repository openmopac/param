    3129     subroutine dtrsl (t, ldt, n, b, job, info)
    3130       implicit none
    3131       integer, intent (in) :: ldt
    3132       double precision, dimension (ldt,*), intent (inout) :: t
    3133       integer, intent (in) :: n
    3134       double precision, dimension (*), intent (inout) :: b
    3135       integer, intent (in) :: job
    3136       integer, intent (inout) :: info
    3137       integer :: case, j, jj
    3138       double precision :: temp
    3139       external daxpy
    3140       double precision, external :: ddot
    3141     !
    3142     !
    3143     !     begin block permitting ...exits to 150
    3144     !
    3145     !        check for zero diagonal elements.
    3146     !
    3147       do info = 1, n
    3148        !     ......exit
    3149         if (t(info, info) == 0.0d0) return
    3150       end do
    3151       info = 0
    3152     !
    3153     !        determine the task and go to it.
    3154     !
    3155     case = 1
    3156       if (Mod(job, 10) /= 0) then
    3157       case = 2
    3158       end if
    3159       if (Mod(job, 100)/10 /= 0) then
    3160       case = case + 2
    3161       end if
    3162       select case (case)
    3163       case (2)
    3164        !
    3165        !        solve t*x=b for t upper triangular.
    3166        !
    3167         b(n) = b(n) / t(n, n)
    3168         if (n >= 2) then
    3169           do jj = 2, n
    3170             j = n - jj + 1
    3171             temp = -b(j+1)
    3172             call daxpy (j, temp, t(1, j+1), 1, b(1), 1)
    3173             b(j) = b(j) / t(j, j)
    3174           end do
    3175         end if
    3176       case (3)
    3177        !
    3178        !        solve trans(t)*x=b for t lower triangular.
    3179        !
    3180         b(n) = b(n) / t(n, n)
    3181         if (n >= 2) then
    3182           do jj = 2, n
    3183             j = n - jj + 1
    3184             b(j) = b(j) - ddot (jj-1, t(j+1, j), 1, b(j+1), 1)
 
 FORCHECK PC V13.5.13          DTRSL           2021-03-24 10:59:30   page:  2990
 lbfgs.F90  /FF
 
    3185             b(j) = b(j) / t(j, j)
    3186           end do
    3187         end if
    3188       case (4)
    3189        !
    3190        !        solve trans(t)*x=b for t upper triangular.
    3191        !
    3192         b(1) = b(1) / t(1, 1)
    3193         if (n >= 2) then
    3194           do j = 2, n
    3195             b(j) = b(j) - ddot (j-1, t(1, j), 1, b(1), 1)
    3196             b(j) = b(j) / t(j, j)
    3197           end do
    3198         end if
    3199       case default
    3200        !
    3201        !        solve t*x=b for t lower triangular
    3202        !
    3203         b(1) = b(1) / t(1, 1)
    3204         if (n >= 2) then
    3205           do j = 2, n
    3206             temp = -b(j-1)
    3207             call daxpy (n-j+1, temp, t(j, j-1), 1, b(j), 1)
    3208             b(j) = b(j) / t(j, j)
    3209           end do
    3210         end if
    3211       end select
    3212     end subroutine dtrsl
 
