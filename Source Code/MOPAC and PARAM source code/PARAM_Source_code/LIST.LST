       2     Subroutine eigenvectors_LAPACK(eigenvecs, xmat, eigvals, ndim)
       3       USE chanel_C, only : iw
       4
       5
       6
       7       implicit none
       8       Integer :: ndim
       9       double precision :: eigenvecs(ndim,ndim), &
      10                     & eigvals(ndim),xmat((ndim*(ndim+1))/2)
      11       integer :: i, j
      12       Integer :: lwork, liwork, info
      13       double precision,dimension(1:10) :: work_tmp
      14       Integer, dimension(1:10) :: iwork_tmp
      15       double precision, allocatable :: work(:)
      16       Integer, allocatable :: iwork(:)
      17 !======================================================================
 ========
      18 ! Code to find all eigenvectors and all eigenvalues for a symmetric Gen
 eral matrix
      19 ! using LAPACK and MAGMA
      20 ! Gerd Bruno Rocha and Julio Carvalho Maia 11/17/2013.
      21 !======================================================================
 ========
      22       continue
      23       eigvals = 0.d0
      24       eigenvecs = 0.d0
      25
      26 !
      27 ! Perturb secular determinant matrix to split exact degeneracies
      28 ! (This is to get around a bug in the diagonalizer that causes eigenvec
 tors to not be orthonormal)
      29 !
      30 !  The following unusual construction works.  Do NOT change it unless d
 egeneracy tests have been done,
      31 !  and the results are reproducible.
      32 !
      33       forall (i=1:ndim)
      34           xmat((i*(i + 1))/2) = xmat((i*(i + 1))/2) + i*1.d-10   ! Do N
 OT go much higher than 1.d-10, otherwise the geometry
      35       endforall                                              ! optimiza
 tion might go into an endless loop.
      36       call dtpttr( 'u', ndim, xmat, eigenvecs, ndim, i )
      37
      38
      39       if (i /= 0) stop 'error in dtpttr'
      40
      41       j = i ! Dummy - to make FORCHECK not complain about "j"
      42       i = j ! Dummy
      43       if (i == -999) return
      44       lwork = -1
      45       liwork = -1
      46
      47 ! GBR_new_addition
      48
      49
      50       call dsyevd('v','u',ndim,eigenvecs,ndim,eigvals,work_tmp, &
      51                     & lwork,iwork_tmp,liwork,info)
      52
 
 FORCHECK PC V13.5.13   EIGENVECTORS_LAPACK    2021-03-24 10:59:30   page:    76
 eigenvectors_LAPACK.F90  /FF
 
      53       lwork = int(work_tmp(1))
      54       liwork = iwork_tmp(1)
      55       allocate (work(lwork), iwork(liwork), stat = i)
      56 !      forall (j=1:lwork) work(j) = 0.d0
      57 !      forall (j=1:liwork) iwork(j) = 0
      58
      59
      60       call dsyevd('v','u',ndim,eigenvecs,ndim,eigvals,work, &
      61                                 & lwork,iwork,liwork,info)
      62
      63
      64       deallocate (iwork,work,stat = j)
      65       if (info /= 0)  write(iw,*) ' dsyevd Diagonalization error., CODE
  =',info
      66       continue
      67       return
      68     End subroutine eigenvectors_LAPACK
 
