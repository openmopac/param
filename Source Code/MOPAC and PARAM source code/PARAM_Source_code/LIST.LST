 ), rij
      44
      45 !         **** s - s, s - p, or p - p interactions ******
      46           f0(1, 1) = gamma1 (fg(mf0ss, ia), fg(mf0ss, ja), rij)
      47           gav = f0(1, 1)
      48           fracsi = 1.d0
      49           fracsj = 1.d0
      50           if (nbf(i) == 9) then
      51 !           **** i - j is d-sp interaction ****
 
 FORCHECK PC V13.5.13          REPLSN          2021-03-24 10:59:30   page:  1950
