    1002       use common_arrays_C, only : nat, p
    1003       use chanel_C, only : iw, imep
    1004       use elemts_C, only : elemnt
    1005 !*********************************************************************
    1006 !  SUBROUTINE MEPMAP CALCULATES THE MEP MINIMA AND GENERATES THE
    1007 !  CONROUR DATA IN A DEFINED PLANE.
    1008 !  REF.  G.P.FORD AND B. WANG J.COMPT.CHEM. 14(1993)1101.
    1009 !                                    WRITTEN BY BINGZE WANG, DEC 1992
    1010 !*********************************************************************
