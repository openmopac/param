     164             part1 = dg(1)*c1
 
 FORCHECK PC V13.5.13          ANALYT          2021-03-24 10:59:30   page:  3672
 analyt.F90  /FF
 
     165             part2 = -(g(1)*(del1/rij)*(alp(ni)*exp((-alp(ni)*rij))+alp(
 nj)*&
     166               exp((-alp(nj)*rij))))*abs(c1)
     167             part3 = dg(1)*(exp((-alp(ni)*rij))+exp((-alp(nj)*rij)))*abs
 (c1)
     168             dd = part1 + part2 + part3
     169 !
     170 !   THE GENERAL CASE
     171 !
     172           end if
     173           termnc = dd
     174 !
     175 !   ****   START OF THE AM1 SPECIFIC DERIVATIVE CODE   ***
     176 !
     177 !      ANALYT=-A*(1/(R*R)+2.D0*B*(R-C)/R)*EXP(-B*(R-C)**2)
     178 !
     179 !    ANALYTICAL DERIVATIVES
     180 !
     181         if (am1) then
     182           anam1 = 0.D0
     183           do ig = 1, 4
     184             if (abs(guess1(ni,ig)) > 0.D0) anam1 = anam1 + guess1(ni,ig
 )*(1.D0/(rij*&
     185               rij) + 2.D0*guess2(ni,ig)*(rij-guess3(ni,ig))/rij)*exp(ma
 x(-30.D0,(-guess2&
     186               (ni,ig)*(rij-guess3(ni,ig))**2)))
     187             if (abs(guess1(nj,ig)) <= 0.D0) cycle
     188             anam1 = anam1 + guess1(nj,ig)*(1.D0/(rij*rij) + 2.D0*guess2
 (nj,ig)*(rij-&
     189               guess3(nj,ig))/rij)*exp(max(-30.D0,(-guess2(nj,ig)*(rij-g
 uess3(nj,ig))**2)&
     190               ))
     191           end do
     192           anam1 = anam1*tore(ni)*tore(nj)
     193           termnc = termnc - anam1*del1/rij
     194         end if
     195 !
     196 !   ****   END OF THE AM1 SPECIFIC DERIVATIVE CODE   ***
     197 !
     198    50   continue
     199 !
     200 !   COMBINE TOGETHER THE OVERLAP DERIVATIVE PARTS
     201 !
     202           bi(1) = betas(ni)
     203           bi(2) = betap(ni)
     204           bi(3) = bi(2)
     205           bi(4) = bi(2)
     206           bj(1) = betas(nj)
     207           bj(2) = betap(nj)
     208           bj(3) = bj(2)
     209           bj(4) = bj(2)
     210         iol = 0
     211         do k = ia, id
     212           if (jd - ja + 1 > 0) then
     213             termk = bi(k-ia+1)
     214             termab = termab + sum((termk + bj(:jd-ja+1))*psum(ja+k*(k-1
 )/2:jd+k&
     215               *(k-1)/2)*ds(iol+1:jd-ja+1+iol))
     216             iol = jd - ja + 1 + iol
 
 FORCHECK PC V13.5.13          ANALYT          2021-03-24 10:59:30   page:  3673
 analyt.F90  /FF
 
     217           end if
     218         end do
     219 !
     220 !        FIRST, CORE-ELECTRON ATTRACTION DERIVATIVES (MNDO AND AM1)
     221 !
     222 !          ATOM CORE I AFFECTING A.O.S ON J
     223           isp = 0
     224           do m = ja, jd
     225             bb = 1.D0
     226             do n = m, jd
     227               mn = m + (n*(n - 1))/2
     228               isp = isp + 1
     229               termab = termab - bb*tore(ni)*psum(mn)*dr(isp)
     230               bb = 2.D0
     231             end do
     232           end do
     233 !          ATOM CORE J AFFECTING A.O.S ON I
     234           k = max(jd - ja + 1,1)
     235           k = (k*(k + 1))/2
     236           isp = (-k) + 1
     237           do m = ia, id
     238             bb = 1.D0
     239             do n = m, id
     240               mn = m + (n*(n - 1))/2
     241               isp = isp + k
     242               termab = termab - bb*tore(nj)*psum(mn)*dr(isp)
     243               bb = 2.D0
     244             end do
     245           end do
     246           isp = 0
     247 !
     248 !   NOW FOR COULOMB AND EXCHANGE TERMS (MNDO AND AM1)
     249 !
     250           do k = ia, id
     251             aa = 1.D0
     252             kk = (k*(k - 1))/2
     253             do l = k, id
     254               ll = (l*(l - 1))/2
     255               do m = ja, jd
     256                 bb = 1.D0
     257                 do n = m, jd
     258                   isp = isp + 1
     259                   kl = k + ll
     260                   mn = m + (n*(n - 1))/2
     261 !
     262 !    COULOMB TERM
     263 !
     264                   termaa = termaa + aa*bb*psum(kl)*psum(mn)*dr(isp)
     265                   mk = m + kk
     266                   nk = n + kk
     267                   ml = m + ll
     268                   nl = n + ll
     269 !
     270 !    EXCHANGE TERM
     271 !
     272                   termaa = termaa - 0.5D0*aa*bb*(palpha(mk)*palpha(nl)+
 palpha(&
     273                     nk)*palpha(ml)+pbeta(mk)*pbeta(nl)+pbeta(nk)*pbeta(
 ml))*dr(&
 
 FORCHECK PC V13.5.13          ANALYT          2021-03-24 10:59:30   page:  3674
 analyt.F90  /FF
 
     274                     isp)
     275                   bb = 2.D0
     276                 end do
     277               end do
     278               aa = 2.D0
     279             end do
     280           end do
     281         eaa(ix) = eaa(ix) + termaa
     282         eab(ix) = eab(ix) + termab
     283         enuc(ix) = enuc(ix) + termnc
     284       end do
     285       eng = eaa + eab + enuc
     286       eng = -eng*fpc_9
     287       return
     288       end subroutine analyt
 
