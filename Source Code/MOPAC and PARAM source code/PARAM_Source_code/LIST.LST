     501   subroutine Cpt_SecondOrderMatrix( N_qm, Id_qm, Crd_qm, Q_qm, Eta, dEt
 adQa, dEtadQb )
     502     use YGXX_SimpleGaussianInts, only : GGJPP_IntQ
     503     USE parameters_C, only : CPE_Z0, CPE_B
     504     implicit none
     505     integer, intent(in) :: N_qm          ! Number of qm atoms
