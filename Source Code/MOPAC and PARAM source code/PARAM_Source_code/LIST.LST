    2320       subroutine ffreq1(f, ptot, pa, pb, ndim)
    2321 !-----------------------------------------------
    2322 !   M o d u l e s
    2323 !-----------------------------------------------
    2324       USE parameters_C, only : gss, gsp, gpp, gp2, hsp
    2325       use common_arrays_C, only : nat, nfirst, nlast
    2326       use molkst_C, only : numat
    2327 !**********************************************************************
 *
    2328       implicit none
    2329 !-----------------------------------------------
    2330 !   G l o b a l   P a r a m e t e r s
    2331 !-----------------------------------------------
    2332 !-----------------------------------------------
    2333 !   D u m m y   A r g u m e n t s
    2334 !-----------------------------------------------
    2335       integer , intent(in) :: ndim
    2336       double precision , intent(inout) :: f(ndim,ndim)
    2337       double precision , intent(in) :: ptot(ndim,ndim)
    2338       double precision , intent(in) :: pa(ndim,ndim)
    2339       double precision , intent(in) :: pb(ndim,ndim)
    2340 !-----------------------------------------------
    2341 !   L o c a l   V a r i a b l e s
    2342 !-----------------------------------------------
    2343       integer :: ii, ia, ib, ni, iplus, j, iminus, icc
    2344       double precision :: ptpop, papop
    2345       logical :: first
    2346
    2347       save first
    2348 !-----------------------------------------------
    2349 ! *********************************************************************
    2350 !
    2351 ! *** COMPUTE THE REMAINING CONTRIBUTIONS TO THE ONE-CENTRE ELEMENTS.
    2352 !
    2353 ! *********************************************************************
    2354       data first/ .TRUE./
    2355       if (first) first = .FALSE.
    2356       do ii = 1, numat
    2357         ia = nfirst(ii)
    2358         ib = min(nlast(ii), ia + 3)
    2359         ni = nat(ii)
    2360         ptpop = 0.D0
    2361         papop = 0.D0
    2362         go to (1002,20,10,10,10,10,10,10,10,10) ib - ia + 2
    2363    10   continue
    2364         ptpop = ptot(ib,ib) + ptot(ib-1,ib-1) + ptot(ib-2,ib-2)
    2365         papop = pa(ib,ib) + pa(ib-1,ib-1) + pa(ib-2,ib-2)
    2366    20   continue
    2367 !
    2368 !     F(S,S)
    2369 !
    2370         f(ia,ia) = f(ia,ia) + pb(ia,ia)*gss(ni) + ptpop*gsp(ni) - papop
 *hsp(ni)
    2371         if (ni >= 3) then
    2372           iplus = ia + 1
    2373           do j = iplus, ib
    2374 !
    2375 !     F(P,P)
 
 FORCHECK PC V13.5.13          FFREQ1          2021-03-24 10:59:30   page:  2635
 polar.F90  /FF
 
    2376 !
    2377             f(j,j) = f(j,j) + ptot(ia,ia)*gsp(ni) - pa(ia,ia)*hsp(ni) +
  pb(j,j)&
    2378               *gpp(ni) + (ptpop - ptot(j,j))*gp2(ni) - 0.5D0*(papop - p
 a(j,j))*&
    2379               (gpp(ni)-gp2(ni))
    2380 !
    2381 !     F(S,P)
    2382 !
    2383             f(ia,j) = f(ia,j) + 2.D0*ptot(ia,j)*hsp(ni) - pa(ia,j)*(hsp
 (ni)+gsp&
    2384               (ni))
    2385             f(j,ia) = f(j,ia) + 2.D0*ptot(j,ia)*hsp(ni) - pa(j,ia)*(hsp
 (ni)+gsp&
    2386               (ni))
    2387           end do
    2388 !
    2389 !     F(P,P*)
    2390 !
    2391           iminus = ib - 1
    2392           do j = iplus, iminus
    2393             icc = j + 1
    2394             f(j,icc:ib) = f(j,icc:ib) + ptot(j,icc:ib)*(gpp(ni)-gp2(ni)
 ) - &
    2395               0.5D0*pa(j,icc:ib)*(gpp(ni)+gp2(ni))
    2396             f(icc:ib,j) = f(icc:ib,j) + ptot(icc:ib,j)*(gpp(ni)-gp2(ni)
 ) - &
    2397               0.5D0*pa(icc:ib,j)*(gpp(ni)+gp2(ni))
    2398           end do
    2399         end if
