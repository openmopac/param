       1       subroutine mat33(a, b, c)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5 !  A subroutine that will multiply two 3 by 3 matricies in the followin
 g
       6 !     fashion:    C = A(transpose) B A
       7 !
       8       implicit none
       9 !-----------------------------------------------
      10 !   D u m m y   A r g u m e n t s
      11 !-----------------------------------------------
      12       double precision , intent(in) :: a(9)
      13       double precision , intent(in) :: b(9)
      14       double precision , intent(out) :: c(9)
      15 !-----------------------------------------------
      16 !   L o c a l   V a r i a b l e s
      17 !-----------------------------------------------
      18       double precision, dimension(9) :: t
      19 !-----------------------------------------------
      20 !
      21 !
      22       t(1) = b(1)*a(1) + b(2)*a(4) + b(3)*a(7)
      23       t(2) = b(1)*a(2) + b(2)*a(5) + b(3)*a(8)
      24       t(3) = b(1)*a(3) + b(2)*a(6) + b(3)*a(9)
      25       t(4) = b(4)*a(1) + b(5)*a(4) + b(6)*a(7)
      26       t(5) = b(4)*a(2) + b(5)*a(5) + b(6)*a(8)
      27       t(6) = b(4)*a(3) + b(5)*a(6) + b(6)*a(9)
      28       t(7) = b(7)*a(1) + b(8)*a(4) + b(9)*a(7)
      29       t(8) = b(7)*a(2) + b(8)*a(5) + b(9)*a(8)
      30       t(9) = b(7)*a(3) + b(8)*a(6) + b(9)*a(9)
      31 !
      32       c(1) = a(1)*t(1) + a(4)*t(4) + a(7)*t(7)
      33       c(2) = a(1)*t(2) + a(4)*t(5) + a(7)*t(8)
      34       c(3) = a(1)*t(3) + a(4)*t(6) + a(7)*t(9)
      35       c(4) = a(2)*t(1) + a(5)*t(4) + a(8)*t(7)
      36       c(5) = a(2)*t(2) + a(5)*t(5) + a(8)*t(8)
      37       c(6) = a(2)*t(3) + a(5)*t(6) + a(8)*t(9)
      38       c(7) = a(3)*t(1) + a(6)*t(4) + a(9)*t(7)
      39       c(8) = a(3)*t(2) + a(6)*t(5) + a(9)*t(8)
      40       c(9) = a(3)*t(3) + a(6)*t(6) + a(9)*t(9)
      41 !
      42       return
      43       end subroutine mat33
 
