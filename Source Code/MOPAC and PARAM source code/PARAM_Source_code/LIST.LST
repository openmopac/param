     796   subroutine get_pars(stresses, gradients, relscf, cutoff, nloop)
     797 !
     798 !  Used for calibrating quantities
     799 !
     800   use molkst_C, only : line
     801   implicit none
     802   double precision :: stresses(20), gradients(20), relscf(20), cutoff(2
 0)
     803   integer :: nloop, io_stat
     804 !
     805 !  Local
     806 !
     807     read(33,'(a)')line
     808     nloop = 0
     809     do
     810       read(33,'(a)', iostat = io_stat) line
     811       nloop = nloop + 1
     812       if (io_stat /= 0) exit
     813       read(line,*, iostat = io_stat)stresses(nloop), gradients(nloop),
 relscf(nloop), cutoff(nloop)
     814       if (io_stat /= 0) exit
     815     end do
     816     nloop = nloop - 1
     817     close (33)
     818     return
     819   end subroutine get_pars
 
