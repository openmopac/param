     481 !     *****************************************************************
 ********
     482
     483       subroutine swaap (xz, ef, op, jrels, i, j, na)
     484
     485       implicit none
     486       integer           i, j, k, na, &
     487                         itmp, jrels(na, 7)
     488       double precision  xz(na, 3), ef(3), tmp
     489       logical           op(7), op1
     490
     491 !     **** interchanges coordinate axes i and j ****
     492
     493       op1 = op(4-i)
     494       op(4-i) = op(4-j)
     495       op(4-j) = op1
     496       op1 = op(8-i)
     497       op(8-i) = op(8-j)
     498       op(8-j) = op1
     499
     500       tmp = ef(i)
     501       ef(i) = ef(j)
     502       ef(j) = tmp
     503
     504       do k = 1, na
     505         tmp = xz(k, i)
     506         xz(k, i) = xz(k, j)
     507         xz(k, j) = tmp
     508
     509         itmp = jrels(k, 4-i)
     510         jrels(k, 4-i) = jrels(k, 4-j)
     511         jrels(k, 4-j) = itmp
     512         itmp = jrels(k, 8-i)
     513         jrels(k, 8-i) = jrels(k, 8-j)
     514         jrels(k, 8-j) = itmp
     515       end do
     516
     517       return
     518       end subroutine swaap
 
