    1026               end do
    1027             end do
    1028
    1029             dists = phinet(ips, 1) ** 2 + &
    1030                  & phinet(ips, 2) ** 2 + &
    1031                  & phinet(ips, 3) ** 2
    1032
    1033             dists = Max (dists, 1.d-20)
    1034             dist = 1.d0 / Sqrt (dists)
    1035             cosurf(1, ips) = phinet(ips, 1) * dist
    1036             cosurf(2, ips) = phinet(ips, 2) * dist
    1037             cosurf(3, ips) = phinet(ips, 3) * dist
    1038             if (ips >= nps) exit
    1039           end do loop1
    1040
    1041           if (niter >= 2) exit
    1042         end do
    1043         !
    1044         !        NOW ALL SEGMENTS ARE FINALLY DEFINED AND THE ASSOCIATE
 D
    1045         !        BASIC GRID POINTS ARE CLOSE-PACKED
    1046         !
    1047         do ips = nps0, nps
    1048           nsetf(ips) = inset
    1049           inset = inset + nar_loc(ips)
    1050           nar_loc(ips) = 0
    1051           cosurf(4, ips) = 0.d0
    1052           cosurf(1, ips) = cosurf(1, ips) * ri + xa(1)
    1053           cOsurf(2, ips) = cosurf(2, ips) * ri + xa(2)
    1054           cosurf(3, ips) = cosurf(3, ips) * ri + xa(3)
    1055         end do
    1056
    1057         do j = 1, 1082
    1058           if (din(j)) then
    1059             ipm = iseg(j)
    1060             nara = nar_loc(ipm)
    1061             nset(nsetf(ipm)+nara) = j
    1062             nar_loc(ipm) = nara + 1
    1063             cosurf(4, ipm) = cosurf(4, ipm) + dirvec(4, j) * ri2
    1064           end if
