       1 ! calculate dC6/dr analytically
       2       subroutine anagrdc6(max_elem, maxc, n, cn, dcn2, dcn3, nat, c6ab,
  mxc, iat, jat, kat, anag)
       3       implicit   none
       4       double precision :: k3
       5       parameter (k3 = -4.d0)
       6       integer :: n, nat(*), max_elem, maxc, iat, jat, kat, mxc(max_elem
 )
       7       double precision :: cn(*), dcn2(3, n), anag(3)
       8       double precision :: c6ab(max_elem, max_elem, maxc, maxc, 3)
       9       double precision :: term1, term2, term3, term4
      10       double precision :: dterm2(3), dterm3(3), dcn3(3, n, n)
      11       double precision :: zaehler, nenner, dzaehler(3), dnenner(3)
      12       integer :: i, j, k
      13       if (iat.eq.kat) then
      14         dterm2 = dcn2(:,iat)
      15         dterm3 = dcn3(:,iat,jat)
      16       else
      17         dterm2 = dcn3(:,kat,iat)
      18         dterm3 = dcn3(:,kat,jat)
      19       end if
      20       zaehler = 0.0d0
      21       nenner = 0.0d0
      22       dzaehler = 0.0d0
      23       dnenner = 0.0d0
      24       do i = 1, mxc(nat(iat))
      25         do j = 1, mxc(nat(jat))
      26           term3 = c6ab(nat(iat), nat(jat), i, j, 3) - cn(jat)
      27           term2 = c6ab(nat(iat), nat(jat), i, j, 2) - cn(iat)
      28           term1 = exp(k3*(term2*term2 + term3*term3))
      29           zaehler = zaehler + c6ab(nat(iat), nat(jat), i, j, 1)*term1
      30           nenner = nenner + term1
      31           term4 = term1*k3*2.0d0
      32           do k = 1, 3
      33             dzaehler(k) = dzaehler(k) + c6ab(nat(iat), nat(jat), i, j,
 1)*term4*(term2*dterm2(k) + term3*dterm3(k))
      34              dnenner(k) = dnenner(k) + term4*(term2*dterm2(k) + term3*d
 term3(k))
      35           end do
      36         end do
      37       end do
      38       if (nenner.gt.0) then
      39         term4 = 1.0d0/(nenner*nenner)
      40         do k = 1, 3
      41            anag(k) = (dzaehler(k)*nenner-dnenner(k)*zaehler)*term4
      42         end do
      43       else
      44         anag = 0.0d0
      45       end if
      46       end subroutine anagrdc6
 
