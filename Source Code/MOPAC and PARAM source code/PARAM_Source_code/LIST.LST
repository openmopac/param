     613       subroutine fractional_metal_ion
     614       use parameters_C, only : tore, zs, zp, gss, gpp, gp2, gsp, hsp, &
     615       betas, betap, upp, alp
     616       integer :: i
     617 !
     618 !  Pseudo - halide metal ion with core charge of -1/2 - for use with
     619 !  transition metal ions only
     620     tore(85) = -0.5d0
     621 !
     622 !  Pseudo - alkali metal ion with core charge of 1/2 - for use with
     623 !  transition metal ions only
     624       tore(87) = 0.5d0
     625       do i = 85, 87, 2
     626         upp(i) = 0.d0
     627         alp(i) = 3.0d0
     628         zs(i) = 0.d0
     629         zp(i) = 0.d0
     630         betas(i) = 0.d0
     631         betap(i) = 0.d0
     632         gss(i) = 10.d0
     633         gsp(i) =0.d0
     634         gpp(i) = 0.d0
     635         gp2(i) = 0.d0
     636         hsp(i) = 0.d0
     637       end do
     638       end subroutine fractional_metal_ion
 
