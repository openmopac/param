       1 subroutine MOZYME_eigs (nocc)
       2    !*******************************************************************
 ***
       3    !
       4    !  f:      FOCK MATRIX OVER ATOMIC ORBITALS
       5    !  VECTOR:   EIGENVECTORS OF M.O.S
       6    !  FILLED:   OCCUPIED M.O.S
       7    !  eigs:     EIGENVALUES OF OCCUPIED M.O.S
       8    !  NOCC:     NUMBER OF OCCUPIED M.O.S
       9    !  EIG:      ALL THE EIGENVALUES
      10    !  N:        NUMBER OF M.O.S = NUMBER OF A.O.S*
      11    !
      12    !*******************************************************************
 ***
      13    !
      14    !  ALL OCCUPIED LMO ENERGY LEVELS ARE CALCULATED.
      15    !
      16    !*******************************************************************
 ***
      17    !
      18     use molkst_C, only: norbs
      19     use MOZYME_C, only : icocc_dim, &
      20        lijbo, nijbo, &
      21        ijc, ncf, nncf, ncocc, &
      22      & iorbs, icocc, cocc
      23     use common_arrays_C, only : eigs, nfirst, nlast, p, f
      24     implicit none
      25     integer, intent (in) :: nocc
      26     integer :: i, i4, ii, j, j1, j4, &
      27          & jl, jx, k, k1, kk, kl, l, loopi, loopj, k1j1
      28     double precision, allocatable :: avir(:), aocc(:)
      29     double precision :: cutoff, sum, sum1
      30     integer, external :: ijbo
      31     allocate (avir(norbs), aocc(icocc_dim))
      32     !
      33     !
      34     aocc(:) = 0.d0
      35
      36     do j = 1, nocc
      37         loopj = ncocc(j)
      38         kl = 0
      39         do kk = nncf(j) + 1, nncf(j) + ncf(j)
      40           k1 = icocc(kk)
      41           sum = 0.d0
      42           do k = nfirst(k1), nlast(k1)
      43             kl = kl + 1
      44             sum = sum + cocc(kl+loopj) ** 2
      45           end do
      46           !
      47           !   AOCC(KK) HOLDS THE SQUARE OF THE CONTRIBUTION OF THE KK'T
 H ATOM
      48           !   IN THE OCCUPIED SET.  NOTE:  THIS IS NOT ATOM KK.
      49           !
      50           aocc(kk) = sum
      51           !
      52         end do
      53       !
      54     end do
 
 FORCHECK PC V13.5.13       MOZYME_EIGS        2021-03-24 10:59:30   page:  3383
 MOZYME_eigs.F90  /FF
 
      55     cutoff = 1.d-8
      56     ijc = 0
      57 !
      58 !  EVALUATE THE OCCUPIED ENERGY LEVELS
      59 !
      60 !
      61       do i = 1, nocc
      62         loopi = ncocc(i)
      63           l = 0
      64           do j = nncf(i) + 1, nncf(i) + ncf(i)
      65             j1 = icocc(j)
      66             sum = 0.d0
      67             do k = l + 1, l + iorbs(j1)
      68               sum = sum + cocc(k+loopi) ** 2
      69             end do
      70             l = l + iorbs(j1)
      71             !
      72             !   AOCC(KK) HOLDS THE SQUARE OF THE CONTRIBUTION OF THE KK
 'TH ATOM
      73             !   IN THE OCCUPIED SET.  NOTE:  THIS IS NOT ATOM KK.
      74             !
      75             !   AVIR(J1) HOLDS THE SQUARE OF THE CONTRIBUTION OF ATOM J
 1
      76             !   IN THE OCCUPIED SET.  NOTE:  THIS IS NOT THE J1'th ATOM
 .
      77             !
      78             avir(j1) = sum
      79             !
      80             !   AOCC(KK) HOLDS THE SQUARE OF THE CONTRIBUTION OF THE KK
 'TH ATOM
      81             !   IN THE OCCUPIED SET.  NOTE:  THIS IS NOT ATOM KK.
      82             !
      83             !   AVIR(J1) HOLDS THE SQUARE OF THE CONTRIBUTION OF ATOM J
 1
      84             !   IN THE OCCUPIED SET.  NOTE:  THIS IS NOT THE J1'th ATOM
 .
      85             !
      86           end do
      87           sum = 0.d0
      88           jl = loopi
      89           !
      90           if (lijbo) then
      91             do j = nncf(i) + 1, nncf(i) + ncf(i)
      92               j1 = icocc(j)
      93               kl = loopi
      94               do k = nncf(i) + 1, nncf(i) + ncf(i)
      95                 k1 = icocc(k)
      96                 k1j1 = nijbo(k1, j1)
      97                 if (k1j1 >= 0) then
      98                   if (avir(k1)*p(k1j1+1)*aocc(k) >= cutoff) then
      99                     !
     100                     !  EXTRACT THE ATOM-ATOM INTERSECTION OF f
     101                     !
     102                     if (k1 > j1) then
     103                       !
     104                       !   LOWER TRIANGLE
     105                       !
     106                       do jx = 1, iorbs(j1)
     107                         sum1 = 0.d0
 
 FORCHECK PC V13.5.13       MOZYME_EIGS        2021-03-24 10:59:30   page:  3384
 MOZYME_eigs.F90  /FF
 
     108                         do i4 = 1, iorbs(k1)
     109                           ii = k1j1 + (i4-1) * iorbs(j1) + jx
     110                           sum1 = sum1 + f(ii) * cocc(kl+i4)
     111                         end do
     112                         sum = sum + cocc(jl+jx) * sum1
     113                       end do
     114                     else if (k1 < j1) then
     115                       !
     116                       !   UPPER TRIANGLE
     117                       !
     118                       do jx = 1, iorbs(j1)
     119                         sum1 = 0.d0
     120                         do i4 = 1, iorbs(k1)
     121                           ii = k1j1 + (jx-1) * iorbs(k1) + i4
     122                           sum1 = sum1 + f(ii) * cocc(kl+i4)
     123                         end do
     124                         sum = sum + cocc(jl+jx) * sum1
     125                       end do
     126                     else
     127                       !
     128                       !   DIAGONAL TERM
     129                       !
     130                       do jx = 1, iorbs(j1)
     131                         sum1 = 0.d0
     132                         do j4 = 1, jx
     133                           ii = k1j1 + (jx*(jx-1)) / 2 + j4
     134                           sum1 = sum1 + f(ii) * cocc(kl+j4)
     135                         end do
     136                         ii = k1j1 + (jx*(jx+1)) / 2
     137                         do i4 = jx + 1, iorbs(k1)
     138                           ii = k1j1 + (i4*(i4-1)) / 2 + jx
     139                           sum1 = sum1 + f(ii) * cocc(kl+i4)
     140                         end do
     141                         sum = sum + cocc(jl+jx) * sum1
     142                       end do
     143                     end if
     144                   end if
     145                 end if
     146                 kl = kl + iorbs(k1)
     147               end do
     148               !
     149               jl = jl + iorbs(j1)
     150             end do
     151           else
     152             do j = nncf(i) + 1, nncf(i) + ncf(i)
     153               j1 = icocc(j)
     154               kl = loopi
     155               do k = nncf(i) + 1, nncf(i) + ncf(i)
     156                 k1 = icocc(k)
     157                 k1j1 = ijbo (k1, j1)
     158                 if (k1j1 >= 0) then
     159                   if (avir(k1)*p(k1j1+1)*aocc(k) >= cutoff) then
     160                     !
     161                     !  EXTRACT THE ATOM-ATOM INTERSECTION OF f
     162                     !
     163                     if (k1 > j1) then
     164                       !
     165                       !   LOWER TRIANGLE
     166                       !
 
 FORCHECK PC V13.5.13       MOZYME_EIGS        2021-03-24 10:59:30   page:  3385
 MOZYME_eigs.F90  /FF
 
     167                       do jx = 1, iorbs(j1)
     168                         sum1 = 0.d0
     169                         do i4 = 1, iorbs(k1)
     170                           ii = k1j1 + (i4-1) * iorbs(j1) + jx
     171                           sum1 = sum1 + f(ii) * cocc(kl+i4)
     172                         end do
     173                         sum = sum + cocc(jl+jx) * sum1
     174                       end do
     175                     else if (k1 < j1) then
     176                       !
     177                       !   UPPER TRIANGLE
     178                       !
     179                       do jx = 1, iorbs(j1)
     180                         sum1 = 0.d0
     181                         do i4 = 1, iorbs(k1)
     182                           ii = k1j1 + (jx-1) * iorbs(k1) + i4
     183                           sum1 = sum1 + f(ii) * cocc(kl+i4)
     184                         end do
     185                         sum = sum + cocc(jl+jx) * sum1
     186                       end do
     187                     else
     188                       !
     189                       !   DIAGONAL TERM
     190                       !
     191                       do jx = 1, iorbs(j1)
     192                         sum1 = 0.d0
     193                         do j4 = 1, jx
     194                           ii = k1j1 + (jx*(jx-1)) / 2 + j4
     195                           sum1 = sum1 + f(ii) * cocc(kl+j4)
     196                         end do
     197                         ii = k1j1 + (jx*(jx+1)) / 2
     198                         do i4 = jx + 1, iorbs(k1)
     199                           ii = k1j1 + (i4*(i4-1)) / 2 + jx
     200                           sum1 = sum1 + f(ii) * cocc(kl+i4)
     201                         end do
     202                         sum = sum + cocc(jl+jx) * sum1
     203                       end do
     204                     end if
     205                   end if
     206                 end if
     207                 kl = kl + iorbs(k1)
     208               end do
     209               !
     210               jl = jl + iorbs(j1)
     211             end do
     212           end if
     213           !
     214           eigs(i) = sum
     215           !
     216       end do
     217
     218 end subroutine MOZYME_eigs
 
