       1       subroutine symoir(itype, vects, eigs, nvecs, r, imat)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE symmetry_C, ONLY: jndex, namo, nirred, nclass, name, jx, grou
 p
       6       USE meci_C, only : lab
       7       use molkst_C, only : keywrd, numat
       8       use chanel_C, only : iw
       9 !**********************************************************************
 *
      10 !-----------------------------------------------
      11 !   I n t e r f a c e   B l o c k s
      12 !-----------------------------------------------
      13       implicit none
      14 !-----------------------------------------------
      15 !   G l o b a l   P a r a m e t e r s
      16 !-----------------------------------------------
      17 !-----------------------------------------------
      18 !   D u m m y   A r g u m e n t s
      19 !-----------------------------------------------
      20       integer , intent(in) :: itype
      21       integer  :: nvecs
      22       integer , intent(in) :: imat
      23       double precision  :: vects(nvecs,*)
      24       double precision , intent(in) :: eigs(*)
      25       double precision  :: r(3,3)
      26       double precision  :: carmat(imat,20)
      27 !-----------------------------------------------
      28 !   L o c a l   V a r i a b l e s
      29 !-----------------------------------------------
      30       integer , dimension(20) :: icount
      31       integer , dimension(nvecs) :: ntype
      32       integer :: korb, i, jj, j, nfind, ifound, l, ik, k
      33       double precision, dimension(20) :: tchar
      34       double precision :: toler, check
      35       logical :: first, r3, debug
      36       character :: names*4
      37       double precision, external :: charmo, charst, charvi
      38
      39       save toler
      40 !-----------------------------------------------
      41 !**********************************************************************
 *
      42 !
      43 !    Calculates the Irreducible Representation of an eigenvector.
      44 !
      45 !    GROUP(i,j) is the Character of Irreducible Representation i in
      46 !    Class j.
      47 !
      48 !     On input  NVECS  = No. of vectors to be assigned.
      49 !               VECTS  = Eigenvectors, packed
      50 !
      51 !     On output ICOUNT = No. of I.R.s of each type.
      52 !               NAMO   = Irreducible Representation as a 4 character
      53 !                        string.
      54 !
      55 !
 
 FORCHECK PC V13.5.13          SYMOIR          2021-03-24 10:59:30   page:  3321
 symoir.F90  /FF
 
      56 !**********************************************************************
 *
      57       data toler/ 0.1D0/
      58 !
      59 !
      60 !  ICOUNT will hold the number of occurances of each Irreducible
      61 !         Representation
      62 !
      63       r3 = name == 'R3'
      64       korb = 0
