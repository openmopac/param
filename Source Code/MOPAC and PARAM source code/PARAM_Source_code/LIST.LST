       1       subroutine matout(a, b, nc, nr, ndim)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use molkst_C, only : numat, method_indo
       6       use common_arrays_C, only : nfirst, nlast, nat
       7       use chanel_C, only : iw
       8       use elemts_C, only : elemnt
       9 !**********************************************************************
 *
      10       implicit none
      11 !-----------------------------------------------
      12 !   G l o b a l   P a r a m e t e r s
      13 !-----------------------------------------------
      14 !-----------------------------------------------
      15 !   D u m m y   A r g u m e n t s
      16 !-----------------------------------------------
      17       integer , intent(in) :: nc
      18       integer , intent(inout) :: nr
      19       integer , intent(in) :: ndim
      20       double precision , intent(in) :: a(ndim,ndim)
      21       double precision , intent(in) :: b(ndim)
      22 !-----------------------------------------------
      23 !   L o c a l   P a r a m e t e r s
      24 !-----------------------------------------------
      25 !-----------------------------------------------
      26 !   L o c a l   V a r i a b l e s
      27 !-----------------------------------------------
      28       integer , dimension(:), allocatable :: natom
      29       integer :: i, jlo, jhi, l, j, ka, kc, kb, la, lc, lb
      30       character :: ref_atorbs(9,2)*2, atorbs(9)*2
      31       character, dimension(:), allocatable :: itext*2, jtext*2
      32
      33       save atorbs
      34 !-----------------------------------------------
      35 !**********************************************************************
      36 !
      37 !      MATOUT PRINTS A SQUARE MATRIX OF EIGENVECTORS AND EIGENVALUES
      38 !
      39 !    ON INPUT A CONTAINS THE MATRIX TO BE PRINTED.
      40 !             B CONTAINS THE EIGENVALUES.
      41 !             NC NUMBER OF MOLECULAR ORBITALS TO BE PRINTED.
      42 !             NR IS THE SIZE OF THE SQUARE ARRAY TO BE PRINTED.
      43 !             NDIM IS THE ACTUAL SIZE OF THE SQUARE ARRAY "A".
      44 !             NFIRST AND NLAST CONTAIN ATOM ORBITAL COUNTERS.
      45 !             NAT = ARRAY OF ATOMIC NUMBERS OF ATOMS.
      46 !
      47 !
      48 !**********************************************************************
 *
      49       data ref_atorbs/ ' S', 'PX', 'PY', 'PZ', 'X2', 'XZ', 'Z2', 'YZ',
 'XY', &
      50                        ' S', 'PX', 'PY', 'PZ', 'Z2', 'X2', 'XY', 'XZ',
 'YZ'/
      51       if (method_indo) then
      52         atorbs(:) = ref_atorbs(:,2)
      53       else
      54         atorbs(:) = ref_atorbs(:,1)
 
 FORCHECK PC V13.5.13          MATOUT          2021-03-24 10:59:30   page:  3640
 matout.F90  /FF
 
      55       end if
      56       i = max(ndim, 1)
      57       allocate (itext(i), jtext(i), natom(i))
      58       if (nlast(numat) /= nr) go to 30
      59       do i = 1, numat
      60         jlo = nfirst(i)
      61         jhi = nlast(i)
      62         l = nat(i)
      63         itext(jlo:jhi) = atorbs(:jhi-jlo+1)
      64         jtext(jlo:jhi) = elemnt(l)
      65         natom(jlo:jhi) = i
      66       end do
      67       go to 50
      68    30 continue
      69       nr = abs(nr)
      70       do i = 1, nr
      71         itext(i) = '  '
      72         jtext(i) = '  '
      73         natom(i) = i
      74       end do
      75    50 continue
      76       ka = 1
      77       kc = 6
      78    60 continue
      79       kb = min0(kc,nc)
      80       write (iw, 100) (i,i=ka,kb)
      81       if (b(1) /= 0.D0) write (iw, 110) (b(i),i=ka,kb)
      82       write (iw, 120)
      83       la = 1
      84       lc = 40
      85    70 continue
      86       lb = min0(lc,nr)
      87       do i = la, lb
      88         if (itext(i) == ' S') write (iw, 120)
      89         write (iw, 130) itext(i), jtext(i), natom(i), (a(i,j),j=ka,kb)
      90       end do
      91       if (lb == nr) go to 90
      92       la = lc + 1
      93       lc = lc + 40
      94       go to 70
      95    90 continue
      96       if (kb == nc) return
      97       ka = kc + 1
      98       kc = kc + 6
      99       go to 60
     100 !
     101   100 format(/,/,/,/,3x,' ROOT NO.',i5,9i12)
     102   110 format(/,8x,10f12.5)
     103   120 format('  ')
     104   130 format(2(1x,a2),i4,f10.5,10f12.5)
     105 !
     106       end subroutine matout
 
