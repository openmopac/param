       1 subroutine write_trajectory(xyz, escf, ekin, rc_dipo, time, xtot, l_dip
 ole)
       2 !
       3 ! Write a single point in a trajectory to a file of type <file>.xyz or
 <file>.pdb
       4 !
       5 !  If the type is <file>.xyz then the single point consists of:
       6 !
       7 !  A line containing the number of atoms in the system.
       8 !  A line containing the text "Profile." followed by the model number,
  some more text ending in the character "="
       9 !    and a real datum, either the heat of formation or the dipole momen
 t.
      10 !    The geometry in Cartesian coordinates
      11 !
      12 !  Example of a single point in such a file (6 lines):
      13 !     4
      14 !Profile.   2 HEAT OF FORMATION =    -0.467 KCAL =    -1.955 KJ
      15 !    N        0.00000        0.00000       -0.00092
      16 !    H        0.97231        0.00000        0.00427
      17 !    H       -0.48616        0.84205        0.00427
      18 !    H       -0.48616       -0.84205        0.00427
      19 !
      20 !  If the type if <file>.pdb then the single point consists of:
      21 !
      22 !  A line containing the text "MODEL" followed by the model number.
      23 !  A PDB file giving a header line, the geometry, and an "END" line
      24 !  A A line containing the text "ENDMDL"
      25 !
      26 !  Example of a single point in such a file (8 lines)
      27 !MODEL      2
      28 !HEADER Heat of Formation =       2.677 Kcal/mol
      29 !HETATM    1  N   NH3 A   1       0.000   0.000   0.000  1.00 -0.83
   PROT N
      30 !HETATM    2 1H   NH3 A   1       0.920   0.000   0.000  1.00  0.28
   PROT H
