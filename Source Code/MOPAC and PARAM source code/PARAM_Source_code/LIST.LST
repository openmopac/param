      55 subroutine addhcr
      56     use molkst_C, only : lm61
      57     use funcon_C, only : a0, ev
      58     use cosmo_C, only : nps, bmat, qscnet, ipiden
      59     use common_arrays_C, only : h
      60     implicit none
      61     integer :: i, im, j
      62     double precision :: fcon, him
      63     fcon = a0 * ev
      64     do i = 1, lm61
      65       im = ipiden(i)
      66       him = 0.d0
      67       do j = 1, nps
      68         him = him + bmat(i, j) * qscnet(j, 1)
      69       end do
      70       h(im) = h(im) - fcon * him
      71     end do
      72 end subroutine addhcr
 
