     154 !
     155           call rsp (sec, nsec, eigs, vec)
     156           sum = eigs(1) ! dummy use of eigs
     157 !
     158 !    Crude, but fast, way of rotating LMOs
     159 !
     160           select case (nsec)
     161           case default
     162             mo1 = idegen(1)
     163             mo2 = idegen(2)
     164             do i = 1, norbs
     165               sum1 = vec(1)*c(i,mo1) + vec(2)*c(i,mo2)
     166               sum2 = vec(3)*c(i,mo1) + vec(4)*c(i,mo2)
 
 FORCHECK PC V13.5.13          RESOLV          2021-03-24 10:59:30   page:   388
 resolv.F90  /FF
 
     167               c(i,mo1) = sum1
     168               c(i,mo2) = sum2
     169             end do
     170             if (lone_pair .and. l_rabbit .or. .not. lone_pair .and. l_b
 anana) then
     171               sum3 = sqrt(0.5d0)
     172               do i = 1, norbs
     173                 sum1 = sum3*c(i,mo1) + sum3*c(i,mo2)
     174                 sum2 = sum3*c(i,mo1) - sum3*c(i,mo2)
     175                 c(i,mo1) = sum1
     176                 c(i,mo2) = sum2
     177               end do
     178             end if
     179           case (3)
     180             mo1 = idegen(1)
     181             mo2 = idegen(2)
     182             mo3 = idegen(3)
     183             do i = 1, norbs
     184               sum1 = vec(1)*c(i,mo1) + vec(2)*c(i,mo2) + vec(3)*c(i,mo3
 )
     185               sum2 = vec(4)*c(i,mo1) + vec(5)*c(i,mo2) + vec(6)*c(i,mo3
 )
     186               sum3 = vec(7)*c(i,mo1) + vec(8)*c(i,mo2) + vec(9)*c(i,mo3
 )
     187               c(i,mo1) = sum1
     188               c(i,mo2) = sum2
     189               c(i,mo3) = sum3
     190             end do
     191             if (lone_pair .and. l_rabbit .or. .not. lone_pair .and. l_b
 anana) then
     192               do i = 1, norbs
     193                 sum1 = sqrt_3*c(i,mo1) - sqrt_2*c(i,mo2) +  sqrt_6*c(i,
 mo3)
     194                 sum2 = sqrt_3*c(i,mo1) + sqrt_2*c(i,mo2) +  sqrt_6*c(i,
 mo3)
     195                 sum3 = sqrt_3*c(i,mo1)                   - sqrt_23*c(i,
 mo3)
     196                 c(i,mo1) = sum1
     197                 c(i,mo2) = sum2
     198                 c(i,mo3) = sum3
     199               end do
     200               continue
     201             end if
     202           end select
     203         end if
     204       end do l160
     205       return
     206       end subroutine resolv
 
