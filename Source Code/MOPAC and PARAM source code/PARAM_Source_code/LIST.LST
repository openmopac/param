    3433       subroutine to_point(r, point, const)
    3434         use molkst_C, only : trunc_1, trunc_2
    3435         use funcon_C, only : ev, a0
    3436         double precision, intent(in) :: r
    3437         double precision, intent(out) :: point, const
    3438 !
    3439 ! smooth the transition from NDDO-type two-electron integrals to exact
 point-charge
    3440 ! values.  The function used here is the reverse of the intuitive funct
 ion:
    3441 ! it starts off with the Gaussian value being small and builds up to 1.
 0 at the
    3442 ! distance "trunc_1".  This behavior is designed to have the smallest e
 ffect where
    3443 ! the difference between point change and NDDO values is largest.
    3444 !
    3445 ! On input, r = interatomic distance in Angstroms
    3446 !
    3447 ! On output, point = e-e repulsion point-charge energy in eV
    3448 !            const = fraction of NDDO term to be used
    3449 !
    3450         point = ev*a0/r
    3451         if (r < trunc_1) then
    3452           const = 1.d0 - exp(-(r - trunc_1)**2*trunc_2)
    3453         else
    3454           const = 0.d0
    3455         end if
    3456         return
    3457       end subroutine to_point
 
