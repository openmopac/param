     910       !    - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 -
     911       !     P(C.I.) = P(SCF) + C * DELTAP * C'
     912       do i = 1, nmos
     913         do j = 1, i - 1
     914           deltap(j, i) = deltap(i, j)
     915         end do
     916       end do
     917       !     STEP 1: DELTAP = C * DELTAP
     918       call mxm (coeffs(1, nelec + 1), norbs, deltap, nmos, delta, nmos)
     919       !     STEP 2: P = P + DELTAP * C'
     920       iden = 0
