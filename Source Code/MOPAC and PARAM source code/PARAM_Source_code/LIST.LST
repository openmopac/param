       1       subroutine vecprt(a, numm)
       2       use molkst_C, only : numat, mozyme
       3       use common_arrays_C, only : nfirst, nlast, nat
       4       use chanel_C, only : iw
       5       use elemts_C, only : elemnt
       6       implicit none
       7       integer , intent(in) :: numm
       8       double precision , intent(inout) :: a(*)
       9 !
      10 ! Local
      11 !
      12       integer , dimension(:), allocatable :: natom
      13       integer :: i, jlo, jhi, l, k, numb, limit, kk, na, ll, m, ma, n
      14       double precision :: sumax, fact
      15       character :: line(21)*6, atorbs(9)*2, fmt*31
      16       character, dimension(:), allocatable :: itext*2, jtext*2
      17       save atorbs
      18 !**********************************************************************
      19 !
      20 !  VECPRT PRINTS A LOWER-HALF TRIANGLE OF A SQUARE MATRIX, THE
      21 !         LOWER-HALF TRIANGLE BEING STORED IN PACKED FORM IN THE
      22 !         ARRAY "A"
      23 !
      24 ! ON INPUT:
      25 !      A      = ARRAY TO BE PRINTED
      26 !      NUMM   = SIZE OF ARRAY TO BE PRINTED
      27 !(REF) NUMAT  = NUMBER OF ATOMS IN THE MOLECULE (THIS IS NEEDED TO
      28 !               DECIDE IF AN ATOMIC ARRAY OR ATOMIC ORBITAL ARRAY IS
      29 !               TO BE PRINTED
      30 !(REF) NAT    = LIST OF ATOMIC NUMBERS
      31 !(REF) NFIRST = LIST OF ORBITAL COUNTERS
      32 !(REF) NLAST  = LIST OF ORBITAL COUNTERS
      33 !
      34 !  NONE OF THE ARGUMENTS ARE ALTERED BY THE CALL OF VECPRT
      35 !
      36 !*********************************************************************
      37       data atorbs/ ' S', 'PX', 'PY', 'PZ', 'X2', 'XZ', 'Z2', 'YZ', 'XY'
 /
      38       l = 0
      39       if (mozyme) then
      40         call vecprt_for_MOZYME(a,numm)
      41         return
      42       end if
      43       numb = abs(numm)
      44       allocate (natom(numb), itext(numb), jtext(numb))
      45       sumax = 1.D0
      46       do i = 1, numm
      47         sumax = max(abs(a((i*(i+1))/2)), sumax)
      48       end do
      49       i = int(log10(sumax))
      50       if (i == 1 .or. i == 2) i = 0
      51       fact = 10.D0**(-i)
      52       if (abs(fact - 1.D0) > 0.001D0) then
      53         write (iw, '(A,F12.1)') 'Diagonal Terms should be Multiplied by
 ', 1.D0/fact
      54         do i = 1, numm
      55           a((i*(i+1))/2) = a((i*(i+1))/2)*fact
      56         end do
 
 FORCHECK PC V13.5.13          VECPRT          2021-03-24 10:59:30   page:  2508
