     261 !
     262 !  Find nearest heavy atom to hydrogen atom i
     263 !
     264           rmin = 1.d12
     265           do j = 1, numat
     266             if (j == i .or. nat(j) == 1) cycle
     267             r = distance(i, j)
     268             if (r < rmin) then
     269               rmin = r
     270               k = j
     271             end if
     272           end do
