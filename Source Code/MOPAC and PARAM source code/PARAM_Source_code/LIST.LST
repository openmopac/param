       1   subroutine rotate(ni, nj, xi, xj, w, kr, e1b, e2a, enuc)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5   use molkst_C, only : id, method_pm7
       6   use parameters_C, only: natorb
       7 !**********************************************************************
 *
       8 !
       9   implicit none
      10 !-----------------------------------------------
      11 !   D u m m y   A r g u m e n t s
      12 !-----------------------------------------------
      13   integer  :: ni
      14   integer  :: nj
      15   integer , intent(inout) :: kr
      16   double precision , intent(out) :: enuc
      17   double precision , intent(in) :: xi(3)
      18   double precision , intent(in) :: xj(3)
      19   double precision , intent(out) :: w(2025)
      20   double precision , intent(out) :: e1b(45)
      21   double precision , intent(out) :: e2a(45)
      22 !-----------------------------------------------
      23 !   L o c a l   V a r i a b l e s
      24 !-----------------------------------------------
      25   integer :: i, li, lj, ik, k
      26   double precision ::  rijx, rij
      27   double precision, dimension(3) :: x
      28   double precision, dimension(171) :: en
      29 !-----------------------------------------------
      30 !**********************************************************************
 *
      31 !
      32 !..IMPROVED SCALAR VERSION
      33 !..WRITTEN BY ERNEST R. DAVIDSON, INDIANA UNIVERSITY.
      34 !
      35 !
      36 !   ROTATE CALCULATES THE TWO-PARTICLE INTERACTIONS.
      37 !
      38 !   ON INPUT  NI     = ATOMIC NUMBER OF FIRST ATOM.
      39 !             NJ     = ATOMIC NUMBER OF SECOND ATOM.
      40 !             XI     = COORDINATE OF FIRST ATOM.
      41 !             XJ     = COORDINATE OF SECOND ATOM.
      42 !
      43 ! ON OUTPUT W      = ARRAY OF TWO-ELECTRON REPULSION INTEGRALS.
      44 !           E1B,E2A= ARRAY OF ELECTRON-NUCLEAR ATTRACTION INTEGRALS,
      45 !                    E1B = ELECTRON ON ATOM NI ATTRACTING NUCLEUS OF NJ
 .
      46 !           ENUC   = NUCLEAR-NUCLEAR REPULSION TERM.
      47 !
      48 !
      49 ! *** THIS ROUTINE COMPUTES THE REPULSION AND NUCLEAR ATTRACTION
      50 !     INTEGRALS OVER MOLECULAR-FRAME COORDINATES.  THE INTEGRALS OVER
      51 !     LOCAL FRAME COORDINATES ARE EVALUATED BY SUBROUTINE REPP AND
      52 !     STORED AS FOLLOWS (WHERE P-SIGMA = O,   AND P-PI = P AND P* )
      53 !     IN RI
      54 !     (SS/SS)=1,   (SO/SS)=2,   (OO/SS)=3,   (PP/SS)=4,   (SS/OS)=5,
      55 !     (SO/SO)=6,   (SP/SP)=7,   (OO/SO)=8,   (PP/SO)=9,   (PO/SP)=10,
 
 FORCHECK PC V13.5.13          ROTATE          2021-03-24 10:59:30   page:   884
 rotate.F90  /FF
 
      56 !     (SS/OO)=11,  (SS/PP)=12,  (SO/OO)=13,  (SO/PP)=14,  (SP/OP)=15,
      57 !     (OO/OO)=16,  (PP/OO)=17,  (OO/PP)=18,  (PP/PP)=19,  (PO/PO)=20,
      58 !     (PP/P*P*)=21,   (P*P/P*P)=22.
      59 !
      60 !**********************************************************************
 *
      61   x(1) = xi(1) - xj(1)
      62   x(2) = xi(2) - xj(2)
      63   x(3) = xi(3) - xj(3)
      64   rij = x(1)*x(1) + x(2)*x(2) + x(3)*x(3)
      65   if (rij < 0.00002D0) then
      66 !
      67 !     SMALL RIJ CASE
      68 !
      69     e1b = 0.D0
      70     e2a = 0.D0
      71     w = 0.D0
      72     enuc = 0.D0
      73     return
      74   end if
      75 !
      76 !
      77 ! *** THE REPULSION INTEGRALS OVER MOLECULAR FRAME (W) ARE STORED IN TH
 E
      78 !     ORDER IN WHICH THEY WILL LATER BE USED.  IE.  (I,J/K,L) WHERE
      79 !     J.LE.I  AND  L.LE.K     AND L VARIES MOST RAPIDLY AND I LEAST
      80 !     RAPIDLY.  (ANTI-NORMAL COMPUTER STORAGE)
      81 !
      82 !
      83   rijx = sqrt(rij)
      84   rij = rijx
      85 !
      86 ! *** COMPUTE INTEGRALS IN DIATOMIC FRAME
      87 !
      88   li = natorb(ni)
      89   lj = natorb(nj)
      90   call rotatd(ni, nj, xi, xj, w, kr, enuc)
      91   en(:) = 0.d0
      92   call elenuc (1, li, li + 1, li + lj, en)
      93   ik = 0
      94   do i = 1, li
      95     do k = 1, i
      96       ik = ik + 1
      97       e1b(ik) = en((i*(i - 1))/2 + k)
      98     end do
      99   end do
     100   ik = 0
     101   do i = li + 1, li + lj
     102     do k = li + 1, i
     103       ik = ik + 1
     104       e2a(ik) = en((i*(i - 1))/2 + k)
     105     end do
     106   end do
     107   if (id == 3 .and. .not. method_PM7) call nddo_to_point(w, e1b, e2a, e
 nuc, rij, ni, nj) ! In solids, transition to point-charge as Rij increases
     108   return
     109   end subroutine rotate
 
 FORCHECK PC V13.5.13          ROTATE          2021-03-24 10:59:30   page:   885
 rotate.F90  /FF


