     969 !     *****************************************************************
 *****
     970
     971       subroutine perms (aoi, boi, ao, bo, isng, nalpha, nbeta, isync, i
 max)
     972
     973 !     **** this forms all possible permutations of NALPHA and NBETA ***
 *
     974 !     **** electrons, one per orbital, in orbs ISNG                 ***
 *
     975 !     **** ISYNC is increased one per call; IMAX is terminating value *
 *
     976       use reimers_C, only: ncore, nov
     977
     978       implicit none
     979       integer           isng(nov), i, j, &
     980                         ialpha, ibeta, imax, io, isync, &
     981                         jsync, kk, nalpha, nbeta, ntot
     982       logical*1         aoi(nov), boi(nov), ao(nov), bo(nov)
     983
     984 !     **** copy accross initial determinate ****
     985       do i = 1, nov
     986         ao(i) = aoi(i)
     987         bo(i) = boi(i)
     988       end do
     989
     990 !     **** loop increasing isync looking for allowed pattern ****
     991
     992 100   continue
     993
     994       if (isync.ge.imax) stop 'PERMS: could not find permutation'
     995       isync = isync + 1
     996
     997       ntot = nalpha + nbeta
     998       ialpha = 0
     999       ibeta = 0
    1000       jsync = isync
    1001       do i = 1, ntot
    1002         io = isng(i) - ncore
    1003         j = jsync / 2
    1004         kk = jsync - 2*j
    1005         jsync = j
    1006         ao(io) = kk.eq.0
    1007         if (ao(io)) then
    1008           ialpha = ialpha + 1
    1009           if (ialpha > nalpha) goto 100
    1010         else
    1011           ibeta = ibeta + 1
    1012           if (ibeta > nbeta) goto 100
    1013         end if
    1014       end do
    1015
    1016 !     **** it can only get here if pattern is allowed ****
    1017       do i = 1, ntot
    1018         io = isng(i) - ncore
    1019         bo(io) = .not. ao(io)
    1020       end do
    1021
 
 FORCHECK PC V13.5.13          PERMS           2021-03-24 10:59:30   page:  2494
 excite.F90  /FF
 
    1022       return
    1023       end subroutine perms
 
