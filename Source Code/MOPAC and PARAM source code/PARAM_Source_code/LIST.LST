    3259         yy = yy + trsub(u1,gs,ud3,nclose,norbs,norbs)
    3260         yy = yy - trsub(ud3,eps,u1,norbs,nclose,norbs)
    3261         yy = yy - trsub(u1,eps,ud3,norbs,nclose,norbs)
    3262 !
