     346   subroutine GPJPS_IntQ(Rab, na, Ca, Za, dZadQa, X, Xa)
     347     implicit none
     348     double precision, intent(in) :: Rab(3)
     349     integer, intent(in) :: na
     350     double precision, intent(in) :: Ca(na), Za(na), dZadQa(na)
     351     double precision, intent(OUT) :: X( 3, 1 ), Xa( 3, 1 )
     352 !
     353 !  Local variables
     354 !
     355     integer :: i
     356     double precision :: r2, r, b, br, cc, j00, d00dr, j10, e, U(3), d10
 dQa, dbdQa, &
     357       dedb, d00db, d00drdb
     358     X = 0.d0
     359     Xa = 0.d0
     360     r2 = Rab(1)*Rab(1) + Rab(2)*Rab(2) + Rab(3)*Rab(3)
     361     if ( r2 < 1.d-25 ) then
     362        X = 0.d0
     363        Xa = 0.d0
     364     else
     365        r = sqrt(r2)
     366        U = Rab/r
     367        j10 = 0.d0
     368        d10dQa = 0.d0
     369        do i=1, na
     370           b  = sqrt( Za(i) )
     371           dbdQa = dZadQa(i) / ( 2.d0*b )
     372           br = b * r
     373           cc = Ca(i)
     374           e = (2.d0 / sqrt_PI) * b * EXP(-br*br)
     375           dedb = (2.d0 / sqrt_PI) * (1.d0-2.d0*br*br) * EXP(-br*br)
     376           j00    = erf(br)/r
     377           d00dr  = e/r - j00/r
     378           d00db = (2.d0 / sqrt_PI) * EXP(-br*br)
     379           d00drdb = dedb/r - d00db/r
     380           j10    = j10 + cc * d00dr
     381           d10dQa = d10dQa + cc * d00drdb * dbdQa
     382        end do
     383        X(1, 1) = X(1, 1) + j10 * U(3)
     384        X(2, 1) = X(2, 1) + j10 * U(1)
     385        X(3, 1) = X(3, 1) + j10 * U(2)
     386        Xa(1, 1) = Xa(1, 1) + d10dQa * U(3)
     387        Xa(2, 1) = Xa(2, 1) + d10dQa * U(1)
     388        Xa(3, 1) = Xa(3, 1) + d10dQa * U(2)
     389     end if
     390   end subroutine GPJPS_IntQ
 
