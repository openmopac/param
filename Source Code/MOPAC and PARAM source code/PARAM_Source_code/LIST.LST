    2258       subroutine ddpo(ni)
    2259 !-----------------------------------------------
    2260 !   M o d u l e s
    2261 !-----------------------------------------------
    2262       use parameters_C, only : dorbs, gss, hsp, gpp, gp2, ddp, po
    2263       use mndod_C, only :  aij, repd
    2264 !     *
    2265 !     CALCULATION OF CHARGE SEPARATIONS AND ADDITIVE TERMS USED
    2266 !     TO COMPUTE THE TWO-CENTER TWO-ELECTRON INTEGRALS IN MNDO/D.
    2267 !     *
    2268 !     CHARGE SEPARATIONS DD(6,107) FROM ARRAY AIJ COMPUTED IN AIJM.
    2269 !     ADDITIVE TERMS     PO(9,107) FROM FUNCTION POIJ.
    2270 !     SECOND INDEX OF DD AND PO    SS 1, SP 2,PP 8, PP 3, SD 4, PD 5, D
 D
    2271 !     SEE EQUATIONS (12)-(16) OF TCA PAPER FOR DD.
    2272 !     SEE EQUATIONS (19)-(26) OF TCA PAPER FOR PO.
    2273 !     SPECIAL CONVENTION FOR ATOMIC CORE: ADDITIVE TERM PO(9,NI)
    2274 !     USED IN THE EVALUATION OF THE CORE-ELECTRON ATTRACTIONS AND
    2275 !     CORE-CORE REPULSIONS.
    2276 !     *
    2277 !-----------------------------------------------
    2278 !   I n t e r f a c e   B l o c k s
    2279 !-----------------------------------------------
    2280       implicit none
    2281 !-----------------------------------------------
    2282 !   D u m m y   A r g u m e n t s
    2283 !-----------------------------------------------
    2284       integer , intent(in) :: ni
    2285 !-----------------------------------------------
    2286 !   L o c a l   V a r i a b l e s
    2287 !-----------------------------------------------
    2288       double precision :: fg, d, da
    2289       double precision, external :: poij
    2290 !-----------------------------------------------
    2291 ! *** ADDITIVE TERM FOR SS.
    2292       fg = gss(ni)
    2293       if (fg > 0.1d0) po(1,ni) = poij(0,1.d0,fg)
    2294       if (ni >= 3) then
    2295 ! *** OTHER TERMS FOR SP BASIS.
    2296 !     SP
    2297         d = aij(2,ni)/sqrt(12.0D0)
    2298         fg = hsp(ni)
    2299         ddp(2,ni) = d
    2300         po(2,ni) = poij(1,d,fg)
    2301 !     PP
    2302         po(7,ni) = po(1,ni)
    2303         d = sqrt(aij(3,ni)*0.1D0)
    2304         fg = 0.5D0*(gpp(ni)-gp2(ni))
    2305         ddp(3,ni) = d
    2306         po(3,ni) = poij(2,d,fg)
    2307 ! *** TERMS INVOLVING D ORBITALS.
    2308         if (dorbs(ni)) then
    2309 !     SD
    2310           da = sqrt(1.d0/60.0D0)
    2311           d = sqrt(aij(4,ni)*da)
    2312           fg = repd(19,ni)
    2313           ddp(4,ni) = d
    2314           po(4,ni) = poij(2,d,fg)
 
 FORCHECK PC V13.5.13           DDPO           2021-03-24 10:59:30   page:  1508
 mndod.F90  /FF
 
    2315 !     PD
    2316           d = aij(5,ni)/sqrt(20.0D0)
    2317           fg = repd(23,ni) - 1.8D0*repd(35,ni)
    2318           ddp(5,ni) = d
    2319           po(5,ni) = poij(1,d,fg)
    2320 !     DD
    2321           fg = 0.2D0*(repd(29,ni)+2.d0*repd(30,ni)+2.d0*repd(31,ni))
    2322           if (fg > 1.d-5) then
    2323             po(8,ni) = poij(0,1.d0,fg)
    2324           else
    2325             po(8,ni) = 1.d5
    2326           end if
    2327           d = sqrt(aij(6,ni)/14.0D0)
    2328           fg = repd(44,ni) - (20.0D0/35.0D0)*repd(52,ni)
    2329           ddp(6,ni) = d
    2330           po(6,ni) = poij(2,d,fg)
    2331         end if
    2332       end if
    2333       return
    2334       end subroutine ddpo
 
