     632 !
     633       subroutine grids(co, potpt, nmep)
     634 !-----------------------------------------------
     635 !   M o d u l e s
     636 !-----------------------------------------------
     637       use chanel_C, only : iw
     638       use molkst_C, only : numat
     639       use common_arrays_C, only : nat
     640 !********************************************************************
     641 !   THIS SUBROUTINE CALCULATES THE WILLIAMS SURFACE OR GRIDS. IT IS
     642 !   LIFTED FROM <ESP> BY B.H.BESLER AND K.M.MERZ.
     643 !********************************************************************
     644 !**********************************************************************
 *
     645 !-----------------------------------------------
     646 !   I n t e r f a c e   B l o c k s
     647 !-----------------------------------------------
     648       implicit none
     649 !-----------------------------------------------
     650 !   G l o b a l   P a r a m e t e r s
     651 !-----------------------------------------------
     652 !-----------------------------------------------
     653 !   D u m m y   A r g u m e n t s
     654 !-----------------------------------------------
     655       integer , intent(inout) :: nmep
     656       double precision , intent(in) :: co(3,*)
     657       double precision , intent(out) :: potpt(3,*)
     658 !-----------------------------------------------
     659 !   L o c a l   V a r i a b l e s
     660 !-----------------------------------------------
     661       integer :: i, ia, npnt, l, jz
     662       double precision, dimension(53) :: vderw
     663       double precision, dimension(100) :: dist
     664       double precision, dimension(3) :: xmin, xmax
     665       double precision :: shell, grid, closer, vdmax, xstart, ystart, z
 start, zgrid&
     666         , ygrid, xgrid
     667 !-----------------------------------------------
     668 !
     669       data vderw/ 53*0.0D0/
     670       vderw(1) = 2.4D0
     671       vderw(5) = 3.0D0
     672       vderw(6) = 2.9D0
     673       vderw(7) = 2.7D0
     674       vderw(8) = 2.6D0
     675       vderw(9) = 2.55D0
     676       vderw(15) = 3.1D0
     677       vderw(16) = 3.05D0
     678       vderw(17) = 3.0D0
     679       vderw(35) = 3.15D0
     680       vderw(53) = 3.35D0
     681       shell = 1.2D0
     682       grid = 0.8D0
     683       closer = 0.D0
     684 !     CHECK IF VDERW IS DEFINED FOR ALL ATOMS
     685 !
     686       do i = 1, numat
     687         if (vderw(nat(i)) == 0.0D0) go to 20
 
 FORCHECK PC V13.5.13          GRIDS           2021-03-24 10:59:30   page:  3041
 pmep.F90  /FF
 
     688       end do
     689       go to 30
     690    20 continue
     691       write (iw, *) 'VAN DER WAALS'' RADIUS NOT DEFINED FOR ATOM', i
     692       write (iw, *) 'IN WILLIAMS SURFACE ROUTINE PDGRID!'
     693       call mopend (&
     694       'VAN DER WAALS'' RADIUS NOT DEFINED IN WILLIAMS SURFACE ROUTINE P
 DGRID!.'&
     695         )
     696       return
     697 !     NOW CREATE LIMITS FOR A BOX
     698    30 continue
     699       xmin = 100000.0D0
     700       xmax = -100000.0D0
     701       do ia = 1, numat
     702         where (co(:,ia) - xmin < 0.D0)
     703           xmin = co(:,ia)
     704         end where
     705         where (co(:,ia) - xmax > 0.D0)
     706           xmax = co(:,ia)
     707         end where
     708       end do
     709 !     ADD (OR SUBTRACT) THE MAXIMUM VDERW PLUS SHELL
     710       vdmax = 0.0D0
     711       vdmax = dmax1(maxval(vderw),vdmax)
     712       xmin = xmin - vdmax - shell
     713       xmax = xmax + vdmax + shell
     714 ! STEP GRID BACK FROM ZERO TO FIND STARTING POINTS
     715       xstart = 0.0D0
     716       xstart = xstart - grid
     717       do while(xstart > xmin(1))
     718         xstart = xstart - grid
     719       end do
     720       ystart = 0.0D0
     721       ystart = ystart - grid
     722       do while(ystart > xmin(2))
     723         ystart = ystart - grid
     724       end do
     725       zstart = 0.0D0
     726       zstart = zstart - grid
     727       do while(zstart > xmin(3))
     728         zstart = zstart - grid
     729       end do
     730       npnt = 0
     731       zgrid = zstart
     732   140 continue
     733       ygrid = ystart
     734   150 continue
     735       xgrid = xstart
     736   160 continue
     737       do l = 1, numat
     738         jz = nat(l)
     739         dist(l) = sqrt((co(1,l)-xgrid)**2+(co(2,l)-ygrid)**2+(co(3,l)-z
 grid)**2&
     740           )
     741 !     REJECT GRID POINT IF ANY ATOM IS TOO CLOSE
     742         if (dist(l) < vderw(jz) - closer) go to 200
     743       end do
     744 ! BUT AT LEAST ONE ATOM MUST BE CLOSE ENOUGH
 
 FORCHECK PC V13.5.13          GRIDS           2021-03-24 10:59:30   page:  3042
 pmep.F90  /FF
 
     745       do l = 1, numat
     746         jz = nat(l)
     747         if (dist(l) > vderw(jz) + shell) cycle
     748         go to 190
     749       end do
     750       go to 200
     751   190 continue
     752       npnt = npnt + 1
     753       nmep = nmep + 1
     754       potpt(1,nmep) = xgrid
     755       potpt(2,nmep) = ygrid
     756       potpt(3,nmep) = zgrid
     757   200 continue
     758       xgrid = xgrid + grid
     759       if (xgrid <= xmax(1)) go to 160
     760       ygrid = ygrid + grid
     761       if (ygrid <= xmax(2)) go to 150
     762       zgrid = zgrid + grid
     763       if (zgrid <= xmax(3)) go to 140
     764       return
     765       end subroutine grids
 
