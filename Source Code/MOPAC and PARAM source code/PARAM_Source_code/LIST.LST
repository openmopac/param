      44 subroutine prtlmn (nncx, icxxx, ncxxx, cxxx, ncx, isort, eigs, mmos, i_
 offset)
      45    !*******************************************************************
 ****
      46    !
      47    !  PRTLMN (PRTLMO) prints the Localized Molecular Orbitals as the
      48    !         scalar of the atomic contribution for the top few atoms.
      49    !  The value is multipled by 100, and printed as a percentage.
      50    !
      51    !*******************************************************************
 ****
      52     use MOZYME_C, only: iorbs, noccupied
      53 !
      54     use molkst_C, only: norbs, numat
      55 !
      56     use chanel_C, only: iw
      57 !
      58     use elemts_C, only: elemnt
      59 !
      60     use common_arrays_C, only : nat
      61 !
      62     implicit none
      63     integer, intent (in) :: mmos, i_offset
      64     integer, dimension (norbs), intent (inout) :: isort
      65     integer, dimension (*), intent (in) :: ncx, nncx, ncxxx
      66     integer, dimension (*), intent (in) :: icxxx
      67     double precision, dimension (norbs), intent (in) :: eigs
      68     double precision, dimension (*), intent (in) :: cxxx
      69 !
      70     integer :: i, ii, iunsrt, j, jl, ju, k, kk, l, lj, loop, m, n, nj,
 ibig(100), jbig(100)
      71     double precision :: const, sum, eig_min, xbig(100)
      72     double precision, dimension(:), allocatable :: w, eigs_temp
      73     integer, dimension(:), allocatable :: iscrch, jat
      74     character :: num_1*1, num_2*1
      75
      76     allocate (w(Max(1,noccupied*20)), iscrch(Max(1,noccupied*20)), jat(
 norbs), &
      77             stat=i)
      78     if (i /= 0) then
      79       call memory_error ("prtlmo")
      80       return
      81     end if
      82 !
      83 ! Construct map of LMO energy levels
      84 !
      85     allocate (eigs_temp(mmos))
      86     eigs_temp(:mmos) = eigs(:mmos)
      87     do i = 1, mmos
      88       eig_min = 1.d7
      89       ii = 0
      90       do j = 1, mmos
      91         if (eigs_temp(j) < eig_min) then
      92           eig_min = eigs_temp(j)
      93           ii = j
      94         end if
      95       end do
      96       isort(i) = ii
 
 FORCHECK PC V13.5.13          PRTLMN          2021-03-24 10:59:30   page:  2208
 prtlmo.F90  /FF
 
      97       eigs_temp(ii) = 1.d8
      98     end do
      99    !
     100    !   Put LMO contributions per atom into an atom-based array
     101    !   Store number of atoms in each LMO in JAT
     102    !   Store number of times an atom is used in the LMOs in IAT
     103    !   Store the address of each atom in the square array IM
     104    !
     105     j = 0
     106     const = 2.d-4
     107     do iunsrt = 1, mmos
     108       i = isort(iunsrt)
     109       n = ncxxx(i)
     110       k = 0
     111       do ii = nncx(i) + 1, nncx(i) + ncx(i)
     112         l = icxxx(ii)
     113         nj = iorbs(l)
     114         sum = 0.d0
     115         do m = 1, nj
     116           sum = sum + cxxx(m+n) ** 2
     117         end do
     118         if (sum > const) then
     119           j = j + 1
     120           k = k + 1
     121           iscrch(j) = l
     122           w(j) = sum * 2.d0
     123         end if
     124         n = n + nj
     125       end do
     126       !
     127       !   JAT holds the number of atoms that are important in the LMO(I
 )
     128       !
     129       jat(i) = k
     130     end do
     131     ju = 0
     132     num_1 = char(ichar("3") +int(log10(numat + 0.05)))
     133     num_2 = char(ichar("2") +int(log10(norbs + 0.05)))
     134     do iunsrt = 1, mmos
     135       i = isort(iunsrt)
     136       jl = ju + 1
     137       ju = jl + jat(i) - 1
     138       k = 0
     139       do j = jl, ju
     140         k = k + 1
     141         xbig(k) = w(j)
     142         ibig(k) = iscrch(j)
     143       end do
     144       kk = Min (20, k)
     145       do loop = 1, kk
     146         sum = -1.d0
     147         l = 0
     148         lj = 0
     149         do j = loop, k
     150           if (xbig(j) > sum) then
     151             sum = xbig(j)
     152             l = ibig(j)
     153             lj = j
     154           end if
 
 FORCHECK PC V13.5.13          PRTLMN          2021-03-24 10:59:30   page:  2209
 prtlmo.F90  /FF
 
     155         end do
     156         if (sum < const*100.d0) exit
     157         xbig(lj) = xbig(loop)
     158         ibig(lj) = ibig(loop)
     159         jbig(loop) = Int (sum/const)
     160         ibig(loop) = l
     161       end do
     162       loop = loop - 1
     163       sum = 0.d0
     164       do j = 1, loop
     165         sum = sum + jbig(j)**2
     166       end do
     167       k = iunsrt + i_offset
     168       sum = 1.d8/sum
     169       if (loop == 1) then
     170         if (jbig(1)*0.01d0> 99.949d0) then
     171           write (iw, '(i'//num_1//',f10.4,f17.5, 3x,a2,i'//num_2//',f6.
 1)') &
     172                 & k, sum,eigs(i), elemnt(nat(ibig(1))),ibig(1),jbig(1)*
 0.01d0
     173         else
     174           write (iw, '(i'//num_1//',f10.4,f17.5, 3x,a2,i'//num_2//',f6.
 2)') &
     175                 & k, sum,eigs(i), elemnt(nat(ibig(1))),ibig(1),jbig(1)*
 0.01d0
     176         end if
     177       else
     178         if (loop < 6) then
     179           write (iw, '(i'//num_1//',f10.4,f17.5, 4(5(3x,a2,i'//num_2//'
 ,f6.2)))') &
     180           k, sum,eigs(i), (elemnt(nat(ibig(j))),ibig(j),jbig(j)*0.01d0,
  j=1, loop)
     181         else
     182           write (iw, '(i'//num_1//',f10.4,f17.5, 4(5(3x,a2,i'//num_2//'
 ,f6.2),/,'//num_1//'x,27x))') &
     183           k, sum,eigs(i), (elemnt(nat(ibig(j))),ibig(j),jbig(j)*0.01d0,
  j=1, loop)
     184         end if
     185       end if
     186     end do
     187     deallocate (w, iscrch, jat)
     188     return
     189   end subroutine prtlmn
 
