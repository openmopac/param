 FORCHECK PC V13.5.13          THERMO          2021-03-24 10:59:30   page:   945
 thermo.F90  /FF
 
  hv, cpv, sv
     222         write (iw, '(9X,''ROT.'',D15.4,10X,f17.4,2F11.4)') qr, hr, cpr,
  sr
     223         write (iw, '(9X,''INT.'',D15.4,10X,f17.4,2F11.4)') qint, hint,
 cpint, sint
     224         write (iw, '(9X,''TRA.'',D15.4,10X,f17.4,2F11.4)') qtr, htr, cp
 tr, str
     225         write (iw, '(9X,''TOT.'',12X,F17.3,F13.4,2F11.4)') escf + (htot
  - h298)/1000.D0, htot, cptot, stot
     226         HOF_tot(ir) = escf + (htot - h298)/1000.D0
     227         H_tot(ir)   = htot
     228         Cp_tot(ir)  = cptot
     229         S_tot(ir)   = stot
     230       end do
