     293       subroutine staticsolv(ao, bo, ener)
     294       use cosmo_C, only : bmat, nden, gden, ipiden, nps, qscnet
     295       use molkst_c, only : mpack
     296       use funcon_C, only : a0, ev
     297       use reimers_C, only : n, nov, cc0, ncore
     298
     299       implicit none
     300       double precision  :: p(mpack), phi(nps), qden(nden)
     301       logical*1 :: ao(nov), bo(nov)
     302       integer :: a, i, j, k, k0, kocc
     303       double precision :: ener, fcon
     304 !**********************************************************************
 *
     305 !   RMG - Compute the interaction energy of an excited-state electron
     306 !   density (p) with the ground-state surface charges (qdenet(2)).
     307 !**********************************************************************
 *
     308       ener = 0.d0
     309       fcon = a0 * ev
     310
     311       do i = 1, mpack
     312         p(i) = 0.d0
     313       end do
     314
     315       a = 0
     316       do i = 1, n
     317         do j = 1, i
     318            a = a + 1
     319            p(a) = p(a) + sum(cc0(1:ncore, i)*cc0(1:ncore, j)) * 2.d0
     320            do k = 1, nov
     321               k0 = k + ncore
     322               kocc = 0
     323               if (ao(k)) kocc = kocc + 1
     324               if (bo(k)) kocc = kocc + 1
     325               p(a) = p(a) + cc0(k0, i) * cc0(k0, j) * kocc
     326
     327            end do
     328         end do
     329       end do
     330
     331 ! Set up charge density for solvation
     332       do i = 1, nden
     333         qden(i) = gden(i) * p(ipiden(i))
     334       end do
     335
     336 ! Compute electrostatic potential at each surface point
     337       do i = 1, nps
     338         phi(i) = 0.d0
     339         do j = 1, nden
     340           phi(i) = phi(i) + bmat(j, i) * qden(j)
     341         end do
     342       end do
     343
     344 ! Calculate interaction energy of charge density with surface points
     345       do i = 1, nps
     346         ener = ener + qscnet(i, 2) * phi(i)
     347       end do
     348       ener = ener * fcon
 
 FORCHECK PC V13.5.13        STATICSOLV        2021-03-24 10:59:30   page:  1397
 cosci.F90  /FF
 
     349       return
     350       end subroutine staticsolv
 
 FORCHECK PC V13.5.13        STATICSOLV        2021-03-24 10:59:30   page:  1398
