       1       double precision function charmo (vects, ntype, jorb, ioper, r, n
 vecs, first)
       2       use symmetry_C, only : elem, jelem
       3       use molkst_C, only : norbs, numat
       4       implicit none
       5       integer , intent(in) :: jorb
       6       integer  :: ioper
       7       integer , intent(in) :: nvecs
       8       logical, intent(inout)  :: first
       9       integer , intent(in) :: ntype(*)
      10       double precision , intent(in) :: vects(nvecs,nvecs)
      11       double precision  :: r(3,3)
      12       integer , dimension(2,3) :: ip
      13       integer , dimension(2,5) :: id
      14       integer , dimension(2,9) :: loc
      15       integer :: i, iatom, jatom, ibase, kj, icheck, jcheck, ii, jj
      16       double precision, dimension(norbs) :: vect1, vect2
      17       double precision, dimension(5) :: h = 0.d0
      18       double precision, dimension(3) :: p
      19       double precision, dimension(5) :: d
      20       double precision :: sum
      21       double precision, external :: ddot
      22 !-----------------------------------------------
      23 !
      24 !  Trivial case:  Operation is 'E', the identity.
      25 !
      26       charmo = 1.D0
      27       if (ioper == 1) return
      28 !
      29 !   Non-trivial case
      30 !
      31       vect1(:nvecs) = 0.D0
      32       vect2(:nvecs) = 0.D0
      33       do iatom = 1, numat
      34         jatom = jelem(ioper,iatom)
      35         ibase = 0
      36         kj = 0
      37         do i = 1, nvecs
      38           icheck = ntype(i)/100
      39           if (icheck == iatom) then
      40             ibase = ibase + 1
      41             loc(1,ibase) = i
      42           end if
      43           if (icheck /= jatom) cycle
      44           kj = kj + 1
      45           loc(2,kj) = i
      46         end do
      47         if (ibase > 0) then
      48 !
      49 !   's'-type basis function
      50 !
      51           icheck = loc(1,1)
      52           jcheck = loc(2,1)
      53           vect1(icheck) = vects(icheck,jorb)
      54           vect2(jcheck) = vects(icheck,jorb)
      55         end if
      56           if (ibase < 4) cycle
      57 !
 
 FORCHECK PC V13.5.13          CHARMO          2021-03-24 10:59:30   page:  2344
 charmo.F90  /FF
 
      58 !    Atom I had a 'p' shell
      59 !
      60         ip(1,:) = 0
      61         id(1,:3) = 0
      62         id(1,4) = 0
      63         id(1,5) = 0
      64         do i = 2, ibase
      65           icheck = loc(1,i)
      66           if (i <= 4) then
      67             p(i-1) = vects(icheck,jorb)
      68             ip(1,i-1) = loc(1,i)
      69             ip(2,i-1) = loc(2,i)
      70           else
      71             d(i-4) = vects(icheck,jorb)
      72             id(1,i-4) = loc(1,i)
      73             id(2,i-4) = loc(2,i)
      74           end if
      75         end do
      76         if (ibase /= 1) then
      77 !
      78 !    'p' transform
      79 !
      80           h(1) = r(1,1)*p(1) + r(2,1)*p(2) + r(3,1)*p(3)
      81           h(2) = r(1,2)*p(1) + r(2,2)*p(2) + r(3,2)*p(3)
      82           h(3) = r(1,3)*p(1) + r(2,3)*p(2) + r(3,3)*p(3)
      83           p(1) = elem(1,1,ioper)*h(1) + elem(1,2,ioper)*h(2) + elem(1,3
 ,ioper)*h(3)
      84           p(2) = elem(2,1,ioper)*h(1) + elem(2,2,ioper)*h(2) + elem(2,3
 ,ioper)*h(3)
      85           p(3) = elem(3,1,ioper)*h(1) + elem(3,2,ioper)*h(2) + elem(3,3
 ,ioper)*h(3)
      86           do i = 1, 3
      87             if (ip(1,i) < 1) return
      88             ii = ip(1,i)
      89             jj = ip(2,i)
      90             vect1(ii) = h(i)
      91             vect2(jj) = p(i)
      92           end do
      93         end if
      94         if (ibase /= 9) cycle
      95 !
      96 !   'd' transform
      97 !
      98         call dtrans (d, ioper, first, r)
      99         do i = 1, 5
     100           if (id(1,i) < 1) return
     101           ii = id(1,i)
     102           jj = id(2,i)
     103           vect1(ii) = h(i)
     104           vect2(jj) = d(i)
     105         end do
     106       end do
     107 !
     108 !   Evaluate the term <psi(i)|R(theta)|psi(i)>
     109 !
     110       sum = ddot(nvecs,vect1(:nvecs),1,vect2(:nvecs),1)
     111       charmo = sum
     112       return
     113       end function charmo
 
