     375     integer function lin(i1,i2)
     376       integer :: i1,i2,idum1,idum2
     377       idum1 = max(i1,i2)
     378       idum2 = min(i1,i2)
     379       lin = idum2 + idum1*(idum1-1)/2
     380       return
     381     end
 
