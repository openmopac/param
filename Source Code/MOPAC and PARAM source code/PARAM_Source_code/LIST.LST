     380       subroutine tf(ua, ga, ub, gb, t, norbs)
     381 !-----------------------------------------------
     382 !   M o d u l e s
     383 !-----------------------------------------------
     384 !-----------------------------------------------
     385 !   I n t e r f a c e   B l o c k s
     386 !-----------------------------------------------
     387       implicit none
     388 !-----------------------------------------------
     389 !   D u m m y   A r g u m e n t s
     390 !-----------------------------------------------
     391       integer  :: norbs
     392       double precision , intent(in) :: ua(norbs,norbs)
     393       double precision , intent(in) :: ga(norbs,norbs)
     394       double precision , intent(in) :: ub(norbs,norbs)
     395       double precision , intent(in) :: gb(norbs,norbs)
     396       double precision  :: t(norbs,norbs)
     397 !-----------------------------------------------
     398 !   L o c a l   V a r i a b l e s
     399 !-----------------------------------------------
     400       integer :: i, j
     401       double precision :: sum1, sum2
     402 !-----------------------------------------------
     403 !
     404 !  THIS SUBROUTINE CREATES THE NEW T MATRIX
     405 !
     406 !
     407 !  ZERO MATRIX INITIALLY
     408 !
     409       call zerom (t, norbs)
     410 !
     411 ! CALCULATE T (IJ)(W,W)= SUM(GA(IK)(W)*UB(KJ)(W)+
     412 ! GB(IK)(W)*UA(KJ)(W)-UA(IK)(W)GB(KJ)(W)-UB(IK)(W)GA(KJ)(W)
     413 !
     414       do i = 1, norbs
     415         do j = 1, norbs
     416           sum1 = 0.0D0
     417           sum2 = 0.0D0
     418 ! CALCULATE FOR (W,W), (0,W) VALUES
     419 !
     420           sum1 = sum(ga(i,:norbs)*ub(:norbs,j)+gb(i,:norbs)*ua(:norbs,j
 )-ua(i,:&
     421             norbs)*gb(:norbs,j)-ub(i,:norbs)*ga(:norbs,j))
     422           sum2 = sum(ga(j,:norbs)*ub(:norbs,i)+gb(j,:norbs)*ua(:norbs,i
 )-ua(j,:&
     423             norbs)*gb(:norbs,i)-ub(j,:norbs)*ga(:norbs,i))
     424           t(i,j) = sum1
     425           t(j,i) = sum2
     426         end do
     427       end do
     428 !
     429       return
     430       end subroutine tf
 
