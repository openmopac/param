    1144 subroutine mkbmat
    1145     use molkst_C, only : numat, method_indo
    1146     use cosmo_C, only : nps, bmat, cosurf
    1147     use parameters_C, only : dd, qq, dsd, dpd, ddd
    1148     use funcon_C, only : a0
    1149     use common_arrays_C, only : coord, nfirst, nlast, nat
    1150     implicit none
    1151     integer :: i, ia, idel, iden, ips, ix, nati, iii
    1152     double precision :: ddi, dist, qqi2, rm1, rm3, rm5, dsdi, dpdi, ddd
 i, atmp
    1153     double precision, dimension (3) :: xa
    1154    ! FILLING B - MATRIX
    1155     iden = 0
    1156     do i = 1, numat
    1157       ia = nfirst(i)
    1158       idel = nlast(i) - ia + 1
    1159       nati = nat(i)
    1160       ddi = dd(nati) * a0
    1161       qqi2 = (a0*qq(nati)) ** 2
    1162 !
    1163 ! replace dd and qq with terms that work for d orbitals
    1164 !
    1165       dsdi = (dsd(nati)*a0)**2
    1166       dpdi = dpd(nati)*a0
    1167       dddi = (ddd(nati)*a0)**2
    1168       do ips = 1, nps
    1169         dist = 0.d0
    1170         do ix = 1, 3
    1171           xa(ix) = cosurf(ix, ips) - coord(ix, i)
    1172           dist = dist + xa(ix) ** 2
    1173         end do
    1174         rm1 = 1.d0 / Sqrt (dist)
    1175         bmat(iden + 1, ips) = rm1
    1176         if (idel > 1) then
    1177           rm3 = rm1 ** 3
    1178           rm5 = rm1 ** 5
    1179 !
    1180 !   INDO off - diagonal terms are zero - preset here
    1181 !
    1182           do iii = iden + 2, iden + 9
    1183             bmat(iii, ips) = 0.d0
    1184           end do
    1185           bmat(iden + 3, ips) = rm1 + 3 * xa(1) ** 2 * qqi2 * rm5 - qqi
 2 * &
    1186          & rm3
    1187           bmat(iden + 6, ips) = rm1 + 3 * xa(2) ** 2 * qqi2 * rm5 - qqi
 2 * &
    1188          & rm3
    1189           bmat(iden + 10, ips) = rm1 + 3 * xa(3) ** 2 * qqi2 * rm5 - qq
 i2 &
    1190          & * rm3
    1191 !
    1192 !  s - p terms (2, 4, 7) and p - p terms (5, 8, 9) for non - INDO metho
 ds
    1193 !
    1194           if (.not. method_indo) then
    1195             bmat(iden + 2, ips) = xa(1) * ddi * rm3
    1196             bmat(iden + 4, ips) = xa(2) * ddi * rm3
 
 FORCHECK PC V13.5.13          MKBMAT          2021-03-24 10:59:30   page:  1632
 cosmo.F90  /FF
 
    1197             bmat(iden + 7, ips) = xa(3) * ddi * rm3
    1198             bmat(iden + 5, ips) = 3 * xa(1) * xa(2) * qqi2 * rm5
    1199             bmat(iden + 8, ips) = 3 * xa(1) * xa(3) * qqi2 * rm5
    1200             bmat(iden + 9, ips) = 3 * xa(3) * xa(2) * qqi2 * rm5
    1201           end if
    1202 ! c now the d-orbitals in spherical symmetry
    1203           if(idel > 4) then
    1204             do iii = iden + 11, iden + 44
    1205               bmat(iii, ips) = 0.d0
    1206             end do
    1207             do iii = 5, 9
    1208               bmat(iden + (iii*(iii + 1))/2, ips) = rm1
    1209             end do
    1210 ! Replace spherically symmetric d orbitals with terms from
    1211 ! J. Phys. Chem. B 2005, 109, 9799
    1212             if (method_indo) then
    1213               do iii = iden + 11, iden + 44
    1214                 bmat(iii, ips) = 0.d0
    1215               end do
    1216 ! Order of INDO d orbitals:  z^2, x^2 - y^2, xy, xz, yz
    1217 ! d-d self interactions
    1218               bmat(iden + 15, ips) = rm1 - dddi*rm3 + 3*dddi*xa(3)**2*r
 m5   ! z^2
    1219               bmat(iden + 21, ips) = rm1 + dddi*rm3 - 3*dddi*xa(3)**2*r
 m5   ! x^2 - y^2
