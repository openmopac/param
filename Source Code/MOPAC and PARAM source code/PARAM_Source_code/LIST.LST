       1       subroutine osinv(a, n, d)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5 !**********************************************************************
 *
       6       implicit none
       7 !-----------------------------------------------
       8 !   D u m m y   A r g u m e n t s
       9 !-----------------------------------------------
      10       integer , intent(in) :: n
      11       double precision , intent(out) :: d
      12       double precision , intent(inout) :: a(*)
      13 !-----------------------------------------------
      14 !   L o c a l   P a r a m e t e r s
      15 !-----------------------------------------------
      16 !-----------------------------------------------
      17 !   L o c a l   V a r i a b l e s
      18 !-----------------------------------------------
      19       integer , dimension(n) :: l, m
      20       integer :: nk, k, kk, j, iz, i, ij, ki, ji, jp, jk, ik, kj, jq, j
 r
      21       double precision :: tol, biga, holo
      22 !-----------------------------------------------
      23 !**********************************************************************
 *
      24 !
      25 !    OSINV INVERTS A GENERAL SQUARE MATRIX OF ORDER UP TO MAXORB. SEE
      26 !          DIMENSION STATEMENTS BELOW.
      27 !
      28 !   ON INPUT       A = GENERAL SQUARE MATRIX STORED LINEARLY.
      29 !                  N = DIMENSION OF MATRIX A.
      30 !                  D = VARIABLE, NOT DEFINED ON INPUT.
      31 !
      32 !   ON OUTPUT      A = INVERSE OF ORIGINAL A.
      33 !                  D = DETERMINANT OF ORIGINAL A, UNLESS A WAS SINGULAR
 ,
      34 !                      IN WHICH CASE D = 0.0
      35 !
      36 !**********************************************************************
 *
      37 !**********************************************************************
 *
      38 !
      39 !    IF THE VALUE OF TOL GIVEN HERE IS UNSUITABLE, IT CAN BE CHANGED.
      40       tol = 1.D-8
      41 !
      42 !
      43 !**********************************************************************
 *
      44       d = 1.D0
      45       nk = -n
      46       do k = 1, n
      47         nk = nk + n
      48         l(k) = k
      49         m(k) = k
      50         kk = nk + k
      51         biga = a(kk)
 
 FORCHECK PC V13.5.13          OSINV           2021-03-24 10:59:30   page:   646
 osinv.F90  /FF
 
      52         do j = k, n
      53           iz = n*(j - 1)
      54           do i = k, n
      55             ij = iz + i
      56 !
      57 !     10 FOLLOWS
      58 !
      59             if (abs(biga) - abs(a(ij)) >= 0.D0) cycle
      60             biga = a(ij)
      61             l(k) = i
      62             m(k) = j
      63           end do
      64         end do
      65         j = l(k)
      66         if (j - k > 0) then
      67           ki = k - n
      68           do i = 1, n
      69             ki = ki + n
      70             holo = -a(ki)
      71             ji = ki - k + j
      72             a(ki) = a(ji)
      73             a(ji) = holo
      74           end do
      75         end if
      76         i = m(k)
      77         if (i - k > 0) then
      78           jp = n*(i - 1)
      79           do j = 1, n
      80             jk = nk + j
      81             ji = jp + j
      82             holo = -a(jk)
      83             a(jk) = a(ji)
      84             a(ji) = holo
      85           end do
      86         end if
      87         if (abs(biga) - tol < 0.D0) then
      88           d = 0.D0
      89           return
      90         end if
      91         do i = 1, n
      92           if (i - k == 0) cycle
      93           ik = nk + i
      94           a(ik) = a(ik)/(-biga)
      95         end do
      96         do i = 1, n
      97           ik = nk + i
      98           ij = i - n
      99           if (i - k == 0) then
     100           else
     101             do j = 1, n
     102               ij = ij + n
     103               if (j - k == 0) cycle
     104               kj = ij - i + k
     105               a(ij) = a(ik)*a(kj) + a(ij)
     106             end do
     107           end if
     108         end do
     109         kj = k - n
     110         do j = 1, n
 
 FORCHECK PC V13.5.13          OSINV           2021-03-24 10:59:30   page:   647
 osinv.F90  /FF
 
     111           kj = kj + n
     112           if (j - k == 0) cycle
     113           a(kj) = a(kj)/biga
     114         end do
     115         d = min(d*biga,1.D10)
     116         a(kk) = 1.D0/biga
     117       end do
     118       k = n
     119   190 continue
     120       k = k - 1
     121       if (k <= 0) go to 260
     122       i = l(k)
     123       if (i - k > 0) then
     124         jq = n*(k - 1)
     125         jr = n*(i - 1)
     126         do j = 1, n
     127           jk = jq + j
     128           holo = a(jk)
     129           ji = jr + j
     130           a(jk) = -a(ji)
     131           a(ji) = holo
     132         end do
     133       end if
     134       j = m(k)
     135       if (j - k <= 0) go to 190
     136       ki = k - n
     137       do i = 1, n
     138         ki = ki + n
     139         holo = a(ki)
     140         ji = ki + j - k
     141         a(ki) = -a(ji)
     142         a(ji) = holo
     143       end do
     144       go to 190
     145   260 continue
     146       return
     147 !
     148       end subroutine osinv
 
