     103
     104       if (iand (nbtmo(i), nbtmo(a)) /= 0) then
     105         ir = ixprd(nsym(i), nsym(a))
     106         jk12 = 0.d0
     107         imu0 = 0
     108         do mu1 = nslwr(ir), nsupr(ir)
     109           mu = istr(1, mu1)
     110           wk1(mu) = c(i, mu)*c(a, mu)
     111           wk2(mu) = c(j, mu)*c(b, mu)
     112           k12 = k12 + wk1(mu)*wk2(mu) * gamma(mu1, mu1)
     113           do nu1 = nslwr(ir), mu1 - 1
     114 !           **** CNDO coulomb integrals (mu, mu|nu, nu) ****
     115             nu = istr(1, nu1)
     116             k12 = k12 + (wk2(mu)*wk1(nu) + wk2(nu)*wk1(mu)) * &
     117      &                                gamma(mu1, nu1)
     118           end do
     119           if (nham == 2) then
     120 !           **** INDO exchange terms (mu, nu|mu, nu) ****
     121             imu = iat(mu)
     122             if (imu /= imu0) then
     123               nu1l = mu1
     124               imu0 = imu
     125             else
     126               do nu1 = nu1l, mu1 - 1
     127                 nu = istr(1, nu1)
     128                 jk12 = jk12 + (wk1(mu)*wk2(nu) + wk1(nu)*wk2(mu))&
     129      &                                * gamma(nu1, mu1)
     130               end do
     131             end if
     132           end if
     133         end do
     134         if (diagon) then
     135 !         **** this trick adds also the i x b terms for determinate ene
 rgy ****
     136           j12 = j12 + jk12 * 2.d0
     137           k12 = k12 + jk12
     138         else
     139 !         **** this is the i x a term only ****
     140           j12 = j12 + jk12
     141         end if
     142       end if
     143
     144 !     **** integrals (mu, nu|nu, mu) from INDO, symmetry = i x b ****
     145
     146       if (.not.diagon .and. nham == 2 .and.&
     147      &                iand (nbtmo(i), nbtmo(b)) /= 0) then
     148         jk12 = 0.d0
     149         imu0 = 0
     150         ir = ixprd(nsym(i), nsym(b))
     151         do mu1 = nslwr(ir), nsupr(ir)
     152           mu = istr(1, mu1)
     153           imu = iat(mu)
     154           wk1(mu) = c(i, mu)*c(b, mu)
     155           wk2(mu) = c(j, mu)*c(a, mu)
     156           if (imu /= imu0) then
     157             nu1l = mu1
     158             imu0 = imu
 
 FORCHECK PC V13.5.13          INTTR           2021-03-24 10:59:30   page:  3964
 ci.F90  /FF
 
     159           else
     160             do nu1 = nu1l, mu1 - 1
     161               nu = istr(1, nu1)
     162               jk12 = jk12 + (wk2(mu)*wk1(nu) + wk2(nu)*wk1(mu))&
     163      &                                * gamma(nu1, mu1)
     164             end do
     165           end if
     166         end do
     167         j12 = j12 + jk12
     168         k12 = k12 + jk12
     169       end if
