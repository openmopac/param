    2488       subroutine fhpatn(a, b, norbs, itw, sign)
    2489 !-----------------------------------------------
    2490 !   M o d u l e s
    2491 !-----------------------------------------------
    2492       implicit none
    2493 !-----------------------------------------------
    2494 !   D u m m y   A r g u m e n t s
    2495 !-----------------------------------------------
    2496       integer , intent(in) :: norbs
    2497       integer , intent(in) :: itw
    2498       double precision , intent(in) :: sign
    2499       double precision , intent(out) :: a(norbs,norbs)
    2500       double precision , intent(in) :: b(norbs,norbs)
    2501 !-----------------------------------------------
    2502 !   L o c a l   V a r i a b l e s
    2503 !-----------------------------------------------
    2504 !-----------------------------------------------
    2505 !
    2506 ! THIS SUBROUTINE CONVERTS THE MATRICES INTO ITS ADJOINTS
    2507 !
    2508       go to (10,40,40,10) itw
    2509    10 continue
    2510       a = b
    2511       go to 70
    2512    40 continue
    2513       a = transpose(sign*b)
    2514    70 continue
    2515       return
    2516       end subroutine fhpatn
 
