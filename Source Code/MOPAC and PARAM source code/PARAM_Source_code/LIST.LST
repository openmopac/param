       1 subroutine extvdw_for_MOZYME (radius, refvdw)
       2     use molkst_C, only: numat, keywrd, line
       3     use chanel_C, only: iw
       4     use common_arrays_C, only: nat
       5     use mod_atomradii, only: is_metal
       6     use elemts_C, only : cap_elemnt
       7     implicit none
       8     double precision, dimension (numat), intent (out) :: radius
       9     double precision, dimension (107), intent (in) :: refvdw
      10     integer :: i, j, k
      11     double precision, dimension (107) :: vdw
      12     character (len=80) :: txt_rad
      13     logical :: paren
      14     double precision, external :: reada
      15 !
      16 !  Modify Van der Waals' radii of various atoms.  The format of
      17 ! the keyword is: VDW(:chemical symbol=n.nn:chemical symbol=n.nn ...)
      18 ! e.g. VDWM(:H=1.0:Cl=1.7)
      19 !
      20     txt_rad = " "
      21     j = -1
      22     i = index(keywrd," METAL")
      23     if (i /= 0) j = index(keywrd(i:),") ") + i
      24     if (i == j .or. index(keywrd, " ADD-H") /= 0) then
      25       is_metal = .false.
      26       do i = 1, 102
      27         select case (i)
      28         case (3, 4, 11, 12, 19:30, 37:48, 55:80)
      29           is_metal(i) = .true.
      30         end select
      31       end do
      32     else if (i > 0) then
      33       i = index(keywrd(i:j), "(") + i
      34       txt_rad = keywrd(i:j - 1)
      35       do k = 1, 83
      36         if (.not. is_metal(k)) is_metal(k) = (index(txt_rad,cap_elemnt(
 k)) /= 0)
      37       end do
      38     end if
      39     i = index(keywrd," VDWM(")
      40     if (i == 0) then
      41       line = " "
      42     else
      43       if (keywrd(i + 6:i + 6) /= ";" .and. keywrd(i + 6:i + 6) /= ":")
 keywrd(i + 6:) = ";"//keywrd(i + 6:)
      44       j = index(keywrd(i + 6:),")") + i + 6
      45       do k = i + 5, j
      46          if (keywrd(k:k) == ":") keywrd(k:k) = ";"
      47          if (keywrd(k:k) == ",") keywrd(k:k) = ";"
      48       end do
      49       line = keywrd(i + 5:j - 1)
      50     end if
      51     vdw(:107) = refvdw(:107)
      52     if (line /= " ") then
      53       do i = 1, 107
      54         j = 2
      55         if (cap_elemnt(i)(2:2) == " ") j = 1
      56         k = index(line, ";"//cap_elemnt(i)(:j)//"=")
 
 FORCHECK PC V13.5.13    EXTVDW_FOR_MOZYME     2021-03-24 10:59:30   page:  4096
 geochk_bits_1.F90  /FF
 
      57         if (k > 0) then
      58           vdw(i) = reada(line, k)
      59           is_metal(i) = .false.
      60         end if
      61       end do
      62     end if
      63 !
      64 !  Verify that all radii that will be used are, in fact, set correctly
      65 !
      66     do i = 1, numat
      67       if (nat(i) > 98) cycle
      68       if (vdw(nat(i)) > 900.d0) then
      69         write (line,*) "MISSING VAN DER WAALS RADIUS FOR " // cap_elemn
 t (nat(i))
      70         call mopend(trim(line))
      71         j = 2
      72         if (cap_elemnt(nat(i)) (2:2) == " ") j = 1
      73         write (iw, "(2x,3a)") "To correct this, add keyword 'VDWM(", &
      74        & cap_elemnt (nat(i)) (1:j), "=n.nn)'"
      75         return
      76       end if
      77     end do
      78 !
      79 ! Flag which elements are to be treated as metals by giving them negati
 ve
      80 ! atomic radii
      81     do i = 1, 102
      82       if (is_metal(i)) vdw(i) = -1.0d0
      83     end do
      84     do i = 1, numat
      85       radius(i) = vdw(nat(i))
      86     end do
      87 !
      88 !  Set VDW radius for individual atoms to -1
      89 !
      90     if (txt_rad /= " ") then
      91       paren = .false.
      92       i = 0
      93       do k = 1, len_trim(txt_rad)
      94         i = i + 1
      95         if (paren) then
      96           paren = (txt_rad(i:i) /= ")")
      97         else
      98            paren = (txt_rad(i:i) == "(")
      99           if (ichar(txt_rad(i:i)) - ichar("0") <= 9 .and. ichar(txt_rad
 (i:i)) - ichar("0") > 0) then
     100             j = nint(reada(txt_rad(i:), 1))
     101             i = i + int(log10(j*1.0001))
     102             radius(j) = -1.d0
     103             do j = i, len_trim(txt_rad)
     104               if (ichar(txt_rad(i:i)) - ichar("0") > 9 .or. &
     105               ichar(txt_rad(i:i)) - ichar("0") < 0) exit
     106               txt_rad(i:i) = " "
     107             end do
     108           end if
     109         end if
     110       end do
     111     end if
     112     return
 
 FORCHECK PC V13.5.13    EXTVDW_FOR_MOZYME     2021-03-24 10:59:30   page:  4097
 geochk_bits_1.F90  /FF
 
