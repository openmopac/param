       1       subroutine mecid(eigs, gse, eiga, diag, xy)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use meci_C, only : occa, microa, microb, nmos, lab
       6 !**********************************************************************
 *
       7 !-----------------------------------------------
       8 !   I n t e r f a c e   B l o c k s
       9 !-----------------------------------------------
      10       implicit none
      11 !-----------------------------------------------
      12 !   D u m m y   A r g u m e n t s
      13 !-----------------------------------------------
      14       double precision , intent(out) :: gse
      15       double precision , intent(in) :: eigs(*)
      16       double precision  :: eiga(*)
      17       double precision , intent(out) :: diag(*)
      18       double precision  :: xy(nmos,nmos,nmos,nmos)
      19 !-----------------------------------------------
      20 !   L o c a l   P a r a m e t e r s
      21 !-----------------------------------------------
      22 !-----------------------------------------------
      23 !   L o c a l   V a r i a b l e s
      24 !-----------------------------------------------
      25       integer :: i, j
      26       double precision :: x
      27       double precision, external :: diagi
      28 !-----------------------------------------------
      29 !**********************************************************************
 *
      30 !
      31 !   MECID CALCULATES THE EFFECT OF REMOVING THE ELECTRONS INVOLVED IN
      32 !   THE C.I. FROM THE GROUND-STATE CONFIGURATION, AND CALCULATES THE
      33 !   MICROSTATE ENERGIES OF THE MICROSTATES INVOLVED IN THE C.I.
      34 !
      35 !  THE QUANTITIES NMOS, NELEC, AND LAB, AND THE ARRAYS EIGS, OCCA,
      36 !  MICROA, AND MICROB ARE USED, BUT UNCHANGED ON EXIT
      37 !
      38 !   ON EXIT, GSE IS THE ELECTRONIC ENERGY OF STABILIZATION DUE TO
      39 !            REMOVAL OF THE ELECTRONS INVOLVED IN THE C.I.
      40 !
      41 !            EIGA HOLDS THE ONE-ELECTRON ENERGY LEVELS RESULTING FROM
      42 !            REMOVAL OF THE ELECTRONS INVOLVED IN THE C.I.
      43 !
      44 !            DIAG HOLDS THE MICROSTATE ENERGIES OF ALL STATES INVOLVED
      45 !            IN THE C.I.  THIS CAN BE USED AS THE DIAGONAL OF A C.I.
      46 !            MATRIX
      47 !
      48 !**********************************************************************
 *
      49       gse = 0.D0
      50       do i = 1, nmos
      51         x = 0.D0
      52         do j = 1, nmos
      53           x = x + (2.D0*xy(i,i,j,j)-xy(i,j,i,j))*occa(j)
      54         end do
      55         eiga(i) = eigs(i) - x
 
 FORCHECK PC V13.5.13          MECID           2021-03-24 10:59:30   page:  1900
 mecid.F90  /FF
 
      56         gse = gse + eiga(i)*occa(i)*2.D0
      57         gse = gse + xy(i,i,i,i)*occa(i)*occa(i)
      58         do j = i + 1, nmos
      59           gse = gse + 2.D0*(2.D0*xy(i,i,j,j)-xy(i,j,i,j))*occa(i)*occa(
 j)
      60         end do
      61       end do
      62       do i = 1, lab
      63         diag(i) = diagi(microa(1,i),microb(1,i),eiga,xy,nmos) - gse
      64       end do
      65       return
      66       end subroutine mecid
 
