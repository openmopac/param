       1       subroutine rotmol(numat, coord, sina, cosa, i, j, r)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5 !**********************************************************************
 *
       6 !-----------------------------------------------
       7 !   I n t e r f a c e   B l o c k s
       8 !-----------------------------------------------
       9       implicit none
      10 !-----------------------------------------------
      11 !   G l o b a l   P a r a m e t e r s
      12 !-----------------------------------------------
      13 !-----------------------------------------------
      14 !   D u m m y   A r g u m e n t s
      15 !-----------------------------------------------
      16       integer  :: numat
      17       integer , intent(in) :: i
      18       integer , intent(in) :: j
      19       double precision , intent(in) :: sina
      20       double precision , intent(in) :: cosa
      21       double precision  :: coord(3,numat)
      22       double precision  :: r(3,3)
      23 !-----------------------------------------------
      24 !   L o c a l   P a r a m e t e r s
      25 !-----------------------------------------------
      26 !-----------------------------------------------
      27 !   L o c a l   V a r i a b l e s
      28 !-----------------------------------------------
      29       integer :: k
      30       double precision :: buff
      31 !-----------------------------------------------
      32       call symopr (numat, coord, -1, r)
      33       do k = 1, 3
      34         buff = (-sina*r(k,i)) + cosa*r(k,j)
      35         r(k,i) = cosa*r(k,i) + sina*r(k,j)
      36         r(k,j) = buff
      37       end do
      38       call symopr (numat, coord, 1, r)
      39       return
      40       end subroutine rotmol
 
