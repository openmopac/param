       1       subroutine bangle(xyz, i, j, k, angle)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use common_arrays_C, only: tvec
       6       use molkst_C, only : numat, id, l11, l21, l31
       7       implicit none
       8 !-----------------------------------------------
       9 !   D u m m y   A r g u m e n t s
      10 !-----------------------------------------------
      11       integer , intent(in) :: i
      12       integer , intent(in) :: j
      13       integer , intent(in) :: k
      14       double precision , intent(out) :: angle
      15       double precision , intent(in) :: xyz(3,numat + 3)
      16 !-----------------------------------------------
      17 !   L o c a l   V a r i a b l e s
      18 !-----------------------------------------------
      19       double precision :: d2ij, d2jk, d2ik, xy, temp, Vab(3), Rab
      20       integer :: ii, jj, kk
      21 !-----------------------------------------------
      22 !********************************************************************
      23 !
      24 ! BANGLE CALCULATES THE ANGLE BETWEEN ATOMS I,J, AND K. THE
      25 !        CARTESIAN COORDINATES ARE IN XYZ.
      26 !
      27 !********************************************************************
      28       if (id == 0) then
      29         d2ij = (xyz(1,i)-xyz(1,j))**2 + (xyz(2,i)-xyz(2,j))**2 + (xyz(3
 ,i)-xyz(3,j))**2
      30         d2jk = (xyz(1,j)-xyz(1,k))**2 + (xyz(2,j)-xyz(2,k))**2 + (xyz(3
 ,j)-xyz(3,k))**2
      31         d2ik = (xyz(1,i)-xyz(1,k))**2 + (xyz(2,i)-xyz(2,k))**2 + (xyz(3
 ,i)-xyz(3,k))**2
      32       else
      33         d2ij = 1.d8
      34         d2jk = 1.d8
      35         d2ik = 1.d8
      36         do ii = -l11, l11
      37           do jj = -l21, l21
      38             do kk = -l31, l31
      39               Vab = xyz(:,i) - xyz(:,j) + tvec(:,1)*ii + tvec(:,2)*jj +
  tvec(:,3)*kk
      40               Rab = Vab(1)**2 + Vab(2)**2 + Vab(3)**2
      41               if (Rab < d2ij) then
      42                 d2ij = Rab
      43               end if
      44               Vab = xyz(:,k) - xyz(:,j) + tvec(:,1)*ii + tvec(:,2)*jj +
  tvec(:,3)*kk
      45               Rab = Vab(1)**2 + Vab(2)**2 + Vab(3)**2
      46               if (Rab < d2jk) then
      47                 d2jk = Rab
      48               end if
      49               Vab = xyz(:,i) - xyz(:,k) + tvec(:,1)*ii + tvec(:,2)*jj +
  tvec(:,3)*kk
      50               Rab = Vab(1)**2 + Vab(2)**2 + Vab(3)**2
      51               if (Rab < d2ik) then
      52                 d2ik = Rab
 
 FORCHECK PC V13.5.13          BANGLE          2021-03-24 10:59:30   page:  3661
 bangle.F90  /FF
 
      53               end if
      54             end do
      55           end do
      56         end do
      57       end if
      58       xy = sqrt(d2ij*d2jk)
      59       if (xy < 1.d-20) then
      60         angle = 0.d0
      61         return
      62       end if
      63       temp = 0.5D0*(d2ij + d2jk - d2ik)/xy
      64       temp = min(1.0D0,temp)
      65       temp = dmax1(-1.0D0,temp)
      66       angle = acos(temp)
      67       return
      68       end subroutine bangle
 
