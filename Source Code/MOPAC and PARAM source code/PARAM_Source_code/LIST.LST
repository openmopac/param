     106         call chrge(p, q)
     107         mode = 0
 
 FORCHECK PC V13.5.13          DCART           2021-03-24 10:59:30   page:  4150
 dcart.F90  /FF
 
     108       end if
     109       q(:numat) = tore(nat(:numat)) - q(:numat)
