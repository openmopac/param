  set.
     249               end if
     250             else
     251               iijj(ix) = mpack
     252               ijall(ix) = i
     253               numij(i) = ix
     254             end if
     255           end if
     256           if (id /= 0) then
     257             n2elec = n2elec + ((io*(io+1))/2) ** 2
     258           end if
     259           mpack = mpack + (io*(io+1)) / 2
     260       end do
     261       !
     262       if (count) then
     263         ij_dim = ix
     264       end if
     265       !
     266       !  Leave room for dummy atom integrals and for gradients
