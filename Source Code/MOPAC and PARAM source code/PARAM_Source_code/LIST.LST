     816 subroutine dmecip (coeffs, deltap, delta, eig, vectci, conf)
     817     use molkst_C, only : numat, norbs, lm61
     818     use meci_C, only : lab, nmos, nstate, nelec, microa, microb, occa,
 nalmat
     819     use cosmo_C, only : nps, fnsq, amat, bmat, nsetf, &
     820     phinet, qscnet, qdenet
     821     use common_arrays_C, only : nfirst, nlast
     822     use funcon_C, only : ev, a0
     823     implicit none
     824     double precision, dimension (lab), intent (inout) :: eig, vectci
     825     double precision, dimension (lab**2), intent (in) :: conf
     826     double precision, dimension (norbs, norbs), intent (in) :: coeffs
     827     double precision, dimension (norbs, nmos), intent (inout) :: delta
     828     double precision, dimension (nmos, nmos), intent (inout) :: deltap
     829     integer :: i, iat, id, iden, ii, ij, ist, ix, iy, j, jd, k
     830     double precision :: edie, fact, sum
     831
     832     fact = -ev * a0 * fnsq / 2
     833     do ist = 1, lab
     834       ii = lab * (ist - 1)
     835       do j = 1, lab
     836         vectci(j) = conf(ii + j)
     837       end do
     838       !     INITIALIZE WITH THE OPPOSITE OF THE 'SCF' DENSITY.
     839       do i = 1, nmos
     840         deltap(i, i) = -occa(i) * 2.d0
     841         do j = 1, i - 1
     842           deltap(i, j) = 0.d0
     843         end do
     844       end do
     845       !
     846       !     ADD THE C.I. CORRECTION
     847       do id = 1, lab
     848         do jd = 1, id
     849             !     CHECK SPIN AGREEMENT
     850           if (nalmat(id) == nalmat(jd)) then
     851             ix = 0
     852             iy = 0
     853             do j = 1, nmos
     854               ix = ix + Abs (microa(j, id) - microa(j, jd))
     855               iy = iy + Abs (microb(j, id) - microb(j, jd))
     856             end do
     857                !     CHECK NUMBER OF DIFFERING M.O.
     858             if (ix + iy  <= 2) then
     859               if (ix == 2) then
     860                 ! DETERMINANTS ID AND JD DIFFER BY M.O I IN ID AND M.O
 J IN JD:
     861                 do i = 1, nmos
     862                   if (microa(i, id) /= microa(i, jd)) exit
     863                 end do
     864                 ij = microb(i, id)
     865                 do j = i + 1, nmos
     866                   if (microa(j, id) /= microa(j, jd)) exit
     867                   ij = ij + microa(j, id) + microb(j, id)
     868                 end do
     869                 !        IJ GIVES THE SIGN OF THE PERMUTATION
     870                 sum = 0.d0
     871                 do k = 1, nstate
 
