     981   subroutine simple_mm (coord, nc, n, q, res, dir_int, far_int, &
     982        & tricky_multipoles)
     983
     984     !
     985     !.. Implicit Declarations ..
     986     implicit none
     987     !
     988     !.. Formal Arguments ..
     989     integer, intent(in) :: nc, n
