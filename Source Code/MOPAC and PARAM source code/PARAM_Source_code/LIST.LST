    2519       subroutine hmuf(h1, id, coord, nfirst, nlast, nat, norbs, numat)
    2520 !-----------------------------------------------
    2521 !   M o d u l e s
    2522 !-----------------------------------------------
    2523       USE parameters_C, only : dd
    2524 !-----------------------------------------------
    2525 !   I n t e r f a c e   B l o c k s
    2526 !-----------------------------------------------
    2527       implicit none
    2528 !-----------------------------------------------
    2529 !   D u m m y   A r g u m e n t s
    2530 !-----------------------------------------------
    2531       integer , intent(in) :: id
    2532       integer  :: norbs
    2533       integer , intent(in) :: numat
    2534       integer , intent(in) :: nfirst(numat)
    2535       integer , intent(in) :: nlast(numat)
    2536       integer , intent(in) :: nat(numat)
    2537       double precision  :: h1(norbs,norbs)
    2538       double precision , intent(in) :: coord(3,*)
    2539 !-----------------------------------------------
    2540 !   L o c a l   V a r i a b l e s
    2541 !-----------------------------------------------
    2542       integer :: i, ia, ib, ni, i1, j1, io1, jo1
    2543 !-----------------------------------------------
    2544 !
    2545 !  FORM THE DIPOLE MOMENT MATRIX FOR COMPONENT ID
    2546 !
    2547 !
    2548 !  ZERO H1 MATRIX
    2549 !
    2550       call zerom (h1, norbs)
    2551 !
    2552 !  FORM DIPOLE MATRIX
    2553 !
    2554       do i = 1, numat
    2555         ia = nfirst(i)
    2556         ib = min(nlast(i), ia + 3)
    2557         ni = nat(i)
    2558         do i1 = ia, ib
    2559           do j1 = ia, i1
    2560             h1(i1,j1) = 0.0D00
    2561             io1 = i1 - ia
    2562             jo1 = j1 - ia
    2563             if (id==1 .and. jo1==0 .and. io1==1) then
    2564               h1(i1,j1) = dd(ni)
    2565               h1(j1,i1) = dd(ni)
    2566             end if
    2567             if (id==2 .and. jo1==0 .and. io1==2) then
    2568               h1(i1,j1) = dd(ni)
    2569               h1(j1,i1) = dd(ni)
    2570             end if
    2571             if (.not.(id==3 .and. jo1==0 .and. io1==3)) cycle
    2572             h1(i1,j1) = dd(ni)
    2573             h1(j1,i1) = dd(ni)
    2574           end do
    2575           h1(i1,i1) = 0.0D00
    2576 !.. ADDED FOR TRANSLATION OF CENTER FROM ORIGIN
 
 FORCHECK PC V13.5.13           HMUF           2021-03-24 10:59:30   page:  2643
 polar.F90  /FF
 
    2577           h1(i1,i1) = h1(i1,i1) + 1.8897262D0*coord(id,i)
    2578         end do
    2579       end do
    2580 !
    2581       return
    2582       end subroutine hmuf
 
 FORCHECK PC V13.5.13           HMUF           2021-03-24 10:59:30   page:  2644
