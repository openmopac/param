      97   subroutine prt_sorted_gradients
      98     use molkst_C, only: natoms, nvar, maxtxt, pdb_label
      99     use chanel_C, only: iw
     100     use elemts_C, only: elemnt
     101     use common_arrays_C, only : grad, txtatm, loc, labels, coord
     102     implicit none
     103     character (len=30) :: blank
     104     integer :: i, j, k, l, m
     105     double precision :: glim, gmax, sum
     106     double precision, dimension (3) :: tmp
     107     double precision, allocatable :: mod_grad(:), grads(:,:)
     108     if (nvar < 3) return
     109     allocate (mod_grad(natoms), grads(3,natoms))
     110     mod_grad = 0.d0
     111     l = 1
     112     do i = 1, natoms
     113       j = 0
     114       if (l <= nvar) then
     115         tmp = 0.d0
     116         do m = 1, 3
     117           if (loc(1, l) == i .and. loc(2, l) == m) then
     118             j = j + 1
     119             tmp(m) = grad(l)
     120             l = l + 1
     121           end if
     122         end do
     123         mod_grad(i) = sqrt(tmp(1)**2 + tmp(2)**2 + tmp(3)**2)
     124         grads(:,i) = tmp(:)
     125       end if
     126     end do
     127     if (pdb_label) then
     128       write(iw,'(/10x, a, //1x, a, 16x, a, 19x,a, 11x, a, 7x, a)')"LARG
 EST ATOMIC GRADIENTS","Atom","Label", &
     129       "Cartesian Gradients", "Cartesian Coordinates", " |Gradient|"
     130     else
     131       write(iw,'(/10x, a, //10x, a, 5x, a, 21x,a, 11x, a, 6x, a)')"LARG
 EST ATOMIC GRADIENTS","Atom","Label", &
     132       "Cartesian Gradients", "Cartesian Coordinates", " |Gradient|"
     133     end if
     134     write(iw,'(41x, a, 8x, a, /)')"  X          Y          Z", "X
     Y          Z"
     135     gmax = 0.d0
     136     glim = 1.d6
     137     blank = " "
     138     do i = 1, min(20, natoms)
     139       sum = gmax
     140       do j = 1, natoms
     141         if (mod_grad(j) > sum .and. mod_grad(j) < glim) then
     142           sum = mod_grad(j)
     143           k = j
     144         end if
     145       end do
     146       if (sum < 1.d-3) exit
     147       if (pdb_label) then
     148       write (iw, '(i5, a, 3f11.3, 3f11.5, f11.3)') k, " " // elemnt (la
 bels(k)) // "(" // txtatm (k) &
     149          & (:maxtxt) // ")" // blank (maxtxt+3:17), grads(:,k), coord(:
 ,k), sum
 
 FORCHECK PC V13.5.13   PRT_SORTED_GRADIENTS   2021-03-24 10:59:30   page:  1786
 prtgra.F90  /FF
 
     150       else
     151          write (iw, '(i14, 5x, a, 13x, 3f11.3, 3f11.5, f11.3)') k, " "
 // elemnt (labels(k)),grads(:,k), coord(:,k), sum
     152       end if
     153       glim = sum
     154       if (i > 9 .and. sum < 50) exit
     155     end do
     156     return
     157   end subroutine prt_sorted_gradients
 
 FORCHECK PC V13.5.13   PRT_SORTED_GRADIENTS   2021-03-24 10:59:30   page:  1787
