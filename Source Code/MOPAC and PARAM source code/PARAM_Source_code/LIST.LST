     242       end do
     243 !
     244 ! If C found, look for the second O
     245 !
     246       if (cc /= -1) then
     247         odist = 9.9d9
     248         cv_cc = 0.d0
     249         do k = 1, numat
     250           v = cvalence_contribution(cc, k, d_list, nd_list)
     251           cv_cc = cv_cc + v
     252           sum = distance(cc, k)
     253           if ((v > 0.d0) .and. (k /= o1) .and. (nat(k) == 8) .and. (sum
  < odist)) then
     254             odist =  sum
     255             o2 = k
     256           end if
     257         end do
     258       end if
     259 !
     260 ! O1-C-O2 triad:
     261 !
     262       if (o2 /= -1) then
     263 !
     264 ! Get O2 valence
     265 !
     266         cv_o2 = 0.d0
     267         do k = 1, numat
     268           cv_o2 = cv_o2 +cvalence_contribution(o2, k, d_list, nd_list)
     269         end do
     270         f_o1 = max(1.d0 - abs(1.d0 - cv_o1), 0.d0)
     271         f_o2 = max(1.d0 - abs(1.d0 - cv_o2), 0.d0)
     272         f_cc = max(1.d0 - abs(3.d0 - cv_cc), 0.d0)
