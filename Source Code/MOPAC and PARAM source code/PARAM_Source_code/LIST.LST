    1617   !
    1618     subroutine cmprlb (n, m, x, g, ws, wy, sy, wt, z, r, wa, index, the
 ta, &
    1619    & col, head, nfree, cnstnd, info)
    1620       implicit none
    1621       logical, intent (in) :: cnstnd
    1622       integer, intent (in) :: col, head, m, n, nfree
    1623       integer, intent (inout) :: info
    1624       double precision, intent (in) :: theta
    1625       integer, dimension (n), intent (in) :: index
    1626       double precision, dimension (4*m), intent (inout) :: wa
    1627       double precision, dimension (n), intent (in) :: g, x, z
    1628       double precision, dimension (n), intent (inout) :: r
    1629       double precision, dimension (m, m), intent (in) :: sy
    1630       double precision, dimension (m, m), intent (inout) :: wt
    1631       double precision, dimension (n, m), intent (in) :: ws, wy
    1632       integer :: i, j, k, pointr
    1633       double precision :: a1, a2
    1634       intrinsic Mod
    1635       if ( .not. cnstnd .and. col > 0) then
    1636         do i = 1, n
    1637           r(i) = -g(i)
    1638         end do
    1639       else
    1640         do i = 1, nfree
    1641           k = Index(i)
    1642           r(i) = -theta * (z(k)-x(k)) - g(k)
    1643         end do
    1644         call bmv (m, sy, wt, col, wa(2*m+1), wa(1), info)
    1645         if (info /= 0) then
    1646           info = -8
    1647           return
    1648         end if
    1649         pointr = head
    1650         do j = 1, col
    1651           a1 = wa(j)
    1652           a2 = theta * wa(col+j)
    1653           do i = 1, nfree
    1654             k = Index(i)
    1655             r(i) = r(i) + wy(k, pointr) * a1 + ws(k, pointr) * a2
    1656           end do
    1657           pointr = Mod (pointr, m) + 1
    1658         end do
    1659       end if
    1660     !
    1661     end subroutine cmprlb
 
