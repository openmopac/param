       1       subroutine dang(a1, a2, b1, b2, rcos)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       implicit none
       6 !-----------------------------------------------
       7 !   D u m m y   A r g u m e n t s
       8 !-----------------------------------------------
       9       double precision , intent(inout) :: a1
      10       double precision , intent(inout) :: a2
      11       double precision , intent(inout) :: b1
      12       double precision , intent(inout) :: b2
      13       double precision , intent(out) :: rcos
      14 !-----------------------------------------------
      15 !   L o c a l   V a r i a b l e s
      16 !-----------------------------------------------
      17       double precision :: zero, anorm, bnorm, sinth, costh
      18 !-----------------------------------------------
      19 !*********************************************************************
      20 !
      21 !    DANG  DETERMINES THE ANGLE BETWEEN THE POINTS (A1,A2), (0,0),
      22 !          AND (B1,B2).  THE RESULT IS PUT IN RCOS.
      23 !
      24 !*********************************************************************
      25       zero = 1.0D-6
      26       if (abs(a1) >= zero .or. abs(a2) >= zero) then
      27         if (abs(b1) >= zero .or. abs(b2) >= zero) then
      28           anorm = 1.0D0/sqrt(a1**2 + a2**2)
      29           bnorm = 1.0D0/sqrt(b1**2 + b2**2)
      30           a1 = a1*anorm
      31           a2 = a2*anorm
      32           b1 = b1*bnorm
      33           b2 = b2*bnorm
      34           sinth = a1*b2 - a2*b1
      35           costh = a1*b1 + a2*b2
      36           costh = min(1.0D0,costh)
      37           costh = dmax1(-1.0D0,costh)
      38           rcos = acos(costh)
      39           if (abs(rcos) >= 4.0D-5) then
      40             if (sinth > 0.D0) rcos = 6.28318530717959D0 - rcos
      41             rcos = -rcos
      42             return
      43           end if
      44         end if
      45       end if
      46       rcos = 0.0D0
      47       return
      48       end subroutine dang
 
