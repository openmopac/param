       1       double precision function capcor (nat, nfirst, nlast, p, h)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use molkst_C, only : numat
       6       implicit none
       7 !-----------------------------------------------
       8 !   D u m m y   A r g u m e n t s
       9 !-----------------------------------------------
      10       integer , intent(in) :: nat(numat)
      11       integer , intent(in) :: nfirst(numat)
      12       integer , intent(in) :: nlast(numat)
      13       double precision , intent(in) :: p(*)
      14       double precision , intent(in) :: h(*)
      15 !-----------------------------------------------
      16 !   L o c a l   V a r i a b l e s
      17 !-----------------------------------------------
      18       integer :: i, ni, il, iu, j, ii, k, jl, kk
      19       double precision :: sum
      20 !-----------------------------------------------
      21 !*****************************************************************
      22 !
      23 !    CORRECTION TO ELECTRONIC ENERGY DUE TO CAPPED BONDS
      24 !
      25 !*****************************************************************
      26       sum = 0.D0
      27       do i = 1, numat
      28         ni = nat(i)
      29         il = nfirst(i)
      30         iu = nlast(i)
      31         if (ni == 102) then
      32 !
      33 !   DO ENTIRE ROW - NO NEED TO CHECK FURTHER.
      34 !
      35           j = (nlast(i)*(nlast(i)+1))/2
      36           ii = iu - 1
      37           do k = 1, ii
      38             j = j - 1
      39             sum = sum + p(j)*h(j)
      40           end do
      41         else
      42           do j = 1, i
      43             jl = nfirst(j)
      44             if (nat(j) /= 102) cycle
      45             do k = il, iu
      46               kk = (k*(k - 1))/2 + jl
      47               sum = sum + p(kk)*h(kk)
      48             end do
      49           end do
      50         end if
      51       end do
      52 !
      53 !   DOUBLE SUM SINCE WE ONLY CALCULATED LOWER HALF, AND CAPCOR
      54 !   WILL APPEAR IN 1/2*P(H+F).  ONLY H PART OF F WILL BE USED.
      55       capcor = -sum*2.D0
      56       return
      57       end function capcor
 
