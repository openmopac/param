     181 !
     182 !
     183 !
     184 subroutine remove_bond(i)
     185   use common_arrays_C, only: coord, nbonds, ibonds
     186 !
     187 !  Remove the longest bond from atom i
     188 !
     189   implicit none
     190   integer, intent (in) :: i
     191   double precision :: rmax, sum
     192   integer :: j, k, l
     193   rmax = 0.d0
     194   l = 0
     195   do j = 1, nbonds(i)
     196     k = ibonds(j,i)
     197     sum = (coord(1, i)-coord(1, k)) ** 2 + &
     198           (coord(2, i)-coord(2, k)) ** 2 + &
     199           (coord(3, i)-coord(3, k)) ** 2
     200     if (sum > rmax) then
     201       rmax = sum
     202       l = k
     203     end if
     204   end do
     205   k = 0
     206   do j = 1, nbonds(i)
     207     if (ibonds(j,i) /= l) then
     208       k = k + 1
     209       ibonds(k,i) = ibonds(j,i)
     210     end if
     211   end do
     212   nbonds(i) = nbonds(i) - 1
     213   k = 0
     214   do j = 1, nbonds(l)
     215     if (ibonds(j,l) /= i) then
     216     k = k + 1
     217       ibonds(k,l) = ibonds(j,l)
     218     end if
     219   end do
     220   nbonds(l) = nbonds(l) - 1
     221   end subroutine remove_bond
 
