    3097     subroutine dpofa (a, lda, n, info)
    3098       implicit none
    3099       integer, intent (in) :: lda
    3100       double precision, dimension (lda,*), intent (inout) :: a
    3101       integer, intent (in) :: n
    3102       integer, intent (inout) :: info
    3103        integer :: j, jm1, k
    3104       double precision :: s, t
    3105       double precision, external :: ddot
    3106     !     begin block with ...exits to 40
    3107     !
    3108     !
    3109       do j = 1, n
    3110         info = j
    3111         s = 0.0d0
    3112         jm1 = j - 1
    3113         if (jm1 >= 1) then
    3114           do k = 1, jm1
    3115             t = a(k, j) - ddot (k-1, a(1, k), 1, a(1, j), 1)
    3116             t = t / a(k, k)
    3117             a(k, j) = t
    3118             s = s + t * t
    3119           end do
    3120         end if
    3121         s = a(j, j) - s
    3122        !     ......exit
    3123         if (s <= 0.0d0) return
    3124         a(j, j) = Sqrt (s)
    3125       end do
    3126       info = 0
    3127     end subroutine dpofa
 
