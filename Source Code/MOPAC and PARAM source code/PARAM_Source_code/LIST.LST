      13       double precision , intent(in) :: r(3,3)
      14       integer :: i, k
      15       double precision, dimension(5,5,12) :: t1
      16       double precision, dimension(3,3) :: s
      17       double precision :: h(5)
      18 !-----------------------------------------------
      19       if (first) then
      20         first = .FALSE.
      21 !
      22 !  Copy r into s because dtrans modifies the first argument
      23 !
      24         s = r
      25         t1 = 0.d0
      26         call dtran2 (s, t1, 1)
      27         do k = 2, nclass
      28           s = elem(:,:,k)
      29           call dtran2 (s, t1, k)
      30         end do
      31       end if
      32 !
      33 !  Matrix multiply d*t1*d(trans)
      34 !
      35       do i = 1, 5
      36         h(i) = 0.D0
      37         h(i) = h(i) + sum(t1(i,:,1)*d)
      38       end do
      39       do i = 1, 5
      40         d(i) = 0.D0
      41         d(i) = d(i) + sum(t1(:,i,ioper)*h)
      42       end do
      43       return
      44       end subroutine dtrans
 
