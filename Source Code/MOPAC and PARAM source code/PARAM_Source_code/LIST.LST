     116   subroutine bpnew_vec (v)
     117     !
     118     ! Interaction of electronic densities with induced charges
     119     !
     120
     121     use molkst_C, only : numat
     122     use cosmo_C, only : nps, cosurf
     123     use common_arrays_C, only: coord, nfirst, nlast, nat, p
     124     use parameters_C, only : dd, qq
     125     use funcon_C, only : a0
     126     implicit none
     127     double precision, dimension(nps), intent (out) :: v
     128     integer :: i, j, k, l, m, jj, nao, ni
     129     double precision :: dx, dy, dz, r, t, dip, quad
     130     double precision :: w(45)
     131     v(1:nps) = 0.d0
     132     dip = 0.d0
     133     quad = 0.d0
     134
     135     do j=1, numat
     136       nao = nlast(j)-nfirst(j)
     137       jj = ijbo_diag(j )
     138
     139       if (nao > 0) then
     140         ni = nat(j)
     141         dip = dd(ni) * a0
     142         quad = (a0 *qq(ni))** 2
     143       end if
     144
     145       do i=1, nps
     146
     147         dx= cosurf(1, i) - coord(1, j)
     148         dy= cosurf(2, i) - coord(2, j)
     149         dz= cosurf(3, i) - coord(3, j)
     150
     151         r = 1.d0 / Sqrt (dx**2 + dy**2 + dz**2)
     152
     153         if (nao == 0) then ! --- S-element
     154           v(i) = v(i) - p(jj+1) * r
     155           cycle
     156
     157         else ! --- sp element
     158
     159            w(1) = r
     160
     161            dx = dx * r
     162            dy = dy * r
     163            dz = dz * r
     164
     165            t = dip * r*r
     166
     167            w(2) =  dx * t
     168            w(4) =  dy * t
     169            w(7) =  dz * t
     170
     171            t = quad * r*r*r
     172            w(3)  = r + (3.d0*dx**2 - 1.d0) * t
     173            w(6)  = r + (3.d0*dy**2 - 1.d0) * t
 
 FORCHECK PC V13.5.13        BPNEW_VEC         2021-03-24 10:59:30   page:  2228
 linear_cosmo.F90  /FF
 
     174            w(10) = r + (3.d0*dz**2 - 1.d0) * t
     175
     176            w(5) = 3.d0*dx*dy * t
     177            w(8) = 3.d0*dx*dz * t
     178            w(9) = 3.d0*dy*dz * t
     179
     180            if (nao > 3) then ! --- d - element
     181               w(11:45) = 0
     182               w(15) = r
     183               w(21) = r
     184               w(28) = r
     185               w(36) = r
     186               w(45) = r
     187            end if
     188         end if
     189
     190         m = 0
     191         t = 0.d0
     192         do k = 1, nao+1
     193           do l = 1, k-1
     194             m = m + 1
     195             t = t - 2*p(jj+m) * w(m)
     196           end do
     197           m = m + 1
     198           t = t - p(jj+m) * w(m)
     199         end do
     200
     201         !!write(26,*) ' Pair :', i, j
     202         !!write(26,*) ( w(k),k=1,((nao+1)*(nao+2))/2 )
     203
     204         v(i) = v(i) + t
     205       end do
     206     end do
     207
     208   end subroutine bpnew_vec
 
