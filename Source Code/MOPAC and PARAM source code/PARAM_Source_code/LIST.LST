     863 !  Label any remaining atoms
     864 !
     865     do i = 1, natoms - id
     866       if (txtatm(i) (26:26) == " ") then
     867         el = cap_elemnt(nat(i))
     868         if (el(2:2) == " ") el = " "//el(1:1)
