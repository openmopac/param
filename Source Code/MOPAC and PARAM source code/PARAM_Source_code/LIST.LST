     477       double precision function trsub (ul, x, ur, l1, lm, ndim)
     478 !-----------------------------------------------
     479 !   M o d u l e s
     480 !-----------------------------------------------
     481 ! THIS PROGRAM CALCULATES TRACES OF MATRICES
     482       implicit none
     483 !-----------------------------------------------
     484 !   D u m m y   A r g u m e n t s
     485 !-----------------------------------------------
     486       integer , intent(in) :: l1
     487       integer , intent(in) :: lm
     488       integer , intent(in) :: ndim
     489       double precision , intent(in) :: ul(ndim,ndim)
     490       double precision , intent(in) :: x(ndim,ndim)
     491       double precision , intent(in) :: ur(ndim,ndim)
     492 !-----------------------------------------------
     493 !   L o c a l   V a r i a b l e s
     494 !-----------------------------------------------
     495       integer :: i, k, l
     496       double precision :: sum, suml
     497 !-----------------------------------------------
     498 !
     499       sum = 0.0D00
     500       do i = 1, l1
     501         do k = 1, lm
     502           suml = 0.0D00
     503           do l = 1, lm
     504             suml = suml + x(k,l)*ur(l,i)
     505           end do
     506           sum = sum + suml*ul(i,k)
     507         end do
     508       end do
     509       trsub = 2.0D00*sum
     510       return
     511       end function trsub
 
