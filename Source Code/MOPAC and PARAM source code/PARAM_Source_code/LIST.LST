     353 !     *****************************************************************
 ********
     354
     355       subroutine ovlaap (n1, l1, amu, n2, l2, bmu, r, s, sp, sd, sf)
     356 !
     357 !     evaluates overlap between two slater type orbitals.
     358 !     n1, n2, are princ. q.no. - s, l1, l2, are secondary q.n. - s, , a
 mu and
     359 !     bmu are the exponential constants. r is the separation in angstro
 m
     360 !     s is the sigma, sp the pi, sd the delta and sf the f compoents of
     361 !     the overlap, to be put together using lh and sub. geom.
     362 !     fact(i + 1) = factorial i.
     363 !
     364       use reimers_C, only : au2ang, pp, fact, ss
     365
     366       implicit none
     367       double precision ::  zero, one, two, &
     368                         f, p, r, s, t, &
     369                         amu, bmu, rr, sp, sd, sf, ssss, tt
     370       integer ::           i, ii, l1, l2, lmin, mm, n1, n2, nn
     371       save :: tt
     372
     373       data              zero/0.d0/, one/1.d0/, two/2.d0/
     374
     375       if (abs(pp + 10.d0) < 1.d-10)then
     376       tt = zero
     377       end if
     378       rr = r/au2ang
     379       p = (amu + bmu)*rr/two
     380       t = (amu - bmu)/(amu + bmu)
     381       if (r <= 1.d-3) go to 300
     382       if(dabs (t) <= 1.d-4) t = zero
     383       if(abs(p - pp) < 1.d-10 .and. abs(t - tt) < 1.d-10) go to 5
     384       pp = p
     385       tt = t
     386       call aux (p, t)
     387     5 continue
     388       ss(2) = zero
     389       ss(3) = zero
     390       ss(4) = zero
     391       lmin = l1
     392       if (l2 < l1) lmin = l2
     393       lmin = lmin + 1
     394       do 10 ii = 1, lmin
     395       i = ii - 1
     396       call molpab (n1, n2, l1, l2, i, i, amu, bmu, rr, ssss)
     397       ss(ii) = ssss
     398    10 continue
     399       s = ss(1)
     400       sp = ss(2)
     401       sd = ss(3)
     402       sf = ss(4)
     403       go to 500
     404 !     one center overlap.
     405   300 s = zero
     406       sp = zero
     407       sd = zero
 
 FORCHECK PC V13.5.13          OVLAAP          2021-03-24 10:59:30   page:  2063
 ovlp.F90  /FF
 
     408       sf = zero
     409       if (l1 /= l2) go to 500
     410       nn = 2*n1 + 1
     411       mm = 2*n2 + 1
     412       f = (one - t)**mm*(one + t)**nn
     413       s = fact(n1 + n2 + 1)*dsqrt(f/(fact(nn)*fact(mm)))
     414       if (l1 > 0) sp = (- one)**(l1 + 1)*s
     415       if (l1 > 1) sd = (- one)**(l1 + 2)*s
     416       if (l1 > 2) sf = (- one)**(l1 + 3)*s
     417       s = (- one)**l1*s
     418   500 continue
     419       return
     420       end subroutine ovlaap
 
