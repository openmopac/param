 .0d0)))
     285         else
     286 !
     287 ! In very strong X - H - Y systems the X - Y distance is small, so an i
 ncreased
     288 ! X - H minimum distance is expected, therefore do not dampen the funct
 ion.
     289 !
     290           damping = 1.d0
     291         end if
     292 ! y-x damping
     293         xc_dist = distance(hblist(i, 1), hblist(i, 5))
     294
     295 !
 
 FORCHECK PC V13.5.13         EH_PLUS          2021-03-24 10:59:30   page:  3536
 H_bond_correction_EH_plus.F90  /FF
 
     296 ! Make damping a function of the O - O distance
     297 ! Damping is decreased as the O - O distances approaches shortcut Angst
 roms
     298 !
     299         damping = damping/(1.d0 + exp( -100.d0*(xc_dist/shortcut - 1.d0
 )))
     300 !
     301 ! At very large O - O distances, make damping go to zero
     302 !
     303         damping = damping*(1.d0 - 1.d0/(1.d0 + exp( -10.d0*(xc_dist/lon
 gcut - 1.d0))))
     304         XY_dist = distance(hblist(i, 1), hblist(i, 5))
     305 !
     306 !   angle_cos       = cos(angle between donor-hydrogen-acceptor)
     307 !   angle2_cos      = cos(difference between optimum DA-D-H and actual
 DA-D-H angle)
     308 !   torsion_cos     =
     309 !   angle2_cos_new  = cos(difference between optimum AA-A-H and actual
 AA-A-H angle)
     310 !   torsion_cos_new = cos(difference between optimum AA'-AA-A-H and act
 ual AA'-AA-A-H torsion angle)
     311 !
     312         EH_plus = scale_c/XY_dist**2.d0*angle_cos**2* &
     313           (1.d0 - (1.d0 - angle2_cos*torsion_cos*angle2_cos_new*torsion
 _cos_new)**2)*hartree2kcal*damping
     314         if (nat(hblist(i, 1)) == 8 .and. nat(hblist(i, 5)) == 8) then
     315 !
     316 !  Add in extra stabilization as the O - O distance approaches 2.41 Ang
 stroms.
     317 !  As a guide, formic acid dimer has O - O: 2.67 Angstroms, stabilizati
 on should total 18.61 kcal/mol
     318 !              the H5O2(+) ion has O - O: 2.38 - 2.43 Angstroms
     319 !
     320           short = -2.5d0*exp(-80.d0*(max(XY_dist - 2.67d0, 0.d0))**2)*a
 ngle_cos**4
     321           EH_plus = EH_plus + short
     322         end if
     323       else
     324 ! y-h damping
     325       damping = 1.d0 - 1.d0/(1.d0 + exp( -60.d0*(xc_dist/covcut - 1.d0)
 ))
     326 ! y-x damping
     327       xc_dist = distance(hblist(i, 1), hblist(i, 5))
     328
     329 ! short range
     330       damping = damping/(1.d0 + exp( -100.d0*(xc_dist/shortcut - 1.d0))
 )
     331 ! long range
     332       damping = damping*(1.d0 - 1.d0/(1.d0 + exp( -10.d0*(xc_dist/longc
 ut - 1.d0))))
     333         EH_plus = scale_c/distance(hblist(i, 1), hblist(i, 5))**2.d0* &
     334         angle_cos**2*angle2_cos**2*torsion_cos**2*angle2_cos_new**2*tor
 sion_cos_new**2*hartree2kcal*damping
     335       end if
     336     end if
     337     return
     338   end function EH_plus
 
