       1       subroutine scfmat (v, shft)
       2
       3 !     *****************************************************************
 *******
       4 !     **** generates the Fock matrices F for each shell plus determins
 the ***
       5 !     **** variational energy using trace formula, V.
     ***
       6 !     **** then it constracts the total fock operator in A,
     ***
       7 !     **** using SHFT as a shift of the virtual energy levels in AII.
     ***
       8 !     **** D = each shells density matrix (d, ff in symmetric storage m
 ode)  ***
       9 !     ****   D is destroyed if open shell or damped closed shell
     ***
      10 !     **** P = atomic charges from each shell; BETA, U = 1 e matr; GAMM
 A = 2e ***
      11 !     **** C = previous set of MO coefficients if first element  >  - 1
 .     ***
      12 !     *****************************************************************
 *******
      13 !     **** References:
     ***
      14 !     ****   ROHF: Edwards and Zerner Theor Chim Acta 72 (1987) 347
     ***
      15 !     ****         eqn 27 for v, eqn 33 for shell Fock matrices
     ***
      16 !     ****         eqn 24 is solved in previous MO basis for the total
      **
      17 !     ****         Fock operator by putting
     ***
      18 !     ****           alam = n(nu)/n(mu)*LAMBDA(mu, nu) - LAMBDA(nu, mu)
     ***
      19 !     ****           so that cross term is alam*(F(nu) - F(mu))*n(mu)/n
 (nu)  ***
      20 !     ****           alam is arbitrary non - zero, is set to 1 herein
     ***
      21 !     ****         eqn 24 is extended by a VIRTUAL - VIRTUAL term desig
 ned   ***
      22 !     ****           to produce better virtual eigenvalues
     ***
      23 !     ****         Errors: eqn 24, no 1/n(mu); eqn 33 F(hat) = not F =
     ***
      24 !     ****   INDO (Rotationally invariant for Transition Metals):
     ***
      25 !     ****         Bacon and Zerner Theor Chim Acta 53 (1979) 21
     ***
      26 !     ****         with additional R integrals included
     ***
      27 !     *****************************************************************
 *******
      28
      29       use molkst_C, only : mpack, norbs
      30       use reimers_C, only : n, na, nb2, matind, occfr, nel, nshell, nor
 bl, &
      31           norbh, nbf, ibf, iat, ig1, ig2, ig3, ig4, g, nirreg, natt, &
      32           avec1, bvec1, avec2, bvec2, ppg, pg, dia, dd, ff, aa, cc0, &
 
 FORCHECK PC V13.5.13          SCFMAT          2021-03-24 10:59:30   page:   182
 scf.F90  /FF
 
      33           beta, gamma
      34
      35       implicit none
      36       double precision ::   q, v, avec10, &
      37                          ga, gk, hg, off, shft, wt
      38       integer ::            i, j, k, irreg, &
      39                          ib, is, ishell, jb, jshell, &
      40                          k1, k2, k3, k4, mu, nm, nu
      41
      42       double precision :: eltot
      43       double precision :: dd1(mpack, 2)
      44
      45       avec10 = 0.d0
      46       hg = 0.d0
      47       v = 0.d0
      48
      49 !     **** diagonal term, sum Coulomb integrals from all other atoms **
 **
      50       if (.not. allocated(pg)) allocate(pg(na, 0:2))
      51       if (.not. allocated(ppg)) allocate(ppg(norbs, 0:2))
      52
      53       do ishell = 0, nshell
      54         do ib = 1, n
      55           ppg(ib, ishell) = 0.d0
      56         end do
      57         do i = 1, na
      58           pg(i, ishell) = 0.d0
      59         end do
      60       end do
      61
      62       do ib = 1, n
      63         i = iat(ib)
      64
      65         do jb = 1, n
      66           j = iat(jb)
      67           ga = gamma(ib, jb)
      68           if (ib < jb) ga = gamma(jb, ib)
      69           nm = matind(jb) + jb
      70           call veccou (nm, avec1, bvec1)
      71           do ishell = 0, nshell
      72             if (ib == jb) then
      73 !             **** weighted charges ****
      74               pg(i, ishell) = pg(i, ishell) + avec1(ishell)
      75             else if (i /= j) then
      76 !             **** weighted sums over all other atoms ****
      77               ppg(ib, ishell) = ppg(ib, ishell) + avec1(ishell) * ga
      78             end if
      79           end do
      80         end do
      81
      82       end do
      83
      84 !     ************ Shell Fock matrices for different Hamiltonians *****
 ********
      85
      86 !       **** INDO Hamiltonian ****
      87       do i = 1, na
      88         do mu = ibf(i), ibf(i) + nbf(i) - 1
      89 !         **** terms in diagonal atom - atom block ****
 
 FORCHECK PC V13.5.13          SCFMAT          2021-03-24 10:59:30   page:   183
 scf.F90  /FF
 
      90
      91 !         **** zero counters for the diagonal energy ****
      92           do is = 0, nshell
      93             dia(is) = 0.d0
      94           end do
      95
      96 !         **** loop over all other densities on this atom ****
      97         do nu = ibf(i), ibf(i) + nbf(i) - 1
      98
      99 !           **** load the (nu, nu) elements of density matrix ****
     100             nm = matind(nu) + nu
     101             call veccou (nm, avec1, bvec1)
     102             if (mu > nu) then
     103 !             **** load the (mu, nu) elements of density matrix ****
     104               nm = matind(mu) + nu
     105               call veccou (nm, avec2, bvec2)
     106             end if
     107
     108             do is = 0, nshell
     109               if (mu == nu) then
     110                 dia(is) = dia(is) + gamma(mu, mu) * (avec1(is) - bvec1(
 is))
     111                 avec10 = avec1(0)
     112               else if (mu > nu) then
     113 !               **** gamma(mu, nu) = (mu, mu|nu, nu); gamma(nu, mu) = (
 mu, nu|mu, nu) ***
     114                 dia(is) = dia(is) + gamma(mu, nu)*avec1(is)&
     115      &                          - gamma(nu, mu)*bvec1(is)
     116 !               **** same atom but different basis functions ****
     117                 off = gamma(nu, mu) * (2.d0*avec2(is) - bvec2(is))&
     118      &            - gamma(mu, nu) * bvec2(is)
     119                 if (is == 0) then
     120                   hg = off
     121                   v = v + off * avec2(0)
     122                 else
     123                   ff(nm, is) = hg - off
     124                   v = v - off * dd(nm, is)
     125                 end if
     126               else
     127                 dia(is) = dia(is) + gamma(nu, mu)*avec1(is)&
     128      &                          - gamma(mu, nu)*bvec1(is)
     129               end if
     130             end do
     131           end do
     132
     133 !         **** store fully diagonal terms ****
     134           nm = matind(mu) + mu
     135           hg = beta(nm) + ppg(mu, 0) + dia(0)
     136           v = v + (beta(nm) + hg) * avec10 * 0.5d0
     137           do is = 1, nshell
     138             q = ppg(mu, is) + dia(is)
     139             ff(nm, is) = hg - q
     140             v = v - q * dd(nm, is) * 0.5d0
     141           end do
     142
     143 !         **** off - diagonal atom - atom blocks and energy contributio
 n ****
     144           do j = 1, i - 1
     145             do nu = ibf(j), ibf(j) + nbf(j) - 1
 
 FORCHECK PC V13.5.13          SCFMAT          2021-03-24 10:59:30   page:   184
 scf.F90  /FF
 
     146               nm = matind(mu) + nu
     147               call veccou (nm, avec1, bvec1)
     148               hg = beta(nm) - bvec1(0) * gamma(mu, nu)
     149               v = v + (beta(nm) + hg) * avec1(0)
     150               do is = 1, nshell
     151                 q = -bvec1(is) * gamma(mu, nu)
     152                 ff(nm, is) = hg - q
     153                 v = v - q * dd(nm, is)
     154               end do
     155             end do
     156           end do
     157         end do
     158
     159 !       **** Zerners irregular integrals ****
     160         k = natt(i)
     161         if (k > 0) then
     162           mu = ibf(i)
     163           do irreg = 1, nirreg
     164             k1 = ig1(irreg, k)
     165             k2 = ig2(irreg, k)
     166             k3 = ig3(irreg, k)
     167             k4 = ig4(irreg, k)
     168             gk = g(irreg, k)
     169             call scfirr (v, mu, gk, k1, k2, k3, k4)
     170             call scfirr (v, mu, gk, k1, k2, k4, k3)
     171             call scfirr (v, mu, gk, k3, k4, k1, k2)
     172             call scfirr (v, mu, gk, k4, k3, k1, k2)
     173             if (k1 /= k2) then
     174               call scfirr (v, mu, gk, k2, k1, k3, k4)
     175               call scfirr (v, mu, gk, k2, k1, k4, k3)
     176               call scfirr (v, mu, gk, k3, k4, k2, k1)
     177               call scfirr (v, mu, gk, k4, k3, k2, k1)
     178             end if
     179           end do
     180         end if
     181
     182       end do
     183
     184 !     ********************* construct total fock matrix ***************
 *******
     185
     186       if (nshell == 1 .and. shft == 0.d0) then
     187 !       **** Closed shell, no damping so just copy single Fock matrix
 ****
     188         do nm = 1, nb2
     189           aa(nm) = ff(nm, 1)
     190         end do
     191
     192       else
     193        dd1 = dd
     194
     195 !       ***** first, zero all matrix elements of total fock matrix ****
     196         do nm = 1, nb2
     197           aa(nm) = 0.d0
     198         end do
     199 !       **** transform Fock matrices into previous MO basis set ****
     200 !       **** doing projections of E and Z eqn 24                ****
     201 !       **** uses first two density matrices as work space      ****
     202
 
 FORCHECK PC V13.5.13          SCFMAT          2021-03-24 10:59:30   page:   185
 scf.F90  /FF
 
     203 !       **** these coupling coeffs are almost arbitrary, choose irratio
 nal ****
     204         eltot = 0.d0
     205         do ishell = 1, nshell
     206           eltot = eltot + nel(ishell)
     207         end do
     208
     209         do ishell = 1, nshell
     210           wt = 1.d0
     211 !         **** diagonal terms ISHELL - ISHELL ****
     212           call ao2mo1 (aa, ff(:, ishell), cc0, dd1, norbl(ishell), norb
 h(ishell), &
     213      &          norbl(ishell), norbh(ishell), wt)
     214 !         **** terms ISHELL - VIRTUAL ****
     215           call ao2mo1 (aa, ff(:, ishell), cc0, dd1, norbl(ishell), norb
 h(ishell), &
     216      &          norbh(nshell) + 1, n, wt)
     217 !         **** JRRs xtra VIRTUAL - VIRTUAL term (improves order of virt
 uals) ****
     218           wt = nel(ishell) / eltot
     219           call ao2mo1 (aa, ff(:, ishell), cc0, dd1, norbh(nshell) + 1,
 n, &
     220      &          norbh(nshell) + 1, n, wt)
     221
     222 !         **** off - diagonal occupied terms ISHELL - JSHELL ****
     223           do jshell = ishell + 1, nshell
     224             wt = 1.d0
     225             call ao2mo1 (aa, ff(1, ishell), cc0, dd1, norbl(ishell), no
 rbh(ishell), &
     226      &            norbl(jshell), norbh(jshell), wt)
     227             wt = -occfr(jshell) / occfr(ishell)
     228             call ao2mo1 (aa, ff(1, jshell), cc0, dd1, norbl(ishell), no
 rbh(ishell), &
     229      &            norbl(jshell), norbh(jshell), wt)
     230
     231           end do
     232         end do
     233
     234 !       **** shift virtual energies to dampen SCF convergence problems
 ****
     235
     236         do is = 1, max(1, nshell - 1)
     237           do i = norbh(is) + 1, n
     238             nm = matind(i) + i
     239             aa(nm) = aa(nm) + shft
     240           end do
     241         end do
     242
     243 !       **** back - transform Fock matrix into AO basis ****
     244
     245         call mo2ao (aa, cc0, dd1, n)
     246
     247         if (cc0(1, 1) == 0.d0) then
     248           do nm = 1, nb2
     249             aa(nm) = ff(nm, 1)
     250           end do
     251         end if
     252       end if
     253       return
 
 FORCHECK PC V13.5.13          SCFMAT          2021-03-24 10:59:30   page:   186
 scf.F90  /FF
 
     254       end subroutine scfmat
 
