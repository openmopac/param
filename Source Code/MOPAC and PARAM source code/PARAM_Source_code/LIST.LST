    2691       s1 = 0.d0
    2692
    2693       im = 0
    2694       do i = 1, numat
    2695         nao = nlast(i)-nfirst(i)
    2696         ii = ijbo_diag(i)
    2697
    2698         if (nao == 0) then ! S - element
    2699
    2700           v(1) = 0.d0
    2701           do j=1, nps
    2702             t = 1.d0 / Sqrt (( cosurf(1,j) - coord(1,i) )**2 &
    2703                          &  +( cosurf(2,j) - coord(2,i) )**2 &
    2704                          &  +( cosurf(3,j) - coord(3,i) )**2)
    2705             v(1) = v(1) + qscnet(j, 2) * t
    2706           end do
    2707
    2708           v(1) = -v(1) * fcon
    2709
    2710           f(ii+1) = f(ii+1) + v(1)
    2711
    2712           im = im + 1
    2713           s1 = s1 + v(1) * p(ii+1) * gden(im)
    2714
    2715         else
    2716
    2717           nnn = ((nao+2)*(nao+1)) / 2
    2718           v(1:nnn) = 0
    2719
    2720           do j = 1, nps
    2721             call get_bvec (cosurf(1, j), coord(1, i), nao, nat(i), w)
    2722             v(1:nnn) = v(1:nnn) + w(1:nnn) * qscnet(j, 2)
    2723           end do
    2724
    2725           v(1:nnn) = -v(1:nnn) * fcon
    2726
    2727           do j = 1, nnn
    2728             f(ii+j) = f(ii+j) + v(j)
    2729
    2730             im = im + 1
    2731             s1 = s1 + v(j) * p(ii+j) * gden(im)
    2732           end do
    2733
    2734         end if
    2735       end do
    2736     end if
    2737
    2738     solv_energy = s1 * 0.5d0 + ediel
    2739
    2740     ! CALCULATE QDENET FROM DENSITY MATRIX
    2741
    2742     do i = 1, lm61
    2743       qdenet(i, 2) = gden(i) * p(ipiden(i))
    2744       qdenet(i, 3) = qdenet(i, 2) + qdenet(i, 1)
    2745     end do
    2746
    2747   end subroutine addfckz
 
