       1       double precision function dipole (p, coord, dipvec, mode)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE molkst_C, only : numat, keywrd, numcal, ux, uy, uz, mpack, &
       6       mol_weight
       7       USE parameters_C, only : ddp, dd
       8       use to_screen_C, only : dip
       9       USE funcon_C, only : fpc_8, fpc_1, a0
      10       USE chanel_C, only : iw
      11       use common_arrays_C, only : nfirst, nlast, nat, atmass, q
      12 !-----------------------------------------------
      13 !   I n t e r f a c e   B l o c k s
      14 !-----------------------------------------------
      15       implicit none
      16 !-----------------------------------------------
      17 !   D u m m y   A r g u m e n t s
      18 !-----------------------------------------------
      19       integer , intent(in) :: mode
      20       double precision , intent(in) :: p(mpack)
      21       double precision , intent(inout) :: coord(3,*)
      22       double precision , intent(out) :: dipvec(3)
      23 !-----------------------------------------------
      24 !   L o c a l   V a r i a b l e s
      25 !-----------------------------------------------
      26       integer :: icalcn, i, j, ni, ia, ib, l, k, ll
      27       double precision, dimension(3) :: center
      28       double precision :: sum, hyfsp, xt, hyfpd, dx, dy, dz, factdm
      29       logical :: first, chargd, force
      30
      31       save first, chargd, force, icalcn
      32 !-----------------------------------------------
      33 !**********************************************************************
 *
      34 !     DIPOLE CALCULATES DIPOLE MOMENTS
      35 !
      36 !  ON INPUT P     = DENSITY MATRIX
      37 !           Q     = TOTAL ATOMIC CHARGES, (NUCLEAR + ELECTRONIC)
      38 !           NUMAT = NUMBER OF ATOMS IN MOLECULE
      39 !           NAT   = ATOMIC NUMBERS OF ATOMS
      40 !           NFIRST= START OF ATOM ORBITAL COUNTERS
      41 !           COORD = COORDINATES OF ATOMS
      42 !
      43 !  OUTPUT  DIPOLE = DIPOLE MOMENT
      44 !**********************************************************************
 *
      45 !
      46 !     IN THE ZDO APPROXIMATION, ONLY TWO TERMS ARE RETAINED IN THE
      47 !     CALCULATION OF DIPOLE MOMENTS.
      48 !     1. THE POINT CHARGE TERM (INDEPENDENT OF PARAMETERIZATION).
      49 !     2. THE ONE-CENTER HYBRIDIZATION TERM, WHICH ARISES FROM MATRIX
      50 !     ELEMENTS OF THE FORM <NS/R/NP>. THIS TERM IS A FUNCTION OF
      51 !     THE SLATER EXPONENTS (ZS,ZP) AND IS THUS DEPENDENT ON PARAMETER-
      52 !     IZATION.
      53 !
      54 !
      55 !     REFERENCES:
      56 !     J.A.POPLE & D.L.BEVERIDGE: APPROXIMATE M.O. THEORY
 
 FORCHECK PC V13.5.13          DIPOLE          2021-03-24 10:59:30   page:  2503
 dipole.F90  /FF
 
      57 !     S.P.MCGLYNN, ET AL: APPLIED QUANTUM CHEMISTRY
      58 !
      59       data icalcn/ 0/
      60       first = icalcn /= numcal
      61       icalcn = numcal
      62 !
      63 !   CONST = c.C.a0.2
      64 !
      65       if (first) then
      66         sum = 0.D0
      67         do i = 1, numat
      68           sum = sum + q(i)
      69         end do
      70         chargd = abs(sum) > 0.5D0
      71         force = index(keywrd,'FORCE') + index(keywrd," THERMO") + index
 (keywrd,'IRC') /= 0
      72       end if
      73       if (.not.force .and. chargd) then
      74 !
      75 !   NEED TO RESET ION'S POSITION SO THAT THE CENTER OF MASS IS AT THE
      76 !   ORIGIN.
      77 !
      78         center = 0.D0
      79         do i = 1, 3
      80           do j = 1, numat
      81             center(i) = center(i) + atmass(j)*coord(i,j)
      82           end do
      83         end do
      84         center = center/mol_weight
      85         do i = 1, 3
      86           coord(i,:numat) = coord(i,:numat) - center(i)
      87         end do
      88       end if
      89       dip = 0.0D00
      90       do i = 1, numat
      91         ni = nat(i)
      92         ia = nfirst(i)
      93         ib = nlast(i)
      94         l = ib - ia
      95         if (l > 0) then
      96             hyfsp = 2.0D0*dd(ni)*a0*fpc_8*fpc_1*1.D-10
      97           do j = 1, 3
      98             k = ((ia + j)*(ia + j - 1))/2 + ia
      99             dip(j,2) = dip(j,2) - hyfsp*p(k)
     100           end do
     101 !
     102 !   PD ONE-CENTER TERM
     103           if (ib - ia == 8) then
     104             xt = 1.D0/sqrt(3.D00)
     105             hyfpd = 2.0D0*ddp(5,ni)*a0*fpc_8*fpc_1*1.D-10
     106             ll = (ia + 5)*(ia + 4)/2 + ia + 3
     107             dx = p(ll)
     108             ll = (ia + 4)*(ia + 3)/2 + ia + 1
     109             dx = dx + p(ll)
     110             ll = (ia + 8)*(ia + 7)/2 + ia + 2
     111             dx = dx + p(ll)
     112             ll = (ia + 6)*(ia + 5)/2 + ia + 1
     113             dx = dx - xt*p(ll)
     114 !
 
 FORCHECK PC V13.5.13          DIPOLE          2021-03-24 10:59:30   page:  2504
 dipole.F90  /FF
 
     115             ll = (ia + 7)*(ia + 6)/2 + ia + 3
     116             dy = p(ll)
     117             ll = (ia + 4)*(ia + 3)/2 + ia + 2
     118             dy = dy - p(ll)
     119             ll = (ia + 8)*(ia + 7)/2 + ia + 1
     120             dy = dy + p(ll)
     121             ll = (ia + 6)*(ia + 5)/2 + ia + 2
     122             dy = dy - xt*p(ll)
     123 !
     124             ll = (ia + 5)*(ia + 4)/2 + ia + 1
     125             dz = p(ll)
     126             ll = (ia + 7)*(ia + 6)/2 + ia + 2
     127             dz = dz + p(ll)
     128             ll = (ia + 6)*(ia + 5)/2 + ia + 3
     129             dz = dz + 2.D0*xt*p(ll)
     130             dip(1,2) = dip(1,2) - dx*hyfpd
     131             dip(2,2) = dip(2,2) - dy*hyfpd
     132             dip(3,2) = dip(3,2) - dz*hyfpd
     133           end if
     134         end if
     135 !
     136 !  FPC(8)=SPEED OF LIGHT,  FPC(1)=CHARGE ON ELECTRON.
     137 !
     138         factdm = fpc_8*fpc_1*1.D-10
     139         dip(:3,1) = dip(:3,1) + q(i)*coord(:,i)*factdm
     140       end do
     141       dip(:3,3) = dip(:3,2) + dip(:3,1)
     142       do j = 1, 3
     143         dip(4,j) = sqrt(dip(1,j)**2+dip(2,j)**2+dip(3,j)**2)
     144       end do
     145       if (force) then
     146         dipvec(1) = dip(1,3)
     147         dipvec(2) = dip(2,3)
     148         dipvec(3) = dip(3,3)
     149       end if
     150       if (mode == 1) write (iw, 140) ((dip(i,j),i=1,4),j=1,3)
     151 !     STORE DIPOLE MOMENT COMPONENTS IN UX,UY,UZ FOR USE IN
     152 !     ASSIGNING CHARGES DETERMINED FROM THE ESP. BHB
     153       ux = dip(1,3)
     154       uy = dip(2,3)
     155       uz = dip(3,3)
     156       dipole = dip(4,3)
     157       if (.not.force .and. chargd) then
     158 !
     159 !   NEED TO RESET ION'S POSITION AGAIN, SO THAT IT IS BACK WHERE IT STA
 RTED
     160 !
     161         do i = 1, 3
     162           coord(i,:numat) = coord(i,:numat) + center(i)
     163         end do
     164       end if
     165       return
     166 !
     167   140 format(' DIPOLE',11x,'X         Y         Z       TOTAL',/,' POIN
 T-CHG.',&
     168         4f10.3,/,' HYBRID',4x,4f10.3,/,' SUM',7x,4f10.3)
     169 !
     170       end function dipole
 
 FORCHECK PC V13.5.13          DIPOLE          2021-03-24 10:59:30   page:  2505
 dipole.F90  /FF


