    2852   subroutine fock_mult_int (ind, n, psi, p, x0, y0, z0, y_norm, pmn, c,
  &
    2853        & nc, q, r)
    2854     !
    2855     ! Adds correction to the Fock matrix due to far charges on surface
    2856     ! using local expansions
    2857     !
    2858
    2859     use common_arrays_C, only: nfirst, nlast
    2860     !
    2861     !.. Implicit Declarations ..
    2862     implicit none
    2863     !
    2864     !.. Formal Arguments ..
    2865     integer, intent(in) :: n, p, nc
    2866     integer, intent(in), dimension(*) :: ind
    2867     complex (kind=dcmplx_kind), dimension(-p:p, 0:p), intent(in) :: psi
    2868     double precision, dimension(-p:p, 0:p), intent(in) :: y_norm
    2869     double precision, dimension(-p:p, 0:p), intent(out) :: pmn
    2870     double precision, intent(in), dimension(nc, *) :: c
    2871     double precision, intent(in), dimension(*) :: q
    2872     double precision, intent(inout), dimension(*) :: r
    2873     double precision, intent(in) :: x0, y0, z0
    2874     !
    2875     !.. Local Scalars ..
    2876     integer :: i, ii, i3, j, k, nnn
    2877     double precision :: dx, dy, dz, d, phi, cos_t, t
    2878     complex (kind=dcmplx_kind) :: tc
    2879     !
    2880     !.. Local Arrays ..
    2881     integer :: idiag(9) = (/ 1, 3, 6, 10, 15, 21, 28, 36, 45 /)
    2882     !
    2883     !.. Intrinsic Functions ..
    2884     intrinsic Real, Cmplx, Atan2, Exp, Sqrt
    2885     !
    2886     ! ... Executable Statements ...
    2887
    2888 !
    2889 ! Dummy statement to "use" q
    2890 !
    2891     dx = q(1)
    2892     do i3 = 1, n
    2893       i = ind(i3)  ! atom number
    2894       ii = iatom_pos(i)
    2895       nnn = nlast(i) - nfirst(i) + 1
    2896
    2897       dx =  c(1, i) - x0
    2898       dy =  c(2, i) - y0
    2899       dz =  c(3, i) - z0
    2900
    2901       d = Sqrt (dx**2 + dy**2 + dz**2)
    2902       cos_t = dz / d
    2903       phi = Atan2 (dy, dx)
    2904
    2905       call get_legendre (p, cos_t, pmn)
    2906
    2907       t = 0.d0
    2908       do j = 0, p
 
 FORCHECK PC V13.5.13      FOCK_MULT_INT       2021-03-24 10:59:30   page:  2318
 linear_cosmo.F90  /FF
 
    2909         tc = Cmplx (0.d0, 0.d0, dcmplx_kind)
    2910         do k = 1, j
    2911           tc = tc + y_norm(k, j) * pmn(k, j) * d**j &
    2912                & *psi(k, j) * Exp (Cmplx (0.d0, k*phi, dcmplx_kind))
    2913
    2914         end do
    2915
    2916         t = t + 2.d0 * Real (tc) + pmn(0, j) * d**j * Real (psi(0, j))
    2917       end do
    2918
    2919       r(ii + idiag(1:nnn)) = r(ii + idiag(1:nnn)) + t
    2920
    2921     end do
    2922
    2923   end subroutine fock_mult_int
 
