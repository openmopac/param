     241 !         **** check to see if this type of atom already found ****
     242           j = 1
     243           do while (j < i .and. natm(j) /= natm(i))
     244             j = j + 1
     245           end do
     246           if (j < i) then
     247 !           **** atom already done ****
     248             natt(i) = natt(j)
     249           else
     250             k = k + 1
     251             if (k > mte) then
     252               write (iw, "(/' ERROR: Max number of different transition
  metals = ', i4)") mte
     253               write (6, "(/' ERROR: Max number of different transition
 metals = ', i4)") mte
     254               stop 'MTE'
     255             end if
     256             natt(i) = k
