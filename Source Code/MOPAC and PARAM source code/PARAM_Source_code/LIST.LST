       1       double precision function aabbcd (iocca1, ioccb1, iocca2, ioccb2,
  nmos, &
       2         xy)
       3 !-----------------------------------------------
       4 !   M o d u l e s
       5 !-----------------------------------------------
       6       USE meci_C, only : ispqr, is, iiloop, jloop
       7 !**********************************************************************
 *
       8       implicit none
       9 !-----------------------------------------------
      10 !   G l o b a l   P a r a m e t e r s
      11 !-----------------------------------------------
      12 !-----------------------------------------------
      13 !   D u m m y   A r g u m e n t s
      14 !-----------------------------------------------
      15       integer , intent(in) :: nmos
      16       integer , intent(in) :: iocca1(nmos)
      17       integer , intent(in) :: ioccb1(nmos)
      18       integer , intent(in) :: iocca2(nmos)
      19       integer , intent(in) :: ioccb2(nmos)
      20       double precision , intent(in) :: xy(nmos,nmos,nmos,nmos)
      21 !-----------------------------------------------
      22 !   L o c a l   P a r a m e t e r s
      23 !-----------------------------------------------
      24 !-----------------------------------------------
      25 !   L o c a l   V a r i a b l e s
      26 !-----------------------------------------------
      27       integer :: i, j, k, l, m, ij
      28       double precision :: xr
      29 !-----------------------------------------------
      30 !**********************************************************************
      31 !
      32 ! AABBCD EVALUATES THE C.I. MATRIX ELEMENT FOR TWO MICROSTATES DIFFERIN
 G
      33 !       BY TWO SETS OF M.O.S. ONE MICROSTATE HAS AN ALPHA ELECTRON
      34 !       IN PSI(I) AND A BETA ELECTRON IN PSI(K) FOR WHICH THE OTHER
      35 !       MICROSTATE HAS AN ALPHA ELECTRON IN PSI(J) AND A BETA ELECTRON
      36 !       IN PSI(L)
      37 !
      38 !**********************************************************************
      39       do i = 1, nmos
      40         if (iocca1(i) == iocca2(i)) cycle
      41         exit
      42       end do
      43       do j = i + 1, nmos
      44         if (iocca1(j) == iocca2(j)) cycle
      45         exit
      46       end do
      47       do k = 1, nmos
      48         if (ioccb1(k) == ioccb2(k)) cycle
      49         exit
      50       end do
      51       do l = k + 1, nmos
      52         if (ioccb1(l) == ioccb2(l)) cycle
      53         exit
      54       end do
      55       if (i==k .and. j==l .and. iocca1(i)/=ioccb1(i)) then
 
 FORCHECK PC V13.5.13          AABBCD          2021-03-24 10:59:30   page:   383
 aabbcd.F90  /FF
 
      56         ispqr(iiloop,is) = jloop
      57         is = is + 1
      58       end if
      59       if (iocca1(i) < iocca2(i)) then
      60         m = i
      61         i = j
      62         j = m
      63       end if
      64       if (ioccb1(k) < ioccb2(k)) then
      65         m = k
      66         k = l
      67         l = m
      68       end if
      69       xr = xy(i,j,k,l)
      70 !#      WRITE(IW,'(4I5,F12.6)')I,J,K,L,XR
      71 !
      72 !   NOW UNTANGLE THE MICROSTATES
      73 !
      74       ij = 1
      75       if (i>k .and. j>l .or. i<=k .and. j<=l) ij = 0
      76       if (i > k) ij = ij + iocca1(k) + ioccb1(i)
      77       if (j > l) ij = ij + iocca2(l) + ioccb2(j)
      78       if (i > k) then
      79         m = i
      80         i = k
      81         k = m
      82       end if
      83       ij = ij + sum(ioccb1(i:k)+iocca1(i:k))
      84       if (j > l) then
      85         m = j
      86         j = l
      87         l = m
      88       end if
      89       ij = ij + sum(ioccb2(j:l)+iocca2(j:l))
      90 !
      91 !   IJ IN THE PERMUTATION NUMBER, .EQUIV. -1 IF IJ IS ODD.
      92 !
      93       if (mod(ij,2) == 1) xr = -xr
      94       aabbcd = xr
      95       return
      96       end function aabbcd
 
