     891   subroutine atom_no_to_txt(atom_no, text)
     892 !
     893 ! Convert an atom number to its PDB label
     894 !
     895     use common_arrays_C, only: txtatm
     896     implicit none
     897     integer, intent (in) :: atom_no
     898     character, intent (out) :: text*(*)
     899 !
     900 !  Local
     901 !
     902     character :: txt*18
     903     if (atom_no == 0) then
     904       text = " 0 "
     905       return
     906     end if
     907     txt = txtatm(atom_no)(12:)
     908     text = '"'//trim(txt)//'"'
     909     return
     910   end subroutine atom_no_to_txt
 
