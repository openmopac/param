      21 !     *****************************************************************
 ******
      22
      23       subroutine st (a, b, ihalf)
      24       use reimers_C, only : n, stwt, nr, nslwr, nsupr, nstr, istr
      25
      26       implicit none
      27       double precision ::   a(n, n), b(n, n), bb, bbb
      28       integer ::            i, j, ihalf, i1, ib, ir, j1, jb
      29
      30 !     **** this does the symmetry - orbital transform on a matrix in ao
  basis ***
      31 !     ****                      b = T(transp) . a . T
      ***
      32 !     **** ihalf = 1 lower, = 2 upper, triangle of matrices only
              ***
      33
      34       do i = 1, n
      35         do j = i, n
      36           if (ihalf == 2) then
      37             b(i, j) = 0.d0
      38           else
      39             b(j, i) = 0.d0
      40           end if
      41         end do
      42       end do
      43
      44       do ir = 1, nr
      45         do i = nslwr(ir), nsupr(ir)
      46           do j = i, nsupr(ir)
      47             bbb = 0.d0
      48             do i1 = 1, nstr(i)
      49               bb = 0.d0
      50               ib = abs(istr(i1, i))
      51               do j1 = 1, nstr(j)
      52                 jb = abs(istr(j1, j))
      53                 if (jb > ib .and. ihalf == 2 .or.&
      54      &              jb <= ib .and. ihalf /= 2) then
      55                   bb = bb + isign(1, istr(j1, j)) * a(ib, jb) * stwt(j)
      56                 else
      57                   bb = bb + isign(1, istr(j1, j)) * a(jb, ib) * stwt(j)
      58                 end if
      59               end do
      60               bbb = bbb + bb * isign(1, istr(i1, i)) * stwt(i)
      61             end do
      62             if (ihalf == 2) then
      63               b(i, j) = bbb
      64             else
      65               b(j, i) = bbb
      66             end if
      67           end do
      68         end do
      69       end do
      70
      71       return
      72       end subroutine st
 
