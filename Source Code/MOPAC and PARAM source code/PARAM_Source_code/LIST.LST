      70   subroutine prepare_tesselations (n1, n2, ind, n, ierr)
      71
      72     !
      73     !.. Implicit Declarations ..
      74     implicit none
      75     !
      76     !.. Formal Arguments ..
      77     integer, intent(in) :: n1, n2, n
      78     integer, intent(out) :: ierr
      79     integer, dimension(n), intent(out) :: ind
      80     !
      81     !.. Local Scalars ..
      82     integer :: i, j
      83     !
      84     !.. Intrinsic Functions ..
      85     intrinsic Allocated, Associated, Max
      86     !
      87     ! ... Executable Statements ...
      88
      89     if (Allocated (tess)) then
