 , ii, nd_list, d_list(8)
      12   double precision :: q1, q2, EC, ER
      13   double precision :: angle_cos, r, torsion_check, angle, angle2_shift,
  &
      14     angle2_shift_2, torsion_shift, angle2_cos, angle2, angle2_cos_2, &
      15     torsion, torsion_cos, torsion2, torsion_2, torsion_ref, &
      16     torsion_cos_2, unit_part, attraction, torsion_correct, &
      17     expo, repulsion, rep_pre, rep_exp, c, sum, multiplier_a, sum_max
      18   logical :: torsion_check_set, peptide, torsion_check_set2, first = .t
 rue.
