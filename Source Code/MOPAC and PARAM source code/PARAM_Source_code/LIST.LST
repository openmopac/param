       2       subroutine mult(c, s, vecs, n)
       3
       4 !-----------------------------------------------
       5 !   M o d u l e s
       6 !-----------------------------------------------
       7       implicit none
       8       integer , intent(in) :: n
       9       double precision , intent(in) :: c(n,n)
      10       double precision , intent(in) :: s(n,n)
      11       double precision , intent(out) :: vecs(n,n)
      12 !
      13 !  Local variables
      14 !
      15       integer :: i, j, k
      16       double precision :: sum
      17 !-----------------------------------------------
      18 !**********************************************************************
      19 !
      20 !   MULT IS USED IN THE MULLIKEN ANALYSIS ONLY. IT PERFORMS THE
      21 !        OPERATION:-
      22 !                                   VECS=BACK-TRANSFORMED EIGENVECTORS
      23 !        VECS  =  C*S               C   =UN-BACK-TRANSFORMED VECTORS
      24 !                                   S   =1/SQRT(OVERLAP MATRIX)
      25 !
      26 !**********************************************************************
      27       do i = 1, n
      28         do j = 1, n
      29           sum = 0.D0
      30           do k = 1, n
      31             sum = sum + c(k,i)*s(j,k)
      32           end do
      33           vecs(j,i) = sum
      34         end do
      35       end do
      36       return
      37       end subroutine mult
 
