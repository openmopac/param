    1952     subroutine freev (n, nfree, index, nenter, ileave, indx2, iwhere, w
 rk, &
    1953    & updatd, cnstnd, iprint, iter)
    1954       use chanel_C, only: iw
    1955     !
    1956       implicit none
    1957       logical, intent (in) :: cnstnd, updatd
    1958       logical, intent (out) :: wrk
    1959       integer, intent (in) :: iprint, iter, n
    1960       integer, intent (inout) :: nfree
    1961       integer, intent (out) :: ileave, nenter
    1962       integer, dimension (n), intent (in) :: iwhere
    1963       integer, dimension (n), intent (inout) :: index
    1964       integer, dimension (n), intent (out) :: indx2
    1965       integer :: i, iact, k
    1966     !
    1967     !
    1968       nenter = 0
    1969       ileave = n + 1
    1970       if (iter > 0 .and. cnstnd) then
    1971        !                           count the entering and leaving varia
 bles.
    1972         do i = 1, nfree
    1973           k = Index(i)
    1974           if (iwhere(k) > 0) then
    1975             ileave = ileave - 1
    1976             indx2(ileave) = k
    1977             if (iprint >= 100) then
    1978               write (iw,*) "Variable ", k, " leaves the set of free var
 iables"
    1979             end if
    1980           end if
    1981         end do
    1982         do i = 1 + nfree, n
    1983           k = Index(i)
    1984           if (iwhere(k) <= 0) then
    1985             nenter = nenter + 1
    1986             indx2(nenter) = k
    1987             if (iprint >= 100) then
    1988               write (iw,*) "Variable ", k, " enters the set of free var
 iables"
    1989             end if
    1990           end if
    1991         end do
    1992         if (iprint >= 99) then
    1993           write (iw,*) n + 1 - ileave, " variables leave; ", nenter, &
    1994          & " variables enter"
    1995         end if
    1996       end if
    1997       wrk = (ileave < n+1) .or. (nenter > 0) .or. updatd
    1998     !     Find the index set of free and active variables at the GCP.
    1999       nfree = 0
    2000       iact = n + 1
    2001       do i = 1, n
    2002         if (iwhere(i) <= 0) then
 
 FORCHECK PC V13.5.13          FREEV           2021-03-24 10:59:30   page:  2942
 lbfgs.F90  /FF
 
    2003           nfree = nfree + 1
    2004           Index(nfree) = i
    2005         else
    2006           iact = iact - 1
    2007           Index(iact) = i
    2008         end if
    2009       end do
    2010     !
    2011       if (iprint >= 99) then
    2012         write (iw,*) nfree, " variables are free at GCP ", iter + 1
    2013       end if
    2014     !
    2015     end subroutine freev
 
