     172         alparm(3,:nvar) = xparam(:nvar)
     173         if (iloop == 2) iloop = 3
     174     end if NextReactionStep
     175
     176 ! Find number of reaction path steps
     177     lpr = iloop
     178     do npts = 1,10000
     179         if (react(npts) < -100.D0) exit
     180     end do
     181
     182     MainLoop: do ii = lpr, npts - 1
     183         iloop = ii
     184         if (iloop - lpr > maxcyc - 3) then
     185             tleft = -100.D0
     186         end if
     187         rxn_coord = react(iloop)
