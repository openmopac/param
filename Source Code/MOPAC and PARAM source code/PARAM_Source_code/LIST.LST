       1       subroutine maksym(loc, xparam, xstore)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use molkst_C, only : nvar, ndep, natoms
       6       use symmetry_C, only : locpar, idepfn, locdep
       7       use funcon_C, only : pi
       8       use common_arrays_C, only : na
       9       use chanel_C, only : iw
      10 !**********************************************************************
 *
      11       implicit none
      12 !-----------------------------------------------
      13 !   G l o b a l   P a r a m e t e r s
      14 !-----------------------------------------------
      15     integer, dimension (2, nvar), intent (inout) :: loc
      16     double precision, dimension (nvar), intent (inout) :: xparam, xstor
 e
      17 !-----------------------------------------------
      18 !   L o c a l   P a r a m e t e r s
      19 !-----------------------------------------------
      20 !-----------------------------------------------
      21 !   L o c a l   V a r i a b l e s
      22 !-----------------------------------------------
      23       integer :: i, j, loop, locl
      24       double precision :: twopi, xref
      25 !-----------------------------------------------
      26 !*********************************************************************
      27 !
      28 ! MAKSYM CONSTRUCTS THE SYMMETRY DEFINITIONS FOR THE SYSTEM
      29 !        AUTOMATICALLY.  IT RELIES ON IDENTICAL BOND-LENGTHS BEING
      30 !        SYMMETRY RELATED, SIMILARLY FOR ANGLES AND DIHEDRALS.
      31 !
      32 !*********************************************************************
      33       do i = 2, natoms
      34         if (na(i) == 0) exit
      35       end do
      36       if (i < natoms) then
      37         write(iw,'(a)')" For AUTOSYM to work, geometry must be in inter
 nal coordinates."
      38         call mopend("For AUTOSYM to work, geometry must be in internal
 coordinates")
      39       end if
      40       twopi = 2.D0*pi
      41       ndep = 0
      42       do i = 1, nvar
      43         if (loc(2,i) == 3) then
      44 !
      45 !  FORCE DIHEDRALS INTO SAME HALF-CIRCLE
      46 !
      47           j = int(sign(0.5D0,xparam(i))+xparam(i)/twopi)
      48           xparam(i) = xparam(i) - j*twopi
      49         end if
      50         xstore(i) = xparam(i)
      51       end do
      52       do loop = 1, nvar
      53         if (xstore(loop) < (-1.D4)) cycle
      54         xref = xstore(loop)
 
 FORCHECK PC V13.5.13          MAKSYM          2021-03-24 10:59:30   page:   898
 maksym.F90  /FF
 
      55         locl = loc(2,loop)
      56         do i = loop + 1, nvar
      57           if (abs(xref - xstore(i))>=1.D-3 .or. loc(2,i)/=locl) cycle
      58           ndep = ndep + 1
      59           locpar(ndep) = loc(1,loop)
      60           idepfn(ndep) = locl
      61           locdep(ndep) = loc(1,i)
      62           xstore(i) = -1.D5
      63         end do
      64 !
      65 !   Special, common, dihedral symmetry function
      66 !
      67         do i = loop + 1, nvar
      68           if (abs(xref + xstore(i))>=1.D-3 .or. loc(2,i)/=locl) cycle
      69           ndep = ndep + 1
      70           locpar(ndep) = loc(1,loop)
      71           idepfn(ndep) = 14
      72           locdep(ndep) = loc(1,i)
      73           xstore(i) = -1.D5
      74         end do
      75       end do
      76       j = 0
      77       do i = 1, nvar
      78         if (xstore(i) <= (-1.D4)) cycle
      79         j = j + 1
      80         loc(1,j) = loc(1,i)
      81         loc(2,j) = loc(2,i)
      82         xparam(j) = xparam(i)
      83       end do
      84       nvar = j
      85       return
      86       end subroutine maksym
 
