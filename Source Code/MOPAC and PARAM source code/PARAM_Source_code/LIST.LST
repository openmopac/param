       1       double precision function babbbc (iocca1, ioccb1, ioccb2, nmos, x
 y)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use meci_C, only : occa
       6 !**********************************************************************
 *
       7       implicit none
       8 !-----------------------------------------------
       9 !   G l o b a l   P a r a m e t e r s
      10 !-----------------------------------------------
      11 !-----------------------------------------------
      12 !   D u m m y   A r g u m e n t s
      13 !-----------------------------------------------
      14       integer , intent(in) :: nmos
      15       integer , intent(in) :: iocca1(nmos)
      16       integer , intent(in) :: ioccb1(nmos)
      17       integer , intent(in) :: ioccb2(nmos)
      18       double precision , intent(in) :: xy(nmos,nmos,nmos,nmos)
      19 !-----------------------------------------------
      20 !   L o c a l   V a r i a b l e s
      21 !-----------------------------------------------
      22       integer :: i, ij, j, k
      23       double precision :: sum
      24 !-----------------------------------------------
      25 !**********************************************************************
      26 !
      27 ! BABBBC EVALUATES THE C.I. MATRIX ELEMENT FOR TWO MICROSTATES DIFFERIN
 G
      28 !       BY ONE BETA ELECTRON. THAT IS, ONE MICROSTATE HAS A BETA
      29 !       ELECTRON IN PSI(I) AND THE OTHER MICROSTATE HAS AN ELECTRON IN
      30 !       PSI(J).
      31 !**********************************************************************
      32       do i = 1, nmos
      33         if (ioccb1(i) == ioccb2(i)) cycle
      34         exit
      35       end do
      36       ij = 0
      37       do j = i + 1, nmos
      38         if (ioccb1(j) /= ioccb2(j)) exit
      39         ij = ij + iocca1(j) + ioccb1(j)
      40       end do
      41       ij = ij + iocca1(j)
      42 !
      43 !   THE UNPAIRED M.O.S ARE I AND J
      44       sum = 0.D0
      45       do k = 1, nmos
      46         sum = sum + (xy(i,j,k,k)-xy(i,k,j,k))*(ioccb1(k)-occa(k)) + xy(
 i,j,k,k)&
      47           *(iocca1(k)-occa(k))
      48       end do
      49       if (mod(ij,2) == 1) sum = -sum
      50       babbbc = sum
      51       return
      52       end function babbbc
 
