       1       subroutine mult33(fmat, iplace)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE symmetry_C, only : elem
       6 !**********************************************************************
 *
       7       implicit none
       8 !-----------------------------------------------
       9 !   G l o b a l   P a r a m e t e r s
      10 !-----------------------------------------------
      11 !-----------------------------------------------
      12 !   D u m m y   A r g u m e n t s
      13 !-----------------------------------------------
      14       integer , intent(in) :: iplace
      15       double precision , intent(in) :: fmat(3,3)
      16 !-----------------------------------------------
      17 !   L o c a l   P a r a m e t e r s
      18 !-----------------------------------------------
      19 !-----------------------------------------------
      20 !   L o c a l   V a r i a b l e s
      21 !-----------------------------------------------
      22       integer :: i, j, k
      23       double precision, dimension(3,3) :: help
      24 !-----------------------------------------------
      25 !**********************************************************************
 *
      26 !
      27 !   MULT33 performs a eulerian rotation on a symmetry operation.
      28 !
      29 !    The symmetry operation IPLACE, stored in ELEM is subjected
      30 !    to the operation stored in FMAT.
      31 !
      32 !**********************************************************************
 *
      33       do i = 1, 3
      34         do j = 1, 3
