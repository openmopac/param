       1       subroutine mtxmc(a, nar, b, nbr, c)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5 !-----------------------------------------------
       6 !   I n t e r f a c e   B l o c k s
       7 !-----------------------------------------------
       8       implicit none
       9 !-----------------------------------------------
      10 !   D u m m y   A r g u m e n t s
      11 !-----------------------------------------------
      12       integer , intent(in) :: nar
      13       integer  :: nbr
      14       double precision  :: a(nbr,nar)
      15       double precision  :: b(nbr,nar)
      16       double precision  :: c(*)
      17 !-----------------------------------------------
      18 !   L o c a l   V a r i a b l e s
      19 !-----------------------------------------------
      20       integer :: l, i
      21 !-----------------------------------------------
      22 !     MATRIX PRODUCT C(NAR,NAR) = (A(NBR,NAR))' * B(NBR,NAR)
      23 !     A AND B RECTANGULAR , PACKED,
      24 !     C LOWER LEFT TRIANGLE ONLY, PACKED IN CANONICAL ORDER.
      25 !  NOTE ... THIS IS THE BEST VERSION ON CRAY 1.
      26       l = 1
      27       do i = 1, nar
      28         call mxm (a(1,i), 1, b, nbr, c(l), i)
      29         l = l + i
      30       end do
      31       return
      32       end subroutine mtxmc
 
