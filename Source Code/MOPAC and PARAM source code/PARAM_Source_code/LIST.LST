     243 !     *****************************************************************
 ********
     244
     245       subroutine dump (a, nn, ibtype, name)
     246       use reimers_C, only : matind, nham, natm, iat, nbt, nci, iatsym,
 kind, &
     247           nptg, nr, nmrep
     248       USE chanel_C, only : iw
     249
     250       implicit none
     251       double precision ::  a(*), amax
     252       integer ::           i, j, k, i0, i1, i2, ibtype, ip, ir, k1, k2,
  nm, nn, nnb2
     253       character*(*) ::     name
     254       character*21 ::      f1150
     255       data f1150        /'(1x,2i3,a2,a3,15f8.?)'/
     256
     257 !     **** dumps a symmetric matrix
      ****
     258 !     **** ibtype = 1 atom by atom; = 2 orbital by orbital; = 3 state b
 y state;   ****
     259 !     **** = 4 state by state max 15,    = 0 is basic
      ****
     260
     261       write (iw, *)
     262       write (iw, *) name
     263
     264 !     **** find largest elements ****
     265       nnb2 = nn*(nn + 1)/2
     266       amax = 1.D-10
     267       do i = 1, nnb2
     268         amax = max (amax, abs(a(i)))
     269       end do
     270       ip = int(log10(amax) + 0.99d0)
     271       ip = max (0, min (4, 6 - ip))
     272
     273       k2 = 0
     274       do while (k2 < nn)
     275         k1 = k2 + 1
     276         k2 = min (k1 + 14, nn)
     277         write (iw, *)
     278         write (iw, '(10x, 15i8)') (i, i = k1, k2)
     279         if (ibtype < 3) then
     280           do j = k1, nn
     281             nm = matind(j)
     282             if (ibtype == 0) then
     283 !             **** generic matrix ****
     284               write (iw, '(1x, i6, 1x, a2, 2x, 15f8.4)') j, '  ', (a(nm
  + k), k = k1, min(j, k2))
     285             else if (ibtype == 1) then
     286 !             **** atom by atom matrix ****
     287               write (iw, '(1x, i6, 1x, a2, 2x, 15f8.4)') j, iatsym(natm
 (j)), (a(nm + k), k = k1, min(j, k2))
     288             else
     289 !             **** orbital by orbital matrix ****
     290               f1150(20:20) = char (ip + ichar('0'))
     291               i = iat(j)
     292               write (iw, f1150) j, i, iatsym(natm(i)), kind(nbt(j)), &
 
 FORCHECK PC V13.5.13           DUMP           2021-03-24 10:59:30   page:  1346
 subs.F90  /FF
 
     293      &                                (a(nm + k), k = k1, min(j, k2))
     294               if (nham /= 1 .and. nham /= 3 .and. (j == nn .or.&
     295      &           i /= iat(j + 1)) ) write (iw, *)
     296             end if
     297           end do
     298
     299         else
     300 !         **** configuration by configuration matrix, symmetry - block
 wize ****
     301
     302           i0 = 1
     303           do ir = 1, nr
     304             if (nci(ir) > 0) then
     305               if (nptg > 1) write (iw, "(' Block of symmetry ', a4)") n
 mrep(ir, nptg)
     306               i1 = i0 - 1
     307               i2 = i1 + nci(ir)
     308               if (ibtype == 4) i2 = min (i2, i1 + 14)
     309               do i = i1 + 1, i1 + nci(ir)
     310                 nm = matind(i) + i1
     311                 write (iw, '(1x, i6, 5x, 15f8.4)') i, (a(nm + k), k = 1
 , min(15, i - i1))
     312               end do
     313               i0 = i0 + nci(ir)
     314             end if
     315           end do
     316           k2 = nn
     317
     318         end if
     319       end do
     320
     321       return
     322       end subroutine dump
 
