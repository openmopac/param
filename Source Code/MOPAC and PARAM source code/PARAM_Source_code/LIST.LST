     179 subroutine getusp (nat, nfirst, nlast, uspd, atheat)
     180     use molkst_C, only : numat, norbs, keywrd, cutofp, id
     181     USE parameters_C, only : eisol, eheat, uss, upp, udd, eheat_sparkle
 s, zs
     182     use funcon_C, only : fpc_9
     183     use common_arrays_C, only : geo, coord
     184     implicit none
     185     integer, dimension (numat), intent (in) :: nat, nfirst, nlast
     186     double precision, dimension (norbs), intent (out) :: uspd
     187     double precision, intent (out) :: atheat
     188     integer :: ia, ib, ii, j, k, k1, ni, i
     189     double precision :: eat
     190     double precision, external :: C_triple_bond_C
     191 !----------------------------------------------------------------
     192     atheat = 0.d0
     193     if (index(keywrd, " SPARKL") /= 0) then
     194       atheat = 0.d0
     195       do i = 1, numat
     196         if  (nat(i) > 56 .and. nat(i) < 72 .and. zs(nat(i)) < 0.1d0) th
 en
     197           atheat = atheat + eheat_sparkles(nat(i))
     198         else
     199           atheat = atheat + eheat(nat(i))
     200         end if
     201       end do
     202     else
     203       atheat = sum(eheat(nat(:numat)))
     204     end if
     205     eat = sum(eisol(nat(:numat)))
     206     do ii = 1, numat
     207       ia = nfirst(ii)
     208       ib = nlast(ii)
     209       ni = nat(ii)
     210       if (ia <= ib) then
     211         uspd(ia) = uss(ni)
     212         if (ia /= ib) then
     213           k = ia + 1
     214           k1 = ia + 3
     215           do j = k, k1
     216             uspd(j) = upp(ni)
     217           end do
     218           if (k1 /= ib) then
     219             k = k1 + 1
     220             do j = k, ib
     221               uspd(j) = udd(ni)
     222             end do
     223           end if
     224         end if
     225       end if
     226     end do
     227     atheat = atheat - eat * fpc_9
     228     call gmetry (geo, coord)
     229     if (id == 0) then
     230       cutofp = 1.d10
     231     else
     232       cutofp = 30.d0
     233     end if
     234     call set_up_dentate
 
 FORCHECK PC V13.5.13          GETUSP          2021-03-24 10:59:30   page:  2787
 getmol.F90  /FF
 
     235     atheat = atheat + C_triple_bond_C()
     236   return
     237 end subroutine getusp
 
