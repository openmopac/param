       1   Subroutine set_up_dentate()
       2 !
       3 !   Work out which atoms are connected to which other atoms.
       4 !   Atoms are assumed to be connected if they are within a certain dist
 ance of each other.
       5 !
       6 !  On exit:  nbonds(i) = number of atoms attached to atom "i"
       7 !            ibonds(j,i) = atom numbers of atoms attached to atom i (th
 ere are nbonds(i) of these)
       8     use molkst_C, only : numat, l11, l21, l31, id, pdb_label
       9     use mozyme_C, only : nijbo, tyres
      10     use common_arrays_C, only : nat, coord, tvec, nbonds, ibonds, txtat
 m
      11     use mod_atomradii, only: atom_radius_covalent, radius
      12     implicit none
      13 !-----------------------------------------------
      14 !   L o c a l   V a r i a b l e s
      15 !-----------------------------------------------
      16     integer :: i, ik, j, k, jk, kl, il, iu, l
      17     double precision :: rmin, safety
      18    !
      19    !.. Local Arrays ..
      20     double precision, dimension (3) :: coord1
      21     nbonds = 0
      22     ibonds = 0
      23     if (allocated(radius)) deallocate (radius)
      24     allocate (radius(numat))
      25     call extvdw_for_MOZYME (radius, atom_radius_covalent)
      26    !
      27    !  ATOMS ARE ASSUMED ATTACHED IF THEY ARE WITHIN
      28    !  1.1  TIMES THE SUM OF THEIR COVALENT RADII.
      29    !
      30     do i = 1, numat
      31       do j = 1, i - 1
      32         rmin = 1.d6
      33         if (id == 0) then
      34           rmin = (coord(1, i)-coord(1, j)) ** 2 + &
      35                  (coord(2, i)-coord(2, j)) ** 2 + &
      36                  (coord(3, i)-coord(3, j)) ** 2
      37         else
      38           do ik = -l11, l11
      39             do jk = -l21, l21
      40               do kl = -l31, l31
      41                 coord1(:) = coord(:, j) + tvec(:, 1)*ik + tvec(:, 2)*jk
  + tvec(:, 3)*kl
      42                 rmin = Min (rmin, (coord1(1)-coord(1, i))**2 &
      43                                 + (coord1(2)-coord(2, i))**2 &
      44                                 + (coord1(3)-coord(3, i))**2)
      45               end do
      46             end do
      47           end do
      48         end if
      49 !
      50 !  Apply safety criteria to specific diatomic pairs
      51 !
      52         il = min(nat(i), nat(j))
      53         iu = max(nat(i), nat(j))
      54         safety = 1.1d0
 
 FORCHECK PC V13.5.13      SET_UP_DENTATE      2021-03-24 10:59:30   page:  3151
 set_up_dentate.F90  /FF
 
      55         select case (il)
      56           case (1)
      57             if (iu == 6) safety = 1.25d0  ! C-H
      58           case (5)
      59             if (iu ==7) safety = 1.0d0   ! B-N bonds are unusually shor
 t
      60           case (6)
      61             if (iu < 8) safety = 1.2d0   ! C-C, C-N, C-O
      62           case (16)
      63             if (iu == 16) safety = 1.2d0 ! S-S
      64           end select
      65         if (pdb_label) then
      66           if (il /= 1 .and. iu /= 1 .and. txtatm(i)(18:27) == txtatm(j)
 (18:27)) then
      67             do k = 1, 20
      68               if (txtatm(i)(18:20) == tyres(k)) exit
      69             end do
      70             if (k < 21) then
      71 !
      72 !  Both atoms are heavy atoms in the same standard amino acid residue,
 so be more tolerant.
      73 !
      74               safety = safety*1.05d0
      75             end if
      76           end if
      77         end if
      78         if (rmin < (safety*(radius(i) + radius(j)))**2) then
      79           if (nbonds(i) < 15 .and. nbonds(j) < 15) then
      80             nbonds(i) = nbonds(i) + 1
      81             nbonds(j) = nbonds(j) + 1
      82             ibonds(nbonds(i), i) = j
      83             ibonds(nbonds(j), j) = i
      84           end if
      85         end if
      86       end do
      87     end do
      88 !
      89 !  Check for H attached to H
      90 !
      91     do i = 1, numat
      92       if (nat(i) /= 1) cycle
      93       if (nbonds(i) < 2) cycle
      94       k = 0
      95       do j = 1, nbonds (i)
      96         if (nat(ibonds(j,i)) /= 1) then
      97           k = k +1
      98           ibonds(k,i) = ibonds(j,i)
      99         end if
     100       end do
     101       nbonds(i) = k
     102     end do
     103     if (allocated(nijbo)) then
     104 !
     105 !  Sanity check - don't allow a bond if the atoms are too far apart for
  nijbo to be positive
     106 !
     107       do i = 1, numat
     108         k = 0
     109         do j = 1, nbonds(i)
 
 FORCHECK PC V13.5.13      SET_UP_DENTATE      2021-03-24 10:59:30   page:  3152
 set_up_dentate.F90  /FF
 
     110           l = ibonds(j,i)
     111           if (nijbo(l,i) > -1) then
     112             k = k + 1
     113             ibonds(k,i) = l
     114           end if
     115           nbonds(i) = k
     116         end do
     117       end do
     118     end if
     119     return
     120   end subroutine set_up_dentate
 
