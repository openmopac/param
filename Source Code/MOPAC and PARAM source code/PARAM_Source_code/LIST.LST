     173 !  MODIFY TXTATM TO ALLOW FOR DUMMY ATOMS
     174 !
     175       l = numat
     176       do i = natoms - id, 1, -1
     177         if (labels(i) /= 99) then
     178           txtatm(i) = txtatm(l)
     179           lused(i) = lused(l)
     180           l = l - 1
     181         else
     182           write (txtatm(i), "(I6)") j
     183           j = j - 1
     184         end if
     185       end do
     186     end if
     187     nres = ires
     188     goto 1020
     189 1010 nres = 1
     190     if (allres (ires) (:3) /= "   ") then
     191       if (index(keywrd, " RESIDUE") /= 0) &
     192         write (iw,'(10x,a,i4,a,a)') " AMINO ACID (residue:",ires,") = "
 , allres (ires) (:3)
     193     end if
     194 !
     195 !   LABEL EVERY NON-BACKBONE ATOM AS A SIDE-CHAIN ATOM
     196 !
     197     do i = 1, natoms
     198       if (lused(i) /=-1) then
     199         lused(i) = 1
     200       end if
     201     end do
     202     do j = 1, numat
     203       if (nat(j) == 1) then
     204         lused(j) = lused(ibonds(1, j))
     205       end if
     206     end do
     207     if (numat == natoms) return
     208     j = natoms - numat
     209 !
     210 !  MODIFY TXTATM TO ALLOW FOR DUMMY ATOMS
     211 !
     212     l = numat
     213     do i = natoms - id, 1, -1
     214       if (labels(i) /= 99) then
     215         txtatm(i) = txtatm(l)
     216         lused(i) = lused(l)
     217         l = l - 1
     218       else
     219         write (txtatm(i), "(I6)") j
     220         j = j - 1
     221       end if
     222     end do
     223 1020 continue
     224      return
 
