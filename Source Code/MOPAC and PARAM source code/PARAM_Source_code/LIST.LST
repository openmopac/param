     543       subroutine powsav(hess, grad, xparam, pmat, iloop, bmat, ipow)
     544       use molkst_C, only : nvar, keywrd, numat, norbs
     545       use maps_C, only : latom
     546       use chanel_C, only : iw, ires, restart_fn
     547       use common_arrays_C, only : loc, geo, aicorr
     548       use ef_C, only : alparm, x0, x1, x2
     549       use meci_C, only : jloop
     550       implicit none
     551       integer  :: iloop
     552       integer  :: ipow(9)
     553       double precision  :: hess(nvar,*)
     554       double precision  :: grad(*)
     555       double precision  :: xparam(*)
     556       double precision  :: pmat(*)
     557       double precision  :: bmat(nvar,*)
     558 !
     559       integer :: i, k, l, j, linear, old_numat, old_norbs
     560       double precision :: funct1
     561       double precision, external :: ddot
     562 !-----------------------------------------------
     563 !*********************************************************************
     564 !
     565 ! POWSAV STORES AND RESTORES DATA USED IN THE SIGMA GEOMETRY
     566 !        OPTIMISATION.
     567 !
     568 !  ON INPUT HESS   = HESSIAN MATRIX, PARTIAL OR WHOLE.
     569 !           GRAD   = GRADIENTS.
     570 !           XPARAM = CURRENT STATE OF PARAMETERS.
     571 !           ILOOP  = INDEX OF HESSIAN, OR FLAG OF POINT REACHED SO-FAR.
     572 !           BMAT   = "B" MATRIX!
     573 !           IPOW   = INDICES AND FLAGS.
     574 !           IPOW(9)= 0 FOR RESTORE, 1 or 2 FOR DUMP (2: silent)
     575 !
     576 !*********************************************************************
     577       open(unit=ires, file=restart_fn, status='UNKNOWN', form='UNFORMAT
 TED', position='asis')
     578       rewind ires
     579       if (ipow(9) /= 0) then
     580         if (ipow(9) == 1) then
     581           write (iw, &
     582       '(2/10X,''- - - - - - - TIME UP - - - - - - -'',2/)')
     583           write (iw, '(10X,A)') ' - THE CALCULATION IS BEING DUMPED TO
 DISK', &
     584             '   RESTART IT USING THE KEY-WORD "RESTART"'
     585           funct1 = dsqrt(ddot(nvar,grad,1,grad,1))
     586           write (iw, &
     587             '(2/10X,''CURRENT VALUE OF GRADIENT NORM ='',F12.6)') funct
 1
     588           do i = 1, nvar
     589             k = loc(1,i)
     590             l = loc(2,i)
     591             geo(l,k) = xparam(i)
     592           end do
     593           write (iw, '(/10X,''CURRENT VALUE OF GEOMETRY'',/)')
     594           call geout (iw)
     595         end if
     596         write (ires) numat, norbs, (xparam(i),i=1,nvar)
     597         write (ires) ipow, iloop
 
 FORCHECK PC V13.5.13          POWSAV          2021-03-24 10:59:30   page:  2177
 powsq.F90  /FF
 
     598         write (ires) (grad(i),i=1,nvar)
     599         write (ires) ((hess(j,i),j=1,nvar),i=1,nvar)
     600         write (ires) ((bmat(j,i),j=1,nvar),i=1,nvar)
     601         linear = (nvar*(nvar + 1))/2
     602         write (ires) (pmat(i),i=1,linear)
     603         if (index(keywrd,'AIDER') /= 0) write (ires) (aicorr(i),i=1,nva
 r)
     604         call den_in_out(1)
     605         if (latom /= 0) then
     606           write (ires) ((alparm(j,i),j=1,3),i=1,nvar)
     607           write (ires) jloop, x0, x1, x2
     608         end if
     609         close(ires)
     610         return
     611       else
     612         if (index(keywrd, " LOCATE-TS") == 0) write (iw, '(2/10X,''REST
 ORING DATA FROM DISK''/)')
     613         read (ires, end=40, err=40) old_numat, old_norbs, (xparam(i),i=
 1,nvar)
     614         if (norbs /= old_norbs .or. numat /= old_numat) then
     615               call mopend("Restart file read in does not match current
 data set")
     616               return
     617         end if
     618         read (ires, end=20, err=20) ipow, iloop
     619         read (ires, end=40, err=40) (grad(i),i=1,nvar)
     620         read (ires, end=40, err=40) ((hess(j,i),j=1,nvar),i=1,nvar)
     621         read (ires, end=40, err=40) ((bmat(j,i),j=1,nvar),i=1,nvar)
     622         funct1 = dsqrt(ddot(nvar,grad,1,grad,1))
     623         linear = (nvar*(nvar + 1))/2
     624         read (ires, end=40, err=40) (pmat(i),i=1,linear)
     625         if (index(keywrd,'AIDER') /= 0) read (ires, end=40, err=40) (ai
 corr(i),i=1,nvar)
     626         if (latom /= 0) then
     627           read (ires, end=40, err=40) ((alparm(j,i),j=1,3),i=1,nvar)
     628           read (ires, end=40, err=40) jloop, x0, x1, x2
     629           iloop = iloop + 1
     630         end if
     631         iloop = iloop + 1
     632         return
     633       end if
     634    20 continue
     635       write (iw, '(2/10X,''NO RESTART FILE EXISTS!'')')
     636       return
     637    40 continue
     638       write (iw, '(2/10X,''PROBLEMS READING RESTART FILE'')')
     639       return
     640       end subroutine powsav
 
