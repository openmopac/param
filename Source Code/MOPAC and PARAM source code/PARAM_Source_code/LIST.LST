    1779       double precision function snapth (theta)
    1780       implicit none
    1781       double precision, intent (in) :: theta
    1782       integer :: i, j, k
    1783       double precision :: angle, const, phase, sum
    1784       intrinsic Abs, Acos, Asin, Cos, Int, Mod, Nint, Sign, Sqrt, Dble
    1785         angle = Cos (theta)
    1786         phase = Sign (1.d0, theta)
    1787         if (Abs (angle) < 1.d-4) then
    1788           !
    1789           !   Cos(Theta) is zero - this is 90 or 270 degrees
    1790           !
    1791           const = 2 * Asin (1.d0)
    1792           if (Abs (theta) < const) then
    1793             snapth = phase * Acos (0.d0)
    1794           else
    1795             snapth = phase * Acos (0.d0) + const
    1796           end if
    1797         else
    1798           sum = Abs (1.d0/angle) ** 2
    1799           do i = 1, 7
    1800             j = Nint (sum*i)
    1801             if (Abs (j-sum*i) < 5.d-3) go to 1000
    1802           end do
    1803           snapth = theta
    1804           return
    1805     1000  sum = Sqrt (Dble(i)/Dble(j))
    1806           const = 2 * Asin (1.d0)
    1807           k = Int (Abs (theta)/const)
    1808           if (Mod(k, 2) == 0) then
    1809              !
    1810              !   Theta is in domain -180 - 0 - +180 degrees
    1811              !
    1812             snapth = phase * Acos (sign(sum, angle))
    1813           else
    1814              !
    1815              !   Theta is in domain -180 - 360 - +180 degrees
    1816              !
    1817             snapth = phase * (2*const-Acos (sign(sum, angle)))
    1818           end if
    1819         end if
    1820   end function snapth
 
