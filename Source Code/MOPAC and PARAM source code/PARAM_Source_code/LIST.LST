     186 logical function ring_6(atom_1, atom_2, atom_6)
     187 !
     188 !  Given three adjacent atoms, atom_2 - atom_1 - atom_6, determine if t
 hey belong
     189 !  to an aromatic ring.  If so, "aromatic" return .true.
     190 !
     191     use common_arrays_C,  only : nbonds,  ibonds
     192     implicit none
     193     integer, intent (in) :: atom_1, atom_2, atom_6
     194     integer :: atom_3, atom_5, i, j, k, l, nii, njj, kka, atom_4
     195       ring_6 = .false.
     196       nii = nbonds(atom_2)
     197       njj = nbonds(atom_6)
     198       do i = 1, nii
     199         atom_3 = ibonds(i,atom_2)
     200         if (atom_3 == atom_1) cycle
     201         do j = 1, njj
     202           atom_5 = ibonds(j,atom_6)
     203           if (atom_5 == atom_1) cycle
     204           do k = 1, nbonds(atom_5)
     205             kka = ibonds(k,atom_5)
     206             if (kka == atom_6) cycle
     207             do l = 1, nbonds(atom_3)
     208               atom_4 = ibonds(l,atom_3)
     209               if (atom_4 == atom_2) cycle
     210               if (kka == atom_4) then
     211                 if (atom_1 == atom_3 .or. atom_1 == atom_4 .or. atom_1
 == atom_5) exit
     212                 if (atom_2 == atom_3 .or. atom_2 == atom_4 .or. atom_2
 == atom_5) exit
     213                 if (atom_3 == atom_4 .or. atom_3 == atom_5 .or. atom_3
 == atom_6) exit
     214                 if (atom_4 == atom_5 .or. atom_4 == atom_6 .or. atom_5
 == atom_6) exit
     215 !
     216 !  Six-membered ring, with atoms numbered atom_1, atom_2, atom_3, atom_
 4 = kka, atom_5, atom_6
     217 !
     218
     219                 ring_6 = .true.
     220                 return
     221               end if
     222             end do
     223           end do
     224         end do
     225       end do
     226       return
     227   end function ring_6
 
