       1       subroutine geoutg(iprt)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use common_arrays_C, only : na, coord, geo, loc, labels, &
       6       & simbol, nb, nc, txtatm
       7       use molkst_C, only : natoms, nvar, ndep, maxtxt
       8       USE symmetry_C, ONLY: locpar, idepfn, locdep
       9       use chanel_C, only : iscr
      10       use elemts_C, only : elemnt
      11 !**********************************************************************
 *
      12 !-----------------------------------------------
      13 !   I n t e r f a c e   B l o c k s
      14 !-----------------------------------------------
      15       implicit none
      16 !-----------------------------------------------
      17 !   G l o b a l   P a r a m e t e r s
      18 !-----------------------------------------------
      19 !-----------------------------------------------
      20 !   D u m m y   A r g u m e n t s
      21 !-----------------------------------------------
      22       integer , intent(in) :: iprt
      23 !-----------------------------------------------
      24 !   L o c a l   P a r a m e t e r s
      25 !-----------------------------------------------
      26 !-----------------------------------------------
      27 !   L o c a l   V a r i a b l e s
      28 !-----------------------------------------------
      29       integer , dimension(3,natoms) :: igeo
      30       integer :: i, j, nopt, nbi, nci, l, nchars
      31       double precision :: degree, w, x
      32       character , dimension(3,natoms) :: line*14
      33       character , dimension(3) :: type
      34       character , dimension(3*natoms) :: optdat*14
      35       character :: blank*80
      36       save type
      37 !-----------------------------------------------
      38 !**********************************************************************
 *
      39 !
      40 !   GEOUTG WRITES OUT THE GEOMETRY IN GAUSSIAN-8X STYLE
      41 !
      42 !**********************************************************************
 *
      43       data type/ 'r', 'a', 'd'/
      44       degree = 57.29577951308232D0
      45       do i = 2, natoms
      46         if (na(i) == 0) exit
      47       end do
      48       if (i <= natoms) then
      49 !
      50 !  At least one atom is not in Cartesian coordinates
      51 !  Convert everything to Cartesian coordinates
      52 !
      53         coord(:,:natoms) = geo(:,:natoms)
      54         call xyzint (coord, natoms, na, nb, nc, 1.D0, geo)
      55         nvar = 0
 
 FORCHECK PC V13.5.13          GEOUTG          2021-03-24 10:59:30   page:   486
 geoutg.F90  /FF
 
      56         do i = 1, natoms
      57           do j = 1, min(3,i - 1)
      58             nvar = nvar + 1
      59             loc(1,nvar) = i
      60             loc(2,nvar) = j
      61           end do
      62         end do
      63       else
      64 !
      65 !   CONSTRAIN ANGLES TO THE RANGE 0 to 180 DEGREES
      66 !
      67         do i = 4, natoms
      68           w = geo(2,i)*degree
      69           x = geo(3,i)*degree
      70           w = w - aint(w/360.D0)*360.D0
      71           if (w < 0) w = w + 360.D0
      72           if (w > 180.D0) then
      73             x = x + 180.D0
      74             w = 360.D0 - w
      75           end if
      76 !
      77 !  CONSTRAIN DIHEDRAL TO DOMAIN -180 - 180 DEGREES
      78 !
      79           x = x - aint(x/360.D0 + sign(0.5D0 - 1.D-9,x) - 1.D-9)*360.D0
      80           geo(2,i) = w/degree
      81           geo(3,i) = x/degree
      82         end do
      83       end if
      84       igeo(:,:natoms) = -1
      85       do i = 1, nvar
      86         igeo(loc(2,i),loc(1,i)) = -2
      87       end do
      88       do i = 1, ndep
      89         if (idepfn(i) == 14) then
      90           igeo(3,locdep(i)) = -locpar(i)
      91         else
      92           if (idepfn(i) > 3) cycle
      93           igeo(idepfn(i),locdep(i)) = locpar(i)
      94         end if
      95       end do
      96       open(unit=iscr, status='SCRATCH', position='asis')
      97       nopt = 0
      98       do i = 1, natoms
      99         do j = 1, 3
     100           line(j,i) = ' '
     101           if (igeo(j,i) == (-1)) then
     102             rewind iscr
     103             if (j /= 1) then
     104               write (iscr, '(F12.6)') geo(j,i)*degree
     105             else
     106               write (iscr, '(F12.6)') geo(j,i)
     107             end if
     108             rewind iscr
     109             read (iscr, '(A)') line(j,i)
     110           else if (igeo(j,i) == (-2)) then
     111             nopt = nopt + 1
     112             if (simbol(nopt) /= '---------') then
     113               if (simbol(nopt)(1:1) == '-') then
     114                 line(j,i)(4:) = simbol(nopt)(2:)
 
 FORCHECK PC V13.5.13          GEOUTG          2021-03-24 10:59:30   page:   487
 geoutg.F90  /FF
 
     115               else
     116                 line(j,i)(4:) = simbol(nopt)
     117               end if
     118             else
     119               nbi = nb(i)
     120               nci = nc(i)
     121               if (j /= 3) nci = 0
     122               if (j == 1) nbi = 0
     123               call xxx (type(j), i, na(i), nbi, nci, line(j,i)(4:))
     124             end if
     125             optdat(nopt) = line(j,i)
     126           else if (igeo(j,i) < 0) then
     127             line(3,i) = line(3,(-igeo(j,i)))
     128             line(3,i)(3:3) = '-'
     129           else
     130             line(j,i) = line(j,igeo(j,i))
     131           end if
     132         end do
     133         if (maxtxt /= 0 .and. maxtxt /= 27) then
     134           blank = elemnt(labels(i))//txtatm(i)//'  '
     135           nchars = max(4,maxtxt + 2)
     136         else
     137           blank = elemnt(labels(i))
     138           nchars = 3
     139         end if
     140         if (labels(i) == 99) blank(1:1) = ' '
     141         select case (i)
     142         case (1)
     143           write (iprt, '(1X,A,I4,A,I4,A,I4,A,I4)') blank(:nchars)
     144         case (2)
     145           write (iprt, '(1X,A,I4,A,I4,A,I4,A,I4)') blank(:nchars), na(i
 ), line(1,i)
     146         case (3)
     147           write (iprt, '(1X,A,I4,A,I4,A,I4,A,I4)') &
     148           blank(:nchars), na(i), line(1,i), nb(i), line(2,i)
     149         case default
     150           write (iprt, '(1X,A,I4,A,I4,A,I4,A,I4)') &
     151           blank(:nchars), na(i), line(1,i), nb(i), line(2,i), nc(i), li
 ne(3,i), 0
     152         end select
     153       end do
     154       write (iprt, *)
     155       do l = 1, 3
     156         do i = 1, nopt
     157           if (loc(2,i) /= l) cycle
     158           if (loc(2,i) /= 1) then
     159             write (iprt, '(A,F12.6)') optdat(i), geo(loc(2,i),loc(1,i))
 *degree
     160           else
     161             write (iprt, '(A,F12.6)') optdat(i), geo(loc(2,i),loc(1,i))
     162           end if
     163         end do
     164       end do
     165       return
     166       end subroutine geoutg
 
