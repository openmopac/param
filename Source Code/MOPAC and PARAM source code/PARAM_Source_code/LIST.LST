     826       subroutine espfit()
     827 !-----------------------------------------------
     828 !   M o d u l e s
     829 !-----------------------------------------------
     830       USE esp_C, only : nesp, cf, co, potpt, idip, iz, dx, dy, dz, &
     831       & b_esp, esp_array, rms, rrms
     832       use common_arrays_C, only : q
     833       use molkst_C, only : numat
     834       use funcon_C, only : a0, fpc_1, fpc_8
     835 !**********************************************************************
 *
     836 !-----------------------------------------------
     837 !   I n t e r f a c e   B l o c k s
     838 !-----------------------------------------------
     839       implicit none
     840 !-----------------------------------------------
     841 !   G l o b a l   P a r a m e t e r s
     842 !-----------------------------------------------
     843 !-----------------------------------------------
     844 !   L o c a l   V a r i a b l e s
     845 !-----------------------------------------------
     846       integer :: k, j, i, info
     847       double precision ::rik, rij, espc, atmp
     848       integer, allocatable :: ipiv(:)
     849       double precision, allocatable :: a(:,:)
     850     !
     851     !.. Local Scalars ..
     852     integer ::  istart, iend
     853     cf = fpc_1 * a0 * fpc_8 * 1.d-10
     854      allocate (a(numat+4,numat+4))
     855     !
     856     !     THE FOLLOWING SETS UP THE LINEAR EQUATION A*Q=B
     857     !     SET UP THE A(J,K) ARRAY
     858     !
     859
     860
     861     istart = 1
     862     iend = nesp
     863     do k = 1, numat
     864       do j = 1, numat
     865         atmp = 0
     866         do i = istart, iend
     867           rik = (co(1, k) - potpt(1, i)) ** 2 &
     868                & + (co(2, k) - potpt(2, i)) ** 2 &
     869                & + (co(3, k) - potpt(3, i)) ** 2
     870           rij = (co(1, j) - potpt(1, i)) ** 2 &
     871                & + (co(2, j) - potpt(2, i)) ** 2 &
     872                & + (co(3, j) - potpt(3, i)) ** 2
     873           atmp = atmp + 1 / Sqrt (rij * rik)
     874         end do
     875         a(j, k) = atmp * a0**2
     876       end do
     877     end do
     878       a(numat+1, 1:numat) = 1.d0 !row
     879       a(numat+1:, numat+1:) = 0.d0 !corner
     880       a(1:numat, numat+1) = 1.d0 !column
     881       if (idip == 1) then
     882         a(numat+2:numat+4, 1:numat) = co(1:3, 1:numat) / a0
 
 FORCHECK PC V13.5.13          ESPFIT          2021-03-24 10:59:30   page:  3230
 esp.F90  /FF
 
     883         a(1:numat, numat+2:numat+4) = Transpose (co(1:3, 1:numat) / a0)
     884         a(numat+2:numat+4, numat+2:numat+4) = 0.d0
     885       else
     886         a(:, numat+2:) = 0.d0
     887         a(numat+2:, 1:numat+1) = 0.d0
     888       end if
     889     !
     890     !     INSERT CHARGE AND DIPOLAR (IF DESIRED) CONSTRAINTS
     891     !
     892     b_esp(numat+1) = iz
     893     b_esp(numat+2) = dx / cf
     894     b_esp(numat+3) = dy / cf
     895     b_esp(numat+4) = dz / cf
     896     !
     897     if (allocated(q)) deallocate(q)
     898     allocate(q(numat + 4))
     899     q(1:numat+4) = b_esp(1:numat+4)
     900     !
     901     allocate (ipiv(numat+4))
     902     !
     903     if (idip == 1) then
     904       call dgesv (numat+4, 1, a, numat+4, ipiv, q, numat+4, info)
     905     else
     906       call dgesv (numat+1, 1, a, numat+4, ipiv, q, numat+4, info)
     907     end if
     908     !
     909     deallocate (ipiv)
     910     !
     911     !     CALCULATE ROOT MEAN SQUARE FITS AND RELATIVE ROOT MEAN SQUARE
  FITS
     912     !
     913     do i = 1, nesp
     914       espc = 0.d0
     915       do j = 1, numat
     916         rij = Sqrt ((co(1, j) - potpt(1, i)) ** 2 &
     917              & + (co(2, j) - potpt(2, i)) ** 2 &
     918              & + (co(3, j) - potpt(3, i)) ** 2) / a0
     919         espc = espc + q(j) / rij
     920       end do
     921       rms = rms + (espc-esp_array(i)) ** 2
     922       rrms = rrms + esp_array(i) ** 2
     923     end do
     924     rms = Sqrt (rms/nesp)
     925     rrms = rms / Sqrt (rrms/nesp)
     926     rms = rms * 627.51d0
     927   end subroutine espfit
 
