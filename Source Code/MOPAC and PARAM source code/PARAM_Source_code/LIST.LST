      35 subroutine find_XH_bonds(acc, nacc, h_b, nhb)
      36 !
      37 !  Locate all hydrogen atoms involved in O-H and N-H bonds
      38 !  On exit:
      39 !  nhb:   Number of hydrogen atoms involved in O-H or N-H bonds
      40 !  h_b:   Atom numbers of the hydrogen atoms
      41 !
      42   use molkst_C, only : numat, method_PM7, method_pm6_dh_plus, method_pm
 6_d3h4, method_pm6_d3h4x
      43   use common_arrays_C, only: nat
      44   implicit none
      45   integer :: nacc, nhb
      46
      47   integer :: acc(numat), h_b(numat)
      48   integer :: i, j, is
      49   double precision :: RAH
      50   logical :: used(numat)
      51   logical, external :: connected
      52     if (method_pm6_dh_plus) then
      53       RAH = 1.4d0
      54       is = 8
      55     else if (method_PM7) then
      56       RAH = 1.4d0
      57       is = 8  ! Change to 16 ASAP
      58     else if (method_pm6_d3h4 .or. method_pm6_d3h4x) then
      59       RAH = 1.15d0
      60       is = 8
      61     else
      62       RAH = 1.15d0
      63       is = 16
      64     end if
      65     used = .false.
      66     nacc = 0
      67     nhb  = 0
      68     do i = 1, numat
      69       if (nat(i) ==  7 .or. nat(i) ==  8 .or. nat(i) ==  is) then
      70         nacc = nacc + 1
      71         acc(nacc) = i
      72         do j = 1, numat
      73           if (nat(j) ==  1 .and. .not. used(j)) then
      74             if (connected(i, j, RAH**2)) then
      75               nhb = nhb + 1
      76               h_b(nhb) = j
      77               used(j) = .true.
      78             end if
      79           end if
      80         end do
      81       end if
      82     end do
      83 end subroutine find_XH_bonds
 
