    2079       subroutine dawrit(v, len, nrec)
    2080 !-----------------------------------------------
    2081 !   M o d u l e s
    2082 !-----------------------------------------------
    2083       use chanel_C, only : ioda, ifilen, irecst, idaf, irecln, iw
    2084 !-----------------------------------------------
    2085 !   I n t e r f a c e   B l o c k s
    2086 !-----------------------------------------------
    2087       implicit none
    2088 !-----------------------------------------------
    2089 !   D u m m y   A r g u m e n t s
    2090 !-----------------------------------------------
    2091       integer , intent(in) :: len
    2092       integer , intent(in) :: nrec
    2093       double precision  :: v(len)
    2094 !-----------------------------------------------
    2095 !   L o c a l   V a r i a b l e s
    2096 !-----------------------------------------------
    2097       integer :: n, ist, ns, lent, if, nsp, lenw
    2098       logical :: newrec
    2099 !-----------------------------------------------
    2100       n = ioda(nrec)
    2101       if (n<=0 .or. len==ifilen(nrec)) then
    2102         newrec = .FALSE.
    2103         if (n <= 0) then
    2104           ioda(nrec) = irecst
    2105           ifilen(nrec) = len
    2106           newrec = .TRUE.
    2107           irecst = irecst + (len - 1)/irecln + 1
    2108           n = ioda(nrec)
    2109         end if
    2110         ist = (-irecln) + 1
    2111         ns = n
    2112         lent = len
    2113         ist = ist + irecln
    2114         if = ist + lent - 1
    2115         if (if - ist + 1 > irecln) if = ist + irecln - 1
    2116         nsp = ns
    2117         lenw = if - ist + 1
    2118         call dawrt1 (v(ist), lenw, idaf, nsp)
    2119         lent = lent - irecln
    2120         ns = ns + 1
    2121         n = ns
    2122         do while(lent >= 1)
    2123           ist = ist + irecln
    2124           if = ist + lent - 1
    2125           if (if - ist + 1 > irecln) if = ist + irecln - 1
    2126           nsp = ns
    2127           lenw = if - ist + 1
    2128           call dawrt1 (v(ist), lenw, idaf, nsp)
    2129           lent = lent - irecln
    2130           ns = ns + 1
    2131           n = ns
    2132         end do
    2133         if (newrec) write (unit=idaf, rec=1) irecst, ioda, ifilen
    2134         return
    2135       end if
    2136 !
 
 FORCHECK PC V13.5.13          DAWRIT          2021-03-24 10:59:30   page:  2624
 polar.F90  /FF
 
    2137       write (iw, 40) nrec, len, ifilen(nrec)
    2138       call mopend (&
    2139       'DAWRIT HAS REQUESTED A RECORD WITH LENGTH DIFFERENT THAN BEFORE
 - ABORT &
    2140       &FORCED.')
    2141 !
    2142    40 format(1x,'DAWRIT HAS REQUESTED A RECORD WITH LENGTH',1x,&
    2143         'DIFFERENT THAN BEFORE - ABORT FORCED.'/,1x,'DAF RECORD ',i5,&
    2144         ' NEW LENGTH =',i5,' OLD LENGTH =',i5)
    2145       return
    2146       end subroutine dawrit
 
