       1       subroutine deri1(number, grad, f, minear, fd, scalar, work)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE molkst_C, only : numat, nopen, numcal, keywrd, norbs, mpack,
 &
       6       & n2elec
       7       use chanel_C, only : iw
       8       use common_arrays_C, only : nfirst, nlast, eigb, p, pa, c, coord
       9       USE funcon_C, only : fpc_9
      10       use derivs_C, only : wmat, hmat, fmat
      11       use meci_C, only : nelec, nmos, lab, nbo, nstate, maxci, xy, vect
 ci
      12       implicit none
      13       integer , intent(in) :: number
      14       integer , intent(in) :: minear
      15       double precision , intent(out) :: grad
      16       double precision  :: f(mpack)
      17       double precision  :: fd(mpack)
      18       double precision , intent(in) :: scalar(mpack)
      19       double precision, intent(out) :: work(norbs, norbs)
      20 !
      21       integer ::  icalcn, nati, natx, i, l, j, nend, loop, ninit, n1&
      22         , n2, lcut, k, ll, ncol
      23       double precision :: const, step, enucl2, gse, sum
      24       logical :: debug
      25       double precision, external :: ddot, helect
      26       save debug, icalcn, const
      27 !-----------------------------------------------
      28 !********************************************************************
      29 !
      30 !     DERI1 COMPUTE THE NON-RELAXED DERIVATIVE OF THE NON-VARIATIONALLY
      31 !     OPTIMIZED WAVEFUNCTION ENERGY WITH RESPECT TO ONE CARTESIAN
      32 !     COORDINATE AT A TIME
      33 !                             AND
      34 !     COMPUTE THE NON-RELAXED FOCK MATRIX DERIVATIVE IN M.O BASIS AS
      35 !     REQUIRED IN THE RELAXATION SECTION (ROUTINE 'DERI2').
      36 !
      37 !   INPUT
      38 !     C(NORBS,NORBS) : M.O. COEFFICIENTS.
      39 !     COORD  : CARTESIAN COORDINATES ARRAY.
      40 !     NUMBER : LOCATION OF THE REQUIRED VARIABLE IN COORD.
      41 !     WORK   : WORK ARRAY OF SIZE N*N.
      42 !     WMAT     : WORK ARRAYS FOR d<PQ|RS> (2-CENTERS  A.O)
      43 !   OUTPUT
      44 !     C,COORD,NUMBER : NOT MODIFIED.
      45 !     GRAD   : DERIVATIVE OF THE HEAT OF FORMATION WITH RESPECT TO
      46 !              COORD(NUMBER), WITHOUT RELAXATION CORRECTION.
      47 !     F(MINEAR) : NON-RELAXED FOCK MATRIX DERIVATIVE WITH RESPECT TO
      48 !              COORD(NUMBER), EXPRESSED IN M.O BASIS, SCALED AND
      49 !              PACKED, OFF-DIAGONAL BLOCKS ONLY.
      50 !     FD     : IDEM BUT UNSCALED, DIAGONAL BLOCKS, C.I-ACTIVE ONLY.
      51 !
      52 !**********************************************************************
 *
      53       data icalcn/ 0/
      54       n2 = 0
      55 !
 
 FORCHECK PC V13.5.13          DERI1           2021-03-24 10:59:30   page:   651
 deri1.F90  /FF
 
      56       if (icalcn /= numcal) then
      57         if(allocated(wmat)) deallocate(wmat)
      58         i = Max (n2elec + mpack, (lab*(lab+1))/2, 20*mpack, maxci*(maxc
 i+1)/2)
      59         allocate(wmat(i))
      60         if(allocated(hmat)) deallocate(hmat)
      61         i = Max ((lab*(lab+1))/2, 20*minear, mpack)
      62         allocate(hmat(i))
      63         if(allocated(fmat)) deallocate(fmat)
      64         i = Max ((lab*(lab+1))/2, 20*minear, mpack)
      65         allocate(fmat(i))
      66         const = fpc_9
      67         debug = index(keywrd,'DERI1') /= 0
      68         icalcn = numcal
      69       end if
      70       if (debug) call timer ('BEFORE DERI1')
      71       step = 1.D-3
      72 !
      73 !     2 POINTS FINITE DIFFERENCE TO GET THE INTEGRAL DERIVATIVES
      74 !     ----------------------------------------------------------
      75 !     STORED IN HMAT AND WMAT, WITHOUT DIVIDING BY THE STEP SIZE.
      76 !
      77       nati = (number - 1)/3 + 1
      78       natx = number - 3*(nati - 1)
      79       call dhcore (coord, hmat, wmat, enucl2, nati, natx, step)
      80 !
      81 ! HMAT HOLDS THE ONE-ELECTRON DERIVATIVES OF ATOM NATI FOR DIRECTION
      82 !      NATX W.R.T. ALL OTHER ATOMS
      83 ! WMAT HOLDS THE TWO-ELECTRON DERIVATIVES OF ATOM NATI FOR DIRECTION
      84 !      NATX W.R.T. ALL OTHER ATOMS
      85       step = 0.5D0/step
      86 !
      87 !     NON-RELAXED FOCK MATRIX DERIVATIVE IN A.O BASIS.
      88 !     ------------------------------------------------
      89 !     STORED IN FMAT, DIVIDED BY STEP.
      90 !
      91       call dcopy (mpack, hmat, 1, fmat, 1)
      92       call dfock2 (fmat, p, pa, wmat, numat, nfirst, nlast, nati)
      93 !
      94 !  FMAT HOLDS THE ONE PLUS TWO - ELECTRON DERIVATIVES OF ATOM NATI FOR
      95 !       DIRECTION NATX W.R.T. ALL OTHER ATOMS
      96 !
      97 !       DERIVATIVE OF THE SCF-ONLY ENERGY (I.E BEFORE C.I CORRECTION)
      98 !
      99       grad = (helect(norbs,p,hmat,fmat) + enucl2)*step
     100 !     TAKE STEP INTO ACCOUNT IN FMAT
     101       fmat(:mpack) = fmat(:mpack)*step
     102 !
     103 !     RIGHT-HAND SIDE SUPER-VECTOR F = C' FMAT C USED IN RELAXATION
     104 !     -----------------------------------------------------------
     105 !     STORED IN NON-STANDARD PACKED FORM IN F(MINEAR) AND FD.
     106 !     THE SUPERVECTOR IS THE NON-RELAXED FOCK MATRIX DERIVATIVE IN
     107 !     M.O BASIS: F(IJ)= ( (C' * FOCK * C)(I,J) )   WITH I.GT.J .
     108 !     F IS SCALED AND PACKED IN SUPERVECTOR FORM WITH
     109 !                THE CONSECUTIVE FOLLOWING OFF-DIAGONAL BLOCKS:
     110 !             1) OPEN-CLOSED  I.E. F(IJ)=F(I,J) WITH I OPEN & J CLOSED
     111 !                                  AND I RUNNING FASTER THAN J,
     112 !             2) VIRTUAL-CLOSED SAME RULE OF ORDERING,
     113 !             3) VIRTUAL-OPEN   SAME RULE OF ORDERING.
 
 FORCHECK PC V13.5.13          DERI1           2021-03-24 10:59:30   page:   652
 deri1.F90  /FF
 
     114 !     FD IS PACKED OVER THE C.I-ACTIVE M.O WITH
     115 !                THE CONSECUTIVE DIAGONAL BLOCKS:
     116 !             1) CLOSED-CLOSED   IN CANONICAL ORDER, WITHOUT THE
     117 !                                DIAGONAL ELEMENTS,
     118 !             2) OPEN-OPEN       SAME RULE OF ORDERING,
     119 !             3) VIRTUAL-VIRTUAL SAME RULE OF ORDERING.
     120 !
     121 !     PART 1 : WORK(N,N) = FMAT(N,N) * C(N,N)
     122       do i = 1, norbs
     123         call supdot (work(1,i), fmat, c(1,i), norbs)
     124       end do
     125 !
     126 !     PART 2 : F(IJ) =  (C' * WORK)(I,J) ... OFF-DIAGONAL BLOCKS.
     127       l = 1
     128       if (nbo(2)/=0 .and. nbo(1)/=0) then
     129 !        OPEN-CLOSED
     130         ! TODO: GBR future modifications
     131         call mtxm (c(1,nbo(1)+1), nbo(2), work, norbs, f(l), nbo(1))
     132         l = l + nbo(2)*nbo(1)
     133       end if
     134       if (nbo(3)/=0 .and. nbo(1)/=0) then
     135 !        VIRTUAL-CLOSED
     136         ! TODO: GBR future modifications
     137         call mtxm (c(1,nopen+1), nbo(3), work, norbs, f(l), nbo(1))
     138         l = l + nbo(3)*nbo(1)
     139       end if
     140 !        VIRTUAL-OPEN
     141       ! TODO: GBR future modifications
     142       if (nbo(3)/=0 .and. nbo(2)/=0) &
     143       call mtxm (c(1,nopen+1), nbo(3), work(1,nbo(1)+1), norbs, f(l), n
 bo(2))
     144 !     SCALE F ACCORDING TO THE DIAGONAL METRIC TENSOR 'SCALAR '.
     145       f(:minear) = f(:minear)*scalar(:minear)
     146       if (debug) then
     147         write (iw, *) ' F IN DERI1'
     148         j = min(20,minear)
     149         write (iw, '(5F12.6)') (f(i),i=1,j)
     150       end if
     151 !
     152 !     PART 3 : SUPER-VECTOR FD, C.I-ACTIVE DIAGONAL BLOCKS, UNSCALED.
     153       l = 1
     154       nend = 0
     155       do loop = 1, 3
     156         ninit = nend + 1
     157         nend = nend + nbo(loop)
     158         n1 = max(ninit,nelec + 1)
     159         n2 = min(nend,nelec + nmos)
     160         if (n2 < n1) cycle
     161         do i = n1, n2
     162           if (i <= ninit) cycle
     163           call mxm (c(1,i), 1, work(1,ninit), norbs, fd(l), i - ninit)
     164           l = l + i - ninit
     165         end do
     166       end do
     167       ncol = n2 - ninit + 1
     168       if (ncol > 0 .and. n2 < norbs) then
     169         ! TODO: GBR future modifications
     170         call mtxm (c(1, n2+1), norbs-n2, work(1,ninit), norbs, fd(l), n
 col)
 
 FORCHECK PC V13.5.13          DERI1           2021-03-24 10:59:30   page:   653
 deri1.F90  /FF
 
     171         l = l + ncol * (norbs-n2)
     172       end if
     173 !
     174 !     NON-RELAXED C.I CORRECTION TO THE ENERGY DERIVATIVE.
     175 !     ----------------------------------------------------
     176 !
     177 !     C.I-ACTIVE FOCK EIGENVALUES DERIVATIVES, STORED IN FD(CONTINUED).
     178       lcut = l
     179       do i = nelec + 1, nelec + nmos
     180         fd(l) = ddot(norbs,c(1,i),1,work(1,i),1)
     181         l = l + 1
     182       end do
     183 !
     184 !     C.I-ACTIVE 2-ELECTRONS INTEGRALS DERIVATIVES. STORED IN XY.
     185 !   FMAT IS USED HERE AS SCRATCH SPACE
     186 !
     187       call dijkl1 (c(1,nelec+1), norbs, nati, wmat, fmat, hmat, fmat, x
 y)
     188       xy(:nmos,:nmos,:nmos,:nmos) = xy(:nmos,:nmos,:nmos,:nmos)*step
     189 !
     190 !     BUILD THE C.I MATRIX DERIVATIVE, STORED IN WMAT.
     191       call mecid (fd(lcut), gse, eigb, work, xy)
     192       if (debug) then
     193         write (iw, *) ' GSE:', gse
     194         write (iw, *) ' EIGB:', (eigb(i),i=1,10)
     195         write (iw, *) ' WORK:', (work(i,1),i=1,10)
     196       end if
     197       call mecih (work, wmat, nmos, lab, xy)
     198 !
     199 !     NON-RELAXED C.I CONTRIBUTION TO THE ENERGY DERIVATIVE.
     200       sum = 0.D0
     201       do i = 1, nstate
     202         j = (i - 1)*lab + 1
     203         call supdot (work, wmat, vectci(j), lab)
     204         sum = sum + ddot(lab,vectci(j),1,work,1)
     205       end do
     206       grad = (grad + sum/nstate)*const
     207       if (debug) then
     208         write (iw, '('' * * * GRADIENT COMPONENT NUMBER'',I4)') number
     209         write (iw, &
     210       '('' NON-RELAXED C.I-ACTIVE FOCK EIGENVALUES DERIVATIVES (E.V.)''
 )')
     211         write (iw, '(8F10.4)') (fd(lcut-1+i),i=1,nmos)
     212         write (iw, '('' NON-RELAXED 2-ELECTRONS DERIVATIVES (E.V.)''/
 &
     213         &''    I    J    K    L       d<I(1)J(1)|K(2)L(2)>'')')
     214         do i = 1, nmos
     215           do j = 1, i
     216             do k = 1, i
     217               ll = k
     218               if (k == i) ll = j
     219               do l = 1, ll
     220                 write (iw, '(4I5,F20.10)') nelec + i, nelec + j, nelec
 + k, nelec + l, xy(i,j,k,l)
     221               end do
     222             end do
     223           end do
     224         end do
     225         write (iw, '('' NON-RELAXED GRADIENT COMPONENT'',F10.4,'' KCAL/
 
 FORCHECK PC V13.5.13          DERI1           2021-03-24 10:59:30   page:   654
 deri1.F90  /FF
 
 MOLE'')') grad
     226         call timer ('AFTER DERI1')
     227       end if
     228       return
     229       end subroutine deri1
 
 FORCHECK PC V13.5.13          DERI1           2021-03-24 10:59:30   page:   655
 deri1.F90  /FF


