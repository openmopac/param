     180       subroutine stdeltap(cist, aocc, bocc, dpstat, ist)
     181       use molkst_c, only : mpack
     182       use reimers_C, only : nconf, nov, nex, &
     183           mspn, aor1, bor1
     184       implicit none
     185       double precision :: dpstat(mpack), cist(nconf, nconf), &
     186                       deltap(mpack)
     187       logical*1 :: aocc(nov, mspn, nex), bocc(nov, mspn, nex)
     188       integer :: iorb, ist, iconf
     189       integer :: io(4), iv(4), nio
     190       double precision :: prob(nconf)
     191 !**********************************************************************
 *
     192 !   RMG - Compute the AO density for the full CI states. Loop over all
     193 !   involved excitations to get the overall change in density.
     194 !**********************************************************************
 *
     195
     196 ! Set up an empty matrix to hold all changes in density
     197       do iorb = 1, mpack
     198         dpstat(iorb) = 0.d0
     199       end do
     200
     201 ! For each excitation, compute the change in density
     202       do iconf = 1, nconf
     203 ! Determine occupied & unoccupied orbitals in this configuration
     204         call getocc(aocc(1:nov, 1, iconf), bocc(1:nov, 1, iconf), &
     205                     aor1(1:nov), bor1(1:nov), io, iv, nio)
     206 ! Compute the density change
     207         call exdeltap(io, iv, nio, deltap)
     208
     209 ! For each CI state, add the change in density with the appropriate
     210 ! coefficient
     211         prob(ist) = cist(iconf, ist)**2
     212         if (prob(ist) > 0.0001d0) then
     213           do iorb = 1, mpack
     214             dpstat(iorb) = dpstat(iorb) + prob(ist)*deltap(iorb)
     215           end do
     216         end if
     217       end do
     218
     219       return
     220       end subroutine stdeltap
 
