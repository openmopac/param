     190             write (iw, &
     191                   '(1X,16(''*****''),2/17X,''REACTION COORDINATE = '',F
 12.4,2X,A10,19X,2/1X,16(''*****''))') &
     192                   rxn_coord, 'DEGREES   '
     193         else
     194             write (iw, &
     195                   '(1X,16(''*****''),2/17X,''REACTION COORDINATE = '',F
 12.4,2X,A10,19X,2/1X,16(''*****''))') &
     196                   rxn_coord, 'ANGSTROMS   '
     197         end if
     198
     199 ! Determine type of interpolation
     200         x3 = react(iloop)
     201         c3 = (x0*x0 - x1*x1)*(x1 - x2) - (x1*x1 - x2*x2)*(x0 - x1)
     202         if (abs(c3) < 1.D-8) then
     203  ! Linear interpolation
     204             cc1 = 0.D0
     205             cc2 = 0.D0
     206         else
     207  ! Quadratic interpolation
     208             cc1 = (x1 - x2)/c3
     209             cc2 = (x0 - x1)/c3
     210         end if
