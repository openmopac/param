       1 subroutine local2 (c, mdim, nmos, nfirst, nlast, numat)
       2    !
       3    !.. Implicit Declarations ..
       4     implicit none
       5    !
       6    !.. Formal Arguments ..
       7     integer, intent (in) :: mdim, nmos, numat
       8     integer, dimension (*), intent (in) :: nfirst, nlast
       9     double precision, dimension (mdim, mdim), intent (inout) :: c
      10    !
      11    !.. Local Scalars ..
      12     integer :: i, j, k, k1, loop, n, niter
      13     double precision :: aij, bij, ca, dii, dij, djj, sa, sum, xiiii, xi
 ijj, &
      14    & xijij, xijjj, xjiii, xjjjj
      15    !
      16    !.. Local Arrays ..
      17     double precision, dimension (20) :: psi1, psi2
      18    !
      19    !.. Intrinsic Functions ..
      20     intrinsic Abs, Sqrt
      21    !
      22    ! ... Executable Statements ...
      23    !
      24     n = nlast(numat)
      25     niter = 1
      26     if (nmos == 4) then
      27       niter = 19
      28     end if
      29     do loop = 1, niter
      30       sum = 0.d0
      31       do i = 1, nmos
      32         do j = 1, nmos
      33           if (j /= i) then
      34             xijjj = 0.0d0
      35             xjiii = 0.0d0
      36             xiiii = 0.0d0
      37             xjjjj = 0.0d0
      38             xijij = 0.0d0
      39             xiijj = 0.0d0
      40             do k = 1, n
      41               psi1(k) = c(k, i)
      42               psi2(k) = c(k, j)
      43             end do
      44             do k1 = 1, numat
      45               dij = 0.d0
      46               dii = 0.d0
      47               djj = 0.d0
      48               do k = nfirst(k1), nlast(k1)
      49                 dij = dij + psi1(k) * psi2(k)
      50                 dii = dii + psi1(k) * psi1(k)
      51                 djj = djj + psi2(k) * psi2(k)
      52               end do
      53               xijjj = xijjj + dij * djj
      54               xjiii = xjiii + dij * dii
      55               xiiii = xiiii + dii * dii
      56               xjjjj = xjjjj + djj * djj
      57               xijij = xijij + dij * dij
 
 FORCHECK PC V13.5.13          LOCAL2          2021-03-24 10:59:30   page:   201
 local2.F90  /FF
 
      58               xiijj = xiijj + dii * djj
      59             end do
      60             aij = xijij - (xiiii+xjjjj-2.0d0*xiijj) / 4.0d0
      61             bij = xjiii - xijjj
      62             ca = Sqrt (aij*aij+bij*bij)
      63             sa = aij + ca
      64             if (sa > 1.0d-14) then
      65               ca = (1.0d0+Sqrt((1.0d0-aij/ca)/2.0d0)) / 2.0d0
      66               sa = Sqrt (1.0d0-ca)
      67               sum = sum + Abs (sa)
      68               ca = Sqrt (ca)
      69               do k = 1, n
      70                 c(k, i) = ca * psi1(k) + sa * psi2(k)
      71                 c(k, j) = -sa * psi1(k) + ca * psi2(k)
      72               end do
      73             end if
      74           end if
      75         end do
      76       end do
      77       if (sum < 1.d-5) exit
      78     end do
      79 end subroutine local2
 
