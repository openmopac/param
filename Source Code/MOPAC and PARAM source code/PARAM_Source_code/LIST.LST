       1      subroutine interp(np, nq, mode, e, fp, cp, theta, vec_interp, fock
 _interp, &
       2      p_interp, h_interp, vecl, eold_ref)
       3       use molkst_C, only : keywrd, numcal, norbs
       4       use common_arrays_C, only :
       5       use chanel_C, only : iw
       6       use funcon_C, only : fpc_9, pi
       7       implicit none
       8       integer  :: np
       9       integer  :: nq
      10       integer , intent(inout) :: mode
      11       double precision , intent(in) :: e
      12       double precision , intent(in) :: fp((norbs*(norbs + 1))/2)
      13       double precision , intent(inout) :: cp(norbs,norbs)
      14       double precision , dimension (norbs, norbs), intent (inout) :: ve
 c_interp, &
      15     & fock_interp, p_interp
      16       double precision , dimension (norbs*norbs), intent (inout) :: h_i
 nterp
      17       double precision, dimension(norbs), intent (inout) :: theta
      18       double precision, intent (inout)  :: vecl(norbs*norbs)
      19       double precision, intent(inout) :: eold_ref
      20 !
      21       integer ::  icalcn, minpq, np1, np2, ii, i, i1, j, k, ik, ipoint,
  j1, &
      22         ij, il, k1, k2
      23       double precision :: xold, zero, ff, dum, dedx, deold, xnow, denow
 , enow, ck, sk
      24       integer :: npnts
      25       double precision, dimension(12) :: x, f, df
      26       double precision :: xlow, xhigh, xmin, emin
      27       logical :: debug
      28       save
      29 !-----------------------------------------------
      30 !*********************************************************************
      31 !
      32 ! INTERP: AN INTERPOLATION PROCEDURE FOR FORCING SCF CONVERGANCE
      33 !         ORIGINAL THEORY AND FORTRAN WRITTEN BY R.N. CAMP AND
      34 !         H.F. KING, J. CHEM. PHYS. 75, 268 (1981)
      35 !*********************************************************************
      36 !
      37 ! ON INPUT norbs     = NUMBER OF ORBITALS
      38 !          NP    = NUMBER OF FILLED LEVELS
      39 !          NQ    = NUMBER OF EMPTY LEVELS
      40 !          MODE  = 1, DO NOT RESET.
      41 !          E     = ENERGY
      42 !          FP    = FOCK MATRIX, AS LOWER HALF TRIANGLE, PACKED
      43 !          CP    = EIGENVECTORS OF FOCK MATRIX OF ITERATION -1
      44 !                  AS PACKED ARRAY OF NORBS**2 COEFFICIENTS
