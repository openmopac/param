     166             gamma(ib + 6, ib + 1) = gamma(ib + 5, ib + 1)
     167             gamma(ib + 6, ib + 2) = gamma(ib + 5, ib + 1)
     168             gamma(ib + 7, ib + 1) = gamma(ib + 5, ib + 1)
     169             gamma(ib + 7, ib + 3) = gamma(ib + 5, ib + 1)
