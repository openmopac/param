      97         beta = vt(3) - vt(1)
      98         gamma = vt(1) - vt(2)
      99         if (alpha == 0.D0) alpha = 1.D-20
     100         if (beta == 0.D0) beta = 1.D-20
     101         if (gamma == 0.D0) gamma = 1.D-20
     102         abg = -(phi(1)*alpha+phi(2)*beta+phi(3)*gamma)/alpha
     103         abg = abg/beta
     104         abg = abg/gamma
     105         alpha = abg
     106         beta = (phi(1)-phi(2))/gamma - alpha*(vt(1)+vt(2))
