     280           end if
     281           if (index(keywrd, " SILENT") == 0) then
     282             write (iw, 140) trim(ndimen(id+1))
     283   140       format(/,19x,'THE SYSTEM IS A',a,/)
     284             if (id == 0) go to 170
     285             write (iw, 150)
     286             write (iw, 160) (i,(tvec(j,i),j=1,3),i=1,id)
     287   150       format(/,'                UNIT CELL TRANSLATION VECTORS',/,
 /,&
     288             '              X                Y              Z')
     289 160         format('    T',i1,' =',f14.7,' ',f14.7,' ',f14.7)
     290           end if
     291         end if
     292       end if
     293   170 continue
     294       j = 0
     295       do i = 1, natoms
     296         if (labels(i)==99) cycle
     297         j = j + 1
     298         coord(:,j) = coord(:,i)
     299       end do
     300       return
     301       end subroutine gmetry
 
