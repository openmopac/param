     254           if (set_1_H_energy(i) < sum) then
     255             k = i
     256             sum = set_1_H_energy(i)
     257           end if
     258         end do
     259         if (sum > -0.8d0) exit
     260         if (set_1_H_dist(k) > "3.000") cycle
     261         if (l_prt) then
     262           if (trim(job_fn) == trim(geo_dat_name)) then
     263             line = "dataset"
     264           else
     265             line = "GEO_DAT"
     266           end if
     267           write(iw,'(//28x,a)')"Hydrogen bonds in "//trim(line)//" but
 
 FORCHECK PC V13.5.13     ANALYZE_H_BONDS      2021-03-24 10:59:30   page:   364
 wrt_diffs.F90  /FF
 
 not in GEO_REF"
     268           write(iw,'(/15x,a,21x,a,12x,a,5x,a,/)')"Donor atom","Hydrogen
  atom","H-bond length(A)","Energy    Sum"
     269           l_prt = .false.
     270         end if
     271         sum_a = sum_a + set_1_H_energy(k)
     272         write(iw,'(i4,3x,a, 7x, a, f17.3, f9.3)')l, set_1_H_txt(k), set
 _1_H_dist(k), set_1_H_energy(k), sum_a
     273         set_1_H_energy(k) = 5.d0
     274       end do
     275       j = 0
     276       l_prt = .true.
     277       do i = 1, set_2_P_Hbonds
     278         if (.not. l_used_2(i)) then
     279           j = j + 1
     280           set_2_H_txt(j) = set_2_H_txt(i)
     281           set_2_H_energy(j) = set_2_H_energy(i)
     282           set_2_H_dist(j) = set_2_H_dist(i)
     283         end if
     284       end do
     285       sum_a = 0.d0
     286       do l = 1, j
     287         k = 0
     288         sum = 10.d0
     289         do i = 1, j
     290           if (set_2_H_energy(i) < sum) then
     291             k = i
     292             sum = set_2_H_energy(i)
     293           end if
     294         end do
     295         if (sum > -0.8d0) exit
     296         if (set_2_H_dist(k) > "3.000") cycle
     297         if (l_prt) then
     298           if (trim(job_fn) == trim(geo_dat_name)) then
     299             line = "dataset"
     300           else
     301             line = "GEO_DAT"
     302           end if
     303           write(iw,'(//28x,a)')"Hydrogen bonds in GEO_REF but not in "/
 /trim(line)
     304           write(iw,'(/15x,a,21x,a,12x,a,5x,a,/)')"Donor atom","Hydrogen
  atom","H-bond length(A)","Energy    Sum"
     305           l_prt = .false.
     306         end if
     307         sum_a = sum_a + set_2_H_energy(k)
     308         write(iw,'(i4, 3x, a, 7x, a, f17.3, f9.3)')l, set_2_H_txt(k), s
 et_2_H_dist(k), set_2_H_energy(k), sum_a
     309         set_2_H_energy(k) = 5.d0
     310       end do
     311       return
     312   end subroutine analyze_h_bonds
 
