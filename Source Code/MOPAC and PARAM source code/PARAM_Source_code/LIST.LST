    1012       subroutine bdenup(bdcon, uab, c, d, da, norbs, nclose)
    1013 !-----------------------------------------------
    1014 !   M o d u l e s
    1015 !-----------------------------------------------
    1016 !**********************************************************************
 *
    1017 !-----------------------------------------------
    1018 !   I n t e r f a c e   B l o c k s
    1019 !-----------------------------------------------
    1020       implicit none
    1021 !-----------------------------------------------
    1022 !   D u m m y   A r g u m e n t s
    1023 !-----------------------------------------------
    1024       integer  :: norbs
    1025       integer , intent(in) :: nclose
    1026       double precision , intent(in) :: bdcon(norbs,norbs)
    1027       double precision , intent(in) :: uab(norbs,norbs)
    1028       double precision , intent(in) :: c(norbs,norbs)
    1029       double precision  :: d(norbs,norbs)
    1030       double precision , intent(inout) :: da(norbs,norbs)
    1031 !-----------------------------------------------
    1032 !   L o c a l   P a r a m e t e r s
    1033 !-----------------------------------------------
    1034 !-----------------------------------------------
    1035 !   L o c a l   V a r i a b l e s
    1036 !-----------------------------------------------
    1037       integer :: j, k, l, i
    1038       double precision, dimension(norbs) :: w1
    1039       double precision :: sum, s1, s2
    1040 !-----------------------------------------------
    1041 !
    1042 !  THIS SUBROUTINE IS USED TO COMPUTE THE FIRST-ORDER DENSITY
    1043 !
    1044 !
    1045 ! FORM DENSITY MATRIX
    1046 !
    1047 !
    1048       call zerom (d, norbs)
    1049 !
    1050 ! CALCULATE
    1051 !
    1052       do j = 1, norbs
    1053         do k = 1, norbs
    1054           sum = 0.D0
    1055           do l = 1, nclose
    1056             sum = sum + uab(k,l)*c(j,l)
    1057           end do
    1058           da(k,j) = sum
    1059         end do
    1060       end do
    1061       do i = 1, norbs
    1062         do k = 1, norbs
    1063           sum = 0.D0
    1064           do l = 1, nclose
    1065             sum = sum + c(i,l)*uab(l,k)
    1066           end do
    1067           w1(k) = sum
    1068         end do
 
 FORCHECK PC V13.5.13          BDENUP          2021-03-24 10:59:30   page:  2588
 polar.F90  /FF
 
    1069         do j = 1, norbs
    1070           s1 = 0.0D00
    1071           s2 = 0.0D00
    1072           do k = 1, norbs
    1073             s1 = s1 + c(i,k)*da(k,j)
    1074             s2 = s2 + w1(k)*c(j,k)
    1075           end do
    1076           d(i,j) = 2.0D00*(s1 - s2 + bdcon(i,j))
    1077         end do
    1078       end do
    1079       da(:norbs,:norbs) = d(:norbs,:norbs)*0.5D0
    1080 !
    1081       return
    1082       end subroutine bdenup
 
