      81       subroutine pmepco(pp, ria, w, ui, co, nonzo, id)
      82 !-----------------------------------------------
      83 !   M o d u l e s
      84 !-----------------------------------------------
      85       use common_arrays_C, only : nat, nfirst, nlast
      86       use molkst_C, only : numat
      87       use funcon_C, only : ev
      88 !**********************************************************************
      89 ! PMEPCO IS THE CORE SUBROUTINE OF THIS PROGRAM <PMEP>. IT CALCULATES
      90 ! THE MEP AT AN ARBITRALRY POSITION W(3).
      91 ! REF.  B. WANG AND G.P.FORD J.COMPT.CHEM. IN PRESS
      92 !       G.P.FORD AND B. WANG J.COMPT.CHEM. 14(1993)1101
      93 !                                      WRITTEN BY BINGZE WANG FEB 1993
      94 !**********************************************************************
      95 !**********************************************************************
 *
      96 !-----------------------------------------------
      97 !   I n t e r f a c e   B l o c k s
      98 !-----------------------------------------------
      99       implicit none
     100 !-----------------------------------------------
     101 !   G l o b a l   P a r a m e t e r s
     102 !-----------------------------------------------
     103 !-----------------------------------------------
     104 !   D u m m y   A r g u m e n t s
     105 !-----------------------------------------------
     106       integer , intent(in) :: nonzo
     107       integer , intent(in) :: id
     108       double precision , intent(out) :: ui
     109       double precision , intent(in) :: pp(*)
     110       double precision , intent(in) :: ria(*)
     111       double precision  :: w(3)
     112       double precision  :: co(3,*)
     113 !-----------------------------------------------
     114 !   L o c a l   V a r i a b l e s
     115 !-----------------------------------------------
     116       integer :: j, mn, i, ia, ib, ni, i2, i1, k
     117       double precision, dimension(10) :: e1b
     118       double precision, dimension(nonzo) :: vp
     119       double precision, dimension(107) :: alpw, aw
     120       double precision :: enuclr, rr, xx, yy, zz, fnear, enuc
     121 !-----------------------------------------------
     122 !                                    AM1 PARAMETERS (FOR H,C,N,O,F,CL)
     123       data alpw/ 2.92D0, 4*0.0D0, 4.36D0, 6.95D0, 9.22D0, 5.53D0, 0.0D0
 , 4*&
     124         0.0D0, 2.3D0, 2.6D0, 3.32D0, 17*0.0D0, 3.32D0, 72*0.0D0/
     125       data aw/ 0.05D0, 4*0.0D0, 0.63D0, 0.64D0, 0.67D0, 0.29D0, 0.0D0,
 4*0.0D0&
     126         , 0.45D0, 0.37D0, 0.31D0, 17*0.0D0, 0.31D0, 72*0.0D0/
     127 !
     128       vp(:nonzo) = 0.0D0
     129       mn = 0
     130       enuclr = 0.D0
     131       do i = 1, numat
     132         ia = nfirst(i)
     133         ib = nlast(i)
     134         ni = nat(i)
     135         if (id == 1) then
 
 FORCHECK PC V13.5.13          PMEPCO          2021-03-24 10:59:30   page:  3022
 pmep.F90  /FF
 
     136           rr = ria(i)
     137         else
     138           xx = w(1) - co(1,i)
     139           yy = w(2) - co(2,i)
     140           zz = w(3) - co(3,i)
     141           rr = sqrt(xx*xx + yy*yy + zz*zz)
     142         end if
     143         fnear = 1.0D0 + exp((-alpw(ni)*(rr-aw(ni))))
     144 !
     145         call drotat (ni, co(1,i), w, e1b, enuc, rr)
     146         enuclr = enuclr + enuc*fnear
     147         i2 = 0
     148         do i1 = ia, ib
     149           if (i1 - ia + 1 > 0) then
     150             vp(mn+1:i1-ia+1+mn) = e1b(i2+1:i1-ia+1+i2)
     151             i2 = i1 - ia + 1 + i2
     152             mn = i1 - ia + 1 + mn
     153           end if
     154         end do
     155       end do
     156       mn = 0
     157       ui = 0.0D0
     158       do i = 1, numat
     159         ia = nfirst(i)
     160         ib = nlast(i)
     161         do j = ia, ib
     162           do k = ia, j
     163             mn = mn + 1
     164             if (k == j) then
     165               ui = ui + pp(mn)*vp(mn)
     166             else
     167               ui = ui + 2.0D0*pp(mn)*vp(mn)
     168             end if
     169           end do
     170         end do
     171       end do
     172       ui = (enuclr + ui)*ev
     173 !                                                       UI  IN KCAL/MOL
     174       return
     175       end subroutine pmepco
 
 FORCHECK PC V13.5.13          PMEPCO          2021-03-24 10:59:30   page:  3023
 pmep.F90  /FF


