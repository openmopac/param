     163   function truncation(R, limit, spread)
     164 !
     165 !  Truncation has the values:
     166 !
     167 !  limit, when R < limit - spread
     168 !  greater than R when R is in the range: limit - spread < R < limit +
 spread
     169 !  R, when R > limit + spread
     170 !
     171 !  At limit + spread, the slope of truncation is 1, i.e., equal to the
 slope for R > limit + spread
     172 !  At limit - spread, the slope is zero, i.e., equal to the slope of th
 e constant "limit"
     173 !
     174   implicit none
     175   double precision, intent(in) :: R, limit, spread
     176   double precision :: truncation, a, b
     177     a = limit - spread
     178     b = limit + spread
     179     if (R < b) then
     180       if (R < a) then
     181         truncation = limit
     182       else
     183         truncation = limit + (limit - a)/(a - b)**2*(R - a)**2
     184       end if
     185     else
     186       truncation = R
     187     end if
     188     return
     189   end function truncation
 
