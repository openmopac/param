     223       subroutine exdeltap(io, iv, nio, deltap)
     224       use molkst_c, only : mpack
     225       use reimers_C, only : n, matind, cc0
     226       implicit none
     227       double precision  :: deltap(mpack)
     228       integer :: i, j, ia, occ, vir, &
     229                  io(4), iv(4), nio
     230 !**********************************************************************
 *
     231 !   RMG - compute the change in density for a particular excitation.
     232 !**********************************************************************
 *
     233       do i = 1, mpack
     234         deltap(i) = 0.d0
     235       end do
     236
     237       do j = 1, nio
     238         occ = io(j)
     239         vir = iv(j)
     240         do i = 1, n
     241           ia = matind(i) + i
     242           deltap(ia) = deltap(ia) + cc0(vir, i)**2 - cc0(occ, i)**2
     243         end do
     244       end do
     245
     246       return
     247       end subroutine exdeltap
 
