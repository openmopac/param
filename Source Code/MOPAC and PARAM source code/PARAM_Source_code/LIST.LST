     697     implicit none
     698     integer, intent (in) :: i
     699     integer, dimension (numat), intent (in) :: mb
     700     integer, dimension (numat), intent (inout) :: ir5
     701 !
     702     integer :: j, j1, k, k1, l, l1, m, m1, n1, ni, nj, nk, nm
     703     integer :: nrings = 1
     704     ni = nbonds(i)
     705     do j1 = 1, ni
     706       j = ibonds(j1, i)
     707       if (mb(j) >= 3) then
     708         nj = nbonds(j)
     709         do k1 = j1 + 1, ni
     710           k = ibonds(k1, i)
     711           if (mb(j) >= 3) then
     712             nk = nbonds(k)
     713 !
     714 !   Atoms J and K are attached to atom I.
     715 !   Find atoms, other than I, that are attached to J and K.
     716 !
     717             do l1 = 1, nj
     718               l = ibonds(l1, j)
     719               if (l /= i) then
     720                 if (mb(l) >= 3) then
     721                   do m1 = 1, nk
     722                     m = ibonds(m1, k)
     723                     if (m /= i) then
     724                       if (mb(m) >= 3) then
     725 !
     726 !  Atoms L and M are attached to J and K respectively.
     727 !  The connectivity is thus: M-K-I-J-L.  Now, check:
     728 ! is M attached to L?
     729 !
     730                         nm = nbonds(m)
     731                         do n1 = 1, nm
     732                           if (ibonds(n1, m) == l) go to 1000
     733                         end do
     734                       end if
     735                     end if
     736                   end do
     737                 end if
     738               end if
     739             end do
     740           end if
     741         end do
     742       end if
     743     end do
     744     return
     745 !
     746 ! Flag atoms I, J, K, L, and M as being members of a five-membered ring
 .
     747 !
     748 1000 nrings = nrings + 1
     749     ir5(i) = nrings
     750     ir5(j) = nrings
 
 FORCHECK PC V13.5.13          RING5           2021-03-24 10:59:30   page:  3343
 chklew.F90  /FF
 
     751     ir5(k) = nrings
     752     ir5(l) = nrings
     753     ir5(m) = nrings
     754 end subroutine ring5
 
