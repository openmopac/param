    1162   subroutine aq_vec (coord, srad, numat, cosurf, nps, nar_csm, nsetf, &
    1163        & nset, rsc, nipsrs, iatsp, tm, ioldcv, maxrs, lenabc, a_diag, q
 , v)
    1164     !
    1165     ! Computes A*q product using N**2 algorithm
    1166     !
    1167     use cosmo_C, only : dirvec, disex2
