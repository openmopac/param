    1821   subroutine geo_diff(sum, rms, prt)
    1822 !
    1823 !  geo_diff calculates the total distance between geometries "geo" and
 "geoa"
    1824 !
    1825 !  Two measures are used:
    1826 !
    1827 !   sum = addition of all differences in position, i.e., sum of motions
  of atoms.
    1828 !   rms = sum of squares of differences in positions,
    1829 !   i.e., the square of the vector sum of differences
    1830 !
    1831     use common_arrays_C, only : geo, geoa, txtatm, nat
    1832     use molkst_C, only : numat, keywrd, txtmax, line
    1833     use chanel_C, only : iw
    1834     use elemts_C, only : elemnt
    1835     use MOZYME_C, only : tyres
    1836     implicit none
    1837     double precision, intent (out) :: sum, rms
    1838     logical, intent (in) :: prt
    1839     logical :: precise
    1840     integer :: i, j, k, lim, ires_l, ires_u
    1841     logical :: first, l_first
    1842     double precision :: dum1, sum1
    1843     character :: num*7
    1844     integer, allocatable :: No_atoms_in_residue(:)
    1845     double precision, allocatable :: move(:), residue_motion(:)
    1846     character, allocatable :: residue_name(:)*10
    1847     double precision, external :: reada
    1848     save :: first, l_first
    1849     allocate (move(numat), residue_motion(-100:numat), residue_name(-10
 0:numat), No_atoms_in_residue(-100:numat))
    1850 !
    1851 !  Calculate the average and RMS differences of two geometries
    1852 !
    1853     precise = (index(keywrd, " PREC") /= 0)
    1854     residue_motion = 0.d0
    1855     No_atoms_in_residue = 0
    1856     ires_l = 10000
    1857     ires_u = -1000
    1858     sum = 0.d0
    1859     rms = 0.d0
    1860     do i = 1, numat
    1861       dum1 =  (geo(1,i) - geoa(1,i))**2 + &
    1862               (geo(2,i) - geoa(2,i))**2 + &
    1863               (geo(3,i) - geoa(3,i))**2
    1864       rms = rms + dum1
    1865       dum1 = sqrt(dum1)
    1866       move(i) = dum1
    1867       sum = sum + dum1
    1868       if (txtmax == 26) then
    1869         j = max(-100, nint(reada(txtatm(i), 24)))
    1870         ires_l = min(j, ires_l)
    1871         ires_u = max(j, ires_u)
    1872         residue_motion(j) = residue_motion(j) + move(i)
    1873         No_atoms_in_residue(j) = No_atoms_in_residue(j) + 1
    1874         residue_name(j) = txtatm(i)(17:26)
    1875       end if
 
 FORCHECK PC V13.5.13         GEO_DIFF         2021-03-24 10:59:30   page:  3935
