     104   subroutine build_res_start_etc()
     105     use MOZYME_C, only : nres, at_res, res_start
     106     use molkst_C, only: numat, id
     107     use common_arrays_C, only : txtatm, nat, nbonds, ibonds
     108     implicit none
     109     integer :: i, j
     110     character :: ren_name(numat)*9, residue*9
     111 !
     112 ! Work out which residue each atom belongs to, and the location of the
 first atom
     113 ! in each residue.
     114 !
     115     nres = 0
     116     ren_name = " "
     117     if (.not. allocated(at_res)) allocate(at_res(numat + id))
     118 !
     119 !  Do all non-hydrogen atoms
     120 !
     121      do i = 1, numat
     122       if (nat(i) == 1 .and. nbonds(i) == 1) cycle
     123       residue = txtatm(i)(18:26)
     124       do j = 1, nres
     125         if (ren_name(j) == residue) exit
     126       end do
     127       if (j > nres) then
     128         nres = nres + 1
     129         ren_name(j) = residue
     130         res_start(j) = i
     131       end if
     132       at_res(i) = j
     133      end do
     134 !
     135 ! Do all hydrogen atoms
     136 !
     137     do i = 1, numat
     138       if (nat(i) /= 1 .or. nbonds(i) /= 1) cycle
     139         j = ibonds(1,i)
     140         residue = txtatm(j)(18:26)
     141       do j = 1, nres
     142         if (ren_name(j) == residue) exit
     143       end do
     144       at_res(i) = j
     145     end do
     146     return
     147   end subroutine build_res_start_etc
 
