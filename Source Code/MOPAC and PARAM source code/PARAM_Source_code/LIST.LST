      48       logical function collid (cw, rw, cnbr, rnbr, nnbr, ishape)
      49 !-----------------------------------------------
      50 !   M o d u l e s
      51 !-----------------------------------------------
      52 !****************************************************************
      53 !
      54 !     COLLISION CHECK OF PROBE WITH NEIGHBORING ATOMS
      55 !     USED BY SURFAC ONLY.
      56 !
      57 !****************************************************************
      58       implicit none
      59 !-----------------------------------------------
      60 !   D u m m y   A r g u m e n t s
      61 !-----------------------------------------------
      62       integer , intent(in) :: nnbr
      63       integer , intent(in) :: ishape
      64       double precision , intent(in) :: rw
      65       double precision , intent(in) :: cw(3)
      66       double precision , intent(in) :: cnbr(3,200)
      67       double precision , intent(in) :: rnbr(200)
      68 !-----------------------------------------------
      69 !   L o c a l   V a r i a b l e s
      70 !-----------------------------------------------
      71       integer :: i
      72       double precision :: sumrad, vect1, vect2, vect3, sr2, dd2
      73 !-----------------------------------------------
      74       if (nnbr > 0) then
      75 !
      76 !     CHECK WHETHER PROBE IS TOO CLOSE TO ANY NEIGHBOR
      77 !
      78         if (ishape == 3) then
      79         else
      80           do i = 1, nnbr
      81             sumrad = rw + rnbr(i)
      82             vect1 = dabs(cw(1)-cnbr(1,i))
      83             if (vect1 >= sumrad) cycle
      84             vect2 = dabs(cw(2)-cnbr(2,i))
      85             if (vect2 >= sumrad) cycle
      86             vect3 = dabs(cw(3)-cnbr(3,i))
      87             if (vect3 >= sumrad) cycle
      88             sr2 = sumrad**2
      89             dd2 = vect1**2 + vect2**2 + vect3**2
      90             if (dd2 < sr2) go to 30
      91           end do
      92         end if
      93       end if
      94       collid = .FALSE.
      95       go to 40
      96    30 continue
      97       collid = .TRUE.
      98    40 continue
      99       return
     100       end function collid
 
