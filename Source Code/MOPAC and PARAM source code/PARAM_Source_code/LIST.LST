     167       end if
     168       scale = 0.d0
     169       if (method_pm6 .or. method_pm7 .or. method_pm8) then
     170   !
     171   !  VdW term
     172   !
     173         ax = guess2(ni,1)*(r - guess3(ni,1))**2
     174         if (ax < 25.D0) scale = scale + tore(ni)*tore(nj)/r*guess1(ni,1
 )*exp((-ax))
     175         ax = guess2(nj,1)*(r - guess3(nj,1))**2
     176         if (ax < 25.D0) scale = scale + tore(ni)*tore(nj)/r*guess1(nj,1
 )*exp((-ax))
     177         if (abond > 1.d-4) then
     178           i = 0
     179         else
     180           i = 4
     181         end if
     182       else
     183           i = 4
     184           if (fff > 1.d-4) i = 0
     185       end if
     186       do ig = 1, i
     187         if (abs(guess1(ni,ig)) > 0.D0) then
     188           ax = guess2(ni,ig)*(r - guess3(ni,ig))**2
     189           if (ax <= 25.D0) scale = scale + tore(ni)*tore(nj)/r*guess1(n
 i,ig)*&
     190             exp((-ax))
     191         end if
     192         if (abs(guess1(nj,ig)) <= 0.D0) cycle
     193         ax = guess2(nj,ig)*(r - guess3(nj,ig))**2
     194         if (ax > 25.D0) cycle
     195         scale = scale + tore(ni)*tore(nj)/r*guess1(nj,ig)*exp((-ax))
     196       end do
     197       enuclr = enuclr + scale
     198       if (method_pm6 .or. method_pm7 .or. method_pm8) then
     199 !
     200 !  The next term is the unpolarizable core - unpolarizable core interac
 tion
     201 !  It should have no effect on heats of formation or other properties.
     202 !  Its purpose is to allow systems where the atoms are forced together
     203 !  to be realistic.  The form of the expression is the Lennard-Jones "1
 2" part
     204 !  in the "12 - 6" potential.
     205 !
     206 !  The multiplier "1.d-8" was chosen to make the function negligible at
     207 !  normal bonding distances. "ax" is proportional to the interatomic di
 stance
     208 !  divided by the sum of the two covalent radii.
     209 !
     210         ax = r/(ni**0.3333d0 + nj**0.3333d0)
     211         if (ax < 3.d0) then
     212           scale = 1.d-8/ax**12
     213           enuclr = enuclr + min(scale, 1.d5)
     214         end if
     215       end if
     216       return
     217       end subroutine ccrep
 
