    1328   subroutine minimize_energy(loop)
    1329     USE molkst_C, only : numat, refkey, line, numcal, nvar, time0, escf
 , gnorm, keywrd
    1330     use common_arrays_C, only : xparam, grad, geo, loc
    1331     use chanel_C, only : iw
    1332     implicit none
    1333     integer, intent (in) :: loop
    1334     double precision :: gnorm_lim
    1335 !
    1336 !
    1337 !
    1338     integer :: i, k, l
    1339     double precision, external :: seconds, reada
    1340
    1341
    1342       call l_control("TS", len("TS"), -1)
    1343       write(iw,'(a, i4 ,a,/)')"  Loop:", loop, &
    1344       "  Energy minimization, excluding active site, using L-BFGS"
    1345       gnorm_lim = nint(numat**0.25d0*2.d0 + 1.d0)
    1346       line = refkey(1)
    1347       call upcase(line, len_trim(line))
    1348       i = index(line, " GNORM=")
    1349       if (i /= 0) gnorm_lim = reada(line, i)
    1350       write(line,'(a,f0.1)')"DDMIN=0 GNORM=",gnorm_lim
    1351       call l_control(trim(line), len_trim(line), 1)
    1352       numcal = numcal + 1
    1353       time0 = seconds(1)
    1354       if (nvar > 0) then
    1355         call lbfgs(xparam,escf)
    1356         do i = 1, nvar
    1357           k = loc(1,i)
    1358           l = loc(2,i)
    1359           geo(l,k) = xparam(i)
    1360         end do
    1361       else
    1362         call compfg (xparam, .TRUE., escf, .TRUE., grad, .FALSE.)
    1363         gnorm = 0.d0
    1364       end if
    1365       if (gnorm < gnorm_lim) then
    1366         i = index(keywrd, " GNORM")
    1367         write (iw, '(/, 5 x, "GRADIENT =", f9.5, " IS LESS THAN CUTOFF
 =", f9.5,//)') gnorm, &
    1368         gnorm_lim
    1369       end if
    1370       return
    1371   end subroutine minimize_energy
 
