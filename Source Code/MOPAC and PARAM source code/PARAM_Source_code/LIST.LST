     324         do jj = 1, iminus
     325           ja = nfirst(jj)
     326           jb = nlast(jj)
     327           n = n + 1
     328           e(n, 4) = 0.0d0
     329           ex(n, 1) = 0.0d0
     330           i3 = 0
     331           do i = ia, ib
     332             i3 = i3 + 1
     333             ka = (i*(i-1)) / 2
     334             j3 = 0
     335             do j = ia, i
