     795         call prtgra ()
     796       end if
     797       write (iw, '(/10X,''CURRENT VALUE OF GEOMETRY'',/)')
     798       call geout (iw)
     799     end if
     800 !
     801 !  IPOW(1) AND IPOW(9) ARE USED ALREADY, THE REST ARE FREE FOR USE
     802 !
     803     ipow(8) = nscf
     804     write (ires) numat, norbs, (xparam(i),i=1,nvar)
     805     if (latom /= 0) then
     806       if (index(keywrd,' STEP=') /= 0) then
     807         write (ires) kloop
     808         write (ires) rxn_coord
     809         write (ires) (profil(i),i=1,kloop)
     810       else
     811         write (ires) ((alparm(j,i),j=1,3),i=1,nvar)
     812        write (ires) iloop, x0, x1, x2
     813       end if
     814     end if
     815     write (ires) ipow, il, nstep, funct, tt0
     816     write (ires) (grad(i),i=1,nvar)
     817     write (ires) ((hess(j,i),j=1,nvar),i=1,nvar)
     818     write (ires) ((bmat(j,i),j=1,nvar),i=1,nvar)
     819     write (ires) (oldf(i),i=1,nvar), (d(i),i=1,nvar), (vmode(i),i=1,nva
 r)
     820     write (ires) ddx, ef_mode, nstep, negreq
     821     linear = (nvar*(nvar + 1))/2
     822     write (ires) (pmat(i),i=1,linear)
     823     call den_in_out(1)
     824     if (index(keywrd,'STEP1') /= 0) return
     825     close(ires)
     826     return
     827   else
     828     read (ires, iostat = io_stat)old_numat, old_norbs
     829     if (norbs /= old_norbs .or. numat /= old_numat) then
     830         call mopend("Restart file read in does not match current data s
 et")
     831         return
     832     end if
     833     if (latom /= 0) then
     834       if (index(keywrd,' STEP=') /= 0) then
     835         read (ires, iostat = io_stat) kloop
     836         read (ires, iostat = io_stat) rxn_coord
     837         read (ires, iostat = io_stat) (profil(i),i=1,kloop)
     838       else
     839         read (ires, iostat = io_stat) ((alparm(j,i),j=1,3),i=1,nvar)
     840         read (ires, iostat = io_stat) iloop, x0, x1, x2
     841       end if
     842     end if
     843     read (ires, iostat = io_stat) ipow, il, nstep, funct, tt0
     844     nscf = ipow(8)
     845     i = int(tt0/1000000)
     846     tt0 = tt0 - i*1000000
     847     write (iw, '(2/10X,''TOTAL TIME USED SO FAR:'',F13.2,'' SECONDS'')'
