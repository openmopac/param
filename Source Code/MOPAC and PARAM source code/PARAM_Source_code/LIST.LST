    1963       subroutine w2mat(ww, w, kr, limij, limkl)
    1964 !-----------------------------------------------
    1965 !   M o d u l e s
    1966 !-----------------------------------------------
    1967 !     *
    1968 !     STORE TWO-CENTER TWO-ELECTRON INTEGRALS IN A SQUARE MATRIX.
    1969 !     *
    1970       implicit none
    1971 !-----------------------------------------------
    1972 !   D u m m y   A r g u m e n t s
    1973 !-----------------------------------------------
    1974       integer , intent(inout) :: kr
    1975       integer , intent(in) :: limij
    1976       integer , intent(in) :: limkl
    1977       double precision , intent(in) :: ww(limkl,limij)
    1978       double precision , intent(out) :: w(*)
    1979 !-----------------------------------------------
    1980 !   L o c a l   V a r i a b l e s
    1981 !-----------------------------------------------
    1982     integer :: ij, kl, l
    1983    !
    1984    ! ... Executable Statements ...
    1985    !
    1986     l = 0
    1987     do ij = 1, limij
    1988       do kl = 1, limkl
    1989         l = l + 1
    1990         w(l) = ww(kl, ij)
    1991       end do
    1992     end do
    1993     kr = kr + l
    1994       return
    1995       end subroutine w2mat
 
