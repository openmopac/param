     121 !
     122 !
     123 !
     124   double precision function nsp2_correction()
     125 !
     126 !   Add a molecular mechanics correction to all nitrogen atoms that hav
 e exactly
     127 !   three ligands.
     128 !
     129     use common_arrays_C, only : nat, coord, nbonds, ibonds
     130     use molkst_C, only : numat, method_pm6, method_pm7, method_pm8
     131     implicit none
     132     integer :: i, j
     133     double precision :: correction, sum
     134     double precision, external :: nsp2_atom_correction
     135     if ( .not. (method_pm6 .or. method_pm7 .or. method_pm8)) then
     136       nsp2_correction = 0.d0
     137       return
     138     end if
     139     correction = 0.d0
     140     do i = 1, numat
     141       if (nat(i) == 7 .and. nbonds(i) == 3) then
     142         j = 0
     143         if (nat(ibonds(1,i)) == 1) j = 1
     144         if (nat(ibonds(2,i)) == 1) j = j + 1
     145         if (nat(ibonds(3,i)) == 1) j = j + 1
     146         if ( j < 2) then
     147           sum = nsp2_atom_correction(coord, i, ibonds(1,i), ibonds(2,i)
 , ibonds(3,i))
     148           correction = correction + sum
     149          end if
     150       end if
     151     end do
     152     nsp2_correction = correction
     153   end function nsp2_correction
 
