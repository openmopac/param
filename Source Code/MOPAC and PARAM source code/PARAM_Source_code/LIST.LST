       1       double precision function helect (n, p, h, f)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       implicit none
       6 !-----------------------------------------------
       7 !   D u m m y   A r g u m e n t s
       8 !-----------------------------------------------
       9       integer , intent(in) :: n
      10       double precision , intent(in) :: p(*)
      11       double precision , intent(in) :: h(*)
      12       double precision , intent(in) :: f(*)
      13 !-----------------------------------------------
      14 !   L o c a l   V a r i a b l e s
      15 !-----------------------------------------------
      16       integer :: k, nn, i, jj
      17       double precision :: ed, ee
      18 !-----------------------------------------------
      19 !**********************************************************************
 *
      20 !
      21 !    SUBROUTINE CALCULATES THE ELECTRONIC ENERGY OF THE SYSTEM IN EV.
      22 !
      23 !    ON ENTRY N = NUMBER OF ATOMIC ORBITALS.
      24 !             P = DENSITY MATRIX, PACKED, LOWER TRIANGLE.
      25 !             H = ONE-ELECTRON MATRIX, PACKED, LOWER TRIANGLE.
      26 !             F = TWO-ELECTRON MATRIX, PACKED, LOWER TRIANGLE.
      27 !    ON EXIT
      28 !        HELECT = ELECTRONIC ENERGY.
      29 !
      30 !    NO ARGUMENTS ARE CHANGED.
      31 !
      32 !**********************************************************************
 *
      33       ed = 0.0D00
      34       ee = 0.0D00
      35       k = 0
      36       nn = n + 1
      37       do i = 2, nn
      38         k = k + 1
      39         jj = i - 1
      40         ed = ed + p(k)*(h(k)+f(k))
      41         if (i == nn) cycle
      42         if (jj > 0) then
      43           ee = ee + sum(p(k+1:jj+k)*(h(k+1:jj+k)+f(k+1:jj+k)))
      44           k = jj + k
      45         end if
      46       end do
      47       ee = ee + .5D00*ed
      48       helect = ee
      49       return
      50 !
      51       end function helect
 
