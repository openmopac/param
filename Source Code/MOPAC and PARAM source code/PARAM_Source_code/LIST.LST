       1  subroutine extract_parameter (iparam, ielmnt, param)
       2 !
       3     use parameters_C, only : guess1, guess2, guess3, zs, zp, zd, &
       4     betas, betap, betad, alp, zsn, zpn, zdn, uss, upp, udd, gss, gpp, &
