     219           i2 = 0
     220           do i1 = ia, ib
     221             ii = i1*(i1 - 1)/2 + ja - 1
     222             i2 = i2 + 1
     223             jj = min(i1,jb)
     224             h(ii+1:jj-ja+1+ii) = h(ii+1:jj-ja+1+ii) + di(i2,:jj-ja+1)
     225           end do
     226 !
     227 !   CALCULATE THE TWO-ELECTRON INTEGRALS, W; THE ELECTRON NUCLEAR TERMS
     228 !   E1B AND E2A; AND THE NUCLEAR-NUCLEAR TERM ENUC.
     229 !
     230           if (id == 0) then
     231             call rotate (ni, nj, coord(1,i), coord(1,j), w(kr), kr, e1b
 , e2a, enuc)
     232           else
     233             kro = kr
     234             call solrot (ni, nj, coord(1,i), coord(1,j), wjd, wkd, kr,
 e1b, e2a, enuc)
     235             jj = 0
     236             w(kro:kr - 1) = wjd(:kr-kro)
     237             wk(kro:kr - 1) = wkd(:kr-kro)
     238           end if
     239           enuclr = enuclr + enuc
     240 !
     241 !   ADD ON THE ELECTRON-NUCLEAR ATTRACTION TERM FOR ATOM I.
     242 !
     243           i2 = 0
     244           do i1 = ia, ib
     245             ii = i1*(i1 - 1)/2 + ia - 1
     246             if (i1 - ia + 1 > 0) then
     247               h(ii+1:i1-ia+1+ii) = h(ii+1:i1-ia+1+ii) + e1b(i2+1:i1-ia+
 1+i2)*half
     248               i2 = i1 - ia + 1 + i2
     249             end if
     250           end do
     251 !
     252 !   ADD ON THE ELECTRON-NUCLEAR ATTRACTION TERM FOR ATOM J.
     253 !
     254           i2 = 0
     255           do i1 = ja, jb
     256             ii = i1*(i1 - 1)/2 + ja - 1
     257             if (i1 - ja + 1 > 0) then
     258               h(ii+1:i1-ja+1+ii) = h(ii+1:i1-ja+1+ii) + e2a(i2+1:i1-ja+
 1+i2)*half
     259               i2 = i1 - ja + 1 + i2
     260             end if
     261           end do
     262         end do
     263         ii = ib - ia + 1
     264         ii = (ii*(ii+1)) / 2
     265         if (id /= 0) then
     266           do i1 = kr, kr + ii * ii - 1
     267             wk(i1) = 0.d0
     268           end do
     269         end if
     270         if (ii /= 0) then
     271           call wstore (w(kr), kr, ni, ii)
     272         end if
     273       end do
 
