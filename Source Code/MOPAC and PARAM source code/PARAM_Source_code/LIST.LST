     564
     565 subroutine trstlp (n,  m,  a,  b,  rho,  dx,  ifull)
     566
     567 ! N.B. Arguments Z,  ZDOTA,  VMULTC,  SDIRN,  DXNEW,  VMULTD & IACT hav
 e been removed.
     568
     569 integer,  intent(in)     :: n
     570 integer,  intent(in)     :: m
     571 double precision,  intent(in)   :: a(n, 10)
     572 double precision,  intent(in)   :: b(m)
     573 double precision,  intent(in)   :: rho
     574 double precision,  intent(out)  :: dx(10)
     575 integer,  intent(out)    :: ifull
     576
     577 !
     578
     579 double precision :: z(n, n),  zdota(m + 1),  vmultc(m + 1),  sdirn(n),
  dxnew(n),  vmultd(m + 1)
     580 double precision :: acca,  accb,  alpha,  beta,  dd,  optnew,  optold,
  ratio,  resmax,    &
     581              resold,  sd,  sp,  spabs,  ss,  step,  stpful,  sumabs,  t
 emp,  tempa,  &
     582              tot,  total,  vsave,  zdotv,  zdotw,  zdvabs,  zdwabs
     583 integer   :: i,  iact(m + 1),  icon,  icount,  isave,  k,  kk,  kl,  kp
 ,  kw,  mcon,    &
     584              nact,  nactx
     585
     586 ifull = 1
     587 icon = 0
     588 mcon = m
     589 nact = 0
     590 nactx = 0
     591 resold = 0.d0
     592 resmax = 0.0d0
     593 do i=1, n
     594   z(i, 1:n) = 0.0d0
     595   z(i, i) = 1.0d0
     596   dx(i) = 0.0d0
     597 end do
     598 if (m >= 1) then
     599   do k=1, m
     600     if (b(k) > resmax) then
     601       resmax = b(k)
     602       icon = k
     603     end if
     604   end do
     605   do k=1, m
     606     iact(k) = k
     607     vmultc(k) = resmax - b(k)
     608   end do
     609 end if
     610 if (resmax == 0.0d0) go to 480
     611 sdirn(1:n) = 0.0d0
     612
     613 !  end the current stage of the calculation if 3 consecutive iterations
     614 !  have either failed to reduce the best calculated value of the object
 
 FORCHECK PC V13.5.13          TRSTLP          2021-03-24 10:59:30   page:  2718
 orient_water.F90  /FF
 
 ive
     615 !  function or to increase the number of active constraints since the b
 est
     616 !  value was calculated. This strategy prevents cycling,  but there is
 a
     617 !  remote possibility that it will cause premature termination.
     618
     619 60 optold = 0.0d0
     620 icount = 0
     621 70 if (mcon == m) then
     622   optnew = resmax
     623 else
     624   optnew = -dot_product( dx(1:n),  a(1:n, mcon) )
     625 end if
     626 if (icount == 0 .or. optnew < optold) then
     627   optold = optnew
     628   nactx = nact
     629   icount = 3
     630 else if (nact > nactx) then
     631   nactx = nact
     632   icount = 3
     633 else
     634   icount = icount - 1
     635   if (icount == 0) go to 490
     636 end if
     637
     638 !  if ICON exceeds NACT,  then we add the constraint with index IACT(IC
 ON) to
     639 !  the active set. Apply Givens rotations so that the last N-NACT-1 col
 umns
     640 !  of Z are orthogonal to the gradient of the new constraint,  a scalar
     641 !  product being set to zero if its nonzero value could be due to compu
 ter
     642 !  rounding errors. The array DXNEW is used for working space.
     643
     644 if (icon <= nact) go to 260
     645 kk = iact(icon)
     646 dxnew(1:n) = a(1:n, kk)
     647 tot = 0.0d0
     648 k = n
     649 100 if (k > nact) then
     650   sp = 0.0d0
     651   spabs = 0.0d0
     652   do i=1, n
     653     temp = z(i, k)*dxnew(i)
     654     sp = sp + temp
     655     spabs = spabs + abs(temp)
     656   end do
     657   acca = spabs + 0.1d0*abs(sp)
     658   accb = spabs + 0.2d0*abs(sp)
     659   if (spabs >= acca .or. acca >= accb) sp = 0.0d0
     660   if (tot == 0.0d0) then
     661     tot = sp
     662   else
     663     kp = k + 1
     664     temp = sqrt(sp*sp + tot*tot)
     665     alpha = sp/temp
     666     beta = tot/temp
     667     tot = temp
 
 FORCHECK PC V13.5.13          TRSTLP          2021-03-24 10:59:30   page:  2719
 orient_water.F90  /FF
 
     668     do i=1, n
     669       temp = alpha*z(i, k) + beta*z(i, kp)
     670       z(i, kp) = alpha*z(i, kp) - beta*z(i, k)
     671       z(i, k) = temp
     672     end do
     673   end if
     674   k = k - 1
     675   go to 100
     676 end if
     677
     678 !  Add the new constraint if this can be done without a deletion from t
 he
     679 !  active set.
     680
     681 if (tot /= 0.0d0) then
     682   nact = nact + 1
     683   zdota(nact) = tot
     684   vmultc(icon) = vmultc(nact)
     685   vmultc(nact) = 0.0d0
     686   go to 210
     687 end if
     688
     689 !  The next instruction is reached if a deletion has to be made from th
 e
     690 !  active set in order to make room for the new active constraint,  bec
 ause
     691 !  the new constraint gradient is a linear combination of the gradients
  of
     692 !  the old active constraints.  Set the elements of VMULTD to the multi
 pliers
     693 !  of the linear combination.  Further,  set IOUT to the index of the
     694 !  constraint to be deleted,  but branch if no suitable index can be fo
 und.
     695
     696 ratio = -1.0d0
     697 k = nact
     698 130 zdotv = 0.0d0
     699 zdvabs = 0.0d0
     700 do i=1, n
     701   temp = z(i, k)*dxnew(i)
     702   zdotv = zdotv + temp
     703   zdvabs = zdvabs + abs(temp)
     704 end do
     705 acca = zdvabs + 0.1d0*abs(zdotv)
     706 accb = zdvabs + 0.2d0*abs(zdotv)
     707 if (zdvabs < acca .and. acca < accb) then
     708   temp = zdotv/zdota(k)
     709   if (temp > 0.0d0 .and. iact(k) <= m) then
     710     tempa = vmultc(k)/temp
     711     if (ratio < 0.0d0 .or. tempa < ratio) then
     712       ratio = tempa
     713     end if
     714   end if
     715   if (k >= 2) then
     716     kw = iact(k)
     717     dxnew(1:n) = dxnew(1:n) - temp*a(1:n, kw)
     718   end if
     719   vmultd(k) = temp
     720 else
 
 FORCHECK PC V13.5.13          TRSTLP          2021-03-24 10:59:30   page:  2720
 orient_water.F90  /FF
 
     721   vmultd(k) = 0.0d0
     722 end if
     723 k = k - 1
     724 if (k > 0) go to 130
     725 if (ratio < 0.0d0) go to 490
     726
     727 !  Revise the Lagrange multipliers and reorder the active constraints s
 o
     728 !  that the one to be replaced is at the end of the list. Also calculat
 e the
     729 !  new value of ZDOTA(NACT) and branch if it is not acceptable.
     730
     731 do k=1, nact
     732   vmultc(k) = max(0.0d0, vmultc(k) - ratio*vmultd(k))
     733 end do
     734 if (icon < nact) then
     735   isave = iact(icon)
     736   vsave = vmultc(icon)
     737   k = icon
     738   170 kp = k + 1
     739   kw = iact(kp)
     740   sp = dot_product( z(1:n, k),  a(1:n, kw) )
     741   temp = sqrt(sp*sp + zdota(kp)**2)
     742   alpha = zdota(kp)/temp
     743   beta = sp/temp
     744   zdota(kp) = alpha*zdota(k)
     745   zdota(k) = temp
     746   do i=1, n
     747     temp = alpha*z(i, kp) + beta*z(i, k)
     748     z(i, kp) = alpha*z(i, k) - beta*z(i, kp)
     749     z(i, k) = temp
     750   end do
     751   iact(k) = kw
     752   vmultc(k) = vmultc(kp)
     753   k = kp
     754   if (k < nact) go to 170
     755   iact(k) = isave
     756   vmultc(k) = vsave
     757 end if
     758 temp = dot_product( z(1:n, nact),  a(1:n, kk) )
     759 if (temp == 0.0d0) go to 490
     760 zdota(nact) = temp
     761 vmultc(icon) = 0.0d0
     762 vmultc(nact) = ratio
     763
     764 !  Update IACT and ensure that the objective function continues to be
     765 !  treated as the last active constraint when MCON>M.
     766
     767 210 iact(icon) = iact(nact)
     768 iact(nact) = kk
     769 if (mcon > m .and. kk /= mcon) then
     770   k = nact - 1
     771   sp = dot_product( z(1:n, k),  a(1:n, kk) )
     772   temp = sqrt(sp*sp + zdota(nact)**2)
     773   alpha = zdota(nact)/temp
     774   beta = sp/temp
     775   zdota(nact) = alpha*zdota(k)
     776   zdota(k) = temp
     777   do i=1, n
 
 FORCHECK PC V13.5.13          TRSTLP          2021-03-24 10:59:30   page:  2721
 orient_water.F90  /FF
 
     778     temp = alpha*z(i, nact) + beta*z(i, k)
     779     z(i, nact) = alpha*z(i, k) - beta*z(i, nact)
     780     z(i, k) = temp
     781   end do
     782   iact(nact) = iact(k)
     783   iact(k) = kk
     784   temp = vmultc(k)
     785   vmultc(k) = vmultc(nact)
     786   vmultc(nact) = temp
     787 end if
     788
     789 !  if stage one is in progress,  then set SDIRN to the direction of the
  next
     790 !  change to the current vector of variables.
     791
     792 if (mcon > m) go to 320
     793 kk = iact(nact)
     794 temp = dot_product( sdirn(1:n),  a(1:n, kk) )
     795 temp = temp - 1.0d0
     796 temp = temp/zdota(nact)
     797 sdirn(1:n) = sdirn(1:n) - temp*z(1:n, nact)
     798 go to 340
     799
     800 !  Delete the constraint that has the index IACT(ICON) from the active
 set.
     801
     802 260 if (icon < nact) then
     803   isave = iact(icon)
     804   vsave = vmultc(icon)
     805   k = icon
     806   do
     807     kp = k + 1
     808     kk = iact(kp)
     809     sp = dot_product( z(1:n, k),  a(1:n, kk) )
     810     temp = sqrt(sp*sp + zdota(kp)**2)
     811     alpha = zdota(kp)/temp
     812     beta = sp/temp
     813     zdota(kp) = alpha*zdota(k)
     814     zdota(k) = temp
     815     do i=1, n
     816       temp = alpha*z(i, kp) + beta*z(i, k)
     817       z(i, kp) = alpha*z(i, k) - beta*z(i, kp)
     818       z(i, k) = temp
     819     end do
     820     iact(k) = kk
     821     vmultc(k) = vmultc(kp)
     822     k = kp
     823     if (k >= nact) EXIT
     824   end do
     825   iact(k) = isave
     826   vmultc(k) = vsave
     827 end if
     828 nact = nact - 1
     829
     830 !  if stage one is in progress,  then set SDIRN to the direction of the
  next
     831 !  change to the current vector of variables.
     832
     833 if (mcon > m) go to 320
 
 FORCHECK PC V13.5.13          TRSTLP          2021-03-24 10:59:30   page:  2722
 orient_water.F90  /FF
 
     834 temp = dot_product( sdirn(1:n),  z(1:n, nact + 1) )
     835 sdirn(1:n) = sdirn(1:n) - temp*z(1:n, nact + 1)
     836 go to 340
     837
     838 !  Pick the next search direction of stage two.
     839
     840 320 temp = 1.0d0/zdota(nact)
     841 sdirn(1:n) = temp*z(1:n, nact)
     842
     843 !  Calculate the step to the boundary of the trust region or take the s
 tep
     844 !  that reduces RESMAX to zero. The two statements below that include t
 he
     845 !  factor 1.0E-6 prevent some harmless underflows that occurred in a te
 st
     846 !  calculation. Further,  we skip the step if it could be zero within a
     847 !  reasonable tolerance for computer rounding errors.
     848
     849 340 dd = rho*rho
     850 sd = 0.0d0
     851 ss = 0.0d0
     852 do i=1, n
     853   if (abs(dx(i)) >= 1.0E-6*rho) dd = dd - dx(i)**2
     854   sd = sd + dx(i)*sdirn(i)
     855   ss = ss + sdirn(i)**2
     856 end do
     857 if (dd <= 0.0d0) go to 490
     858 temp = sqrt(ss*dd)
     859 if (abs(sd) >= 1.0E-6*temp) temp = sqrt(ss*dd + sd*sd)
     860 stpful = dd/(temp + sd)
     861 step = stpful
     862 if (mcon == m) then
     863   acca = step + 0.1d0*resmax
     864   accb = step + 0.2d0*resmax
     865   if (step >= acca .or. acca >= accb) go to 480
     866   step = min(step, resmax)
     867 end if
     868
     869 !  Set DXNEW to the new variables if STEP is the steplength,  and reduc
 e
     870 !  RESMAX to the corresponding maximum residual if stage one is being d
 one.
     871 !  Because DXNEW will be changed during the calculation of some Lagrang
 e
     872 !  multipliers,  it will be restored to the following value later.
     873
     874 dxnew(1:n) = dx(1:n) + step*sdirn(1:n)
     875 if (mcon == m) then
     876   resold = resmax
     877   resmax = 0.0d0
     878   do k=1, nact
     879     kk = iact(k)
     880     temp = b(kk) - dot_product( a(1:n, kk),  dxnew(1:n) )
     881     resmax = max(resmax, temp)
     882   end do
     883 end if
     884
     885 !  Set VMULTD to the VMULTC vector that would occur if DX became DXNEW.
  A
 
 FORCHECK PC V13.5.13          TRSTLP          2021-03-24 10:59:30   page:  2723
 orient_water.F90  /FF
 
     886 !  device is included to force VMULTD(K) = 0.0 if deviations from this
 value
     887 !  can be attributed to computer rounding errors. First calculate the n
 ew
     888 !  Lagrange multipliers.
     889
     890 k = nact
     891 390 zdotw = 0.0d0
     892 zdwabs = 0.0d0
     893 do i=1, n
     894   temp = z(i, k)*dxnew(i)
     895   zdotw = zdotw + temp
     896   zdwabs = zdwabs + abs(temp)
     897 end do
     898 acca = zdwabs + 0.1d0*abs(zdotw)
     899 accb = zdwabs + 0.2d0*abs(zdotw)
     900 if (zdwabs >= acca .or. acca >= accb) zdotw = 0.0d0
     901 vmultd(k) = zdotw / zdota(k)
     902 if (k >= 2) then
     903   kk = iact(k)
     904   dxnew(1:n) = dxnew(1:n) - vmultd(k)*a(1:n, kk)
     905   k = k - 1
     906   go to 390
     907 end if
     908 if (mcon > m) vmultd(nact) = max(0.0d0, vmultd(nact))
     909
     910 !  Complete VMULTC by finding the new constraint residuals.
     911
     912 dxnew(1:n) = dx(1:n) + step*sdirn(1:n)
     913 if (mcon > nact) then
     914   kl = nact + 1
     915   do k=kl, mcon
     916     kk = iact(k)
     917     total = resmax - b(kk)
     918     sumabs = resmax + abs(b(kk))
     919     do i=1, n
     920       temp = a(i, kk)*dxnew(i)
     921       total = total + temp
     922       sumabs = sumabs + abs(temp)
     923     end do
     924     acca = sumabs + 0.1*abs(total)
     925     accb = sumabs + 0.2*abs(total)
     926     if (sumabs >= acca .or. acca >= accb) total = 0.0
     927     vmultd(k) = total
     928   end do
     929 end if
     930
     931 !  Calculate the fraction of the step from DX to DXNEW that will be tak
 en.
     932
     933 ratio = 1.0d0
     934 icon = 0
     935 do k=1, mcon
     936   if (vmultd(k) < 0.0d0) then
     937     temp = vmultc(k)/(vmultc(k) - vmultd(k))
     938     if (temp < ratio) then
     939       ratio = temp
     940       icon = k
     941     end if
 
 FORCHECK PC V13.5.13          TRSTLP          2021-03-24 10:59:30   page:  2724
 orient_water.F90  /FF
 
     942   end if
     943 end do
     944
     945 !  Update DX,  VMULTC and RESMAX.
     946
     947 temp = 1.0d0 - ratio
     948 dx(1:n) = temp*dx(1:n) + ratio*dxnew(1:n)
     949 do k=1, mcon
     950   vmultc(k) = max(0.0d0, temp*vmultc(k) + ratio*vmultd(k))
     951 end do
     952 if (mcon == m) resmax = resold + ratio*(resmax - resold)
     953
     954 !  if the full step is not acceptable then begin another iteration.
     955 !  Otherwise switch to stage two or end the calculation.
     956
     957 if (icon > 0) go to 70
     958 if (abs(step - stpful) < 1.d-6) go to 500
     959 480 mcon = m + 1
     960 icon = mcon
     961 iact(mcon) = mcon
     962 vmultc(mcon) = 0.0d0
     963 go to 60
     964
     965 !  We employ any freedom that may be available to reduce the objective
     966 !  function before returning a DX whose length is less than RHO.
     967
     968 490 if (mcon == m) go to 480
     969 ifull = 0
     970
     971 500 return
     972 end subroutine trstlp
 
