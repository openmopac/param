     692 !     *****************************************************************
 ********
     693
     694       subroutine cidiag (ciin, ci, aii, aocc, bocc)
     695       use reimers_C, only : matind, nconf, nci, nr, nov, nex, mspn
     696       use cosmo_C, only : ffact, diagsl
     697
     698       implicit none
     699       double precision ::  ciin(nconf*(nconf + 1)/2), ci(nconf, nconf),
  &
     700                         aii(nconf), wk0(nconf), emin, xx
     701       integer ::           i, j, k, i0, ier, nm, nconf1
     702       logical*1 ::         aocc(nov, mspn, nex), bocc(nov, mspn, nex)
     703
     704
     705 !     **** expand symmetric matrix into full storage mode ****
     706       nm = matind(nconf) + nconf
     707       do i = nconf, 1, - 1
     708         do j = i, 1, - 1
     709           ci(j, i) = ciin(nm)
     710           nm = nm - 1
     711         end do
     712       end do
     713       do i = nconf, 1, - 1
     714         do j = i, 1, - 1
     715           ci(i, j) = ci(j, i)
     716         end do
     717       end do
     718
     719 !     **** block - wise diagonalization ****
     720       i0 = 1
     721       do i = 1, nr
     722         if (nci(i) > 0) then
     723
     724           call tred2e (nconf, nci(i), ci(i0, i0), aii(i0), wk0, ci(i0,
 i0))
     725           call tql2e  (nconf, nci(i),         aii(i0), wk0, ci(i0, i0),
  ier)
     726           i0 = i0 + nci(i)
     727         end if
     728       end do
     729
     730 ! RMG - correct eigenvalues if using solvent
     731       if (ffact > 0.d0) then
     732         call corrci(ciin, ci, aocc, bocc, diagsl, aii)
     733       end if
     734
     735 !     **** order in terms of increasing eigenvalue ****
     736       do nconf1 = 1, nconf
     737         k = 0
     738         emin = 1.d30
     739         do i = nconf1, nconf
     740           if (emin > aii(i)) then
     741             k = i
     742             emin = aii(i)
     743           end if
     744         end do
     745         xx = aii(nconf1)
 
 FORCHECK PC V13.5.13          CIDIAG          2021-03-24 10:59:30   page:  3987
 ci.F90  /FF
 
     746         aii(nconf1) = aii(k)
     747         aii(k) = xx
     748         do i = 1, nconf
     749           xx = ci(i, nconf1)
     750           ci(i, nconf1) = ci(i, k)
     751           ci(i, k) = xx
     752         end do
     753       end do
     754 !     **** transpose eigenvectors ****
     755       do i = 2, nconf
     756         do j = 1, min(i - 1, nconf)
     757           xx = ci(i, j)
     758           ci(i, j) = ci(j, i)
     759           ci(j, i) = xx
     760         end do
     761       end do
     762
     763       return
     764       end subroutine cidiag
 
