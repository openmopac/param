     154 !     *****************************************************************
 ********
     155
     156       subroutine ao2mo (a, c, wk, mm, nn, n1, n2)
     157
     158 !     **** this transforms a matrix from AO to MO basis ****
     159 !     **** or from configuration state basis to CI states ****
     160 !     **** calculating output for states n1 to n2 only ****
     161       use reimers_C, only : matind
     162
     163       implicit none
     164       integer ::           i, j, k, mm, nn, n1, n2, nm
     165       double precision ::  a(*), c(mm, nn), wk(mm, nn), xx
     166
     167       do i = 1, nn
     168         do j = n1, n2
     169           xx = 0.d0
     170           do k = 1, nn
     171             nm = matind (max(i, k)) + min(i, k)
     172             xx = xx + a(nm) * c(j, k)
     173           end do
     174           wk(i, j) = xx
     175         end do
     176       end do
     177
     178       do j = n1, n2
     179         nm = matind(j)
     180         do i = n1, j
     181           nm = nm + 1
     182           xx = 0.d0
     183           do k = 1, nn
     184             xx = xx + c(i, k) * wk(k, j)
     185           end do
     186           a(nm) = xx
     187         end do
     188       end do
     189
     190       return
     191       end subroutine ao2mo
 
