      56       subroutine diagci(cimat, aocc, bocc, diagsl)
      57       use molkst_C, only : mpack
      58       use reimers_C, only : nconf, nov, nex, matind, mspn, &
      59                            aor1, bor1
      60
      61       implicit none
      62       double precision :: cimat(*), deltap(mpack), &
      63                       diagsl(nconf)
      64       logical*1 :: aocc(nov, mspn, nex), bocc(nov, mspn, nex)
      65       integer :: iconf, io(4), iv(4), nm, nio
      66       double precision :: ener
      67 !**********************************************************************
 *
      68 !   RMG - compute the correction to the diagonal terms of the CI matrix
      69 !   due to solvation, as in Klamt, J. Phys. Chem. 1996, 100, 3349.
      70 !
      71 !   For each excitation, compute the density change, then compute the
      72 !   correction to the diagonal energy term. Correct the CI matrix, but
      73 !   save all corrections in dcie for later use in unsolv.
      74 !**********************************************************************
 *
      75       diagsl(1) = 0.d0
      76       do iconf = 2, nconf
      77         call getocc(aocc(1:nov, 1, iconf), bocc(1:nov, 1, iconf), &
      78                     aor1(1:nov), bor1(1:nov), io, iv, nio)
      79 ! Compute the density change
      80         call exdeltap(io, iv, nio, deltap)
      81
      82 ! Compute the energy change
      83         call solenr(deltap, ener)
      84         diagsl(iconf) = ener
      85         nm = matind(iconf) + iconf
      86         cimat(nm) = cimat(nm) + ener
      87       end do
      88
      89       return
      90       end subroutine diagci
 
