     126               print_shift = noccupied
     127             end if
     128           end if
     129           !
     130           ! Write out results
     131           !
     132           ! Find number of print panels
     133           if (print_set == do_occ) then
     134             write (iw, "(/'  Occupied Orbitals'/)")
     135             print_first_orbital = noccupied - print_nocc
     136             print_npanels = 1 + (print_nocc - 1) / print_columns_per_pa
 nel
     137             print_columns_left = print_nocc
     138           else
     139             write (iw, "(/'  Virtual Orbitals'/)")
     140             print_first_orbital = noccupied
     141             print_npanels = 1 + (print_nvir - 1) / print_columns_per_pa
 nel
     142             print_columns_left = print_nvir
     143           end if
     144           !
     145           ! For each panel ...
     146           do i = 1, print_npanels
     147             !
     148             ! Evaluate how many columns to print in this panel
     149             if (print_columns_left >= print_columns_per_panel) then
     150               print_ncolumns = print_columns_per_panel
     151             else
     152               print_ncolumns = print_columns_left
     153             end if
     154             print_columns_left = print_columns_left - print_ncolumns
     155             !
     156             ! Print header for this panel
     157             write (iw, "(//'    Root No.')", advance="no")
     158             do j = 1, print_ncolumns
     159               write (iw, "(i6,'  ')", advance="no") print_first_orbital
  + &
     160                   & (i - 1) * print_columns_per_panel + j
     161             end do
     162             write (iw, "(/)")
     163             !
     164             ! Print eigenvalues
     165             write (iw, "('            ')", advance="no")
     166             do j = 1, print_ncolumns
 
 FORCHECK PC V13.5.13          EIGEN           2021-03-24 10:59:30   page:   631
