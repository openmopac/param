    1901                 do i = 1, nbonds(ii)
    1902                   kk = ibonds(i,ii)
    1903                   if (nbonds(kk) == 1 .and. nat(kk) == 8) jj = jj + 1
    1904                   if (nat(kk) == 8) j = j + 1
    1905                 end do
    1906                 if (ionized .and. j == 4) then
    1907                   nH =0
