      64                & icocc(icocc_dim), icvir(icvir_dim), jopt(numat), &
      65                & kopt(numat), ncf(noccupied + 1), nce(nvirtual + 1), p(
 mpack), &
      66                f(mpack), q(numat), stat = i)
      67   j = j + i
      68   allocate(ifact(norbs), stat = i)
      69   j = j + i
      70   allocate(cocc(cocc_dim), cvir(cvir_dim), stat = i)
      71   j = j + i
      72   if ( index(keywrd, " RESTART") /= 0 .or. &
      73        index(keywrd," 1SCF") == 0     .or. &
      74        index(keywrd, " GRAD") /= 0) then
