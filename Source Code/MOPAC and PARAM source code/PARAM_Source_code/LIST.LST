      56       logical, allocatable :: l_use(:)
      57       character :: space, ch, idate*24, line_1*1000, line_2*1000, txt*1
 5
      58       save  space, intern, ireact
      59 !-----------------------------------------------
      60 !
      61 ! MODULE TO READ IN GEOMETRY FILE, OUTPUT IT TO THE USER,
      62 ! AND CHECK THE DATA TO SEE IF IT IS REASONABLE.
      63 ! EXIT IF NECESSARY.
      64 !
      65 !
      66 !
      67 !  ON EXIT NATOMS    = NUMBER OF ATOMS PLUS DUMMY ATOMS (IF ANY).
      68 !          KEYWRD    = KEYWORDS TO CONTROL CALCULATION
      69 !          KOMENT    = COMMENT CARD
      70 !          TITLE     = TITLE CARD
      71 !          LABELS    = ARRAY OF ATOMIC LABELS INCLUDING DUMMY ATOMS.
      72 !          GEO       = ARRAY OF INTERNAL COORDINATES.
      73 !          LOPT      = FLAGS FOR OPTIMIZATION OF MOLECULE
      74 !          NA        = ARRAY OF LABELS OF ATOMS, BOND LENGTHS.
      75 !          NB        = ARRAY OF LABELS OF ATOMS, BOND ANGLES.
      76 !          NC        = ARRAY OF LABELS OF ATOMS, DIHEDRAL ANGLES.
      77 !          LATOM     = LABEL OF ATOM OF REACTION COORDINATE.
      78 !          LPARAM    = RC: 1 FOR LENGTH, 2 FOR ANGLE, AND 3 FOR DIHEDRA
 L
      79 !          REACT     = REACTION COORDINATE PARAMETERS
      80 !          LOC(1,I)  = LABEL OF ATOM TO BE OPTIMIZED.
      81 !          LOC(2,I)  = 1 FOR LENGTH, 2 FOR ANGLE, AND 3 FOR DIHEDRAL.
      82 !          NVAR      = NUMBER OF PARAMETERS TO BE OPTIMIZED.
      83 !          XPARAM    = STARTING VALUE OF PARAMETERS TO BE OPTIMIZED.
      84 !
      85 !**********************************************************************
 *
      86 ! *** IR THE TRIAL GEOMETRY  (IE.  KGEOM=0)
      87 !   LABEL(I) = THE ATOMIC NUMBER OF ATOM(I).
      88 !            = 99, THEN THE I-TH ATOM IS A DUMMY ATOM USED ONLY TO
      89 !              SIMPLIFY THE DEFINITION OF THE MOLECULAR GEOMETRY.
      90 !   GEO(1,I) = THE INTERNUCLEAR SEPARATION (IN ANGSTROMS) BETWEEN ATOMS
      91 !              NA(I) AND (I).
