     210 !   STR=2.2868D0*(5.D0*LOG10(T)+3.D0*LOG10(mol_weight))-2.3135D0
     211 !   STR=0.993608D0*(5.D0*LOG(T)+3.D0*LOG(mol_weight))-2.31482D0
     212 !   STR=4.96804D0*(LOG(T)+0.6D0*LOG(mol_weight))-2.31482D0
     213 !
     214 !   ***   CONSTRUCT TOTALS   ***
     215         cptot = cptr + cpint
     216         stot = str + sint
     217         htot = htr + hint
     218 !   ***   OUTPUT SECTION   ***
