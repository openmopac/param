       1       subroutine symtry ()
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use molkst_C, only : ndep
       6       USE symmetry_C, ONLY: locpar, idepfn, locdep, depmul
       7       use common_arrays_C, only : geo
       8 !**********************************************************************
 *
       9 !-----------------------------------------------
      10 !   I n t e r f a c e   B l o c k s
      11 !-----------------------------------------------
      12       implicit none
      13 !   L o c a l   V a r i a b l e s
      14 !-----------------------------------------------
      15       integer :: n, i, locn, j
      16       double precision :: value
      17 !-----------------------------------------------
      18 !**********************************************************************
      19 !
      20 !  SYMTRY COMPUTES THE BOND LENGTHS AND ANGLES THAT ARE FUNCTIONS OF
      21 !         OTHER BOND LENGTHS AND ANGLES.
      22 !
      23 ! ON INPUT GEO     = KNOWN INTERNAL COORDINATES
      24 !          NDEP    = NUMBER OF DEPENDENCY FUNCTIONS.
      25 !          IDEPFN  = ARRAY OF DEPENDENCY FUNCTIONS.
      26 !          LOCDEP  = ARRAY OF LABELS OF DEPENDENT ATOMS.
      27 !          LOCPAR  = ARRAY OF LABELS OF REFERENCE ATOMS.
      28 !
      29 !  ON OUTPUT THE ARRAY "GEO" IS FILLED
      30 !**********************************************************************
 *
      31 !
      32 !     NOW COMPUTE THE DEPENDENT PARAMETERS.
      33 !
      34       n = 0
      35       do i = 1, ndep
      36         if (idepfn(i) == 19 .and. depmul(n + 1) > 1.d-20) then
      37           n = n + 1
      38           call haddon (value, locn, idepfn(i), locpar(i), geo, depmul(n
 ))
      39         else
      40           call haddon (value, locn, idepfn(i), locpar(i), geo, depmul(i
 ))
      41         end if
      42         j = locdep(i)
      43         geo(locn,j) = value
      44       end do
      45       return
      46       end subroutine symtry
 
 FORCHECK PC V13.5.13          SYMTRY          2021-03-24 10:59:30   page:  3493
 symtry.F90  /FF


