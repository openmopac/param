       1 subroutine setupk (nocc1)
       2     use MOZYME_C, only : icocc, ncf, nncf, kopt
       3     use molkst_C, only : numat
       4     implicit none
       5     integer, intent (in) :: nocc1
       6     integer :: i, j, k, l
       7    !*******************************************************************
 *
       8    !
       9    !   SETUPK DETERMINES WHICH ATOMS NEED TO BE CONSIDERED IN
      10    !   RE-CONSTRUCTING THE FOCK MATRIX.
      11    !
      12    !   THE SET OF ATOMS TO BE USED IS PUT INTO KOPT.  ALL ATOMS USED IN
      13    !   THE LMOs IN THE SCF CALCULATION ARE PUT INTO KOPT.
      14    !
      15    !   (Note:  Perhaps a better test would be 'All atoms that make a
      16    !   significant contribution to the LMOs in the SCF calculation?'
      17    !
      18    !*******************************************************************
 *
      19     kopt = 0
      20     do i = 1, nocc1
      21       j = nncf(i)
      22       do k = 1, ncf(i)
      23         kopt(icocc(k+j)) = 1
      24       end do
      25     end do
      26 !
      27 !   If atom i is to be used in constructing the Fock matrix, then kopt(
 i) = 1
      28 !   otherwise kopt(i) = 0
      29 !
      30 !   Now compress kopt, so that all the atoms used for the Fock matrix a
 re in
      31 !   order.
      32 !
      33     l = 0
      34     do i = 1, numat
      35       if (kopt(i) == 1) then
      36         l = l + 1
      37         kopt(l) = i
      38       end if
      39     end do
      40 !
      41 !  Force a zero in after the last atom.  This can be used in finding th
 e end of the atom list.
      42 !
      43     if (l /= numat) kopt(l+1) = 0
      44 end subroutine setupk
 
