     454               iout = iout + 1
     455               iwk(1, iout) = i
     456               iwk(2, iout) = a
     457               wk0(1, iout) = beta(matind(i) + a)
     458               wk0(2, iout) = eec(nm)
     459             end if
     460             if (iout == 5 .or. iout > 0 .and. nm == nxs) then
     461               write (iw, '(5(2i4, 2f6.0, f6.1))') (iwk(1, k), iwk(2, k)
 , wk0(1, k), wk0(2, k), &
     462      &            wk0(1, k) + wk0(2, k), k = 1, iout)
     463               iout = 0
     464             end if
     465           end do
     466         end do
     467         write (iw, "(1x, a3, ' used = ', i6, ' maximum = ', i6, ' fract
 ion = ', f6.2)") &
     468           'eec', ioutt, nxs, ioutt/float(nxs)
     469
     470 !       **** dump matrix elements differing by 2 electrons ****
     471         write (iw, "(/' Non - Zero Contributions to integrals differing
  by 2', &
     472      &         ' electrons'/)")
     473         iout = 0
     474         ioutt = 0
     475         nm = 0
     476         do i = nol, nvh
     477          do j = nol, i
     478           do a = nol, j
     479            do b = nol, a
     480             nm = nm + 1
 
 FORCHECK PC V13.5.13          CIMAT           2021-03-24 10:59:30   page:  3977
 ci.F90  /FF
 
     481             if (ee2(nm) < edefs) then
     482               ioutt = ioutt + 1
     483               if (ee2(nm) /= 0.E0) then
     484                 iout = iout + 1
     485                 iwk(1, iout) = i
     486                 iwk(2, iout) = j
     487                 iwk(3, iout) = a
     488                 iwk(4, iout) = b
     489                 wk0(1, iout) = ee2(nm)
     490               end if
     491             end if
     492             if (iout == 6 .or. iout > 0 .and. nm == nxss) then
