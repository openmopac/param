     644   subroutine compfg_TS(big_xparam, int, escf1, escf2, fulscf, big_grad,
  lgrad)
     645 !
     646 ! compfg_TS evaluates the heat of formation and, if lgrad, the gradient
 s of the two systems,
     647 ! one in the data-set and one in the reference data-set.
     648 !
     649     USE molkst_C, ONLY: nvar, numat
     650     use common_arrays_C, only : geo, geoa, grad
     651     use MOZYME_C, only : geo_1, geo_2
     652     implicit none
     653 !-----------------------------------------------
     654 !   D u m m y   A r g u m e n t s
     655 !-----------------------------------------------
     656     double precision, intent(out) :: escf1, escf2
     657     logical , intent(in) :: int
     658     logical, intent(in)  :: fulscf
     659     logical , intent(in) :: lgrad
     660     double precision, intent(in) :: big_xparam(2*nvar)
     661     double precision, intent (out) :: big_grad(2*nvar)
     662     double precision, allocatable :: xparam(:)
     663 !-----------------------------------------------
     664 !   L o c a l   V a r i a b l e s
     665 !-----------------------------------------------
     666     integer :: i, nparam = -1
     667     save xparam, nparam
     668 !  Reallocate xparam as needed
     669    if (nparam < nvar) then
     670      if(nparam >= 0) deallocate(xparam)
     671      nparam = nvar
     672      allocate(xparam(nparam))
     673    end if
     674 !
     675 !  Save the current point
     676 !
     677     do i = 1, nvar
     678       xparam(i) = big_xparam(i)
     679     end do
     680 !
     681 !  Run data-set geometry, using reference geometry as geo_ref - this is
  in geoa
     682 !
     683     call big_swap(1,1)
     684     call compfg(xparam, int, escf1, fulscf, grad, lgrad)
     685     call big_swap(0,1)
     686     big_grad(:nvar) = grad(:nvar)
     687     geoa(:,:numat) = geo(:,:numat)
     688 !
     689 ! Run reference geometry using data-set as reference - this is now in g
 eoa
     690 !
     691     call big_swap(1,2)
     692     xparam = big_xparam(nvar + 1: 2*nvar)
     693     call compfg(xparam, int, escf2, fulscf, grad, lgrad)
     694     big_grad(nvar + 1: 2*nvar) = grad(:nvar)
     695     call big_swap(0,2)
     696 !
     697 !  Re-set geo and geoa to data-set and reference geometries
 
 FORCHECK PC V13.5.13        COMPFG_TS         2021-03-24 10:59:30   page:  1720
 big_swap.F90  /FF
 
     698 !
     699     geo(:,:numat) = geo_1(:,:numat)
     700     geoa(:,:numat) = geo_2(:,:numat)
     701     return
     702   end subroutine compfg_TS
 
