     277 !     *****************************************************************
 ********
     278
     279       function align (i, j, spn, aocc, bocc)
     280
     281 !     **** calculates the number of column interchanges necessary to gi
 ve ****
     282 !     **** optimum alignment of two determinates.
    ****
     283 !     **** returns 1.d0 if even nber, - 1.d0 if odd number
    ****
     284 !     **** I, J are orbs that are different in spin type SPN
    ****
     285 !
     286 !     **** ELECTRON ORDERING IS: alpha(1) beta(1) alpha(2) beta(2) ...
    ****
     287 !     **** ie, any electron for orbital i appears before any for orb i
 + 1  ****
     288 !     **** which is different to Georges book which has all alpha els
    ****
     289 !     **** followed by all beta els.  The consequence is that signs of
    ****
     290 !     **** linear combinations change, eg, closed shell i - >a singlet
 state ***
     291 !     **** is |i, a_bar> - |i_bar, a> wheras in Goerges book its writte
 n as ****
     292 !     ****    |i, a_bar> + |a, i_bar>
    ****
     293 !     **** This choice has consequences only here and in S2 matrix gen
    ****
     294       use reimers_C, only : nov
     295
     296       implicit none
     297       double precision ::  align
     298       integer ::           i, j, k, i1, j1, ninter
     299       logical*1 ::         aocc(nov), bocc(nov), spn
     300
     301       i1 = min(i, j)
     302       j1 = max(i, j)
     303       ninter = 0
     304       do k = i1 + 1, j1 - 1
     305         if (aocc(k)) ninter = ninter + 1
     306         if (bocc(k)) ninter = ninter + 1
     307       end do
     308       if (spn) then
     309 !       **** electron is alpha spin, move past a beta spin in orb i1 **
 **
     310         if (bocc(i1)) ninter = ninter + 1
     311       else
     312 !       **** electron is beta spin, move past an alpha spin in orb j1 *
 ***
     313         if (aocc(j1)) ninter = ninter + 1
     314       end if
     315
     316       align = 1.d0
     317       if (mod(ninter, 2) == 1) align = -1.d0
     318       return
     319
 
 FORCHECK PC V13.5.13          ALIGN           2021-03-24 10:59:30   page:  3972
 ci.F90  /FF
 
     320       end function align
 
