      14 !   L o c a l   V a r i a b l e s
      15 !-----------------------------------------------
      16       integer :: i
      17       double precision, dimension(2,4) :: f
      18       double precision :: tol, s12, s3, one, r1, r2, r3, check, arg, b,
  sina, g&
