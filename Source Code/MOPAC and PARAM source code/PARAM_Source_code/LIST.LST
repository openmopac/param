       5     use common_arrays_C, only: eigs, nfirst, nlast, nat, c
       6     use MOZYME_C, only : icocc, icvir, ncocc, ncvir, nvirtual, noccupie
 d, &
       7       & nnce, nncf, cocc, cvir, ncf, nce,  cocc_dim, &
       8       & cvir_dim, icocc_dim, icvir_dim
       9     implicit none
      10     logical, intent (in) :: write_gpt, write_out
      11     integer :: alloc_stat, vec_ao_size
      12     integer :: i, j, k, l, m
      13     integer :: print_set, print_first_orbital
      14     integer :: print_nocc, print_nvir, print_ntot, print_shift
      15     integer :: print_npanels, print_ncolumns, print_columns_left
      16     integer, parameter :: print_columns_per_panel = 8
      17     integer, parameter :: do_occ = 1, do_vir = 2
      18     integer, parameter :: default_print_nocc = 8
      19     integer, parameter :: default_print_nvir = 8
      20     character (len=248) :: tmpkey
      21     character (len=2), dimension (9), save :: print_orbital_name
      22     double precision, external :: reada
      23     data print_orbital_name / "S ", "Px", "Py", "Pz", "x2", "xz", "z2",
  "yz", "xy" /
      24     noccupied = nelecs/2
      25     nvirtual = norbs - noccupied
      26    !
      27    ! ==============================
      28    ! Write eigenvectors to gpt file
      29    ! ==============================
      30     if (write_gpt) then
      31       !
      32       ! Allocate local arrays
      33       allocate (c(norbs, norbs), stat=alloc_stat)
      34       if (alloc_stat /= 0) then
      35         call memory_error ("eigen")
      36         goto 1100
      37       end if
      38   !
      39   ! Convert LMOs to Eigenvectors
      40   !
      41       call lmo_to_eigenvectors(noccupied, ncf, nncf, ncocc, noccupied,
 &
      42            & icocc, icocc_dim, cocc, cocc_dim, eigs, c)
      43       call lmo_to_eigenvectors(nvirtual, nce, nnce, ncvir, nvirtual, ic
 vir, &
      44            & icvir_dim, cvir, cvir_dim, eigs(noccupied + 1), c(1, noccu
 pied + 1))
      45       !
      46       ! Write out results
      47       write (igpt) c
      48     end if
      49    !
      50    ! =================================================
      51    ! Write eigenvalues and eigenvectors to output file
      52    ! =================================================
      53     if (write_out) then
 
 FORCHECK PC V13.5.13          EIGEN           2021-03-24 10:59:30   page:   629
 eigen.F90  /FF
 
      54       !
      55       ! Determine how much needs to be written out
      56       if (Index (keywrd, " ALLVEC") /= 0) then
      57         !
      58         ! Everything requested
      59         print_nocc = noccupied
      60         print_nvir = nvirtual
      61       else if ((Index (keywrd, " VECTORS(") /= 0) .or. &
      62              & (Index (keywrd, " VECTORS=(") /= 0)) then
      63         !
      64         ! User has requested limits
      65         !
      66         ! Extract user limits from keyword string
      67         !
      68         ! Build temporary keyword string, and erase all text from it
      69         ! except VECTORS data
      70         tmpkey = trim(keywrd)
      71         i = Index (tmpkey, "VECTORS=(") + Index (tmpkey, "VECTORS(")
      72         tmpkey (:i) = " "
      73         j = Index (tmpkey, ")")
      74         tmpkey (j:) = " "
      75         ! Extract number of occupied orbitals to be written out
      76         print_nocc = Nint (reada (tmpkey, i))
      77         ! Extract number of virtual orbitals to be written out
      78         i = Index (tmpkey, ",") + Index (tmpkey, ":")
      79         if (i /= 0) then
      80           print_nvir = Nint (reada (tmpkey, i + 1))
      81         else
      82           print_nvir = default_print_nvir
      83         end if
      84       else
      85         !
      86         ! Use defaults
      87         print_nocc = default_print_nocc
      88         print_nvir = default_print_nvir
      89       end if
      90      !
      91      ! Make sure number of orbitals requested is no larger than
      92      ! the number available
      93       print_nocc = Max (0, Min (print_nocc, noccupied))
      94       print_nvir = Max (0, Min (print_nvir, nvirtual))
      95       print_ntot = print_nocc + print_nvir
      96       if (print_ntot > 0) then
      97         if (.not. write_gpt) then
      98           !
      99           ! Allocate local arrays
     100           vec_ao_size = Max (noccupied, nvirtual)
     101           allocate (c(norbs, vec_ao_size), stat=alloc_stat)
     102           if (alloc_stat /= 0) then
     103             call memory_error ("eigen")
     104             goto 1100
     105           end if
     106         end if
     107         c = 0.d0
     108         do print_set = do_occ, do_vir
     109           if (.not. write_gpt) then
     110             !
     111             ! Convert LMOs to Eigenvectors
     112             !
 
 FORCHECK PC V13.5.13          EIGEN           2021-03-24 10:59:30   page:   630
 eigen.F90  /FF
 
     113             if (print_set == do_occ) then
     114               call lmo_to_eigenvectors(noccupied, ncf, nncf, ncocc, noc
 cupied, &
     115            & icocc, icocc_dim, cocc, cocc_dim, eigs, c)
     116               print_shift = noccupied - print_nocc
     117             else
     118               call lmo_to_eigenvectors(nvirtual, nce, nnce, ncvir, nvir
 tual, &
     119            & icvir, icvir_dim, cvir, cvir_dim, eigs, c)
     120               print_shift = 0
     121             end if
     122           else
     123             if (print_set == do_occ) then
     124               print_shift = noccupied - print_nocc
