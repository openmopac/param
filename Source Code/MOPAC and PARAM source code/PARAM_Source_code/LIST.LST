    1206   subroutine select_opt(shell, active_site)
    1207   use molkst_C, only: nvar
    1208   use common_arrays_C, only: loc, xparam, geo, geoa
    1209   implicit none
    1210   integer, intent (in) :: shell, active_site(200)
    1211   integer :: i, j, k, l, use(shell), tmp(shell)
    1212   double precision :: x_1(3*shell), x_2(3*shell)
    1213   tmp = active_site(:shell)
    1214   do i = 1, shell
    1215     k = 100000
    1216     l = 0
    1217     do j = 1, shell
    1218       if (tmp(j) < k) then
    1219         k = tmp(j)
    1220         l = j
    1221       end if
    1222
    1223     end do
    1224     tmp(l) = 200000
    1225     use(i) = k
    1226   end do
    1227   if (.false.) then
    1228   nvar = 0
    1229   do i = 1, shell
    1230     do j = 1, 3
    1231       nvar = nvar + 1
    1232       loc(1,nvar) = use(i)
    1233       loc(2,nvar) = j
    1234       x_1(nvar) = geoa(j,use(i))
    1235       x_2(nvar) = geo(j,use(i))
    1236     end do
    1237   end do
    1238   call big_swap(1,1)
    1239   xparam(:nvar) = x_1(:nvar)
    1240   call big_swap(0,1)
    1241   call big_swap(1,2)
    1242   xparam(:nvar) = x_2(:nvar)
    1243   call big_swap(0,2)
    1244   end if
    1245   return
    1246   end subroutine select_opt
 
