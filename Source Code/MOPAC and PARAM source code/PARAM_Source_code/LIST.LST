       1       subroutine solrot(ni, nj, xi, xj, wj, wk, kr, e1b, e2a, enuc)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use common_arrays_C, only : tvec
       6       use molkst_C, only : numcal, l1u, l2u, l3u, clower
       7 !-----------------------------------------------
       8 !   I n t e r f a c e   B l o c k s
       9 !-----------------------------------------------
      10       implicit none
      11 !-----------------------------------------------
      12 !   D u m m y   A r g u m e n t s
      13 !-----------------------------------------------
      14       integer  :: ni
      15       integer  :: nj
      16       integer , intent(inout) :: kr
      17       double precision , intent(out) :: enuc
      18       double precision , intent(in) :: xi(3)
      19       double precision , intent(in) :: xj(3)
      20       double precision , intent(out) :: wj(2025)
      21       double precision , intent(out) :: wk(2025)
      22       double precision , intent(inout) :: e1b(45)
      23       double precision , intent(inout) :: e2a(45)
      24 !-----------------------------------------------
      25 !   L o c a l   V a r i a b l e s
      26 !-----------------------------------------------
      27       integer :: icalcn, i, j, k, kb
      28       double precision, dimension(:), allocatable :: wsum, wmax, wbits
      29       double precision, dimension(3) :: xjuc
      30       double precision, dimension(45) :: e1bits = 0.d0, e2bits = 0.d0
      31       double precision, dimension(3) :: xdumy
      32       double precision :: one, cutof2, r, enubit
      33
      34       save xdumy, icalcn, cutof2
      35 !-----------------------------------------------
      36 !**********************************************************************
 *
      37 !
      38 !   SOLROT FORMS THE TWO-ELECTRON TWO-ATOM J AND K INTEGRAL STRINGS.
      39 !          ON EXIT WJ = "J"-TYPE INTEGRALS
      40 !                  WK = "K"-TYPE INTEGRALS
      41 !
      42 !      FOR MOLECULES, WJ = WK.
      43 !**********************************************************************
 *
      44       data icalcn/ 0/
      45       data xdumy/ 3*0.D0/
      46       if (icalcn /= numcal) then
      47         icalcn = numcal
      48         cutof2 = clower**2
      49       end if
      50       one = 1.D0
      51       if (Abs(xi(1) - xj(1)) <1.d-20 .and. Abs(xi(2) - xj(2)) <1.d-20 .
 and. &
      52       Abs(xi(3) - xj(3)) <1.d-20) one = 0.5D0
      53       allocate (wsum(2025), wmax(2025), wbits(2025))
      54       wmax = 0.D0
      55       wsum = 0.D0
 
 FORCHECK PC V13.5.13          SOLROT          2021-03-24 10:59:30   page:  1181
 solrot.F90  /FF
 
      56       wbits = 0.D0
      57       e1b = 0.D0
      58       e2a = 0.D0
      59       enuc = 0.D0
      60       do i = -l1u, l1u
      61         do j = -l2u, l2u
      62           do k = -l3u, l3u
      63             xjuc = xj + tvec(:,1)*i + tvec(:,2)*j + tvec(:,3)*k - xi
      64             r = xjuc(1)**2 + xjuc(2)**2 + xjuc(3)**2
      65             if (r > cutof2) then
      66 !
      67 !  Interaction distance is greater than cutoff, so use point-charge
      68 !
      69               r = sqrt(r)
      70               call point(r, ni, nj, wbits, kb, e1bits, e2bits, enubit)
      71             else
      72 !
      73 !  Interaction distance is less than cutoff
      74 !
      75               kb = 0
      76               call rotate (ni, nj, xdumy, xjuc, wbits, kb, e1bits, e2bi
 ts, enubit)
      77             end if
      78             wsum(:kb) = wsum(:kb) + wbits(:kb)
      79             if (wmax(1) < wbits(1)) wmax(:kb) = wbits(:kb) ! "K" integr
 als apply only to nearest pair
      80             e1b = e1b + e1bits
      81             e2a = e2a + e2bits
      82             enuc = enuc + enubit*one
      83           end do
      84         end do
      85       end do
      86       if (one < 0.9D0) wmax(:kb) = 0.D0
      87       wk(:kb) = wmax(:kb)
      88       wj(:kb) = wsum(:kb)
      89       kr = kb + kr
      90       deallocate(wmax, wbits, wsum)
      91       return
      92       end subroutine solrot
 
