      43 subroutine calcfc (x, fun)
      44 !
      45 ! Evaluate the energy penalty due to steric interactions between water
 hydrogen atoms
      46 ! and nearby heavy atoms.
      47 !
      48 ! Input:
      49 ! x:                Coordinates of the two hydrogen atoms
      50 ! O_coord:          Coordinates of the oxygen atom
      51 ! near(3, n_atoms): Coordinates of the n_atoms atoms near to oxygen ato
 m
      52 !
      53 ! On exit:
      54 ! fun:                Value of the energy-penalty, i.e., function to be
  minimized
      55 !
      56 use common_arrays_C,  only : coord
      57 use orient_water_C, only : near, O_coord, n_atoms, near_nat, O_copy, H1
 _copy, atom_nos
      58 implicit none
      59 double precision, intent(in)   :: x(6)
      60 double precision, intent(out)  :: fun
      61 !
      62 ! Local
      63 !
      64 integer :: i, j
      65 double precision :: h2(3,2), Rab, Rab2, min_O, c_O, angle
      66 !
      67 logical :: first = .true.
      68 save
      69 !
      70 ! This method of positioning the hydrogen atoms in a water molecule is
 "quick and dirty" -
      71 ! it works, but could do with being improved.
      72 !
      73   if (first) then
      74 !
      75 !  Set the optimum H-X distances
      76 !
      77     min_O = 2.d0
      78 !
      79 !  For a 12-6 potential, the precursor to the "6" term is 2/min_X**6
      80 !
      81     c_O = 2.d0/min_O**6
      82     first = .false.
      83   end if
      84   h2(1:3,1) = x(1:3)
      85   h2(1:3,2) = x(4:6)
      86   fun = 0.d0
      87 !
      88 !  H - other atoms repulsion
      89 !
      90   do j = 1, 2
      91     do i = 1, n_atoms
      92       Rab2 = (h2(1,j) - near(1,i))**2 + (h2(2,j) - near(2,i))**2 + (h2(
 3,j) - near(3,i))**2
      93       rab =  sqrt(rab2)
      94       select case (near_nat(i))
 
 FORCHECK PC V13.5.13          CALCFC          2021-03-24 10:59:30   page:  2704
 orient_water.F90  /FF
 
      95       case (1)  ! H-H repulsion
      96         fun = fun + 1.d0*Rab2**(-6)
      97       case (6, 7)  ! H-(C, and N) repulsion
      98         fun = fun + 100.d0*Rab2**(-6)
      99       case (8)  ! H-O interaction
     100         fun = fun + 100.d0*(Rab2**(-6) - c_O/Rab2**3)
     101         if (j == 1) then
     102           coord(:,H1_copy) = H2(:,1)
     103           call bangle (coord, O_copy, H1_copy, atom_nos(i), angle)
     104           fun = fun + 0.15d0*(3.14159d0 - angle)
     105         end if
     106       case (12)  ! H-Mg
     107         fun = fun + 200.d0*Rab2**(-6)
     108       case default  ! H-(everything else) repulsion
     109         fun = fun + 100.d0/Rab2**6
     110       end select
     111     end do
     112   end do
     113 !
     114 !  H - H distance
     115 !
     116   Rab = sqrt((h2(1,1) - h2(1,2))**2 +(h2(2,1) - h2(2,2))**2 + (h2(3,1)
 - h2(3,2))**2)
     117   fun = fun + (Rab - 1.52d0)**2
     118 !
     119 !  O - H distance
     120 !
     121   do i = 1, 2
     122     Rab = sqrt((h2(1,i) - O_coord(1))**2 +(h2(2,i) - O_coord(2))**2 + (
 h2(3,i) - O_coord(3))**2)
     123     fun = fun +    (Rab - 0.98d0)**2
     124   end do
     125 return
     126 end subroutine calcfc
 
