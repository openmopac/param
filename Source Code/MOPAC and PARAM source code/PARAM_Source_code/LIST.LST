    1052       subroutine delete_iter_arrays
    1053 !
    1054 !  If these arrays exist, they must be deleted before starting ITER.
    1055 !  If they're not deleted, and they're too small, the stack will
    1056 !  become corrupt if INTERP is called.
    1057 !
    1058       use iter_C, only : vec_ai, vec_bi, fock_ai, fock_bi, p_ai, &
    1059       p_bi, h_ai, h_bi, vecl_ai, vecl_bi
    1060       implicit none
    1061         if (allocated(vec_ai)) deallocate(vec_ai)
    1062         if (allocated(vec_bi)) deallocate(vec_bi)
    1063         if (allocated(fock_ai)) deallocate(fock_ai)
    1064         if (allocated(fock_bi)) deallocate(fock_bi)
    1065         if (allocated(p_ai)) deallocate(p_ai)
    1066         if (allocated(p_bi)) deallocate(p_bi)
    1067         if (allocated(h_ai)) deallocate(h_ai)
    1068         if (allocated(h_bi)) deallocate(h_bi)
    1069         if (allocated(vecl_ai)) deallocate(vecl_ai)
    1070         if (allocated(vecl_bi)) deallocate(vecl_bi)
    1071       end subroutine delete_iter_arrays
 
