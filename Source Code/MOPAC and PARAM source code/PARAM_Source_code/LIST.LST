       5       use molkst_C, only : norbs, numat, mpack, id, l1u, l2u, l3u, &
       6       mozyme
       7 !
       8       use chanel_C, only : iw
       9       use elemts_C, only : elemnt
      10       use common_arrays_C, only : nat, geo, nfirst, nlast, coord, p, tv
 ec
      11 !**********************************************************************
 *
      12 !-----------------------------------------------
