       1       subroutine deri23(f, fd, e, fci, cmo, emo, ninear, minear)
       2       use molkst_C, only : norbs, nopen, fract
       3       use meci_C, only : nelec, nmos, nbo
       4       implicit none
       5       integer :: minear, ninear
       6       double precision , intent(in) :: f(minear)
       7       double precision , intent(in) :: fd(ninear)
       8       double precision , intent(in) :: e(norbs)
       9       double precision  :: fci(minear)
      10       double precision , intent(out) :: cmo(norbs,norbs)
      11       double precision  :: emo(*)
      12       integer :: l, nend, loop, ninit, n1, n2, i, j, ncol
      13       double precision :: const, diffe, com, scal
      14 !-----------------------------------------------
      15 !**********************************************************************
      16 !  1) UNPACK THE C.I-ACTIVE M.O. DERIVATIVES IN M.O. BASIS,
      17 !     DIAGONAL BLOCKS INCLUDED.
      18 !  2) EXTRACT THE FOCK EIGENVALUES RELAXATION OVER C.I-ACTIVE M.O.
      19 !   INPUT
      20 !     F           : UNSCALED SOLUTIONS VECTOR IN M.O. BASIS,
      21 !                   OFF-DIAGONAL BLOCKS PACKED AS DEFINED IN 'DERI21'.
      22 !     FD          : DIAGONAL BLOCKS OF NON-RELAXED FOCK MATRIX
      23 !                   AS DEFINED IN 'DERI1'.
      24 !     E(NORBS)    : FOCK EIGENVALUES.
      25 !     FCI         : DIAGONAL BLOCKS OF RELAXATION OF THE FOCK MATRIX.
      26 !     NORBS       : NUMBER OF M.O
      27 !     NELEC,NMOS  : # OF LAST FROZEN CORE M.O , C.I-ACTIVE BAND LENGTH.
      28 !   OUTPUT
      29 !     CMO(N,NELEC+1,...,NELEC+NMOS): C.I-ACTIVE M.O DERIVATIVES
      30 !                                  IN M.O BASIS.
      31 !     EMO(  NELEC+1,...,NELEC+NMOS): C.I-ACTIVE FOCK EIGENVALUE RELAXAT
 I
      32 !
      33 !**********************************************************************
      34 !
      35       nopen = nbo(1) + nbo(2)
      36       const = 1.D-3
      37 !
      38 !     PART 1.
      39 !     -------
      40 !     COMPUTE AND UNPACK DIAGONAL BLOCKS, DIAGONAL TERMS INCLUDED,
      41 !     ACCORDING TO CMO(I,J) = (FD(I,J)-FCI(I,J))/(E(I)-E(J))
      42 !     AND TAKING   CMO(I,J)=0 IF E(I)=E(J) (THRESHOLD 1D-4 EV),
      43 !                             I.E WHEN M.O. DEGENERACY OCCURS.
      44       l = 1
      45       nend = 0
      46       do loop = 1, 3
      47         ninit = nend + 1
      48         nend = nend + nbo(loop)
      49         n1 = max(ninit,nelec + 1)
      50         n2 = min(nend,nelec + nmos)
      51         if (n2 < n1) cycle
      52         do i = n1, n2
      53           if (i > ninit) then
      54             do j = ninit, i - 1
      55               diffe = e(i) - e(j)
      56               if (abs(diffe) > 1.D-4) then
      57                 com = (fd(l)-fci(l))/diffe
 
 FORCHECK PC V13.5.13          DERI23          2021-03-24 10:59:30   page:  1890
 deri23.F90  /FF
 
      58               else
      59                 com = 0.D0
      60               end if
      61               cmo(i,j) = -com
      62               cmo(j,i) = com
      63               l = l + 1
      64             end do
      65           end if
      66           cmo(i,i) = 0.D0
      67         end do
      68       end do
      69       ncol = n2 - ninit + 1
      70       if (ncol > 0 .and. n2 < norbs) then
      71         do j = ninit, n2
      72           do i = n2 + 1, norbs
      73             diffe = e(i) - e(j)
      74             if (Abs (diffe) > 1.d-4) then
      75               com = (fd(l)-fci(l)) / diffe
      76             else
      77               com = 0.d0
      78             end if
      79             cmo(i, j) = -com
      80             cmo(j, i) = com
      81             l = l + 1
      82           end do
      83         end do
      84       end if
      85 !
      86 !     C.I-ACTIVE EIGENVALUES RELAXATION.
      87       call dcopy (nmos, fci(l), 1, emo(nelec+1), 1)
      88 !
      89 !     PART 2.
      90 !     -------
      91 !     UNPACK THE ANTISYMMETRIC MATRIX F IN CMO, (OFF-DIAGONAL BLOCKS).
      92 !
      93       l = 1
      94       if (nbo(2)>0 .and. nbo(1)>0) then
      95 !        OPEN-CLOSED
      96         scal = 1.D0/(2.D0 - fract + const)
      97         do j = 1, nbo(1)
      98           do i = nbo(1) + 1, nopen
      99             com = f(l)*scal
     100             cmo(i,j) = -com
     101             cmo(j,i) = com
     102             l = l + 1
     103           end do
     104         end do
     105       end if
     106       if (nbo(3)>0 .and. nbo(1)>0) then
     107 !       VIRTUAL-CLOSED
     108         scal = 0.5D0
     109         do j = 1, nbo(1)
     110           do i = nopen + 1, norbs
     111             com = f(l)*scal
     112             cmo(i,j) = -com
     113             cmo(j,i) = com
     114             l = l + 1
     115           end do
     116         end do
 
 FORCHECK PC V13.5.13          DERI23          2021-03-24 10:59:30   page:  1891
 deri23.F90  /FF
 
     117       end if
     118       if (nbo(3)/=0 .and. nbo(2)/=0) then
     119 !        VIRTUAL-OPEN
     120         scal = 1.D0/(fract + const)
     121         do j = nbo(1) + 1, nopen
     122           do i = nopen + 1, norbs
     123             com = f(l)*scal
     124             cmo(i,j) = -com
     125             cmo(j,i) = com
     126             l = l + 1
     127           end do
     128         end do
     129       end if
     130       return
     131       end subroutine deri23
 
