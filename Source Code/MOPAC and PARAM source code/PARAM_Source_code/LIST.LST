       5 subroutine orient_water(O_of_H2O, H1, H2, fun)
       6 use common_arrays_C,  only : coord, nat
       7 use molkst_C,  only : numat
       8 use orient_water_C, only: near,  O_coord, n_atoms, near_nat, O_copy, H1
 _copy, atom_nos
       9 implicit none
      10 integer, intent (in) :: O_of_H2O, H1, H2
      11 double precision, intent (out) :: fun
      12 double precision :: x(6)
      13 integer   :: i, n
      14 double precision, external :: distance
      15   n = 6
      16   x(1:3) = coord(:,H1)
      17   x(4:6) = coord(:,H2)
      18   O_coord = coord(:,O_of_H2O)
      19   O_copy = O_of_H2O
      20   H1_copy = H1
      21 !
      22 ! Find nearby atoms
      23 !
      24   n_atoms = 0
      25   do i = 1, numat
      26     if (distance(O_of_H2O, i) < 3.5d0) then
      27       if (i /= O_of_H2O .and. i /= H1 .and. i /= H2) then
      28         n_atoms = n_atoms + 1
      29         near(:, n_atoms) = coord(:, i)
      30         near_nat(n_atoms) = nat(i)
      31         atom_nos(n_atoms) = i
      32       end if
      33     end if
      34   end do
      35   if (n_atoms > 0) then
      36     call cobyla (n, x, fun)
      37     coord(:,H1) = x(1:3)
      38     coord(:,H2) = x(4:6)
      39   end if
      40   return
      41 end subroutine orient_water
 
