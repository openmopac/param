     757       do i = 1, numat
     758         xmin = coord(1, i) ** 2 + coord(2, i) ** 2 + coord(3, i) ** 2
     759         if (xmin >= rmin) then
     760           ligand_type = nat(i)
     761           exit
     762         end if
     763       end do
