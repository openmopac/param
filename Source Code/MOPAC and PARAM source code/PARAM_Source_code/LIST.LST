     100       t(3,5,ioper) = s12*e2*x2*sin(ta)
     101       t(4,1,ioper) = 2.D0*e1*x3*sin(ta - g) + 2.D0*e3*x1*sin(ta + g)
     102       t(4,2,ioper) = (-(e4 - 3.D0*e2*x2)*sin(a + g)) - (3.D0*e2*x2 - x4
 )*sin(a - g)
     103       t(4,3,ioper) = -2.D0*s3*(e3*x1 - e1*x3)*sin(g)
     104       t(4,4,ioper) = (e4 - 3.D0*e2*x2)*cos(a + g) + (3.D0*e2*x2 - x4)*c
 os(a - g)
     105       t(4,5,ioper) = (-2.D0*e3*x1*cos(ta + g)) - 2.D0*e1*x3*cos(ta - g)
     106       t(5,1,ioper) = (-e4*sin(ta + tg)) + x4*sin(ta - tg)
     107       t(5,2,ioper) = (-2.D0*e3*x1*sin(a + tg)) - 2.D0*e1*x3*sin(a - tg)
     108       t(5,3,ioper) = -2.D0*s3*e2*x2*sin(tg)
     109       t(5,4,ioper) = 2.D0*e3*x1*cos(a + tg) + 2.D0*e1*x3*cos(a - tg)
     110       t(5,5,ioper) = e4*cos(ta + tg) - x4*cos(ta - tg)
