      42       if (.not. allocated(wk1)) allocate(wk1(n))
      43       if (.not. allocated(wk2)) allocate(wk2(n))
      44       if (ifstor == 1) then
      45 !       **** see if element already evaluated and stored ****
      46         nm1 = matind(max(i, j) - ncore) + min(i, j) - ncore
      47         nm2 = matind(max(a, b) - ncore) + min(a, b) - ncore
      48         nmc = matind(max(nm1, nm2)) + min(nm1, nm2)
      49
      50         nm1 = matind(max(i, a) - ncore) + min(i, a) - ncore
      51         nm2 = matind(max(j, b) - ncore) + min(j, b) - ncore
      52         nme = matind(max(nm1, nm2)) + min(nm1, nm2)
      53
      54         edefs = edef / 2.
      55         if (ee2(nme) < edefs .and. ee2(nmc) < edefs) then
      56 !         **** retriev from store ****
      57           j12 = ee2(nmc)
      58           k12 = ee2(nme)
      59           return
      60         end if
      61       end if
      62
      63 !     ********** evaluate integrals **************
      64
      65       diagon = i == j .and. a == b
      66       j12 = 0.d0
      67       k12 = 0.d0
      68
      69 !     **** elements of symmetry i x j ****
      70
      71       if (iand (nbtmo(i), nbtmo(j)) /= 0) then
      72         ir = ixprd(nsym(i), nsym(j))
      73         imu0 = 0
      74         do mu1 = nslwr(ir), nsupr(ir)
      75           mu = istr(1, mu1)
      76           wk1(mu) = c(i, mu)*c(j, mu)
      77           wk2(mu) = c(a, mu)*c(b, mu)
      78           j12 = j12 + wk1(mu)*wk2(mu) * gamma(mu1, mu1)
      79           do nu1 = nslwr(ir), mu1 - 1
      80 !            **** CNDO coulomb integrals (mu, mu|nu, nu) ****
      81              nu = istr(1, nu1)
      82              j12 = j12 + (wk1(mu)*wk2(nu) + wk1(nu)*wk2(mu)) *&
      83      &                                gamma(mu1, nu1)
      84           end do
      85           if (nham == 2) then
      86 !           **** INDO exchange terms (mu, nu|mu, nu) ****
      87             imu = iat(mu)
      88             if (imu /= imu0) then
      89               nu1l = mu1
      90               imu0 = imu
      91             else
      92               do nu1 = nu1l, mu1 - 1
      93                 nu = istr(1, nu1)
      94                 k12 = k12 + (wk1(mu)*wk2(nu) + wk1(nu)*wk2(mu))&
      95      &                        * gamma(nu1, mu1)
      96               end do
      97             end if
      98           end if
      99         end do
     100       end if
 
 FORCHECK PC V13.5.13          INTTR           2021-03-24 10:59:30   page:  3963
 ci.F90  /FF
 
     101
