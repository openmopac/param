       1       subroutine resolv(c, cold, mdim, eig, nocc, size_of_LMO)
       2       use common_arrays_C, only : nfirst, nlast
       3       use molkst_C, only : norbs, numat, keywrd
       4       implicit none
       5       integer , intent(in) :: mdim
       6       integer , intent(in) :: nocc
       7       double precision , intent(inout) :: c(mdim,mdim)
       8       double precision , intent(in) :: cold(mdim,mdim)
       9       double precision , intent(in) :: eig(nocc), size_of_LMO(nocc)
      10 !
      11       integer , dimension(4) :: idegen
      12       integer :: loop, j, k, nsec, i, ij, ii, jj, l, mo1, mo2, mo3, ato
 m_a, atom_b
      13       double precision, dimension(10) :: sec
      14       double precision, dimension(16) :: vec
      15       double precision, dimension(4) :: eigs
      16       double precision :: thresh, sum1, sum, coi, coj, sum2, sum3, &
      17         sqrt_2, sqrt_3, sqrt_23, sqrt_6
      18       logical :: l_banana, l_rabbit, lone_pair, multiple
      19       logical, allocatable :: used_MO(:)
      20 !**********************************************************************
 *
      21 !
      22 !   RESOLVE removes any ill-definition in the LMOs.
      23 !
      24 !   If two or more LMOs have the same atomic contributions, then
      25 !   any linear combination of these LMOs is an acceptable solution.
      26 !   This is undesirable, in that the energies of these LMOs is therefor
 e
      27 !   not defined.  RESOLVE will identify such sets of LMOs, and resolve
      28 !   them so that they have a zero energy interaction, that is, the
      29 !   integral <psi(1)|F|psi(2)> is zero.
      30 !
      31 !**********************************************************************
 *
      32       atom_a = 0
      33       atom_b = 0
      34       thresh = 0.05d0
      35       lone_pair = .false.
      36       l_banana = (index(keywrd, "BANANA") /= 0)
      37       l_rabbit = (index(keywrd, "RABBIT") /= 0)
      38       allocate(used_MO(norbs))
      39       used_MO = .false.
      40       sqrt_2 = sqrt(0.5d0)
      41       sqrt_3 = sqrt(1/3.d0)
      42       sqrt_23 = sqrt(2/3.d0)
      43       sqrt_6 = sqrt(1/6.d0)
      44
      45       l160: do loop = 1, nocc
      46 !
      47 !  Test the LMO to see if it is a potential candidate for degeneracy.
      48 !
      49 !  If the LMO is entirely on one atom (a lone pair) or
      50 !  if the LMO is over 30% on one atom and entirely on two atoms (a doub
 le or triple bond)
      51 !
      52         if (used_MO(loop)) cycle
      53         do j = 1, numat
 
 FORCHECK PC V13.5.13          RESOLV          2021-03-24 10:59:30   page:   386
 resolv.F90  /FF
 
      54           if (nlast(j) == nfirst(j)) cycle
      55           sum1 = 0.D0
      56           do k = nfirst(j), nlast(j)
      57             sum1 = sum1 + c(k,loop)**2
      58           end do
      59 !
      60 !  Only LMOs that are near 100% on an atom (a lone pair) or at least 30
 % on one atom and entirely
      61 !  on two atoms (a bond) are potential candidates.
      62 !
      63           if (sum1 > 1.d0 - thresh) then
      64             lone_pair = .true.
      65             atom_a = j
      66             exit
      67           else if (sum1 > 0.3d0) then
      68             do l = j + 1, numat
      69               sum2 = 0.D0
      70               do k = nfirst(l), nlast(l)
      71                 sum2 = sum2 + c(k,loop)**2
      72               end do
      73               if (sum1 + sum2 > 1.d0 - thresh) exit
      74             end do
      75             if (l <= numat) then
      76               atom_a = j
      77               atom_b = l
      78               exit
      79             end if
      80           end if
      81         end do
      82         if (j > numat) then
      83 !
      84 ! No atoms qualify as belonging to either a lone pair or to an atom in
 a diatomic bond
      85 ! so go on to the next LMO
      86 !
      87           continue
      88           cycle  l160
      89         end if
      90 !
      91 ! If a lone pair, then "atom_a" is the atom involved
      92 ! If a bond, then "atom_a" is the first atom, and "atom_b" is the secon
 d atom in the bond
      93 !
      94         nsec = 1
      95         idegen(nsec) = loop
      96 !
      97 !   LMO 'LOOP' is a candidate.  Now identify any related LMOs
      98 !
      99         do i = loop + 1, nocc
     100 !
     101 ! Check that LMO "i" has not already been used.
     102 !
     103           if (used_MO(i)) cycle
     104 !
     105 ! Check that LMO "i" has roughly the same number of centers as LMO "loo
 p".
     106 ! If it does not, then it is not a candidate for rabbit ears or banana
 bonds
     107 !
 
 FORCHECK PC V13.5.13          RESOLV          2021-03-24 10:59:30   page:   387
 resolv.F90  /FF
 
     108           if (abs(size_of_LMO(i) - size_of_LMO(loop)) > 0.3d0) cycle
     109           multiple = .false.
     110           sum1 = 0.d0
     111           do k = nfirst(atom_a), nlast(atom_a)
     112               sum1 = sum1 + c(k,i)**2
     113           end do
     114           if (lone_pair) then
     115             multiple = (sum1 > 1.d0 - thresh)
     116           else
     117             sum2 = 0.d0
     118             do k = nfirst(atom_b), nlast(atom_b)
     119                 sum2 = sum2 + c(k,i)**2
     120             end do
     121             multiple = (sum1 + sum2 > 1.d0 - thresh)
     122           end if
     123           if (multiple) then
     124             nsec = nsec + 1
     125             idegen(nsec) = i
     126             used_MO(i) = .true.
     127           end if
     128         end do
     129         if (nsec /= 1 .and. nsec < 4) then
     130 !
     131 !   Build small secular determinant.
     132 !
     133           ij = 0
     134           do ii = 1, nsec
     135             i = idegen(ii)
     136             do jj = 1, ii
     137               j = idegen(jj)
     138               sum = 0.D0
     139               do l = 1, nocc
     140                 coi = 0.D0
     141                 coj = 0.D0
     142                 do k = 1, norbs
     143                   coi = coi + cold(k,l)*c(k,i)
     144                   coj = coj + cold(k,l)*c(k,j)
     145                 end do
     146                 sum = sum + coi*eig(l)*coj
     147               end do
     148               ij = ij + 1
     149               sec(ij) = sum
