    1659   subroutine identify_nearby_counterions(i_in, j_in, n_jj, near_ions, r
 _ions, line)
    1660 !
    1661 ! Identify charged atoms
    1662 ! If the charge is +1 or -1, then test for salt bridge
    1663 !
    1664   use MOZYME_C, only : ions
    1665   use common_arrays_C, only : txtatm, nbonds, ibonds, nat
    1666   implicit none
    1667   integer, intent(in) :: i_in, j_in
    1668   integer, intent (inout) :: n_jj, near_ions(2, 100)
    1669   double precision, intent (inout) :: r_ions(100)
    1670   character, intent (out) :: line*100
    1671 !
    1672   double precision :: sum, sum_min
    1673   integer :: i, j, k, l, m, atom_i, atom_j, i_set(3), ni, j_set(3), nj
    1674   character :: atm*3
    1675   logical :: l_salt_i, l_salt_j
    1676   double precision, external :: distance
    1677   if (ions(i_in) == 1) then
    1678     atom_i = i_in
    1679     atom_j = j_in
    1680   else
    1681     atom_j = i_in
    1682     atom_i = j_in
    1683   end if
    1684   ni = 1
    1685   i_set(1) = atom_i
    1686   nj = 1
    1687   j_set(1) = atom_j
    1688   if (ions(atom_i)*ions(atom_j) == -1) then
    1689 !
    1690 !  This might be a salt-bridge.  Search for the shortest contact distan
 ce
    1691 !
    1692 ! Look for cations
    1693 !
    1694     if (txtatm(atom_i)(18:20) == "HIS") then
    1695 !
    1696 ! Search for ND1 and NE2 in the imidazolium ring
    1697 !
    1698       if (txtatm(atom_i)(14:16) == "CE1" .or. txtatm(atom_i)(14:16) ==
 "ND1" .or. txtatm(atom_i)(14:16) == "NE2") then
    1699         if (txtatm(atom_i)(14:16) == "CE1") then
    1700 !
    1701 !  Use the nitrogen atoms on each side of the current atom
    1702 !
    1703           ni = 0
    1704           do i = 1, nbonds(atom_i)
    1705             j = ibonds(i,atom_i)
    1706             if (nat(j) == 7) then
    1707               ni = ni + 1
    1708               i_set(ni) = j
    1709             end if
    1710           end do
    1711         else                                                  ! The fol
 lowing block has not been tested.
    1712           if (txtatm(i_in)(14:16) == "ND1") then
 
 FORCHECK PC V13.5.13                          2021-03-24 10:59:30   page:  2775
 geochk.F90  /FF
 
    1713             atm = "NE2"
    1714           else
    1715             atm = "ND1"
    1716           end if
    1717 !
    1718 !  Use the current nitrogen atom and the nitrogen atom on the other sid
 e of "CE1"
    1719 !
    1720           do i = 1, nbonds(atom_i)
    1721             j = ibonds(i,atom_i)
    1722             if (txtatm(j)(14:16) == "CE1") then
    1723               do k = 1, nbonds(j)
    1724                 l = ibonds(k,j)
    1725                 if (txtatm(l)(14:16) == atm) then
    1726                   ni = ni + 1
    1727                   i_set(ni) = l
    1728                 end if
    1729               end do
    1730             end if
    1731           end do
    1732         end if
    1733       end if
    1734     else if (txtatm(atom_i)(18:20) == "ARG") then
    1735       if (txtatm(atom_i)(14:15) == "CZ" .or. txtatm(atom_i)(14:16) == "
 NH1" .or. txtatm(atom_i)(14:16) == "NH2") then
    1736         if (txtatm(atom_i)(14:15) == "CZ") then
    1737 !
    1738 !  Use the terminal nitrogen atoms on each side of the current atom
    1739 !
    1740           ni = 0
    1741           do i = 1, nbonds(atom_i)
    1742             j = ibonds(i,atom_i)
    1743             ni = ni + 1
    1744             i_set(ni) = j
    1745           end do
    1746         end if
    1747       end if
    1748     end if
    1749 !
    1750 ! Look for anionic oxygen atoms
    1751 !
    1752    if (txtatm(atom_i)(24:26) == "107" .and. txtatm(atom_j)(24:26) == "2
 45") then
    1753     continue
    1754    end if
    1755     if (txtatm(atom_j)(14:14) == "O") then
    1756       do i = 1, nbonds(atom_j)
    1757         j = ibonds(i, atom_j)
    1758         if (txtatm(j)(14:14) == "C" .and. nbonds(j) == 3) then
    1759 !
    1760 ! Search for both oxygen atoms of a -COO
    1761 !
    1762           nj = 0
    1763           do l = 1, nbonds(j)
    1764             m = ibonds(l,j)
    1765             if (txtatm(m)(14:14) == "O") then
    1766               nj = nj + 1
    1767               j_set(nj) = m
    1768             end if
 
 FORCHECK PC V13.5.13                          2021-03-24 10:59:30   page:  2776
 geochk.F90  /FF
 
    1769           end do
    1770         end if
    1771       end do
    1772     end if
    1773   end if
    1774
    1775 !
    1776 ! Now find the shortest distance between the two ions
    1777 !
    1778   sum_min = 1.d10
    1779   k = 0
    1780   l = 0
    1781   do i = 1, ni
    1782     atom_i = i_set(i)
    1783     do j = 1, nj
    1784       atom_j = j_set(j)
    1785       sum = distance(atom_i, atom_j)
    1786       if (sum < sum_min) then
    1787         sum_min = sum
    1788         k = atom_i
    1789         l = atom_j
    1790       end if
    1791     end do
    1792   end do
    1793   atom_i = k
    1794   atom_j = l
    1795   if (sum_min < 99.d0) then
    1796     n_jj = n_jj + 1
    1797     if (n_jj > 100) return
    1798     if(ions(i_in) == 1) then
    1799       near_ions(1,n_jj) = atom_i
    1800       near_ions(2,n_jj) = atom_j
    1801     else
    1802       near_ions(1,n_jj) = atom_j
    1803       near_ions(2,n_jj) = atom_i
    1804     end if
    1805     r_ions(n_jj) = sum_min
    1806     l_salt_i = .false.
    1807     l_salt_j = .false.
    1808     if (txtatm(atom_i)(18:20) == "HIS") then
    1809       if (txtatm(atom_i)(14:16) == "ND1" .or. txtatm(atom_i)(14:16) ==
 "NE2") l_salt_i = .true.
    1810     else if (txtatm(atom_i)(18:20) == "ARG") then
    1811        if (txtatm(atom_i)(14:16) == "NH1" .or. txtatm(atom_i)(14:16) ==
  "NH2" &
    1812          .or. txtatm(atom_i)(14:15) == "NE") l_salt_i = .true.
    1813     else if (txtatm(atom_i)(14:14) == "N") then
    1814        if (nbonds(atom_i) == 4) l_salt_i = .true.
    1815     end if
    1816     if (txtatm(atom_j)(14:14) == "O") l_salt_j = .true.
    1817     if (l_salt_i .and. l_salt_j .and. sum_min < 4.d0) line = "Salt brid
 ge!"
    1818   end if
    1819   return
    1820   end subroutine identify_nearby_counterions
 
