     971       double precision function rijkl (ni, nj, ij, kl, li, lj, lk, ll,
 ic, r)
     972 !-----------------------------------------------
     973 !   M o d u l e s
     974 !-----------------------------------------------
     975       use parameters_C, only : ddp, po
     976       use mndod_C, only : indx, ch
     977 !-----------------------------------------------
     978 !   I n t e r f a c e   B l o c k s
     979 !-----------------------------------------------
     980       implicit none
     981 !-----------------------------------------------
     982 !   D u m m y   A r g u m e n t s
     983 !-----------------------------------------------
     984       integer , intent(in) :: ni
     985       integer , intent(in) :: nj
