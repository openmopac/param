       1       subroutine dtran2(r, t, ioper)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use funcon_C, only : pi
       6       implicit none
       7 !-----------------------------------------------
       8 !   D u m m y   A r g u m e n t s
       9 !-----------------------------------------------
      10       integer , intent(in) :: ioper
