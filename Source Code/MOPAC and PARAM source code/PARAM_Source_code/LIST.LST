    2675       subroutine ngamtg(x, gd3, ud3, g1, u1, gs, usmd, eps, us)
    2676 !-----------------------------------------------
    2677 !   M o d u l e s
    2678 !-----------------------------------------------
    2679       use molkst_C, only : norbs, nclose
    2680       use chanel_C, only : iw
    2681        USE polar_C, only : omega
    2682 !**********************************************************************
