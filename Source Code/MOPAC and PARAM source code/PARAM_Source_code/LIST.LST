       1   subroutine fillij (count)
       2       use molkst_C, only: numat, natoms, cutofp, id, n2elec, l1u, l2u,
 l3u, keywrd, mpack, &
       3         ispd, line
       4       use common_arrays_C, only : tvec, coord
       5       use chanel_C, only: iw
       6       use MOZYME_C, only : cutofs, direct, semidr, &
       7         nijbo, lijbo, iijj, iij, ij_dim, ijall, numij, morb, iorbs
       8       use overlaps_C, only : cutof1, cutof2
       9 !
      10       implicit none
      11       !
      12       !****************************************************************
 *******
      13       !
      14       ! fillij creates either the array ijbo, if there is enough memory
 , or
      15       ! the arrays iijj, ijall, and iij, if there is not enough memory.
      16       !
      17       !****************************************************************
 *******
      18       logical :: count
      19 !
      20       integer :: i, ii, iloop, io, ip, j, jloop, jo, jp, &
      21            & kp, lp, ix
      22       double precision :: r, rmin, rr, x1, x2, x3
      23       save :: ix
      24       logical :: first
      25       double precision, dimension (3) :: xj
      26       double precision, external :: reada
      27 !
      28       if (.not. allocated(nijbo)) then
      29         ix = 0
      30         n2elec = 0
      31         mpack = 0
      32         first = .true.
      33         morb = 4
      34         if (ispd > 0) morb = 9
      35       else
      36 !
      37 !   Array nijbo was already allocated, therefore it was filled.  Do not
  reset mpack1, instead add any new interactions
      38 !   to array nijbo
      39 !
      40         first = .false.
      41       end if
      42 !
      43       if (.not. count) then
      44         ! Allocate either nijbo or iijj and ijall
      45         if ( .not. allocated(nijbo)) then
      46           i = 1
      47           if (lijbo) then
      48 !
      49 !  Try to allocate memory for a simple square array
      50 !
      51             allocate (nijbo(numat, numat), stat = i)
