     382
     383 subroutine eigen_limits (print_nocc, print_nvir)
     384    !
     385    ! This routine evaluates the number of occupied and virtual orbitals
     386    ! to be written out to the output file.
     387     use molkst_C, only: norbs, nelecs, keywrd
     388     implicit none
     389     integer, intent (inout) :: print_nocc, print_nvir
     390     integer :: i, j
     391     integer :: noccupied, nvirtual
     392     integer, parameter :: default_print_nocc = 8
     393     integer, parameter :: default_print_nvir = 8
     394     character (len=248) :: tmpkey
     395     double precision, external :: reada
     396     noccupied = nelecs/2
     397     nvirtual = norbs - noccupied
     398     if (Index (keywrd, " ALLVEC") /= 0) then
     399       !
     400       ! Everything requested
     401       print_nocc = noccupied
     402       print_nvir = nvirtual
     403     else if ((Index (keywrd, " VECTORS(") /= 0) .or. &
     404            & (Index (keywrd, " VECTORS=(") /= 0)) then
     405       !
     406       ! User has requested limits
     407       !
     408       ! Extract user limits from keyword string
     409       !
     410       ! Build temporary keyword string, and erase all text from it
     411       ! except VECTORS data
     412       tmpkey = trim(keywrd)
     413       i = Index (tmpkey, "VECTORS=(") + Index (tmpkey, "VECTORS(")
     414       tmpkey (:i) = " "
     415       j = Index (tmpkey, ")")
     416       tmpkey (j:) = " "
     417       ! Extract number of occupied orbitals to be written out
     418       print_nocc = Nint (reada (tmpkey, i))
     419       ! Extract number of virtual orbitals to be written out
     420       i = Index (tmpkey, ",") + Index (tmpkey, ":")
     421       if (i /= 0) then
     422         print_nvir = Nint (reada (tmpkey, i + 1))
     423       else
     424         print_nvir = default_print_nvir
     425       end if
     426     else
     427       !
     428       ! Use defaults
     429       print_nocc = default_print_nocc
     430       print_nvir = default_print_nvir
     431     end if
     432    !
     433    ! Make sure number of orbitals requested is no larger than
     434    ! the number available
     435     print_nocc = Max (0, Min (print_nocc, noccupied))
     436     print_nvir = Max (0, Min (print_nvir, nvirtual))
     437 end subroutine eigen_limits
 
