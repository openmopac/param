       1       subroutine rsp(a, n, root, vect)
       2       implicit none
       3       integer  :: n
       4       double precision  :: a(*)
       5       double precision, intent (out)  :: root(n)
       6       double precision  :: vect(n,n)
       7 !
       8 ! Trivial case: n = 1
       9 !
      10       if (n == 1) then
      11         root(1) = a(1)
      12         vect(1,1) = 1.d0
      13         return
      14       end if
      15       call eigenvectors_LAPACK(vect, a, root, n)
      16       return
      17       end subroutine rsp
 
