     117       atomjx = ' 0 0 0'
     118 !
     119 !     fspdf(i, j) is weighting factor.
     120 !     i = angular quantum number + 1,
     121 !     j = 1, 2, 3, 4 for sigma, pi, delta, phi.
     122       do 1 i = 1, 4
     123       do 11 j = 1, 4
     124       fspdf(i, j) = one
     125    11 continue
     126     1 continue
     127       fspdf(1, 1) = fssig
     128       fspdf(2, 1) = fpsig
     129       fspdf(2, 2) = fppi
     130       fspdf(3, 1) = fdsig
     131       fspdf(3, 2) = fdpi
