       1       subroutine h1elec(ni, nj, xi, xj, smat)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5 !-----------------------------------------------
       6 !   I n t e r f a c e   B l o c k s
       7 !-----------------------------------------------
       8       use parameters_C, only : natorb, betas, betap, betad
       9       use MOZYME_C, only : cutofs
      10       implicit none
      11 !-----------------------------------------------
      12 !   D u m m y   A r g u m e n t s
      13 !-----------------------------------------------
      14       integer  :: ni
      15       integer  :: nj
      16       double precision , intent(in) :: xi(3)
      17       double precision , intent(in) :: xj(3)
      18       double precision  :: smat(9,9)
      19
      20 !-----------------------------------------------
      21 !   L o c a l   V a r i a b l e s
      22 !-----------------------------------------------
      23       integer :: j, norbi, norbj
      24       double precision :: bi(9), bj(9), xjuc(3), rab
      25 !-----------------------------------------------
      26 !**********************************************************************
 *
      27 !
      28 !  H1ELEC FORMS THE ONE-ELECTRON MATRIX BETWEEN TWO ATOMS.
      29 !
      30 !   ON INPUT    NI   = ATOMIC NO. OF FIRST ATOM.
      31 !               NJ   = ATOMIC NO. OF SECOND ATOM.
      32 !               XI   = COORDINATES OF FIRST ATOM.
      33 !               XJ   = COORDINATES OF SECOND ATOM.
      34 !
      35 !   ON OUTPUT   SMAT = MATRIX OF ONE-ELECTRON INTERACTIONS.
      36 !
      37 !**********************************************************************
 *
      38       rab = (xi(1)-xj(1))**2+(xi(2)-xj(2))**2+(xi(3)-xj(3))**2
      39       if (rab > cutofs .or. (rab > 3.24D0 .and. (ni==102 .or. nj==102))
 ) then
      40         smat = 0.D0
      41         return
      42       end if
      43       xjuc = xj - xi
      44       call diat (ni, nj, xjuc, smat)
      45       bi(1) = betas(ni)*0.5D0
      46       bi(2) = betap(ni)*0.5D0
      47       bi(3) = bi(2)
      48       bi(4) = bi(2)
      49       bi(5) = betad(ni)*0.5D0
      50       bi(6) = bi(5)
      51       bi(7) = bi(5)
      52       bi(8) = bi(5)
      53       bi(9) = bi(5)
      54       bj(1) = betas(nj)*0.5D0
      55       bj(2) = betap(nj)*0.5D0
 
 FORCHECK PC V13.5.13          H1ELEC          2021-03-24 10:59:30   page:  3012
 h1elec.F90  /FF
 
      56       bj(3) = bj(2)
      57       bj(4) = bj(2)
      58       bj(5) = betad(nj)*0.5D0
      59       bj(6) = bj(5)
      60       bj(7) = bj(5)
      61       bj(8) = bj(5)
      62       bj(9) = bj(5)
      63       norbi = natorb(ni)
      64       norbj = natorb(nj)
      65       do j = 1, norbj
      66         smat(:norbi,j) = smat(:norbi,j)*(bi(:norbi)+bj(j))
      67       end do
      68       return
      69       end subroutine h1elec
 
