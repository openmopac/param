     187           cpr = 1.5D0*R
     188           hr = cpr*T
     189           sr = R*(1.5D0*dlog(1.D0/c1) - dlog(sym) + dlog(e0)/2.D0 + 1.5
 D0)
     190         else
     191           qr = 1.D0/(c1*a*sym)
     192           cpr = R
     193           hr = cpr*T
     194           sr = R*dlog(qr) + R
