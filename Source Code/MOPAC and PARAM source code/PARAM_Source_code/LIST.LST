    4089       subroutine openda(irest)
    4090 !-----------------------------------------------
    4091 !   M o d u l e s
    4092 !-----------------------------------------------
    4093       use chanel_C, only : idaf, irecln, irecst, ioda, ifilen, &
    4094       pol_fn
    4095 !
    4096 !     - - - - OPEN MASTER DICTIONARY FILE 10 - - - -
    4097 !
    4098       implicit none
    4099 !-----------------------------------------------
    4100 !   D u m m y   A r g u m e n t s
    4101 !-----------------------------------------------
    4102       integer , intent(in) :: irest
    4103 !-----------------------------------------------
    4104 !
    4105 !
    4106       idaf = 17
    4107       irecln = 1023
    4108       open(unit=idaf, file=pol_fn, status='UNKNOWN', access=&
    4109         'DIRECT', form='UNFORMATTED', recl=8*irecln)
    4110 !
    4111 !     ----- IS THIS A NEW OR OLD DAF FILE -----
    4112 !
    4113       if (irest == 0) then
    4114 !
    4115 !        ----- MARK THE NEW DAF RECORDS AS EMPTY -----
    4116 !
    4117         irecst = 1
    4118         ioda = -1
    4119         irecst = irecst + 1
    4120         write (unit=idaf, rec=1) irecst, ioda, ifilen
    4121         return
    4122       end if
    4123 !
    4124 !     ----- LOAD THE OLD DAF DIRECTORY -----
    4125 !
    4126       read (unit=idaf, rec=1) irecst, ioda, ifilen
    4127       return
    4128       end subroutine openda
 
