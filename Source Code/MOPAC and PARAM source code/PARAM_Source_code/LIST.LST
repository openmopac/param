       1 subroutine adjvec (cvecb, ncvb, icvecb, nib, nncb, ncb_loc, nnb, ncvecb
 , lmob, &
       2 & iorbs, cveca, ncva, icveca, nia, nnca, nca_loc, nna_loc, ncveca, lmoa
 , beta, &
       3 & iused, sumtot)
       4     use molkst_C, only: numat, norbs
       5     use MOZYME_C, only : thresh
       6     implicit none
       7     integer, intent (in) :: lmoa, lmob, ncva, ncvb, nia, nib, nna_loc,
 nnb
       8     double precision, intent (in) :: beta
       9     double precision, intent (inout) :: sumtot
      10     integer, dimension (nia), intent (in) :: icveca
      11     integer, dimension (nib), intent (inout) :: icvecb
      12     integer, dimension (nna_loc), intent (in) :: nca_loc, ncveca, nnca
      13     integer, dimension (nnb), intent (in) :: ncvecb, nncb
      14     integer, dimension (nnb), intent (inout) :: ncb_loc
      15     integer, dimension (numat), intent (inout) :: iused
      16     integer, dimension (norbs), intent (in) :: iorbs
      17     double precision, dimension (ncva), intent (in) :: cveca
      18     double precision, dimension (ncvb), intent (inout) :: cvecb
      19 !
      20     integer :: ii, la, lb, llim, mia, mla, mlb, mlim, mlla, mllb
      21     double precision :: cutoff, sum
      22     mlla = 0
      23     cutoff = thresh * 1.d1
      24     if (Abs (beta) < cutoff) return
      25     sumtot = sumtot + Abs (beta)
      26    !
      27    !   IDENTIFY THE ATOMS IN THE SECOND SET OF LMOs.  ATOMS NOT USED AR
 E
      28    !   FLAGGED BY '-1' IN IUSED.
      29    !
      30     do la = nnca(lmoa) + 1, nnca(lmoa) + nca_loc(lmoa)
      31       iused(icveca(la)) = -1
      32     end do
      33     mlb = ncvecb(lmob)
      34     if (lmob == nnb) then
      35       llim = nib
      36     else
      37       llim = nncb(lmob+1)
      38     end if
      39     if (lmob == nnb) then
      40       mlim = ncvb - 4
      41     else
      42       mlim = ncvecb(lmob+1) - 4
      43     end if
      44     do lb = nncb(lmob) + 1, nncb(lmob) + ncb_loc(lmob)
      45       ii = icvecb(lb)
      46       iused(ii) = mlb
      47       mlb = mlb + iorbs(ii)
      48     end do
      49     mla = ncveca(lmoa)
      50    !
      51    !      ROTATION OF SECOND VECTOR TO MAKE IT ORTHOGONAL TO THE FIRST.
      52    !
      53     do la = nnca(lmoa) + 1, nnca(lmoa) + nca_loc(lmoa)
      54       mia = icveca(la)
 
 FORCHECK PC V13.5.13          ADJVEC          2021-03-24 10:59:30   page:  1229
 adjvec.F90  /FF
 
      55       if (iused(mia) >= 0) then
      56         mllb = iused(mia)
      57          !
      58          !   ROTATION INVOLVING ATOMS WHICH ARE COMMON TO BOTH LMOs
      59          !
      60         do mlla = mla + 1, mla + iorbs(mia)
      61           mllb = mllb + 1
      62           cvecb(mllb) = cvecb(mllb) - beta * cveca(mlla)
      63         end do
      64       else
      65          !
      66          !   ATOM 'MIA' DOES NOT EXIST IN LMOB.  CHECK IF IT SHOULD EXI
 ST.
      67          !   IF IT SHOULD EXIST, MAKE IT EXIST.
      68          !
      69         sum = 0.d0
      70         do mlla = mla + 1, mla + iorbs(mia)
      71           sum = sum + cveca(mlla) ** 2
      72         end do
      73         if (beta**2*sum > cutoff) then
      74           if (ncb_loc(lmob) < llim .and. mlb < mlim) then
      75             ncb_loc(lmob) = ncb_loc(lmob) + 1
      76             icvecb(nncb(lmob)+ncb_loc(lmob)) = mia
      77             iused(mia) = mlb
      78             do mlla = mla + 1, mla + iorbs(mia)
      79               mlb = mlb + 1
      80               cvecb(mlb) = -beta * cveca(mlla)
      81             end do
      82           end if
      83         end if
      84       end if
      85       mla = mla + iorbs(mia)
      86     end do
      87     if (mlla /= -1) return
      88 !
      89 !   Use in debugging - sum is the value of the overlap after orthogonal
 ization
      90 !
      91     sum = 0
      92     mla = ncveca(lmoa)
      93     do la = nnca(lmoa) + 1, nnca(lmoa) + nca_loc(lmoa)
      94       mia = icveca(la)
      95       if (iused(mia) >= 0) then
      96         mllb = iused(mia)
      97         do mlla = mla + 1, mla + iorbs(mia)
      98           mllb = mllb + 1
      99           sum = sum + cvecb(mllb)*cveca(mlla)
     100         end do
     101       end if
     102       mla = mla + iorbs(mia)
     103     end do
     104 end subroutine adjvec
 
