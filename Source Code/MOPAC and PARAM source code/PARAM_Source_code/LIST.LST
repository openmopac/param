    1277         do k = 13, 16
    1278             if (txtatm(i)(k:k) == " ") then
    1279               txtatm(i)(k:k) = "1"
    1280               if (numat == numat_old) then
    1281                 if (txtatm1(i) == " ") txtatm1(i) = txtatm(i)
    1282               end if
    1283               exit
    1284             end if
    1285         end do
    1286       end if
    1287     end if
    1288   end do
    1289
    1290 !
    1291 !  Add atom numbering, using PDB format, i.e., a TER group has its own
 number
    1292 !  (TER groups are represented by BREAKS)
    1293 !
    1294   j = 1
    1295   do i = 1, numat
    1296     write(line,'(a6,i5,a)')txtatm(i)(:6),i + j - 1,txtatm(i)(12:)
    1297     txtatm(i) = trim(line)
 
 FORCHECK PC V13.5.13      UPDATE_TXTATM       2021-03-24 10:59:30   page:  4137
 geochk_bits_1.F90  /FF
 
    1298     if (PDB .and. i == breaks(j)) j = j + 1
    1299   end do
    1300   return
    1301   end subroutine update_txtatm
 
