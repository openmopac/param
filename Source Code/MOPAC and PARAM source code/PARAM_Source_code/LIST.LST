      71 !
      72 ! CHNGE IS A MACHINE-PRECISION DEPENDENT CONSTANT
      73 ! CHNGE2=CHNGE/2
      74 !
      75       if (icalcn /= numcal) then
      76         icalcn = numcal
      77         const = fpc_9
      78         if (id == 0) then
