     397       subroutine dipind(dipvec)
     398 !-----------------------------------------------
     399 !   M o d u l e s
     400 !-----------------------------------------------
     401       use common_arrays_C, only : p, nfirst, nlast, nat, geo
     402       use molkst_C, only : numat, mozyme
     403       use funcon_C, only : a0, fpc_8, fpc_1
     404       use parameters_C, only : ams, tore, dd
     405 !...............................................................
     406 !  MODIFICATION OF DIPOLE SUBROUTINE FOR USE IN THE CALUCLATION
     407 !  OF THE INDUCED DIPOLES FOR POLARIZABILITIES.
     408 !...............................................................
     409 !-----------------------------------------------
     410 !   I n t e r f a c e   B l o c k s
     411 !-----------------------------------------------
     412       implicit none
     413 !-----------------------------------------------
     414 !   D u m m y   A r g u m e n t s
     415 !-----------------------------------------------
     416       double precision , intent(out) :: dipvec(3)
     417 !-----------------------------------------------
     418 !   L o c a l   V a r i a b l e s
     419 !-----------------------------------------------
     420       integer :: i, l, j, ni, ia, k
     421       double precision, dimension(numat) :: q, q2
     422       double precision, dimension(3) :: center
     423       double precision, dimension(3,numat) :: coord
     424       double precision, dimension(4,3) :: dip
     425       double precision :: sum, hyfsp
     426       double precision, save :: wtmol = 0.0d0
     427       logical, save :: first, chargd
     428       integer, external :: ijbo
     429 !-----------------------------------------------
     430 !
     431 !**********************************************************************
 *
     432 !     DIPOLE CALCULATES DIPOLE MOMENTS
     433 !
     434 !  ON INPUT P     = DENSITY MATRIX
     435 !           Q     = TOTAL ATOMIC CHARGES, (NUCLEAR + ELECTRONIC)
     436 !           NUMAT = NUMBER OF ATOMS IN MOLECULE
     437 !           NAT   = ATOMIC NUMBERS OF ATOMS
     438 !           NFIRST= START OF ATOM ORBITAL COUNTERS
     439 !           COORD = COORDINATES OF ATOMS
     440 !
     441 !  OUTPUT  DIPOLE = DIPOLE MOMENT
     442 !**********************************************************************
 *
     443 !
     444 !     IN THE ZDO APPROXIMATION, ONLY TWO TERMS ARE RETAINED IN THE
     445 !     CALCULATION OF DIPOLE MOMENTS.
     446 !     1. THE POINT CHARGE TERM (INDEPENDENT OF PARAMETERIZATION).
     447 !     2. THE ONE-CENTER HYBRIDIZATION TERM, WHICH ARISES FROM MATRIX
     448 !     ELEMENTS OF THE FORM <NS/R/NP>. THIS TERM IS A FUNCTION OF
     449 !     THE SLATER EXPONENTS (ZS,ZP) AND IS THUS DEPENDENT ON PARAMETER-
     450 !     IZATION. THE HYBRIDIZATION FACTORS (HYF(I)) USED IN THIS SUB-
     451 !     ROUTINE ARE CALCULATED FROM THE FOLLOWING FORMULAE.
     452 !     FOR SECOND ROW ELEMENTS <2S/R/2P>
 
 FORCHECK PC V13.5.13          DIPIND          2021-03-24 10:59:30   page:  1846
 static_polarizability.F90  /FF
 
     453 !     HYF(I)= 469.56193322*(SQRT(((ZS(I)**5)*(ZP(I)**5)))/
     454 !           ((ZS(I) + ZP(I))**6))
     455 !     FOR THIRD ROW ELEMENTS <3S/R/3P>
     456 !     HYF(I)=2629.107682607*(SQRT(((ZS(I)**7)*(ZP(I)**7)))/
     457 !           ((ZS(I) + ZP(I))**8))
     458 !     FOR FOURTH ROW ELEMENTS AND UP :
     459 !     HYF(I)=2*(2.10716)*DD(I)
     460 !     WHERE DD(I) IS THE CHARGE SEPARATION IN ATOMIC UNITS
     461 !
     462 !
     463 !     REFERENCES:
     464 !     J.A.POPLE & D.L.BEVERIDGE: APPROXIMATE M.O. THEORY
     465 !     S.P.MCGLYNN, ET AL: APPLIED QUANTUM CHEMISTRY
     466 !
     467       data first/ .TRUE./, chargd /.FALSE./
     468
     469 !
     470 !  SETUP FOR DIPOLE CALCULATION
     471 !
     472       call chrge (p, q2)
     473       q(:numat) = tore(nat(:numat)) - q2(:numat)
     474       call gmetry (geo, coord)
     475 !
     476       if (first) then
     477         wtmol = 0.D0
     478         sum = 0.D0
     479         do i = 1, numat
     480           wtmol = wtmol + ams(nat(i))
     481           sum = sum + q(i)
     482         end do
     483         chargd = abs(sum) > 0.5D0
     484         first = .FALSE.
     485       end if
     486       if (chargd) then
     487 !
     488 !   NEED TO RESET ION'S POSITION SO THAT THE CENTER OF MASS IS AT THE
     489 !   ORIGIN.
     490 !
     491         center = 0.D0
     492         do i = 1, 3
     493           do j = 1, numat
     494             center(i) = center(i) + ams(nat(j))*coord(i,j)
     495           end do
     496         end do
     497         center = center/wtmol
     498         do i = 1, 3
     499           coord(i,:numat) = coord(i,:numat) - center(i)
     500         end do
     501       end if
     502       dip = 0.0D00
     503       do i = 1, numat
     504         ni = nat(i)
     505         ia = nfirst(i)
     506         l = Min(nlast(i) - ia, 3)
     507         hyfsp = 2.0D0*dd(ni)*a0*fpc_8*fpc_1*1.D-10
     508         if (mozyme) then
     509           do j = 1, l
     510             k = ijbo (i, i) + 1 + (j*(j+1)) / 2
     511             dip(j, 2) = dip(j, 2) - hyfsp * p(k)
 
 FORCHECK PC V13.5.13          DIPIND          2021-03-24 10:59:30   page:  1847
 static_polarizability.F90  /FF
 
     512           end do
     513         else
     514           do j = 1, l
     515             k = ((ia + j)*(ia + j - 1))/2 + ia
     516             dip(j,2) = dip(j,2) - hyfsp*p(k)
     517           end do
     518         end if
     519         dip(:3,1) = dip(:3,1) + 4.803D00*q(i)*coord(:,i)
     520       end do
     521       dip(:3,3) = dip(:3,2) + dip(:3,1)
     522       do j = 1, 3
     523         dip(4,j) = sqrt(dip(1,j)**2+dip(2,j)**2+dip(3,j)**2)
     524       end do
     525       dipvec(1) = -dip(1,3)
     526       dipvec(2) = -dip(2,3)
     527       dipvec(3) = -dip(3,3)
     528       return
     529 !
     530       end subroutine dipind
 
