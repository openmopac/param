    1240 subroutine write_comp_vect(output, c, size_c, cutoff, norm, text1, text
 2, fmt9p4)
    1241 !
    1242 !  Write out the vector "c" in compressed form
    1243 !
    1244   implicit none
    1245   integer, intent(in) :: output, size_c
    1246   logical, intent (in) :: norm
    1247   double precision, intent(in) :: c(size_c), cutoff
    1248   character (len=*), intent (in) :: text1, text2
    1249   character, intent (in) :: fmt9p4*5
    1250 !
    1251 !  Local
    1252 !
    1253   integer :: n, ii, j, k
    1254   double precision :: sum, phase
    1255   double precision, allocatable :: c_loc(:), c1(:)
    1256   integer, allocatable :: ivec(:), ic(:)
    1257   character :: fmt*3, fmt1*5
    1258   allocate(c_loc(size_c), c1(size_c), ivec(size_c), ic(size_c))
    1259   n = 0
    1260   do j = 1, size_c
    1261   if (Abs(c(j)) > cutoff) then
    1262     n = n + 1
    1263     ivec(n) = j
    1264     c_loc(n) = c(j)
    1265   end if
    1266   end do
    1267 !
    1268 !  Re-sequence the coefficients so that the largest is first
    1269 !
    1270   do ii = 1, n
    1271   sum = 0.d0
    1272   k = 1
    1273   do j = 1, n
    1274     if (sum < Abs(c_loc(j))) then
    1275       sum = Abs(c_loc(j))
    1276       k = j
    1277     end if
    1278   end do
    1279   ic(ii) = ivec(k)
    1280   c1(ii) = c_loc(k)
    1281   c_loc(k) = 0.d0
    1282   end do
    1283   if (norm) then
    1284     sum = 0.d0
    1285     do j = 1, n
    1286       sum = sum + c1(j)**2
    1287     end do
    1288     phase = 1.d0/sqrt(sum)
    1289     if (c1(1) < 0.d0) phase = -phase
    1290   else
    1291     phase = 1.d0
    1292   end if
    1293 !
    1294 !  Write out all finite indices.
    1295 !
    1296   if (n < 999) then
 
 FORCHECK PC V13.5.13     WRITE_COMP_VECT      2021-03-24 10:59:30   page:  4205
 to_screen.F90  /FF
 
    1297   fmt = "3.3"
    1298   else
    1299   fmt = "6.6"
    1300   end if
    1301   j = int(log10(size_c*1.0001)) + 2
    1302   write(fmt1,'(i2,a,i1)')120/j, "i", j
    1303   write(output,"(1x,a,i"//fmt//",a)")trim(text1)//"[",n,"]="
    1304   write(output,"("//fmt1//")") (ic(ii),ii=1,n)
    1305   write(output,"(1x,a,i"//fmt//",a)")trim(text2)//"[",n,"]="
    1306   write(output,"(10f"//fmt9p4//")") (phase*c1(ii),ii=1,n)
    1307   return
    1308 end subroutine write_comp_vect
 
 FORCHECK PC V13.5.13     WRITE_COMP_VECT      2021-03-24 10:59:30   page:  4206
 to_screen.F90  /FF


