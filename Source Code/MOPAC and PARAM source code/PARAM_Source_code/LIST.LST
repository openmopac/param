     267   subroutine write_path_html(mode)
     268     use chanel_C, only: input_fn
     269     use molkst_C, only : line, koment, escf, title, backslash
     270     implicit none
     271     integer, intent (in) :: mode
     272     logical :: exists
     273     integer :: iprt=27, i, j
     274     double precision :: store_escf
     275     if (mode == 1) then
     276       line = input_fn(:len_trim(input_fn) - 4)//"html"
     277     else
