      85           xjiii = 0.0D0
      86           xiiii = 0.0D0
      87           xjjjj = 0.0D0
      88           xijij = 0.0D0
      89           xiijj = 0.0D0
      90           k = 1
      91           if (norbs > 0) then
      92             psi1(:norbs) = c(:norbs,i)
      93             psi2(:norbs) = c(:norbs,j)
      94             k = norbs + 1
