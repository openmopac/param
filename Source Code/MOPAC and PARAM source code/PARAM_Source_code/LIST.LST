     284   270     format(/,/,' ',70('*'),/,' CALCULATION FOR A FREQUENCY OF ',f
 10.5,&
     285             ' EV  =',f14.5,' A.U. '/,18x,'WAVELENGTH OF ',f10.2,' NM  =
 ',f14.5,&
     286             ' CM(-1)',/,' ',70('*'))
     287         end if
     288 !
     289 !  CALCULATE ALPHA(W)
     290 !
     291         iwfla = 1
     292         call alphaf (iwfla, atol, maxita, x1, x2, x3, x4, x5, x6, x7, x
 8, c, w)
     293         if (moperr) return
     294 !
     295 !  PERFORM NONITERATIVE BETA CALCULATIONS
     296 !
     297 !   OPTICAL RECTIFICATION
     298         if (ibet == (-3)) call nonor (x1, x2, x3, x4, x5, x6, x7, x8, x
 19, x10&
     299           , x11, x12)
     300 !   ELECTROPTIC POCKELS EFFECT
     301         if (ibet == (-2)) call nonope (x1, x2, x3, x4, x5, x6, x7, x8,
 x19, x10&
     302           , x11, x12)
     303 !   SECOND HARMONIC GENERATION
     304         if (ibet == (-1)) then
     305           iwfla = 2
     306           omega = omega*2.0D00
     307           call alphaf (iwfla, atol, maxita, x1, x2, x3, x4, x5, x6, x7,
  x8, c, w)
     308           if (moperr) return
     309 !
     310           omega = omega/2.0D00
     311           call nonbet (x1, x2, x3, x4, x5, x6, x7, x8, x19, x10, x11, x
 12)
     312         end if
     313 !
     314 !  PERFORM ITERATIVE BETA (SHG AND STATIC)CALCULATIONS
     315 !
     316 !         IF ((IBET.GT.0) .AND.(IGAM .EQ. 0)) THEN
     317         if (ibet==1 .and. iwflb<=1 .and. igam==0) then
     318           call betaf (iwflb, maxitu, btol, x1, x2, x3, x4, x5, x6, x7,
 x8, x19&
     319             , x10, x11, x12, x13, c, w)
     320 !
     321 ! PERFORM ITERATIVE BETA (EOPE AND OR) CALCULATIONS
     322 !
     323         else if (ibet==1 .and. iwflb>1 .and. igam==0) then
     324           call beopor (iwflb, maxitu, btol, x1, x2, x3, x4, x5, x6, x7,
  x8, x19&
     325             , x10, x11, x12, x13, c, w)
     326         end if
     327 !......................................................................
 .
 
 FORCHECK PC V13.5.13          POLAR           2021-03-24 10:59:30   page:  2556
 polar.F90  /FF
 
     328 ! CALCULATE GAMMA VALUES
     329 !......................................................................
 .
     330         if (ibet>0 .and. igam<=3 .and. igam/=0) then
     331           iwflb = 1
     332           call betaf (iwflb, maxitu, btol, x1, x2, x3, x4, x5, x6, x7,
 x8, x19&
     333             , x10, x11, x12, x13, c, w)
     334         end if
     335 ! THIRD HARMONIC GENERATION
     336         if (igam == 1) then
     337           iwfla = 3
     338           omega = omega*3.0D00
     339           call alphaf (iwfla, atol, maxita, x1, x2, x3, x4, x5, x6, x7,
  x8, c, w)
     340           if (moperr) return
     341 !
     342           omega = omega/3.0D00
     343           call ngamtg (x1, x2, x3, x4, x5, x6, x7, x8, x19)
     344         end if
     345 ! DC-EFISHG
     346         if (igam == 2) then
     347           iwfla = 2
     348           omega = 2.0D00*omega
     349           call alphaf (iwfla, atol, maxita, x1, x2, x3, x4, x5, x6, x7,
  x8, c, w)
     350           if (moperr) return
     351 !
     352           omega = omega/2.0D00
     353           iwflb = 2
     354           call beopor (iwflb, maxitu, btol, x1, x2, x3, x4, x5, x6, x7,
  x8, x19&
     355             , x10, x11, x12, x13, c, w)
     356           call ngefis (x1, x2, x3, x4, x5, x6, x7, x8, x19)
     357         end if
     358 ! IDRI
     359         if (igam == 3) then
     360           iwflb = 3
     361           call beopor (iwflb, maxitu, btol, x1, x2, x3, x4, x5, x6, x7,
  x8, x19&
     362             , x10, x11, x12, x13, c, w)
     363           call ngidri (x1, x2, x3, x4, x5, x6, x7, x8, x19)
     364         end if
     365 ! OKE
     366         if (igam /= 4) cycle
     367         iwflb = 2
     368         call beopor (iwflb, maxitu, btol, x1, x2, x3, x4, x5, x6, x7, x
 8, x19, &
     369           x10, x11, x12, x13, c, w)
     370         call ngoke (igam, x1, x2, x3, x4, x5, x6, x7, x8, x19)
     371       end do
     372 !
     373       geo(:,:natoms) = refgeo(:,:natoms)
     374       na(:natoms) = ref_na(:natoms)
     375       return
     376       end subroutine polar
 
