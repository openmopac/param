      51         , 3, 2, 4, 2, 3, 3, 2, 2, 2, 4, 3, 2, 3, 2, 2, 4, 2, 4, 4, 3, 4
 , 2, 2, &
      52         4, 4, 4, 2, 3, 4, 5, 5, 3, 1, 5, 6, 5, 3, 4, 3, 7, 5, 3, 3, 3,
 8, 5, 3&
      53         , 2, 3, 9, 5, 3, 5, 3, 5, 6, 3, 1, 2, 6, 6, 3, 4, 2, 7, 7, 3, 3
 , 2, 8, &
      54         6, 3, 2, 2, 9, 6, 3, 5, 2, 5, 7, 3, 1, 4, 6, 7, 3, 4, 4, 7, 7,
 3, 3, 4&
      55         , 8, 7, 3, 2, 4, 9, 7, 3, 5, 4, 5, 8, 3, 1, 1, 6, 8, 3, 4, 1, 7
 , 8, 3, &
      56         3, 1, 8, 8, 3, 2, 1, 9, 8, 3, 5, 1, 5, 9, 3, 1, 5, 6, 9, 3, 4,
 5, 7, 9&
      57         , 3, 3, 5, 8, 9, 3, 2, 5, 9, 9, 3, 5, 5/
      58       data isp/ 1, 2, 3, 3, 4, 5, 5, 6, 6/
      59       if (mozyme) then
      60         call denrot_for_MOZYME()
      61         return
      62       end if
      63       allocate(b(mpack))
      64       call gmetry (geo, coord)
      65       iprt = 0
      66       j1 = 0
      67       do i = 1, numat
      68         if = nfirst(i)
      69         il = nlast(i)
      70         ipq = il - if - 1
      71         ii = ipq + 2
      72         if (ii == 0) cycle
      73         do i1 = 1, ii
      74           j1 = iprt + isp(i1)
      75           itext(j1) = atorbs(i1)
      76           jtext(j1) = elemnt(nat(i))
      77           natom(j1) = i
      78         end do
      79         iprt = j1
      80         if (ipq /= 2) ipq = min(max(ipq,1),3)
      81         do j = 1, i
      82           delx = coord(1,j) - coord(1,i)
      83           dely = coord(2,j) - coord(2,i)
      84           delz = coord(3,j) - coord(3,i)
      85           if (id /= 0) then
      86             rmin = 100.D0
      87             delxm = 0.d0
      88             delym = 0.d0
      89             delzm = 0.d0
      90             do mm = -l1u, l1u
      91               do nn = -l2u, l2u
      92                 do kk = -l3u, l3u
      93                   r = (tvec(1,1)*mm+tvec(1,2)*nn+tvec(1,3)*kk+delx)**2
 + (tvec(&
      94                     2,1)*mm+tvec(2,2)*nn+tvec(2,3)*kk+dely)**2 + (tvec(
 3,1)*mm+&
      95                     tvec(3,2)*nn+tvec(3,3)*kk+delz)**2
      96                   if (r >= rmin) cycle
      97                   rmin = r
      98                   delxm = tvec(1,1)*mm + tvec(1,2)*nn + tvec(1,3)*kk +
 delx
      99                   delym = tvec(2,1)*mm + tvec(2,2)*nn + tvec(2,3)*kk +
 dely
 
 FORCHECK PC V13.5.13          DENROT          2021-03-24 10:59:30   page:  1686
