    2201   !
    2202     subroutine matupd (n, m, ws, wy, sy, ss, d, r, itail, iupdat, col,
 head, &
    2203    & theta, rr, dr, stp, dtd)
    2204       implicit none
    2205       double precision, parameter :: one = 1.0d0
    2206       integer, intent (in) :: iupdat, m, n
    2207       integer, intent (inout) :: col, head, itail
    2208       double precision, intent (in) :: dr, dtd, rr, stp
    2209       double precision, intent (out) :: theta
    2210       double precision, dimension (n), intent (inout) :: d, r
    2211       double precision, dimension (m, m), intent (inout) :: ss, sy
    2212       double precision, dimension (n, m), intent (inout) :: ws, wy
    2213       integer :: j, pointr
    2214       external dcopy
    2215       double precision, external :: ddot
    2216       intrinsic Mod
    2217     !
    2218     !
    2219     !     Set pointers for matrices WS and WY.
    2220       if (iupdat <= m) then
    2221         col = iupdat
    2222         itail = Mod (head+iupdat-2, m) + 1
    2223       else
    2224         itail = Mod (itail, m) + 1
    2225         head = Mod (head, m) + 1
    2226       end if
    2227     !     Update matrices WS and WY.
    2228     !
    2229       call dcopy (n, d, 1, ws(1, itail), 1)
    2230       call dcopy (n, r, 1, wy(1, itail), 1)
    2231     !     Set theta=yy/ys.
    2232       theta = rr / dr
    2233     !     Form the middle matrix in B.
    2234     !        update the upper triangle of SS,
    2235     !                                         and the lower triangle of
  SY:
    2236       if (iupdat > m) then
    2237        !                              move old information
    2238         do j = 1, col - 1
    2239           call dcopy (j, ss(2, j+1), 1, ss(1, j), 1)
    2240           call dcopy (col-j, sy(j+1, j+1), 1, sy(j, j), 1)
    2241         end do
    2242       end if
    2243     !        add new information: the last row of SY
    2244     !                                             and the last column o
 f SS:
    2245       pointr = head
    2246       do j = 1, col - 1
    2247         sy(col, j) = ddot (n, d, 1, wy(1, pointr), 1)
    2248         ss (j, col) = ddot (n, ws(1, pointr), 1, d, 1)
    2249         pointr = Mod (pointr, m) + 1
    2250       end do
    2251       if (Abs(stp - one) < 1.d-20) then
    2252         ss (col, col) = dtd
 
 FORCHECK PC V13.5.13          MATUPD          2021-03-24 10:59:30   page:  2953
 lbfgs.F90  /FF
 
    2253       else
    2254         ss (col, col) = stp * stp * dtd
    2255       end if
    2256       sy(col, col) = dr
    2257     !
    2258     end subroutine matupd
 
