    1105       subroutine ovlp(ic)
    1106 !-----------------------------------------------
    1107 !   M o d u l e s
    1108 !-----------------------------------------------
    1109       use esp_C, only : cen, ex, iam, cc, is_esp, ip, npr, ncc, icd, ov
 l, &
    1110       &  dx_array, dy_array, dz_array, td, ce, exs, expn, rnai, ewcx, e
 wcy, ewcz
    1111 !**********************************************************************
 *
    1112       implicit none
    1113       integer :: ic
    1114 !-----------------------------------------------
    1115 !   L o c a l   V a r i a b l e s
    1116 !-----------------------------------------------
    1117       integer :: ipr, istart, i, j, np, ips, jps
    1118       double precision :: pi
    1119 !-----------------------------------------------
    1120 !
    1121 !     CALCULATE DISTANCE ARRAYS
    1122 !
    1123       pi = 4.D0*atan(1.D0)
    1124       ipr = ic*icd - icd + 1
    1125       istart = ipr
    1126       dx_array(istart:npr) = cen(ipr,1) - cen(istart:npr,1)
    1127       dy_array(istart:npr) = cen(ipr,2) - cen(istart:npr,2)
    1128       dz_array(istart:npr) = cen(ipr,3) - cen(istart:npr,3)
    1129       td(istart:npr) = dx_array(istart:npr)**2 + dy_array(istart:npr)**
 2 + dz_array(istart:npr)**2
    1130 !
    1131 !     CALCULATE EXPONENT SUM
    1132 !
    1133       do i = istart, npr
    1134         exs(i,:icd) = 1.D0/(ex(ipr:icd-1+ipr)+ex(i))
    1135         ce(i,:icd) = ex(ipr:icd-1+ipr)*ex(i)*exs(i,:icd)
    1136 !
    1137 !     CALCULATE EXPONENT WEIGHTED CENTERS
    1138 !
    1139         ewcx(i,:icd) = (ex(i)*cen(i,1)+ex(ipr:icd-1+ipr)*cen(ipr:icd-1+
 ipr,1))*&
    1140           exs(i,:icd)
    1141         ewcy(i,:icd) = (ex(i)*cen(i,2)+ex(ipr:icd-1+ipr)*cen(ipr:icd-1+
 ipr,2))*&
    1142           exs(i,:icd)
    1143         ewcz(i,:icd) = (ex(i)*cen(i,3)+ex(ipr:icd-1+ipr)*cen(ipr:icd-1+
 ipr,3))*&
    1144           exs(i,:icd)
    1145       end do
    1146       do i = 1, npr
    1147         do j = 1, icd
    1148           expn(i,j) = exp((-ce(i,j)*td(i)))
    1149           rnai(i,j) = (pi*exs(i,j))**1.5D0*expn(i,j)
    1150           expn(i,j) = rnai(i,j)
    1151         end do
    1152       end do
    1153 !
    1154 !     CALCULATE (S||P) ESP INTEGRALS
    1155 !
 
 FORCHECK PC V13.5.13           OVLP           2021-03-24 10:59:30   page:  3240
 esp.F90  /FF
 
    1156       if (iam(ipr,1)==0 .and. is_esp/=ip) then
    1157         np = is_esp + 1
    1158         do i = np, npr
    1159           do j = 1, icd
    1160             select case (iam(i,2))
    1161             case default
    1162               rnai(i,j) = (ewcx(i,j)-cen(i,1))*expn(i,j)
    1163             case (2)
    1164               rnai(i,j) = (ewcy(i,j)-cen(i,2))*expn(i,j)
    1165             case (3)
    1166               rnai(i,j) = (ewcz(i,j)-cen(i,3))*expn(i,j)
    1167             end select
    1168           end do
    1169         end do
    1170       end if
    1171 !
    1172 !     CALCULATE (P||S) ESP INTEGRALS
    1173 !
    1174       if (iam(ipr,1)==1 .and. is_esp/=ip) then
    1175         np = is_esp + 1
    1176         do i = istart, npr
    1177           do j = 1, icd
    1178             select case (iam(ipr+j-1,2))
    1179             case default
    1180               rnai(i,j) = (ewcx(i,j)-cen(ipr+j-1,1))*expn(i,j)
    1181             case (2)
    1182               rnai(i,j) = (ewcy(i,j)-cen(ipr+j-1,2))*expn(i,j)
    1183             case (3)
    1184               rnai(i,j) = (ewcz(i,j)-cen(ipr+j-1,3))*expn(i,j)
    1185             end select
    1186           end do
    1187         end do
    1188         do i = istart, npr
    1189           do j = 1, icd
    1190             select case (iam(i,2))
    1191             case default
    1192               rnai(i,j) = (ewcx(i,j)-cen(i,1))*rnai(i,j)
    1193               if (iam(ipr+j-1,2) == iam(i,2)) rnai(i,j) = rnai(i,j) + e
 xs(i,j)*&
    1194                 0.5D0*expn(i,j)
    1195             case (2)
    1196               rnai(i,j) = (ewcy(i,j)-cen(i,2))*rnai(i,j)
    1197               if (iam(ipr+j-1,2) == iam(i,2)) rnai(i,j) = rnai(i,j) + e
 xs(i,j)*&
    1198                 0.5D0*expn(i,j)
    1199             case (3)
    1200               rnai(i,j) = (ewcz(i,j)-cen(i,3))*rnai(i,j)
    1201               if (iam(ipr+j-1,2) == iam(i,2)) rnai(i,j) = rnai(i,j) + e
 xs(i,j)*&
    1202                 0.5D0*expn(i,j)
    1203             end select
    1204           end do
    1205         end do
    1206       end if
    1207       ips = ic*icd - icd + 1
    1208       do i = ic, ncc
    1209         jps = i*icd - icd + 1
    1210         ovl(ic,i) = 0.D0
    1211         do j = jps, jps + icd - 1
 
 FORCHECK PC V13.5.13           OVLP           2021-03-24 10:59:30   page:  3241
 esp.F90  /FF
 
    1212           ovl(ic,i) = ovl(ic,i) + sum(cc(j)*cc(ips:icd-1+ips)*rnai(j,:i
 cd))
    1213         end do
    1214         ovl(i,ic) = ovl(ic,i)
    1215       end do
    1216       return
    1217       end subroutine ovlp
 
 FORCHECK PC V13.5.13           OVLP           2021-03-24 10:59:30   page:  3242
 esp.F90  /FF


