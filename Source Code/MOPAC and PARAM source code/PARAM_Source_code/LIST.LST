     222                 padi(ij+1:jl-jf+1+ij) = pa(k+1:jl-jf+1+k)
     223                 pbdi(ij+1:jl-jf+1+ij) = pb(k+1:jl-jf+1+k)
     224                 pdi(ij+1:jl-jf+1+ij) = p(k+1:jl-jf+1+k)
     225                 ij = jl - jf + 1 + ij
 
 FORCHECK PC V13.5.13          DCART           2021-03-24 10:59:30   page:  4152
 dcart.F90  /FF
 
     226               end if
