     102         do k = if, il
     103           ii = (k*(k - 1))/2
     104           do j = 1, im1
     105             jf = nfirst(j)
     106             jl = nlast(j)
     107             bj = betas(nat(j))
     108 !  THE  +1.D-14 IS TO PREVENT POSSIBLE ERRORS IN THE DIAGONALIZATION.
     109             ij = ii + jf
 
 FORCHECK PC V13.5.13          MULLIK          2021-03-24 10:59:30   page:  3645
 mullik.F90  /FF
 
     110             h(ij) = 2.D0*h(ij)/(bi + bj) + 1.D-14
     111             store(ij) = h(ij)
     112             bj = betap(nat(j))
     113             bj = betap(nat(j))
     114             h(ii+jf+1:jl+ii) = 2.D0*h(ii+jf+1:jl+ii)/(bi + bj) + 1.D-14
     115 !  THE  +1.D-14 IS TO PREVENT POSSIBLE ERRORS IN THE DIAGONALIZATION.
     116             store(ii+jf+1:jl+ii) = h(ii+jf+1:jl+ii)
     117           end do
     118           store(ii+if:k+ii) = 0.D0
     119           h(ii+if:k+ii) = 0.D0
     120           bi = betap(nat(i))
     121         end do
     122       end do
     123       store(ifact(2:norbs+1)) = 1.D0
     124       h(ifact(2:norbs+1)) = 1.D0
     125       call rsp (h, norbs, eig, vecs)
     126       do i = 1, norbs
     127         eig(i) = 1.D0/sqrt(abs(eig(i)))
     128       end do
     129       if (.not. allocated(work)) allocate(work(norbs,norbs))
     130       ij = 0
     131       do i = 1, norbs
     132         do j = 1, i
     133           ij = ij + 1
     134           sum = 0.D0
     135           do k = 1, norbs
     136             sum = sum + vecs(i+(k-1)*norbs)*eig(k)*vecs(j+(k-1)*norbs)
     137           end do
     138           work(i,j) = sum
     139           work(j,i) = sum
     140         end do
     141       end do
     142       if (graph) then
     143         if (graph_formatted) then
