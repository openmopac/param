    1270   subroutine get_legendre (n_max, x, pmn)
    1271     !
    1272     !       Computes array of Legendre functions
    1273     !
    1274
    1275     !
    1276     !.. Implicit Declarations ..
    1277     implicit none
    1278     !
    1279     !.. Formal Arguments ..
    1280     integer, intent (in) :: n_max
    1281     double precision, intent (inout) :: x
    1282     double precision, intent (out), dimension(-n_max:n_max, 0:n_max) ::
  pmn
    1283
    1284     !
    1285     !.. Local Scalars ..
    1286     double precision :: x2, t, s, s1
    1287     integer :: n, m
    1288     !
    1289     !.. Intrinsic Functions ..
    1290     intrinsic Sqrt, Dble
    1291     !
    1292     ! ... Executable Statements ...
    1293
    1294     x2 = x**2
    1295     if (x2 >= 1.d0) then
    1296       if (x > 0) then
    1297         x = 1.d0
    1298       else
    1299         x = -1.d0
    1300       end if
    1301       x2 = 1.d0
    1302       t = 0.d0
    1303     else
    1304       t = Sqrt (1.d0 - x2)
    1305     end if
    1306
    1307     pmn(0, 0) = 1.d0
    1308     pmn(0, 1) = x
    1309     pmn(1, 1) = -t
    1310     pmn(0, 2) = 0.5d0 * (3.d0*x2 - 1.d0)
    1311     pmn(1, 2) = -3.d0*x*t
    1312     pmn(2, 2) = 3.d0*t*t
    1313
    1314     s = pmn(2, 2)
    1315     do n = 3, n_max
    1316       s = s * (2*n - 1) * t
    1317       pmn(n, n) = s * (-1)**n
    1318     end do
    1319
    1320     do n = 3, n_max
    1321       do m = n-1, 0, -1
    1322         s = 1.d0 / (Dble(n-m))
    1323         s1 = x*(2*n-1)*pmn(m, n-1)
    1324         if (m <= n-2) then
    1325           s1 = s1 - (n+m-1)*pmn(m, n-2)
    1326         end if
 
 FORCHECK PC V13.5.13       GET_LEGENDRE       2021-03-24 10:59:30   page:  1147
 afmm_mod.F90  /FF
 
    1327         pmn(m, n) = s1 * s
    1328       end do
    1329     end do
    1330
    1331     do n = 1, n_max
    1332       do m = 1, n
    1333         pmn(-m, n) = pmn(m, n)
    1334       end do
    1335     end do
    1336
    1337   end subroutine get_legendre
 
