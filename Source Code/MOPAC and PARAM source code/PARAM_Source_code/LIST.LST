     622       double precision function wrdkey (keywrd, key, nk, refkey, nr, de
 f)
     623 !-----------------------------------------------
     624 !   M o d u l e s
     625 !-----------------------------------------------
     626 !-----------------------------------------------
     627 !   I n t e r f a c e   B l o c k s
     628 !-----------------------------------------------
     629       implicit none
     630 !-----------------------------------------------
     631 !   D u m m y   A r g u m e n t s
     632 !-----------------------------------------------
     633       integer , intent(in) :: nk
     634       integer , intent(in) :: nr
     635       double precision , intent(in) :: def
     636       character  :: keywrd*241
     637       character , intent(in) :: key*(*)
     638       character , intent(in) :: refkey*(*)
     639 !-----------------------------------------------
     640 !   L o c a l   V a r i a b l e s
     641 !-----------------------------------------------
     642       integer :: i, j, k
     643       double precision, external :: reada
     644 !-----------------------------------------------
     645 !**********************************************************************
 *
     646 !
     647 !   WRDKEY is a way to assign values using keywords.  If the keyword is
     648 !          present, it is used, otherwise the default is used.
     649 !
     650 !   Format:
     651 !          KEY    =  Start of keyword
     652 !          NK     =  Number of characters in (start of keyword)
     653 !          REFKEY =  Variable in keyword
     654 !          NR     =  Number of characters in (variable in keyword)
     655 !
     656 !   For example, if call is WRDKEY(KEYWRD,'VDW(',4,':ZN',3,1.5D0)
     657 !   then if VWD(:ZN=1.4) exists, WRDKEY will be 1.4, otherwise 1.5
     658 !   Note: the "=" and ")" are not necessary, but make the line easier
     659 !   to read.
     660 !**********************************************************************
 *
     661       i = index(keywrd,key(:nk))
     662       if (i /= 0) then
     663         j = index(keywrd(i:),') ')
     664         k = index(keywrd(i:i+j),refkey(:nr))
     665         if (k /= 0) then
     666           wrdkey = reada(keywrd,i + k)
     667         else
     668           wrdkey = def
     669         end if
     670       else
     671         wrdkey = def
     672       end if
     673       return
     674       end function wrdkey
 
