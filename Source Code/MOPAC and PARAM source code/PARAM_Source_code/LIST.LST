     768       subroutine mepchg(co, potpt, nmep)
     769 !-----------------------------------------------
     770 !   M o d u l e s
     771 !-----------------------------------------------
     772       USE common_arrays_C, only : ch, p, nat => nat
     773       USE elemts_C, only : elemnt
     774       use chanel_C, only : iw
     775       use molkst_C, only : keywrd, ux, uy, uz, numat, mpack, &
     776       mxmep => itemp_1
     777       use funcon_C, only : fpc_9, a0, fpc_1, fpc_8, ev
     778 !**********************************************************************
     779 !  MEPCHG CALCULATES THE MEP CHARGES BY FITTING THE QUANTUM POTENTIAL
     780 !  TO THE COULOMB POTENTIAL.
     781 !  REF.  B. WANG AND G.P.FORD J.COMPT.CHEM. IN PRESS.
     782 !        G.P.FORD AND B. WANG J.COMPT.CHEM. 14(1993)1101.
     783 !                                       BINGZE WANG ON 19 AUGUST 1993
     784 !**********************************************************************
     785 !-----------------------------------------------
     786 !   I n t e r f a c e   B l o c k s
     787 !-----------------------------------------------
     788       implicit none
     789 !-----------------------------------------------
     790 !   G l o b a l   P a r a m e t e r s
     791 !-----------------------------------------------
     792 !-----------------------------------------------
     793 !   D u m m y   A r g u m e n t s
     794 !-----------------------------------------------
     795       integer , intent(in) :: nmep
     796       double precision  :: co(3,*)
     797       double precision  :: potpt(3,*)
     798       double precision  :: al(1000)
     799       double precision  :: a(numat + 4,numat + 4)
     800       double precision  :: d(numat,nmep)
     801       double precision  :: d1(numat,nmep)
     802       logical       :: cequiv(numat,numat)
     803 !-----------------------------------------------
     804 !   L o c a l   V a r i a b l e s
     805 !-----------------------------------------------
     806       integer :: iz, numat0, k, i, nonzo, ip, j, l, ieq
     807       double precision, dimension(numat) :: q
     808       double precision, dimension(mxmep) :: ep
     809       double precision, dimension(numat + 4) :: b
     810       double precision, dimension(mpack) :: pp
     811       double precision, dimension(numat) :: qsc, qq
     812       double precision :: rms, rrms, dipx, dipy, dipz, au, cf, bohr1, a
 u1, dx&
     813         , dy, dz, xk, yk, zk, xp, yp, zp, dki, ui, ajk, det,qi, epc, ep
 i, dip
     814       logical :: idip
     815 ! For Mopac BLAS
     816       double precision, external :: ddot, reada
     817 !
     818
     819 !-----------------------------------------------
     820       iz = 0
     821       rms = 0.0D0
     822       rrms = 0.0D0
     823       dipx = 0.0D0
 
 FORCHECK PC V13.5.13          MEPCHG          2021-03-24 10:59:30   page:  3046
 pmep.F90  /FF
 
     824       dipy = 0.0D0
     825       dipz = 0.0D0
     826       dx = 0.d0
     827       dy = 0.d0
     828       dz = 0.d0
     829       idip = .FALSE.
     830       au = ev*fpc_9
     831 !     cf = 5.2917715D0*1.601917D0/3.33564D0
     832       cf = fpc_1*a0*fpc_8*1.D-10
     833       bohr1 = 1.0D0/a0
     834       au1 = 1.0D0/au
     835       numat0 = numat + 1
     836 !
     837       write (iw, 10)
     838    10 format(/,/,1x,'ATOMIC CHARGES DERIVED FROM MOLECULAR',&
     839         ' ELECTROSTATIC POTENTIAL')
     840       if (index(keywrd,' WILLIAMS') /= 0) then
     841         write (iw, '(8X,''(WILLIAMS SURFACES)''/)')
     842       else
     843         write (iw, '(8X,''(CONNOLLY SURFACES)''/)')
     844       end if
     845 !
     846       if (index(keywrd,' CHARGE=') /= 0) iz = nint(reada(keywrd,index(k
 eywrd,&
     847         ' CHARGE=')))
     848 !                                                  DIPOLAR CONSTRAINTS
     849       if (index(keywrd,'DIPOLE') /= 0) then
     850         if (iz == 0) then
     851           idip = .TRUE.
     852           numat0 = numat + 4
     853           write (iw, '(/12X,''DIPOLE CONSTRAINTS WILL BE USED'',/)')
     854           dx = ux
     855           dy = uy
     856           dz = uz
     857           if (index(keywrd,'DIPX=') /= 0) dx = reada(keywrd,index(keywr
 d,&
     858             'DIPX='))
     859           if (index(keywrd,'DIPY=') /= 0) dy = reada(keywrd,index(keywr
 d,&
     860             'DIPY='))
     861           if (index(keywrd,'DIPZ=') /= 0) dz = reada(keywrd,index(keywr
 d,&
     862             'DIPZ='))
     863         else
     864           write (iw, *) ' DIPOLE CONSTRAINTS NOT USED FOR CHARGED MOLEC
 ULE'
     865         end if
     866       end if
     867       do k = 1, numat
     868         xk = co(1,k)
     869         yk = co(2,k)
     870         zk = co(3,k)
     871         do i = 1, nmep
     872           xp = potpt(1,i) - xk
     873           yp = potpt(2,i) - yk
     874           zp = potpt(3,i) - zk
     875           dki = sqrt(xp*xp + yp*yp + zp*zp)
     876           d(k,i) = dki
     877           d1(k,i) = a0/dki
 
 FORCHECK PC V13.5.13          MEPCHG          2021-03-24 10:59:30   page:  3047
 pmep.F90  /FF
 
     878         end do
     879       end do
     880 !
     881 !******  SET UP THE LINEAR EQUATION A*Q=B  *******
     882 !                                       MEP AT SAMPLE POINTS & B MATRIX
     883       call packp (p, pp, nonzo)
     884       b(:numat) = 0.0D0
     885       do ip = 1, nmep
     886         call pmepco (pp, d(1,ip), potpt(1,ip), ui, co, nonzo, 1)
     887         ep(ip) = ui*au1
     888         b(:numat) = b(:numat) + ep(ip)*d1(:numat,ip)
     889       end do
     890       b(numat+1) = dble(iz)
     891       if (idip) then
     892         b(numat+2) = dx/cf
     893         b(numat+3) = dy/cf
     894         b(numat+4) = dz/cf
     895       end if
     896 !                                                      THE A(J,K) ARRAY
     897       do k = 1, numat
     898         do j = 1, k
     899           ajk = 0.0D0
     900           ajk = sum(d1(k,:nmep)*d1(j,:nmep))
     901           a(k,j) = ajk
     902           a(j,k) = ajk
     903         end do
     904         a(numat+1,k) = 1.D0
     905         a(k,numat+1) = 1.D0
     906         if (.not.idip) cycle
     907         a(numat+2,k) = co(1,k)*bohr1
     908         a(numat+3,k) = co(2,k)*bohr1
     909         a(numat+4,k) = co(3,k)*bohr1
     910         a(k,numat+2) = a(numat+2,k)
     911         a(k,numat+3) = a(numat+3,k)
     912         a(k,numat+4) = a(numat+4,k)
     913       end do
     914       a(numat+1,numat+1) = 0.D0
     915       if (idip) then
     916         a(numat+2,numat+2) = 0.D0
     917         a(numat+3,numat+3) = 0.D0
     918         a(numat+4,numat+4) = 0.D0
     919       end if
     920 !                                                            SOLVE AQ=B
     921       l = 0
     922       do i = 1, numat0
     923         al(l+1:numat0+l) = a(i,:numat0)
     924         l = numat0 + l
     925       end do
     926       call osinv (al, numat0, det)
     927       l = 0
     928       do i = 1, numat
     929         qi = 0.0D0
     930         if (numat0 > 0) then
     931           qi = sum(al(l+1:numat0+l)*b(:numat0))
     932           l = numat0 + l
     933         end if
     934         q(i) = qi
     935       end do
     936       qi = det ! dummy use of det
 
 FORCHECK PC V13.5.13          MEPCHG          2021-03-24 10:59:30   page:  3048
 pmep.F90  /FF
 
     937 !                               AVERAGE CHARGES EQUIVALENT BY SYMMETRY
     938       if (index(keywrd,'SYMAVG') /= 0) then
     939         do i = 1, numat
     940           do j = 1, numat
     941             cequiv(i,j) = .FALSE.
     942             if (abs(abs(ch(i))-abs(ch(j))) >= 1.D-5) cycle
     943             cequiv(i,j) = .TRUE.
     944           end do
     945         end do
     946         do i = 1, numat
     947           ieq = 0
     948           qsc(i) = 0.D0
     949           do j = 1, numat
     950             if (.not.cequiv(i,j)) cycle
     951             qsc(i) = qsc(i) + abs(q(j))
     952             ieq = ieq + 1
     953           end do
     954           qq(i) = q(i)/abs(q(i))*qsc(i)/ieq
     955         end do
     956         q(:numat) = qq(:numat)
     957       end if
     958 !                              ROOT MEAN SQUARE (RMS) AND RELATIVE RMS
     959       do i = 1, nmep
     960         epi = ep(i)
     961         epc = sum(q(:numat)*d1(:numat,i))
     962         epc = epc - epi
     963         rms = rms + epc*epc
     964         rrms = rrms + epi*epi
     965       end do
     966       rms = sqrt(rms/nmep)
     967       rrms = rms/sqrt(rrms/nmep)
     968       rms = rms*au
     969 !
     970       write (iw, '(3X,''ATOM NO.    TYPE    CHARGE'')')
     971       do i = 1, numat
     972         write (iw, '(5X,I2,9X,A2,1X,F10.4)') i, elemnt(nat(i)), q(i)
     973       end do
     974 !
     975       write (iw, '(/2X,A,4X,I6)') 'NUMBER OF POINTS ', nmep
     976       write (iw, '(2X,A,4X,F9.4)') 'RMS DEVIATION ', rms
     977       write (iw, '(2X,A,3X,F9.4)') 'RRMS DEVIATION ', rrms
     978 !
     979       if (iz /= 0) return
     980 !                                    DIPOLE MOMENT FOR NEUTRAL MOLECULE
     981       dipx = dipx + ddot(numat,co(1,:numat),1,q(:numat),1)
     982       dipy = dipy + ddot(numat,co(2,:numat),1,q(:numat),1)
     983       dipz = dipz + ddot(numat,co(3,:numat),1,q(:numat),1)
     984       dipx = dipx*bohr1
     985       dipy = dipy*bohr1
     986       dipz = dipz*bohr1
     987       dip = sqrt(dipx*dipx + dipy*dipy + dipz*dipz)
     988       write (iw, '(2/1X,''DIPOLE MOMENT EVALUATED FROM THE MEP CHARGES'
 ')')
