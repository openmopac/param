       1       subroutine dfpsav(totime, xparam, gd, xlast, funct1, mdfp, xdfp)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE ef_C, ONLY: alparm, x0, x1, x2, iloop
       6       USE maps_C, only : rxn_coord, latom, kloop
       7       use common_arrays_C, only : na, geo, geoa, grad, hesinv, profil
       8       USE molkst_C, ONLY: natoms, numcal, nvar, keywrd, mozyme, koment,
  title, norbs, numat, &
       9         prt_gradients
      10       USE chanel_C, only : iw, ires, restart_fn
      11 !**********************************************************************
 *
      12 !-----------------------------------------------
      13 !   I n t e r f a c e   B l o c k s
      14 !-----------------------------------------------
      15       implicit none
      16 !-----------------------------------------------
      17 !   G l o b a l   P a r a m e t e r s
      18 !-----------------------------------------------
      19 !-----------------------------------------------
      20 !   D u m m y   A r g u m e n t s
      21 !-----------------------------------------------
      22       double precision  :: totime
      23       double precision  :: funct1
      24       integer  :: mdfp(9)
      25       double precision  :: xparam(nvar)
      26       double precision  :: gd(nvar)
      27       double precision  :: xlast(nvar)
      28       double precision  :: xdfp(9)
      29 !-----------------------------------------------
      30 !   L o c a l   P a r a m e t e r s
      31 !-----------------------------------------------
      32 !-----------------------------------------------
      33 !   L o c a l   V a r i a b l e s
      34 !-----------------------------------------------
      35       integer :: icalcn, i, j, linear, old_numat, old_norbs
      36       logical :: first, opend
      37
      38       save first, icalcn
      39 !-----------------------------------------------
      40 !*********************************************************************
      41 !
      42 ! DFPSAV STORES AND RESTORES DATA USED IN THE D-F-P GEOMETRY
      43 !        OPTIMISATION.
      44 !
      45 !  ON INPUT TOTIME = TOTAL JOB TIME ELAPSED DURING THE CALCULATION.
      46 !           XPARAM = CURRENT VALUE OF PARAMETERS.
      47 !           GD     = OLD GRADIENT.
      48 !           XLAST  = OLD VALUE OF PARAMETERS.
      49 !           FUNCT1 = CURRENT VALUE OF HEAT OF FORMATION.
      50 !           MDFP   = INTEGER CONSTANTS USED IN D-F-P.
      51 !           XDFP   = REAL CONSTANTS USED IN D-F-P.
      52 !           MDFP(9)= 1 FOR DUMP, 0 FOR RESTORE.
      53 !*********************************************************************
      54       data icalcn/ 0/
      55       first = icalcn /= numcal
      56       if (first) icalcn = numcal
 
 FORCHECK PC V13.5.13          DFPSAV          2021-03-24 10:59:30   page:  3589
 dfpsav.F90  /FF
 
      57       inquire(unit=ires, opened=opend)
      58       if (opend) close(unit=ires, status='KEEP')
      59       open(unit=ires, file=restart_fn, status='UNKNOWN', form=&
      60         'UNFORMATTED', position='asis')
      61       rewind ires
      62       if (mdfp(9) /= 0) then
      63         if (mdfp(9) == 1) then
      64           write (iw, &
      65       '(2/10X,''- - - - - - - TIME UP - - - - - - -'',2/)')
      66           if (index(keywrd,'SADDLE') /= 0) then
      67             write (iw, &
      68       '(2/10X,'' NO RESTART EXISTS FOR SADDLE'',2/      10X, &
      69       & '' HERE IS A DATA-FILE FILES THAT MIGHT BE SUITABLE'',/ &
      70       & 10X,'' FOR RESTARTING THE CALCULATION'',3/)')
      71             write (iw, '(A)') keywrd, koment, title
      72             do iloop = 1, 2
      73               call geout ((-iw))
      74               geo(:,:natoms) = geoa(:,:natoms)
      75               na = 0
      76             end do
      77             write (iw, '(3/10X,''CALCULATION TERMINATED HERE'')')
      78             call mopend ('NO RESTART EXISTS FOR SADDLE. ')
      79             return
      80           end if
      81           write (iw, &
      82       '(2/10X,'' - THE CALCULATION IS BEING DUMPED TO DISK'',/10X, &
      83       & ''   RESTART IT USING THE KEYWORD "RESTART"'')')
      84           if (index(keywrd,'STEP1') == 0) then
      85             write (iw, &
      86               '(2/10X,''CURRENT VALUE OF HEAT OF FORMATION ='',F12.6)')
  funct1
      87             if (prt_gradients .and. index(keywrd," GRADI") /= 0 .and. m
 ozyme) then
      88               write (iw, '(3/7X,''CURRENT  POINT  AND  DERIVATIVES'',/)
 ')
      89               call prtgra ()
      90             end if
      91             if (mdfp(9) == 1) call geout (iw)
      92           end if
      93         end if
      94         write (ires) norbs, numat, (xparam(i),i=1,nvar), (gd(i),i=1,nva
 r)
      95         write (ires) mdfp, xdfp, totime, funct1
      96         write (ires) (xlast(i),i=1,nvar), (grad(i),i=1,nvar)
