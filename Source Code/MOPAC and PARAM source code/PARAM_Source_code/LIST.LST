       1 subroutine mbonds (locc, lvir, f, catom, nfirst, ii, jj, ui, uj, lok, i
 orbs, &
       2      & cocc, cvir, cocc_dim, cvir_dim, numat, norbs, morb, mpack1)
       3     use chanel_C, only: iw
       4     use molkst_C, only: nelecs
       5     implicit none
       6     logical, intent (out) :: lok
       7     integer, intent (in) :: ii, jj, locc, lvir, morb, mpack1, cocc_dim,
  &
       8          & cvir_dim, norbs, numat
       9     logical, dimension (*), intent (inout) :: ui, uj
      10     integer, dimension (numat), intent (in) :: iorbs, nfirst
      11     double precision, dimension (mpack1), intent (in) :: f
      12     double precision, dimension (cocc_dim), intent (inout) :: cocc
      13     double precision, dimension (cvir_dim), intent (inout) :: cvir
      14     double precision, dimension (morb, norbs), intent (in) :: catom
      15 !
      16     logical :: ok
      17     integer :: nocc, nvir
      18     integer :: i, i1 = 0, i2 = 0, iorbsi, iorbsj, j, j1 = 0, j2 = 0, k,
  l, m, ni, nj
      19     double precision :: alpha, beta, d, e, e11, e111, e12, e22, e221, o
 ne, &
      20    & sum, summax, summin
      21     integer, external :: ijbo
      22     lok = .false.
      23    !
      24    !   Four cases: Both light, one light and one heavy,
      25    !               one heavy and one light, and both heavy
      26    !
      27     iorbsi = iorbs(ii)
      28     iorbsj = iorbs(jj)
      29    !
      30     ni = nfirst(ii) - 1
      31     nj = nfirst(jj) - 1
      32     summin = 0.d0
      33     summax = -1.d5
      34     ok = .false.
      35     do i = 1, iorbsi
      36       if ( .not. ui(i)) then
      37         do j = 1, iorbsj
      38           if ( .not. uj(j)) then
      39             ok = .true.
      40             sum = 0.d0
      41             l = ijbo (ii, jj)
      42             do m = 1, iorbsj
      43               do k = 1, iorbsi
      44                 l = l + 1
      45                 sum = sum + catom(k, i+ni) * f(l) * catom(m, j+nj)
      46               end do
      47             end do
      48             if (sum < summin) then
      49               i1 = i
      50               j1 = j
      51               summin = sum
      52             end if
      53             if (sum > summax) then
      54               i2 = i
 
 FORCHECK PC V13.5.13          MBONDS          2021-03-24 10:59:30   page:   257
 mbonds.F90  /FF
 
      55               j2 = j
      56               summax = sum
      57             end if
      58           end if
      59         end do
      60       end if
      61     end do
      62     if ( .not. ok) return
      63     lok = .true.
      64     k = 0
      65     do i = 1, iorbsi
      66       if (ui(i)) k = k + 1
      67     end do
      68     do i = 1, iorbsj
      69       if (uj(i)) k = k + 1
      70     end do
      71    !
      72     if ((locc + iorbsi + iorbsj - k) > cocc_dim .or. &
      73       & (lvir + iorbsi + iorbsj - k) > cvir_dim) then
      74       nocc = Max (1, nelecs/2)
      75       nvir = Max (1, norbs - nocc)
      76       write (iw, "(A,I3,A)") " THIS FAULT CAN PROBABLY BE " // &
      77      & "CORRECTED BY USE OF KEYWORD 'NLMO=", &
      78      & Max (Nint (Real (locc + iorbsi + iorbsj - k) / Real (nocc) &
      79           &     * Real (numat) / Real (norbs)), &
      80           & Nint (Real (lvir + iorbsi + iorbsj - k) / Real (nvir) &
      81           &     * Real (numat) / Real (norbs))), "'"
      82       write (iw,*)
      83       call mopend ("VALUE OF NLMO IS TOO SMALL")
      84       return
      85     end if
      86    !
      87    !   'best' hybrid pair is I1 and J1
      88    !
      89    !  Now form LCAO for the two hybrid orbitals
      90    !
      91     if (summax >-summin) then
      92       i1 = i2
      93       j1 = j2
      94       one = -1.d0
      95       e12 = -summax
      96     else
      97       one = 1.d0
      98       e12 = summin
      99     end if
     100     e11 = 0.d0
     101     e111 = 0.d0
     102     l = ijbo (ii, ii)
     103     do i = 1, iorbsi
     104       do j = 1, i - 1
     105         l = l + 1
     106         e111 = e111 + catom(i, ni+i1) * f(l) * catom(j, ni+i1)
     107       end do
     108       l = l + 1
     109       e11 = e11 + catom(i, ni+i1) * f(l) * catom(i, ni+i1)
     110     end do
     111     e11 = e11 + e111 * 2.d0
     112     l = ijbo (jj, jj)
     113     e22 = 0.d0
 
 FORCHECK PC V13.5.13          MBONDS          2021-03-24 10:59:30   page:   258
 mbonds.F90  /FF
 
     114     e221 = 0.d0
     115     do i = 1, iorbsj
     116       do j = 1, i - 1
     117         l = l + 1
     118         e221 = e221 + catom(i, nj+j1) * f(l) * catom(j, nj+j1)
     119       end do
     120       l = l + 1
     121       e22 = e22 + catom(i, nj+j1) * f(l) * catom(i, nj+j1)
     122     end do
     123     e22 = e22 + e221 * 2.d0
     124     d = e11 - e22
     125     e = Sign (Sqrt(4.d0*e12*e12+d*d), d)
     126     alpha = Min (0.866d0, Max (Sqrt(0.5d0*(1.d0+d/e)), 0.5d0))
     127     beta = -Sign (Sqrt(1.d0-alpha*alpha), e12)
     128     do i = 1, iorbsi
     129     if (locc + i == 1225)then
     130       alpha = alpha
     131     end if
     132       cocc(locc+i) = catom(i, ni+i1) * alpha
     133       cvir(lvir+i) = catom(i, ni+i1) * beta
     134     end do
     135     do i = 1, Min(iorbsj, Min(cocc_dim -locc -iorbsi, cvir_dim -lvir -i
 orbsi))
     136       cocc(locc+iorbsi+i) = catom(i, nj+j1) * beta * one
     137       cvir(lvir+iorbsi+i) = -catom(i, nj+j1) * alpha * one
     138     end do
     139     ui(i1) = .true.
     140     uj(j1) = .true.
     141 end subroutine mbonds
 
