    1911 !  jj is the number of oxygen atoms that are not bonded to another atom
    1912 !
    1913                 if (jj > nbonds(ii) - 2) then
    1914                   nH = 1
    1915                   angle = 150.d0
    1916                   dihedral = 0.d0
    1917                 end if
    1918               else
    1919                 hybrid(icc) = 3
    1920               end if
    1921             else
    1922               hybrid(icc) = 3
    1923             end if
    1924           else
    1925             hybrid(icc) = 2
    1926           end if
