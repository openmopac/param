       1     subroutine fock2(f, ptot, p, w, wj, wk, numat, nfirst, nlast, mode)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use molkst_C, only : numcal, norbs, mpack, n2elec, id, numat_ref
 => numat
       6       use cosmo_C, only : useps
       7
       8 !**********************************************************************
 *
       9 !-----------------------------------------------
      10 !   I n t e r f a c e   B l o c k s
      11 !-----------------------------------------------
      12       implicit none
      13 !-----------------------------------------------
      14 !   D u m m y   A r g u m e n t s
      15 !-----------------------------------------------
      16       integer  :: numat, mode
      17       integer  :: nfirst(numat_ref)
      18       integer  :: nlast(numat_ref)
      19       double precision  :: f(mpack)
      20       double precision , intent(in) :: ptot(mpack)
      21       double precision  :: p(mpack)
      22       double precision  :: w(n2elec)
      23       double precision , intent(in) :: wj(n2elec)
      24       double precision , intent(in) :: wk(n2elec)
      25
      26
      27 !-----------------------------------------------
      28 !   L o c a l   P a r a m e t e r s
      29 !-----------------------------------------------
      30 !-----------------------------------------------
      31 !   L o c a l   V a r i a b l e s
      32 !-----------------------------------------------
      33       integer , dimension(:), allocatable :: ifact, i1fact
      34       double precision, dimension(:,:), allocatable  :: ptot2
      35       integer :: ione, icalcn
      36       integer , dimension(256) :: jindex
      37       integer :: i, m, j, ij, ji, k, ik, l, kl, lk, jl, i1, ia, ib, jk,
  kj, kk&
      38         , ii, iminus, jj, ja, jb, ll, j1, ka, kb, kc, il
      39       double precision, dimension(81) :: pk
      40       double precision, dimension(16) :: pja, pjb
      41       double precision :: sumdia, sumoff, sum, aa, bb, aj, ak, a
      42       logical :: lid, deriv
      43
      44       save ifact, i1fact, ione, lid, icalcn, jindex, ptot2
      45 !-----------------------------------------------
      46 !**********************************************************************
 *
      47 !
      48 ! FOCK2 FORMS THE TWO-ELECTRON TWO-CENTER REPULSION PART OF THE FOCK
      49 ! MATRIX
      50 ! ON INPUT  PTOT = TOTAL DENSITY MATRIX.
      51 !           P    = ALPHA OR BETA DENSITY MATRIX.
      52 !           W    = TWO-ELECTRON INTEGRAL MATRIX.
      53 !
      54 !  ON OUTPUT F   = PARTIAL FOCK MATRIX
 
 FORCHECK PC V13.5.13          FOCK2           2021-03-24 10:59:30   page:  4418
 fock2.F90  /FF
 
      55 !**********************************************************************
 *
      56       data icalcn/ 0/
      57       deriv = (numat < 0)
      58       numat = abs(numat)
      59       if (numat == 0) then
      60         if (allocated(ptot2))  deallocate(ptot2)
      61         if (allocated(ifact))  deallocate(ifact)
      62         if (allocated(i1fact)) deallocate(i1fact)
      63          return
      64       end if
      65       if (icalcn /= numcal) then
      66         if (allocated(ptot2))  deallocate(ptot2)
      67         if (allocated(ifact))  deallocate(ifact)
      68         if (allocated(i1fact)) deallocate(i1fact)
      69         allocate(ptot2(numat,81), ifact(3 + norbs), i1fact(3 + norbs))
      70         icalcn = numcal
      71 !
      72 !   SET UP ARRAY OF LOWER HALF TRIANGLE INDICES (PASCAL'S TRIANGLE)
      73 !
      74         do i = 1, norbs
      75           ifact(i) = (i*(i - 1))/2
      76           i1fact(i) = ifact(i) + i
      77         end do
      78 !
      79 !   SET UP GATHER-SCATTER TYPE ARRAYS FOR USE WITH TWO-ELECTRON
      80 !   INTEGRALS.  JINDEX ARE THE INDICES OF THE J-INTEGRALS FOR ATOM I
      81 !   INTEGRALS.  JJNDEX ARE THE INDICES OF THE J-INTEGRALS FOR ATOM J
      82 !               KINDEX ARE THE INDICES OF THE K-INTEGRALS
      83 !
      84         m = 0
      85         do i = 1, 4
      86           do j = 1, 4
      87             ij = min(i,j)
      88             ji = i + j - ij
      89             do k = 1, 4
      90               ik = min(i,k)
      91               do l = 1, 4
      92                 m = m + 1
      93                 kl = min(k,l)
      94                 lk = k + l - kl
      95                 jl = min(j,l)
      96                 jindex(m) = (ifact(ji)+ij)*10 + ifact(lk) + kl - 10
      97               end do
      98             end do
      99           end do
     100         end do
     101         l = 0
     102         do i = 1, 4
     103           i1 = (i - 1)*4
     104           if (i > 0) then
     105             l = i + l
     106           end if
     107         end do
     108         lid = id == 0
     109         ione = 1
     110         if (id /= 0) ione = 0
     111 !
     112 !      END OF INITIALIZATION
 
 FORCHECK PC V13.5.13          FOCK2           2021-03-24 10:59:30   page:  4419
 fock2.F90  /FF
 
     113 !
     114       end if
     115 !
     116 !     START OF MNDO, AM1, OR PM3 OPTION
     117 !
     118       l = 0
     119       do i = 1, numat
     120         ia = nfirst(i)
     121         ib = nlast(i)
     122         m = 0
     123         do j = ia, ib
     124           do k = ia, ib
     125             m = m + 1
     126             jk = min(j,k)
     127             kj = k + j - jk
     128             jk = jk + (kj*(kj - 1))/2
     129             ptot2(i,m) = ptot(jk)
     130           end do
     131         end do
     132       end do
     133       kk = 0
     134       do ii = 1, numat
     135         ia = nfirst(ii)
     136         ib = nlast(ii)
     137 !
     138 !  IF NUMAT=2 THEN WE ARE IN A DERIVATIVE IN A SOLID STATE OR IN A MOLE
 CULE CALCULATION
     139 !
     140         if (deriv) then
     141           iminus = ii - 1
     142         else
     143           iminus = ii - ione
     144         end if
     145         do jj = 1, iminus
     146           ja = nfirst(jj)
     147           jb = nlast(jj)
     148           if (lid) then    !  System does not use periodic boundary con
 ditions
     149             if (ib - ia >= 6 .or. jb - ja >= 6) then
     150               call fockdorbs(ia, ib, ja, jb, f, p, ptot, w, kk, ifact)
     151
     152             else if (ib - ia >= 3 .and. jb - ja >= 3) then
     153 !
     154 !                         HEAVY-ATOM  - HEAVY-ATOM
     155 !
     156 !   EXTRACT COULOMB TERMS
     157 !
     158               pja = ptot2(ii,:16)
     159               pjb = ptot2(jj,:16)
     160 !
     161 !  COULOMB TERMS
     162 !
     163               call jab (ia, ja, pja, pjb, w(kk+1), f)
     164 !
     165 !  EXCHANGE TERMS
     166 !
     167 !
     168 !  EXTRACT INTERSECTION OF ATOMS II AND JJ IN THE SPIN DENSITY MATRIX
     169 !
 
 FORCHECK PC V13.5.13          FOCK2           2021-03-24 10:59:30   page:  4420
 fock2.F90  /FF
 
     170 !  The following loop had been written in a more compact style, but
     171 !  this had caused problems with the INTEL compiler in RELEASE mode whe
 n QuickWin was used
     172 !
     173               l = 1
     174               do i = ia, ib
     175                 i1 = ifact(i) + ja
     176                 do j = l, l + 3
     177                   pk(j) = p(i1)
     178                   i1 = i1 + 1
     179                 end do
     180                 l = 4 + l
     181               end do
     182               call kab (ia, ja, pk, w(kk+1), f)
     183               kk = kk + 100
     184             else if (ib - ia >= 3 .and. ja == jb) then
     185 !
     186 !                         LIGHT-ATOM  - HEAVY-ATOM
     187 !
     188 !
     189 !   COULOMB TERMS
     190 !
     191               sumdia = 0.D0
     192               sumoff = 0.D0
     193               ll = i1fact(ja)
     194               k = 0
     195               do i = 0, 3
     196                 j1 = ifact(ia+i) + ia - 1
     197                 if (i > 0) then
     198                   do j = 1, i
     199                     f(j+j1) = f(j+j1) + ptot(ll)*w(j+kk+k)
     200                     sumoff = sumoff + ptot(j+j1)*w(j+kk+k)
     201                   end do
     202                   k = i + k
     203                   j1 = i + j1
     204                 end if
     205                 j1 = j1 + 1
     206                 k = k + 1
     207                 f(j1) = f(j1) + ptot(ll)*w(kk+k)
     208                 sumdia = sumdia + ptot(j1)*w(kk+k)
     209               end do
     210               f(ll) = f(ll) + sumoff*2.D0 + sumdia
     211 !
     212 !  EXCHANGE TERMS
     213 !
     214 !
     215 !  EXTRACT INTERSECTION OF ATOMS II AND JJ IN THE SPIN DENSITY MATRIX
     216 !
     217               k = 0
     218               do i = ia, ib
     219                 i1 = ifact(i) + ja
     220                 sum = 0.D0
     221                 do j = 1, ib - ia + 1
     222                   sum = sum + p(ifact(j-1+ia)+ja)*w(kk+jindex(j+k))
     223                 end do
     224                 k = ib - ia + 1 + k
     225                 f(i1) = f(i1) - sum
     226               end do
     227               kk = kk + 10
 
 FORCHECK PC V13.5.13          FOCK2           2021-03-24 10:59:30   page:  4421
 fock2.F90  /FF
 
     228             else if (jb - ja >= 3 .and. ia == ib) then
     229 !
     230 !                         HEAVY-ATOM - LIGHT-ATOM
     231 !
     232 !
     233 !   COULOMB TERMS
     234 !
     235               sumdia = 0.D0
     236               sumoff = 0.D0
     237               ll = i1fact(ia)
     238               k = 0
     239               do i = 0, 3
     240                 j1 = ifact(ja+i) + ja - 1
     241                 if (i > 0) then
     242                   do j = 1, i
     243                     f(j+j1) = f(j+j1) + ptot(ll)*w(j+kk+k)
     244                     sumoff = sumoff + ptot(j+j1)*w(j+kk+k)
     245                   end do
     246                   k = i + k
     247                   j1 = i + j1
     248                 end if
     249                 j1 = j1 + 1
     250                 k = k + 1
     251                 f(j1) = f(j1) + ptot(ll)*w(kk+k)
     252                 sumdia = sumdia + ptot(j1)*w(kk+k)
     253               end do
     254               f(ll) = f(ll) + sumoff*2.D0 + sumdia
     255 !
     256 !  EXCHANGE TERMS
     257 !
     258 !
     259 !  EXTRACT INTERSECTION OF ATOMS II AND JJ IN THE SPIN DENSITY MATRIX
     260 !
     261               k = ifact(ia) + ja
     262               j = 0
     263               do i = k, k + 3
     264                 sum = 0.D0
     265                 do l = 1, 4
     266                   sum = sum + p(l-1+k)*w(kk+jindex(l+j))
     267                 end do
     268                 j = 4 + j
     269                 f(i) = f(i) - sum
     270               end do
     271               kk = kk + 10
     272             else if (jb == ja .and. ia == ib) then
     273 !
     274 !                         LIGHT-ATOM - LIGHT-ATOM
     275 !
     276               i1 = i1fact(ia)
     277               j1 = i1fact(ja)
     278               ij = i1 + ja - ia
     279               f(i1) = f(i1) + ptot(j1)*w(kk+1)
     280               f(j1) = f(j1) + ptot(i1)*w(kk+1)
     281               f(ij) = f(ij) - p(ij)*w(kk+1)
     282               kk = kk + 1
     283             end if
     284           else
     285             do i = ia, ib
     286               ka = ifact(i)
 
 FORCHECK PC V13.5.13          FOCK2           2021-03-24 10:59:30   page:  4422
 fock2.F90  /FF
 
     287               do j = ia, i
     288                 kb = ifact(j)
     289                 ij = ka + j
     290                 aa = 2.0D00
     291                 if (i == j) aa = 1.0D00
     292                 do k = ja, jb
     293                   kc = ifact(k)
     294                   if (i >= k) then
     295                     ik = ka + k
     296                   else
     297                     ik = 0
     298                   end if
     299                   if (j >= k) then
     300                     jk = kb + k
     301                   else
     302                     jk = 0
     303                   end if
     304                   do l = ja, k
     305                     if (i >= l) then
     306                       il = ka + l
     307                     else
     308                       il = 0
     309                     end if
     310                     if (j >= l) then
     311                       jl = kb + l
     312                     else
     313                       jl = 0
     314                     end if
     315                     kl = kc + l
     316                     bb = 2.0D00
     317                     if (k == l) bb = 1.0D00
     318                     kk = kk + 1
     319                     aj = wj(kk)
     320                     ak = wk(kk)
     321 !
     322 !     A  IS THE REPULSION INTEGRAL (I,J/K,L) WHERE ORBITALS I AND J ARE
     323 !     ON ATOM II, AND ORBITALS K AND L ARE ON ATOM JJ.
     324 !     AA AND BB ARE CORRECTION FACTORS SINCE
     325 !     (I,J/K,L)=(J,I/K,L)=(I,J/L,K)=(J,I/L,K)
     326 !     IJ IS THE LOCATION OF THE MATRIX ELEMENTS BETWEEN ATOMIB ORBITALS
     327 !     I AND J.  SIMILARLY FOR IK ETC.
     328 !
     329 ! THIS FORMS THE TWO-ELECTRON TWO-CENTER REPULSION PART OF THE FOCK
     330 ! MATRIX.  THE CODE HERE IS HARD TO FOLLOW, AND IMPOSSIBLE TO MODIFY!,
     331 ! BUT IT WORKS,
     332                     if (kl > ij) cycle
     333                     if (i == k .and. aa + bb < 2.1D0) then
     334                       f(ij) = f(ij) + aj*ptot(kl)
     335                     else
     336                       f(ij) = f(ij) + bb*aj*ptot(kl)
     337                       f(kl) = f(kl) + aa*aj*ptot(ij)
     338                       a = ak*aa*bb*0.25D0
     339                       if (jl > 0) f(ik) = f(ik) - a*p(jl)
     340                       if (jk > 0) f(il) = f(il) - a*p(jk)
     341                       if (jk > 0) f(jk) = f(jk) - a*p(il)
     342                       if (jl > 0) f(jl) = f(jl) - a*p(ik)
     343                     end if
     344                   end do
     345                 end do
 
 FORCHECK PC V13.5.13          FOCK2           2021-03-24 10:59:30   page:  4423
 fock2.F90  /FF
 
     346               end do
     347             end do
     348           end if
     349         end do
     350         if (mode == 2) then
     351           i = ((ib - ia + 1)*(ib - ia + 2))/2
     352           call fock1(f, ptot, p, mpack, w(kk+1), kk, ia, ib, i)
     353         end if
     354       end do
     355       if (useps) then
     356         call addfck (f,ptot)
     357       end if
     358       return
     359     end subroutine fock2
 
