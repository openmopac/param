     436           hblist(i, 7) = hblist(i, 5)
     437           hblist(i, 8) = hblist(i, 5)
     438       end if
     439     else
     440       hbs2_ok = .false.
     441     end if
     442   end do
     443 ! check for problems
     444   if ( .not. hbs1_ok .or. .not. hbs2_ok ) then
     445 !
 
 FORCHECK PC V13.5.13      SETUP_DH_PLUS       2021-03-24 10:59:30   page:   588
 Hydrogen_bond_corrections.F90  /FF
 
     446 !  No hydrogen bonds found
     447 !
     448     l_h_bonds = .false.
     449   end if
     450 end subroutine setup_DH_Plus
 
