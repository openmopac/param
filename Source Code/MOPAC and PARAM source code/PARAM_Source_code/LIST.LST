       1   subroutine txtype (jj, jtype, letter)
       2 !
       3 !  Construct the Greek letter for each atom using
       4 !  the PDB convention.  The letter will go in character 15
       5 !  of the entries in array "txtatm"  If there is also a number,
       6 !  it will go in character 16.
       7 !
       8     use common_arrays_C, only : txtatm, nat, nbonds, ibonds
       9     implicit none
      10     character, intent (in) :: letter
      11     integer, intent (inout) :: jj
      12     integer, dimension (jj), intent (inout) :: jtype
      13 !
      14     integer :: i, j, k, loop, m
      15    !
      16    !   Remove any duplicates from JTYPE
      17    !
      18     j = 1
      19     outer_loop: do i = 2, jj
      20       do k = 1, j
      21         if (jtype(k) == jtype(i)) cycle outer_loop
      22       end do
      23       j = j + 1
      24       jtype(j) = jtype(i)
      25     end do outer_loop
      26     jj = j
      27     do loop = 1, 4
      28       m = 0
      29       do i = 1, jj
      30         if (nat(jtype(i)) /= 1) then
      31           m = m + 1
      32           k = i
      33         end if
      34       end do
      35       !
      36       !   Make symbol for atom.  Greek letter goes in 15:15
      37       !                            and number goes in 16:16
      38       !
      39       if (m == 1) then
      40         txtatm (jtype(k)) (15:15) = letter
      41         j = jtype(k)
      42         m = 0
      43         do i = 1, nbonds(j)
      44           if (txtatm(ibonds(i, j)) (16:16) /= " ") then
      45             txtatm(j) (16:16) = txtatm(ibonds(i, j)) (16:16)
      46             m = m + 1
      47           end if
      48         end do
      49         if (m /= 1) then
      50           txtatm (j) (16:16) = " "
      51         end if
      52         if (txtatm(j)(18:20) == "TRP" .and. letter == "H") then
      53           txtatm (j) (16:16) = "2"
      54         end if
      55       else
      56         m = 0
      57 !
      58 !  Special case: Tryptophan zeta starts with 2, not 1
 
 FORCHECK PC V13.5.13          TXTYPE          2021-03-24 10:59:30   page:  1584
 txtype.F90  /FF
 
      59 !
      60         if (txtatm(j)(18:20) == "TRP" .and. letter == "Z") m = 1
      61         do i = 1, jj
      62           j = jtype(i)
      63           if (nat(jtype(i)) /= 1) then
      64             m = m + 1
      65             txtatm(j) (15:15) = letter
      66             if (txtatm(j)(18:20) /= "UNK" .or. txtatm (j) (16:16) == "
 " &
      67               .or. txtatm (j) (16:16) > Char (min(9,m)+Ichar ("0"))) th
 en
      68               txtatm (j) (16:16) = Char (min(9,m)+Ichar ("0"))
      69             end if
      70           end if
      71         end do
      72       end if
      73     end do
      74 end subroutine txtype
 
