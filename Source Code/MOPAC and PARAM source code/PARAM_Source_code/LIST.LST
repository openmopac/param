       1       subroutine pmep()
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use common_arrays_C, only : nat, geo, &
       6       & coord
       7       USE molkst_C, only : numat, keywrd, moperr, mxmep => itemp_1
       8       USE chanel_C, only : iw, mep_fn, imep
       9 !**********************************************************************
 *
      10 !  THIS IS A DRIVING ROUTINE FOR COMPUTATIONS OF PMEP - PARAMETRIC
      11 !  MOLECULAR ELECTROSTATIC POTENTIAL AS WELL AS  MEP CHARGES.
      12 !
      13 !  REF.  B. WANG AND G.P.FORD J.COMPT.CHEM. IN PRESS.
      14 !        G.P.FORD AND B. WANG J.COMPT.CHEM. 14(1993)1101.
      15 !
      16 !                               WRITTEN BY BINGZE WANG, AUGUST 1993
      17 !**********************************************************************
 *
      18 !**********************************************************************
 *
      19 !-----------------------------------------------
      20 !   I n t e r f a c e   B l o c k s
      21 !-----------------------------------------------
      22       implicit none
      23 !-----------------------------------------------
      24 !   L o c a l   V a r i a b l e s
      25 !-----------------------------------------------
      26       integer ::  nmep, i
      27       double precision, dimension(3,numat*50 + 1000) :: potpt
      28       double precision, dimension(107) :: alpw
      29       double precision :: t1
      30       double precision, external :: seconds
      31 !-----------------------------------------------
      32       data alpw/ 2.92D0, 4*0.0D0, 4.36D0, 6.95D0, 9.22D0, 5.53D0, 0.0D0
 , 4*&
      33         0.0D0, 2.3D0, 2.6D0, 3.32D0, 17*0.0D0, 3.32D0, 72*0.0D0/
      34       data nmep/ 0/
      35 !                                                 CHECK FOR SAVING TIME
      36       if (index(keywrd,' AM1') /= 0) then
      37         do i = 1, numat
      38           if (alpw(nat(i)) < 0.1D0) go to 30
      39         end do
      40 !
      41         t1 = seconds(1)
      42 !
      43         call gmetry (geo, coord)
      44         if (moperr) return
      45 !                                              ***** CALCULATE MEP ONLY
      46         if (index(keywrd,' PMEP') /= 0) then
      47           open(unit=imep, file=mep_fn, status='UNKNOWN', position=&
      48             'asis')
      49           call mepmap (coord)
      50           if (moperr) return
      51           go to 20
      52         end if
      53          mxmep = 50*numat + 1000
      54 !                         ***** CHOOSE SURFACE WHERE POINTS ARE SAMPLED
 
 FORCHECK PC V13.5.13           PMEP           2021-03-24 10:59:30   page:  3019
 pmep.F90  /FF
 
      55 !
      56         if (index(keywrd,'WILLIAMS') /= 0) then
      57 !                                                  THE WILLIAMS SURFACE
      58           call grids (coord, potpt, nmep)
      59           if (moperr) return
      60         else
      61 !                                                  THE CONNOLLY SURFACE
      62           call surfa (coord, potpt, nmep)
      63           if (moperr) return
      64         end if
      65 !                                           ***** CALCULATE MEP CHARGES
      66         call mepchg (coord, potpt, nmep)
      67 !
      68    20   continue
      69         t1 = seconds(1) - t1
      70         write (iw, '(/1X,A,F9.2,A)') 'TIME TO CALCULATE MEP', t1, ' SEC
 ONDS'
      71         return
      72       end if
      73    30 continue
      74       write (iw, *) ' AM1 PARAMETERS FOR H,C,N,F AND CL ARE AVAILABLE.'
 , &
      75         '  PMEP WAS NOT EXECUTED'
      76       return
      77       end subroutine pmep
 
