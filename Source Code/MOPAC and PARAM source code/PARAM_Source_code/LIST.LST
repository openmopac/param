    1862       subroutine bmakuf(ua, ub, uab, t, uold1, gab, eigs, last, norbs,
 nclose, &
    1863         diff, iwflb, maxu, btol)
    1864 !-----------------------------------------------
    1865 !   M o d u l e s
    1866 !-----------------------------------------------
    1867       use funcon_C, only : ev
    1868       USE polar_C, only : omega
    1869       implicit none
    1870 !-----------------------------------------------
    1871 !   D u m m y   A r g u m e n t s
    1872 !-----------------------------------------------
    1873       integer , intent(in) :: norbs
    1874       integer , intent(in) :: nclose
    1875       integer , intent(in) :: iwflb
    1876       double precision , intent(out) :: diff
    1877       double precision , intent(out) :: maxu
    1878       double precision , intent(in) :: btol
    1879       logical , intent(out) :: last
    1880       double precision , intent(in) :: ua(norbs,norbs)
    1881       double precision , intent(in) :: ub(norbs,norbs)
    1882       double precision , intent(inout) :: uab(norbs,norbs)
    1883       double precision , intent(in) :: t(norbs,norbs)
    1884       double precision , intent(inout) :: uold1(norbs,norbs)
    1885       double precision , intent(in) :: gab(norbs,norbs)
    1886       double precision , intent(in) :: eigs(norbs)
    1887 !-----------------------------------------------
    1888 !   L o c a l   V a r i a b l e s
    1889 !-----------------------------------------------
    1890       integer :: i, j, kll, kul, k, l
    1891       double precision :: hartr, sum, udif
    1892 !-----------------------------------------------
    1893 !
    1894 !  THIS SUBROUTINE CREATES THE NEW TRANSFORMATION MATRIX U
    1895 !  AND THEN CHECKS FOR CONVERGENCE
    1896 !
    1897       hartr = ev
    1898 !
    1899 !  ZERO MATRIX INITIALLY
    1900 !      CALL ZEROM(UAB,NORBS)
    1901 !
    1902 !  CREATE DIAGONAL BLOCKS (OCC,OCC) AND (UNOCC,UNOCC)
    1903 !
    1904       kll = 0
    1905       kul = 0
    1906       do i = 1, norbs
    1907         do j = 1, i
    1908           sum = 0.0D00
    1909           if (i <= nclose) then
    1910             kll = nclose + 1
    1911             kul = norbs
    1912           else if (i>nclose .and. j>nclose) then
    1913             kll = 1
    1914             kul = nclose
    1915           end if
    1916           do k = kll, kul
    1917             sum = sum + ua(i,k)*ub(k,j) + ub(i,k)*ua(k,j)
    1918           end do
 
 FORCHECK PC V13.5.13          BMAKUF          2021-03-24 10:59:30   page:  2615
 polar.F90  /FF
 
    1919           uab(i,j) = sum*0.5D00
    1920           uab(j,i) = sum*0.5D00
    1921         end do
    1922       end do
    1923 !
    1924 !  CREATE OFF-DIAGONAL BLOCKS
    1925 !
    1926       do k = nclose + 1, norbs
    1927         do l = 1, nclose
    1928           select case (iwflb)
    1929 ! CALCULATE FOR (W,W) VALUES
    1930 !
    1931           case default
    1932             uab(k,l) = hartr*((gab(k,l)+t(k,l))/((eigs(l)-eigs(k))-2.0D
 00*omega&
    1933               ))
    1934             uab(l,k) = hartr*((gab(l,k)+t(l,k))/((eigs(k)-eigs(l))-2.0D
 00*omega&
    1935               ))
    1936 ! CALCULATE FOR (0,W) VALUES
    1937 !
    1938           case (2)
    1939             uab(k,l) = hartr*((gab(k,l)+t(k,l))/((eigs(l)-eigs(k))-omeg
 a))
    1940             uab(l,k) = hartr*((gab(l,k)+t(l,k))/((eigs(k)-eigs(l))-omeg
 a))
    1941 ! CALCULATE FOR (W,-W) VALUES
    1942 !
    1943           case (3)
    1944             uab(k,l) = hartr*((gab(k,l)+t(k,l))/(eigs(l)-eigs(k)))
    1945             uab(l,k) = hartr*((gab(l,k)+t(l,k))/(eigs(k)-eigs(l)))
    1946           end select
    1947         end do
    1948       end do
    1949 !
    1950 !  CHECK FOR CONVERGENCE
    1951 !
    1952       diff = 0.0D00
    1953       maxu = -1000
    1954       do i = 1, norbs
    1955         do j = 1, norbs
    1956           udif = uab(i,j) - uold1(i,j)
    1957           diff = dmax1(abs(udif),diff)
    1958           maxu = dmax1(uab(i,j),maxu)
    1959         end do
    1960       end do
    1961       if (diff < btol) last = .TRUE.
    1962 !
    1963       uold1 = uab
    1964 !
    1965       return
    1966       end subroutine bmakuf
 
