     433       subroutine transf(f, g, c, norb)
     434 !-----------------------------------------------
     435 !   M o d u l e s
     436 !-----------------------------------------------
     437       use molkst_C, only : norbs
     438 !**********************************************************************
 *
     439       implicit none
     440 !-----------------------------------------------
     441 !   D u m m y   A r g u m e n t s
     442 !-----------------------------------------------
     443       integer , intent(in) :: norb
     444       double precision , intent(in) :: f(norb,norb)
     445       double precision , intent(out) :: g(norb,norb)
     446       double precision , intent(in) :: c(norb,norb)
     447 !-----------------------------------------------
     448 !   L o c a l   P a r a m e t e r s
     449 !-----------------------------------------------
     450 !-----------------------------------------------
     451 !   L o c a l   V a r i a b l e s
     452 !-----------------------------------------------
     453       integer :: i, j
     454       double precision, dimension(norbs) :: work
     455       double precision :: term, term2
     456 !-----------------------------------------------
     457 !
     458 !  THIS SUBROUTINE FORMS THE G MATRIX BY TRANSFORMING F WITH C
     459 !
     460 !
     461       do i = 1, norb
     462         do j = 1, norb
     463           term = 0.0D00
     464           term = sum(f(j,:)*c(:,i))
     465           work(j) = term
     466         end do
     467         do j = 1, norb
     468           term2 = 0.0D00
     469           term2 = sum(work(:norb)*c(:,j))
     470           g(j,i) = term2
     471         end do
     472       end do
     473       return
     474       end subroutine transf
 
