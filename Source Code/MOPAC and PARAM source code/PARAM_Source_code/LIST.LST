    1954   subroutine bp_dir_int (ind1, n1, ind2, n2, c, nc, q, r, same)
    1955     !
    1956     ! Computes part of the B*q product for near surface elements
    1957     !
    1958
    1959     use common_arrays_C, only: nfirst, nlast, nat, p
    1960     use cosmo_C, only : cosurf
    1961     use parameters_C, only: tore
    1962
    1963     !
    1964     !.. Implicit Declarations ..
    1965     implicit none
    1966     !
    1967     !.. Formal Arguments ..
    1968     integer, intent(in) :: n1, n2, nc
    1969     integer, intent(in), dimension(*) :: ind1, ind2
    1970     double precision, intent(in), dimension(nc, *) :: c
    1971     double precision, intent(in), dimension(*) :: q
    1972     double precision, intent(inout), dimension(*) :: r
    1973     logical, intent(in) :: same
    1974     !
    1975     !.. Local Scalars ..
    1976     integer :: i3, j3, ii, i, j, jj, k, l, m, nao
    1977     double precision :: t
    1978     !
    1979     !.. Local Arrays ..
    1980     double precision :: w(45)
    1981     !
    1982     ! ... Executable Statements ...
    1983 !
    1984 ! Dummy statement to "use" q
    1985 !
    1986     t = q(1)
    1987     if(same) then         ! --- points vs. atoms in the same box
