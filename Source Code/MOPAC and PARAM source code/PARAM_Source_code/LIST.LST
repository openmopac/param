    1353       subroutine rotmat(nj, ni, coordi, coordj, r)
    1354 !-----------------------------------------------
    1355 !   M o d u l e s
    1356 !-----------------------------------------------
    1357       use parameters_C, only : dorbs
    1358       use mndod_C, only : sp, pp, sd, dp, d_d
    1359 !     *
    1360 !     ROTATION MATRIX FOR A GIVEN ATOM PAIR I-J (I.GT.J).
    1361 !     *
    1362       implicit none
    1363 !-----------------------------------------------
    1364 !   D u m m y   A r g u m e n t s
    1365 !-----------------------------------------------
    1366       integer , intent(in) :: nj
    1367       integer , intent(in) :: ni
    1368       double precision , intent(out) :: r
    1369       double precision , intent(in) :: coordi(3)
    1370       double precision , intent(in) :: coordj(3)
    1371 !-----------------------------------------------
    1372 !   L o c a l   P a r a m e t e r s
    1373 !-----------------------------------------------
    1374       double precision, parameter :: small = 1.0D-07
    1375       double precision, parameter :: pt5sq3 = 0.8660254037841D0
    1376 !-----------------------------------------------
    1377 !   L o c a l   V a r i a b l e s
    1378 !-----------------------------------------------
    1379       integer :: k
    1380       double precision, dimension(3,3) :: p
    1381       double precision, dimension(5,5) :: d
    1382       double precision :: x11, x22, x33, b, sqb, sb, ca, sa, cb, c2a, c
 2b, s2a, s2b
    1383 !-----------------------------------------------
    1384 ! *** CALCULATE GEOMETRIC DATA AND INTERATOMIC DISTANCE.
    1385 !     CA  = COS(PHI)    , SA  = SIN(PHI)
    1386 !     CB  = COS(THETA)  , SB  = SIN(THETA)
    1387 !     C2A = COS(2*PHI)  , S2A = SIN(2*PHI)
    1388 !     C2B = COS(2*THETA), S2B = SIN(2*PHI)
    1389       x11 = coordj(1) - coordi(1)
    1390       x22 = coordj(2) - coordi(2)
    1391       x33 = coordj(3) - coordi(3)
    1392       b = x11*x11 + x22*x22
    1393       r = sqrt(b + x33*x33)
    1394       sqb = sqrt(b)
    1395       sb = sqb/r
    1396 !     CHECK FOR SPECIAL CASE (BOTH ATOMS ON Z AXIS).
    1397       if (sb > small) then
    1398         ca = x11/sqb
    1399         sa = x22/sqb
    1400         cb = x33/r
    1401       else
    1402         sa = 0.d0
    1403         sb = 0.d0
    1404         if (x33 < 0.d0) then
    1405           ca = -1.d0
    1406           cb = -1.d0
    1407         else if (x33 > 0.d0) then
    1408           ca = 1.d0
    1409           cb = 1.d0
 
 FORCHECK PC V13.5.13          ROTMAT          2021-03-24 10:59:30   page:  1472
 mndod.F90  /FF
 
    1410         else
    1411           ca = 0.d0
    1412           cb = 0.d0
    1413         end if
    1414       end if
    1415 !     CONVERT DISTANCE TO ATOMIC UNITS.
    1416 !#      R      = R/A0
    1417 ! *** CALCULATE ROTATION MATRIX ELEMENTS.
    1418       p(1,1) = ca*sb
    1419       p(2,1) = ca*cb
    1420       p(3,1) = -sa
    1421       p(1,2) = sa*sb
    1422       p(2,2) = sa*cb
    1423       p(3,2) = ca
    1424       p(1,3) = cb
    1425       p(2,3) = -sb
    1426       p(3,3) = 0.d0
    1427       if (dorbs(ni) .or. dorbs(nj)) then
    1428         c2a = 2.d0*ca*ca - 1.d0
    1429         c2b = 2.d0*cb*cb - 1.d0
    1430         s2a = 2.d0*sa*ca
    1431         s2b = 2.d0*sb*cb
    1432         d(1,1) = pt5sq3*c2a*sb*sb
    1433         d(2,1) = 0.5d0*c2a*s2b
    1434         d(3,1) = -s2a*sb
    1435         d(4,1) = c2a*(cb*cb + 0.5d0*sb*sb)
    1436         d(5,1) = -s2a*cb
    1437         d(1,2) = pt5sq3*ca*s2b
    1438         d(2,2) = ca*c2b
    1439         d(3,2) = -sa*cb
    1440         d(4,2) = -0.5d0*ca*s2b
    1441         d(5,2) = sa*sb
    1442         d(1,3) = cb*cb - 0.5d0*sb*sb
    1443         d(2,3) = -pt5sq3*s2b
    1444         d(3,3) = 0.d0
    1445         d(4,3) = pt5sq3*sb*sb
    1446         d(5,3) = 0.d0
    1447         d(1,4) = pt5sq3*sa*s2b
    1448         d(2,4) = sa*c2b
    1449         d(3,4) = ca*cb
    1450         d(4,4) = -0.5d0*sa*s2b
    1451         d(5,4) = -ca*sb
