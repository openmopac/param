 N_qm, 3*N_qm ), &
     511       dEtadQb( 3*N_qm, 3*N_qm )
     512 !
     513 !  Local variables
     514 !
     515     double precision :: X(3, 3), Xa(3, 3), Xb(3, 3), Za, dZadQa, Zb, dZ
 bdQb, Rab(3)
