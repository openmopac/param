 enpart.F90  /FF
 
     339               aa = 2.0d0
     340               if (i == j) then
     341                 aa = 1.0d0
     342               end if
     343               pij = (pa(ij)+pb(ij))
     344               k3 = 0
     345               do k = ja, jb
     346                 k3 = k3 + 1
     347                 kc = (k*(k-1)) / 2
     348                 ik = ka + k
     349                 jk = kb + k
     350                 l3 = 0
     351                 do l = ja, k
     352                   l3 = l3 + 1
     353                   il = ka + l
     354                   jl = kb + l
     355                   kl = kc + l
     356                   bb = 2.0d0
     357                   if (k == l) then
     358                     bb = 1.0d0
     359                   end if
     360                   kk = kk + 1
     361                   g = w(kk)
     362                   e(n, 4) = e(n, 4) + aa * bb * g * pij * &
     363                  & (pa(kl)+pb(kl))
     364                   ex(n, 1) = ex(n, 1) - 0.5d0 * aa * bb * g * &
     365                  & (pa(ik)*pa(jl)+pa(il)*pa(jk)+pb(ik)*pb(jl)+&
     366                  & pb(il)*pb(jk))
     367                 end do
     368               end do
     369             end do
     370           end do
     371         end do
     372         kk = kk + (((ib-ia+1)*(ib-ia+2))/2) ** 2
     373         n = n + 1
     374       end do
     375       numat1 = (numat*(numat + 1))/2
     376       e(numat1,:) = 0.0D0
     377       ex(numat1,:) = 0.0D0
     378 !@ --------------------------*
     379 !-----PRINT OUT ONE AND TWO CENTER ENERGIES
