    1245   !
    1246   !======================= The end of active ==========================
 ===
    1247     subroutine bmv (m, sy, wt, col, v, p, info)
    1248       implicit none
    1249       integer, intent (in) :: col, m
    1250       integer, intent (inout) :: info
    1251       double precision, dimension (2*col), intent (in) :: v
    1252       double precision, dimension (2*col), intent (inout) :: p
    1253       double precision, dimension (m, m), intent (in) :: sy
    1254       double precision, dimension (m, m), intent (inout) :: wt
    1255       integer :: i, i2, k
    1256       double precision :: sum
    1257       if (col == 0) return
    1258     !     PART I: solve [  D^(1/2)      O ] [ p1 ] = [ v1 ]
    1259     !                   [ -L*D^(-1/2)   J ] [ p2 ]   [ v2 ].
    1260     !
    1261     !       solve Jp2=v2+LD^(-1)v1.
    1262       p(col+1) = v(col+1)
    1263       do i = 2, col
    1264         i2 = col + i
    1265         sum = 0.0d0
    1266         do k = 1, i - 1
    1267           sum = sum + sy(i, k) * v(k) / sy(k, k)
    1268         end do
    1269         p(i2) = v(i2) + sum
    1270       end do
    1271     !     Solve the triangular system
    1272       call dtrsl (wt, m, col, p(col+1), 11, info)
    1273       if (info /= 0) return
    1274     !       solve D^(1/2)p1=v1.
    1275       do i = 1, col
    1276         p(i) = v(i) / Sqrt (sy(i, i))
    1277       end do
    1278     !     PART II: solve [ -D^(1/2)   D^(-1/2)*L'  ] [ p1 ] = [ p1 ]
    1279     !                    [  0         J'           ] [ p2 ]   [ p2 ].
    1280     !       solve J^Tp2=p2.
    1281       call dtrsl (wt, m, col, p(col+1), 1, info)
    1282       if (info /= 0) return
    1283     !       compute p1=-D^(-1/2)(p1-D^(-1/2)L'p2)
    1284     !                 =-D^(-1/2)p1+D^(-1)L'p2.
    1285       do i = 1, col
    1286         p(i) = -p(i) / Sqrt (sy(i, i))
    1287       end do
    1288       do i = 1, col
    1289         sum = 0.d0
    1290         do k = i + 1, col
    1291           sum = sum + sy(k, i) * p(col+k) / sy(i, i)
    1292         end do
    1293         p(i) = p(i) + sum
    1294       end do
    1295     !
    1296     end subroutine bmv
 
