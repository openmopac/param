      46 !   ON INPUT UHF     = .TRUE. IF A U.H.F. CALCULATION.
      47 !            H       = ONE-ELECTRON MATRIX.
      48 !            pa      = ALPHA ELECTRON DENSITY.
      49 !            pb      = BETA ELECTRON DENSITY.
      50 !            P       = TOTAL ELECTRON DENSITY.
      51 !            Q       = ATOM ELECTRON DENSITIES.
      52 !
 
