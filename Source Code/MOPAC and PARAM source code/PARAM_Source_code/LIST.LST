       1 subroutine findn1 (n1, ioptl, io, delta_res)
       2 !**********************************************************************
       3 !
       4 !  Locate the nitrogen atom of a peptide linkage.
       5 !
       6 !  On input, ioptl is a logical array of atoms which might contain a
       7 !  peptide linkage.
       8 !
       9 !  On output:
      10 !
      11 !  n1 is the atom-number of the nitrogen atom of the peptide
      12 !  or zero, if a nitrogen could not be found.
      13 !
      14 !  io is the oxygen of the "C=O" of the peptide linkage.
      15 !
      16 !  delta_res is the change in residue number caused by moving along
      17 !  the chain to the N end.  This is normally zero.
      18 !
      19 !**********************************************************************
      20
      21     use molkst_C, only: numat, isok
      22     use common_arrays_C, only : nat, nbonds, ibonds
      23     implicit none
      24     integer, intent (out) :: n1, io, delta_res
      25     logical, dimension (numat), intent (in) :: ioptl
      26     logical :: peptide, is_ring, ok = .true.
      27 !
      28     integer :: i, iatom, ii, ires_loc, j, k, l, jj, kk, ll, mm, last_n1
      29     logical, external :: ring_6
      30     integer, external :: nheavy
      31     save :: ok
      32 !
      33     n1 = 0
      34     delta_res = 0
      35     last_n1 = 0
      36 !
      37 !   FIND A N-C-C=O SYSTEM
      38 !
      39     outer_loop: do iatom = 1, numat
      40       if ( .not. ioptl(iatom)) then
      41 !
      42 !   START WITH OXYGEN OF C=O
      43 !
      44         if (nat(iatom) == 8 .and. nbonds(iatom) == 1) then
      45           do i = 1, nbonds(iatom)
      46             if (nat(ibonds(i, iatom)) == 6) then
      47 !
      48 !    THERE IS A CARBON ATTACHED TO THE OXYGEN
      49 !
      50               l = ibonds(i, iatom)
      51       loop_k: do k = 1, nbonds(l)
      52                 if (nat(ibonds(k, l)) == 6) then
      53 !
      54 !  THERE IS A CARBON ATTACHED TO THE CARBON ATTACHED
      55 !  TO THE OXYGEN
      56 !
      57                   j = ibonds(k, l)
      58                   if (nheavy(j) == 4) cycle loop_k
 
 FORCHECK PC V13.5.13          FINDN1          2021-03-24 10:59:30   page:  1232
 findn1.F90  /FF
 
      59                   if (j == 4159) then
      60                    j = j
      61                    end if
      62 !
      63 ! Make sure that C(alpha) is not part of a six-membered ring
      64 !
      65                   do jj = 1, nbonds(j)
      66                     kk = ibonds(jj,j)
      67                     if (kk /= l) then
      68                       if (ring_6(j, l, kk)) cycle loop_k
      69                     end if
      70                     if (nat(kk) /= 6 .and. nat(kk) /= 1 .and. nat(kk) /
 =7) cycle loop_k
      71                   end do
      72                   do ii = 1, nbonds(j)
      73                     if (nheavy(ibonds(ii, j)) < 4 .and. nat(ibonds(ii,
 j)) == 7 .and. .not. ioptl(ibonds(ii, j))) then
      74
      75 !
      76 !  THERE IS A NITROGEN ATTACHED TO THE CARBON ATTACHED TO THE
      77 !  CARBON ATTACHED TO THE OXYGEN
      78 !
      79 !
      80 !   YES, A PEPTIDE LINKAGE HAS BEEN FOUND.
      81 !   THE NITROGEN IS N1
      82 !
      83                       n1 = ibonds(ii, j)
      84 !
      85 !  Make sure it's not part of a ring
      86 !
      87                       is_ring = .false.
      88                       do jj = 1, nbonds(n1)
      89                         kk = ibonds(jj,n1)
      90                         do ll = 1, nbonds(n1)
      91                           mm = ibonds(ll,n1)
      92                           if (nat(kk) > 1 .and. nat(mm) > 1 .and. kk >
 mm) then
      93                             if (ring_6(n1, mm, kk)) is_ring = .true.
      94                           end if
      95                         end do
      96                       end do
      97                       if ( is_ring) then
      98                         n1 = 0
      99                       else
     100                         n1 = n1
     101                         exit outer_loop
     102                       end if
     103                     end if
     104                   end do
     105                 end if
     106               end do loop_k
     107             end if
     108           end do
     109         end if
     110       end if
     111     end do outer_loop
     112     io = iatom
     113     if (n1 == 0) return
     114 !
 
 FORCHECK PC V13.5.13          FINDN1          2021-03-24 10:59:30   page:  1233
 findn1.F90  /FF
 
     115 !  N1 IS A NITROGEN IN AN O=C-C-N SYSTEMS.
     116 !
     117     if (nat(n1) == 7) last_n1 = n1
     118     j = 0
     119     do i = 1, nbonds(n1)
     120       if (nat(ibonds(i, n1)) /= 1) then
     121         j = j + 1
     122       end if
     123     end do
     124     if (j == 1) return
     125 !
     126 !  AT THIS POINT, THE SEQUENCE O-C-C-N HAS BEEN IDENTIFIED.
     127 !  NOW TO MOVE ALONG BACKBONE TO THE START OF THE PROTEIN
     128 !
     129     peptide = .false.
     130     do ires_loc = 1, 1000000
     131       do i = 1, nbonds(n1)
     132         j = ibonds(i, n1)
     133         if (nat(j) == 6) then
     134           do k = 1, nbonds(j)
     135             if (nat(ibonds(k, j)) == 8) go to 1000
     136           end do
     137           cycle
     138 !
     139 !   J IS THE CARBON OF C=O
     140 !
     141 1000      do k = 1, nbonds(j)
     142             if (nat(ibonds(k, j)) == 6) then
     143               peptide = .true.
     144               go to 1010
     145             end if
     146           end do
     147         end if
     148       end do
     149       cycle
     150 1010  j = ibonds(k, j)
     151       do k = 1, nbonds(j)
     152         if (nat(ibonds(k, j)) == 7) go to 1020
     153       end do
     154       if (peptide) then
     155 !
     156 !  The residue at the start does not contain a nitrogen atom.
     157 !  So, temporarily, artificially convert a hydrogen into a nitrogen.
     158 !  This will allow the second residue to be correctly identified.
     159 !  (The first residue might be almost correctly identified)
     160 !
     161         do k = 1, nbonds(j)
     162           if (nat(ibonds(k, j)) == 1) n1 = ibonds(k, j)
     163         end do
     164         ok = (ok .and. n1 == ibonds(k, j))
     165         isok = ok
     166       end if
     167       exit
     168 1020  if (n1 == ibonds(k, j)) exit
     169       if (.not. ioptl(ibonds(k, j))) then
     170         n1 = ibonds(k, j)
     171         delta_res = delta_res + 1
     172       end if
     173       j = 0
 
 FORCHECK PC V13.5.13          FINDN1          2021-03-24 10:59:30   page:  1234
 findn1.F90  /FF
 
     174       do ii = 1, nbonds(n1)
     175         if (nat(ibonds(ii, n1)) /= 1) then
     176           j = j + 1
     177         end if
     178       end do
     179       if (j == 1) exit
     180     end do
     181     if (nat(n1) /= 7) then
     182       n1 = last_n1
     183     end if
     184     return
     185 end subroutine findn1
 
