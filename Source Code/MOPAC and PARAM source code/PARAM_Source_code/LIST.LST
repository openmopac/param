    1248   subroutine Refine_TS_for_Proteins
    1249 !
    1250 !       Refine the transition state by minimizing the heat of formation
  of everything
    1251 !       except the reaction side, followed by gradient minimization of
 the active site.
    1252 !       This is an iterative process, so up to five cycles of
    1253 !       (HoF minimization followed by gradient minimization) are used
    1254 !
    1255   use common_arrays_C, only : xparam, loc, lopt, geo
    1256   USE molkst_C, only : nvar, numat, moperr, keywrd
    1257   use ef_C, only: nstep
    1258   implicit none
    1259   integer :: loop, i, j
    1260   logical :: converged, extra_print, l_ts, l_nllsq, l_sigma
    1261     i = index(keywrd,  " LOCATE-TS")
    1262     do j = i + 12, min(240, i + 100)
    1263       if (keywrd(j:j) == " ") exit
    1264     end do
    1265     extra_print = (index(keywrd(i:j), "C:") > 0)
    1266     l_ts = (index(keywrd, " TS") /= 0)
    1267     l_nllsq = (index(keywrd, " NLLSQ") /= 0)
    1268     l_sigma = (index(keywrd, " SIGMA") /= 0)
    1269 !
    1270 !  Set default gradient minimization method.
    1271 !
    1272     if (.not. (l_ts .or. l_nllsq .or. l_sigma)) l_ts = .true.
    1273     if (.not. l_sigma) then
    1274       call l_control("NLLSQ", len("NLLSQ"), -1)
    1275       call l_control("TS", len("TS"), -1)
    1276     end if
    1277     do loop = 1,5
    1278 !
    1279 ! Set up geometry optimization calculation for everything except the ac
 tive site.
    1280 !
    1281       if (loop > 1) then
    1282         do i = 1, numat
    1283           do j = 1, 3
    1284             lopt(j,i) = 1 - lopt(j,i)
    1285           end do
    1286         end do
    1287       end if
    1288       loc = 0
    1289       nvar = 0
    1290       do i = 1, numat
    1291         do j = 1, 3
    1292           if (lopt(j,i) == 1) then
    1293             nvar = nvar + 1
    1294             loc(1,nvar) = i
    1295             loc(2,nvar) = j
    1296             xparam(nvar) = geo(j,i)
    1297           end if
    1298         end do
    1299       end do
    1300       call minimize_energy(loop)
    1301       converged = (nstep < 3)
    1302 !
 
 FORCHECK PC V13.5.13  REFINE_TS_FOR_PROTEINS  2021-03-24 10:59:30   page:  1750
 big_swap.F90  /FF
 
    1303 ! Set up gradient-minimum calculation for the active site, i.e., where
 the imaginary mode is.
    1304 !
    1305       if (moperr) return
    1306       do i = 1, numat
    1307         do j = 1, 3
    1308           lopt(j,i) = 1 - lopt(j,i)
    1309         end do
    1310       end do
    1311       loc = 0
    1312       nvar = 0
    1313       do i = 1, numat
    1314         do j = 1, 3
    1315           if (lopt(j,i) == 1) then
    1316             nvar = nvar + 1
    1317             loc(1,nvar) = i
    1318             loc(2,nvar) = j
    1319             xparam(nvar) = geo(j,i)
    1320           end if
    1321         end do
    1322       end do
    1323       call minimize_gradient(loop, converged, extra_print, l_ts, l_nlls
 q, l_sigma)
    1324       converged = (converged .and. nstep < 3)
    1325       if (converged) exit
    1326     end do
    1327   end subroutine Refine_TS_for_Proteins
 
