       1 subroutine chkpar
       2     use param_global_C, only : ifiles_8, numvar, nfns, diffns, locvar
       3     use elemts_C, only : elemnt
       4     use parameters_C, only : partyp
       5     implicit none
       6     integer :: i, il, iu, j, j2, k, l, lim, ll, lu
       7     double precision :: sum
       8     double precision, dimension (:), allocatable :: par
       9     double precision, dimension (5) :: eiglim
      10     double precision, dimension (:), allocatable :: parmod
      11     double precision, dimension (:), allocatable :: vects
      12     intrinsic Min, Sqrt
      13   !
      14   !.. Data Declarations ..
      15     data eiglim / 1.d-5, 1.d-0, 1.d1, 1.d2, 1.d3 /
      16   !
      17   ! ... Executable Statements ...
      18   !
      19     write (ifiles_8, "(//20X,A)") " CHECK OF PARAMETER INDEPENDENCE"
      20     write (ifiles_8, "(//15X,A,I5)") " Number of reference data:", nfns
      21     write (ifiles_8, "(  15X,A,I5)") " Number of parameters:    ", numv
 ar
      22      i = (numvar*(numvar+1))/2
      23      allocate (par(i), parmod(numvar), vects(numvar**2))
      24     if (nfns < 30 .and. numvar < 9) then
      25       write (ifiles_8, "(/3X,2A,/)") "Matrix of Differentials ", "(Rows
 : Refer&
      26      &ence data, Columns: Parameters)"
      27       do i = 1, nfns
      28         write (ifiles_8, "(8F10.4)") (diffns(j, i), j=1, numvar)
      29       end do
      30     end if
      31     l = 0
      32     do i = 1, numvar
      33       sum = 1.d-20
      34       do k = 1, nfns
      35         sum = sum + diffns(i, k) * diffns(i, k)
      36       end do
      37       parmod(i) = 1.d0 / Sqrt (sum)
      38       parmod(i) = 1.d0
      39       do j = 1, i
      40         sum = 0.d0
      41         do k = 1, nfns
      42           sum = sum + diffns(i, k) * diffns(j, k)
      43         end do
      44         l = l + 1
      45         par(l) = sum * parmod(i) * parmod(j)
      46       end do
      47     end do
      48     if (numvar < 9) then
      49       write (ifiles_8, "(/15X,A,/)") "Parameter Hessian"
      50       l = 1
      51       do i = 1, numvar
      52         ll = l
      53         l = l + i
      54         lu = l - 1
      55         write (ifiles_8, "(8F10.1)") (par(j), j=ll, lu)
      56       end do
 
 FORCHECK PC V13.5.13          CHKPAR          2021-03-24 10:59:30   page:   482
 chkpar.F90  /FF
 
      57     end if
      58     call rsp (par, numvar, parmod, vects)
      59     write (ifiles_8, "(//20X,A,/)") " Eigenvalues of Parameter Hessian"
      60     do j = 1, numvar
      61       if (parmod(j) > 1.d7) then
      62         j2 = j - 1
      63         go to 1000
      64       end if
      65     end do
      66     j2 = numvar
      67 1000 write (ifiles_8, "(8F10.1)") (parmod(i), i=1, j2)
      68     if (j2 /= numvar) then
      69       write (ifiles_8, "(/20X,A)") "(Eigenvalues over 10,000,000 omitte
 d)"
      70     end if
      71     write (ifiles_8, "(/)")
      72     if (parmod(1) < eiglim(1)) then
      73       lim = 1
      74       write (ifiles_8, "(20X,A)") " Parameters are ill-defined"
      75     else if (parmod(1) < eiglim(2)) then
      76       lim = 2
      77       write (ifiles_8, "(20X,A)") " Parameters are very poorly defined"
      78     else if (parmod(1) < eiglim(3)) then
      79       lim = 3
      80       write (ifiles_8, "(20X,A)") " Parameters are poorly defined"
      81     else
      82       lim = 4
      83       write (ifiles_8, "(20X,A)") " Parameters are defined by reference
  data"
      84     end if
      85     if (lim == 4) return
      86     do i = 1, numvar
      87       if (parmod(i) > eiglim(lim)) go to 1100
      88     end do
      89     i = numvar
      90 1100 write (ifiles_8, "(/15X,A,/)") " Parameter Eigenvectors of Low Eig
 envalue&
      91    &s"
      92     i = Min (i, 8)
      93     write (ifiles_8, "(12X,8F8.1)") (parmod(j), j=1, i)
      94     locvar(1,numvar+1) = 0
      95     locvar(2,numvar+1) = 0
      96     do j = 1, numvar
      97       il = (j-1) * numvar + 1
      98       iu = il + i - 1
      99       write (ifiles_8, "(3X,A,2X,A,2X,8F8.3)") partyp (locvar(1, j)), e
 lemnt &
     100      & (locvar(2, j)), (vects(k), k=il, iu)
     101     end do
     102 end subroutine chkpar
 
