       1       subroutine genun(u, n)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5 !****************************************************************
       6 !
       7 !     GENERATE UNIT VECTORS OVER SPHERE. USED BY SURFAC ONLY.
       8 !
       9 !****************************************************************
      10       implicit none
      11 !-----------------------------------------------
      12 !   D u m m y   A r g u m e n t s
      13 !-----------------------------------------------
      14       integer , intent(inout) :: n
      15       double precision , intent(out) :: u(3,n)
      16 !-----------------------------------------------
      17 !   L o c a l   V a r i a b l e s
      18 !-----------------------------------------------
      19       integer :: nequat, nvert, nu, i, nhor, j
      20       double precision :: pi, fi, z, xy, fj, x, y
      21 !-----------------------------------------------
      22       pi = 4.D0*atan(1.D0)
      23       nequat = int(sqrt(n*pi))
      24       nvert = nequat/2
      25       nu = 0
      26       l20: do i = 1, nvert + 1
      27         fi = (pi*(i - 1))/nvert
      28         z = cos(fi)
      29         xy = sin(fi)
      30         nhor = int(nequat*xy)
      31         nhor = max0(1,nhor)
      32         do j = 1, nhor
      33           fj = (2.D0*pi*(j - 1))/nhor
      34           x = dcos(fj)*xy
      35           y = dsin(fj)*xy
      36           if (nu >= n) exit  l20
      37           nu = nu + 1
      38           u(1,nu) = x
      39           u(2,nu) = y
      40           u(3,nu) = z
      41         end do
      42       end do l20
      43       n = nu
      44       return
      45       end subroutine genun
 
