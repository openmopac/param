 babbcd.F90  /FF


       1       double precision function babbcd (iocca1, ioccb1, iocca2, ioccb2,
  nmos, &
       2         xy)
       3 !-----------------------------------------------
       4 !   M o d u l e s
       5 !-----------------------------------------------
       6 !**********************************************************************
 *
       7       implicit none
       8 !-----------------------------------------------
       9 !   D u m m y   A r g u m e n t s
      10 !-----------------------------------------------
      11       integer , intent(in) :: nmos
      12       integer , intent(in) :: iocca1(nmos)
      13       integer , intent(in) :: ioccb1(nmos)
      14       integer , intent(in) :: iocca2(nmos)
      15       integer , intent(in) :: ioccb2(nmos)
      16       double precision , intent(in) :: xy(nmos,nmos,nmos,nmos)
      17 !-----------------------------------------------
      18 !   L o c a l   P a r a m e t e r s
      19 !-----------------------------------------------
      20 !-----------------------------------------------
      21 !   L o c a l   V a r i a b l e s
      22 !-----------------------------------------------
      23       integer :: ij, i, j, k, l
      24       double precision :: one
      25 !-----------------------------------------------
      26 !**********************************************************************
      27 !
      28 ! BABBCD EVALUATES THE C.I. MATRIX ELEMENT FOR TWO MICROSTATES DIFFERIN
 G
      29 !       BY TWO BETA MOS. ONE MICROSTATE HAS BETA ELECTRONS IN
      30 !       M.O.S PSI(I) AND PSI(J) FOR WHICH THE OTHER MICROSTATE HAS
      31 !       ELECTRONS IN PSI(K) AND PSI(L)
      32 !
      33 !**********************************************************************
      34       ij = 0
      35       do i = 1, nmos
      36         if (ioccb1(i) >= ioccb2(i)) cycle
      37         exit
      38       end do
      39       do j = i + 1, nmos
      40         if (ioccb1(j) < ioccb2(j)) exit
      41         ij = ij + iocca2(j) + ioccb2(j)
      42       end do
      43       ij = ij + iocca2(j)
      44       do k = 1, nmos
      45         if (ioccb1(k) <= ioccb2(k)) cycle
      46         exit
      47       end do
      48       do l = k + 1, nmos
      49         if (ioccb1(l) > ioccb2(l)) exit
      50         ij = ij + iocca1(l) + ioccb1(l)
      51       end do
      52       ij = ij + iocca1(l)
      53       if ((ij/2)*2 == ij) then
      54         one = 1.D0
      55       else
 
 FORCHECK PC V13.5.13          BABBCD          2021-03-24 10:59:30   page:    44
 babbcd.F90  /FF
 
      56         one = -1.D0
      57       end if
      58       babbcd = (xy(i,k,j,l)-xy(i,l,j,k))*one
      59       return
      60       end function babbcd
 
 FORCHECK PC V13.5.13          BABBCD          2021-03-24 10:59:30   page:    45
 babbcd.F90  /FF


