     116 !
     117       subroutine ffhpol()
     118       use molkst_C, only : keywrd, numat, efield,escf
     119       use common_arrays_C, only : geo, nat
     120       use parameters_C, only : tore
     121       use funcon_C, only : fpc_9, eV,a0, fpc_1, fpc_8
     122       use chanel_C, only : iw
     123       implicit none
     124 !
     125       integer :: nbdip, nbcnt, ngcnt, id, ivl, kd, kvl, &
     126         idm1, jd, i3, counter
     127       double precision, dimension(3) :: eigs
     128       double precision, dimension(9) :: vectrs
     129       double precision, dimension(3) :: dipe4
     130       double precision, dimension(6) :: apole4
     131       double precision, dimension(3) :: dipdp
     132       double precision, dimension(6) :: apoldp
     133       double precision, dimension(3) :: dip1p, dip1m, dip2p, dip2m
     134       double precision :: autokc, autodb, autovm, efval, sfe&
     135         , hnuc, heat1p, grad(1), heat1m, heat2p, heat2m, eterm, dmu, &
     136         ae, aki, hnucj, hpp, hpm, hmm, hmp, &
     137         h2pp, h2pm, h2mm, h2mp, aterm, aij, &
     138         dipe4t, dipe4d, dipdpt, dipdpd, avgpe4, avga3, avgesu, avgpdp,
 &
     139         avga3d, avgesd, heat0
     140       logical :: debug
     141       character, dimension(3) :: axis
     142       character :: ch_xyz(3)*1
     143       double precision, external :: pol_vol
     144       data ch_xyz/"X","Y","Z"/
     145 !**********************************************************************
 *
     146 !  SUBROUTINE FOR THE FINITE FIELD CALCULATION OF ELECTRIC RESPONSE
     147 !  PROPERTIES (DIPOLE MOMENT, POLARIZABILITY, AND 1ST AND 2ND
     148 !  HYPERPOLARIZABILITY.
     149 !
     150 !  HENRY A. KURTZ, DEPARTMENT OF CHEMISTRY
     151 !                  MEMPHIS STATE UNIVERSITY
     152 !                  MEMPHIS, TN   38152
     153 !
     154 !**********************************************************************
 *
     155 !
     156 !
     157 !     DIPE4 AND DIPDP HOLD THE CALCULATED DIPOLE MOMENTS
     158 !
     159 !     APOLE4 AND APOLDP HOLD THE POLARIZABILITY TENSOR AS
     160 !                                A PACKED ARRAY XX,XY,YY,XZ,YZ,ZZ
     161 !
     162 ! Energy: a.u. to kcal/mole
     163       autokc = fpc_9*eV
     164 ! Dipole: a.u. to debye
     165       autodb = a0*fpc_8*fpc_1*1.d-10
     166 ! Electric Field: a.u. to volt/meter
     167       autovm = eV/a0 ! = 51.42
     168       nbdip = 1
     169       nbcnt = 4
     170       ngcnt = 4
 
 FORCHECK PC V13.5.13          FFHPOL          2021-03-24 10:59:30   page:  1837
 static_polarizability.F90  /FF
 
     171       heat0 = escf
     172 !
     173       data axis/ 'X', 'Y', 'Z'/
     174       debug = index(keywrd,'DEBUG') /= 0
     175 !
     176 !  FIELD STRENGTH IN A.U.
     177 !
     178       efval = 0.002D0
     179       write (iw, "(/,/,' APPLIED ELECTRIC FIELD MAGNITUDE: ',f15.5,a)")
  efval*ev/a0, &
     180       " VOLTS PER ANGSTROM"
     181       sfe = 1.D00/efval
     182 !......................................................................
 .
     183 !  CALCULATE THE POLARIZABILITY AND HYPERPOLARIZABILITIES ALONG
     184 !  THE THREE PRINCIPLE AXES.  (THESE AXES DEPEND ON YOUR ARBITRARY
     185 !  ORIENTATION AND MAY NOT BE THE TRUE PRINCIPLE AXES.)
     186 !......................................................................
 .
     187       counter = 0
     188       do id = 1, 3
     189         if (debug) then
     190           write (iw, 40) axis(id)
     191    40     format(/,/,' ****** ',a1,' DIRECTION *****',/)
     192         end if
     193 !
     194 ! ZERO THE FIELD
     195 !
     196         efield = 0.0D00
     197         hnuc = sum(efval*geo(id,:numat)*tore(nat(:numat))*autovm)
     198         hnuc = hnuc*fpc_9
     199 ! +E(ID)
     200         efield(id) = efval
     201         call compfg (geo, .TRUE., heat1p, .TRUE., grad, .FALSE.)
     202         counter = counter + 1
     203         write(iw,'(a,i3,a)')"    Step", counter, " of 36 done (+"//ch_x
 yz(id)//")"
     204         call dipind (dip1p)
     205 ! -E(ID)
     206         efield(id) = -efval
     207         call compfg (geo, .TRUE., heat1m, .TRUE., grad, .FALSE.)
     208         counter = counter + 1
     209         write(iw,'(a,i3,a)')"    Step", counter, " of 36 done (-"//ch_x
 yz(id)//")"
     210         call dipind (dip1m)
     211 ! +2E(ID)
     212         efield(id) = 2.0D00*efval
     213         call compfg (geo, .TRUE., heat2p, .TRUE., grad, .FALSE.)
     214         counter = counter + 1
     215         write(iw,'(a,i3,a)')"    Step", counter, " of 36 done (+2"//ch_
 xyz(id)//")"
     216         call dipind (dip2p)
     217 ! -2E(ID)
     218         efield(id) = -2.0D00*efval
     219         call compfg (geo, .TRUE., heat2m, .TRUE., grad, .FALSE.)
     220         counter = counter + 1
     221         write(iw,'(a,i3,a)')"    Step", counter, " of 36 done (-2"//ch_
 xyz(id)//")"
     222         call dipind (dip2m)
 
 FORCHECK PC V13.5.13          FFHPOL          2021-03-24 10:59:30   page:  1838
 static_polarizability.F90  /FF
 
     223         if (debug) then
     224           write (iw, 70)
     225    70     format(' ENERGIES AT: ',5x,'F',21x,'2F',/)
     226           write (iw, 80) heat1p, heat2p, heat1m, heat2m
     227    80     format('   + ',2(f20.10,3x),/,'   - ',2(f20.10,3x))
     228         end if
     229 !
     230 ! DIPOLE
     231 !
     232         eterm = (1.0D00/12.D00)*(heat2p - heat2m) - &
     233           (2.0D00/3.0D00)*(heat1p - heat1m)
     234         dipe4(id) = eterm*sfe/autokc
     235 !
     236 ! ALPHA
     237 !
     238         ivl = (id*(id + 1))/2
     239         eterm = 2.5D00*heat0 - (4.D00/3.D00)*(heat1p + heat1m) + &
     240           (1.D00/12.0D00)*(heat2p + heat2m)
     241         apole4(ivl) = eterm*sfe*sfe/autokc
     242 !
     243 ! DIPOLE CALCULATIONS
     244 !
     245         dmu = (2.0D00/3.0D00)*(dip1p(id)+dip1m(id)) - &
     246           (1.D00/6.0D00)*(dip2p(id) + dip2m(id))
     247         dipdp(id) = dmu/autodb
     248         ae = (2.0D00/3.0D00)*(dip1p(id)-dip1m(id)) - &
     249           (1.0D00/12.D00)*(dip2p(id) - dip2m(id))
     250         apoldp(ivl) = ae*sfe/autodb
     251         do kd = 1, 3
     252           if (kd < id) then
     253             kvl = (id*(id - 1))/2 + kd
     254             aki = (2.0D00/3.0D00)*(dip1p(kd)-dip1m(kd)) - &
     255               (1.0D00/12.0D00)*(dip2p(kd)-dip2m(kd))
     256             apoldp(kvl) = aki*sfe/autodb
     257           end if
     258           if (kd == id) cycle
     259           nbdip = nbdip + 1
     260         end do
     261 !......................................................................
 .
     262 !
     263 !  NOW CALCULATE THE OFF AXIS RESULTS.
     264 !
     265 !......................................................................
 .
     266         idm1 = id - 1
     267         do jd = 1, idm1
     268           hnucj = sum(efval*geo(jd,:numat)*tore(nat(:numat))*eV/a0)
     269           hnucj = hnucj*fpc_9
     270           efield = 0.0D00
     271 !
     272 ! DIAGONAL FIELDS WITH COMPONENTS EQUAL TO EFVAL
     273 !
     274           efield(id) = efval
     275           efield(jd) = efval
     276           call compfg (geo, .TRUE., hpp, .TRUE., grad, .FALSE.)
     277           counter = counter + 1
     278           write(iw,'(a,i3,a)')"    Step", counter, " of 36 done (+"//ch
 _xyz(id)//"+"//ch_xyz(jd)//")"
 
 FORCHECK PC V13.5.13          FFHPOL          2021-03-24 10:59:30   page:  1839
 static_polarizability.F90  /FF
 
     279           call dipind (dip1p)
     280           efield(jd) = -efval
     281           call compfg (geo, .TRUE., hpm, .TRUE., grad, .FALSE.)
     282           counter = counter + 1
     283           write(iw,'(a,i3,a)')"    Step", counter, " of 36 done (+"//ch
 _xyz(id)//"-"//ch_xyz(jd)//")"
     284           call dipind (dip1p)
     285           efield(id) = -efval
     286           call compfg (geo, .TRUE., hmm, .TRUE., grad, .FALSE.)
     287           counter = counter + 1
     288           write(iw,'(a,i3,a)')"    Step", counter, " of 36 done (-"//ch
 _xyz(id)//"-"//ch_xyz(jd)//")"
     289           call dipind (dip1p)
     290           efield(jd) = efval
     291           call compfg (geo, .TRUE., hmp, .TRUE., grad, .FALSE.)
     292           counter = counter + 1
     293           write(iw,'(a,i3,a)')"    Step", counter, " of 36 done (-"//ch
 _xyz(id)//"+"//ch_xyz(jd)//")"
     294           call dipind (dip1p)
     295           hpp = hpp + hnuc + hnucj
     296           hpm = hpm + hnuc - hnucj
     297           hmm = hmm - hnuc - hnucj
     298           hmp = hmp - hnuc + hnucj
     299           if (debug) then
     300             write (iw, 120)
     301   120       format(/,'  ',12x,'+,+',15x,'+,-',15x,'-,+',15x,'-,-')
     302             write (iw, 130) hpp, hpm, hmp, hmm
     303   130       format('  E ',4f18.6)
     304           end if
     305 !
     306 !  DIAGONAL FIELDS WITH COMPONENTS EQUAL TO 2*EFVAL
     307 !
     308           efield(id) = efval*2.D00
     309           efield(jd) = efval*2.D00
     310           call compfg (geo, .TRUE., h2pp, .TRUE., grad, .FALSE.)
     311           counter = counter + 1
     312           write(iw,'(a,i3,a)')"    Step", counter, " of 36 done (+2"//c
 h_xyz(id)//"+2"//ch_xyz(jd)//")"
     313           efield(jd) = -efval*2.D00
     314           call compfg (geo, .TRUE., h2pm, .TRUE., grad, .FALSE.)
     315           counter = counter + 1
     316           write(iw,'(a,i3,a)')"    Step", counter, " of 36 done (+2"//c
 h_xyz(id)//"-2"//ch_xyz(jd)//")"
     317           efield(id) = -efval*2.D00
     318           call compfg (geo, .TRUE., h2mm, .TRUE., grad, .FALSE.)
     319           counter = counter + 1
     320           write(iw,'(a,i3,a)')"    Step", counter, " of 36 done (-2"//c
 h_xyz(id)//"-2"//ch_xyz(jd)//")"
     321           efield(jd) = efval*2.D00
     322           call compfg (geo, .TRUE., h2mp, .TRUE., grad, .FALSE.)
     323           counter = counter + 1
     324           write(iw,'(a,i3,a)')"    Step", counter, " of 36 done (-2"//c
 h_xyz(id)//"+2"//ch_xyz(jd)//")"
     325           h2pp = h2pp + 2.0D00*(hnuc + hnucj)
     326           h2pm = h2pm + 2.0D00*(hnuc - hnucj)
     327           h2mm = h2mm - 2.0D00*(hnuc + hnucj)
     328           h2mp = h2mp - 2.0D00*(hnuc - hnucj)
     329           if (debug) then
     330             write (iw, 140) h2pp, h2pm, h2mp, h2mm
 
 FORCHECK PC V13.5.13          FFHPOL          2021-03-24 10:59:30   page:  1840
 static_polarizability.F90  /FF
 
     331   140       format(' 2E ',4f18.6)
     332           end if
     333 !
     334           aterm = (1.0D00/48.0D00)*(h2pp - h2pm - h2mp + h2mm) - &
     335             (1.0D00/3.0D00)*(hpp - hpm - hmp + hmm)
     336           aij = aterm*sfe*sfe/autokc
     337           ivl = (id*(id - 1))/2 + jd
