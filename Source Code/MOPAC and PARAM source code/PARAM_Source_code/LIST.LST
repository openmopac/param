     984             write(iw, 1006) 'Config ', i, ci(il, i), ci(il, i)**2
     985             cisum = cisum + ci(il, i)**2
     986           end if
     987         end do
     988         write (iw, 1007) 'Total coeff printed    ', cisum
     989         write (iw, *) ' '
     990       end do
     991 !     End RMG
     992
     993 ! RMG - add option to write transition dipoles between excited states
     994       if (index(keywrd, ' TDIP') /= 0) then
     995         do i = 1, nciout
     996           do j = 1, i
     997             nm = matind(max(i, j)) + min(i, j)
     998             write(14, '(i5, i5, 3f12.6)') i, j, dmci(nm, 1)*debye, dmci
 (nm, 2)*debye, dmci(nm, 3)*debye
     999           end do
    1000          end do
    1001         close(14)
    1002       end if
    1003
    1004 ! End RMG
    1005
    1006       return
    1007
    1008       end subroutine ciout
 
