     310   subroutine GPJPS_Int(Rab, na, Ca, Za, X)
     311     implicit none
     312     double precision, intent(in) :: Rab(3)
     313     integer, intent(in) :: na
     314     double precision, intent(in) :: Ca(na), Za(na)
     315     double precision, intent(OUT) :: X( 3, 1 )
     316 !
     317 !  Local variables
     318 !
     319     integer :: i
     320     double precision :: r2, r, b, br, cc, j00, d00dr, j10, e, U(3)
     321     X = 0.d0
     322     r2 = Rab(1)*Rab(1) + Rab(2)*Rab(2) + Rab(3)*Rab(3)
     323     if ( r2 < 1.d-25 ) then
     324        X = 0.d0
     325     else
     326        r = sqrt(r2)
     327        U = Rab/r
     328        j10 = 0.d0
     329        do i=1, na
     330           b  = sqrt( Za(i)  )
     331           br = b * r
     332           cc = Ca(i)
     333           e = (2.d0 / sqrt_PI) * b * EXP(-br*br)
     334           j00    = erf(br)/r
     335           d00dr  = e/r - j00/r
     336           j10    = j10 + cc * d00dr
     337        end do
     338        X(1, 1) = X(1, 1) + j10 * U(3)
     339        X(2, 1) = X(2, 1) + j10 * U(1)
