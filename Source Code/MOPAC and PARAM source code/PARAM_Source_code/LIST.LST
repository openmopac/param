    1801 !-----------------------------------------------
    1802       double precision :: t1a, t2a, t3a, t4a, t5a, t6a, t1b, t2b, t3b,
 t4b, t5b, &
    1803         t6b
    1804       double precision, external :: trugud, trudgu, trugdu
    1805 !-----------------------------------------------
    1806       t1a = trudgu(u2a,g1b,u1c,nclose,norbs,norbs)
    1807       t2a = trugud(u1c,g1b,u2a,nclose,norbs,norbs)
    1808       t3a = trugud(u1b,g1c,u2a,nclose,norbs,norbs)
    1809       t4a = trudgu(u2a,g1c,u1b,nclose,norbs,norbs)
    1810       t5a = trugdu(u1c,g2a,u1b,nclose,norbs,norbs)
    1811       t6a = trugdu(u1b,g2a,u1c,nclose,norbs,norbs)
    1812       t1b = trudgu(u2a,g1b,u1c,norbs,nclose,norbs)
    1813       t2b = trugud(u1c,g1b,u2a,norbs,nclose,norbs)
    1814       t3b = trugud(u1b,g1c,u2a,norbs,nclose,norbs)
    1815       t4b = trudgu(u2a,g1c,u1b,norbs,nclose,norbs)
    1816       t5b = trugdu(u1c,g2a,u1b,norbs,nclose,norbs)
    1817       t6b = trugdu(u1b,g2a,u1c,norbs,nclose,norbs)
    1818       term = t1b - t1a + t2b - t2a + t3b - t3a + t4b - t4a + t5a - t5b
 + t6a - &
