     112       do ii = 2, numat
     113         e(n,1) = 0.0D0
     114         ia = nfirst(ii)
     115         ib = nlast(ii)
     116         iminus = ii - 1
     117         oneii = 1.D0
     118         if (nat(ii) == 102) oneii = 0.D0
     119         do jj = 1, iminus
     120           n = n + 1
     121           ja = nfirst(jj)
     122           jb = nlast(jj)
     123           onejj = 1.D0
     124           if (nat(jj) == 102) onejj = 0.D0
     125           e(n,1) = 0.0D0
     126           do i = ia, ib
     127             ka = (i*(i - 1))/2
     128             do k = ja, jb
     129               ik = ka + k
     130               e(n,1) = e(n,1) + 2.0D0*p(ik)*h(ik)*oneii*onejj
     131             end do
     132           end do
     133         end do
     134         n = n + 1
     135       end do
     136 !
     137 !
     138 !     CORE-CORE REPULSION (E(N,2)) AND CORE-ELEC. ATTRACTION (E(N,3)).
     139       n = 0
     140       kk = 0
     141       outer_ii_loop: do ii = 1, numat
     142         ia = nfirst(ii)
     143         ib = nlast(ii)
     144         si = (ib < ia)
     145         ni = nat(ii)
     146         iss = (ia*(ia+1)) / 2
     147         iminus = ii - 1
     148         outer_jj_loop: do jj = 1, iminus
     149           n = n + 1
     150           e(n, 2) = 0.0d0
     151           e(n, 3) = 0.0d0
     152           ja = nfirst(jj)
     153           jb = nlast(jj)
     154           sj = (jb < ja)
     155           nj = nat(jj)
     156           jss = (ja*(ja+1)) / 2
     157 !
     158 !  Use rotate here because g, e1b, and e2a need to be re-calculated.
     159 !
     160           call rotate (ni, nj, coord(1,ii), coord(1,jj), w2, i, e1b, e2
 a, g)
     161           if(w2(1) < -1.d20) return ! Dummy use of w2
     162           if (ib >= ia .and. jb >= ja) then
     163             kk = kk + 1
     164 !
 
 FORCHECK PC V13.5.13          ENPART          2021-03-24 10:59:30   page:  3137
 enpart.F90  /FF
 
     165 !  Calculate the nuclear-nuclear term (e(n,2).
     166 !
     167             e(n, 2) = g
     168 !
     169 !  Calculate the electron-nuclear stabilization. (e(n,3))
     170 !
     171             if (ib >= ia ) e(n, 3) =  e(n, 3) + (pa(iss) + pb(iss)) * e
 1b(1)
     172             if (jb >= ja ) e(n, 3) =  e(n, 3) + (pa(jss) + pb(jss)) * e
 2a(1)
     173           else  ! add in sparkle contribution
     174             e(n, 2) = g
     175             if (ib >= ia ) e(n, 3) =  (pa(iss) + pb(iss)) * e1b(1)
     176             if (jb >= ja ) e(n, 3) =  (pa(jss) + pb(jss)) * e2a(1)
     177           end if
     178 !
     179 !  Calculate the electron-nuclear stabilization. (e(n,3))
     180 !
     181 !
     182 !  The s-s term has already been calculated.  Now do the
     183 !  <ZZ|other terms>  Go along the side of the square matrix of
     184 !  W integrals (in steps of 1).
     185 !  Note:  The first term is the <ZZ|sz> integral.
     186 !
     187           kinc = ((jb-ja+1)*(jb-ja+2)) / 2 - 1
     188           jap1 = ja + 1
     189           i = 1
     190           do k = jap1, jb
     191             kc = (k*(k-1)) / 2
     192             do l = ja, k
     193               kl = kc + l
     194               bb = 2.0d0
     195               if (k == l) then
     196                 bb = 1.0d0
     197               end if
     198               if ( si ) then
     199                 i = i + 1  ! Sparkle contribution to A.O. of atom j
     200                 e(n, 3) = e(n, 3) + (pa(kl) + pb(kl)) * bb * e2a(i)
     201               else
     202                 i = i + 1
     203                 kk = kk + 1
     204                 e(n, 3) = e(n, 3) + (pa(kl) + pb(kl)) * bb * e2a(i)
     205               end if
     206             end do
     207           end do
     208          !
     209          !  Calculate the electron-nuclear stabilization.
     210          !  The s-s term has already been calculated.  Now do the
     211          !  <ZZ|other terms>  Go down the side of the square matrix of
     212          !  W integrals (in steps of kinc+1).
     213          !  Note: The first term is the <sz|ZZ> integral.
     214          !
     215           iap1 = ia + 1
     216           l = 1
     217           do i = iap1, ib
     218             ka = (i*(i-1)) / 2
     219             do j = ia, i
     220               ij = ka + j
     221               aa = 2.0d0
 
 FORCHECK PC V13.5.13          ENPART          2021-03-24 10:59:30   page:  3138
 enpart.F90  /FF
 
     222               if (i == j) then
     223                 aa = 1.0d0
     224               end if
     225               if ( sj ) then
     226                 l = l + 1
     227                 e(n, 3) = e(n, 3) +  (pa(ij) + pb(ij)) * aa * e1b(l)
     228               else
     229                 l = l + 1
     230                 kk = kk + 1
     231                 e(n, 3) = e(n, 3) + (pa(ij) + pb(ij)) * aa * e1b(l)
     232                !
     233                !  KINC is the number of terms on a side, less 1
     234                !
     235                 kk = kk + kinc
     236               end if
     237             end do
     238           end do
     239         end do outer_jj_loop
     240         sum1 = 0.d0
     241        !
     242        !   One-center coulomb and exchange terms for atom II.
     243        !
     244        !  F(i,j)=F(i,j)+sum(k,l)((PA(k,l)+PB(k,l))*<i,j|k,l>
     245        !                        -(PA(k,l)        )*<i,k|j,l>), k,l on a
 tom II.
     246        !
     247         do i = ia, ib
     248           aa = 2.d0
     249           do j = ia, i
     250             if (i == j) then
     251               aa = 1.d0
     252             end if
     253                !
     254                !   'J' address in P
     255                !
     256             jij = (i*(i-1)) / 2 + j
     257             sum = 0.d0
     258             do k = ia, ib
     259               bb = 2.d0
     260               do l = ia, k
     261                 if (k == l) then
     262                   bb = 1.d0
     263                 end if
     264                      !
     265                      !   'J' address in P
     266                      !
     267                 jkl = (k*(k-1)) / 2 + l
     268                      !
     269                      !   'K' addresses in P
     270                      !
     271                 im = Max (i, k)
     272                 km = Min (i, k)
     273                 kik = (im*(im-1)) / 2 + km
     274                 im = Max (i, l)
     275                 lm = Min (i, l)
     276                 kil = (im*(im-1)) / 2 + lm
     277                 jm = Max (j, k)
     278                 km = Min (j, k)
     279                 kjk = (jm*(jm-1)) / 2 + km
 
 FORCHECK PC V13.5.13          ENPART          2021-03-24 10:59:30   page:  3139
 enpart.F90  /FF
 
     280                 jm = Max (j, l)
     281                 lm = Min (j, l)
     282                 kjl = (jm*(jm-1)) / 2 + lm
     283                      !
     284                      !   The term itself
     285                      !
     286                 kk = kk + 1
     287                 sum = sum + aa * bb * w(kk) * ((pa(jij)+&
     288                & pb(jij))*(pa(jkl)+pb(jkl))-(pa(kik)*pa(kjl)+&
     289                & pa(kil)*pa(kjk)+pb(kik)*pb(kjl)+&
     290                & pb(kil)*pb(kjk))*0.5d0)
     291               end do
     292             end do
     293             sum1 = sum1 + sum
     294           end do
     295         end do
     296         ea(ii, 2) = sum1 * 0.5d0
