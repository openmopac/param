       1       subroutine pulay(f, p, n, fppf, fock, emat, lfock, nfock, msize,
 start, pl)
       2       use chanel_C, only : iw
       3       use molkst_C, only : numcal, keywrd, mpack, npulay
       4       use Common_arrays_C, only : workmat1, workmat2, workmat3
       5       implicit none
       6       integer  :: n
       7       integer , intent(inout) :: lfock
       8       integer , intent(inout) :: nfock
       9       integer , intent(in) :: msize
      10       double precision , intent(out) :: pl
      11       logical , intent(inout) :: start
      12       double precision  :: f(mpack)
      13       double precision  :: p(mpack)
      14       double precision  :: fppf(*)
      15       double precision , intent(inout) :: fock(*)
      16       double precision , intent(inout) :: emat(npulay+1,npulay+1)
      17 !
      18       integer :: icalcn, maxlim, linear, mfock, lbase, i, nfock1, j, l,
  il, ii
      19       double precision, dimension((npulay+1)**2) :: evec
      20       double precision, dimension(npulay) :: coeffs
      21       double precision :: const, d, sum
      22       logical :: debug
      23       double precision, external :: ddot
      24 !
      25       save icalcn, maxlim, debug, linear, mfock
      26 !-----------------------------------------------
      27 !**********************************************************************
 *
      28 !
      29 !   PULAY USES DR. PETER PULAY'S METHOD FOR CONVERGENCE.
      30 !         A MATHEMATICAL DESCRIPTION CAN BE FOUND IN
      31 !         "P. PULAY, J. COMP. CHEM. 3, 556 (1982).
      32 !
      33 ! ARGUMENTS:-
      34 !         ON INPUT F      = FOCK MATRIX, PACKED, LOWER HALF TRIANGLE.
      35 !                  P      = DENSITY MATRIX, PACKED, LOWER HALF TRIANGLE
 .
      36 !                  N      = NUMBER OF ORBITALS.
      37 !                  FPPF   = WORKSTORE OF SIZE MSIZE, CONTENTS WILL BE
      38 !                           OVERWRITTEN.
      39 !                  FOCK   =      "       "              "         "
      40 !                  EMAT   = WORKSTORE OF AT LEAST NPULAY**2 ELEMENTS.
      41 !                  START  = LOGICAL, = TRUE TO START PULAY.
      42 !                  PL     = UNDEFINED ELEMENT.
      43 !      ON OUTPUT   F      = "BEST" FOCK MATRIX, = LINEAR COMBINATION
      44 !                           OF KNOWN FOCK MATRICES.
      45 !                  START  = FALSE
      46 !                  PL     = MEASURE OF NON-SELF-CONSISTENCY
      47 !                         = [F*P] = F*P - P*F.
      48 !
      49 !**********************************************************************
 *
      50       data icalcn/ 0/
      51       if (icalcn /= numcal) then
      52         icalcn = numcal
      53         maxlim = npulay
 
 FORCHECK PC V13.5.13          PULAY           2021-03-24 10:59:30   page:   491
 pulay.F90  /FF
 
      54         debug = index(keywrd,'DEBUGPULAY') /= 0
      55       end if
      56       if (start) then
      57         linear = (n*(n + 1))/2
      58         mfock = msize/linear
      59         mfock = min0(maxlim,mfock)
      60         if (debug) write (iw, '('' MAXIMUM SIZE:'',I5)') mfock
      61         nfock = 1
      62         lfock = 1
      63         start = .FALSE.
      64       else
      65         if (nfock < mfock) nfock = nfock + 1
      66         if (lfock /= mfock) then
      67           lfock = lfock + 1
      68         else
      69           lfock = 1
      70         end if
      71       end if
      72       lbase = (lfock - 1)*linear
      73 !
      74 !   FIRST, STORE FOCK MATRIX FOR FUTURE REFERENCE.
      75 !
      76       fock(lfock:(linear-1)*mfock+lfock:mfock) = f(:linear)
      77 !
      78 !   NOW FORM /FOCK*DENSITY-DENSITY*FOCK/, AND STORE THIS IN FPPF
      79 !
      80 !      call mamult (p, f, fppf(lbase+1), n, 0.D0)
      81 !      call mamult (f, p, fppf(lbase+1), n, -1.D0)
      82       call unpack_matrix(p, workmat1, n)
      83       call unpack_matrix(f, workmat2, n)
      84       call sym_commute(workmat1, workmat2, workmat3, n)
      85       call pack_matrix(workmat3, fppf(lbase+1), n)
      86 !
      87 !   FPPF NOW CONTAINS THE RESULT OF FP - PF.
      88 !
      89       nfock1 = nfock + 1
      90       do i = 1, nfock
      91         emat(nfock1,i) = -1.D0
      92         emat(i,nfock1) = -1.D0
      93         emat(lfock,i) = ddot(linear,fppf((i-1)*linear+1),1,fppf(lbase+1
 ),1)
      94         emat(i,lfock) = emat(lfock,i)
      95       end do
      96       pl = emat(lfock,lfock)/linear
      97       emat(nfock1,nfock1) = 0.D0
      98       if (emat(lfock, lfock) < 1.d-20) return
      99       const = 1.D0/emat(lfock,lfock)
     100       emat(:nfock,:nfock) = emat(:nfock,:nfock)*const
     101       if (debug) then
     102         write (iw, '('' EMAT'')')
     103         do i = 1, nfock1
     104           write (iw, '(6E13.6)') (emat(j,i),j=1,nfock1)
     105         end do
     106       end if
     107       l = 0
     108       do i = 1, nfock1
     109         evec(l+1:nfock1+l) = emat(i,:nfock1)
     110         l = nfock1 + l
     111       end do
 
 FORCHECK PC V13.5.13          PULAY           2021-03-24 10:59:30   page:   492
 pulay.F90  /FF
 
     112       const = 1.D0/const
     113       emat(:nfock,:nfock) = emat(:nfock,:nfock)*const
     114 !********************************************************************
     115 !   THE MATRIX EMAT SHOULD HAVE FORM
     116 !
     117 !      |<E(1)*E(1)>  <E(1)*E(2)> ...   -1.0|
     118 !      |<E(2)*E(1)>  <E(2)*E(2)> ...   -1.0|
     119 !      |<E(3)*E(1)>  <E(3)*E(2)> ...   -1.0|
     120 !      |<E(4)*E(1)>  <E(4)*E(2)> ...   -1.0|
     121 !      |     .            .      ...     . |
     122 !      |   -1.0         -1.0     ...    0. |
     123 !
     124 !   WHERE <E(I)*E(J)> IS THE SCALAR PRODUCT OF [F*P] FOR ITERATION I
     125 !   TIMES [F*P] FOR ITERATION J.
     126 !
     127 !********************************************************************
     128       call osinv (evec, nfock1, d)
     129       if (abs(d) < 1.D-6) then
     130         start = .TRUE.
     131         return
     132       end if
     133       if (nfock < 2) return
     134       il = nfock*nfock1
     135       coeffs(:nfock) = -evec(1+il:nfock+il)
     136       if (debug) then
     137         write (iw, '('' EVEC'')')
     138         write (iw, '(6F12.6)') (coeffs(i),i=1,nfock)
     139         write (iw, '(''    LAGRANGIAN MULTIPLIER (ERROR) =''
                ,F13.6)') evec(nfock1*nfock1)
     140       end if
     141       do i = 1, linear
     142         sum = 0.D0
     143         l = 0
     144         ii = (i - 1)*mfock
     145         do j = 1, nfock
     146           sum = sum + coeffs(j)*fock(j+ii)
     147         end do
     148         f(i) = sum
     149       end do
     150       return
     151       end subroutine pulay
 
