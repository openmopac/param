    2362   !
    2363     subroutine prn3lb (n, x, f, task, iprint, info, itfile, iter, nfgv,
  &
    2364    & nintol, nskip, nact, sbgnrm, time, nint, word, iback, stp, xstep,
 k, &
    2365    & cachyt, sbtime, lnscht)
    2366
    2367       use chanel_C, only: iw
