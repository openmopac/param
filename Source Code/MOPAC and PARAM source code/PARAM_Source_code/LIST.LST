     193   subroutine all_h_bonds(hblist1, hblist2, hblist3, max_h_bonds, nrpair
 s)
     194 !
     195 !  all_h_bonds detects all potential hydrogen bonds.  A hydrogen bond i
 s a set of three atoms,
     196 !  an oxygen or nitrogen, a hydrogen, and an oxygen or nitrogen atom.
 The hydrogen atom must
     197 ! be within RAH Angstroms of either an oxygen or a nitrogen atom.
     198 !
     199 !  On exit:
     200 !
     201 !    nrpairs: number of pairs of atoms
     202 !    hblist1: Atom number of oxygen or nitrogen attached to hydrogen
     203 !    hblist2: Atom number of hydrogen atom involved in hydrogen bonding
     204 !    hblist3: Atom number ofoxygen or nitrogen hydrogen bonded to the h
 ydrogen atom
     205 !
     206 !
     207   use common_arrays_C, only: bonding_a_h, bonding_b_h, acceptor_a, acce
 ptor_b
     208   use molkst_C, only : numat, line, moperr
     209   use chanel_C, only : iw
     210   implicit none
     211     integer, intent (in) :: max_h_bonds
     212     integer, intent (out) :: hblist1(max_h_bonds), hblist2(max_h_bonds)
 , hblist3(max_h_bonds), nrpairs
     213 !
     214 !  Local variables
     215 !
     216     integer :: i, nacceptor_a, nbonding_a_h
     217 !
     218 !  Work out list of of potential hydrogen bonds
     219 !
     220 !   First, find all N-H and O-H groups
     221 !
     222     if (allocated(acceptor_a))   deallocate(acceptor_a)
     223     if (allocated(acceptor_b))   deallocate(acceptor_b)
     224     if (allocated(bonding_a_h))  deallocate(bonding_a_h)
     225     if (allocated(bonding_b_h))  deallocate(bonding_b_h)
