       1       subroutine symh(h, dip, i, n, ipo)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use symmetry_C, only : r
       6       USE molkst_C, ONLY: numat
       7 !**********************************************************************
 *
       8 !-----------------------------------------------
       9 !   I n t e r f a c e   B l o c k s
      10 !-----------------------------------------------
      11       implicit none
      12 !-----------------------------------------------
      13 !   G l o b a l   P a r a m e t e r s
      14 !-----------------------------------------------
      15 !-----------------------------------------------
      16 !   D u m m y   A r g u m e n t s
      17 !-----------------------------------------------
      18       integer , intent(in) :: i
      19       integer , intent(in) :: n
      20       integer, dimension (numat, 120), intent (in) :: ipo
      21       double precision , intent(inout) :: h(*)
      22       double precision , intent(inout) :: dip(3,*)
      23
      24 !-----------------------------------------------
      25 !   L o c a l   V a r i a b l e s
      26 !-----------------------------------------------
      27       integer :: k, i3, i6, k3, k6, j, l, l3, l6, j3, j6, iel33, im1t3,
  istart
      28       double precision, dimension(9) :: temp, temp2
      29       double precision :: fact
      30 !-----------------------------------------------
      31 !****************************************************************
      32 !
      33 !  INPUT:   H()   A packed lower triangular hessian
      34 !           DIP(,) A MATRIX OF DIPOLE TENSORS TO BE SYMM
      35 !           R(,)  A matrix of symmetry operations
      36 !           IPO(,) A matrix of atomic mapping according to R
      37 !           I     The atom (row and column) to add to H()
      38 !           N     The symmetry operation to use to generate I
      39 !
      40 !  OUTPUT:  H()   A packed lower triangular Hessian with information
      41 !                   about atom I added
      42 !           DIP(,) A MATRIX OF DIPOLE TENSORS THAT HAVE BEEN SYMM
      43 !
      44 !****************************************************************
      45 !
      46 !
      47 !  This subroutine will add all necessary information to the Hessian
      48 !    concerning atom I.  Since the Hessian is a packed lower half
      49 !    triangle, the existing information for atom pair (K,L) where K,L
      50 !    < I is fully known, (K > I and L < I) or (vice versa) is half
      51 !    known, K,L > I is completely unknown.
      52 !    Therefore, start in unknown region and make it half known.  Double
      53 !    known values, and move in the diagonal element at full strength.
      54 !
      55 !
      56 !
 
 FORCHECK PC V13.5.13           SYMH           2021-03-24 10:59:30   page:  1894
 symh.F90  /FF
 
      57 !
      58 !
      59 !  Variables used:  (n represents the number of atomic centers)
      60 !     H(3n,3n):  Input/output matrix.  It is a packed lower half triang
 u
      61 !        matrix.  Commonly, the Hessian.
      62 !     TEMP(9), TEMP2(9):   Temporary matricies used to hold small parts
      63 !          larger matricies for specific matrix operations.
      64 !
      65 !    For the next two items, the last indicy represents the symmetry
      66 !        operation number.
      67 !     R(14,*):   The first 9 elements of each record are a packed 3 by
 3
      68 !          array of a given symmetry operations.  Elements 10 - 14 are
 t
      69 !          users input describing the symmetry operation.
      70 !     IPO(n,*):  A vector that contains the symmetry mapping of atomic
 c
      71 !
      72 !
      73       k = ipo(i,n)
      74       i3 = 3*i
      75       i6 = 6*i
      76       k3 = 3*k
      77       k6 = 6*k
      78 !
      79 !  Now, to climb up the matrix
      80       do j = numat, i + 1, -1
      81         l = ipo(j,n)
      82         l3 = 3*l
      83         l6 = 6*l
      84         j3 = 3*j
      85         j6 = 6*j
      86 !
      87 !  Now, to actually perform R H R
      88 !
      89 !  Do this multiplication in a 3 by 3 block at a time.  Store H(i,j) in
      90 !    H( IPO(I,N), IPO(J,N))
      91 !
      92         if (k > l) then
      93           iel33 = (k3*(k3 - 1))/2 + l3
      94           temp(9) = 0.5D0*h(iel33)
      95           temp(8) = 0.5D0*h(iel33-1)
      96           temp(7) = 0.5D0*h(iel33-2)
      97           temp(6) = 0.5D0*h(iel33-k3+1)
      98           temp(5) = 0.5D0*h(iel33-k3)
      99           temp(4) = 0.5D0*h(iel33-k3-1)
     100           temp(3) = 0.5D0*h(iel33-k6+3)
     101           temp(2) = 0.5D0*h(iel33-k6+2)
     102           temp(1) = 0.5D0*h(iel33-k6+1)
     103         else
     104           iel33 = (l3*(l3 - 1))/2 + k3
     105           fact = 1.0D0
     106           if (l < i) fact = 0.5D0
     107           temp(9) = fact*h(iel33)
     108           temp(6) = fact*h(iel33-1)
     109           temp(3) = fact*h(iel33-2)
     110           temp(8) = fact*h(iel33-l3+1)
     111           temp(5) = fact*h(iel33-l3)
 
 FORCHECK PC V13.5.13           SYMH           2021-03-24 10:59:30   page:  1895
 symh.F90  /FF
 
     112           temp(2) = fact*h(iel33-l3-1)
     113           temp(7) = fact*h(iel33-l6+3)
     114           temp(4) = fact*h(iel33-l6+2)
     115           temp(1) = fact*h(iel33-l6+1)
     116         end if
     117 !
     118         call mat33 (r(1,n), temp, temp2)
     119 !
     120         iel33 = (j3*(j3 - 1))/2 + i3
     121         h(iel33) = temp2(9)
     122         h(iel33-j3+1) = temp2(8)
     123         h(iel33-j6+3) = temp2(7)
     124         h(iel33-1) = temp2(6)
     125         h(iel33-j3) = temp2(5)
     126         h(iel33-j6+2) = temp2(4)
     127         h(iel33-2) = temp2(3)
     128         h(iel33-j3-1) = temp2(2)
     129         h(iel33-j6+1) = temp2(1)
     130       end do
     131 !
     132 !  Now, to do the diagonal term
     133 !
     134       iel33 = (k3*(k3 + 1))/2
     135       temp(9) = 0.5D0*h(iel33)
     136       temp(8) = 0.5D0*h(iel33-1)
     137       temp(7) = 0.5D0*h(iel33-2)
     138       temp(6) = temp(8)
     139       temp(5) = 0.5D0*h(iel33-k3)
     140       temp(4) = 0.5D0*h(iel33-k3-1)
     141       temp(3) = temp(7)
     142       temp(2) = temp(4)
     143       temp(1) = 0.5D0*h(iel33-k6+1)
     144 !
     145       call mat33 (r(1,n), temp, temp2)
     146 !
     147       iel33 = (i3*(i3 + 1))/2
     148       h(iel33) = temp2(9)
     149       h(iel33-1) = temp2(8)
     150       h(iel33-2) = temp2(7)
     151       h(iel33-i3) = temp2(5)
     152       h(iel33-i3-1) = temp2(4)
     153       h(iel33-i6+1) = temp2(1)
     154 !
     155 !   NOW, TO ROTATE THE DIPOLE TENSOR TERM
     156 !
     157       temp(9) = dip(3,k*3)
     158       temp(8) = dip(2,k*3)
     159       temp(7) = dip(1,k*3)
     160       temp(6) = dip(3,k*3-1)
     161       temp(5) = dip(2,k*3-1)
     162       temp(4) = dip(1,k*3-1)
     163       temp(3) = dip(3,k*3-2)
     164       temp(2) = dip(2,k*3-2)
     165       temp(1) = dip(1,k*3-2)
     166 !
     167       call mat33 (r(1,n), temp, temp2)
     168 !
     169       dip(3,i*3) = temp2(9)
     170       dip(2,i*3) = temp2(8)
 
 FORCHECK PC V13.5.13           SYMH           2021-03-24 10:59:30   page:  1896
 symh.F90  /FF
 
     171       dip(1,i*3) = temp2(7)
     172       dip(3,i*3-1) = temp2(6)
     173       dip(2,i*3-1) = temp2(5)
     174       dip(1,i*3-1) = temp2(4)
     175       dip(3,i*3-2) = temp2(3)
     176       dip(2,i*3-2) = temp2(2)
     177       dip(1,i*3-2) = temp2(1)
     178 !
     179 !   Now, to double all existing values going across
     180 !
     181       im1t3 = (i - 1)*3
     182       istart = (im1t3*(im1t3 + 1))/2 + 1
     183       h(istart:iel33) = h(istart:iel33) + h(istart:iel33)
     184 !  Everything is now done for this symmetry element.
     185 !
     186       return
     187       end subroutine symh
 
