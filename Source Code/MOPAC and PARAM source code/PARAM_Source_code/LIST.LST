     721   subroutine normal_multipoles (x0, y0, z0, ind, n, pmn, y_norm, &
     722        & c, nc, q, psi, p)
     723     !
     724     !.. Implicit Declarations ..
     725     implicit none
     726     !
     727     !.. Formal Arguments ..
     728     double precision, intent(in) :: x0, y0, z0
     729     integer, intent(in) :: n, nc, p
     730     integer, dimension(*), intent(in) :: ind
     731     double precision, dimension(nc, *), intent(in) :: c
     732     double precision, dimension(*), intent(in) :: q
     733     double precision, dimension(-p:p, 0:p), intent(in) :: y_norm
     734     double precision, dimension(-p:p, 0:p), intent(inout) :: pmn
     735     complex (kind=dcmplx_kind), dimension(-p:p, 0:p), intent(inout) ::
 psi
     736     !
     737     !.. Local Scalars ..
     738     double precision :: dx, dy, dz, t, tt, r, cos_t, phi
     739     complex (kind=dcmplx_kind) :: tc, tc1
     740     integer :: j, k, n1, m1
     741     !
     742     !.. Intrinsic Functions ..
     743     intrinsic Sqrt, Atan2, Exp, Cmplx, Conjg
     744     !
     745     ! ... Executable Statements ...
     746
     747     do j = 1, n
     748       k = ind(j)
     749       dx = c(1, k) - x0
     750       dy = c(2, k) - y0
     751       dz = c(3, k) - z0
     752       r = Sqrt (dx**2 + dy**2 + dz**2)
     753       cos_t = dz / r
     754       phi = Atan2 (dy, dx)
     755
     756       call get_legendre (p, cos_t, pmn)
     757
     758       psi(0, 0) = psi(0, 0) + Cmplx (q(k), 0.d0, dcmplx_kind)
     759
     760       t = 1.d0
     761       do n1 = 1, p
     762         t = t * r
     763         do m1 = 0, n1
     764           tc = Exp (Cmplx (0.d0, -m1*phi, dcmplx_kind))
     765           tt = y_norm(-m1, n1) * pmn(-m1, n1) * t * q(k)
     766           tc1 = tc * tt
     767           psi(m1, n1) = psi(m1, n1) + tc1
     768         end do
     769       end do
     770
     771       do n1 = 1, p
     772         do m1 = 1, n1
     773           psi(-m1, n1) = Conjg (psi(m1, n1))
     774         end do
     775       end do
     776     end do
     777
 
