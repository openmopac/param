      22    !
      23    !*******************************************************************
 ****
      24    !
      25    !                   The Occupied Set
      26    !
      27    !  COCC:     Starting localized filled M.O.s        Atomic Orbitals
      28    !  NCOCC:    Starting address of the filled LMOs    Atomic Orbitals
      29    !  ICOCC:    Atom indices for the filled LMOs       Atoms
      30    !  NCF:      Number of atoms in each filled LMO     Atoms
      31    !  NNCF:     Starting address of each M.O. in NCF   Atoms
      32    !
      33    !                   The Virtual Set
      34    !
      35    !  CVIR:     Starting localized empty M.O.s         Atomic Orbitals
      36    !  NCVIR:    Starting address of the empty LMOs     Atomic Orbitals
      37    !  ICVIR:    Atom indices for the empty LMOs        Atoms
      38    !  NCE:      Number of atoms in each empty LMO      Atoms
      39    !  NNCE:     Starting address of each M.O. in NCE   Atoms
      40    !
      41    !*******************************************************************
 ****
      42     character :: xchar = " "
      43     logical, save :: prtpls, orthog, times, scf1, bigscf, debug, prtden
 , &
      44          & prtfok, okscf, opend, panic = .true., store_useps
      45     integer, save :: i, idnout, nocc1, nvir1, istabl, idiagg, nhb, itrm
 ax, &
      46       niter, lno, iemax, iemin, lnv, mn, indi, j, k, l, nij = 0, re_loc
 al, &
      47       icalcn = 0, imol = 0, nmol = 0, lstart = 0, add_niter
