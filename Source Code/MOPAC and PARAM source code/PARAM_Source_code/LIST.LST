    2611       subroutine makeuf(u, uold, g, eigs, last, norbs, nclose, diff, at
 ol)
    2612 !-----------------------------------------------
    2613 !   M o d u l e s
    2614 !-----------------------------------------------
    2615       use funcon_C, only : ev
    2616        USE polar_C, only : omega
    2617 !-----------------------------------------------
    2618 !   I n t e r f a c e   B l o c k s
    2619 !-----------------------------------------------
    2620       implicit none
    2621 !-----------------------------------------------
    2622 !   D u m m y   A r g u m e n t s
    2623 !-----------------------------------------------
    2624       integer  :: norbs
    2625       integer , intent(in) :: nclose
    2626       double precision , intent(out) :: diff
    2627       double precision , intent(in) :: atol
    2628       logical , intent(out) :: last
    2629       double precision  :: u(norbs,norbs)
    2630       double precision , intent(inout) :: uold(norbs,norbs)
    2631       double precision , intent(in) :: g(norbs,norbs)
    2632       double precision , intent(in) :: eigs(norbs)
    2633 !-----------------------------------------------
    2634 !   L o c a l   V a r i a b l e s
    2635 !-----------------------------------------------
    2636       integer :: k, i, j
    2637       double precision :: hartr, udif
    2638 !-----------------------------------------------
    2639 !
    2640 !  THIS SUBROUTINE CREATES THE NEW TRANSFORMATION MATRIX U
    2641 !  AND THEN CHECKS FOR CONVERGENCE
    2642 !
    2643       hartr = ev
    2644 !
    2645 !  ZERO MATRIX INITIALLY
    2646 !
    2647       call zerom (u, norbs)
    2648 !
    2649 !  CREATE OFF-DIAGONAL BLOCKS
    2650 !
    2651      do k = nclose + 1, norbs
    2652       do i = 1, nclose
    2653         u(i, k) = hartr * g(i, k) / (eigs(k)-eigs(i)-omega)
    2654         u(k, i) = hartr * g(k, i) / (eigs(i)-eigs(k)-omega)
    2655       end do
    2656     end do
    2657 !
    2658 !  CHECK FOR CONVERGENCE
    2659 !
    2660       diff = 0.0D00
    2661       do i = 1, norbs
    2662         do j = 1, norbs
    2663           udif = abs(u(i,j)-uold(i,j))
    2664           diff = dmax1(udif,diff)
    2665         end do
    2666       end do
    2667       if (diff < atol) last = .TRUE.
 
 FORCHECK PC V13.5.13          MAKEUF          2021-03-24 10:59:30   page:  2648
 polar.F90  /FF
 
    2668 !
    2669       uold(:norbs,:norbs) = u(:norbs,:norbs)
    2670 !
    2671       return
    2672       end subroutine makeuf
 
 FORCHECK PC V13.5.13          MAKEUF          2021-03-24 10:59:30   page:  2649
 polar.F90  /FF


