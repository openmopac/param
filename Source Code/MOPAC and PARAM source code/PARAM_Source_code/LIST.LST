       1 subroutine savgeo (loop, geo, na, nb, nc, xparam, loc)
       2 !
       3     use param_global_C, only : contrl, nas, nbs, ncs, geos, &
       4     names, refher, ifiles_8
       5 !
       6     use molkst_C, only : natoms, nvar, keywrd, title, refkey, escf, &
       7       line, ncomments, backslash
       8 !
       9     use common_arrays_C, only : all_comments
      10
      11     implicit none
      12     integer, intent (in) :: loop
      13     integer, dimension (natoms), intent (in) :: na, nb, nc
      14     integer, dimension (2, nvar), intent (in) :: loc
      15     double precision, dimension (nvar), intent (in) :: xparam
      16     double precision, dimension (3, natoms), intent (inout) :: geo
      17 !--------------------------------------------------------------------
      18     character (len=100) :: dirnew
      19     character (len=100) :: name
      20     logical :: opend, lsav, exists
      21     integer :: i, iatm, igeo, j, k, iw
      22     character :: num*1
      23     intrinsic Index
      24     double precision, external :: reada
      25     character, external :: get_a_name*300
      26     save :: iatm, igeo
      27 !--------------------------------------------------------------------
      28   !
      29   !   Check - should the geometry be saved.  Criterion: NEW_REF exists.
      30   !   "lsav" is TRUE if the geometry is to be saved.
      31       lsav = .false.
      32       iw = 14
      33       k = Index (contrl, " NEW_REF=")
      34       if (k /= 0) then
      35         dirnew = trim(get_a_name(trim(contrl(k + 9:)), len_trim(contrl(
 k + 9:))))
      36         k = len_trim(dirnew)
      37         if (dirnew(k:k) /= backslash)then
      38 !
      39 ! The directory name for the new reference data needs a "/"
      40 !
      41           k = k + 1
      42           dirnew(k:k) = backslash
      43         end if
      44         do i = 80, 2, -1
      45           if (names(loop)(i:i) /= " ") exit
      46         end do
      47         name = trim(dirnew) // names (loop) (:i) // ".mop"
      48         inquire (unit=iw, opened=opend)
      49         if (opend) then
      50           close (unit=iw, status="KEEP")
      51         end if
      52         call add_path(dirnew)
      53         inquire (directory=trim(dirnew) , exist = exists)
      54         if (.not. exists) then
      55           write(ifiles_8,'(//10x,a)')"Folder """//trim(dirnew)//""" spe
 cified by NEW_REF does not exist"
      56           write(ifiles_8,'(/10x,a)')"(Either edit or delete ""NEW_REF""
 
 FORCHECK PC V13.5.13          SAVGEO          2021-03-24 10:59:30   page:  1789
 savgeo.F90  /FF
 
  or create the folder.)"
      57           stop
      58         end if
      59         call add_path(name)
      60         open (iw, status="UNKNOWN", file=name, blank="ZERO", err=1000)
      61         write (iw, "(A)", err=1000) " Test"
      62         rewind (iw)
      63         lsav = .true.
      64       end if
      65 !
      66 !  keywrd is 248 characters long, refkey is 360 characters long
      67 !
      68  1000 refkey(1) = trim(keywrd)
      69      do i = 1, nvar
      70       geo(loc(2, i), loc(1, i)) = xparam(i)
      71      end do
      72      line = title
      73      if (Index (contrl, " UPDATE ") /= 0) then
      74 !
      75 ! Replace the old reference heat of formation with the calculated HoF.
      76 !
      77        i = index(title, "H=")
      78        if (i /= 0) then
      79          do j = i + 2, i + 20
      80            if ((ichar(title(j:j)) < ichar("0") .or. ichar(title(j:j)) >
  ichar("9")) .and. &
      81               ichar(title(j:j)) /= ichar("-") .and. ichar(title(j:j)) /
 = ichar(".")) exit
      82          end do
      83          line(100:) = title(j:) ! j = end of number
      84          if (line(i + 3:i + 3) == "-") then
      85            line(i + 3:99) = " "
      86          else
      87             line(i + 2:99) = " "
      88          end if
      89          if (title(j:j) == "+") then
      90 !
      91 ! Re-set escf to difference between calculated error (refher) and that
 supplied
      92 !
      93            escf = reada(title, i + 2) + refher
      94          end if
      95          if (escf > 0.d0) then
      96            i = max(int(log10(escf)),0)
      97            num = char(ichar("5") + i)
      98          else
      99            i = max(int(log10(-escf)),0)
     100            num = char(ichar("6") + i)
     101          end if
     102          write(title,"(a,f"//num//".3,a)")trim(line(:99)), escf, trim(l
 ine(100:199))
     103        end if
     104      end if
     105   !
     106   !  Only write out the geometry if the geometry has been optimized.
     107   !
     108     if (lsav) then
     109       if (Index (contrl, " EXPORT ") /= 0) title = " "
     110       if (index(contrl," LET") /= 0) then
 
 FORCHECK PC V13.5.13          SAVGEO          2021-03-24 10:59:30   page:  1790
 savgeo.F90  /FF
 
     111           i = index(refkey(1)," GEO-OK")
     112           if (i /= 0) refkey(1)(i:i+7) = " "
     113         end if
     114       ncomments = 3
     115       all_comments(1) = "*"
     116       write(all_comments(2),"('*', f10.3)") escf
     117       all_comments(3) = "*"
     118       call geout (iw)
     119       ncomments = 0
     120       close (iw)
     121     end if
     122     if (loop == 1) then
     123       igeo = 0
     124       iatm = 0
     125     end if
     126     do i = 1, natoms
     127       igeo = igeo + 1
     128       do j = 1, 3
     129         geos(j, igeo) = geo(j, i)
     130       end do
     131     end do
     132     do i = 1, natoms
     133       iatm = iatm + 1
     134       nas(iatm) = na(i)
     135       nbs(iatm) = nb(i)
     136       ncs(iatm) = nc(i)
     137     end do
     138 end subroutine savgeo
 
