    1654       subroutine spcore(ni, nj, r, core)
    1655 !-----------------------------------------------
    1656 !   M o d u l e s
    1657 !-----------------------------------------------
    1658       use parameters_C, only : tore, po, ddp
    1659       use funcon_C, only : ev
    1660       implicit none
    1661 !-----------------------------------------------
    1662 !   D u m m y   A r g u m e n t s
    1663 !-----------------------------------------------
    1664       integer , intent(in) :: ni
    1665       integer , intent(in) :: nj
    1666       double precision , intent(in) :: r
    1667       double precision , intent(out) :: core(10,2)
    1668 !-----------------------------------------------
    1669 !   L o c a l   V a r i a b l e s
    1670 !-----------------------------------------------
    1671       integer :: i
    1672       double precision, dimension(7) :: pxy
    1673       double precision, dimension(4) :: ai, aj
    1674       double precision, dimension(7) :: xi, xj
    1675       double precision :: r2, aci, acj, ssi, ssj, ppj, da, qa, twoqa, a
 dj, aqj, ppi&
    1676         , db, qb, adi, aqi, twoqb
    1677 !-----------------------------------------------
    1678 !     *
    1679 !     CALCULATE THE NUCLEAR ATTRACTION INTEGRALS IN LOCAL COORDINATES.
    1680 !     *
    1681       data pxy/ 1.0d0, -0.5d0, -0.5d0, 0.5d0, 0.25d0, 0.25d0, 0.5d0/
    1682       core = 0.d0
    1683 ! *** INITIALIZATION.
    1684       r2 = r*r
    1685       aci = po(9,ni)
    1686       acj = po(9,nj)
    1687 ! *** SS -CORE INTERACTION
    1688       ssi = (aci + po(1,nj))**2
    1689       ssj = (acj + po(1,ni))**2
    1690       core(1,1) = -tore(nj)*ev/sqrt(r2 + ssj)
    1691       core(1,2) = -tore(ni)*ev/sqrt(r2 + ssi)
    1692       if (ni>=3 .or. nj>=3) then
    1693 ! *** NI -  HEAVY ATOM
    1694         if (ni >= 3) then
    1695           ppj = (acj + po(7,ni))**2
    1696           da = ddp(2,ni)
    1697           qa = ddp(3,ni)/sqrt(2.d0)
    1698           twoqa = qa + qa
    1699           adj = (po(2,ni)+acj)**2
    1700           aqj = (po(3,ni)+acj)**2
    1701           xj(1) = r2 + ppj
    1702           xj(2) = r2 + aqj
    1703           xj(3) = (r + da)**2 + adj
    1704           xj(4) = (r - da)**2 + adj
    1705           xj(5) = (r - twoqa)**2 + aqj
    1706           xj(6) = (r + twoqa)**2 + aqj
    1707           xj(7) = r2 + twoqa*twoqa + aqj
    1708           do i = 1, 7
    1709             xj(i) = pxy(i)/sqrt(xj(i))
    1710           end do
 
 FORCHECK PC V13.5.13          SPCORE          2021-03-24 10:59:30   page:  1483
 mndod.F90  /FF
 
    1711           aj(2) = (xj(3)+xj(4))*ev
    1712           aj(3) = (xj(1)+xj(2)+xj(5)+xj(6))*ev
    1713           aj(4) = (xj(1)+xj(2)+xj(7))*ev
    1714           core(2,1) = -tore(nj)*aj(2)
    1715           core(3,1) = -tore(nj)*aj(3)
    1716           core(4,1) = -tore(nj)*aj(4)
    1717         end if
    1718 ! *** NJ- HEAVY ATOM
    1719         if (nj >= 3) then
    1720           ppi = (aci + po(7,nj))**2
    1721           db = ddp(2,nj)
    1722           qb = ddp(3,nj)/sqrt(2.d0)
    1723           adi = (po(2,nj)+aci)**2
    1724           aqi = (po(3,nj)+aci)**2
    1725           twoqb = qb + qb
    1726           xi(1) = r2 + ppi
    1727           xi(2) = r2 + aqi
    1728           xi(3) = (r + db)**2 + adi
    1729           xi(4) = (r - db)**2 + adi
    1730           xi(5) = (r - twoqb)**2 + aqi
    1731           xi(6) = (r + twoqb)**2 + aqi
    1732           xi(7) = r2 + twoqb*twoqb + aqi
    1733           do i = 1, 7
    1734             xi(i) = pxy(i)/sqrt(xi(i))
    1735           end do
    1736           ai(2) = -(xi(3)+xi(4))*ev
    1737           ai(3) = (xi(1)+xi(2)+xi(5)+xi(6))*ev
    1738           ai(4) = (xi(1)+xi(2)+xi(7))*ev
    1739           core(2,2) = -tore(ni)*ai(2)
    1740           core(3,2) = -tore(ni)*ai(3)
    1741           core(4,2) = -tore(ni)*ai(4)
    1742         end if
    1743       end if
    1744       return
    1745       end subroutine spcore
 
