       1       subroutine chrge(p, q)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use common_arrays_C, only:  nfirst, nlast
       6       use molkst_C, only: numat, norbs, mozyme
       7 !**********************************************************************
 *
       8       implicit none
       9 !-----------------------------------------------
      10 !   G l o b a l   P a r a m e t e r s
      11 !-----------------------------------------------
      12 !-----------------------------------------------
      13 !   D u m m y   A r g u m e n t s
      14 !-----------------------------------------------
      15
      16       double precision , intent(out) :: q(numat)
      17       double precision , intent(in) :: p((norbs*(norbs+1))/2)
      18 !-----------------------------------------------
      19 !   L o c a l   P a r a m e t e r s
      20 !-----------------------------------------------
      21 !-----------------------------------------------
      22 !   L o c a l   V a r i a b l e s
      23 !-----------------------------------------------
      24       integer :: k, i, ia, ib, j
      25 !-----------------------------------------------
      26 !**********************************************************************
 *
      27 !
      28 !      CHRGE STORES IN Q THE TOTAL ELECTRON DENSITIES ON THE ATOMS
      29 !
      30 !      ON INPUT P      = DENSITY MATRIX
      31 !
      32 !      ON OUTPUT Q     = ATOM ELECTRON DENSITIES
      33 !
      34 !**********************************************************************
 *
      35       if (mozyme) then
      36         call chrge_for_MOZYME(p, q)
      37         return
      38       end if
      39       k = 0
      40       do i = 1, numat
      41         ia = nfirst(i)
      42         ib = nlast(i)
      43         q(i) = 0.D0
      44         do j = ia, ib
      45           k = k + j
      46           q(i) = q(i) + p(k)
      47         end do
      48       end do
      49       return
      50       end subroutine chrge
 
