     932             if (ndtype <= 1) then
     933               write (iw, "(i4, 1x, a3, f11.7, f10.0, f10.2, f10.6, 3f11
 .6, f10.6, 3f8.3)") &
     934                 il, nmrep(nst, nptg), eng, freq, wl, fosc, &
     935      &                (dmci(nm, kk)*rmom, kk = 1, 3), &
     936      &                dmtot, (debye*dmci(nmd, kk), kk = 1, 3)
     937             else
     938               write (iw, "(i4, 1x, a3, f11.7, f10.0, f10.2, f10.6, 3f11
 .6, f10.6, 3f8.3)") &
     939                 il, nmrep(nst, nptg), eng, freq, wl, fosc, &
     940      &                (dmci(nm, kk)*rmom, kk = 1, 3)
     941             end if
     942
     943           else if (il > i0) then
     944 !           **** main output to log file, no osc strength ****
     945             if (ndtype <= 1) then
     946               write (iw, '(i4, 1x, a3, f11.7, f10.0, f10.2, f10.6, 33x,
   f10.6, 3f8.3)') &
     947                 il, nmrep(nst, nptg), eng, freq, wl, fosc, &
     948      &                dmtot, (debye*dmci(nmd, kk), kk = 1, 3)
     949             else
     950               write (iw, '(i4, 1x, a3, f11.7, f10.0, f10.2, f10.6, 33x,
   f10.6, 3f8.3)') &
     951                 il, nmrep(nst, nptg), eng, freq, wl, fosc
     952             end if
     953           end if
     954
     955          end if
     956          end do
     957
     958         if (ndtype <= 1) call polout
     959         if (n2phot > 0) call twopho (i0, evalci, dmci, istate)
     960       end do
     961
     962 !     ************************ write out ci matrix ********************
 **
     963 !     RMG add-print major state contributions for all states
     964
     965       wrtconf = 0.04d0
     966       if (index(keywrd, ' WRTCONF') /= 0) then
     967         wrtconf = reada(keywrd, index(keywrd, ' WRTCONF = '))
     968       end if
     969
     970       write (iw, *)
     971       write (iw, *)
     972       write (iw, *) 'Major CI contributions to CI states'
     973       write (iw, *)
     974
     975       do il = 1, nciout
     976         eng = evalci(il) - evalci(1)
     977         write (iw, 1005) 'State ', il, eng
     978
     979 !       Find configurations with large contributions
     980 !
     981         cisum = 0
     982         do i = 1, nconf
     983           if (abs(ci(il, i)) > wrtconf) then
 
 FORCHECK PC V13.5.13          CIOUT           2021-03-24 10:59:30   page:  3993
