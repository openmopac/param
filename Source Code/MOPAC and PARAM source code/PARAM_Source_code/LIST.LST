    1389   subroutine write_paras_used(iwrt)
    1390     use Common_arrays_C, only : nat
    1391     USE parameters_C, only : guess1, guess2, guess3, gpp, gp2, hsp, gss
 , gsp, betas, betap, betad, &
    1392       zs, zp, zd, uss, upp, udd, zsn, zpn, zdn, pocord, alpb, xfac, &
    1393       f0sd, g2sd, main_group, alp
    1394     use molkst_C, only : numat
    1395     implicit none
    1396     integer, intent(in) :: iwrt
    1397 !
    1398 !  Local
    1399 !
    1400     integer :: i, j, k
    1401     logical :: els(107) = .false.
    1402     character :: elemnt(107)*2, num1*1
    1403 !-----------------------------------------------
    1404       data (elemnt(i),i=1,107)/ 'H ', 'HE', 'LI', 'BE', 'B ', 'C ', 'N
 ', 'O '&
    1405         , 'F ', 'NE', 'NA', 'MG', 'AL', 'SI', 'P ', 'S ', 'CL', 'AR', '
 K ', &
    1406         'CA', 'SC', 'TI', 'V ', 'CR', 'MN', 'FE', 'CO', 'NI', 'CU', 'ZN
 ', 'GA'&
    1407         , 'GE', 'AS', 'SE', 'BR', 'KR', 'RB', 'SR', 'Y ', 'ZR', 'NB', '
 MO', &
    1408         'TC', 'RU', 'RH', 'PD', 'AG', 'CD', 'IN', 'SN', 'SB', 'TE', 'I
 ', 'XE'&
    1409         , 'CS', 'BA', 'LA', 'CE', 'PR', 'ND', 'PM', 'SM', 'EU', 'GD', '
 TB', &
    1410         'DY', 'HO', 'ER', 'TM', 'YB', 'LU', 'HF', 'TA', 'W ', 'RE', 'OS
 ', 'IR'&
    1411         , 'PT', 'AU', 'HG', 'TL', 'PB', 'BI', 'PO', 'AT', 'RN', 'FR', '
 RA', &
    1412         'AC', 'TH', 'PA', 'U ', 'NP', 'PU', 'AM', 'CM', 'BK', 'MI', 'XX
 ', 'FM'&
    1413         , 'MD', 'CB', '++', '+', '--', '-', 'TV'/
