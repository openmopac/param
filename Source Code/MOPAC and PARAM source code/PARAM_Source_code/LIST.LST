    2020       subroutine daread(v, len, nrec)
    2021 !-----------------------------------------------
    2022 !   M o d u l e s
    2023 !-----------------------------------------------
    2024       use chanel_C, only : iw, idaf, ioda, irecln
    2025 !-----------------------------------------------
    2026 !   I n t e r f a c e   B l o c k s
    2027 !-----------------------------------------------
    2028       implicit none
    2029 !-----------------------------------------------
    2030 !   D u m m y   A r g u m e n t s
    2031 !-----------------------------------------------
    2032       integer , intent(in) :: len
    2033       integer , intent(in) :: nrec
    2034       double precision  :: v(len)
    2035 !-----------------------------------------------
    2036 !   L o c a l   V a r i a b l e s
    2037 !-----------------------------------------------
    2038       integer :: n, is, ns, lent, if, nsp, lenw
    2039 !-----------------------------------------------
    2040 !
    2041       n = ioda(nrec)
    2042       if (n /= (-1)) then
    2043         is = (-irecln) + 1
    2044         ns = n
    2045         lent = len
    2046         is = is + irecln
    2047         if = is + lent - 1
    2048         if (if - is + 1 > irecln) if = is + irecln - 1
    2049         nsp = ns
    2050         lenw = if - is + 1
    2051         call darea1 (v(is), lenw, idaf, nsp)
    2052         lent = lent - irecln
    2053         ns = ns + 1
    2054         n = ns
    2055         do while(lent >= 1)
    2056           is = is + irecln
    2057           if = is + lent - 1
    2058           if (if - is + 1 > irecln) if = is + irecln - 1
    2059           nsp = ns
    2060           lenw = if - is + 1
    2061           call darea1 (v(is), lenw, idaf, nsp)
    2062           lent = lent - irecln
    2063           ns = ns + 1
    2064           n = ns
    2065         end do
    2066         return
    2067       end if
    2068 !
    2069       write (iw, 30) nrec, len
    2070       call mopend (&
    2071         '*** ERROR ***, ATTEMPT TO READ A DAF RECORD THAT WAS NEVER WRI
 TTEN')
    2072 !
