     102   subroutine print_bonds_compact(i_atom,n_non_zero, valenc, bab, ibab)
     103 !
     104 ! Print bonds in a compact form.
     105 ! On input: i_atom = atom number
     106 !           n_non_zero = number of non-zero bonds
     107 !
     108   use molkst_C, only: maxtxt
     109   use common_arrays_C, only : txtatm,nat
     110   use elemts_C, only: elemnt
     111   use chanel_C, only: iw
     112   implicit none
     113   double precision, intent (inout) :: bab(100)
     114   double precision, intent (in) :: valenc
     115   integer, intent (inout) :: ibab(100)
     116   integer, intent (in) :: i_atom, n_non_zero
     117 !
     118   integer :: j, k, m, mtx, nper, ju
     119   double precision :: sum
     120   character :: nc*2, blank*60,  f5p3*4 = "f5.3"
     121   save :: f5p3
     122     if (n_non_zero == 0) return
     123     if (maxtxt /= 0) then
     124       write(nc,'(i2)')maxtxt + 20
     125       mtx = maxtxt + 23
     126       nper = 33
     127     else
     128       mtx = 21
     129       nper = 6
     130     end if
     131     blank = " "
     132     do j = 1, n_non_zero
     133       m = 0
     134       sum = 0.d0
     135       do k = j, n_non_zero
     136         if (bab(k) > sum) then
     137           m = k
     138           sum = bab(k) * (1.d0+1.d-4)
     139         end if
     140       end do
     141       k = ibab(j)
     142       ibab(j) = ibab(m)
     143       ibab(m) = k
     144       sum = bab(j)
     145       bab(j) = bab(m)
     146       bab(m) = sum
     147     end do
     148     ju = Min (nper, n_non_zero)
     149
     150     if (maxtxt /= 0) then
     151       write (iw, "(I6, 1X, A, A, "//f5p3//", A1, F8.3, 2x, a)") i_atom,
  elemnt (nat(i_atom)) &
     152       & //"("// txtatm (i_atom)(:maxtxt)//")", "  (", valenc, ")      "
 , &
     153       & bab(1), elemnt(nat(ibab(1)))//"("//txtatm(ibab(1))(:maxtxt)//")
 "
     154       do j = 2, ju
     155         write(iw,'('//nc//'x, f8.3, 2x, a)') bab(j), elemnt(nat(ibab(j)
 ))//"("//txtatm(ibab(j))(:maxtxt)//")"
 
 FORCHECK PC V13.5.13   PRINT_BONDS_COMPACT    2021-03-24 10:59:30   page:  3504
 bonds_for_MOZYME.F90  /FF
 
     156       end do
     157     else
     158       write (iw, "(I6,1X,A,A,"//f5p3//",')',6(I6,1x,A2,F6.3))") i_atom,
  elemnt(nat(i_atom)), &
     159       "     (", valenc, (ibab(j), elemnt(nat(ibab(j))), &
     160       & bab(j), j=1, ju)
     161       do m = nper + 1, n_non_zero, nper
     162         ju = Min (m+nper-1, n_non_zero)
     163         write (iw, "(A,6(I6,1x,A2,F6.3))") blank (1:mtx), (ibab(j), &
     164         & elemnt(nat(ibab(j))), bab(j), j=m, ju)
     165       end do
     166     end if
     167     write (iw,*)
     168   end subroutine print_bonds_compact
 
