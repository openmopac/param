    1309 !
    1310 subroutine print_conventional_M_O_s(iwrite, compressed, moa_lower, moa_
 upper, mob_lower, mob_upper, fmt9p4, orbs2)
    1311   use common_arrays_C, only : c, cb
    1312   use molkst_C, only : norbs, uhf
    1313   implicit none
    1314   logical :: compressed
    1315   integer :: iwrite, moa_lower, moa_upper, mob_lower, mob_upper
    1316   character :: fmt9p4*5, orbs2*3
    1317 !
    1318 !
    1319   integer :: i, j
    1320   logical :: lnmos, first = .true.
    1321   save :: first
    1322   if (uhf) then
    1323     if (compressed) then
    1324       lnmos = (moa_upper - moa_lower > -1)
    1325       if (lnmos) then
    1326         write(iwrite,"(a,2i8)")" SET_OF_ALPHA_MOS=",moa_lower, moa_uppe
 r
    1327         if (first .and. (moa_lower > 1 .or. moa_upper < norbs)) write(i
 write,"(a)") &
    1328         " # To print all the molecular orbitals, add keyword LARGE or u
 se MOS=99999 in AUX  #"
    1329         do i = moa_lower, moa_upper
    1330           call write_comp_vect(iwrite, c(1,i), norbs, 0.002d0, .false.,
  &
    1331           "ALPHA_MO_INDICES","ALPHA_MO_COEFFICIENTS", fmt9p4)
    1332         end do
    1333       end if
    1334       lnmos = (mob_upper - mob_lower > -1)
    1335       if (lnmos) then
    1336         write(iwrite,"(a,2i8)")" SET_OF_BETA_MOS=",mob_lower, mob_upper
    1337         if (first .and. (mob_lower > 1 .or. mob_upper < norbs)) write(i
 write,"(a)") &
    1338         " # To print all the molecular orbitals, add keyword LARGE or u
 se MOS=99999 in AUX  #"
    1339         do i = mob_lower, mob_upper
    1340           call write_comp_vect(iwrite, cb(1,i), norbs, 0.002d0, .false.
 , &
    1341           "BETA_MO_INDICES","BETA_MO_COEFFICIENTS", fmt9p4)
    1342         end do
    1343       end if
    1344     else
