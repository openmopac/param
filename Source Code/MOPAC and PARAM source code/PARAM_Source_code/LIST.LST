       2       subroutine mxm(a, nar, b, nbr, c, ncc)
       3       implicit none
       4       integer  :: nar
       5       integer  :: nbr
       6       integer  :: ncc
       7       double precision  :: a(nar,nbr)
       8       double precision  :: b(nbr,ncc)
       9       double precision  :: c(nar,ncc)
      10 !
      11 !     RECTANGULAR MATRIX PRODUCT C=A*B.
      12 !     EACH MATRIX IS ENTIRELY FULLFILLED AND PACKED.
      13 !
      14       call dgemm ('N', 'N', nar, ncc, nbr, 1.0D0, a, nar, b, nbr, 0.0D0
 , c, nar)
      15       return
      16       end subroutine mxm
 
