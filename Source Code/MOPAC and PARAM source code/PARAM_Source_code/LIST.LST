     109         else
     110           w2 = -ri(2) * x(1)
     111           w3 = -ri(2) * x(2)
     112           w4 = -ri(2) * x(3)
     113           ki = 4
     114           e1b(2) = -w2 * tore(nj)
     115           e1b(3) = -w1 * tore(nj)
     116           e1b(4) = -w3 * tore(nj)
 
 FORCHECK PC V13.5.13          OUTER2          2021-03-24 10:59:30   page:  3521
 outer2.F90  /FF
 
     117           e1b(6) = -w1 * tore(nj)
     118           e1b(7) = -w4 * tore(nj)
     119           e1b(10) = -w1 * tore(nj)
     120           if (natorb(ni) > 4) then
     121             e1b(15) = e1b(1)
     122             e1b(21) = e1b(1)
     123             e1b(28) = e1b(1)
     124             e1b(36) = e1b(1)
     125             e1b(45) = e1b(1)
