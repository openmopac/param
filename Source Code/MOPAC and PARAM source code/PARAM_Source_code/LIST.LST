     508 !     *****************************************************************
 ******
     509
     510       function ciener (aoi, boi, aoj, boj, c, gamma, nbtmo, beta)
     511
     512 !     **** determines the interaction energy between two necessarily
  ****
     513 !     **** different dets. first is aoi, boi; second is aoj, boj
          ****
     514       use cosmo_C, only : bmat, nden, gden, ipiden, nps, qscnet, useps
     515       use funcon_C, only : a0, ev
     516       use reimers_C, only : n, nb2, matind, ncore, nol, nvh, nov, &
     517           ndiff, io, iv, cc0
     518       use molkst_c, only : mpack
     519
     520       implicit none
     521       integer ::  nbtmo(n)
     522       double precision ::  beta(nb2), c(n, n), gamma(n, n), &
     523                         j12, k12, ciener, e, eec1, align
     524       integer ::           i, j, ivo, j1, ndiffo, ndiffv, a
     525       logical*1 ::         aoi(nov), boi(nov), aoj(nov), boj(nov), &
     526      &                  ao, bo, spno(2), spnv(2), ao1(nov), bo1(nov)
     527       double precision  ::  ediel, fcon, phi(nps), qden(nden), p(mpack)
     528
     529       e = 0.d0
     530
     531 !      ************ determine nber of different electrons ************
     532 !      **** ndiff = total, o = occ in k1 not k2; v = occ in k2 not k1**
 **
     533 !      **** spn = true if alpha ****
     534       ndiff = 0
     535       ndiffo = 0
     536       ndiffv = 0
     537       do j1 = nol, nvh
     538         j = j1 - ncore
     539
     540 !        **** check alpha occupancy ****
     541         if (aoi(j) .neqv. aoj(j)) then
     542           if (ndiff == 4) goto 120
     543           ndiff = ndiff + 1
     544           if (aoi(j)) then
     545             ndiffo = ndiffo + 1
     546             if (ndiffo > 2) goto 120
     547             io(ndiffo) = j1
     548             spno(ndiffo) = .true.
     549           else
     550             ndiffv = ndiffv + 1
     551             if (ndiffv > 2) goto 120
     552             iv(ndiffv) = j1
     553             spnv(ndiffv) = .true.
     554           end if
     555         end if
     556
     557 !       **** check beta occupancy ****
     558         if (boi(j) .neqv. boj(j)) then
     559           if (ndiff == 4) goto 120
     560           ndiff = ndiff + 1
     561           if (boi(j)) then
 
 FORCHECK PC V13.5.13          CIENER          2021-03-24 10:59:30   page:  3981
 ci.F90  /FF
 
     562             ndiffo = ndiffo + 1
     563             if (ndiffo > 2) goto 120
     564             io(ndiffo) = j1
     565             spno(ndiffo) = .false.
     566           else
     567             ndiffv = ndiffv + 1
     568             if (ndiffv > 2) goto 120
     569             iv(ndiffv) = j1
     570             spnv(ndiffv) = .false.
     571           end if
     572         end if
     573
     574       end do
     575
     576       if (ndiff == 2) then
     577 !       ******* differ in one electron, excitn io(1) - >iv(1) ********
     578
     579 !       **** core term sum_j in core (io, iv|j, j) ****
     580         e = e + eec1 (io(1), iv(1), c, gamma, nbtmo)
     581
     582 !       **** (io, iv|j, j) terms with j in xcitn space ****
     583         do j1 = nol, nvh
     584           j = j1 - ncore
     585           ao = aoi(j)
     586           bo = boi(j)
     587           if (j1 == io(1) .or. j1 == iv(1)) then
     588 !           **** remove the electon thats changing from sum ****
     589             if (spno(1)) then
     590               ao = .false.
     591             else
     592               bo = .false.
     593             end if
     594           end if
     595
     596           if (ao .or. bo) then
     597 !           **** calc <i, j||a, j> via J = [i, a|j, j] and K = [i, j|a,
  j] ****
     598             call inttr (io(1), iv(1), j1, j1, &
     599      &          c, gamma, nbtmo, j12, k12, 0)
     600             if (ao .and. bo) then
     601 !                     **** orb k has both electrons occupied ****
     602               e = e + 2.d0*j12 - k12
     603             else if (ao .eqv. spno(1)) then
     604 !              **** one electron, same spin as moving one ****
     605               e = e + j12 - k12
     606             else
     607 !              **** one electron, opp spin to moving one ****
     608               e = e + j12
     609             end if
     610           end if
     611          end do
     612
     613 !        **** add one - electron term ****
     614          ivo = matind (max(io(1), iv(1))) + min(io(1), iv(1))
     615          e = e + beta(ivo)
     616
     617 !        **** determine sign due to reorg of det to line it all up ****
     618 ! Add solvent correction for electron - induced surface charges to beta
 (ivo)
 
 FORCHECK PC V13.5.13          CIENER          2021-03-24 10:59:30   page:  3982
 ci.F90  /FF
 
     619          if (useps) then
     620            ediel = 0.d0
     621            fcon = a0 * ev
     622            a = 0
     623 ! Construct electron density for the product of orbitals
     624            do i = 1, n
     625              do j = 1, i
     626                a = a + 1
     627                p(a) = cc0(iv(1), i)*cc0(io(1), j)
     628              end do
     629            end do
     630 ! Set up charge density for solvation
     631            do i = 1, nden
     632              qden(i) = gden(i) * p(ipiden(i))
     633            end do
     634 ! Compute electrostatic potential at each surface point
     635            do i = 1, nps
     636              phi(i) = 0.d0
     637              do j = 1, nden
     638                phi(i) = phi(i) + bmat(j, i) * qden(j)
     639              end do
     640            end do
     641            do i = 1, nps
     642              ediel = ediel + qscnet(i, 2) * phi(i)
     643            end do
     644            e = e + ediel * fcon
     645           end if
     646
     647 !        **** determine sign due to reorg of det to line it all up ****
     648          e = e * align (iv(1) - ncore, io(1) - ncore, spno(1), aoi, boi
 )
     649
     650
     651        else
     652 !        ********* dets differ by two electrons ***********
     653
     654          if (spno(1) .neqv. spnv(1) ) then
     655 !          **** ensure io(1) and iv(1) are same spin ****
     656            j = iv(1)
     657            iv(1) = iv(2)
     658            iv(2) = j
     659          end if
     660 !        *** calc <ij||ab> = <ib||aj> via J = [i, a|b, j] and K = [ib|a
 j] ****
     661         call inttr (io(1), iv(1), iv(2), io(2), c, gamma, nbtmo, &
     662       &              j12, k12, 0)
     663         e = j12
     664         if (spno(1) .eqv. spno(2)) e = e - k12
     665
     666 !       **** determine sign due to reorg of det, electron 1 ****
     667         e = e * align (iv(1) - ncore, io(1) - ncore, spno(1), aoi, boi)
     668
     669 !       **** determine change to det k1 after this rearrangement ****
     670         do i = 1, nov
     671           ao1(i) = aoi(i)
     672           bo1(i) = boi(i)
     673         end do
     674         if (spno(1)) then
     675           ao1(io(1) - ncore) = .false.
 
 FORCHECK PC V13.5.13          CIENER          2021-03-24 10:59:30   page:  3983
 ci.F90  /FF
 
     676           ao1(iv(1) - ncore) = .true.
     677         else
     678           bo1(io(1) - ncore) = .false.
     679           bo1(iv(1) - ncore) = .true.
     680         end if
     681
     682 !       **** determine sign due to reorg of det, electron 2 ****
     683         e = e * align (iv(2) - ncore, io(2) - ncore, spno(2), ao1, bo1)
     684
     685       end if
     686
     687 120   continue
     688       ciener = e
     689       return
     690       end function ciener
 
