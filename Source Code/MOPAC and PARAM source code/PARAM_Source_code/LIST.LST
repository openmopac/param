       1 subroutine kab_for_MOZYME (ia, ja, pk, w, f)
       2     implicit none
       3     integer, intent (in) :: ia, ja
       4     double precision, dimension (16), intent (in) :: pk
       5     double precision, dimension (100), intent (in) :: w
       6     double precision, dimension (*), intent (inout) :: f
       7     integer :: i, j, j1, j2, j3, m
       8     integer, dimension (16, 16) :: kkind
       9     double precision, dimension (16) :: sum
      10     data kkind / 1, 2, 4, 7, 11, 12, 14, 17, 31, 32, 34, 37, 61, 62, 64
 , 67, &
      11    & 2, 3, 5, 8, 12, 13, 15, 18, 32, 33, 35, 38, 62, 63, 65, 68, 4, 5,
 6, 9, &
      12    & 14, 15, 16, 19, 34, 35, 36, 39, 64, 65, 66, 69, 7, 8, 9, 10, 17, 1
 8, 19, &
      13    & 20, 37, 38, 39, 40, 67, 68, 69, 70, 11, 12, 14, 17, 21, 22, 24, 27
 , 41, &
      14    & 42, 44, 47, 71, 72, 74, 77, 12, 13, 15, 18, 22, 23, 25, 28, 42, 43
 , 45, &
      15    & 48, 72, 73, 75, 78, 14, 15, 16, 19, 24, 25, 26, 29, 44, 45, 46, 49
 , 74, &
      16    & 75, 76, 79, 17, 18, 19, 20, 27, 28, 29, 30, 47, 48, 49, 50, 77, 78
 , 79, &
      17    & 80, 31, 32, 34, 37, 41, 42, 44, 47, 51, 52, 54, 57, 81, 82, 84, 87
 , 32, &
      18    & 33, 35, 38, 42, 43, 45, 48, 52, 53, 55, 58, 82, 83, 85, 88, 34, 35
 , 36, &
      19    & 39, 44, 45, 46, 49, 54, 55, 56, 59, 84, 85, 86, 89, 37, 38, 39, 40
 , 47, &
      20    & 48, 49, 50, 57, 58, 59, 60, 87, 88, 89, 90, 61, 62, 64, 67, 71, 72
 , 74, &
      21    & 77, 81, 82, 84, 87, 91, 92, 94, 97, 62, 63, 65, 68, 72, 73, 75, 78
 , 82, &
      22    & 83, 85, 88, 92, 93, 95, 98, 64, 65, 66, 69, 74, 75, 76, 79, 84, 85
 , 86, &
      23    & 89, 94, 95, 96, 99, 67, 68, 69, 70, 77, 78, 79, 80, 87, 88, 89, 90
 , 97, &
      24    & 98, 99, 100 /
      25     do j = 1, 16
      26       sum(j) = 0.0d0
      27       do i = 1, 16
      28         sum(j) = sum(j) + pk(i) * w(kkind(i, j))
      29       end do
      30     end do
      31    !
      32     if (ia > ja) then
      33       !
      34       !   IA IS GREATER THAN JA, THEREFORE USE HALF OF TRIANGLE
      35       !
      36       m = 0
      37       do j1 = ia, ia + 3
      38         j = (j1*(j1-1)) / 2
      39         do j2 = ja, ja + 3
      40           m = m + 1
      41           j3 = j + j2
      42           f(j3) = f(j3) - sum(m)
      43         end do
      44       end do
 
 FORCHECK PC V13.5.13      KAB_FOR_MOZYME      2021-03-24 10:59:30   page:   239
 kab_for_MOZYME.F90  /FF
 
      45     else if (ia < ja) then
      46       !
      47       !   IA IS LESS THAN JA, THEREFORE USE OTHER HALF OF TRIANGLE
      48       !
      49       m = 0
      50       do j1 = ia, ia + 3
      51         do j2 = ja, ja + 3
      52           m = m + 1
      53           j3 = (j2*(j2-1)) / 2 + j1
      54           f(j3) = f(j3) - sum(m)
      55         end do
      56       end do
      57     else
      58       !
      59       !   MOZYME - type - array elements are stored simply.
      60       !   (The factor of 0.5 is because MOZYME uses only the
      61       !    TOTAL density matrix.)
      62       !
      63       do i = 1, 16
      64         f(i) = f(i) - sum(i) * 0.5d0
      65       end do
      66     end if
      67 end subroutine kab_for_MOZYME
 
