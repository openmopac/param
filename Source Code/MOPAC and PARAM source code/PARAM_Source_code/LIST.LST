     102   logical function PLS_faulty()
     103 !
     104 !  When some systems are run using MOZYME, the DIAGG1 - DIAGG2 combinat
 ion fails to converge,
     105 !  and the ovmax converges to a non-zero minimum.  If the job is stoppe
 d and a <file>.den
     106 !  is generated, then on restarting the same job, the fault is automati
 cally corrected.
     107 !
     108 !  PLS_faulty detects the conditions of the failure, at run time, and s
 ilently writes out
     109 !  the <file>.den, then after reading in the same file, it re-runs the
 SCF calculation.
     110 !  This corrects the fault.
     111 !
     112     use MOZYME_C, only : ovmax
     113     use molkst_C, only : escf
     114     implicit none
     115     integer :: loop = -1, j = 0
     116     integer, parameter :: loop_lim = 6
     117     double precision :: ovmax_old = 0.d0, array_ovmax(loop_lim), escf_o
 ld = 0.d0, array_escf(loop_lim)
     118     save
     119     if (loop == -1) then
     120       array_ovmax = 10.d0
     121       array_escf = 10.d0
     122       loop = 0
     123     else
     124       loop = loop + 1
     125       if (loop == loop_lim + 1) then
     126         do loop = 2, loop_lim
     127           array_ovmax(loop - 1) = array_ovmax(loop)
     128           array_escf(loop - 1) = array_escf(loop)
     129         end do
     130         loop = loop_lim
     131       end if
     132       array_ovmax(loop) = abs(ovmax - ovmax_old)
     133       ovmax_old = ovmax
     134       array_escf(loop) = abs(escf - escf_old)
     135       escf_old = escf
     136       do j = 1, loop
     137         if (array_ovmax(j) > 0.01d0) exit
     138       end do
     139       if (j <= loop) then
     140         do j = 1, loop
     141           if (array_escf(j) > 0.1d0) exit
     142         end do
     143       end if
     144     end if
     145 !
     146 !  Check to see if (a) ovmax (PLS) has converged, and (b) that ovmax is
  not near zero.
     147 !
     148     PLS_faulty = (j > loop .and. ovmax > 0.1d0)
     149     if (j > loop  .and. ovmax > 0.1d0) then
     150 !
     151 !  Deliberately overwrite array_ovmax with different numbers.
     152 !  This prevents the appearance of convergance, for loop_lim iterations
 
 FORCHECK PC V13.5.13        PLS_FAULTY        2021-03-24 10:59:30   page:  3441
 isitsc.F90  /FF
 
 .
     153 !
     154       do j = 1, loop_lim
     155         array_ovmax(j) = j
     156         array_escf(j) = j
     157       end do
     158     end if
     159     return
     160   end function PLS_faulty
 
