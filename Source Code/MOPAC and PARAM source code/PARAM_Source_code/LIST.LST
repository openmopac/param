    2481   subroutine precondition_solve (m, z, r, n)
    2482
    2483     use molkst_C, only : numat
    2484
    2485     !
    2486     !.. Implicit Declarations ..
    2487     implicit none
    2488     integer, intent (in) :: n
    2489     double precision, dimension(n), intent(in) :: r
    2490     double precision, dimension(*), intent(in) :: m
    2491     double precision, dimension(n), intent(out) :: z
    2492     integer :: i, ndim, ipos
    2493     if (use_a_blocks) then
    2494       ipos = 1
    2495       do i=1, numat
    2496         ndim = npoints(i+1) - npoints(i)
    2497         if (ndim > 0) then
    2498           call mult_triangle_vec (m(iblock_pos(i)) , r(ipos) , ndim, &
    2499             & z(ipos))
    2500           ipos = ipos + ndim
    2501         end if
    2502       end do
    2503     else
    2504       z(1:n) = r(1:n) * m(1:n)
    2505     end if
    2506
    2507   end subroutine precondition_solve
 
