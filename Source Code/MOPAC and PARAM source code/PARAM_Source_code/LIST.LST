      22   if (first) then
      23     first = .false.
      24     dh2_a_parameters(1) = 1.48d0    ! Nitrogen
      25     dh2_a_parameters(2) = 1.56d0    ! Oxygen, generic
      26     dh2_a_parameters(3) = 1.55d0    ! Oxygen, acid
      27     dh2_a_parameters(4) = 0.96d0    ! Oxygen, peptide
      28     dh2_a_parameters(5) = 0.76d0    ! Oxygen, water
      29     dh2_a_parameters(6) = 0.85d0    ! Sulfur
      30   end if
      31   EC_plus_ER = 0.d0
      32   EC = 0.d0
      33   ER = 0.d0
