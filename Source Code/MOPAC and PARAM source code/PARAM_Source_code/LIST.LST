     136     else
     137 !
     138 !   SOLID SYSTEM
     139 !
     140       if (icalcn /= numcal) then
     141         icalcn = numcal
     142         cutof2 = clower**2
     143       end if
     144       do i = 1, 10
     145         e1b(i) = 0.d0
     146         e2a(i) = 0.d0
     147       end do
     148       si = (natorb(ni) > 1)
     149       sj = (natorb(nj) > 1)
     150       ki = 1
     151       if (si .or. sj) then
