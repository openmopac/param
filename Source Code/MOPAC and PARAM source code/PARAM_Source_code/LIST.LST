     659 subroutine coscl2 (a, id, x, y, n)
     660    ! THIS ROUTINE SOLVES THE LINEAR SYSTEM CX = Y BASED ON
     661    ! CHOLESKY FACTORIZATION
     662    ! INPUT:   A = UPPER TRIANGLE OF CHOLESKY MATRIX
     663    ! INPUT:   Y = VECTOR OF LENGTH N
     664    !         ID = INTEGER VECTOR OF LENGTH N CONTAINING THE INDICES I(I
  - 1)
     665    ! OUTPUT:  X = VECTOR OF LENGTH N
     666     implicit none
     667     integer, intent (in) :: n
     668     double precision, dimension (*), intent (in) :: a
     669     integer, dimension (n), intent (in) :: id
     670     double precision, dimension (n), intent (out) :: x
     671     double precision, dimension (n), intent (in) :: y
     672     integer :: i, k, kk
     673     double precision :: summe
     674     x = 0.d0
     675     do k = 1, n
     676       summe = y(k)
     677       kk = id(k)
     678       do i = k - 1, 1, - 1
     679         summe = summe - a(i + kk) * x(i)
     680       end do
     681       x(k) = summe * a(k + kk)
     682     end do
     683     do k = n, 1, - 1
     684       summe = x(k)
     685       do i = k + 1, n
     686         summe = summe - a(k + id(i)) * x(i)
     687       end do
     688       x(k) = summe * a(k + id(k))
     689     end do
     690 end subroutine coscl2
 
