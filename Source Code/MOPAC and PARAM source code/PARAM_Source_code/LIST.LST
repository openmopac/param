       2       subroutine esp()
       3 !-----------------------------------------------
       4 !   M o d u l e s
       5 !-----------------------------------------------
       6       use molkst_C, only : keywrd, moperr
       7       use chanel_C, only : iw
       8       use esp_C, only : scale, den, nesp
       9 !**********************************************************************
 *
      10 !-----------------------------------------------
      11 !   I n t e r f a c e   B l o c k s
      12 !-----------------------------------------------
      13       implicit none
      14 !-----------------------------------------------
      15 !   L o c a l   V a r i a b l e s
      16 !-----------------------------------------------
      17       integer :: n, i
      18       double precision :: scincr, time1
      19       double precision, external :: reada, seconds
      20 !-----------------------------------------------
      21       time1 = seconds (1)
      22       if (index(keywrd, " CUBE") /= 0 .or. index(keywrd, " ESPGRID") /=
  0) then
      23         call new_esp()
      24         return
      25       end if
      26 !
      27 !     SET STANDARD PARAMETERS FOR THE SURFACE GENERATION
      28 !
      29       if (index(keywrd,'SCALE=') /= 0) then
      30         scale = reada(keywrd,index(keywrd,'SCALE='))
      31       else
      32         scale = 1.4D0
      33       end if
      34 !
      35       if (index(keywrd,'DEN=') /= 0) then
      36         den = reada(keywrd,index(keywrd,'DEN='))
      37       else
      38         den = 1.0D0
      39       end if
      40 !
      41       if (index(keywrd,'SCINCR=') /= 0) then
      42         scincr = reada(keywrd,index(keywrd,'SCINCR='))
      43       else
      44         scincr = 0.20D0
      45       end if
      46 !
      47       if (index(keywrd,'NSURF=') /= 0) then
      48         n = nint(reada(keywrd,index(keywrd,'NSURF=')))
      49       else
      50         n = 4
      51       end if
      52 !
      53       time1 = seconds(1)
      54 !
      55 !     NOW CALCULATE THE SURFACE POINTS
      56 !
      57       call setup_esp(1)
 
 FORCHECK PC V13.5.13           ESP            2021-03-24 10:59:30   page:  3202
 esp.F90  /FF
 
      58       nesp = 0
      59       if (index(keywrd,'WILLIAMS') /= 0) then
      60         call pdgrid ()
      61         if (moperr) return
      62       else
      63         do i = 1, n
      64           call surfac ()
      65           if (moperr) return
      66           scale = scale + scincr
      67         end do
      68       end if
      69 !
      70 !     NEXT CALCULATE THE ESP AT THE POINTS CALCULATED BY SURFAC
      71 !
      72       call potcal ()
      73 !
      74 !     END OF CALCULATION
      75 !
      76       time1 = seconds(1) - time1
      77       write (iw, 20) 'TIME TO CALCULATE ESP:', time1, ' SECONDS'
      78    20 format(/,9x,a,f8.2,a)
      79       return
      80       end subroutine esp
 
