     371       toang = au2ang**3
     372       write (iw, *)
     373       write (iw, 800) 'au  ', (pol(j)*conv, j = 1, 6)
     374       write (iw, 800) 'A**3', (pol(j)*conv*toang, j = 1, 6)
     375
     376       return
     377 800   format (' Polarizability (', a4, ') xx=', f8.2, &
     378      & ' xy=', f8.2, ' yy=', f8.2, ' xz=', f8.2, ' yz=', f8.2, ' zz=',
 f8.2)
