      74 !     *****************************************************************
 ********
      75       subroutine stgamm (gamma, g1)
      76       use reimers_C, only : n, nham
      77
      78       implicit none
      79       double precision ::  g1(n, n), gamma(n, n)
      80       integer ::           i, j
      81
      82 !     **** symmetry - trandforms the gamma (i, i|j, j) and (i, j|i, j)
 matrices ****
      83
      84 !     **** first copy gamma into g1 ****
      85       do i = 1, n
      86         do j = 1, n
      87           g1(i, j) = gamma(i, j)
      88         end do
      89       end do
      90
      91 !     **** transform integrals (i, j|i, j) in upper half ****
      92       if (nham == 2) call st (g1, gamma, 2)
      93
      94 !     **** transform integrals (i, i|j, j) in lower half ****
      95       call st (g1, gamma, 1)
      96
      97       return
      98       end subroutine stgamm
 
