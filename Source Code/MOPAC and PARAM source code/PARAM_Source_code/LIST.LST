 , &
      10           mf2pp, mg2sd, mg1pd, mf2pd, mg3pd, mf2dd, mf4dd, mr1sppd, &
      11           mr2sddd, mr2sdpp, ntrmet, itrmet, nirreg, natt, nte, natm, &
