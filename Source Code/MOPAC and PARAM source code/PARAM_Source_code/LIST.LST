     210   subroutine bz_vec (v)
     211     !
     212     ! Interaction of atom cores with induced charges
     213     !
     214
     215     use molkst_C, only : numat
     216     use common_arrays_C, only: coord, nat
     217     use cosmo_C, only : cosurf, nps
     218     use parameters_C, only: tore
     219     implicit none
     220     double precision, dimension(nps), intent (out) :: v
     221     integer :: i, j
     222     double precision :: t
     223     intrinsic Sqrt
     224
     225
     226     do i = 1, nps
     227       t = 0
     228       do j = 1, numat
     229
     230         t = t + tore(nat(j)) / &
     231              & Sqrt ((coord(1, j) - cosurf(1, i))**2 + &
     232              & (coord(2, j) - cosurf(2, i))**2 + &
     233              & (coord(3, j) - cosurf(3, i))**2)
     234       end do
     235
     236       v(i) = t
     237
     238     end do
     239   end subroutine bz_vec
 
