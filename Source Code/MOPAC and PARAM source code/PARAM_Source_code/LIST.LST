    2422   subroutine amat_diag (coord, srad, numat, cosurf, nps, nar_csm, nsetf
 , &
    2423        & nset, rsc, nipsrs, iatsp, tm, ioldcv, maxrs, lenabc, m)
    2424     !
    2425     ! Computes diagonal elements of the A matrix
    2426     !
    2427
    2428     use cosmo_C, only : dirvec
    2429     use funcon_C, only: pi
    2430     implicit none
    2431     integer, intent(in) :: numat, nps, ioldcv, maxrs, lenabc
    2432
    2433     double precision, dimension(3, numat), intent(in) :: coord
    2434     double precision, dimension(numat), intent(in) :: srad
    2435     double precision, dimension(4, nps), intent(in) :: cosurf
    2436     integer, dimension(lenabc+1), intent(in) :: nar_csm, nsetf, iatsp
    2437     integer, dimension(*), intent(in) :: nset
    2438     double precision, dimension(4, maxrs), intent(in) :: rsc
    2439     integer, dimension(lenabc), intent(in) :: nipsrs
    2440     double precision, dimension(3, 3, numat), intent(in) :: tm
    2441
    2442     double precision, dimension(nps), intent(out) :: m
    2443     integer :: i, ii, k, l, nfl1
    2444     double precision :: aa, fdiag, ri, x1, x2, x3, x4
    2445     double precision, dimension(4, 500, 2) :: finel
    2446     double precision xi(3)
    2447     fdiag = 2.1d0 * Sqrt (Pi)
    2448
    2449     do ii = 1, nps
    2450       i = iatsp(ii)
    2451       ri = srad(i)
    2452       xi(1:3) = coord(1:3, i)
    2453
    2454       call mfinel (ii, 1, finel, nar_csm, nsetf, nset, rsc, &
    2455            & nipsrs, dirvec, tm(1, 1, i), xi, ri, &
    2456            & nfl1, ioldcv, maxrs, lenabc, numat)
    2457       !
    2458       !       Diagonal element
    2459       !
    2460       aa = 0.d0
    2461       do k = 1, nfl1
    2462         aa = aa + fdiag * Sqrt (finel(4, k, 1)**3)
    2463         x1 = finel(1, k, 1)
    2464         x2 = finel(2, k, 1)
    2465         x3 = finel(3, k, 1)
    2466         x4 = finel(4, k, 1)
    2467
    2468         do l = 1, k - 1
    2469           aa = aa + 2 * x4 * finel(4, l, 1) / &
    2470                &  Sqrt ((x1-finel(1, l, 1))**2 + &
    2471                & (x2-finel(2, l, 1))**2 + &
    2472                & (x3-finel(3, l, 1))**2)
    2473         end do
    2474       end do
    2475
    2476       m(ii) = aa / (cosurf(4, ii) **2)
    2477     end do
    2478
 
 FORCHECK PC V13.5.13        AMAT_DIAG         2021-03-24 10:59:30   page:  2301
 linear_cosmo.F90  /FF
 
    2479   end subroutine amat_diag
 
