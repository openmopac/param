     367       write (iw, 220)
     368   220 format(/,' Polarizability Tensor from Heat of Formation:')
     369       apole4(1) = pol_vol(apole4(1))
     370       apole4(3) = pol_vol(apole4(3))
     371       apole4(6) = pol_vol(apole4(6))
     372       i3 = 3
     373       call vecprt (apole4, (-i3))
     374       call rsp (apole4, i3, eigs, vectrs)
     375       call matout (vectrs, eigs, i3, i3, i3)
     376       avgpe4 = (eigs(1)+eigs(2)+eigs(3))/3.D0
     377       avga3 = avgpe4*0.14818D00
