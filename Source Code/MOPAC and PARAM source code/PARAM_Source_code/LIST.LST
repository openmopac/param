       1       subroutine parsav(mode, n, m, q, r, efslst, xlast, iiium)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE molkst_C, ONLY:  keywrd, numat, norbs
       6       USE chanel_C, only : ires, iw, restart_fn
       7       use common_arrays_C, only : aicorr, errfn
       8 !**********************************************************************
 *
       9 !-----------------------------------------------
      10 !   I n t e r f a c e   B l o c k s
      11 !-----------------------------------------------
      12       implicit none
      13 !-----------------------------------------------
      14 !   G l o b a l   P a r a m e t e r s
      15 !-----------------------------------------------
      16 !-----------------------------------------------
      17 !   D u m m y   A r g u m e n t s
      18 !-----------------------------------------------
      19       integer , intent(in) :: mode
      20       integer  :: n, m, iiium(6)
      21       double precision  :: q(n,n)
      22       double precision, dimension(n) :: efslst, xlast
      23       double precision  :: r(n + 2,n + 2)
      24 !-----------------------------------------------
      25 !   L o c a l   P a r a m e t e r s
      26 !-----------------------------------------------
      27 !-----------------------------------------------
      28 !   L o c a l   V a r i a b l e s
      29 !-----------------------------------------------
      30       integer ::  i, j, io_stat, old_numat, old_norbs
      31       logical :: opend
      32 !-----------------------------------------------
      33 !*********************************************************************
      34 !
      35 !   PARSAV SAVES AND RESTORES DATA USED IN NLLSQ GRADIENT MINIMIZATION.
      36 !
      37 !    IF MODE IS 0 DATA ARE RESTORED, IF 1 THEN SAVED.
      38 !
      39 !*********************************************************************
      40       inquire(unit=ires, opened=opend)
      41       if (opend) close(unit=ires, status='KEEP')
      42       open(unit=ires, file=restart_fn, status='UNKNOWN', form=&
      43         'UNFORMATTED', position='asis', iostat = io_stat)
      44       if (io_stat /= 0) then
      45           write(iw,*)" Restart file either does not exist or is not ava
 ilable for reading"
      46           call mopend ("Restart file either does not exist or is not av
 ailable for reading")
      47           return
      48         end if
      49       rewind ires
      50       if (mode == 0) then
      51 !
      52 !  MODE=0: RETRIEVE DATA FROM DISK.
      53 !
      54         write (iw, '(2/10X,''RESTORING DATA FROM DISK''/)')
      55         read (ires, iostat = io_stat) old_numat, old_norbs, (xlast(i),i
 
 FORCHECK PC V13.5.13          PARSAV          2021-03-24 10:59:30   page:  1887
 parsav.F90  /FF
 
 =1,n), m, iiium, efslst, n
      56         if (norbs /= old_norbs .or. numat /= old_numat) then
      57               call mopend("Restart file read in does not match current
 data set")
      58               return
      59         end if
      60         read (ires, iostat = io_stat) ((q(j,i),j=1,m),i=1,m)
      61         read (ires, iostat = io_stat) ((r(j,i),j=1,n),i=1,n)
      62         if (index(keywrd,'AIDER') /= 0) then
      63           read (ires, iostat = io_stat) (aicorr(i),i=1,n)
      64           read (ires, iostat = io_stat) (errfn(i),i=1,n)
      65         end if
      66         if (io_stat /= 0) then
      67           write(iw,*)" Restart file is currupt"
      68           call mopend ("Restart file is currupt")
      69         end if
      70         close(ires)
      71         return
      72       end if
      73       if (mode == 1) then
      74         write (iw, &
      75       '(2/10X,                                              ''- - - - -
  - - TIM&
      76       &E UP - - - - - - -'',2/)')
      77         write (iw, '(10X,A)') ' - THE CALCULATION IS BEING DUMPED TO DI
 SK', &
      78           '   RESTART IT USING THE KEY-WORD "RESTART"'
      79         write (iw, '(/10X,''CURRENT VALUE OF GEOMETRY'',/)')
      80         call geout (iw)
      81       end if
      82       write (ires) numat, norbs, (xlast(i),i=1,n), m, iiium, efslst, n
      83       write (ires) ((q(j,i),j=1,m),i=1,m)
      84       write (ires) ((r(j,i),j=1,n),i=1,n)
      85       if (index(keywrd,'AIDER') /= 0) write (ires) (aicorr(i),i=1,n)
      86       if (index(keywrd,'AIDER') /= 0) write (ires) (errfn(i),i=1,n)
      87 !*****
      88 !     The density matrix is required by ITER upon restart .
      89 !
      90       call den_in_out(1)
      91 !
      92 !*****
      93       close(ires)
      94       return
      95       end subroutine parsav
 
