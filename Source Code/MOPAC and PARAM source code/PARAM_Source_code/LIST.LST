     704   subroutine l_control(txt, nt, mode)
     705 !
     706 !   l_control has two modes:
     707 !
     708 ! (A)  If mode =  1 the word(s) in txt is(are) added to keywrd.  If the
  word in txt already exists
     709 !                   in keywrd, the word in txt would first be deleted f
 rom keywrd.
     710 ! (B)  If mode = -1 the word(s) in txt is(are) removed from keywrd
     711 !
     712 !  txt can consists of upper and lower case letters, "-" and "_"; the l
 ast two allow hyphenated words.
     713 !
     714   use molkst_C, only : keywrd
     715   implicit none
     716   integer :: nt, mode
     717   character :: txt*(nt), store*2000, line*200
     718   integer :: i, j, trim_len, mt
     719   character :: local_txt*(nt), ch*1
     720   local_txt = txt
     721   do
     722 !
     723 !  Parse each word, one at a time.
     724 !
     725     do
     726       if (local_txt(1:1) /= " ") exit
     727       local_txt = local_txt(2:)
     728     end do
     729     ch = " "
     730     mt = 0
     731     do i = 1, nt
     732       mt = mt + 1
     733       if (local_txt(mt:mt) == '"') then ! Quickly run to the closing '"
 '
     734         do mt = mt + 1, nt
     735           if (local_txt(mt:mt) == '"') exit
     736         end do
     737       end if
     738       if (local_txt(mt:mt) == ' ') exit
     739       if (mt == nt) exit
     740     end do
     741     line = local_txt(:mt)
     742 !
     743 !  "line" holds a single keyword
     744 !
     745     local_txt = local_txt(mt + 1:)
     746     if (line(1:1) >= "0" .and. line(1:1) <= "9") then
     747       i = mt + 1
     748       else
     749   !
     750   ! find the end of the defined keyword, e.g., in pi=3.1415, that would
  be "i"
     751   !
     752       do i = 1, mt
     753         if ((line(i:i) < "A" .or. line(i:i) > "Z") .and. (line(i:i) < "
 a" .or. line(i:i) > "z") .and. &
     754         line(i:i) /= "_" .and. line(i:i) /= "-") exit
     755       end do
 
 FORCHECK PC V13.5.13        L_CONTROL         2021-03-24 10:59:30   page:  1723
 big_swap.F90  /FF
 
     756     end if
     757     trim_len = i - 1
     758 !
     759 !  If keyword already exists, then delete the keyword
     760 !  Keyword can have an "=" sign, or be followed by a "(" or a '"'
     761 !  in which case, find the end of the keyword.
     762 !
     763     do
     764       if (keywrd == " ") exit
     765       i = index(keywrd, " "//line(:trim_len))
     766       if (i > 0) then
     767         j = i + trim_len + 1
     768         if (keywrd(j:j) /= " ") then
     769           if (keywrd(j:j) == "=") j = j + 1
     770           ch = " "
     771           if (keywrd(j:j) == "(") then
     772             ch = ")"
     773           else if (keywrd(j:j) == '"') then
     774             ch = '"'
     775           end if
     776           do
     777             j = j + 1
     778             if (keywrd(j:j) == ch) exit
     779           end do
     780         end if
     781         keywrd = keywrd(:i)//keywrd(j + 1:)
     782       else
     783         exit
     784       end if
     785     end do
     786     store = " "
     787     if (mode == 1) then
     788       i = index(keywrd, store(:mt + 2))
     789       keywrd = keywrd(:i)//line(:mt)//trim(keywrd(i + mt + 1:))
     790     end if
     791     if (local_txt == " ") exit
     792   end do
     793   return
     794   end subroutine l_control
 
 FORCHECK PC V13.5.13        L_CONTROL         2021-03-24 10:59:30   page:  1724
