     541   subroutine SwitchOn(x, xlo, xhi, f)
     542     implicit none
     543     double precision, intent(in) :: x, xlo, xhi
     544     double precision, intent(OUT) :: f
     545 !
     546 !  Local variables
     547 !
     548     double precision :: s, sf
     549 !
     550 ! switch off
     551 !
     552     if ( x >= xhi ) then
     553        f = 0.d0
     554     else if ( x <= xlo ) then
     555        f = 1.d0
     556     else
     557        s  = (xhi-x)/(xhi-xlo)
     558        sf =    10.d0 * s**3 &
     559             & -15.d0 * s**4 &
     560             & + 6.d0 * s**5
     561        f = sf
     562     end if
     563 !
     564 ! switch on
     565 !
     566     f = 1.d0 - f
     567   end subroutine SwitchOn
 
