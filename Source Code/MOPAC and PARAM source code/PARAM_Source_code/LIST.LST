    2174       subroutine densf(u, c, d, da, norbs, nclose, w2)
    2175 !-----------------------------------------------
    2176 !   M o d u l e s
    2177 !-----------------------------------------------
    2178 !
    2179 !**********************************************************************
 *
    2180       implicit none
    2181 !-----------------------------------------------
    2182 !   D u m m y   A r g u m e n t s
    2183 !-----------------------------------------------
    2184       integer , intent(in) :: norbs
    2185       integer , intent(in) :: nclose
    2186       double precision , intent(in) :: u(norbs,norbs)
    2187       double precision , intent(in) :: c(norbs,norbs)
    2188       double precision , intent(out) :: d(norbs,norbs)
    2189       double precision , intent(out) :: da(norbs,norbs)
    2190       double precision , intent(inout) :: w2(norbs,norbs)
    2191 !-----------------------------------------------
    2192 !   L o c a l   P a r a m e t e r s
    2193 !-----------------------------------------------
    2194 !-----------------------------------------------
    2195 !   L o c a l   V a r i a b l e s
    2196 !-----------------------------------------------
    2197       integer :: j, k, l, i
    2198       double precision, dimension(norbs) :: w1
    2199       double precision :: sum
    2200 !-----------------------------------------------
    2201 !
    2202 !  THIS SUBROUTINE IS USED TO COMPUTE THE FIRST-ORDER DENSITY
    2203 !  FROM CA = C*U
    2204 !
    2205 !
    2206 !  FORM DENSITY MATRIX      CA*N*C+ + C*N*CA+
    2207 !
    2208       do j = 1, norbs
    2209         do k = 1, norbs
    2210           sum = 0.D0
    2211           do l = 1, nclose
    2212             sum = sum + u(k,l)*c(j,l)
    2213           end do
    2214           w2(k,j) = sum
    2215         end do
    2216       end do
    2217       do i = 1, norbs
    2218         do k = 1, norbs
    2219           sum = 0.D0
    2220           do l = 1, nclose
    2221             sum = sum + c(i,l)*u(l,k)
    2222           end do
    2223           w1(k) = sum
    2224         end do
    2225         do j = 1, norbs
    2226           sum = 0.0D00
    2227           do k = 1, norbs
    2228             sum = sum + c(i,k)*w2(k,j) - w1(k)*c(j,k)
    2229           end do
    2230           d(i,j) = 2.0D00*sum
 
 FORCHECK PC V13.5.13          DENSF           2021-03-24 10:59:30   page:  2629
 polar.F90  /FF
 
    2231           da(i,j) = sum
    2232         end do
    2233       end do
    2234 !
    2235       return
    2236       end subroutine densf
 
 FORCHECK PC V13.5.13          DENSF           2021-03-24 10:59:30   page:  2630
 polar.F90  /FF


