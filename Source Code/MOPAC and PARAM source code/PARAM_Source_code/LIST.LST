     848     if(abs(funct) > 1.d-20) write (iw, '(  10X,''              FUNCTION
 :'',F17.6)') funct
     849     read (ires, iostat = io_stat) (grad(i),i=1,nvar)
     850     read (ires, iostat = io_stat) ((hess(j,i),j=1,nvar),i=1,nvar)
     851     read (ires, iostat = io_stat) ((bmat(j,i),j=1,nvar),i=1,nvar)
     852     read (ires, iostat = io_stat) (oldf(i),i=1,nvar), (d(i),i=1,nvar),
