       1       subroutine xyzcry(tvec, numat, dxyz, iw)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       implicit none
       6 !-----------------------------------------------
       7 !   D u m m y   A r g u m e n t s
       8 !-----------------------------------------------
       9       integer , intent(in) :: numat
      10       integer , intent(in) :: iw
      11       double precision , intent(inout) :: tvec(3,3)
      12       double precision , intent(inout) :: dxyz(3,*)
      13 !-----------------------------------------------
      14 !   L o c a l   V a r i a b l e s
      15 !-----------------------------------------------
      16       integer :: i, j
      17       double precision :: sum, ca, sa, sum1
      18 !-----------------------------------------------
      19 !
      20 !   Convert Cartesian derivatives into fractional unit cell derivatives
 .
      21 !
      22 !      WRITE(IW,*)' Atoms 1 and 2'
      23 !      WRITE(IW,'(3F12.6)')((DXYZ(I,J),I=1,3),J=1,2)
      24       sum = sqrt(tvec(2,1)**2+tvec(3,1)**2)
      25 !      WRITE(IW,*)' TVEC'
      26 !      WRITE(IW,'(3f12.4)')TVEC
      27       if (sum > 1.D-6) then
      28 !
      29 !    Rotate to eliminate TVEC(3,1)
      30 !
      31         ca = tvec(2,1)/sum
      32         sa = tvec(3,1)/sum
      33         do i = 1, 3
      34           sum1 = tvec(2,i)*ca + tvec(3,i)*sa
      35           tvec(3,i) = (-tvec(2,i)*sa) + tvec(3,i)*ca
      36           tvec(2,i) = sum1
      37         end do
      38 !      WRITE(IW,*)' TVEC'
      39 !      WRITE(IW,'(3f12.4)')TVEC
      40         do i = 1, numat
      41           sum1 = dxyz(2,i)*ca + dxyz(3,i)*sa
      42           dxyz(3,i) = (-dxyz(2,i)*sa) + dxyz(3,i)*ca
      43           dxyz(2,i) = sum1
      44         end do
      45 !
      46 !    Rotate to eliminate TVEC(2,1)
      47 !
      48         sum = sqrt(tvec(1,1)**2+tvec(2,1)**2)
      49         ca = tvec(1,1)/sum
      50         sa = tvec(2,1)/sum
      51         do i = 1, 3
      52           sum1 = tvec(1,i)*ca + tvec(2,i)*sa
      53           tvec(2,i) = (-tvec(1,i)*sa) + tvec(2,i)*ca
      54           tvec(1,i) = sum1
      55         end do
      56         do i = 1, numat
      57           sum1 = dxyz(1,i)*ca + dxyz(2,i)*sa
 
 FORCHECK PC V13.5.13          XYZCRY          2021-03-24 10:59:30   page:    73
 xyzcry.F90  /FF
 
      58           dxyz(2,i) = (-dxyz(1,i)*sa) + dxyz(2,i)*ca
      59           dxyz(1,i) = sum1
      60         end do
      61 !      WRITE(IW,*)' TVEC'
      62 !      WRITE(IW,'(3f12.4)')TVEC
      63       end if
      64 !
      65 !    Rotate to eliminate TVEC(3,2)
      66 !
      67       sum = sqrt(tvec(2,2)**2+tvec(3,2)**2)
      68       if (sum > 1.D-6) then
      69         ca = tvec(2,2)/sum
      70         sa = tvec(3,2)/sum
      71         do i = 2, 3
      72           sum1 = tvec(2,i)*ca + tvec(3,i)*sa
      73           tvec(3,i) = (-tvec(2,i)*sa) + tvec(3,i)*ca
      74           tvec(2,i) = sum1
      75         end do
      76 !      WRITE(IW,*)' TVEC'
      77 !      WRITE(IW,'(3f12.4)')TVEC
      78         do i = 1, numat
      79           sum1 = dxyz(2,i)*ca + dxyz(3,i)*sa
      80           dxyz(3,i) = (-dxyz(2,i)*sa) + dxyz(3,i)*ca
      81           dxyz(2,i) = sum1
      82         end do
      83       end if
      84 !
      85 !  Convert unit cell into it's reciprocal
      86 !
      87       do i = 1, 3
      88         sum = 0.D0
      89         do j = 1, i
      90           sum = sum + tvec(j,i)**2
      91         end do
      92         tvec(:i,i) = tvec(:i,i)/sum
      93       end do
      94 !      WRITE(IW,*)' TVEC'
      95 !      WRITE(IW,'(3f12.4)')TVEC
      96 !         WRITE(IW,'(A)')' Fractional Unit Cell Derivatives'
      97 !         WRITE(IW,'(I4,3F12.5)')(I,(DXYZ(J,I),J=1,3),I=1,NUMAT)
      98       dxyz(3,:numat) = dxyz(3,:numat)/tvec(3,3)
      99       dxyz(2,:numat) = dxyz(2,:numat) - dxyz(3,:numat)*tvec(2,3)
     100       dxyz(1,:numat) = dxyz(1,:numat) - dxyz(3,:numat)*tvec(1,3)
     101       dxyz(2,:numat) = dxyz(2,:numat)/tvec(2,2)
     102       dxyz(1,:numat) = dxyz(1,:numat) - dxyz(2,:numat)*tvec(1,2)
     103       dxyz(1,:numat) = dxyz(1,:numat)/tvec(1,1)
     104       write (iw, '(A)') ' Fractional Unit Cell Derivatives'
     105       write (iw, '(I4,3F12.5)') (i,(dxyz(j,i),j=1,3),i=1,numat)
     106       return
     107       end subroutine xyzcry
 
