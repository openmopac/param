      46   subroutine GGJPS_IntQ(Rab, na, Ca, Za, dZadQa, nb, Cb, Zb, dZbdQb, X,
  Xa, Xb)
      47     implicit none
      48     double precision, intent(in) :: Rab(3)
      49     integer, intent(in) :: na, nb
      50     double precision, intent(in) :: Ca(na), Za(na), dZadQa(na), Cb(nb),
  Zb(nb), dZbdQb(nb)
      51     double precision, intent(OUT) :: X( 3, 1 ), Xa( 3, 1 ), Xb( 3, 1 )
      52 !
      53 !  Local variables
      54 !
      55     integer :: i, j
      56     double precision :: r2, r, b, br, cc, j00, d00dr, j10, e, U(3), dbd
 Qa, dbdQb, d00db, &
      57       dedb, d00drdb, d10db, d10dQa, d10dQb
      58     X = 0.d0
      59     Xa = 0.d0
      60     Xb = 0.d0
      61     r2 = Rab(1)*Rab(1) + Rab(2)*Rab(2) + Rab(3)*Rab(3)
      62     if ( r2 < 1.d-25 ) then
      63        X = 0.d0
      64        Xa = 0.d0
      65        Xb = 0.d0
      66     else
      67        r = sqrt(r2)
      68        U = Rab/r
      69        j10 = 0.d0
      70        d10dQa = 0.d0
      71        d10dQb = 0.d0
      72        do i=1, na
      73           do j=1, nb
      74              b  = sqrt( Za(i) * Zb(j) / ( Za(i) + Zb(j) ) )
      75              dbdQa = dZadQa(i) * ( Zb(j)/( Za(i)+Zb(j) ) )**2  / (2.d0*
 b)
      76              dbdQb = dZbdQb(j) * ( Za(i)/( Za(i)+Zb(j) ) )**2  / (2.d0*
 b)
      77              br = b * r
      78              cc = Ca(i) * Cb(j)
      79              e = (2.d0 / sqrt_PI) * b * EXP(-br*br)
      80              j00    = erf(br)/r
      81              d00dr  = e/r - j00/r
      82              d00db = (2.d0 / sqrt_PI) * EXP(-br*br)
      83              dedb  = (2.d0 / sqrt_PI) * (1.d0-2.d0*br*br) * EXP(-br*br)
      84              d00drdb = dedb/r - d00db/r
      85              j10    = j10 + cc * d00dr
      86              d10db  = cc * d00drdb
      87              d10dQa = d10dQa + d10db * dbdQa
      88              d10dQb = d10dQb + d10db * dbdQb
      89           end do
      90        end do
      91        X(1, 1) = X(1, 1) + j10 * U(3)
      92        X(2, 1) = X(2, 1) + j10 * U(1)
      93        X(3, 1) = X(3, 1) + j10 * U(2)
      94        Xa(1, 1) = Xa(1, 1) + d10dQa * U(3)
      95        Xa(2, 1) = Xa(2, 1) + d10dQa * U(1)
      96        Xa(3, 1) = Xa(3, 1) + d10dQa * U(2)
      97        Xb(1, 1) = Xb(1, 1) + d10dQb * U(3)
      98        Xb(2, 1) = Xb(2, 1) + d10dQb * U(1)
 
 FORCHECK PC V13.5.13        GGJPS_INTQ        2021-03-24 10:59:30   page:  3703
