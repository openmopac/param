      57 ! +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 +++++++++++++++++++++++++++++
      58 !
      59       subroutine mpcpop(icok)
      60 !-----------------------------------------------
      61 !   M o d u l e s
      62 !-----------------------------------------------
      63       USE molkst_C, only : numat, keywrd
      64       use common_arrays_C, only : nfirst, nlast, nat, pb, chrg
      65       use parameters_C, only : tore
      66       use chanel_C, only : iw, isyb
      67       use elemts_C, only : elemnt
      68       implicit none
      69 !-----------------------------------------------
      70 !   D u m m y   A r g u m e n t s
      71 !-----------------------------------------------
      72       integer , intent(in) :: icok
      73 !-----------------------------------------------
      74 !   L o c a l   V a r i a b l e s
      75 !-----------------------------------------------
      76       integer :: i, if, il, j, k
      77       double precision, dimension(numat) :: pop
      78       double precision :: sum
      79       double precision, allocatable :: Pot(:), Dipole_correction(:)
      80       double precision :: Ene
      81 !-----------------------------------------------
      82 !
      83 ! This subroutine calculates the total Mulliken populations on the
      84 !   atoms by summing the diagonal elements from the  Mulliken
      85 !   population analysis.
      86 !
      87       if (icok > -1) write (isyb, '(I4,5X,'' MULLIKEN POPULATION AND CH
 ARGE'')', err=40) icok
      88 !
      89 ! ICOK = 1  ==> SYBYL present - do analysis, and write MOPAC and SYBYL
 output
      90 ! ICOK = 0  ==> KEYWORD SYBYL present, but MULLIK absent - don't do ana
 lysis
      91 ! ICOK = -1 ==> MULLIK present but SYBYL absent - do analysis, but don'
 t write SYBYL output
      92 !
      93       if (allocated(chrg)) deallocate(chrg)
      94       allocate(chrg(numat))
      95       if (icok /= 0) then
      96         do i = 1, numat
      97           if = nfirst(i)
      98           il = nlast(i)
      99           sum = 0.0
     100           pop(i) = 0.0
     101           chrg(i) = 0.0
     102           do j = if, il
     103 !
     104 !    Diagonal element of mulliken matrix
     105 !
     106             sum = sum + pb((j*(j+1))/2)
     107           end do
     108           k = nat(i)
 
 FORCHECK PC V13.5.13          MPCPOP          2021-03-24 10:59:30   page:  3666
 mpcsyb.F90  /FF
 
     109 !
     110 !    Mulliken population for i'th atom
     111 !
     112           pop(i) = sum
     113           chrg(i) = tore(k) - pop(i)
     114         end do
     115         write (iw, '(3/8X,''MULLIKEN POPULATIONS AND CHARGES'',/)')
     116         write (iw, '(6X,''NO.  ATOM   POPULATION      CHARGE'')')
     117         write (iw, '(5X,I4,3X,A2,F13.6,F14.6)') &
     118          (j, elemnt(nat(j)), pop(j), chrg(j), j = 1, numat)
     119
     120          if (index(keywrd, " EF") /= 0) then
     121 !
     122 !  Keyword EF is used here to activate the CPE correction.  When CPE is
  fully integrated, the activation can be removed
     123 !
     124           allocate(Pot(numat), Dipole_correction(3*numat))
     125  !         do i = 1, numat !  Use 4 digits after decimal point, to mimi
 c stand-alone code
     126  !           chrg(i) = nint(chrg(i)*1.d4)/1.d4
     127  !         end do
     128           call CPE_energy(Ene, Pot, Dipole_correction)
     129           write(iw, '(//10x,a,/)') "Chemical-Potential Equalization"
     130           write(iw, '(10x,a, F20.16, a)')  'Energy                    =
  ', Ene ,                     "   kcal/mol"
     131           write(iw, '(10x,a, F20.16, a)')  "Pot(1)                    =
  ", Pot(1),                   "   eV"
     132           write(iw, '(10x,a, F20.16, a)')  "Dipole correction(1)      =
  ", Dipole_correction(1),     "   au"
     133         end if
     134
     135         if (icok > -1) write (isyb, "(2f12.6)", err=40) pop(:numat), ch
 rg(:numat)
     136         call to_screen("To_file: Mulliken")
     137       end if
     138       return
     139    40 continue
     140       write (iw, '(A)') 'Error writing SYBYL Mulliken population output
 '
     141       return
     142       end subroutine mpcpop
 
