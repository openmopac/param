    1748       subroutine eiscor(r016, r066, r244, r266, r466, ni)
    1749 !-----------------------------------------------
    1750 !   M o d u l e s
    1751 !-----------------------------------------------
    1752       use parameters_C, only : eisol
    1753 !**********************************************************************
 *
    1754 !
    1755 !    EISCOR adds in the ONE-CENTER terms for the atomic energy of
    1756 !           those atoms that have partly filled "d" shells
    1757 !
    1758 !**********************************************************************
 *
    1759       implicit none
    1760 !-----------------------------------------------
    1761 !   D u m m y   A r g u m e n t s
    1762 !-----------------------------------------------
    1763       integer , intent(in) :: ni
    1764       double precision , intent(in) :: r016
    1765       double precision , intent(in) :: r066
    1766       double precision , intent(in) :: r244
    1767       double precision , intent(in) :: r266
    1768       double precision , intent(in) :: r466
    1769 !-----------------------------------------------
    1770 !   L o c a l   V a r i a b l e s
    1771 !-----------------------------------------------
    1772       integer , dimension(100) :: ir016, ir066, ir244, ir266, ir466
    1773       integer :: i
    1774 !-----------------------------------------------
    1775       data (ir016(i),ir066(i),ir244(i),ir266(i),ir466(i),i=1,20)/ 100*0
 /
    1776 !
    1777 !                                Sc  Ti   V  Cr  Mn  Fe  Co  Ni  Cu
    1778 ! Atomic orbital population   4s  2   2   2   1   2   2   2   2   1
    1779 ! of gaseous atom             3d  1   2   3   5   5   6   7   8  10
    1780 !
    1781 ! State term:                    2D  3F  4F  7S  6S  5D  4F  3F  2S
    1782 !
    1783       data (ir016(i),i=21,29)/    2,  4,  6,  5, 10, 12, 14, 16, 10/
    1784       data (ir066(i),i=21,29)/    0,  1,  3, 10, 10, 15, 21, 28, 45/
    1785       data (ir244(i),i=21,29)/    1,  2,  3,  5,  5,  6,  7,  8,  5/
    1786       data (ir266(i),i=21,29)/    0,  8, 15, 35, 35, 35, 43, 50, 70/
    1787       data (ir466(i),i=21,29)/    0,  1,  8, 35, 35, 35, 36, 43, 70/
    1788 !
    1789       data (ir016(i),ir066(i),ir244(i),ir266(i),ir466(i),i=30,38)/ 45*0
 /
    1790 !
    1791 !                                 Y  Zr  Nb  Mo  Tc  Ru  Rh  Pd  Ag
    1792 ! Atomic orbital population   5s  2   2   1   1   2   1   1   0   1
    1793 ! of gaseous atom             4d  1   2   4   5   5   7   8  10  10
    1794 !
    1795 ! State term:                    2D  3F  6D  7S  6D  5F  4F  1S  2S
    1796 !
    1797       data (ir016(i),i=39,47)/    2,  4,  4,  5, 10,  7,  8,  0, 10/
    1798       data (ir066(i),i=39,47)/    0,  1,  6, 10, 10, 21, 28, 45, 45/
    1799       data (ir244(i),i=39,47)/    1,  2,  4,  5,  5,  5,  5,  0,  5/
    1800       data (ir266(i),i=39,47)/    0,  8, 21, 35, 35, 43, 50, 70, 70/
    1801       data (ir466(i),i=39,47)/    0,  1, 21, 35, 35, 36, 43, 70, 70/
 
 FORCHECK PC V13.5.13          EISCOR          2021-03-24 10:59:30   page:  1486
 mndod.F90  /FF
 
    1802 !
    1803       data(ir016(i), ir066(i), ir244(i), ir266(i), ir466(i), i=48,56) /
  45 * 0 /
    1804       data ir016(57)  / 2 /
    1805       data ir066(57)  / 0 /  !  Lanthanum
    1806       data ir244(57)  / 1 /  !  For the methods used in MOPAC, use the
    1807       data ir266(57)  / 0 /  !  configuration 6s(2)5d(1), not 6s(2)4f(1
 ).
    1808       data ir466(57)  / 0 /  !  This is a low-lying excited state.
    1809       data(ir016(i), ir066(i), ir244(i), ir266(i), ir466(i), i=58, 70)
 / 65 * 0 /
    1810       data ir016(71)  / 2 /
    1811       data ir066(71)  / 0 /  !  Lutetium
    1812       data ir244(71)  / 1 /  !
    1813       data ir266(71)  / 0 /  !
    1814       data ir466(71)  / 0 /  !
    1815 !                                    Hf  Ta   W  Re  Os  Ir  Pt  Au Hg
    1816 ! Atomic orbital population   6s      2   2   1   2   2   2   1   1  2
    1817 ! of gaseous atom             5d      2   3   5   5   6   7   9  10  0
    1818 !
    1819 ! State term:                        3F  4F  7S  6S  5D  4F  3D  2S 1S
    1820 !
    1821       data (ir016(i),i=72,80)/        4,  6,  5, 10, 12, 14,  9, 10, 0/
    1822       data (ir066(i),i=72,80)/        1,  3, 10, 10, 15, 21, 36, 45, 0/
    1823       data (ir244(i),i=72,80)/        2,  3,  5,  5,  6,  7,  5,  5, 0/
    1824       data (ir266(i),i=72,80)/        8, 15, 35, 35, 35, 43, 56, 70, 0/
    1825       data (ir466(i),i=72,80)/        1,  8, 35, 35, 35, 36, 56, 70, 0/
    1826 !
    1827 !
    1828 !
    1829 !     R016:  <SS|DD>
    1830 !     R066:  <DD|DD> "0" term
    1831 !     R244:  <SD|SD>
    1832 !     R266:  <DD|DD> "2" term
    1833 !     R466:  <DD|DD> "4" term
    1834 !
    1835       eisol(ni) = eisol(ni) + ir016(ni)*r016 + ir066(ni)*r066 - ir244(n
 i)*r244/&
    1836         5 - ir266(ni)*r266/49 - ir466(ni)*r466/49
    1837       return
    1838       end subroutine eiscor
 
