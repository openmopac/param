     959       subroutine sswap(n, sx, incx, sy, incy)
     960       implicit none
     961 !-----------------------------------------------
     962 !   D u m m y   A r g u m e n t s
     963 !-----------------------------------------------
     964       integer , intent(in) :: n
     965       integer , intent(in) :: incx
     966       integer , intent(in) :: incy
     967       real , intent(inout) :: sx(1)
     968       real , intent(inout) :: sy(1)
     969 !-----------------------------------------------
     970 !   L o c a l   V a r i a b l e s
     971 !-----------------------------------------------
     972       integer :: i, ix, iy, m, mp1
     973       real :: stemp
     974 !-----------------------------------------------
     975 !
     976 !     INTERCHANGES TWO VECTORS.
     977 !     USES UNROLLED LOOPS FOR INCREMENTS EQUAL TO 1.
     978 !     JACK DONGARRA, LINPACK, 3/11/78.
     979 !
     980 !
     981       if (n <= 0) return
     982       if (incx/=1 .or. incy/=1) then
     983 !
     984 !       CODE FOR UNEQUAL INCREMENTS OR EQUAL INCREMENTS NOT EQUAL
     985 !         TO 1
     986 !
     987         ix = 1
     988         iy = 1
     989         if (incx < 0) ix = ((-n) + 1)*incx + 1
     990         if (incy < 0) iy = ((-n) + 1)*incy + 1
     991         do i = 1, n
     992           stemp = sx(ix)
     993           sx(ix) = sy(iy)
     994           sy(iy) = stemp
     995           ix = ix + incx
     996           iy = iy + incy
     997         end do
     998         return
     999       end if
    1000 !
    1001 !       CODE FOR BOTH INCREMENTS EQUAL TO 1
    1002 !
    1003 !
    1004 !       CLEAN-UP LOOP
    1005 !
    1006       m = mod(n,3)
    1007       if (m /= 0) then
    1008         do i = 1, m
    1009           stemp = sx(i)
    1010           sx(i) = sy(i)
    1011           sy(i) = stemp
    1012         end do
    1013         if (n < 3) return
    1014       end if
    1015       mp1 = m + 1
    1016       do i = mp1, n, 3
 
 FORCHECK PC V13.5.13          SSWAP           2021-03-24 10:59:30   page:  1934
 esp_utilities.F90  /FF
 
    1017         stemp = sx(i)
    1018         sx(i) = sy(i)
    1019         sy(i) = stemp
    1020         stemp = sx(i+1)
    1021         sx(i+1) = sy(i+1)
    1022         sy(i+1) = stemp
    1023         stemp = sx(i+2)
    1024         sx(i+2) = sy(i+2)
    1025         sy(i+2) = stemp
    1026       end do
    1027       return
    1028       end subroutine sswap
 
