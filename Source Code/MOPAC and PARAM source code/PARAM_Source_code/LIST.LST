       1       subroutine coe(x2, y2, z2, norbi, norbj, c, r)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       implicit none
       6 !-----------------------------------------------
       7 !   D u m m y   A r g u m e n t s
