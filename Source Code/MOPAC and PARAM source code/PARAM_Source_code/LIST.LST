    1003       subroutine cartab
    1004 !-----------------------------------------------
    1005 !   M o d u l e s
    1006 !-----------------------------------------------
    1007       use symmetry_C, only : nclass, igroup, group, allrep, &
    1008       & nallop,ntbs, ntab, nallg, name, nirred, ielem, jx, jy
    1009       use molkst_C, only : numcal, keywrd
    1010       use chanel_C, only : iw
    1011 !**********************************************************************
 *
    1012 !-----------------------------------------------
    1013 !   I n t e r f a c e   B l o c k s
    1014 !-----------------------------------------------
    1015       implicit none
    1016 !-----------------------------------------------
    1017 !   G l o b a l   P a r a m e t e r s
    1018 !-----------------------------------------------
    1019 !-----------------------------------------------
    1020 !   L o c a l   P a r a m e t e r s
    1021 !-----------------------------------------------
    1022       integer, parameter :: ngps = 57
    1023 !-----------------------------------------------
    1024 !   L o c a l   V a r i a b l e s
    1025 !-----------------------------------------------
    1026       integer , dimension(ngps) :: nope, nrep
    1027       integer :: icalcn, i, j, k, l, nopers, nreprs, nstabl, kl, ku, is
 tart, &
    1028         igp, nzz, nz, prnt
    1029       double precision :: buff, fz, fn
    1030       logical :: debug, first, large
    1031       character, dimension(20) :: class*9
    1032       logical, external :: symdec
    1033
    1034       save nrep, class, debug, first, icalcn, large, nope
    1035 !-----------------------------------------------
    1036 !**********************************************************************
 *
    1037 !
    1038 ! CARTAB constructs Character Tables for Point Groups.  Each Group is
    1039 !        defined by an array having the same name as the Group, e.g. C2
 v
    1040 !        The format of each group is explained in BLOCK TABLES
    1041 !
    1042 !
    1043 !   The Magic Number is the decimal representation of a 20-digit binary
    1044 !   number, each digit of which is '1' if the associated operation is
    1045 !   present in the system, '0' otherwise.  The 20 operations are, in
    1046 !   order
    1047 !
    1048 !  1 C2(X)         6 Sigma(YZ)    11 C6     16 S8
    1049 !  2 C2(Y)         7 inversion    12 C7     17 S10
    1050 !  3 C2(Z)         8 C3           13 C8     18 S12
    1051 !  4 Sigma(XY)     9 C4           14 S4     19 Cubic group
    1052 !  5 Sigma(XZ)    10 C5           15 S6     20 Infinite group.
    1053 !
    1054 !**********************************************************************
 *
    1055       data first/ .TRUE./
 
 FORCHECK PC V13.5.13          CARTAB          2021-03-24 10:59:30   page:  3581
 molsym.F90  /FF
 
    1056       data prnt/ 1/
    1057       data class/ 'C2(x)', 'C2(y)', 'C2(z)', 'Sigma(XY)', 'Sigma(v)', &
    1058         'Sigma(d)', 'Inversion', ' C3', ' C4', ' C5', ' C6', ' C7', ' C
 8', &
    1059         ' S4', ' S6', ' S8', ' S10', ' S12', ' ?? ', 'C(Inf)'/
    1060       data icalcn/ 0/
    1061 !
    1062       if (numcal /= icalcn) then
    1063         icalcn = numcal
    1064         debug = index(keywrd,'CARTAB') /= 0
    1065         large = index(keywrd,'LARGE')/=0 .and. debug
    1066       end if
    1067       large = large .and. prnt==1
    1068       if (large) prnt = 0
    1069       if (first) then
    1070         first = .FALSE.
    1071 !
    1072 !   Generate array to hold addresses of groups
    1073 !
    1074 !  NOPE will apply to operations
    1075 !  NREP will apply to group name and irreducible representations
    1076 !
    1077         nope(1) = 1
    1078         nrep(1) = 1
    1079         do i = 2, ngps
    1080           nope(i) = nope(i-1) + nallop(nope(i-1)) + 4
    1081           nrep(i) = nrep(i-1) + nallop(nope(i-1)+1) + 1
    1082         end do
    1083 !
    1084 !   Generate array to hold addresses of character tables
    1085 !
    1086         j = 1
    1087         do i = 1, ntbs
    1088           k = ntab(i)
    1089           ntab(i) = j
    1090           j = j + k
    1091         end do
    1092 !
    1093 !  Use the following lines to check that the common blocks
    1094 !  have the correct sizes.
    1095 !
    1096 !#      WRITE(*,*)' Size of Groups:',NOPE(NGPS)+NALLOP(NOPE(NGPS))+3
    1097 !#      WRITE(*,*)' Size of Reps  :',NREP(NGPS)+NALLOP(NOPE(NGPS)+1)
    1098 !#      WRITE(*,*)' Size of TABLES:',J-1
    1099       end if
    1100 !
    1101 !  Debug code:  Print all the point groups, in order
    1102 !
    1103       if (large) then
    1104         do i = 1, ngps
    1105           k = nope(i)
    1106           l = nrep(i)
    1107           nopers = nallop(k)
    1108           nreprs = nallop(k+1)
    1109           nstabl = ntab(nallop(k+2))
    1110           write (iw, *) '         Point Group: ', allrep(l)
    1111           write (iw, "(a,i4,a,i4,a,i4,a,i9)") ' No. Ops:', nopers + 1,
 ' No. Reps:', &
    1112           nreprs, ' Table:', nallop(k+2), ' "Magic" No.:', nallop(k+3)
 
 FORCHECK PC V13.5.13          CARTAB          2021-03-24 10:59:30   page:  3582
 molsym.F90  /FF
 
    1113           write (iw, '(/10X,8(A,1X))') '   Identity   ', &
    1114           (class(nallop(j)),j=k + 4,k + 3 + nallop(k))
    1115           write (iw, '(A,10I10)') '    '//allrep(l+1), (1,j=1,nallop(k)
  + 1)
    1116           do j = 2, nreprs
    1117             kl = nstabl + (j - 2)*(nopers + 1)
    1118             ku = kl + nopers
    1119             write (iw, '(A,10I10)') '    '//allrep(l+j), (nallg(k),k=kl
 ,ku)
    1120           end do
    1121         end do
    1122       end if
    1123 !
    1124 !    Identify the Point Group of the molecule.
    1125 !
    1126       do igroup = ngps, 1, -1
    1127         if (.not.symdec(nallop(nope(igroup)+3),ielem)) cycle
    1128         exit
    1129       end do
    1130       if (index(keywrd,' NOSYM') /= 0) igroup = 1
    1131       istart = nope(igroup)
    1132       igp = nrep(igroup)
    1133       name = allrep(igp)
    1134       nclass = nallop(istart) + 1
    1135       nirred = nallop(istart+1)
    1136 !
    1137 !  IGROUP:  The number of the point-group of the system.
    1138 !  ISTART:  Starting address of the group.
    1139 !  IGP   :  Starting address of the names used in the group.
    1140 !  NAME  :  The name of the group.
    1141 !  NCLASS:  Number of operations used to represent the group, plus 1.
    1142 !  NIRRED:  Number of Irreducible Representations.
    1143 !  GROUP :  The full point-group character table for group IGROUP.
    1144 !
    1145       group(1,:nclass) = 1.D0
    1146       jy(2:nclass) = nallop(istart+4:nclass+2+istart)
    1147       jx(:nirred) = allrep(igp+1:nirred+igp)
    1148       istart = ntab(nallop(istart+2)) - 1
    1149       do i = 2, nirred
    1150         do k = 1, nclass
    1151           istart = istart + 1
    1152           buff = nallg(istart)
    1153           if (buff>=10.D0 .and. &
    1154           (name/='R3' .or. name=='R3' .and. k/=1 .and. k /= nclass)) th
 en
    1155             nzz = nallg(istart)
    1156             nz = nzz/10
    1157             fz = nz
    1158             fn = nzz - 10*nz
    1159             buff = 2.D0*cos(6.283185307179D0*fn/fz)
    1160           end if
    1161           group(i,k) = buff
    1162         end do
    1163       end do
    1164       jy(1) = 0
    1165       if (debug) then
    1166         write (iw, '(2A)') ' Character Table for Group  ', name
    1167         write (iw, '(7X,10A10)') '   E    ', (class(jy(k)),k=2,nclass)
    1168         do i = 1, nirred
 
 FORCHECK PC V13.5.13          CARTAB          2021-03-24 10:59:30   page:  3583
 molsym.F90  /FF
 
    1169           write (iw, '(A4,10F10.4)') jx(i), (group(i,k),k=1,nclass)
    1170         end do
    1171       end if
    1172       return
    1173       end subroutine cartab
 
 FORCHECK PC V13.5.13          CARTAB          2021-03-24 10:59:30   page:  3584
 molsym.F90  /FF


