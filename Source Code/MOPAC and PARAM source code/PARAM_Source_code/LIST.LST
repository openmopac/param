    1074       subroutine den_in_out(mode)
    1075       use chanel_C, only : iw, iden, density_fn
    1076       use common_arrays_C, only : p, pa, pb
    1077       use molkst_C, only: uhf, keywrd, norbs, numat, mozyme
    1078 !
    1079 ! Read and write the density matrix
    1080 !
    1081 !   If mode == 0 read the density matrix in (fill p, pa, and, if uhf, p
 b)
    1082 !   if mode == 1 write out the density matrix
    1083 !
    1084       implicit none
    1085       integer, intent (in) :: mode
    1086       integer :: io_stat, icount, old_norbs, old_numat
    1087       logical :: formatted, opend
    1088       if (Index (keywrd, " DENOUT") == 0 .and. mode == 1) return
    1089       if (Index (keywrd, " OLDENS") == 0 .and. mode == 0) return
    1090       call l_control("NEWDEN", len("NEWDEN"), 1)
    1091       if (mozyme) then
    1092         call pinout(mode, .true.)
    1093         return
    1094       end if
    1095       formatted = (Index(keywrd," DENOUTF") /= 0)
    1096       inquire(unit=iden, opened=opend)
    1097       if (opend) close(unit=iden, status='KEEP')
    1098       do icount = 1,2
    1099         if (formatted)then
    1100           open(unit=iden, file=density_fn)
    1101         else
    1102           open(unit=iden, file=density_fn, status='UNKNOWN', &
    1103           form='UNFORMATTED', position='asis')
    1104         end if
    1105         rewind iden
    1106         if (mode == 0) then
    1107 !
    1108 !  Try reading the file using formatted input if DENOUTF exists.
    1109 !  If the read does not work, try the other way
    1110 !
    1111           if (formatted)then
    1112              read (iden, *, iostat=io_stat)old_norbs, old_numat, pa
    1113           else
    1114              read (iden, iostat=io_stat)old_norbs, old_numat, pa
    1115           end if
    1116           if (old_norbs > 0 .and. old_norbs < 100000) then   ! Delete t
 his conditional in 2008
    1117           if (norbs /= old_norbs .or. numat /= old_numat) then
    1118             call mopend("Density file read in does not match current da
 ta set")
    1119             return
    1120           end if
    1121           end if
    1122           if (icount < 2.and. io_stat /= 0) then
    1123             formatted = (.not. formatted)
    1124             close(iden)
    1125             cycle
    1126           end if
    1127           if (io_stat /= 0) then
    1128             call to_screen(" Density Restart File missing or corrupt")
 
 FORCHECK PC V13.5.13        DEN_IN_OUT        2021-03-24 10:59:30   page:  4415
 iter.F90  /FF
 
    1129             call mopend ('Density Restart File missing or corrupt')
    1130             return
    1131           end if
    1132             if (uhf) then
    1133               if (formatted)then
    1134                 read (iden, *, iostat=io_stat) pb
    1135               else
    1136                 read (iden, iostat=io_stat) pb
    1137               end if
    1138             if (io_stat /= 0) then
    1139               if (index(keywrd, " GEO-OK") == 0) then
    1140                 call mopend("Beta Density Restart File missing or corru
 pt")
    1141                 write(iw,'(10x,a)')'(Most likely the previous job did n
 ot use UHF)'
    1142                 write(iw,'(10x,a)')"To continue, using the RHF density
 matrix as the starting point, add keyword ""GEO-OK"""
    1143                 return
    1144               end if
    1145               pb = pa
    1146             end if
    1147             p = pa + pb
    1148           else
    1149             p = pa*2.d0
    1150           end if
    1151         else
    1152           if (formatted)then
    1153             write (iden, *, iostat=io_stat)norbs, numat, pa
    1154           else
    1155             write (iden, iostat=io_stat)norbs, numat, pa
    1156           end if
    1157           if (uhf) then
    1158             if (formatted)then
    1159               write (iden, *, iostat=io_stat) pb
    1160             else
    1161               write (iden, iostat=io_stat) pb
    1162             end if
    1163           end if
    1164           close (iden)
    1165           exit
    1166         end if
    1167         close (iden)
