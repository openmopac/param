     606 !     *****************************************************************
 *****
     607
     608       subroutine chkdeg (vv, nv, evalmo)
     609
     610 !     **** this checks an exc list for degenerate boundary MO eigenvalu
 es ****
     611       use reimers_C, only: n
     612       USE chanel_C, only : iw
     613
     614       implicit none
     615       integer :: nv, vv(nv)
     616       double precision   evalmo(n), diff, tol
     617       integer            i, j, k, idir, ifn
     618
     619       data tol  /1.d-1/
     620       do j = 1, 4
     621         i = vv(j)
     622         idir = 0
     623         if ( (j.eq.1 .or. j.eq.3) .and. i > 1) then
     624           diff = abs (evalmo(i) - evalmo(i - 1))
     625           if (diff  <  tol) then
     626             idir = 1
     627             ifn = n
     628           end if
     629         else if ( (j.eq.2 .or. j.eq.4) .and. i < n .and. i.ge.1) then
     630           diff = abs (evalmo(i) - evalmo(i + 1))
     631           if (diff  <  tol) then
     632             idir = -1
     633             ifn = 1
     634           end if
     635         end if
     636
     637         if (idir.ne.0) then
     638           if (diff > tol/5.) then
     639             write (iw, "(/' CI WARNING: MO', i4, ' EVAL DIFF <', f7.4)"
 ) i, tol
     640           else
     641             write (iw, "(/' CI WARNING: MO', i4, ' EVAL DIFF <', f7.4)"
 ) i, tol/5.
     642             do k = i, ifn, idir
     643               if (abs(evalmo(k) - evalmo(i)) < tol) vv(j) = vv(j) + idi
 r
     644             end do
     645           end if
     646         end if
     647       end do
     648
     649       return
     650       end subroutine chkdeg
 
 FORCHECK PC V13.5.13          CHKDEG          2021-03-24 10:59:30   page:  2483
 excite.F90  /FF


