    2394   logical function near_a_metal(icc, ii, metals, nmetals)
    2395 !
    2396 !  Work out whether the atom (icc) or the hydrogen atom (numat) is near
    2397 !  to a metal atom (metals(natoms)).  If so, set near_a_metal = .false.
    2398 !  and delete bonds formed.
    2399 !
    2400   use common_arrays_C,  only : nbonds,  nat
    2401   implicit none
    2402   integer, intent (in) :: icc, ii, nmetals, metals(nmetals)
    2403   integer :: i
    2404   logical :: Sulfur, Oxygen, Nitrogen
    2405   double precision :: Rab, Rac
    2406   double precision, external :: distance
    2407     do i = 1, nmetals
    2408       Rab = distance(metals(i), icc)
    2409       Rac = distance(metals(i), ii)
    2410 !
    2411 !  Check for Sulfur and Oxygen.  Maybe check for (not carbon)?
    2412 !
    2413       Sulfur =   (nat(icc) == 16 .and. Rab < 2.6d0)
    2414       Oxygen =   (nat(icc) == 8 .and. Rab < 2.1d0 .and. Rac <= Rab)
    2415       Nitrogen = (nat(icc) == 7 .and. Rab < 2.5d0 .and. Rac <= Rab)
    2416       if (Rac < 1.5d0) exit
    2417       if ((Sulfur .or. Oxygen .or. Nitrogen)) exit
    2418     end do
    2419     near_a_metal = (i <= nmetals)
    2420     if (.not. near_a_metal) return
    2421     nbonds(icc) = nbonds(icc) - 1
    2422     return
    2423   end function near_a_metal
 
