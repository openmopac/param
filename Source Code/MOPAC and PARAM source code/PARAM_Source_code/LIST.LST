       1   subroutine prtpka(ipKa_sorted, pKa_sorted, ipKa_unsorted, pKa_unsorte
 d,  no)
       2     use common_arrays_C, only : grad, xparam, p, nat, coord
       3     use molkst_C, only : numat, escf, mozyme, emin, mpack, moperr
       4     use linear_cosmo, only : ini_linear_cosmo, coscavz
       5     use parameters_C, only : tore
       6     use cosmo_C, only : iseps, useps, lpka
       7     use chanel_C, only : iw
       8     implicit none
       9     integer, intent (out) :: ipKa_sorted(numat), ipKa_unsorted(numat),
 no
      10     double precision, intent (out) :: pKa_sorted(numat), pKa_unsorted(n
 umat)
      11 !
      12 ! Calculates and prints the pKa_sorted for an organic molecule with an
 ionizable hydrogen
      13 ! attached to an oxygen atom.
      14 !
      15    double precision :: sum, c1, c2, c3, dist(numat), sum_min, sum_H_min
      16    integer :: i, j, k, nh, loop, i_min
      17    double precision, dimension(numat) :: q
      18    logical :: store_iseps, store_useps
      19 !
      20 !  First, switch in parameters specific to the pKa_sorted calculation.
      21 !
      22     call Parameters_for_PKA(c1, c2, c3)
      23 !
      24 !  Re-calculate the charges
      25 !
      26     store_iseps = iseps
      27     store_useps = useps
      28     iseps = .true.
      29     useps = .true.
      30     emin = 0.d0
      31     call cosini(.true.)
      32     if (mozyme) call ini_linear_cosmo
      33     if (mozyme) then
      34       call coscavz(coord, nat)
      35       lpka = .true.
      36     else
      37        call coscav
      38        call mkbmat
      39     end if
      40     i = mpack
      41     call moldat(1)
      42     mpack = i
      43     moperr = .false. ! An error in moldat is not important here. only t
 he electronics are affected.
      44     call calpar
      45     call compfg (xparam, .TRUE., escf, .TRUE., grad, .FALSE.)
      46     nh = 0
      47     if (moperr) return
      48     lpka = .false.
      49     call chrge (p, q)
      50     q(:numat) = tore(nat(:numat)) - q(:numat)
      51 !
      52 !  Find the ionizable hydrogens
      53 !
 
 FORCHECK PC V13.5.13          PRTPKA          2021-03-24 10:59:30   page:  4325
 prtpka.F90  /FF
 
      54     pKa_unsorted = 0.d0
      55     do i = 1, numat
      56       if (nat(i) /= 1) cycle
      57       sum_min = 2.d0
      58       i_min = 0
      59       do j = 1, numat
      60         if (nat(j) /= 8) cycle
      61         sum = (coord(1,i) - coord(1,j))**2 + &
      62             & (coord(2,i) - coord(2,j))**2 + &
      63             & (coord(3,i) - coord(3,j))**2
      64         if (sum < sum_min) then      ! Assume that a hydrogen within 1.
 4 Angstroms of an oxygen is
      65           sum_min = sum              ! attached to that atom
      66           i_min = j
      67         end if
      68       end do
      69       if (sum_min < 1.9999d0) then
      70 !
      71 ! Exclude water
      72 !
      73         sum_H_min = 2.d0
      74         do k = 1, numat
      75           if (nat(k) /= 1 .or. k == i) cycle
      76           sum = (coord(1,k) - coord(1,i_min))**2 + &
      77               & (coord(2,k) - coord(2,i_min))**2 + &
      78               & (coord(3,k) - coord(3,i_min))**2
      79 ! Assume that a hydrogen within 1.4 Angstroms of an oxygen is attached
 to that atom
      80           if (sum < sum_H_min) then
      81             sum_H_min = sum
      82           end if
      83         end do
      84         if (sum_H_min < 1.9999d0 .and. numat > 3) cycle
      85         nh = nh + 1
      86         ipKa_unsorted(nh) = i
      87         pKa_unsorted(nh)=q(i)
      88         dist(nh) = sqrt(sum_min)
      89       end if
      90     end do
      91 !
      92 ! Now sort into decending order
      93 !
      94     ipKa_sorted = 0
      95     pKa_sorted = 0.d0
      96     if (nh == 0) then
      97       write(iw,"(/,3(10x,a,/))")"A request was made to print the pKa_so
 rted values for this system,", &
      98       "but there are no hydrogen atoms attached to an oxygen atom,", &
      99       "so the pKa_sorted calculation cannot be completed."
     100       return
     101     end if
     102     do i = 1, nh !  Convert charges and bond-lengths into pKa_sorted va
 lues
     103      pKa_unsorted(i) = pKa_unsorted(i)*c1 + dist(i)*c2 + c3
     104     end do
     105     loop = 0
     106     do i = 1, nh  ! Sort pKa_sorted into order, select lowest four
     107       sum = 100.d0
     108       k = 0
 
 FORCHECK PC V13.5.13          PRTPKA          2021-03-24 10:59:30   page:  4326
 prtpka.F90  /FF
 
     109       do j = 1, nh
     110         if (pKa_unsorted(j) < sum) then
     111           k = j
     112           sum = pKa_unsorted(j)
     113         end if
     114       end do
     115       if (k == 0) exit
     116       j = 1
     117       if (loop > 0) then
     118         do j = 1, loop
     119           if (ipKa_sorted(j) == ipKa_unsorted(k) .and. Abs(pKa_sorted(j
 ) - pKa_unsorted(k)) < 0.2d0) exit
     120         end do
     121       end if
     122       if (j <= loop) cycle
     123       loop = loop + 1
     124       ipKa_sorted(loop) = ipKa_unsorted(k)
     125       pKa_sorted(loop) =  pKa_unsorted(k)
     126       pKa_unsorted(k) = 200.d0 + pKa_unsorted(k)
     127     end do
     128     pKa_unsorted(:loop) = pKa_unsorted(:loop) - 200.d0
     129     no = loop
     130     call switch
     131     iseps = store_iseps
     132     useps = store_useps
     133     i = mpack
     134     call moldat(1)
     135     mpack = i
     136     moperr = .false. ! An error in moldat is not important here. only t
 he electronics are affected.
     137     call calpar
     138     emin = 0.d0
     139     call compfg (xparam, .TRUE., escf, .TRUE., grad, .FALSE.)
     140     return
     141   end subroutine prtpka
 
