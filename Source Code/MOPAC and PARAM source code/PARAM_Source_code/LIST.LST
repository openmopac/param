       1 subroutine prtgra ()
       2     use molkst_C, only: natoms, nvar, maxtxt, na1, keywrd
       3     use chanel_C, only: iw
       4     use elemts_C, only: elemnt
       5     use common_arrays_C, only : grad, xparam, txtatm, labels, loc, na
       6     implicit none
       7     character (len=30) :: blank
       8     character (len=100) :: fmat
       9     logical :: lint, lxyz
      10     integer :: i, j, k, l, m, n
      11     double precision :: glim, gmax, sum
      12     double precision, dimension (3, 2) :: tmp
      13     j = 0
      14     do i = 2, natoms
      15       if (na(i) /= 0) j = j + 1
      16     end do
      17     lxyz = (j == 0)
      18     lint = (j == natoms - 1)
      19     glim = 0.1d0 ! Only print large gradients
      20     i = Index (keywrd, " GRAD=") + Index (keywrd,"DERIV") + Index (keyw
 rd," GRAD")
      21     if (i /= 0) glim = -0.1d0
      22     blank = " "
