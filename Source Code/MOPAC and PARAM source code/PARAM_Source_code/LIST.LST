     128       write (iw, &
     129       '(''                                   KCAL/MOL   CAL/MOLE    CAL
 /K/MOL  CAL/K/MOL'',/)')
     130       do i = 1, nvibs
     131         vibs(i) = abs(vibs(i))
     132       end do
     133       ilim = 1
     134       if (istep > it2) then
     135         i = istep
     136         istep = it2
     137         it2 = i
     138       end if
     139       do itemp = it1, it2, istep
     140         ilim = ilim + 1
     141         T_range(ilim) = itemp
     142       end do
     143       T_range(1) = 298.D0
     144       qtr2 = 2.D0*pi*ac*mol_weight/fpc_10
     145       if (ilim == 2 .and. Abs(T_range(1) - T_range(2)) < 1.d-4) ilim =
 1
     146       do ir = 1, ilim
     147         itemp = int(T_range(ir))
     148         T = itemp
     149 !   ***   INITIALISE SOME VARIABLES   ***
     150         c1 = h*ac/ak/T
     151         qv = 1.0D0
     152         hv = 0.0D0
     153         cpv = 0.0D0
     154         sv1 = 0.0D0
     155 !   ***   CONSTRUCT THE FREQUENCY DEPENDENT PARTS OF PARTITION FUNCTION
     156         do i = 1, nvibs
