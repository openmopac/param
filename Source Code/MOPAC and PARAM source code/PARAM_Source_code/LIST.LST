    1485               aa = aa / (cosurf(4, ii) * cosurf(4, jj))
    1486             end if
    1487           end if
    1488
    1489           r(ii) = r(ii) + aa * q(jj)
    1490           r(jj) = r(jj) + aa * q(ii)
    1491         end do
    1492       end do
    1493     end if
    1494   end subroutine aq_dir_int
 
