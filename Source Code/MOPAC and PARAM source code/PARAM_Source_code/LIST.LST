       1     integer function ijbo (ii, jj)
       2     !******************************************************************
 ****
       3     !
       4     !  Given atom numbers II and JJ,
       5     !  IJBO = -1 if the atoms are separated by more than SQRT(CUTOF1),
 else
       6     !  IJBO = -2 if the atoms are separated by more than SQRT(CUTOF2),
 else
       7     !  IJBO = N, where "N+1" in the address of the starting location in
  the
       8     !            H, P, and F arrays.
       9     !
      10     !******************************************************************
 ****
      11       use overlaps_C, only: cutof1, cutof2
      12       use common_arrays_C, only: coord
      13       use MOZYME_C, only : lijbo, nijbo, iij, numij, ijall, iijj
      14       implicit none
      15       integer, intent (in) :: ii, jj
      16       integer :: ik, il, iu, j, ind_i, ind_j, jm1, jm2
      17       double precision :: r
      18       if (lijbo) then
      19         ijbo = nijbo(ii, jj)
      20         return
      21       end if
      22 !
      23       r =      (coord(1, ii)-coord(1, jj)) ** 2 &
      24            & + (coord(2, ii)-coord(2, jj)) ** 2 &
      25            & + (coord(3, ii)-coord(3, jj)) ** 2
      26       if (r > cutof1) then
      27         ijbo = -1
      28         return
      29       end if
      30       if (r > cutof2) then
      31         ijbo = -2
      32         return
      33       end if
      34     !
      35     !   use lookup array to find ijbo
      36     !
      37       if (ii > jj) then
      38         ind_i = ii
      39         ind_j = jj
      40       else
      41         ind_i = jj
      42         ind_j = ii
      43       end if
      44       il = iij(ind_i)
      45       iu = numij(ind_i)
      46       j = (il+iu+1) / 2
      47       jm1 = 0
      48       jm2 = 0
      49       do
      50         ik = ijall(j)
      51         if (ik < ind_j) then
      52           il = j
      53           j = (j+iu+1) / 2
 
 FORCHECK PC V13.5.13           IJBO           2021-03-24 10:59:30   page:  2220
 ijbo.F90  /FF
 
      54         else
      55           if (ik == ind_j) exit
      56           iu = j
      57           j = (j+il) / 2
      58           if (j == jm2) then
      59             ijbo = -2
      60             return
      61           end if
      62           jm1 = j
      63           jm2 = jm1
      64         end if
      65       end do
      66       ijbo = iijj(j)
      67       return
      68     end function ijbo
 
 FORCHECK PC V13.5.13           IJBO           2021-03-24 10:59:30   page:  2221
 ijbo.F90  /FF


