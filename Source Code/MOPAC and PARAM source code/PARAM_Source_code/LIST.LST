 cosmo.F90  /FF
 
     872                   sum = sum + vectci(id + (k - 1)*lab) * vectci(jd + (k
  - 1)*lab)
     873                 end do
     874                 deltap(j, i) = deltap(j, i) + sum * Dble (1 - 2*Mod(ij,
  2)) / &
     875                & nstate
     876               else if (iy == 2) then
     877                 ! DETERMINANTS ID AND JD DIFFER BY M.O J IN ID AND M.O
 I IN JD:
     878                 do i = 1, nmos
     879                   if (microb(i, id) /= microb(i, jd)) exit
     880                 end do
     881                 ij = 0
     882                 do j = i + 1, nmos
     883                   if (microb(j, id) /= microb(j, jd)) exit
     884                   ij = ij + microa(j, id) + microb(j, id)
     885                 end do
     886                 ij = ij + microa(j, id)
     887                 sum = 0.d0
     888                 do k = 1, nstate
     889                   sum = sum + vectci(id + (k - 1)*lab) * vectci(jd + (k
  - 1)*lab)
     890                 end do
     891                 deltap(j, i) = deltap(j, i) + sum * Dble (1 - 2*Mod(ij,
  2)) / &
     892                      & nstate
