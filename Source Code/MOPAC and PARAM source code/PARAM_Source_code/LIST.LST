    2511           h2(k), Rab1(k), elemnt(nat(h1(k))), h1(k), distance(h1(k), h2
 (k)), &
    2512           txtatm(h2(k))(18:20)//txtatm(h2(k))(23:27)//" "//txtatm(h2(k)
