 ,nvar), (gd(i),i=1,nvar)
     117         if (norbs /= old_norbs .or. numat /= old_numat) then
     118               call mopend("Restart file read in does not match current
 data set")
     119               return
     120         end if
     121         read (ires, end=40, err=40) mdfp, xdfp, totime, funct1
     122         if (first) write (iw, '(10X,''FUNCTION ='',F13.6,2/)') funct1
