     598     inquire (file=trim(line)//"txt", exist = exists)
     599     if (.not. exists) then
     600       open(unit=iprt, file=trim(line)//"txt")
     601       i = 0
     602       do j = 1, len_trim(line)
     603         if (line(j:j) == "/" .or. line(j:j) == backslash) i = j
     604       end do
     605       if (i /= 0) line = line(i + 1:)
     606       write(iprt,"(a)")"#","# Script for use with the HTML file """//tr
 im(line)//"html""","#"
     607     end if
     608     close (iprt)
 
