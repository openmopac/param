       1       subroutine freqcy(fmatrx, freq, travel, force_const, eorc, deldip
 , ff, oldf, ts)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE molkst_C, only : numat, keywrd, nvar, mers, id
       6       USE common_arrays_C, only : atmass, coord, tvec
       7       USE funcon_C, only : fpc_10, fpc_8, fpc_6, pi
       8       USE chanel_C, only : iw, brillouin_fn, ibrz
       9       use to_screen_C, only : redmas, cnorml
      10       implicit none
      11       double precision  :: ff(*)
      12       logical , intent(in) :: eorc, ts
      13       double precision  :: fmatrx((3*numat*(3*numat+1))/2)
      14       double precision  :: freq(3*numat)
      15       double precision , intent(out) :: travel(3*numat), force_const(3*
 numat)
      16       double precision  :: deldip(3,3*numat)
      17       double precision , intent(out) :: oldf((3*numat*(3*numat+1))/2)
      18 !
      19       integer :: loop, i, j, ij, iu, il, im1, ju, jl, ii, jj, l, linear
 , jii, k
      20       double precision, dimension(numat*3) :: wtmass
      21       double precision :: fact, c2pi, sumerr, sum, err, weight, summ, s
 um1
      22       logical :: bcc
      23 !********************************************************************
      24 !
      25 !  FREQCY CALCULATES THE FORCE CONSTANTS AND VIBRATIONAL FREQUENCIES
      26 !       FOR A MOLECULE.  IT USES THE ISOTOPIC MASSES TO WEIGHT THE
      27 !       FORCE MATRIX
      28 !
      29 ! ON INPUT   FMATRX   =  FORCE MATRIX, OF SIZE NUMAT*3*(NUMAT*3+1)/2.
      30 !
      31 !********************************************************************
      32       fact = fpc_10
      33 !
      34 !    CONVERSION FACTOR FOR SPEED OF LIGHT AND 2 PI.
      35 !
      36       c2pi = 1.D0/(fpc_8*pi*2.D0)
      37 ! NOW TO CALCULATE THE VIBRATIONAL FREQUENCIES
      38 !
      39 !   FIND CONVERSION CONSTANTS FOR MASS WEIGHTED SYSTEM
      40       if (eorc .and. .not. ts .and. index(keywrd,' NOSYM') == 0) then
      41 !
      42 !     The diagonal terms of the Force Matrix should
      43 !     be equal to minus the sum of the off-diagonal terms.
      44 !
      45         do loop = 1, 20
      46           sumerr = 0.D0
      47           do i = 1, nvar
      48             sum = 0.D0
      49             err = 0.D0
      50             do j = 1, i - 1
      51               sum = sum + fmatrx((i*(i-1))/2+j)
      52             end do
      53             do j = i + 1, nvar
      54               sum = sum + fmatrx((j*(j-1))/2+i)
 
 FORCHECK PC V13.5.13          FREQCY          2021-03-24 10:59:30   page:  4141
 freqcy.F90  /FF
 
      55             end do
      56             err = err + fmatrx((i*(i+1))/2) + sum
      57             sumerr = sumerr + abs(err)
      58             fmatrx((i*(i+1))/2) = (-sum) - err*0.5D0
      59           end do
      60           call symt (fmatrx, deldip, ff)
      61           if (sumerr >= 1.D-6) cycle
      62           exit
      63         end do
      64       end if
      65       if (index(keywrd,' FREQCY') /= 0) then
      66         write (iw, '(A)') ' SYMMETRIZED HESSIAN MATRIX'
      67 !
      68 !   THE FORCE MATRIX IS PRINTED AS AN ATOM-ATOM MATRIX RATHER THAN
      69 !   AS A 3N*3N MATRIX, AS THE 3N MATRIX IS VERY CONFUSING!
      70 !
      71         ij = 0
      72         iu = 0
      73         do i = 1, numat
      74           il = iu + 1
      75           iu = il + 2
      76           im1 = i - 1
      77           ju = 0
      78           do j = 1, im1
      79             jl = ju + 1
      80             ju = jl + 2
      81             sum = 0.D0
      82             do ii = il, iu
      83               do jj = jl, ju
      84                 sum = sum + fmatrx((ii*(ii-1))/2+jj)**2
      85               end do
      86             end do
      87             ij = ij + 1
      88             cnorml(ij) = sqrt(sum)
      89           end do
      90           ij = ij + 1
      91           cnorml(ij) = sqrt(fmatrx(((il+0)*(il+1))/2)**2 + &
      92                             fmatrx(((il+1)*(il+2))/2)**2 + &
      93                             fmatrx(((il+2)*(il+3))/2)**2 + &
      94                             2.D0*(fmatrx(((il+1)*(il+2))/2-1)**2 + &
      95                                   fmatrx(((il+2)*(il+3))/2-2)**2 + &
      96                                   fmatrx(((il+2)*(il+3))/2-1)**2))
      97         end do
      98         i = -numat
      99         call vecprt (cnorml, i)
     100       end if
     101       l = 0
     102       do i = 1, numat
     103         weight = 1.D0/sqrt(atmass(i))
     104         wtmass(l+1) = weight
     105         wtmass(l+2) = weight
     106         wtmass(l+3) = weight
     107         l = l + 3
     108         wtmass(l) = weight
     109       end do
     110 !    CONVERT TO MASS WEIGHTED FMATRX
     111       linear = 0
     112       do i = 1, nvar
     113         if (i > 0) then
 
 FORCHECK PC V13.5.13          FREQCY          2021-03-24 10:59:30   page:  4142
 freqcy.F90  /FF
 
     114           oldf(linear+1:i+linear) = fmatrx(linear+1:i+linear)*1.D5
     115           fmatrx(linear+1:i+linear) = fmatrx(linear+1:i+linear)* &
     116             wtmass(i)*wtmass(:i)
     117           linear = i + linear
     118         end if
     119       end do
     120 !
     121 !    1.D5 IS TO CONVERT FROM MILLIDYNES/ANGSTROM TO DYNES/CM.
     122
     123       if (Index (keywrd, " MERS") /= 0) then
     124 !
     125 !  Write out information for BZ.  Do NOT stop the run - the user might
 want
     126 !  vibrational frequencies and thermodynamics of the cluster.
     127 !
     128         bcc = (Index (keywrd, " BCC") /= 0)
     129         open (unit=ibrz, file=brillouin_fn, status="UNKNOWN", form="FOR
 MATTED")
     130         rewind(ibrz)
     131         write (ibrz,*) numat*3, mers, bcc
     132         write (ibrz,*) (fmatrx(i), i=1, linear)
     133         write (ibrz,*) tvec, id, numat, ((coord(j, i)-coord(j,1), j=1,
 3), i=1,numat)
     134         write (ibrz,*) ((i-1)*3+1,i*3, i=1, numat)
     135       end if
     136 !
     137 !    DIAGONALIZE
     138 !
     139       if (.not. ts) call frame (fmatrx, numat, 1)
     140       call rsp (fmatrx, nvar, freq, cnorml)
     141       call phase_lock(cnorml, nvar)
     142       if (eorc .and. nvar == 3*numat) call symtrz (cnorml, freq, 2, .TR
 UE.)
     143       do i = 1, nvar
     144         j = int((freq(i)+50.D0)*0.01D0)
     145         freq(i) = freq(i) - dble(j*100)
     146       end do
     147       freq(:nvar) = freq(:nvar)*1.D5
     148 !
     149 !    CALCULATE REDUCED MASSES, STORE IN REDMAS
     150 !
     151       do i = 1, nvar
     152         ii = (i - 1)*nvar
     153         summ = 0.D0
     154         do j = 1, nvar/3
     155           summ = summ + (cnorml(ii+j*3-2)**2 + &
     156                          cnorml(ii+j*3-1)**2 + &
     157                          cnorml(ii+j*3  )**2)**2*atmass(j)
     158         end do
     159         sum = 0.D0
     160         do j = 1, nvar
     161           jii = j + ii
     162           jj = (j*(j - 1))/2
     163           do k = 1, j
     164             sum = sum + cnorml(jii)*oldf(jj+k)*cnorml(k+ii)
     165           end do
     166           do k = j + 1, nvar
     167             sum = sum + cnorml(jii)*oldf((k*(k-1))/2+j)*cnorml(k+ii)
     168           end do
 
 FORCHECK PC V13.5.13          FREQCY          2021-03-24 10:59:30   page:  4143
 freqcy.F90  /FF
 
     169         end do
     170         sum = sum*0.5d0
     171         sum1 = sum*2.D0
     172         if (abs(freq(i)) > abs(sum)*1.D-20) then
     173           sum = 1.D0*sum/freq(i)
     174         else
     175           sum = 0.D0
     176         end if
     177       !
     178       !  Given   E = (h/2pi)freqency, then
     179       !          Energy = SQRT(FREQ(I)) = sqrt(force constant/reduced m
 ass) and
     180       !          Reduced mass = (force constant)/(FREQ(I))
     181       !
     182       !   At this point, FREQ(I) is the square root of the energy.
     183       !
     184         redmas(i,1) = summ
     185         if (Abs (freq(i)) > Abs (sum)*1.d-20) then
     186           redmas(i, 2) = Abs (sum1/freq(i))
     187           sum = sum / freq(i)
     188         else
     189           redmas(i, 2) = 0.d0
     190           sum = 0.d0
     191         end if
     192         force_const(i) = freq(i)*redmas(i,1)*1.d-5
     193         freq(i) = sign(sqrt(fact*abs(freq(i)))*c2pi,freq(i))
     194 !
     195 ! Convert frequency into SI units (ergs)
     196 !
     197         sum = freq(i)*fpc_6*fpc_8
     198 !
     199 ! Travel, in Angstroms
     200 !
     201         if (force_const(i) == 0.D0) then
     202           travel(i) = 0.D0
     203         else
     204           travel(i) = sqrt(2.d0*sum/(force_const(i)*1.d5))*1.d8
     205         end if
     206         if (travel(i) > 1.D0) travel(i) = 0.D0
     207         if (abs(freq(i)) < abs(sum1)*1.D+20) then
     208           sum1 = sqrt(abs(freq(i)/(sum1*1.D-5)))
     209         else
     210           sum1 = 0.D0
     211         end if
     212       end do
     213       if (eorc) then
     214 !
     215 !    CONVERT NORMAL VECTORS TO CARTESIAN COORDINATES
     216 !    (DELETED) AND NORMALIZE SO THAT THE TOTAL MOVEMENT IS 1.0 ANGSTROM
 .
     217 !
     218         ij = 0
     219         do i = 1, nvar
     220           sum = 0.D0
     221           j = 0
     222           do jj = 1, nvar/3
     223             sum1 = 0.D0
     224             cnorml(ij+1) = cnorml(ij+1)*wtmass(j+1)
     225             sum1 = sum1 + cnorml(ij+1)**2
 
 FORCHECK PC V13.5.13          FREQCY          2021-03-24 10:59:30   page:  4144
 freqcy.F90  /FF
 
     226 !
     227             cnorml(ij+2) = cnorml(ij+2)*wtmass(j+2)
     228             sum1 = sum1 + cnorml(ij+2)**2
     229 !
     230             cnorml(ij+3) = cnorml(ij+3)*wtmass(j+3)
     231             sum1 = sum1 + cnorml(ij+3)**2
     232 !
     233             j = j + 3
     234             ij = ij + 3
     235             sum = sum + sqrt(sum1)
     236           end do
     237           sum = 1.D0/sum
     238           ij = ij - nvar
     239           cnorml(ij+1:nvar+ij) = cnorml(ij+1:nvar+ij)*sum
     240           ij = nvar + ij
     241         end do
     242 !
     243 !          RETURN HESSIAN IN MILLIDYNES/ANGSTROM IN FMATRX
     244 !
     245         fmatrx(:linear) = oldf(:linear)*1.D-5
     246       else
     247 !
     248 !  RETURN HESSIAN AS MASS-WEIGHTED FMATRIX
     249         linear = 0
     250 !
     251         do i = 1, nvar
     252           if (i > 0) then
     253             fmatrx(linear+1:i+linear) = oldf(linear+1:i+linear)*1.D-5*
 &
     254               wtmass(i)*wtmass(:i)
     255             linear = i + linear
     256           end if
     257         end do
     258       end if
     259       return
     260       end subroutine freqcy
 
