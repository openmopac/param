    1956   subroutine add_path(file)
    1957     use chanel_C, only : job_fn
    1958     implicit none
    1959     character, intent (inout) :: file*(*)
    1960     integer :: i, j, n
    1961     character :: path*241
    1962     logical :: need_path
    1963     i = 0
    1964     if (file(1:1) == '"') then
    1965       i = len_trim(file)
    1966       path = file(2:i-1)
    1967       file = trim(path)
    1968     end if
    1969 !
    1970 !  Test to see if the file "file" already has an absolute path.
    1971 !
    1972     need_path = (file(2:2) /= ":" .and. file(1:1) /= "/" .and. file(1:1
 ) /= "~")
    1973     if (.not. need_path) return
    1974 !
    1975 !  Test to see if the job has an absolute path.
    1976 !
    1977     need_path = (job_fn(2:2) == ":" .or. job_fn(1:1) == "/")
    1978     if (.not. need_path) return
    1979 !
    1980 !  file "file" does not include the path and the path is present in job
 _fn
    1981 !  therefore add path to the file "file"
    1982 !
    1983 !  First check if a relative path is used
    1984 !
    1985     n = 1
    1986     do
    1987       if (file(1:3) /= ".."//"/" .and. file(1:3) /= ".."//"/") exit
    1988       n = n + 1
    1989       file = trim(file(4:))
    1990     end do
    1991 !
    1992 !  Is the file defined relative to the current folder?
    1993 !  If so, delete the definition.
    1994 !
    1995     if (file(1:2) == "."//"/" .or. file(1:2) == "."//"/") file = trim(f
 ile(3:))
    1996 !
    1997 !  Delete the data-set-name from the path, and delete the folders up to
  the relative folder.
    1998 !
    1999     path = trim(job_fn)
    2000     do j = 1, n
    2001       do i = len_trim(path) - 1, 1, -1
    2002         if (path(i:i) == "/") exit
    2003       end do
    2004       path = path(:i)
    2005     end do
    2006 !
    2007 !  Finally, join the path to the start of the file
    2008 !
    2009     file = path(:i)//trim(file)
 
 FORCHECK PC V13.5.13         ADD_PATH         2021-03-24 10:59:30   page:  3940
 readmo.F90  /FF
 
    2010     return
    2011   end subroutine add_path
 
