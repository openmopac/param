       1 subroutine scfcri (selcon)
       2     use molkst_C, only: numcal, keywrd, efield
       3     use chanel_C, only: iw
       4  !   use common_convrg, only: scfref
       5    !
       6    !.. Implicit Declarations ..
       7     implicit none
       8    !
       9    !.. Formal Arguments ..
      10     double precision, intent (inout) :: selcon
      11    !
      12    !.. Local Scalars ..
      13     logical :: precis
      14     integer :: i
      15     integer :: icalcn = 0
      16     double precision, save  :: scfcrt, scfref
      17     double precision, external :: reada
      18     if (icalcn /= numcal) then
      19       icalcn = numcal
      20       !
      21       !   DETERMINE THE SELF-CONSISTENCY CRITERION
      22       !
      23       ! SCFCRT IS MACHINE-PRECISION DEPENDENT
      24       !
      25       !   IF SCFCRT IS CHANGED, THEN ALSO CHANGE DEFAULT IN WRTKEY
      26       !
      27       scfcrt = 1.d-2
      28       !
      29       !  THE USER CAN STATE THE SCF CRITERION, IF DESIRED.
      30       !
      31       i = Index (keywrd, " TS") + Index (keywrd, " FORCETS") + Index (k
 eywrd, " IRC=")
      32       if (i /= 0) scfcrt = 2.0d-3
      33       precis = (Index (keywrd, " PRECIS") /= 0)
      34       i = Index (keywrd, " RELSCF")
      35       if (i /= 0) then
      36         scfcrt = reada (keywrd, i) * scfcrt
      37         write (iw, "('  SCF CRITERION =',G14.4)") scfcrt
      38         if (scfcrt < 1.d-5) then
      39 10000     format (//2 x, " THERE IS A RISK OF INFINITE LOOPING WITH", &
      40          & " THE SCFCRT LESS THAN 1.D-5")
      41           write (iw, 10000)
      42         end if
      43       end if
      44       i = Index (keywrd, " SCFCRT")
      45       if (i /= 0) then
      46         scfcrt = reada (keywrd, i)
      47         write (iw, "('  SCF CRITERION =',G14.4)") scfcrt
      48         if (scfcrt < 1.d-5) then
      49           write (iw, "(//2x,' THERE IS A RISK OF INFINITE LOOPING WITH'
 , &
      50          & ' THE SCFCRT LESS THAN 1.D-5')")
      51         end if
      52       end if
      53       !
      54       !   SELF-CONSISTENCY CRITERIA: SELCON IS IN KCAL/MOL
      55       !   IF GNORM IS LARGE, MAKE SELCON BIGGER
      56       !
 
 FORCHECK PC V13.5.13          SCFCRI          2021-03-24 10:59:30   page:   881
 scfcri.F90  /FF
 
      57       if (precis) then
      58         scfcrt = scfcrt * 0.01d0
      59       end if
      60       !
      61       ! For polarizability calculations, the default convergence should
  be
      62       ! tightened
      63       !
      64       if (Index (keywrd, " POLAR") /= 0 .and. scfref == 0.0d0) then
      65         scfcrt = 1.d-4
      66       end if
      67       selcon = scfcrt
      68       scfref = scfcrt
      69     else
      70       !
      71       !  IF POLARIZATION IS BEING CALCULATED, TIGHTEN SCF CRITERION
      72       !
      73       if (Abs (efield(1))+Abs(efield(2))+Abs(efield(3)) > 1.d-6) then
      74         selcon = 1.d-4
      75       end if
      76       if (scfref /= 0.d0) then
      77         selcon = scfref
      78       end if
      79     end if
      80     return
      81 end subroutine scfcri
 
