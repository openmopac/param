    1057       prtmep = index(keywrd,' PRTMEP') /= 0
    1058       minmep = index(keywrd,' MINMEP') /= 0
    1059       cw(1,:numat) = cut
    1060       cw(2,:numat) = cut
    1061       cw(3,:numat) = cut
    1062       vmin(:numat) = cut
    1063 !
    1064       call packp (p, pp, nonzo)
    1065 !
    1066       npx = int(xm/step)*2 + 1
    1067       if (icase==2 .or. icase==3) then
    1068         ym = ym + 3.0D0
    1069         npy = int(ym/step) + 1
    1070       else
    1071         npy = int(ym/step)*2 + 1
    1072       end if
    1073       if (prtmep) then
    1074         write (imep, 30) numat, npx, npy, (-xm), (-ym), step
    1075    30   format(1x,3i5,3f8.2,/)
    1076         write (imep, 130) npx, npy, npx*npy, z0, (-xm), step, (-ym), st
 ep
    1077         write (imep, 140)
    1078         write (imep, 150) (i,nat(i),(cmep(k,i),k=1,2),i=1,numat)
    1079         write (imep, *)
    1080       end if
    1081 !                                   CREATE THE POINTS AND CALCULATE MEP
    1082       ip = 0
    1083       t11 = t(1,1)
    1084       t12 = t(1,2)
    1085       t13 = t(1,3)
    1086       t21 = t(2,1)
    1087       t22 = t(2,2)
    1088       t23 = t(2,3)
    1089       t31 = t(3,1)
    1090       t32 = t(3,2)
    1091       t33 = t(3,3)
    1092       xx0 = z0*t31
    1093       yy0 = z0*t32
    1094       zz0 = z0*t33
    1095       xxw = xx0 + r0(1)
    1096       yyw = yy0 + r0(2)
    1097       zzw = zz0 + r0(3)
    1098       step1 = step
    1099    40 continue
    1100       xx1 = xx0 + r0(1)
    1101       yy1 = yy0 + r0(2)
    1102       zz1 = zz0 + r0(3)
    1103 !
    1104       do m = 1, npx
    1105         stepm = (m - 1)*step1
    1106         xx2 = xx1 + stepm*t11
 
 FORCHECK PC V13.5.13          MEPMAP          2021-03-24 10:59:30   page:  3054
 pmep.F90  /FF
 
    1107         yy2 = yy1 + stepm*t12
    1108         zz2 = zz1 + stepm*t13
    1109         l60: do n = 1, npy
    1110           uu(n) = cut
    1111           stepn = (n - 1)*step1
    1112           w(1) = xx2 + stepn*t21
    1113           w(2) = yy2 + stepn*t22
    1114           w(3) = zz2 + stepn*t23
    1115           if (need1 == 0) then
    1116 !                                          CHECK IF TOO CLOSE TO NUCLEI
    1117             rmin = 81.0D0
    1118             imin = 0
    1119             do i = 1, numat
    1120               rr = (w(1)-c1(1,i))**2 + (w(2)-c1(2,i))**2 + (w(3)-c1(3,i
 ))**2
    1121               if (rr < 0.25D0) cycle  l60
    1122               if (nat(i)>1 .and. rr<0.36D0) cycle  l60
    1123               ria(i) = sqrt(rr)
    1124               if (rmin <= rr) cycle
    1125               rmin = rr
    1126               imin = i
    1127             end do
    1128             call pmepco (pp, ria, w, ui, c1, nonzo, 1)
    1129             uu(n) = ui
    1130             if (ui < vmin(imin)) then
    1131               vmin(imin) = ui
    1132               cw(1,imin) = w(1)
    1133               cw(2,imin) = w(2)
    1134               cw(3,imin) = w(3)
    1135               mx(imin) = m
    1136               my(imin) = n
    1137             end if
    1138           else
    1139             call pmepco (pp, ria, w, ui, c1, nonzo, 0)
    1140             if (ui < vmin(natm)) then
    1141               vmin(natm) = ui
    1142               cw(1,natm) = w(1)
    1143               cw(2,natm) = w(2)
    1144               cw(3,natm) = w(3)
    1145             end if
    1146           end if
    1147           ip = ip + 1
    1148         end do l60
    1149         if (.not.(need1==0 .and. prtmep)) cycle
    1150         write (imep, 160) (uu(ny),ny=1,npy)
    1151       end do
    1152 !
    1153       if (need1 == 0) write (iw, 170) npx, npy
    1154       if (prtmep .and. need1==0) write (iw, *) &
    1155         '=> CONTOUR FILE IS PRINTED ON CHANNEL 7'
    1156       if (need1 <= 0) then
    1157 !                                               REMOVE THE FALSE MINIMA
    1158         minima = 0
    1159         l90: do i = 1, numat
    1160           if (vmin(i) > 0.0D0) cycle  l90
    1161           do m = mx(i) - 1, mx(i) + 1
    1162             stepm = (m - 1)*step
    1163             xx2 = xxw + stepm*t11
    1164             yy2 = yyw + stepm*t12
 
 FORCHECK PC V13.5.13          MEPMAP          2021-03-24 10:59:30   page:  3055
 pmep.F90  /FF
 
    1165             zz2 = zzw + stepm*t13
    1166             do n = my(i) - 1, my(i) + 1
    1167               stepn = (n - 1)*step
    1168               w(1) = xx2 + stepn*t21
    1169               w(2) = yy2 + stepn*t22
    1170               w(3) = zz2 + stepn*t23
    1171               ip = ip + 1
    1172               call pmepco (pp, ria, w, ui, c1, nonzo, 0)
    1173               if (ui >= vmin(i) - 0.001D0) cycle
    1174               vmin(i) = 99.0D0
    1175               cycle  l90
    1176             end do
    1177           end do
    1178           minima = minima + 1
    1179         end do l90
    1180         if (minima == 0) then
    1181           write (iw, *) ' NO MEP MINIMUM FOUND IN THIS PLANE'
    1182           return
    1183         end if
    1184         if (.not.minmep) go to 110
    1185         need1 = 1
    1186         step1 = step*0.2D0
    1187         npx = 11
    1188         npy = 11
    1189       end if
    1190       natm = natm + 1
    1191       if (natm > numat) go to 110
    1192       do while(vmin(natm) > 0.0D0)
    1193         natm = natm + 1
    1194         if (natm > numat) go to 110
    1195       end do
    1196       r0(1) = cw(1,natm) - step*(t11 + t21)
    1197       r0(2) = cw(2,natm) - step*(t12 + t22)
    1198       r0(3) = cw(3,natm) - step*(t13 + t23)
    1199       go to 40
    1200   110 continue
    1201       if (need1 > 0) write (iw, 180) ip
    1202       write (iw, 190)
    1203       do i = 1, numat
    1204         if (vmin(i) >= 0.0D0) cycle
    1205         write (iw, 200) i, elemnt(nat(i)), vmin(i), dsqrt((c1(1,i)-cw(1
 ,i))**2+&
    1206           (c1(2,i)-cw(2,i))**2+(c1(3,i)-cw(3,i))**2), (cw(j,i),j=1,3)
    1207       end do
    1208       return
    1209   130 format(22x,'INSTRUCTION',/,1x,'1) NX*NY = ',i3,'*',i3,' =',i6,' G
 RIDS;',/&
    1210         ,1x,'2) NY VALUES IN EACH OF THE NX BLOCKS;',/,1x,&
    1211         '3) X,Y COORDINATES (Z=',f6.2,' ) OF THE GRIDS:',/,9x,'X(I)=',f
 8.2,'+',&
    1212         f6.2,'*(I-1)    I=1,2,...,NX',/,9x,'Y(J)=',f8.2,'+',f6.2,&
    1213         '*(J-1)    I=1,2,...,NY')
    1214   140 format(1x,'4) THE MOLECULAR COORDINATES (X,Y)',&
    1215         ' ON THE 2D-MEP CONTOUR MAP')
    1216   150 format(9x,2i4,2f12.5)
    1217   160 format(6f11.5)
    1218   170 format(/,1x,'GRIDS NX*NY=',i3,' *',i3)
    1219   180 format(1x,'TOTAL NUMBER OF THE POINTS CALCULATED ',i8)
    1220   190 format(/,1x,'MINIMA IN THE SPECIFIED PLANE',/,5x,&
 
 FORCHECK PC V13.5.13          MEPMAP          2021-03-24 10:59:30   page:  3056
 pmep.F90  /FF
 
    1221         'ATOM       UMIN      DISTANCE',10x,'XYZ COORDINATE',/,15x,&
    1222         'KCAL/MOL     ANG',14x,'IN MOL COORD')
    1223   200 format(3x,i3,2x,a2,2x,f9.1,4x,f6.2,4x,3f9.3)
    1224       end subroutine mepmap
 
