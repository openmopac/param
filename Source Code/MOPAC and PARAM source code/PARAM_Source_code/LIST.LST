       2 subroutine post_scf_corrections(correction, l_grad)
       3 !
       4 !    Add dispersion, hydrogen bonding, extra H-H repulsion, and other e
 nergies to
       5 !    improve intermolecular interaction geometries and energies.
       6 !
       7   use molkst_C, only : keywrd, E_disp, E_hb, E_hh, method_pm7, P_Hbonds
 , &
       8     method_pm6_dh_plus, method_pm6_dh2, method_pm6_d3h4, method_pm6_dh2
 x, method_pm6_d3h4x, &
       9     method_pm6_d3, method_pm6_d3_not_h4, method_pm7_hh, method_pm7_minu
 s, method_PM8
      10   use common_arrays_C, only: dxyz
      11   implicit none
      12   double precision, intent(out) ::  correction
      13   logical, intent (in) :: l_grad
      14 !
      15 ! Local variables
      16 !
      17   logical ::  prt
      18   double precision, external :: & !                  Original reference
 s
      19                           !
      20   energy_corr_hh_rep,   & ! Rezac J., Hobza P., "Advanced Corrections o
 f Hydrogen Bonding and
      21                           ! Dispersion for Semiempirical Quantum Mechan
 ical Methods", J. Chem.
      22                           ! Theory and Comp 8, 141-151 (2012).
      23                           !
      24                           !
      25   PM6_DH_Dispersion,    & ! S. Grimme, "Accurate description of van der
  Waals complexes by
      26                           ! density functional theory including empiric
 al corrections."
      27                           ! J Comput Chem. 2004 Sep;25(12):1463-73.
      28                           !
      29   dftd3,                & ! Grimme S., Antony J., Ehrlich S., Krieg H.,
  "A consistent and accurate
      30                           ! ab initio parametrization of density functi
 onal dispersion correction
      31                           ! (DFT-D) for the 94 elements H-Pu", J. Chem.
  Phys. 132, 154104:154104
      32                           ! (2010).
      33                           !
      34   disp_DnX,             & ! (DH2X) Rezac and Hobza's correction: "A hal
 ogen-bonding correction
      35                           ! for the semiempirical PM6 method" Chem. Phy
 s. Lett. 506 286-289 (2011)
      36                           !
      37                           ! (D3H4X) Rezac J., Hobza P., "Advanced Corre
 ctions of Hydrogen Bonding
      38                           ! and Dispersion for Semiempirical Quantum Me
 chanical Methods", J. Chem.
      39                           ! Theory and Comp 8, 141-151 (2012)
      40                           !
      41   Hydrogen_bond_corrections !(DH2) Korth M., Pitonak M., Rezac J., Hobz
 a P., "A Transferable
      42                           ! H-bonding Correction for Semiempirical Quan
 
 FORCHECK PC V13.5.13   POST_SCF_CORRECTIONS   2021-03-24 10:59:30   page:  3544
 post_scf_corrections.F90  /FF
 
 tum-Chemical Methods",
      43                           ! J. Chem. Theory and Computation 6, 344-352
 (2010).
      44                           !
      45                           ! (DH+) Korth M., "Third-Generation Hydrogen-
 Bonding Corrections for
      46                           ! Semiempirical QM Methods and Force Fields",
  J. Chem. Theory Comput.
      47                           ! 6, 3808-3816 (2010).
      48 !
      49 ! PM6-D3H4X: Brahmkshatriya, P. S.; Dobes, P.; Fanfrlik, J.; Rezac, J.;
  Paruch, K.; Bronowska,
      50 ! A.; Lepsik, M.; Hobza, P. "Quantum Mechanical Scoring: Structural and
  Energetic Insights into
      51 ! Cyclin-Dependent Kinase 2 Inhibition by Pyrazolo[1,5-a]pyrimidines" C
 urr. Comput.-Aid. Drug.
      52 ! 2013 , 9 (1), 118�129.
      53 !
      54   prt = (index(keywrd," 0SCF ") + index(keywrd," PRT ") /= 0 .and. inde
 x(keywrd," DISP") /= 0)
      55   correction = 0.d0
      56   E_hb       = 0.d0
      57   E_hh       = 0.d0
      58   E_disp     = 0.d0
      59   P_Hbonds   = 0
      60   if (.not. allocated(dxyz)) allocate (dxyz(1))
      61 !
      62 ! All the hydrogen-bond corrections are in Hydrogen_bond_corrections
      63 !
      64   if (method_pm6_d3h4x) then
      65     correction = correction + dftd3(l_grad, dxyz)
      66     correction = correction + Hydrogen_bond_corrections(l_grad, prt)
      67     correction = correction + energy_corr_hh_rep(l_grad, dxyz)
      68     correction = correction + disp_DnX(l_grad)
      69   else if (method_pm6_d3h4) then
      70     correction = correction + dftd3(l_grad, dxyz)
      71     correction = correction + Hydrogen_bond_corrections(l_grad, prt)
      72     correction = correction + energy_corr_hh_rep(l_grad, dxyz)
      73   else if (method_pm6_d3_not_h4) then
      74     correction = correction + dftd3(l_grad, dxyz)
      75     correction = correction + energy_corr_hh_rep(l_grad, dxyz)
      76   else if (method_pm6_d3) then
      77     correction = correction + dftd3(l_grad, dxyz)
      78   else if (method_pm6_dh_plus) then
      79     correction = correction + PM6_DH_Dispersion(l_grad)
      80     correction = correction + Hydrogen_bond_corrections(l_grad, prt)
      81   else if (method_pm6_dh2) then
      82 !
      83 ! Hydrogen_bond_corrections uses partial atomic charges if method_pm6_d
 h2 .or. method_pm6_dh2x
      84 !
      85     correction = correction + PM6_DH_Dispersion(l_grad)
      86     correction = correction + Hydrogen_bond_corrections(l_grad, prt)
      87   else if (method_pm6_dh2x) then
      88     correction = correction + PM6_DH_Dispersion(l_grad)
      89     correction = correction + Hydrogen_bond_corrections(l_grad, prt)
