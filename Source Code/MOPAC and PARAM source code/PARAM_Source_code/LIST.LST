    1279 !
    1280   subroutine coswrt()
    1281 !
    1282   use cosmo_C, only : area, ediel, cosvol, fepsi, amat, nsetf, &
    1283     nps, qscnet, srad, qscat, arat, cosurf, phinet, iatsp, solv_energy
    1284 !
    1285   use chanel_C, only : iwc, cosmo_fn, ir
    1286 !
    1287   use molkst_C, only : keywrd, numat, escf, elect, enuclr, line, mozyme
    1288 !
    1289   use common_arrays_C, only : nat, coord
    1290 !
    1291   use funcon_C, only : a0, ev
    1292 !
    1293   use linear_cosmo, only : am1dft_solve
    1294 !
    1295   implicit none
    1296   double precision :: sum
    1297   integer :: i, j, k, i1, i2, ips, ix
    1298   double precision :: fcon, dqam1dft, dd, enew
    1299     open (unit=iwc, file=cosmo_fn, status='unknown')
    1300     if (index(keywrd,'COSCCH') > 0) then
    1301       fcon=a0*ev
    1302 10    read(ir,'(a)',err=30,end=30) line
    1303         if(index(line,'dq:') == 0) goto 20
    1304         read(line(5:),*) i1,i2,dqam1dft
    1305         do ips=1,nps
    1306           dd=0.d0
    1307           do ix=1,3
    1308            dd=dd+(cosurf(ix,ips)-(coord(ix,i1)+coord(ix,i2))/2)**2
    1309           end do
    1310           phinet(ips,3)=phinet(ips,3)-dqam1dft/sqrt(dd)
    1311         end do
    1312         goto 10
    1313 20      do i=1,numat
    1314           read(line,*,err=30) dqam1dft
    1315           do ips=1,nps
    1316             dd=0.d0
    1317             do ix=1,3
    1318              dd=dd+(cosurf(ix,ips)-coord(ix,i))**2
    1319             end do
    1320             phinet(ips,3)=phinet(ips,3)-dqam1dft/sqrt(dd)
    1321           end do
    1322           read(ir,'(a)',err=30,end=30) line
    1323         end do
    1324 30    continue
    1325       if (mozyme) then
    1326         qscnet(1:nps, 3) = qscnet(1:nps, 3) / (-fepsi)
    1327         call am1dft_solve (qscnet(:, 3), phinet(:, 3), nps)
    1328       else
    1329         call coscl2(amat, nsetf, qscnet(1,3), phinet(1,3), nps)
    1330       end if
    1331 !
    1332 ! SCALE QSCNUC AND CALCULATE INTERACTION ENERGY
    1333 !
    1334       enew = 0.d0
    1335       do i = 1, nps
    1336         qscnet(i,3) =  -fepsi*qscnet(i,3)
 
 FORCHECK PC V13.5.13          COSWRT          2021-03-24 10:59:30   page:  4373
 writmo.F90  /FF
 
    1337         enew = enew + qscnet(i,3)*phinet(i,3)
    1338       end do
    1339       ediel = fcon*enew*0.5d0
    1340     end if
    1341     write (iwc, "(a)") keywrd (1:80)
    1342     write (iwc, "(a)") keywrd (81:160)
    1343     write (iwc, "(a)") keywrd (161:240)
    1344     sum = 0.d0
    1345     do i = 1, nps
    1346       sum = sum + qscnet(i, 3)
    1347     end do
    1348     write (iwc, "(/10x,'FINAL HEAT OF FORMATION =',f17.5,' KCAL/MOL','
 = ', f12.5,' KJ/MOL')") &
    1349        escf, escf * 4.184d0
    1350     write (iwc, "(    10X,'TOTAL ENERGY            =',F17.5,      ' EV'
 )") &
    1351        & elect + enuclr + solv_energy
    1352     write (iwc, "(    10X,'DIELECTRIC ENERGY       =',F17.5,      ' EV'
 )") &
    1353        & ediel
    1354     write (iwc, "(10X,A,F14.2,A)") "COSMO AREA              =", area, "
  SQUARE ANGSTROMS"
    1355     write (iwc, "(10X,A,F14.2,A)") "COSMO VOLUME            =", cosvol,
  " CUBIC ANGSTROMS"
    1356     write (iwc, "(    10X,'TOTAL COSMO CHARGE      =',F17.5,a,/)") &
    1357        & sum
    1358     call web_message(iwc,"COSWRT.html")
    1359     write (iwc, "(10X,A)") "ATOMIC DATA "
    1360     write (iwc, "(2x,a10,4x,a24,10x,a13,2x,a12,A7,5x,a8)") " NR. ELEM."
 , "COORDINATES", &
    1361        & "RADIUS  ", "COSMO-CHARGE", "AREA", "SIGMA"
    1362     do i = 1, numat
    1363      write (iwc, "(2i5,4x,7F12.6)") i, nat (i), &
    1364        (coord(j, i), j=1, 3), srad(i), qscat(i), arat(i), qscat(i) / Ma
 x (arat(i), 1.d-10)
    1365     end do
    1366     write (iwc, "(/10X,A,i8)") " SEGMENT DATA: NPS=", nps
    1367     write (iwc, "(a15,a36,5A12)") " NR. ATOM ELEM.", &
    1368       & "COORDINATES (X, Y, Z)     ", "COSMO-CHARGE", " AREA ", &
    1369       & "SIGMA", "POTENTIAL"
    1370     do i = 1, nps
    1371       k=0
    1372       do j=1,3
    1373         sum=cosurf(j,i)
    1374         if(log10(abs(sum)).gt.4) k=max(k,int(log10(abs(sum))-3))
    1375         if(sum.lt.0.0.and. log10(abs(sum)).gt.3) &
    1376 &                   k=max(k,int(log10(abs(sum))-2))
    1377       end do
    1378       if(k.eq.0) write (iwc, "(3i5,7F12.6)") i, iatsp (i), nat (iatsp(i
 )), &
    1379 &       (cosurf(j, i), j=1, 3), qscnet(i, 3), cosurf(4, i), &
    1380 &        qscnet(i, 3) / cosurf(4, i), phinet(i, 3)
    1381       if(k.eq.1) write (iwc, "(3i5,7F12.5)") i, iatsp (i), nat (iatsp(i
 )), &
    1382 &       (cosurf(j, i), j=1, 3), qscnet(i, 3), cosurf(4, i), &
    1383 &        qscnet(i, 3) / cosurf(4, i), phinet(i, 3)
    1384       if(k.eq.2) write (iwc, "(3i5,7F12.4)") i, iatsp (i), nat (iatsp(i
 )), &
    1385 &       (cosurf(j, i), j=1, 3), qscnet(i, 3), cosurf(4, i), &
 
 FORCHECK PC V13.5.13          COSWRT          2021-03-24 10:59:30   page:  4374
 writmo.F90  /FF
 
    1386 &        qscnet(i, 3) / cosurf(4, i), phinet(i, 3)
    1387     end do
    1388   end subroutine coswrt
 
