     231               if (at(j) == 7 .or. at(j) == 8 .or. at(j) == 9 .or. at(j)
  == 15 .or. at(j) == 16 .or. at(j) == 17)then
     232                 rab  =  ((coord(1, i)-coord(1, j))**2   +  (coord(2, i)
 -coord(2, j))**2   +  (coord(3, i)-coord(3, j))**2)
