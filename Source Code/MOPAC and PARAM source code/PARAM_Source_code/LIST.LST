     250       subroutine solenr(deltap, dcie)
     251       use cosmo_C, only : amat, bmat, nden, gden, ipiden, nps, &
     252            nsetf, fnsq
     253       use molkst_c, only : mpack
     254       use funcon_C, only : a0, ev
     255       implicit none
     256       double precision  :: deltap(mpack), qsc(nps), phi(nps), qden(nden
 )
     257       integer :: i, j
     258       double precision :: dcie, fcon
     259 !**********************************************************************
 *
     260 !   RMG - adapted from dmecip subroutine in MOPAC
     261 !
     262 !   Given the density deltap (change in AO occupation upon excitation),
     263 !   computes the energetic stabilization due to electronic screening of
     264 !   the density difference (dcie).
     265 !
     266 !   See Klamt, J. Phys. Chem. 1996, 100, 3349. Correction computed here
     267 !   corresponds to the final term in Equation 10.
     268 !**********************************************************************
 *
     269
     270       dcie = 0.d0
     271       fcon = a0 * ev
     272
     273       do i = 1, nden
     274         qden(i) = gden(i) * deltap(ipiden(i))
     275       end do
     276       do i = 1, nps
     277         phi(i) = 0.d0
     278         do j = 1, nden
     279           phi(i) = phi(i) + bmat(j, i) * qden(j)
     280         end do
     281       end do
     282
     283       call coscl2 (amat, nsetf, qsc, phi, nps)
     284       do i = 1, nps
     285         dcie = dcie + qsc(i) * phi(i)
     286       end do
     287
     288       dcie = -dcie * fnsq * fcon / 2
     289
     290       return
     291       end subroutine solenr
 
