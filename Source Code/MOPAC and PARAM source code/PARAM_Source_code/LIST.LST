     919 subroutine setcup
     920    !*******************************************************************
 ****
     921    !
     922    !   SETCUP determines CUTOFP and the number of unit cells in each
     923    !          direction that will be needed in order to allow CUTOFP
     924    !   to be correctly used.
     925    !
     926    !*******************************************************************
 ****
     927     use molkst_C, only: cutofp, id, keywrd, l1u, l2u, l3u, l123, l11, l
 21, l31, line, &
     928       clower
     929     use common_arrays_C, only : tvec
     930     use chanel_C, only: iw
     931     implicit none
     932     integer :: i
     933     double precision :: area12, area13, area23, r1, r12, r13, r2, &
     934          & r23, r3, tv1, tv2, tv3, vol, sum
     935     double precision, external :: reada, volume
     936     cutofp = 1.d10
     937     l1u = 0
     938     l2u = 0
     939     l3u = 0
     940     l123 = 1
     941     if (id == 0) return
     942     i = Index (keywrd, " CUTOFP")
     943     if (i /= 0) then
     944       cutofp = reada (keywrd, i+7)
     945     else
     946       cutofp = 30.d0
     947     end if
     948 !
     949 !   Set constants for truncation function.
     950 !
     951 !   CLOWER = lower bound of truncation function, as a function of CUTOF
 P
     952 !
     953 ! Setting "clower" to 17 Angstroms seems to be okay for the gradients a
 nd for smoothness of the PES.
     954 ! It had been 14 Angstroms, but that caused significant problems with t
 he gradients.
     955 !
     956 !  If in doubt, test the gradients using DERITR
     957 !
     958     clower = Min( cutofp*2.d0/3.d0, 17.0d0)
     959    !
     960    !   CALCULATE L1U, L2U, and L3U
     961    !
     962     if (id == 1) then  !   Polymer case
     963       !
     964       !   TV1 =  length of polymer.
     965       !
     966       tv1 = Sqrt (tvec(1, 1)**2+tvec(2, 1)**2+tvec(3, 1)**2)
     967       if (tv1 < 1.d0) then
     968         line = "  Length of translation vector is too small."
     969         write(iw,'(a)')trim(line)
     970         call mopend (trim(line))
 
 FORCHECK PC V13.5.13          SETCUP          2021-03-24 10:59:30   page:  3866
 moldat.F90  /FF
 
     971         return
     972       end if
     973       l1u = Int (cutofp*4.d0/3.d0/tv1) + 1
     974     else if (id == 2) then !  Layer system
     975       !
     976       !   TV1, TV2 = Distances across unit cell.
     977       !
     978       r1 = Sqrt (tvec(1, 1)**2 + tvec(2, 1)**2 + tvec(3, 1)**2)
     979       r2 = Sqrt (tvec(1, 2)**2 + tvec(2, 2)**2 + tvec(3, 2)**2)
     980       if (r1 < 1.d0) then
     981         line = "  Length of first translation vector is too small."
     982         write(iw,'(a)')trim(line)
     983         call mopend (trim(line))
     984         return
     985       end if
     986       if (r1 < 1.d0) then
     987          line = "  Length of second translation vector is too small."
     988         write(iw,'(a)')trim(line)
     989         call mopend (trim(line))
     990         return
     991       end if
     992       r12 = Sqrt ((tvec(1, 2)-tvec(1, 1))**2 + (tvec(2, 2)-tvec(2, 1))*
 *2 &
     993            & + (tvec(3, 2)-tvec(3, 1))**2)
     994       tv1 = r1 * Sin (Acos((r1**2 + r2**2 - r12**2)/(2*r1*r2)))
     995       tv2 = r2 * Sin (Acos((r1**2 + r2**2 - r12**2)/(2*r1*r2)))
     996       l1u = Int (cutofp*4.d0/3.d0/tv1) + 1
     997       l2u = Int (cutofp*4.d0/3.d0/tv2) + 1
     998     else !  Solid-state (three-dimensional crystal)
     999       !
    1000       !   TV1,TV2,TV3 = Distances between faces of unit cell
    1001       !
    1002       r1 = Sqrt (tvec(1, 1)**2 + tvec(2, 1)**2 + tvec(3, 1)**2)
    1003       r2 = Sqrt (tvec(1, 2)**2 + tvec(2, 2)**2 + tvec(3, 2)**2)
    1004       r3 = Sqrt (tvec(1, 3)**2 + tvec(2, 3)**2 + tvec(3, 3)**2)
    1005       if (r1 < 1.d0 .or. r2 < 1.d0 .or. r3 < 1.d0) then
    1006         if (r1 < 1.d0) then
    1007           line = "  Length of first translation vector is too small."
    1008           write(iw,'(a)')trim(line)
    1009           call mopend (trim(line))
    1010           return
    1011         else if (r2 < 1.d0) then
    1012           line = "  Length of second translation vector is too small."
    1013           write(iw,'(a)')trim(line)
    1014           call mopend (trim(line))
    1015           return
    1016         else
    1017           line = "  Length of third translation vector is too small."
    1018           write(iw,'(a)')trim(line)
    1019           call mopend (trim(line))
    1020           return
    1021         end if
    1022       end if
    1023       r12 = Sqrt ((tvec(1, 2)-tvec(1, 1))**2 + (tvec(2, 2)-tvec(2, 1))*
 *2 &
    1024            & + (tvec(3, 2)-tvec(3, 1))**2)
    1025       r13 = Sqrt ((tvec(1, 3)-tvec(1, 1))**2 + (tvec(2, 3)-tvec(2, 1))*
 *2 &
    1026            & + (tvec(3, 3)-tvec(3, 1))**2)
 
 FORCHECK PC V13.5.13          SETCUP          2021-03-24 10:59:30   page:  3867
 moldat.F90  /FF
 
    1027       r23 = Sqrt ((tvec(1, 3)-tvec(1, 2))**2 + (tvec(2, 3)-tvec(2, 2))*
 *2 &
    1028            & + (tvec(3, 3)-tvec(3, 2))**2)
    1029       area12 = r1 * r2 * Sin (Acos((r1**2 + r2**2 - r12**2)/(2*r1*r2)))
    1030       area13 = r1 * r3 * Sin (Acos((r1**2 + r3**2 - r13**2)/(2*r1*r3)))
    1031       area23 = r2 * r3 * Sin (Acos((r2**2 + r3**2 - r23**2)/(2*r2*r3)))
    1032       vol = volume (tvec, id)
    1033       if (vol < 1.d0) then
