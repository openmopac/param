     926               sum = sum + delta (i, k) * coeffs(j, nelec + k)
     927             end do
     928             iden = iden + 1
     929             qdenet(iden, 1) = sum
     930           end do
     931         end do
     932       end do
     933       ! FIRST CALCULATE THE CORRESPONDING POTENTIAL AS BMAT*QDENET
     934       do i = 1, nps
     935         sum = 0.d0
     936         do j = 1, lm61
     937           sum = sum + bmat(j, i) * qdenet(j, 1)
     938         end do
     939         phinet(i, 1) = sum
     940       end do
     941       ! NOW CALCULATE THE CORRESPONDING SCREENING CHARGES FROM A*QSCNET
  = -QDENE
     942       call coscl2 (amat, nsetf, qscnet, phinet, nps)
     943       edie = 0.d0
     944       ! NOW CALCULATE THE DIELECTRIC ENERGY AS QSCNET*PHINET
     945       do i = 1, nps
     946         edie = edie + qscnet(i, 1) * phinet(i, 1)
     947       end do
     948       edie = fact * edie
     949       eig(ist) = eig(ist) + edie
     950     end do
     951     do j = 1, lab
     952       vectci(j) = conf(j)
     953     end do
     954 end subroutine dmecip
 
