       1       logical function myword (keywrd, testwd)
       2       implicit none
       3 !-----------------------------------------------
       4 !   D u m m y   A r g u m e n t s
       5 !-----------------------------------------------
       6       character , intent(inout) :: keywrd*(*)
       7       character , intent(in) :: testwd*(*)
       8 !-----------------------------------------------
       9 !   L o c a l   V a r i a b l e s
      10 !-----------------------------------------------
      11       integer :: j, k, len_key
      12       logical :: quote
      13 !-----------------------------------------------
      14       myword = .FALSE.
      15       len_key = len_trim(keywrd)
      16 !
      17 !  If the keyword containes quoted text, then ignore text between quota
 tion marks.
      18 !  quote starts off .FALSE.
      19 !  quote is turned .TRUE. if a quotation mark, '"', is found
      20 !  quote is turned .FALSE. when another quotation mark is found.
      21       quote = .false.
      22    10 continue
      23       j = index(keywrd,testwd)
      24       if (j /= 0) then
      25 !
      26 !  Keyword found.  Now delete keyword in its entirety
      27 !
      28    20   continue
      29         do while(keywrd(j:j) == ' ')
      30           j = j + 1
      31         end do
      32         myword = .TRUE.
      33         do k = j, len_key
      34           if (keywrd(k:k) == '"') quote = (.not. quote)
      35           if (.not. quote) then
      36             if (keywrd(k:k)=='=' .or. keywrd(k:k)==' ') then
      37 !
      38 !     CHECK FOR ATTACHED '=' SIGN
      39 !
      40               j = k
      41               if (keywrd(j:j) == '=') go to 50
      42 !
      43 !     CHECK FOR SEPARATED '=' SIGN
      44 !
      45               do j = k + 1, len_key
      46                 if (keywrd(j:j) == '=') go to 50
      47                 if (keywrd(j:j) /= ' ') go to 10
      48               end do
      49 !
      50 !    THERE IS NO '=' SIGN ASSOCIATED WITH THIS KEYWORD
      51 !
      52               go to 10
      53      50       continue
      54               keywrd(j:j) = ' '
      55 !
      56 !   THERE MUST BE A NUMBER AFTER THE '=' SIGN, SOMEWHERE
      57 !
 
 FORCHECK PC V13.5.13          MYWORD          2021-03-24 10:59:30   page:   476
 myword.F90  /FF
 
      58               go to 20
      59             end if
      60           end if
      61           keywrd(k:k) = ' '
      62         end do
      63       end if
      64       return
      65       end function myword
 
