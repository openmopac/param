      57       end if
      58       if (numat /= 0 .and. numat == numm) then
      59 !
      60 !    PRINT OVER ATOM COUNT
      61 !
      62         do i = 1, numat
      63           itext(i) = '  '
      64           jtext(i) = elemnt(nat(i))
      65           natom(i) = i
      66         end do
      67       else
      68         if (numat /= 0 .and. nlast(numat) == numm) then
      69           do i = 1, numat
      70             jlo = nfirst(i)
      71             jhi = nlast(i)
      72             l = nat(i)
      73             k = 0
      74             itext(jlo:jhi) = atorbs(:jhi-jlo+1)
      75             jtext(jlo:jhi) = elemnt(l)
      76             natom(jlo:jhi) = i
      77           end do
      78         else
      79           do i = 1, numb
      80             itext(i) = '  '
      81             jtext(i) = '  '
      82             natom(i) = i
      83           end do
      84         end if
      85       end if
      86       line = '------'
      87       limit = (numb*(numb + 1))/2
      88       kk = 8
      89       na = 1
      90       if (numb > 999) then
      91         fmt = "(/,/,12x,10(1x,a2,1x,a2,i4,1x))"
      92       else
      93         fmt = "(/,/,13x,10(1x,a2,1x,a2,i3,2x))"
      94       end if
      95    80 continue
      96       ll = 0
      97       m = min0(numb + 1 - na, 6)
      98       ma = 2*m + 1
      99       m = na + m - 1
     100       write (iw, fmt) (itext(i), jtext(i), natom(i), i = na, m)
     101       write (iw, "(' ',21a6)") (line(k),k=1,ma)
     102       do i = na, numb
     103         ll = ll + 1
     104         k = (i*(i - 1))/2
     105         l = min0(k + m,k + i)
     106         k = k + na
     107         if (kk + ll > 50) then
     108           write (iw, fmt) (itext(n), jtext(n), natom(n) ,n = na, m)
     109           write (iw, "(' ',21a6)") (line(n),n=1,ma)
     110           kk = 4
     111           ll = 0
     112         end if
     113         write (iw, "(' ', a2, 1x, a2, i5, 10f11.6)") itext(i), jtext(i)
 , natom(i), (a(n), n = k, l)
     114       end do
 
 FORCHECK PC V13.5.13          VECPRT          2021-03-24 10:59:30   page:  2509
 vecprt.F90  /FF
 
     115       if (l >= limit) go to 110
     116       kk = kk + ll + 4
     117       na = m + 1
     118       if (kk + numb + 1 - na <= 50) go to 80
     119       kk = 4
     120       go to 80
     121   110 continue
     122       if (abs(fact - 1.D0) > 0.001D0) then
     123         do i = 1, numm
     124           a((i*(i+1))/2) = a((i*(i+1))/2)/fact
     125         end do
     126       end if
     127       return
     128       end subroutine vecprt
 
