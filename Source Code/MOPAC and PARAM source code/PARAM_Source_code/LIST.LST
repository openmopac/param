    1727   subroutine aq_mult_int (ind, n, psi, p, x0, y0, z0, y_norm, pmn, c, n
 3, &
    1728        & q, r)
    1729     !
    1730     ! Computes part of the A*q product for far surface elements,
    1731     ! using local expansions
    1732     !
    1733     implicit none
    1734     integer, intent(in) :: n, p, n3
    1735     integer, intent(in), dimension(*) :: ind
    1736     complex (kind=dcmplx_kind), dimension(-p:p, 0:p), intent(in) :: psi
    1737     double precision, dimension(-p:p, 0:p), intent(in) :: y_norm
    1738     double precision, dimension(-p:p, 0:p), intent(out) :: pmn
    1739     double precision, intent(in), dimension(n3, *) :: c
    1740     double precision, intent(in), dimension(*) :: q
    1741     double precision, intent(inout), dimension(*) :: r
    1742     double precision, intent(in) :: x0, y0, z0
    1743     integer :: i, j, k
    1744     double precision :: dx, dy, dz, d, phi, cos_t, t
    1745     complex (kind=dcmplx_kind) :: tc
    1746     intrinsic Real, Cmplx, Atan2, Sqrt, Exp
    1747 !
    1748 ! Dummy statement to "use" q
    1749 !
    1750     dx = q(1)
    1751     do i = 1, n
    1752       dx = c(1, ind(i)) - x0
    1753       dy = c(2, ind(i)) - y0
    1754       dz = c(3, ind(i)) - z0
    1755
    1756       d = Sqrt (dx**2 + dy**2 + dz**2)
    1757       cos_t = dz / d
    1758       phi = Atan2 (dy, dx)
    1759
    1760       call get_legendre (p, cos_t, pmn)
    1761
    1762       t = 0.d0
    1763       do j = 0, p
    1764         tc = (0.d0, 0.d0)
    1765
    1766         do k = 1, j
    1767           tc = tc + y_norm(k, j) * pmn(k, j) * d**j &
    1768                & * psi(k, j) * Exp (Cmplx (0.d0, k*phi, dcmplx_kind))
    1769         end do
    1770
    1771         t = t + 2.d0 * Real (tc) + pmn(0, j) * d**j * Real (psi(0, j))
    1772       end do
    1773
    1774       r(ind(i)) = r(ind(i)) + t
    1775
    1776     end do
    1777
    1778   end subroutine aq_mult_int
 
