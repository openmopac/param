    2575   subroutine addfckz
    2576     !
    2577     ! Adds correction to the Fock matrix due to charges on surface
    2578     ! Computes corrections to total energy
    2579     !
    2580     use molkst_C, only: lm61, numat
    2581     use cosmo_C, only : nps, solv_energy, fepsi, cosurf, iatsp, phinet,
  &
    2582       qscnet, qdenet, ipiden, gden, qscat, ediel
    2583     use parameters_C, only: tore
    2584     use funcon_C, only: a0, ev
    2585
    2586     use common_arrays_C, only: coord, nfirst, nlast, nat, f, p
    2587     !
    2588     !.. Implicit Declarations ..
    2589     implicit none
    2590     !
    2591     !.. Local Scalars ..
    2592     integer :: i, iat, im, j, ii, nao, nnn, ierr
    2593     double precision :: fcon, qsc3, s1, t
    2594     !.. Local Arrays ..
    2595     integer :: idiag(9) = (/ 1, 3, 6, 10, 15, 21, 28, 36, 45 /)
    2596     double precision :: w(45), v(45)
    2597     !
    2598     !.. Intrinsic Functions ..
    2599     intrinsic Sum
    2600     !
    2601     ! ... Executable Statements ...
    2602
    2603     fcon = a0 * ev
    2604     qscat(1:numat) = 0.d0
    2605     phinet(1:nps, 2) = 0.d0
    2606     if (numat > nb1max .or. numat > nb2max) then
    2607       do i = 1, numat
    2608         ii = ijbo_diag(i)
    2609         j = nlast(i) - nfirst(i) + 1
    2610         s1 = Sum(p(ii + idiag(1:j)))
    2611         q_vec(i) = -s1 + tore(nat(i))
    2612       end do
    2613
    2614       call set_tesselation (atom_handle, ierr)
    2615       if (ierr == -1000) return ! dummy use of ierr
    2616     end if
    2617
    2618     if (numat > nb2max) then
    2619       call afmm (coord, 3, numat, q_vec, phinet(1, 2), nps, &
    2620            & bp_dir_int, bz_mult_int)
    2621
    2622     elseif (numat > nb1max) then
    2623       call simple_mm (coord, 3, numat, q_vec, phinet(1, 2), &
    2624            & bp_dir_int, bz_far_int)
    2625
    2626     else
    2627       call bz_vec (phinet(1, 1))
    2628       call bpnew_vec (phinet(1, 2))
    2629       phinet(1:nps, 2) = phinet(1:nps, 1) + phinet(1:nps, 2)
    2630       phinet(1:nps, 1) = 0
    2631       !!stop
 
 FORCHECK PC V13.5.13         ADDFCKZ          2021-03-24 10:59:30   page:  2310
 linear_cosmo.F90  /FF
 
    2632     end if
    2633
    2634     phinet(1:nps, 3) = phinet(1:nps, 2)
    2635
    2636     if (new_surface) then
    2637       call cgm_solve (qscnet(1, 2), nps, phinet(1, 2), &
    2638            & r_vec, p_vec, q_vec, z_vec, m_vec, .true., .true.)
    2639       new_surface = .false.
    2640     else
    2641       qscnet(1:nps, 2) = qscnet(1:nps, 2) / (-fepsi)
    2642       call cgm_solve (qscnet(1, 2), nps, phinet(1, 2), &
    2643            & r_vec, p_vec, q_vec, z_vec, m_vec, .false., .false.)
    2644     end if
    2645
    2646     ediel = 0.d0
    2647     s1 = 0.0d0
    2648     do i = 1, nps
    2649       iat = iatsp(i)
    2650       qscnet(i, 2) = -fepsi * qscnet(i, 2)
    2651       qsc3 = qscnet(i, 1) + qscnet(i, 2)
    2652       qscnet(i, 3) = qsc3
    2653       ediel = ediel + qsc3 * phinet(i, 3)
    2654       s1 = s1 + qscnet(i, 1)
    2655       qscat(iat) = qscat(iat) + qsc3
    2656     end do
    2657     ediel = ediel * fcon / 2
    2658
    2659     if (numat > nb1max .or. numat > nb2max) then
    2660       call set_tesselation (atom_handle, ierr)
    2661       qdenet(1:lm61, 2) = 0
    2662     end if
    2663
    2664     if (numat > nb2max) then
    2665       call afmm (coord, 3, numat, qscnet(1, 2), qdenet(1, 2), lm61, &
    2666            & fock_dir_int, fock_mult_int, sphere_f_multipoles)
    2667
    2668       f(ipiden(1:lm61)) = f(ipiden(1:lm61)) - qdenet(1:lm61, 2) * fcon
    2669
    2670       s1 = 0.d0
    2671       do i = 1, lm61
    2672         s1 = s1 + qdenet(i, 2) * p(ipiden(i)) * gden(i)
    2673       end do
    2674       s1 = -s1 *fcon
    2675
    2676     elseif (numat > nb1max) then
    2677       call simple_mm (coord, 3, numat, qscnet(1, 2), qdenet(1, 2), &
    2678            & fock_dir_int, fock_far_int, sphere_f_multipoles)
    2679
    2680       f(ipiden(1:lm61)) = f(ipiden(1:lm61)) - &
    2681            & qdenet(1:lm61, 2) * fcon
    2682
    2683       s1 = 0.d0
    2684       do i = 1, lm61
    2685         s1 = s1 + qdenet(i, 2) * p(ipiden(i)) * gden(i)
    2686       end do
    2687       s1 = -s1 * fcon
    2688
    2689     else
    2690
 
 FORCHECK PC V13.5.13         ADDFCKZ          2021-03-24 10:59:30   page:  2311
