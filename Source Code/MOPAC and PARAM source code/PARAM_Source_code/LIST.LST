       1       subroutine ciosci(vects, lroot, oscil, conf)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use molkst_C, only: numat,  norbs, keywrd
       6       use common_arrays_C, only : coord, nfirst, nlast, nat
       7       USE parameters_C, only : dd, zp, zd
       8       use funcon_C, only : a0
       9       use meci_C, only : nstate, lab, nmos, microa, microb
      10       use chanel_C, only: iw
      11 !**********************************************************************
 *
      12 !-----------------------------------------------
      13 !   I n t e r f a c e   B l o c k s
      14 !-----------------------------------------------
      15       implicit none
      16 !-----------------------------------------------
      17 !   G l o b a l   P a r a m e t e r s
      18 !-----------------------------------------------
      19 !-----------------------------------------------
      20 !   C o m m o n   B l o c k s
      21 !-----------------------------------------------
      22
      23 !-----------------------------------------------
      24 !   D u m m y   A r g u m e n t s
      25 !-----------------------------------------------
      26       double precision , intent(in) :: vects(norbs,norbs)
      27       double precision , intent(inout) :: oscil(3,*)
      28       double precision, dimension(:,:), allocatable :: t4
      29       double precision , intent(in) :: conf(lab*lab)
      30       integer :: lroot
      31 !-----------------------------------------------
      32 !   L o c a l   V a r i a b l e s
      33 !-----------------------------------------------
      34       integer , dimension(14) :: ll
      35       integer :: loop, iloop, iatom, i, j, k, l, m, ii, ij, jj, istate,
  &
      36       nd, npp, ns
      37       double precision, dimension(norbs,nmos) :: vect1, vect2
      38       double precision, dimension(nmos,nmos) :: t2
      39       double precision, dimension(lab) :: work
      40       integer, dimension (107), save :: nspqn
      41       double precision, dimension (numat) :: sppol
      42       double precision, dimension (:), allocatable :: pdpol
      43       character (len=1) :: type (3)
      44       double precision :: sum
      45       logical :: debug
      46 !**********************************************************************
 *
      47 !
      48 !    CIOSCI evaluates the expectation value <STATE|x or y or z|STATE>
      49 !
      50 !   Info:   VECTS  = Molecular Orbitals
      51 !           CONF   = State Eigenvectors
      52 !           NSTATE = State to be excited from
      53 !
      54 !
      55 !**********************************************************************
 
 FORCHECK PC V13.5.13          CIOSCI          2021-03-24 10:59:30   page:  3507
 ciosci.F90  /FF
 
 *
      56       data nspqn / 2 * 1, 8 * 2, 8 * 3, 18 * 4, 18 * 5, 32 * 6, 21 * 0
 /
      57       data type / "x", "y", "z" /
      58       debug = (Index (keywrd, "CIOSCI") /= 0)
      59       allocate(t4(lab, lab))
      60    !
      61    !   a0 = 0.529
      62    !
      63    ! dd(i) = (2*n+1)*2**(2n+1)*(exp(s)*exp(p))**(n+1/2)
      64    !           ----------------------------------------  See calpar
      65    !          (sqrt(3)*(exp(s)+exp(p))**(2*n+2))
      66    !
      67    ! dd is the transition length <ns|r|np> in bohr
      68    !
      69       sppol(:numat) = a0 * dd(nat(:numat))
      70       ll(1) = 1
      71       do i = 2, 14
      72         ll(i) = ll(i-1) * i
      73       end do
      74   !
      75   !  For p-d transitions,
      76   !  pdpop(i) = (np+nd+1)!*2**(np+nd+1)*exp(p)**(np+1/2)*exp(d)**(nd+1/
 2)
      77   !              ------------------------------------------------------
 --
      78   !             sqrt(5)*(exp(p)+exp(d)**(np+nd+2)*sqrt( (2*np)! * (2*nd
 )! )
      79   !
      80       allocate (pdpol(numat))
      81       do i = 1, numat
      82         if (nlast(i)-nfirst(i) > 5) then
      83           j = nat(i)
      84           nd = nspqn(j)
      85           npp = nd
      86           if (j > 20) npp = npp - 1
      87           pdpol(i) = a0 * ll(npp+nd+1) * 2 ** (npp+nd+1) * &
      88                & zp(j) ** (npp+ 0.5d0) * zd(j) ** (nd+0.5d0) / &
      89                & (Sqrt(5.d0)*(zp(j)+zd(j))**(npp+nd+2) * &
      90                & Sqrt(Dble(ll((2*npp))*ll(2*nd))))
      91         end if
      92       end do
      93       oscil(:3, :lab) = 0.d0
      94       do loop = 1, 3
      95         !
      96         !    SET UP THE M.O. UNITARY MATRIX, <PSI | IOPER | PSI>
      97         !
      98         do iloop = 1, nmos
      99           do iatom = 1, numat
     100             do i = nfirst(iatom), nlast(iatom)
     101               vect1(i, iloop) = vects(i, iloop)
     102               vect2(i, iloop) = vects(i, iloop) * coord(loop, iatom)
     103               if (nat(iatom) /= 1) then
     104   !
     105   !   Include the s-p transition on the same atom
     106   !
     107                 if (i == nfirst(iatom)) then
     108                   vect2(i, iloop) = vect2(i, iloop) + sppol(iatom) * &
     109                        & vects(i+loop, iloop)
 
 FORCHECK PC V13.5.13          CIOSCI          2021-03-24 10:59:30   page:  3508
 ciosci.F90  /FF
 
     110                 else if (i-nfirst(iatom) == loop) then
     111                   vect2(i, iloop) = vect2(i, iloop) + sppol(iatom) * &
     112                        & vects(i-loop, iloop)
     113                 end if
     114                 if (i == nfirst(iatom)+8) then
     115   !
     116   !  k = start of "p" shell - 1;  l = start of "d" shell - 1.
     117   !
     118                   k = nfirst(iatom)
     119                   l = k + 3
     120   !
     121   ! Add in p - d transition.  Do all three (x, y, z) at one time
     122   !
     123                   if (loop == 1) then
     124                     vect2(k+1, iloop) = vect2(k+1, iloop) + pdpol(iatom
 ) * &
     125                          & (vects(l+1, iloop)-1/Sqrt(3.d0)*vects(l+3, i
