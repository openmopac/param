     309   subroutine prt_hbonds(D, H, A, energy)
     310   use common_arrays_C, only: nat, txtatm, H_txt, H_energy
     311   use molkst_C, only : numat, keywrd, numcal, P_hbonds, maxtxt
     312   use elemts_C, only: elemnt
     313   implicit none
     314   integer, intent (in) :: D, H, A
     315   double precision, intent (in) :: energy
     316 !
     317 !  Local
     318 !
     319   integer :: icalcn = -1
     320   double precision :: cutoff, sum1
     321   double precision, external :: distance, reada
     322   logical :: prt_first
     323   save :: prt_first, cutoff, icalcn
     324     if (icalcn /= numcal) then
     325       icalcn = numcal
     326       if (allocated(H_txt)) deallocate (H_txt, H_energy)
     327       prt_first = .true.
     328       allocate(H_txt(numat), H_energy(numat))
     329       P_hbonds = 0
     330     end if
     331     if (prt_first) then
     332       prt_first = .false.
     333       cutoff = reada(keywrd, index(keywrd," DISP("))
     334       cutoff = -abs(cutoff)
     335       P_Hbonds = 0
     336     end if
     337     if (energy > -0.5d0) return
     338     sum1 = distance(D,H)
     339     P_Hbonds = min(numat, P_Hbonds + 1)
     340     if (txtatm(D) == " ") write(txtatm(D),'(a,i5,3x,a)')"Atom No.:", D,
  elemnt(nat(D))
     341     if (txtatm(H) == " ") write(txtatm(H),'(a,i5,3x,a)')"Atom No.:", H,
  elemnt(nat(H))
     342     if (txtatm(A) == " ") write(txtatm(A),'(a,i5,3x,a)')"Atom No.:", A,
  elemnt(nat(A))
     343     if (maxtxt == 0) then
     344       write(H_txt(P_Hbonds),'(2x,a,f15.3,6x,a,12x,a,10x, f7.2,a)')trim(
 txtatm(D)), sum1,  &
     345       trim(txtatm(H)), trim(txtatm(A)), energy, " Kcal/mol"
     346     else
     347       write(H_txt(P_Hbonds),'(a,2x,f6.3,3x,a,3x,a,3x, f7.2,a)')""""//tx
 tatm(D)(:maxtxt)//"""", sum1,  &
     348       """"//txtatm(H)(:maxtxt)//"""", """"//txtatm(A)(:maxtxt)//"""", e
 nergy, " Kcal/mol"
     349     end if
     350     H_energy(P_Hbonds) = energy
     351     return
     352   end subroutine prt_hbonds
 
