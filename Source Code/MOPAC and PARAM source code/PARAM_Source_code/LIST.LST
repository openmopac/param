    1878     l_first = .true.
    1879     sum1 = 0.d0
    1880     lim = min(60, numat)
    1881     if (.not. precise) lim = min(30, lim)
    1882     do i = 1, lim
    1883       dum1 = -1.d0
    1884       do j = 1, numat
    1885         if (dum1 < move(j)) then
    1886           dum1 = move(j)
    1887           k = j
