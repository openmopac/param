       1   subroutine diagg2 (nocc, nvir,  eigv, iused, latoms, &
       2      & nij, idiagg, storei, storej)
       3    !*******************************************************************
 ****
       4    !
       5    !   DIAGG2  PERFORMS A SIMPLE JACOBIAN ANNIHILATION OF THE ENERGY TE
 RMS
       6    !   CONNECTING THE OCCUPIED LMOS AND THE VIRTUAL LMOS.  THE ENERGY T
 ERMS
       7    !   ARE IN THE ARRAY FMO, AND THE INDICES OF THE LMOS ARE IN IFMO.
       8    !
       9    !*******************************************************************
 ****
      10     use molkst_C, only: numat, norbs, numcal, keywrd, id
      11     use MOZYME_C, only : nvirtual, icocc_dim, shift, &
      12        & icvir_dim, cocc_dim, cvir_dim, ipad2, thresh, tiny, sumb, &
      13        ncf, nce, nncf, nnce, ncocc, ncvir, iorbs, cocc, cvir, icocc, ic
 vir, &
      14        ifmo, fmo
      15 !
      16     use common_arrays_C, only : eigs, nat
      17     use parameters_C, only: main_group
      18     use chanel_C, only: iw
      19     implicit none
      20     integer, intent (in) :: idiagg, nij, nocc, nvir
      21     logical, dimension (numat), intent (out) :: latoms
      22     integer, dimension (numat), intent (out) :: iused
      23     double precision, dimension (norbs), intent (out) :: storei, storej
      24     double precision, dimension (nvirtual), intent (in) :: eigv
      25     logical :: bug = .false.
      26     logical :: retry
      27     logical, save :: debug, times
      28     integer :: i, ii, jur, l
      29     integer, save :: icalcn = 0
      30     integer :: ij, ilr, incv, iur, j, jlr, jncf, k, le, lf, lij, loopi,
  loopj, &
      31    & mie, mle, mlee, mlf, mlff, ncei, ncfj, nrej
      32     double precision :: a, alpha, b, beta, biglim, c, d, e, sum
      33     double precision, save :: const, eps, eta, bigeps
      34     double precision, external :: reada
      35     integer, dimension (2) :: nrejct
      36     data nrejct / 2 * 0 /
      37     if (numcal /= icalcn) then
      38       icalcn = numcal
      39       times = (Index (keywrd, " TIMES") /= 0)
      40       debug = (Index (keywrd, " DIAGG2") /= 0)
      41       !
      42       !   IF THE SYSTEM IS A SOLID, THEN DAMP ROTATION OF VECTORS,
      43       !   IN AN ATTEMPT TO PREVENT AUTOREGENERATIVE CHARGE OSCILLATION.
      44       !
