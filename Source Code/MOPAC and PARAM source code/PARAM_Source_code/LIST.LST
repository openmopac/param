    1785      subroutine getattrib(xmin, xmax)
    1786     !-----------------------------------------------
    1787     !   M o d u l e s
    1788     !-----------------------------------------------
    1789           use molkst_C, only : numat, natoms
    1790           use common_arrays_C, only : geo, coord, labels, nat
    1791           use esp_C, only : nesp, co
    1792           use chanel_C, only : iw
    1793     !
    1794     !     ROUTINE TO CALCULATE WILLIAMS SURFACE
    1795     !
    1796     !******************************************************************
 *****
    1797     !-----------------------------------------------
    1798     !   I n t e r f a c e   B l o c k s
    1799     !-----------------------------------------------
    1800           implicit none
    1801         !.. Formal Arguments ..
    1802           double precision, dimension (3), intent (out) :: xmin
    1803           double precision, dimension (3), intent (out) :: xmax
    1804     !-----------------------------------------------
    1805     !   L o c a l   V a r i a b l e s
    1806     !-----------------------------------------------
    1807           integer :: icntr, i, j, ia
    1808           double precision, dimension(53) :: vderw
    1809           double precision :: shell, vdmax
    1810     !-----------------------------------------------
    1811     !
    1812           data vderw/ 53*0.0D0/
    1813           vderw(1) = 2.4D0
    1814           vderw(5) = 3.0D0
    1815           vderw(6) = 2.9D0
    1816           vderw(7) = 2.7D0
    1817           vderw(8) = 2.6D0
    1818           vderw(9) = 2.55D0
    1819           vderw(15) = 3.1D0
    1820           vderw(16) = 3.05D0
    1821           vderw(17) = 3.0D0
    1822           vderw(35) = 3.15D0
    1823           vderw(53) = 3.35D0
    1824           shell = 1.2D0
    1825           nesp = 0
    1826     !     CHECK IF VDERW IS DEFINED FOR ALL ATOMS
    1827     !
    1828     !     CONVERT INTERNAL TO CARTESIAN COORDINATES
    1829     !
    1830           call gmetry (geo, coord)
    1831     !
    1832     !     STRIP COORDINATES AND ATOM LABEL FOR DUMMIES (I.E. 99)
    1833     !
    1834           icntr = 0
    1835           do i = 1, natoms
