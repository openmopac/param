    2031   subroutine add_a_generic_hydrogen_atom(na, nb, nc, bond_length, angle
 , dihedral, metals, nmetals)
    2032 !
    2033 !  Add a single hydrogen atom to a heavy atom.
    2034 !  (This subroutine is generic, and is derived from subroutine geout)
    2035 !
    2036     use common_arrays_C, only : coord, nbonds, ibonds, nat
    2037     use molkst_C, only : numat, id, temp_1, temp_2, temp_3
    2038     implicit none
    2039     double precision, intent (in) :: bond_length, angle, dihedral
    2040     integer, intent (in) :: na, nb, nc, nmetals, metals(nmetals)
    2041 !
    2042     double precision :: xb, yb, zb, rbc, xa, ya, za, xpa, xpb, costh, s
 inth, &
    2043       sinph, cosph, zqa, yza, xyb, ypa, coskh, sinkh, sina, cosd, &
    2044       xd, yd, zd, xpd, ypd, zqd, xqd, yqd, xrd, cosa, sind, zpd
    2045     integer :: k
    2046     double precision, external :: distance
    2047     logical, external :: near_a_metal
    2048       cosa = cos(angle)
    2049       if (id > 0) then
    2050         xb = distance(nb, na)
    2051         xb = temp_1
    2052         yb = temp_2
    2053         zb = temp_3
    2054       else
    2055         xb = coord(1,nb) - coord(1,na)
    2056         yb = coord(2,nb) - coord(2,na)
    2057         zb = coord(3,nb) - coord(3,na)
    2058       end if
    2059       rbc = xb*xb + yb*yb + zb*zb
    2060       rbc = 1.0D00/sqrt(rbc)
    2061       if (nc /= 0) then
    2062         if (id > 0) then
    2063           xa = distance(nc, na)
    2064           xa = temp_1
    2065           ya = temp_2
    2066           za = temp_3
    2067         else
    2068           xa = coord(1,nc) - coord(1,na)
    2069           ya = coord(2,nc) - coord(2,na)
    2070           za = coord(3,nc) - coord(3,na)
    2071         end if
    2072       else
    2073         xa = 1.d0
    2074         ya = 2.d0
    2075         za = 3.d0
    2076       end if
    2077 !
    2078 !     ROTATE ABOUT THE Z-AXIS TO MAKE YB=0, AND XB POSITIVE.  IF XYB IS
    2079 !     TOO SMALL, FIRST ROTATE THE Y-AXIS BY 90 DEGREES.
    2080 !
    2081       xyb = sqrt(xb*xb + yb*yb)
    2082       k = -1
    2083       if (xyb <= 0.009d0) then
    2084         xpa = za
    2085         za = -xa
    2086         xa = xpa
 
 FORCHECK PC V13.5.13                          2021-03-24 10:59:30   page:   765
 add_hydrogen_atoms.F90  /FF
 
    2087         xpb = zb
    2088         zb = -xb
    2089         xb = xpb
    2090         xyb = sqrt(xb*xb + yb*yb)
    2091         k = 1
    2092       end if
    2093 !
    2094 !     ROTATE ABOUT THE Y-AXIS TO MAKE ZB VANISH
    2095 !
    2096       costh = xb/xyb
    2097       sinth = yb/xyb
    2098       xpa = xa*costh + ya*sinth
    2099       ypa = ya*costh - xa*sinth
    2100       sinph = zb*rbc
    2101       cosph = sqrt(abs(1.D00 - sinph*sinph))
    2102       zqa = za*cosph - xpa*sinph
    2103 !
    2104 !     ROTATE ABOUT THE X-AXIS TO MAKE ZA=0, AND YA POSITIVE.
    2105 !
    2106       yza = sqrt(ypa**2 + zqa**2)
    2107       if (yza >= 1.D-4) then
    2108         coskh = ypa/yza
    2109         sinkh = zqa/yza
    2110       else
    2111 !
    2112 !   ANGLE TOO SMALL TO BE IMPORTANT
    2113 !
    2114         coskh = 1.D0
    2115         sinkh = 0.D0
    2116       end if
    2117 !
    2118 !     COORDINATES :-   A=(???,YZA,0),   B=(RBC,0,0),  C=(0,0,0)
    2119 !     NONE ARE NEGATIVE.
    2120 !     THE COORDINATES OF I ARE EVALUATED IN THE NEW FRAME.
    2121 !
    2122       sina = sin(angle)
    2123       sind = -sin(dihedral)
    2124       cosd = cos(dihedral)
    2125       xd = bond_length*cosa
    2126       yd = bond_length*sina*cosd
    2127       zd = bond_length*sina*sind
    2128 !
    2129 !     TRANSFORM THE COORDINATES BACK TO THE ORIGINAL SYSTEM.
    2130 !
    2131       ypd = yd*coskh - zd*sinkh
    2132       zpd = zd*coskh + yd*sinkh
    2133       xpd = xd*cosph - zpd*sinph
    2134       zqd = zpd*cosph + xd*sinph
    2135       xqd = xpd*costh - ypd*sinth
    2136       yqd = ypd*costh + xpd*sinth
    2137       if (k >= 1) then
    2138         xrd = -zqd
    2139         zqd = xqd
    2140         xqd = xrd
    2141       end if
    2142       numat = numat + 1
    2143       coord(1,numat) = xqd + coord(1,na)
    2144       coord(2,numat) = yqd + coord(2,na)
    2145       coord(3,numat) = zqd + coord(3,na)
 
 FORCHECK PC V13.5.13                          2021-03-24 10:59:30   page:   766
 add_hydrogen_atoms.F90  /FF
 
    2146       nbonds(na) = nbonds(na) + 1
    2147       nbonds(numat) = 1
    2148       nat(numat) = 1
    2149       ibonds(1,numat) = na
    2150       ibonds(nbonds(na),na) = numat
    2151       if (near_a_metal(na, numat, metals, nmetals)) numat = numat - 1
    2152       return
    2153   end subroutine add_a_generic_hydrogen_atom
 
