       1   subroutine to_screen(text0)
       2   use chanel_C, only : iw0
       3   use molkst_C, only : keywrd
       4   implicit none
       5   character (len=*) :: text0
       6   character (len=200) :: text
       7   integer :: i
       8   i = len_trim(text0)
       9   if (i == 0) then
      10 !
      11 ! Length not passed, so work it out
      12 !
      13     do i = 1, 200
      14       if (ichar(text0(i:i)) == 0) exit
      15     end do
      16     i = i - 1
      17   end if
      18   text = text0(:i)
      19   if (text(:min(len_trim(text), 8)) /= "To_file:") then
      20     if (iw0 > -1) then
      21       write(iw0,"(a)") trim(text)
      22       call flush (iw0)
      23     end if
      24   else
      25     if (index(keywrd, " AUX") == 0) return
      26     call current_version(text)
      27   end if
      28   end subroutine to_screen
 
