     999       double precision, external :: charg
    1000 !-----------------------------------------------
    1001 !     *
    1002 !
    1003       pij = 0.d0
    1004       pkl = 0.d0
    1005       l1min = iabs(li - lj)
    1006       l1max = li + lj
    1007       lij = indx(li+1,lj+1)
    1008       l2min = iabs(lk - ll)
    1009       l2max = lk + ll
    1010       lkl = indx(lk+1,ll+1)
    1011       l1max = min(l1max,2)
    1012       l1min = min(l1min,2)
    1013       l2max = min(l2max,2)
    1014       l2min = min(l2min,2)
    1015       sum = 0.D00
    1016 !
    1017       do l1 = l1min, l1max
    1018         if (l1 == 0) then
    1019           select case (lij)
    1020           case (1)
    1021             pij = po(1,ni)
    1022             if (ic == 1) pij = po(9,ni)
    1023           case (3)
