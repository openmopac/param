      52       subroutine aintgs(x, k)
      53 !-----------------------------------------------
      54 !   M o d u l e s
      55 !-----------------------------------------------
      56       USE overlaps_C, only : a
      57       implicit none
      58 !-----------------------------------------------
      59 !   D u m m y   A r g u m e n t s
      60 !-----------------------------------------------
      61       integer , intent(in) :: k
      62       double precision , intent(in) :: x
      63 !-----------------------------------------------
      64 !   L o c a l   V a r i a b l e s
      65 !-----------------------------------------------
      66       integer :: i
      67       double precision :: c
      68 !-----------------------------------------------
      69 !**********************************************************************
 *
      70 !
      71 !    AINTGS FORMS THE "A" INTEGRALS FOR THE OVERLAP CALCULATION.
      72 !
      73 !**********************************************************************
 *
      74       c = exp((-x))
      75       a(1) = c/x
      76       do i = 1, k
      77         a(i+1) = (a(i)*i+c)/x
      78       end do
      79       return
      80 !
      81       end subroutine aintgs
 
