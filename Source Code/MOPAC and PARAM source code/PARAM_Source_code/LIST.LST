     130       subroutine symp
     131 !-----------------------------------------------
     132 !   M o d u l e s
     133 !-----------------------------------------------
     134       use symmetry_C, only : nsym, r, ipo, name
     135       USE molkst_C, ONLY: numat
     136       USE chanel_C, only : iw
     137 !**********************************************************************
 *
     138       implicit none
     139 !-----------------------------------------------
     140 !   G l o b a l   P a r a m e t e r s
     141 !-----------------------------------------------
     142 !-----------------------------------------------
     143 !   L o c a l   P a r a m e t e r s
     144 !-----------------------------------------------
     145       integer, parameter :: maxfun = 120
     146       double precision, parameter :: tol = 1D-2
     147 !-----------------------------------------------
     148 !   L o c a l   V a r i a b l e s
     149 !-----------------------------------------------
     150       integer :: i, j, n, m
     151       double precision :: res
     152 !-----------------------------------------------
     153 !****************************************************************
     154 !
     155 !   ON INPUT   R    = SYMMETRY OPERATIONS (7 MAX)
     156 !              IPO  = PERM OPR FOR ABOVE OPERATIONS
     157 !              NSYM = CURRENT NUMBER OF SYMMETRY OPERATIONS
     158 !              NENT = NUMBER OF USER SUPPLIED OPERATIONS
     159 !
     160 !   ON OUTPUT  R    = SYMMETRY OPERATIONS (120 MAX)
     161 !              IPO  = PERMUTATION OPERATOR FOR SYMMETRY OPERATIONS
     162 !              NSYM = NUMBER OF SYMMETRY OPERATIONS
     163 !
     164 !****************************************************************
     165 !
     166 !  A SUBROUTINE THAT WILL EXPAND THE SYMMETRY OPERATIONS READ IN INTO
     167 !     THE COMPLETE SET.  NOTE: VERY FEW OPERATIONS ARE REQUIRED TO
     168 !     GENERATE EVEN VERY LARGE GROUPS OF OPERATIONS.
     169 !
     170 !
     171 !
     172 !
     173 !  Variables used:  (n represents the number of atomic centers)
     174 !
     175 !    For the next two items, the last index represents the symmetry
     176 !        operation number.
     177 !     R(9,*):   The 9 elements of each record are a packed 3 by 3
     178 !          array of a given symmetry operation.
     179 !    IPO(n,*):  A vector that contains the symmetry mapping of atomic c
 e
     180 !
     181 !  NSYM IS ALWAYS THE UPPER BOUND OF THE VALID FUNCTIONS.  QUIT IF IT
     182 !     REACHES 120.
     183 !  I IS THE SLOW INDEX OF FUNCTIONS TO MULTIPLY
     184 !  J IS THE FAST INDEX OF FUNCTIONS TO MULTIPLY
     185 !  ALWAYS DO R(I)*R(J) AND TAKE I,J FROM 2 TO NSYM
 
 FORCHECK PC V13.5.13           SYMP           2021-03-24 10:59:30   page:  1167
 symr.F90  /FF
 
     186 !
     187       i = 2
     188       j = 1
     189 !
     190 !  DETERMINE IF IT IS TIME TO STOP
     191 !
     192    10 continue
     193       j = j + 1
     194       if (j > nsym) then
     195         j = 2
     196         i = i + 1
     197         if (i > nsym) go to 50
     198       end if
     199       if (nsym == maxfun) go to 50
     200 !
     201 !  NOW TO START THE MULTIPLICATION
     202 !
     203       r(1,nsym+1) = r(1,i)*r(1,j) + r(2,i)*r(4,j) + r(3,i)*r(7,j)
     204       r(2,nsym+1) = r(1,i)*r(2,j) + r(2,i)*r(5,j) + r(3,i)*r(8,j)
     205       r(3,nsym+1) = r(1,i)*r(3,j) + r(2,i)*r(6,j) + r(3,i)*r(9,j)
     206       r(4,nsym+1) = r(4,i)*r(1,j) + r(5,i)*r(4,j) + r(6,i)*r(7,j)
     207       r(5,nsym+1) = r(4,i)*r(2,j) + r(5,i)*r(5,j) + r(6,i)*r(8,j)
     208       r(6,nsym+1) = r(4,i)*r(3,j) + r(5,i)*r(6,j) + r(6,i)*r(9,j)
     209       r(7,nsym+1) = r(7,i)*r(1,j) + r(8,i)*r(4,j) + r(9,i)*r(7,j)
     210       r(8,nsym+1) = r(7,i)*r(2,j) + r(8,i)*r(5,j) + r(9,i)*r(8,j)
     211       r(9,nsym+1) = r(7,i)*r(3,j) + r(8,i)*r(6,j) + r(9,i)*r(9,j)
     212 !
     213 !  IS IT UNIQUE?
     214 !
     215       do n = 1, nsym
     216         res = 0.D0
     217         do m = 1, 9
     218           res = res + abs(r(m,n)-r(m,nsym+1))
     219         end do
     220         if (res < tol) go to 10
     221       end do
     222 !
     223 !  YES, IT IS UNIQUE.  NOW, GENERATE THE NEW IPO(,NSYM)
     224 !
     225       nsym = nsym + 1
     226       do n = 1, numat
     227         ipo(n,nsym) = ipo(ipo(n,j),i)
     228       end do
     229 !
     230 !     ALL DONE ADDING THE NEW FUNCTION.  GO TRY TO FIND A NEW ONE.
     231 !
     232       go to 10
     233 !
     234 !
     235    50 continue
     236       write (iw, 60) name, nsym
     237    60 format(/,'    FOR POINT-GROUP ',a4,' THERE ARE ',i3,&
     238         ' UNIQUE SYMMETRY FUNCTIONS.',/)
     239 !#       WRITE(IW,*)' Symmetry Operations'
     240 !#       DO 14 I=1,NSYM
     241 !#       WRITE(IW,*)
     242 !#       WRITE(IW,'(3f12.6)')(R(J,I),J=1,9)
     243 !#  14   continue
     244 !
 
 FORCHECK PC V13.5.13           SYMP           2021-03-24 10:59:30   page:  1168
 symr.F90  /FF
 
     245       return
     246       end subroutine symp
 
