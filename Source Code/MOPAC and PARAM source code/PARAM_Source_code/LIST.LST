      28 !  Local variables
      29 !
      30   integer :: d_i, a_i, k, o1, o2, cc, icalcn = -1
      31   double precision :: rda, rih, rjh, angle, rdh, rah, e_radial, a, x, e
 _angular, &
      32     e_para, e_bond_switch, e_scale_w, e_scale_chd, e_scale_cha, rdhs, r
 avgs, &
      33     hydrogens, others, slope, v, fv, fv2, f_o1, f_o2, f_cc, cdist, &
      34     cv_o1, odist, cv_cc, cv_o2, e_corr_sum, e_corr, sum
      35   double precision :: M_PI = 3.141592653589793d0, &
      36     para_oh_o = 2.32d0, para_oh_n = 3.10d0, para_nh_o = 1.07d0, para_nh
 _n = 2.01d0, &
      37     multiplier_wh_o = 0.42d0, multiplier_nh4 = 3.61d0, multiplier_coo =
  1.41d0
      38   double precision, external :: distance, cvalence_contribution
      39   save :: icalcn
      40     cv_cc = 0.d0
      41     if (icalcn /= numcal) then
      42 !
      43 !   Variables that change depending on the method
      44 !
      45       if (method_PM6_D3H4 .or. method_pm6_d3h4x) then
      46         icalcn = numcal
      47         para_oh_o = 2.32d0
      48         para_oh_n = 3.10d0
      49         para_nh_o = 1.07d0
      50         para_nh_n = 2.01d0
      51         multiplier_wh_o = 0.42d0
      52         multiplier_nh4 = 3.61d0
      53         multiplier_coo = 1.41d0
      54       else if (method_PM7 .or. method_PM8) then
      55         para_oh_o = 2.32d0
      56         para_oh_n = 3.10d0
      57         para_nh_o = 1.07d0
      58         para_nh_n = 2.01d0
      59         multiplier_wh_o = 0.42d0
      60         multiplier_nh4 = 3.61d0
      61         multiplier_coo = 1.41d0
      62       else
      63         para_oh_o = 2.32d0
      64         para_oh_n = 3.10d0
      65         para_nh_o = 1.07d0
      66         para_nh_n = 2.01d0
      67         multiplier_wh_o = 0.42d0
 
 FORCHECK PC V13.5.13         H_BONDS4         2021-03-24 10:59:30   page:   660
