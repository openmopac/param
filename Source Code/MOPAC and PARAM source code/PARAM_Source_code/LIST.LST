       1 subroutine rapid2 (xparam, functn, grad, lgrad)
       2 !
       3 !
       4     use param_global_C, only : valvar, botlim, toplim, numvar, &
       5     power, nfns, diffns, fns, parab, factor, penalty
       6 !
       7 !
       8     implicit none
       9     double precision, dimension (numvar), intent (in) :: xparam
      10     double precision, intent (out) :: functn
      11     logical, intent (in) :: lgrad
      12     double precision, dimension (numvar) :: grad
      13 !----------------------------------------------------------------
      14
      15     integer :: i, j
      16     double precision :: curpar, error, sum
      17     intrinsic Max, Min
      18 !----------------------------------------------------------------
      19 !
      20 !  Power is the power "n" in error = sum_i x_i**n
      21 !  Default is 2, do NOT go less than about 1.05
      22 !
      23     if (lgrad) then
      24       do i = 1, numvar
      25         grad(i) = 0.d0
      26       end do
      27     end if
      28   !
      29   !    CALCULATE THE ERROR
      30   !
      31     functn = 0.d0
      32     do i = 1, nfns
      33       sum = 0.d0
      34       do j = 1, numvar
      35         sum = sum + xparam(j) * diffns(j, i)
      36       end do
      37       error = (fns(i)-sum)*factor(i)
      38       if (lgrad) then
      39       !
      40       !   CALCULATE DERIVATIVES OF SSQ W.R.T. PARAMETERS
      41       !
      42         do j = 1, numvar
      43           grad(j) = grad(j) - &
      44           & factor(i)*Sign(1.d0,error)*Abs(error)**(power - 1.d0) * dif
 fns(j, i) * power
      45         end do
      46       end if
      47     !
      48     !   CALCULATE FUNCTION = SSQ
      49     !
      50        functn = functn + abs(error)**power
      51     end do
      52   !
      53   !  Add a damping function - to avoid the effects of a very low
      54   !  eigenvalue in the parameter Hessian.
      55   !
      56     sum = 0.d0
      57     do i = 1, numvar
 
 FORCHECK PC V13.5.13          RAPID2          2021-03-24 10:59:30   page:  2872
 rapid2.F90  /FF
 
      58       functn = functn + xparam(i) ** 2 * parab
      59       if (lgrad) then
      60         grad(i) = grad(i) + 2 * xparam(i) * parab
      61  !       if (j == 1) then
      62  !       write(ifiles_8,'(5f12.6)')grad(j),factor(i),error,diffns(j,i)
      63  !       end if
      64       end if
      65     end do
      66   !
      67   ! Add a limiting function - to set "soft" upper and lower limits
      68   ! to the value of the functions
      69   !
      70     do i = 1, numvar
      71       curpar = valvar(i) - xparam(i)
      72       sum = (Max(0.d0, curpar-toplim(i))+Min(0.d0, curpar-botlim(i)))
      73       functn = functn + penalty * sum ** 2
      74       if (lgrad) then
      75         grad(i) = grad(i) - 2.d0 * penalty * sum
      76 !        if (i == 1) then
      77 !        write(ifiles_8,'(5f12.6)')grad(i)
      78 !        end if
      79       end if
      80     end do
      81 end subroutine rapid2
 
