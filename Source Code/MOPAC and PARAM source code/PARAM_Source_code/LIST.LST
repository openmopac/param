     488           write (iw, '(17X,I4,9X,A2,1X,F10.4)') i, elemnt(nat(i)), q(i)
     489         end do
     490         call to_screen("To_file: Esp")
     491       else
     492 !
     493 !     MNDO CALCULATION-SCALE THE CHARGES. TEST FOR SLOPE KEYWORD
     494 !
     495         if (index(keywrd,'SLOPE=') /= 0) then
     496           slope = reada(keywrd,index(keywrd,'SLOPE='))
     497         else
     498           slope = 1.422D0
     499         end if
     500         qsc(:numat) = slope*q(:numat)
     501         write (iw, '(7X,''ATOM NO.    TYPE    CHARGE   SCALED CHARGE'')
 ')
     502         do i = 1, numat
     503           write (iw, '(9X,I4,9X,A2,1X,F10.4,2X,F10.4)') i, elemnt(nat(i
 )), q(i), qsc(i)
     504         end do
     505       end if
     506       write (iw, '(/12X,A,4X,I6)') 'THE NUMBER OF POINTS IS:', nesp
 
 FORCHECK PC V13.5.13          POTCAL          2021-03-24 10:59:30   page:  3217
 esp.F90  /FF
 
     507       write (iw, '(12X,A,4X,F9.4)') 'THE RMS DEVIATION IS:', rms
     508       write (iw, '(12X,A,3X,F9.4)') 'THE RRMS DEVIATION IS:', rrms
     509 !
     510 !     CALCULATE DIPOLE MOMENT IF NEUTRAL MOLECULE
     511 !
     512       if (iz /= 0) then
     513         go to 60
     514       else
     515         write (iw, 40)
     516    40   format(/,/,5x,'DIPOLE MOMENT EVALUATED FROM THE POINT CHARGES',
 /)
     517         dipx = 0.d0
     518         dipy = 0.d0
     519         dipz = 0.d0
     520         dipx = dipx + sum(co(1,:numat)*q(:numat)/a0)
     521         dipy = dipy + sum(co(2,:numat)*q(:numat)/a0)
     522         dipz = dipz + sum(co(3,:numat)*q(:numat)/a0)
     523         dip = sqrt(dipx**2 + dipy**2 + dipz**2)
     524         write (iw, '(12X,'' X        Y        Z       TOTAL'')')
     525         write (iw, '(8X,4F9.4)') dipx*cf, dipy*cf, dipz*cf, dip*cf
     526       end if
     527    60 continue
     528       if (index(keywrd,'SYMAVG') /= 0) then
     529         allocate (cequiv(numat,numat))
     530         do i = 1, numat
     531           do j = 1, numat
     532             cequiv(i,j) = .FALSE.
     533             if (abs(abs(q(i))-abs(q(j))) >= 1.D-5) cycle
     534             cequiv(i,j) = .TRUE.
     535           end do
     536         end do
     537         do i = 1, numat
     538           ieq = 0
     539           qsc(i) = 0.D0
     540           do j = 1, numat
     541             if (.not.cequiv(i,j)) cycle
     542             qsc(i) = qsc(i) + abs(q(j))
     543             ieq = ieq + 1
     544           end do
     545           q(i) = q(i)/abs(q(i))*qsc(i)/ieq
     546         end do
     547         write (iw, *) ' '
