    1232   subroutine split_index (k, coord, nc, g, ind_pos, n, n1, n2)
    1233     !
    1234     !.. Implicit Declarations ..
    1235     implicit none
    1236     !
    1237     !.. Formal Arguments ..
    1238     integer, intent(in) :: k, n, nc, ind_pos
    1239     double precision, intent(in), dimension(nc, *) :: coord
    1240     double precision, intent(in) :: g
    1241     integer, intent (out) :: n1, n2
    1242
    1243     !
    1244     !.. Local Scalars ..
    1245     integer :: i
    1246     !
    1247     ! ... Executable Statements ...
    1248
    1249     n1 = 0
    1250     n2 = n + 1
    1251
    1252     do i = 1, n
    1253       if (coord(k, ind(ind_pos+i)) < g) then
    1254         n1 = n1 + 1
    1255         ind1(n1) = ind(ind_pos+i)
    1256       else
    1257         n2 = n2 - 1
    1258         ind1(n2) = ind(ind_pos+i)
    1259       end if
    1260     end do
    1261
    1262     n2 = n - n1
    1263
    1264     do i = 1, n
    1265       ind(ind_pos+i) = ind1(i)
    1266     end do
    1267
    1268   end subroutine split_index
 
