 )
      70             read (ires, end=120, err=120) iloop, x0, x1, x2
      71             close (ires)
      72         end if
      73
      74     else
      75         write (iw, '(''  ABOUT TO ENTER LBFGS FROM PATH'')')
      76         if (index(keywrd,'RESTAR') /= 0) then
      77           call mopend(" RESTART is not supported in a path calculation
