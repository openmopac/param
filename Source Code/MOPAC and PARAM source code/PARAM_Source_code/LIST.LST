    2509   subroutine mult_triangle_vec (t, x, n, y)
    2510     !
    2511     !.. Implicit Declarations ..
    2512     implicit none
    2513
    2514     !
    2515     !.. Formal Arguments ..
    2516     integer, intent (in) :: n
    2517     double precision, dimension(*), intent(in) :: t
    2518     double precision, dimension(n), intent(in) :: x
    2519     double precision, dimension(n), intent(out) :: y
    2520     !
    2521     !.. Local Scalars ..
    2522     integer :: i, j, ii, ij
    2523     double precision :: s
    2524     !
    2525     ! ... Executable Statements ...
    2526
    2527         ii = 0   ! previous diagonal element
    2528         do i=1, n
    2529           s = 0.d0
    2530           ij = ii
    2531           do j=1, i
    2532             ij = ij +1
    2533             s = s + t(ij) * x(j)
    2534           end do
    2535           ii = ij
    2536           do j=i+1, n
    2537             ij = ij + j -1
    2538             s = s + t(ij) * x(j)
    2539           end do
    2540           y(i) = s
    2541         end do
    2542
    2543   end subroutine mult_triangle_vec
 
