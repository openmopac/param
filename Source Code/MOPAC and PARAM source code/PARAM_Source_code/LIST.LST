    1787 subroutine overlp (dmax, ddmin, newmod, nvar, lorjk, u, vmode)
    1788     use molkst_C, only: numcal
    1789     use chanel_C, only: iw
    1790     use ef_C, only: ef_mode, iprnt, omin
    1791     implicit none
    1792     logical, intent (inout) :: lorjk
    1793     integer, intent (in) :: nvar
    1794     integer, intent (out) :: newmod
    1795     double precision, intent (in) :: ddmin, dmax
    1796     double precision, dimension (nvar), intent (inout) :: vmode
    1797     double precision, dimension (nvar, nvar), intent (in) :: u
    1798     integer :: i
    1799     integer, save :: icalcn = 0, it
    1800     double precision :: ovlp, tovlp
    1801     intrinsic Abs
    1802     double precision, external :: dot
    1803    !
    1804    ! ... Executable Statements ...
    1805    !
    1806    !  ON THE FIRST STEP SIMPLY DETERMINE WHICH MODE TO FOLLOW
    1807    !
    1808    !     IF(NSTEP.EQ.1) THEN
    1809     if (icalcn /= numcal) then
    1810       icalcn = numcal !
    1811       if (ef_mode > nvar) then
    1812         write (iw,*) "ERROR!! MODE IS LARGER THAN NVAR", ef_mode
    1813         call mopend ("ERROR!! MODE IS LARGER THAN NVAR")
    1814         return
    1815       else
    1816         it = ef_mode
    1817         if (iprnt >= 1) then
    1818 10000     format (5 x, "HESSIAN MODE FOLLOWING SWITCHED ON"/ &
    1819                & "     FOLLOWING MODE ", i3)
    1820           write (iw, 10000) ef_mode
    1821         end if
    1822       end if
    1823     else
    1824       !
    1825       !  ON SUBSEQUENT STEPS DETERMINE WHICH HESSIAN EIGENVECTOR HAS
    1826       !  THE GREATEST OVERLAP WITH THE MODE WE ARE FOLLOWING
    1827       !
    1828       it = 1
    1829       lorjk = .false.
    1830       tovlp = dot (u(1, 1), vmode, nvar)
    1831       tovlp = Abs (tovlp)
    1832       do i = 2, nvar
    1833         ovlp = dot (u(1, i), vmode, nvar)
    1834         ovlp = Abs (ovlp)
    1835         if (ovlp > tovlp) then
    1836           tovlp = ovlp
    1837           it = i
    1838         end if
    1839       end do
    1840       !
    1841       if (iprnt >= 1) then
    1842 10010   format (5 x, "OVERLAP OF CURRENT MODE", i3, &
    1843              & " WITH PREVIOUS MODE IS ", f6.3)
    1844         write (iw, 10010) it, tovlp
 
 FORCHECK PC V13.5.13          OVERLP          2021-03-24 10:59:30   page:  2133
 ef.F90  /FF
 
    1845       end if
    1846       if (tovlp < omin) then
    1847         if (dmax > ddmin) then
    1848           lorjk = .true.
    1849           if (iprnt >= 1) then
    1850 10020       format (5 x, "OVERLAP LESS THAN OMIN", f6.3, &
    1851                  & " REJECTING PREVIOUS STEP")
    1852             write (iw, 10020) omin
    1853           end if
    1854           return
    1855         else if (iprnt >= 1) then
    1856 10030     format (5 x, "OVERLAP LESS THAN OMIN", f6.3, " BUT TRUST RADI
 US", &
    1857                & f6.3, " IS LESS THAN DDMIN", f6.3,/, 5 x, " ACCEPTING
 STEP")
    1858           write (iw, 10030) omin, dmax, ddmin
    1859         end if
    1860       end if
    1861     end if
    1862    !
    1863    !  SAVE THE EIGENVECTOR IN VMODE
    1864    !
    1865     do i = 1, nvar
    1866       vmode(i) = u(i, it)
    1867     end do
    1868    !
    1869     newmod = it
    1870 !
