     445 !
     446       double precision function derp (r)
     447       use molkst_C, only: numcal, clower, cutofp, cupper
     448       implicit none
     449       double precision, intent (in) :: r
     450       integer, save :: icalcn = 0
     451       double precision, save :: bound1, bound2, c, cr, cr2, range
     452 !
     453       if (icalcn /= numcal) then
     454       !
     455       ! Set constants for truncation function.
     456       !
     457       ! CLOWER = lower bound of truncation function, as a function of C
 UTOFP
     458         bound1 = clower / cutofp
     459       !
     460       ! CUPPER = upper bound of truncation function, as a function of C
 UTOFP
     461         bound2 = cupper / cutofp
     462         range = bound2 - bound1
     463       !
     464       ! Truncation function = C+CR*R+CR2*R**2
     465       !
     466         c = -0.5d0 * bound1 ** 2 * cutofp / range
     467         cr = 1.d0 + bound1 / range
     468         cr2 = -1 / (cutofp*2*range)
     469       !
     470       !   Above CUPPER function = constant
     471       !
     472         icalcn = numcal
     473       end if
     474    !
     475    !  Need a smooth function in the region of CUTOFP
     476    !
     477    !  Function has form:
     478    !    Up to CLOWER  R=R
     479    !    At CLOWER,  slope = 1.0
     480    !    Between CLOWER and CUPPER = Monotomic increase,
     481    !    with rate of increase dropping from 1.0 to 0.0
     482    !    At CUPPER, slope = 0
     483    !    Above CUTOFP   R=CUTOFP
     484       if (r > clower) then
     485         if (r > cupper) then
     486           derp = 0.d0
     487         else
     488           derp = -(cr+2*cr2*r) / (c+cr*r+cr2*r**2) ** 2
     489         end if
     490       else
     491         derp = -1 / r ** 2
     492       end if
     493   end function derp
 
