     359     subroutine limit(iat, jat, iadr, jadr)
     360       implicit none
     361       integer iat, jat, iadr, jadr
     362       iadr  =  1
     363       jadr  =  1
     364  10   if (iat.gt.100) then
     365          iat  =  iat - 100
     366          iadr  =  iadr  +  1
     367          goto 10
     368       end if
     369  20   if (jat.gt.100) then
     370          jat  =  jat - 100
     371          jadr  =  jadr  +  1
     372          goto 20
     373       end if
     374     end
 
