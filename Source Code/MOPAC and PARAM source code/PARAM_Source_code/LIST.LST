     110 subroutine ansude (ra, rb, d, rs, ara, arb, aar, abr, arad, arbd, rinc)
     111     use funcon_C, only : pi
     112    !   THIS PROGROM CALCULATES THE AREA OF TWO INTERSECTING SPHERES
     113    !   WITH RADII RA AND RB AT A DISTANCE D AND A SOLVENT PROBE
     114    !   RADIUS RS. THE TWO AREAS ARE CALCULATED SEPARATELY (ARA, ARB).
     115    !   THE PART OF THE AREA ON THE CLOSURE PART IS AAR AND ABR.
     116    !   FOR BOTH AREAS ANALYTIC DERIVATIVES WITH RESPECT TO THE DISTANCE
     117    !   D ARE CALCULATED (ARAD, ARBD).    (WRITTEN BY ANDREAS KLAMT, 9/9
 /96)
     118     implicit none
     119     double precision, intent (in) :: d, ra, rb, rs
     120     double precision, intent (out) :: aar, abr, ara, arad, arb, arbd, r
 inc
     121     double precision :: ca, cad, cb, cbd, fza, fzad, fzb, fzbd, qa, qb,
  &
     122    & sa, sad, sb, sbd, ta, tad, tb, tbd, xa, xad, xb, xbd, ya, yad, yb,
  ybd, &
     123    & za, zad, zb, zbd
     124     qa = ra + rs
     125     qb = rb + rs
     126     ca = (qa**2 + d**2 - qb**2) / (2.d0*qa*d)
     127     cb = (qb**2 + d**2 - qa**2) / (2.d0*qb*d)
     128     sa = Sqrt (1.d0 - ca*ca)
     129     sb = Sqrt (1.d0 - cb*cb)
     130     ta = pi * sa
     131     tb = pi * sb
     132     fza = (1.d0 - Cos (ta)) / 2
     133     fzb = (1.d0 - Cos (tb)) / 2
     134     if (sa < 0 .or. sb < 0) then
     135       fza = 1.d0
     136     end if
     137     if (sa < 0 .or. sb < 0) then
     138       fzb = 1.d0
     139     end if
     140     xa = fzb ** 1 * rs * (ca + cb)
     141     xb = fza ** 1 * rs * (ca + cb)
     142     ya = ra * sa - fzb * rb * sb
     143     yb = rb * sb - fza * ra * sa
     144     za = Sqrt (xa*xa + ya*ya)
     145     zb = Sqrt (xb*xb + yb*yb)
     146     rinc = 0.5d0*(za + zb)/sqrt(rs*rs*(ca + cb)**2 + (ra*sa - rb*sb)**2
 )
     147     ara = pi * ra * (2.d0*(1.d0 + ca)*ra + sa*za)
     148     arb = pi * rb * (2.d0*(1.d0 + cb)*rb + sb*zb)
     149     aar = pi * ra * (sa*za)
     150     abr = pi * rb * (sb*zb)
     151    ! NOW DERIVATIVES
     152     cad = (qb**2 + d**2 - qa**2) / (2.d0*qa*d*d)
     153     cbd = (qa**2 + d**2 - qb**2) / (2.d0*qb*d*d)
     154     sad = -ca * cad / sa
     155     sbd = -cb * cbd / sb
     156     tad = pi * sad
     157     tbd = pi * sbd
     158     fzad = Sin (ta) * .5d0
     159     fzbd = Sin (tb) * .5d0
     160     if (sa < 0 .or. sb < 0) then
     161       fzad = 0.d0
     162     end if
 
 FORCHECK PC V13.5.13          ANSUDE          2021-03-24 10:59:30   page:  1593
 cosmo.F90  /FF
 
     163     if (sa < 0 .or. sb < 0) then
     164       fzbd = 0.d0
     165     end if
     166     xad = rs * ((ca + cb)*fzbd*tbd + fzb*(cad + cbd))
     167     xbd = rs * ((ca + cb)*fzad*tad + fza*(cad + cbd))
     168     yad = ra * sad-fzbd * tbd * rb * sb - fzb * rb * sbd
     169     ybd = rb * sbd-fzad * tad * ra * sa - fza * ra * sad
     170     zad = (xa*xad + ya*yad) / za
     171     zbd = (xb*xbd + yb*ybd) / zb
     172     arad = pi * ra * (sad*za + sa*zad + 2.d0*ra*cad)
     173     arbd = pi * rb * (sbd*zb + sb*zbd + 2.d0*rb*cbd)
     174 end subroutine ansude
 
