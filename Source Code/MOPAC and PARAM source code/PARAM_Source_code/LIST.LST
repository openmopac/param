    1166 subroutine write_unit_cell_HOF(iprt)
    1167   use molkst_C, only : keywrd, escf, numat, line, mers, formula
    1168   use common_arrays_C, only : nat
    1169   implicit none
    1170   integer, intent(in) :: iprt
    1171   integer :: i, j, k, l, z, nel(107), m
    1172   character :: num*1
    1173   logical :: one_letter
    1174   double precision, external :: reada
    1175
    1176     if (iprt < 0) return
    1177 !
    1178 !  Work out the empirical formula
    1179 !
    1180         i = Index(keywrd, " Z=")
    1181         if (i /= 0) then
    1182           i = Nint(reada(keywrd,i))
    1183           z = max(1, mers(1))*max(1, mers(2))*max(1, mers(3))*i
