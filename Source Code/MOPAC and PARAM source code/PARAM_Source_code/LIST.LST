     114       !
     115       if (cutof1 < cutof2) then
     116         cutof1 = cutof2 + 1.d-4
     117         write (iw, "(/,A,F12.4,/)") " CUTOF1 WAS SET SMALLER THAN CUTOF
 2," // &
     118              & " RESET TO", Sqrt (cutof1)
     119       end if
     120       !#aab
     121       if ((Index (keywrd, " NODIRECT") /= 0) .or. (id /= 0) ) then
     122         direct = .false.
     123         semidr = .false.
     124       else if (Index (keywrd, " SEMIDIRECT") /= 0) then
     125         direct = .false.
     126         semidr = .true.
     127       else
     128         direct = .true.
     129         semidr = .true.
     130       end if
     131       !#aab - end
     132       !
     133       rmin = 100.d0
     134       !
     135       !     Identify atom pairs involved in calculation.  This is done
 based
     136       !     on interatomic distance.
     137       !
     138       i = 0
     139       do iloop = 1, numat
     140           io = iorbs(iloop)
     141           i = i + 1
     142           x1 = coord(1, i)
     143           x2 = coord(2, i)
     144           x3 = coord(3, i)
     145           ii = (io*(io+1)) / 2
     146           if (first) n2elec = n2elec + ii * ii ! for one-centre two-ele
 ctron integrals
     147           if (.not. lijbo .and. .not. count) then
