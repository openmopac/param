     406 !     *****************************************************************
 ********
     407
     408       subroutine uform (i, fg, f0, zcore)
     409
     410       use reimers_C, only : matind, natm, nbf, ibf, nbt, nbeta, &
     411           mis2, mip2, mid2, mic2, mic1, mg1sp, mf2pp, &
     412           mg2sd, mg1pd, mg3pd, mf2dd, mf4dd, beta
     413
     414       implicit none
     415       double precision ::  fg(24), f0(2, 2), &
     416                         sp, uu, zcore
     417       integer ::           i, k, &
     418                         i0, i1, ib, ic, id, icindx, icore, ip, is, nm
     419
     420 !     *** This constructs the U matrix from either (I + A)/2 or I
          ****
     421 !     *** using mixed electronic configurations for the uncharged atoms
  ****
     422
     423 !     *** mis2 = s ioniz pot from d(n - 2)s2 or from sp, mic2 = its pro
 bability ****
     424 !     *** mis1 = s ioniz pot from d(n - 1)s1,           mic1 = its prob
 ability ****
     425 !     *** sim for p and d ioniz pots, mid0 is d ioniz pot from d(n)s0
      ****
     426 !     *** sp is the sum of the d(n - 2)s2 and d(n - 1)s1 probabilities
      ****
     427
     428       icore = nint (zcore)
     429       i0 = ibf(i)
     430       k = natm(i)
     431       sp = fg(mic2) + fg(mic1)
     432       nbeta = 5
     433 !     **** loop over basis functions on this atom ****
     434
     435       do ib = 0, nbf(i) - 1
     436         i1 = i0 + ib
     437         nm = matind(i1) + i1
     438         beta(nm) = 0.d0
     439
     440 !       **** loop over the 3 configurations d(n - ic)s(ic) ****
     441
     442         do ic = 2, 0, - 1
     443           icindx = 2 - ic
     444           uu = 0.d0
     445           if (nbt(i1) == 0) then
     446 !           ***** s function, note there is no entry for d(n)s0 ****
     447             if (ic > 0) then
     448               uu = fg(mis2 + icindx)
     449               if (nbeta == 5) then
     450
     451 !               **** INDO/1S I only, all atoms ****
     452                 if (nbf(i) == 9) then
     453                   is = ic
     454                   ip = 0
     455                   id = icore - is
     456                 else
 
 FORCHECK PC V13.5.13          UFORM           2021-03-24 10:59:30   page:  1962
 integral.F90  /FF
 
     457 !                 **** sp configuration only ****
     458                   is = min (2, icore)
     459                   id = 0
     460                   ip = icore - is
     461                 end if
     462                 uu = uu - (is - 1) * f0(1, 1)&
     463      &                 - ip     * (f0(1, 1) - fg(mg1sp)/2.d0)&
     464      &                 - id     * (f0(1, 2) - fg(mg2sd)/2.d0)
     465               else if (nbeta < 4) then
     466
     467 !               **** (I + A)/2, 2nd row code only ****
     468                 uu = uu - (zcore - 0.5d0) * f0(1, 1)
     469
     470                 if (k == 4) then
     471                   uu = uu + fg(mg1sp)/4
     472                 else if (k > 4) then
     473                   uu = uu + fg(mg1sp)/2*(zcore - 1.5d0)
     474                 end if
     475
     476               end if
     477             else
     478 !             **** renormalization as no d(n)s(0) ****
     479               beta(nm) = beta(nm) / sp
     480             end if
     481
     482           else if (nbt(i1) <= 3) then
     483 !           ***** p function, note there is no entry for d(n)s0 ****
     484             if (ic > 0) then
     485               uu = fg(mip2 + icindx)
     486                if (nbeta == 5) then
     487 !               **** INDO/1S I only, all atoms ****
     488                 if (nbf(i) == 9) then
     489                   ip = 1
     490                   if (k /= 20) then
     491                     is = ic - ip
     492                     id = icore - ic
     493                   else
     494 !                   **** ZINDO has d->p for Ca and s - >p for all else
 ****
     495                     is = ic
     496                     id = icore - ic - 1
     497                   end if
     498                 else
     499 !                 **** sp configuration only ****
     500                   id = 0
     501                   ip = max (1, icore - 2)
     502                   is = icore - ip
     503                 end if
     504                 uu = uu - (ip - 1.d0) * (f0(1, 1) - fg(mf2pp)*2.0d0)&
     505      &                - is        * (f0(1, 1) - fg(mg1sp)*0.5d0)&
     506      &                - id        * (f0(1, 2) - fg(mg1pd)&
     507      &                                       - fg(mg3pd)*10.5d0)
     508
     509               else if (nbeta < 4) then
     510 !               **** (I + A)/2, 2nd row code only ****
     511                 uu = uu - (zcore - 0.5d0) * f0(1, 1)
     512                  if (k == 3) then
     513                   uu = uu + fg(mg1sp)/4
     514                 else if (k == 4) then
 
 FORCHECK PC V13.5.13          UFORM           2021-03-24 10:59:30   page:  1963
 integral.F90  /FF
 
     515                   uu = uu + fg(mg1sp)*0.75d0
     516                 else if (k > 4) then
     517                   uu = uu + fg(mg1sp)&
     518      &                  + fg(mf2pp)*2*(zcore - 2.5d0)
     519                 end if
     520
     521               end if
     522
     523             else
     524 !             **** renormalization as no d(n)s(0) ****
     525               beta(nm) = beta(nm) / sp
     526             end if
     527
     528           else
     529 !           **** d function, INDO/1S code only, all atoms ****
     530             ip = 0
     531             is = ic
     532             id = icore - is
     533             uu = fg(mid2 + icindx)
     534             uu = uu - (id-1.d0)  * (f0(2, 2) - fg(mf2dd)*14.d0/9.d0&
     535      &                                    - fg(mf4dd)*14.d0)&
     536      &            - is         * (f0(1, 2) - fg(mg2sd)*0.5d0)&
     537      &            - ip         * (f0(1, 2) - fg(mg1pd)&
     538      &                                    - fg(mg3pd)*10.5d0)
     539           end if
     540 !         **** multiply contribution to core integral by its weight ***
 *
     541           beta(nm) = beta(nm) + uu * fg(mic2 + icindx)
     542         end do
     543       end do
     544
     545       return
     546       end subroutine uform
 
