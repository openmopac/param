       1       subroutine densit(c, mdim, norbs, nocc, occ, nfract, fract, p, mo
 de)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       implicit none
       6 !-----------------------------------------------
       7 !   D u m m y   A r g u m e n t s
       8 !-----------------------------------------------
       9       integer , intent(in) :: mdim
      10       integer , intent(in) :: norbs
      11       integer , intent(in) :: nocc
      12       integer , intent(in) :: nfract
      13       integer , intent(in) :: mode
      14       double precision , intent(in) :: occ, fract
      15       double precision , intent(in) :: c(mdim,mdim)
      16       double precision , intent(inout) :: p((norbs*(norbs + 1))/2)
      17 !-----------------------------------------------
      18 !   L o c a l   V a r i a b l e s
      19 !-----------------------------------------------
      20       integer :: norbs2, nl2, nu2, nl1, nu1, l, i, j
      21       double precision :: sign, frac, const, sum2, sum1
      22 !-----------------------------------------------
      23 !**********************************************************************
 *
      24 !
      25 !   DENSIT COMPUTES THE DENSITY MATRIX GIVEN THE EIGENVECTOR MATRIX, AN
 D
      26 !          INFORMATION ABOUT THE M.O. OCCUPANCY.
      27 !
      28 !  INPUT:  C     = SQUARE EIGENVECTOR MATRIX, C IS OF SIZE MDIM BY MDIM
      29 !                  AND THE EIGENVECTORS ARE STORED IN THE TOP LEFT-HAND
      30 !                  CORNER.
      31 !          NORBS = NUMBER OF ORBITALS
      32 !          NOCC  = NUMBER OF FULLY-OCCUPIED M.O.S
      33 !          occ   = NUMBER OF FRACTIONALLY OCCUPIED M.O.S.
      34 !          MODE  = 2 IF POSITRON EQUIVALENT IS NOT TO BE USED
      35 !
      36 !   ON EXIT: P   = DENSITY MATRIX
      37 !
      38 !**********************************************************************
 *
      39 !
      40 ! SET UP LIMITS FOR SUMS
      41 !  NL1 = BEGINING OF ONE ELECTRON SUM
      42 !  NU1 = END OF SAME
      43 !  NL2 = BEGINING OF TWO ELECTRON SUM
      44 !  NU2 = END OF SAME
      45 !
      46       norbs2 = norbs/2
      47       if (nocc /= 0 .and. nfract > norbs2 .and. mode /= 2) then
      48 !
      49 !    TAKE POSITRON EQUIVALENT
      50 !
      51         sign = -1.d0
      52         frac = occ - fract
      53         const = occ
      54         nl2 = nfract + 1
 
 FORCHECK PC V13.5.13          DENSIT          2021-03-24 10:59:30   page:     4
 densit.F90  /FF
 
      55         nu2 = norbs
      56         nl1 = nocc + 1
      57         nu1 = nfract
      58       else
      59 !
      60 !    TAKE ELECTRON EQUIVALENT
      61 !
      62         sign = 1.d0
      63         frac = fract
      64         const = 0.d0
      65         nl2 = 1
      66         nu2 = nocc
      67         nl1 = nocc + 1
      68         nu1 = nfract
      69       end if
      70       l = 0
      71       do i = 1, norbs
      72         do j = 1, i
      73           l = l + 1
      74           sum1 = 0.D0
      75           sum2 = sum(c(i,nl2:nu2)*c(j,nl2:nu2))
      76           sum2 = sum2*occ
      77           sum1 = sum(c(i,nl1:nu1)*c(j,nl1:nu1))
      78           p(l) = (sum2 + sum1*frac)*sign
      79         end do
      80         p(l) = const + p(l)
      81       end do
      82       return
      83       end subroutine densit
 
