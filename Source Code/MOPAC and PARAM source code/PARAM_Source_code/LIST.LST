     827         do i = 1, nov
     828           occ(i) = 0.d0
     829           do k = 1, nconf
     830             occ(i) = occ(i) + nelc(i, k) * ci(j, k)**2
     831           end do
     832         end do
     833       end do
     834
     835 !     **** ground state properties ****
     836       dmtot = sqrt (dmci(1, 1)**2 + dmci(1, 2)**2 + dmci(1, 3)**2) * de
 bye
     837       dlo = evalci(1)/au2ev*au2cm
     838       write (iw, 1150) dlo, evalci(1) + tot, (debye*dmci(1, kk), kk = 1
 , 3), dmtot
     839
     840 !     **** read solvent shift parameters ****
     841
     842       solva = 0.d0
     843       solve = 0.d0
     844       foscf = 2.d0/3.d0/au2ang**2/au2cm
     845       foscm = 2.d0/3.d0*au2ang**2*au2cm
     846
     847 !     *************** output excitations from CI states ***************
 *
     848 ! RMG - add option to write transition dipoles between excited states
     849       if (index(keywrd, ' TDIP') /= 0) then
