       1 subroutine chrge_for_MOZYME (p, q)
       2 !
       3 ! Evaluate the atomic partial charge.
       4 !
       5     use molkst_C, only: mpack, numat
       6     use MOZYME_C, only : iorbs
       7     implicit none
       8     double precision, dimension (mpack), intent (in) :: p
       9     double precision, dimension (numat), intent (out) :: q
      10 !
      11     integer :: i, ii, j
      12     double precision :: sum
      13     integer, external :: ijbo
      14 !
      15     do i = 1, numat
      16       ii = ijbo (i, i)
      17       sum = 0.d0
      18       do j = 1, iorbs(i)
      19         ii = ii + j
      20         sum = sum + p(ii)
      21       end do
      22       q(i) = sum
      23     end do
      24 end subroutine chrge_for_MOZYME
 
