     339 !     *****************************************************************
 ********
     340
     341       subroutine polizn (tmx, tmy, tmz, dele)
     342       use reimers_C, only : pol
     343
     344       implicit none
     345       double precision ::  tmx, tmy, tmz, dele
     346
     347       if (abs(dele) < 1.d1) then
     348         return
     349       end if
     350       pol(1) = pol(1) + tmx**2 / dele
     351       pol(2) = pol(2) + tmx*tmy/ dele
     352       pol(3) = pol(3) + tmy**2 / dele
     353       pol(4) = pol(4) + tmx*tmz/ dele
     354       pol(5) = pol(5) + tmy*tmz/ dele
     355       pol(6) = pol(6) + tmz**2 / dele
     356
     357       return
     358       end subroutine polizn
 
