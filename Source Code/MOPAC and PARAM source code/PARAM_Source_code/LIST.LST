 4, 0, 0, &!   86
      77         &  1, 2, 3, 4, 2, 2,     4, 5, 6, 7, 2, 3, 2, 0, 0,   0, 0, 0,
 0, 0, 0 /
      78 !
      79 !                                Atom higher hypervalent oxidation stat
 e
      80 !
      81     data ox_ref_spd2 &
      82         &/ 1,
       0, &!    2
      83         &  1, 2,                                              3, 4,-3,
 2,-1, 0, &!   10
      84         &  1, 2,                                              3, 4,-5,
 6, 7, 0, &!   18
      85         &  1, 2, 2,              4, 3, 2, 3, 2, 3, 2, 1, 2,   3, 4,-5,
 6, 5, 0, &!   36
      86         &  1, 2, 2,              4, 3, 2, 3, 2, 3, 2, 1, 2,   3, 4,-5,
 6, 7, 0, &!   54
      87         &  1, 2, 2, 5*0,3*2,6*2, 4, 3, 2, 3, 2, 3, 2, 1, 2,   3, 4,-3,
 2, 0, 0, &!   86
      88         &  1, 2, 2, 4, 2, 2,     4, 3, 2, 3, 2, 3, 2, 0, 0,   0, 0, 0,
 0, 0, 0 /
      89 !
      90 !  If instructed to, change oxidation states
      91 !
      92     i = index(keywrd," METAL")
      93     if (i /= 0) then
      94       j = index(keywrd(i:), ") ") + i
      95       if (i /= j) then
      96         line = keywrd(i + 7:j)
      97         do k = 1, 83
      98           if (is_metal(k)) then
      99             if (cap_elemnt(k)(2:2) == " ") then
     100               jj = 1
     101             else
     102               jj = 2
     103             end if
     104             m = index(line,cap_elemnt(k)(:jj))
     105             if (m /= 0) then
     106               jj = jj + m
     107               if (line(jj:jj) == "(") then
     108               m = nint(reada(line, m))
     109               if (mod(m - ox_ref(k), 2) == 1) then
     110                 write(iw,'(10x, a, i3)')"Formal oxidation state of "//e
 lemnt(k)//" is:   ", ox_ref(k)
     111                 write(iw,'(10x,a, i3)')"Requested oxidation state of "/
 /elemnt(k)//" is:", m
     112                 if (mod(ox_ref(k), 2) == 1) then
     113                 write(iw,'(10x,a, i3)')"Alternate oxidation states must
  be odd, e.g, -3, -1, +1, +3, +5, etc."
     114                 else
     115                   write(iw,'(10x,a, i3)')"Alternate oxidation states mu
 st be even, e.g, -4, -2, +0, +2, +4, etc."
     116                 end if
     117                 call mopend("OXIDATION STATE REQUESTED IS NOT ALLOWED")
     118                 return
     119               end if
     120               ox_ref(k) = m
     121               ox_ref_spd1(k) = ox_ref(k)
 
 FORCHECK PC V13.5.13          CHKION          2021-03-24 10:59:30   page:  4079
 chkion.F90  /FF
 
     122               end if
     123             end if
     124           end if
     125         end do
     126       end if
     127     end if
     128 !
     129 !  ALL ORBITALS SHOULD HAVE BEEN USED BY THIS TIME.  SOME ORBITALS
     130 !  HAVE NOT BEEN USED: CHECK TO SEE IF THEY SHOULD BE FILLED OR
     131 !  BE EMPTY.
     132 !
     133 !  First, work out the sign of the oxidation state of the atoms
     134 !
     135     do i = 1, numat
     136       k = ions(i)
     137       if (nbonds(i) == 0) then
     138         jj = sign(1, ox_ref(nat(i)))    ! Isolated atom or ion
     139       else
     140         jj = sign(1, ox_ref_sp(nat(i))) ! Lowest valence state
     141       end if
     142       do j = 1, Lewis_tot
     143         if (Lewis_elem(1,j) /= 0 .and. Lewis_elem(2,j) /= 0) then
     144           if (Lewis_elem(1,j) == i) k = k + jj
     145           if (Lewis_elem(2,j) == i) k = k + jj
     146         end if
     147       end do
     148       ox_calc(i) = k
     149       if (ib(i) == 0) then
     150         ions(i) = iz(i)
     151         iz(i) = 0
     152       end if
     153     end do
     154 !
     155 !   Write in MOZYME(Cr(IV))
     156 !
     157
     158     do outer_loop = 1, 2
     159 !
     160 !  The first cycle of outer_loop assignes all obvious charges,
     161 !  the second cycle assignes the more subtle charges
     162 !  such as those on C2H5
     163 !
     164       atom_loop: do i = 1, numat
     165         loop = 0
     166         do
     167           if (ib(i) <= 0) cycle atom_loop
     168           loop = loop + 1
     169           if (loop > 10) goto 1040
     170           if (nat(i) == 6) then
     171   !
     172   !  Carbon is particularly difficult: decide its charge based on its e
 nvironment
     173   !
     174             if (outer_loop == 1) then
     175               if (iz(i) > 1) then
     176                 call add_Lewis_element(i,0,0, n_lone_pairs)  !  Lone pa
 ir
     177                 if (iz(i) == 0 .and. ib(i) == 1) then
     178                   call add_Lewis_element(0,i,0, dummy)  ! Virtual lone
 
 FORCHECK PC V13.5.13          CHKION          2021-03-24 10:59:30   page:  4080
 chkion.F90  /FF
 
 pair
     179                 end if
     180               else
     181                 do m = 1, nbonds(i)
     182                   if (ions(ibonds(m,i)) > 0) then ! Adjacent atom is a
 cation
     183                     call add_Lewis_element(i,0,-1, n_lone_pairs)    ! L
 one pair
     184                     cycle atom_loop
     185                   else if (ions(ibonds(m,i)) < 0) then ! Adjacent atom
 is an anion
     186                     call add_Lewis_element(0,i,1, dummy)    ! Cation
     187                     cycle atom_loop
     188                   end if
     189                 end do
     190   !
     191   !     If there is a nearby atom of Group V, make the atom a cation
     192   !
     193                 do m = 1, nbonds(i)
     194                   mm = ibonds(m, i)
     195                      !
     196                      !   IS ANY ATOM ATTACHED TO THE ATOM OF GROUP 5?
     197                      !
     198                   if (Nint(tore(nat(mm))) == 5) go to 1010
     199                   if (Nint(tore(nat(mm))) == 6) go to 1012
     200                   do j = 1, nbonds(mm)
     201                     jj = ibonds(j, mm)
     202                         !
     203                         !   IS ANY ATOM ATTACHED TO ANY ATOM ATTACHED
     204                         !   TO THE ATOM OF GROUP 5?
     205                         !
     206                     if (Nint(tore(nat(jj))) == 5) go to 1010
     207                   end do
     208                 end do
