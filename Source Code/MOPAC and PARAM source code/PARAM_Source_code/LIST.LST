 o At Rn
      42 !           Fr Ra Ac Th Pa U    Np Pu Am Cm Bk Cf            Cb ++ +  -
 - -  Tv
      43 !                                      "s" shell
      44 !                              Isolated atom (Most of these will never
 exist, e.g. C)
      45     data ox_ref &
      46         &/ 1,
       0, &!    2
      47         &  1, 2,                                              3, 4, 3,-
 2,-1, 0, &!   10
      48         &  1, 2,                                              3, 4, 3,-
 2,-1, 0, &!   18
      49         &  1, 2, 3,              4, 3, 2, 3, 2, 3, 2, 1, 2,   3, 4, 3,-
 2,-1, 0, &!   36
      50         &  1, 2, 3,              4, 3, 2, 3, 2, 3, 2, 1, 2,   3, 4, 3,-
 2,-1, 0, &!   54
      51         &  1, 2, 3, 14*3,        4, 3, 2, 3, 2, 3, 2, 1, 2,   3, 2, 3,-
 2,-1, 0, &!   86
      52         &  1, 2, 3, 4, 2, 2,     4, 3, 2, 3, 2, 3, 2, 0, 0,   0, 0, 0,
 0, 0, 0 /
      53 !
      54 !                                Atom normal oxidation state.
      55 !  Be very careful in changing these!  They are designed to suit the la
 rgest number
      56 !  of common oxidation states.  Also, they affect the sign of the hyper
 valents.
      57 !  Note in particular, the signs of Groups V, VI, and VII.
      58 !
      59     data ox_ref_sp &
      60         &/ 1,
       0, &!    2
      61         &  1, 2,                                              3, 4, 3,-
 2,-1, 0, &!   10
      62         &  1, 2,                                              3, 4, 3,-
 2,-1, 0, &!   18
      63         &  1, 2, 3,              4, 3, 2, 3, 2, 3, 2, 1, 2,   3, 4, 3,-
 2, 1, 0, &!   36
      64         &  1, 2, 3,              4, 3, 2, 3, 2, 3, 2, 1, 2,   3, 4, 3,-
 2, 1, 0, &!   54
      65         &  1, 2, 3, 5*0,3*2,6*2, 4, 3, 2, 3, 2, 3, 2, 1, 2,   3, 2, 3,-
 2, 0, 0, &!   86
      66         &  1, 2, 3, 4, 2, 2,     4, 3, 2, 3, 2, 3, 2, 0, 0,   0, 0, 0,
 0, 0, 0 /
      67 !
      68 !                                Atom lower hypervalent oxidation state
      69 !
      70     data ox_ref_spd1 &
      71         &/ 1,
       0, &!    2
      72         &  1, 2,                                              3, 4, 3,-
 2,-1, 0, &!   10
      73         &  1, 2,                                              3, 4, 5,
 6, 3, 0, &!   18
      74         &  1, 2, 3,              4, 5, 6, 7, 2, 3, 2, 1, 2,   3, 4, 5,
 6, 3, 0, &!   36
      75         &  1, 2, 3,              4, 5, 6, 7, 2, 3, 2, 1, 2,   3, 4, 5,
 6, 3, 0, &!   54
      76         &  1, 2, 3, 5*0,3*2,6*2, 4, 5, 6, 7, 2, 3, 2, 1, 2,   3, 2, 3,
 
