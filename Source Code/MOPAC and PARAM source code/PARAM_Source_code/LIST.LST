     437   subroutine sqrdc(x, ldx, n, p, qraux, jpvt, work, job)
     438 !-----------------------------------------------
     439 !   I n t e r f a c e   B l o c k s
     440 !-----------------------------------------------
     441       implicit none
     442 !-----------------------------------------------
     443 !   D u m m y   A r g u m e n t s
     444 !-----------------------------------------------
     445       integer , intent(in) :: ldx
     446       integer  :: n
     447       integer , intent(in) :: p
     448       integer , intent(in) :: job
     449       integer , intent(inout) :: jpvt(ldx)
     450       real  :: x(ldx,ldx)
     451       real , intent(out) :: qraux(ldx)
     452       real , intent(inout) :: work(ldx)
     453 !-----------------------------------------------
     454 !   L o c a l   V a r i a b l e s
     455 !-----------------------------------------------
     456       integer :: j, jp, l, lp1, lup, maxj, pl, pu, jj
     457       real :: maxnrm, tt, nrmxl, t
     458       logical :: negj, swapj
     459       real , external :: sdot, snrm2
     460 !-----------------------------------------------
     461 !
     462 !     SQRDC USES HOUSEHOLDER TRANSFORMATIONS TO COMPUTE THE QR
     463 !     FACTORIZATION OF AN N BY P MATRIX X.  COLUMN PIVOTING
     464 !     BASED ON THE 2-NORMS OF THE REDUCED COLUMNS MAY BE
     465 !     PERFORMED AT THE USERS OPTION.
     466 !
     467 !     ON ENTRY
     468 !
     469 !        X       REAL(LDX,P), WHERE LDX .GE. N.
     470 !                X CONTAINS THE MATRIX WHOSE DECOMPOSITION IS TO BE
     471 !                COMPUTED.
     472 !
     473 !        LDX     INTEGER.
     474 !                LDX IS THE LEADING DIMENSION OF THE ARRAY X.
     475 !
     476 !        N       INTEGER.
     477 !                N IS THE NUMBER OF ROWS OF THE MATRIX X.
     478 !
     479 !        P       INTEGER.
     480 !                P IS THE NUMBER OF COLUMNS OF THE MATRIX X.
     481 !
     482 !        JPVT    INTEGER(P).
     483 !                JPVT CONTAINS INTEGERS THAT CONTROL THE SELECTION
     484 !                OF THE PIVOT COLUMNS.  THE K-TH COLUMN X(K) OF X
     485 !                IS PLACED IN ONE OF THREE CLASSES ACCORDING TO THE
     486 !                VALUE OF JPVT(K).
     487 !
     488 !                   IF JPVT(K) .GT. 0, THEN X(K) IS AN INITIAL
     489 !                                      COLUMN.
     490 !
     491 !                   IF JPVT(K) .EQ. 0, THEN X(K) IS A FREE COLUMN.
     492 !
     493 !                   IF JPVT(K) .LT. 0, THEN X(K) IS A FINAL COLUMN.
     494 !
 
 FORCHECK PC V13.5.13          SQRDC           2021-03-24 10:59:30   page:  1918
 esp_utilities.F90  /FF
 
     495 !                BEFORE THE DECOMPOSITION IS COMPUTED, INITIAL COLUMNS
     496 !                ARE MOVED TO THE BEGINNING OF THE ARRAY X AND FINAL
     497 !                COLUMNS TO THE END.  BOTH INITIAL AND FINAL COLUMNS
     498 !                ARE FROZEN IN PLACE DURING THE COMPUTATION AND ONLY
     499 !                FREE COLUMNS ARE MOVED.  AT THE K-TH STAGE OF THE
     500 !                REDUCTION, IF X(K) IS OCCUPIED BY A FREE COLUMN
     501 !                IT IS INTERCHANGED WITH THE FREE COLUMN OF LARGEST
     502 !                REDUCED NORM.  JPVT IS NOT REFERENCED IF
     503 !                JOB .EQ. 0.
     504 !
     505 !        WORK    REAL(P).
     506 !                WORK IS A WORK ARRAY.  WORK IS NOT REFERENCED IF
     507 !                JOB .EQ. 0.
     508 !
     509 !        JOB     INTEGER.
     510 !                JOB IS AN INTEGER THAT INITIATES COLUMN PIVOTING.
     511 !                IF JOB .EQ. 0, NO PIVOTING IS DONE.
     512 !                IF JOB .NE. 0, PIVOTING IS DONE.
     513 !
     514 !     ON RETURN
     515 !
     516 !        X       X CONTAINS IN ITS UPPER TRIANGLE THE UPPER
     517 !                TRIANGULAR MATRIX R OF THE QR FACTORIZATION.
     518 !                BELOW ITS DIAGONAL X CONTAINS INFORMATION FROM
     519 !                WHICH THE ORTHOGONAL PART OF THE DECOMPOSITION
     520 !                CAN BE RECOVERED.  NOTE THAT IF PIVOTING HAS
     521 !                BEEN REQUESTED, THE DECOMPOSITION IS NOT THAT
     522 !                OF THE ORIGINAL MATRIX X BUT THAT OF X
     523 !                WITH ITS COLUMNS PERMUTED AS DESCRIBED BY JPVT.
     524 !
     525 !        QRAUX   REAL(P).
     526 !                QRAUX CONTAINS FURTHER INFORMATION REQUIRED TO RECOVER
     527 !                THE ORTHOGONAL PART OF THE DECOMPOSITION.
     528 !
     529 !        JPVT    JPVT(K) CONTAINS THE INDEX OF THE COLUMN OF THE
     530 !                ORIGINAL MATRIX THAT HAS BEEN INTERCHANGED INTO
     531 !                THE K-TH COLUMN, IF PIVOTING WAS REQUESTED.
     532 !
     533 !     LINPACK. THIS VERSION DATED 08/14/78 .
     534 !     G.W. STEWART, UNIVERSITY OF MARYLAND, ARGONNE NATIONAL LAB.
     535 !
     536 !     SQRDC USES THE FOLLOWING FUNCTIONS AND SUBPROGRAMS.
     537 !
     538 !     BLAS SAXPY,SDOT,SSCAL,SSWAP,SNRM2
     539 !     FORTRAN ABS,AMAX1,MIN0,SQRT
     540 !
     541 !     INTERNAL VARIABLES
     542 !
     543 !
     544 !
     545       pl = 1
     546       pu = 0
     547       if (job /= 0) then
     548 !
     549 !        PIVOTING HAS BEEN REQUESTED.  REARRANGE THE COLUMNS
     550 !        ACCORDING TO JPVT.
     551 !
     552         do j = 1, p
     553           swapj = jpvt(j) > 0
 
 FORCHECK PC V13.5.13          SQRDC           2021-03-24 10:59:30   page:  1919
 esp_utilities.F90  /FF
 
     554           negj = jpvt(j) < 0
     555           jpvt(j) = j
     556           if (negj) jpvt(j) = -j
     557           if (.not.swapj) cycle
     558           if (j /= pl) call sswap (n, x(1,pl), 1, x(1,j), 1)
     559           jpvt(j) = jpvt(pl)
     560           jpvt(pl) = j
     561           pl = pl + 1
     562         end do
     563         pu = p
     564         do jj = 1, p
     565           j = p - jj + 1
     566           if (jpvt(j) >= 0) cycle
     567           jpvt(j) = -jpvt(j)
     568           if (j /= pu) then
     569             call sswap (n, x(1,pu), 1, x(1,j), 1)
     570             jp = jpvt(pu)
     571             jpvt(pu) = jpvt(j)
     572             jpvt(j) = jp
     573           end if
     574           pu = pu - 1
     575         end do
     576       end if
     577       if (pu >= pl) then
     578         do j = pl, pu
     579           qraux(j) = snrm2(n,x(1,j),1)
     580           work(j) = qraux(j)
     581         end do
     582       end if
     583       lup = min0(n,p)
     584       do l = 1, lup
     585         if (l>=pl .and. l<pu) then
     586 !
     587 !           LOCATE THE COLUMN OF LARGEST NORM AND BRING IT
     588 !           INTO THE PIVOT POSITION.
     589 !
     590           maxnrm = 0.0E0
     591           maxj = l
     592           do j = l, pu
     593             if (qraux(j) <= maxnrm) cycle
     594             maxnrm = qraux(j)
     595             maxj = j
     596           end do
     597           if (maxj /= l) then
     598             call sswap (n, x(1,l), 1, x(1,maxj), 1)
     599             qraux(maxj) = qraux(l)
     600             work(maxj) = work(l)
     601             jp = jpvt(maxj)
     602             jpvt(maxj) = jpvt(l)
     603             jpvt(l) = jp
     604           end if
     605         end if
     606         qraux(l) = 0.0E0
     607         if (l == n) cycle
     608 !
     609 !           COMPUTE THE HOUSEHOLDER TRANSFORMATION FOR COLUMN L.
     610 !
     611         nrmxl = snrm2(n - l + 1,x(l,l),1)
     612         if (nrmxl == 0.0E0) cycle
 
 FORCHECK PC V13.5.13          SQRDC           2021-03-24 10:59:30   page:  1920
 esp_utilities.F90  /FF
 
     613         if (x(l,l) /= 0.0E0) nrmxl = sign(nrmxl,x(l,l))
     614         call sscal (n - l + 1, 1.0E0/nrmxl, x(l,l), 1)
     615         x(l,l) = 1.0E0 + x(l,l)
     616 !
     617 !              APPLY THE TRANSFORMATION TO THE REMAINING COLUMNS,
     618 !              UPDATING THE NORMS.
     619 !
     620         lp1 = l + 1
     621         if (p >= lp1) then
     622           do j = lp1, p
     623             t = -sdot(n - l + 1,x(l,l),1,x(l,j),1)/x(l,l)
     624             call saxpy (n - l + 1, t, x(l,l), 1, x(l,j), 1)
     625             if (j<pl .or. j>pu) cycle
     626             if (qraux(j) == 0.0E0) cycle
     627             tt = 1.0E0 - (abs(x(l,j))/qraux(j))**2
     628             tt = amax1(tt,0.0E0)
     629             t = tt
     630             tt = 1.0E0 + 0.05E0*tt*(qraux(j)/work(j))**2
     631             if (Abs(tt - 1.0E0) > 1.e-10 ) then
     632               qraux(j) = qraux(j)*sqrt(t)
     633             else
     634               qraux(j) = snrm2(n - l,x(l+1,j),1)
     635               work(j) = qraux(j)
     636             end if
     637           end do
     638         end if
     639 !
     640 !              SAVE THE TRANSFORMATION.
     641 !
     642         qraux(l) = x(l,l)
     643         x(l,l) = -nrmxl
     644       end do
     645       return
     646       end subroutine sqrdc
 
