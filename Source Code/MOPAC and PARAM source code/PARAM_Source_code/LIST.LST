       1 double precision function parips (eigs, loop)
       2     use molkst_C, only : norbs, nopen, nclose, nalpha
       3     use param_global_C, only : lions
       4     implicit none
       5     integer, intent(in) :: loop
       6     double precision, dimension (norbs), intent (in) :: eigs
       7     if(nclose /= 0) then
       8 !
       9 !  Only allow for higher IPs for closed-shell systems
      10 !
      11       parips = -eigs(lions(loop))
      12       if (nopen /= nclose) then
      13            parips = Min (parips,-eigs(nopen))
      14       end if
      15     elseif (nalpha > 0) then
      16       parips = -eigs(nalpha)
      17     else
      18       parips = 0.d0
      19     end if
      20 end function parips
 
