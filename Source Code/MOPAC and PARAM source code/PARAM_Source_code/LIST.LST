     509 subroutine add_sp_H(i1, i, i2)
     510 !
     511 ! Given three atoms, i1, i, and i2, put a hydrogen atom at the point
     512 ! of a triangle
     513 !
     514   use molkst_C, only: natoms, maxatoms
     515   use common_arrays_C, only : geo, nat, txtatm
     516   use chanel_C, only: iw
     517   implicit none
     518   integer :: i1, i, i2
     519   logical :: first = .true.
     520   double precision :: scale
     521   natoms = natoms + 1
     522   if (natoms > maxatoms) then
     523     if (first) then
     524       write(iw,*)" Too many changes. Re-run using the data set generate
 d by this job"
     525       first = .false.
     526     end if
     527     natoms = natoms - 1
     528     return
     529   end if
     530   geo(:,natoms) = 2.d0*geo(:,i1) - 2.d0*geo(:,i) + geo(:,i2)
     531   scale = 1.1d0/sqrt( (geo(1,i1) - geo(1,natoms))**2 + &
     532                       (geo(2,i1) - geo(2,natoms))**2 + &
     533                       (geo(3,i1) - geo(3,natoms))**2 )
     534   geo(:,natoms) = geo(:,i1) + scale*(geo(:,natoms) - geo(:,i1))
     535   nat(natoms) = 1
     536   txtatm(natoms) = " "
     537 end subroutine add_sp_H
 
