    2728   logical function guanidine (icc, ionized, nH, angle, internal_dihedra
 l, dihedral, hybrid)
    2729 !
    2730 !   Test nitrogen atom "icc" to check that it's a "nu-1" or "nu-2" of a
  guanidine group in an Arg
    2731 !
    2732   use common_arrays_C,  only : nat,  nbonds,  ibonds, txtatm
    2733   use molkst_C,  only : numat
    2734   implicit none
    2735   integer :: nH, icc, hybrid(numat)
    2736   double precision :: angle, internal_dihedral, dihedral
    2737   logical :: ionized
    2738 !
    2739 !  Local
    2740 !
    2741   integer :: i, j, k, ii, jj, loop
    2742   guanidine = .false.
    2743   if (.not. (txtatm(icc)(13:16) == " NH1" .or. txtatm(icc)(13:16) == "
 NH2")) return
    2744   do loop = 1, nbonds(icc)
    2745     ii = ibonds(loop,icc)
    2746     do i = 1, nbonds(ii)
    2747       jj = ibonds(i,ii)
    2748       if (nat(jj) /= 6 .and. nat(jj) /= 7) exit
    2749       if (nat(jj) == 7 .and. jj /= icc) then  !  N-C-N structure
    2750         k = 0
    2751         do j = 1, nbonds(jj)
    2752           if (nat(ibonds(j,jj)) == 6) k = k + 1
    2753         end do
    2754         if (k == 2) cycle               !  Exclude C-N-C
    2755         if (nbonds(jj) == 3) then
    2756           hybrid(icc) = 2
    2757           guanidine = .true.
    2758           if (ionized) then
    2759             nH = 2                      !   ionized and an Arg
    2760             angle = 120.d0
    2761             internal_dihedral = 180.d0
    2762             dihedral = 0.d0
    2763           else
    2764             nH = 1
    2765             angle = 120.d0
    2766             internal_dihedral = 180.d0
    2767             dihedral = 0.d0
    2768           end if
    2769           return                         !  Unconditional
    2770         else
    2771           nH = 2
    2772           angle = 120.d0
    2773           internal_dihedral = 180.d0
    2774           dihedral = 0.d0
    2775           hybrid(icc) = 3
    2776           return
    2777         end if
    2778       end if
    2779     end do
    2780   end do
