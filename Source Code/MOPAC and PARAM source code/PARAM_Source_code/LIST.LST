      15   double precision function H_bonds4(H_i, i, j, d_list, nd_list)
      16 !
      17 ! Rezac J., Hobza P., "Advanced Corrections of Hydrogen Bonding and
      18 ! Dispersion for Semiempirical Quantum Mechanical Methods", J. Chem.
      19 ! Theory and Comp 8, 141-151 (2012).
      20 !
      21   use common_arrays_C, only: coord, nat
      22   use molkst_C, only : numat, N_Hbonds, numcal, method_PM6_D3H4, method
 _PM7, method_PM8, &
      23     method_pm6_d3h4x
