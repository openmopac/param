       1       double precision  function aababc (iocca1, ioccb1, iocca2, nmos,
 xy)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE meci_C, only : occa
       6 !**********************************************************************
 *
       7       implicit none
       8 !-----------------------------------------------
       9 !   D u m m y   A r g u m e n t s
      10 !-----------------------------------------------
      11       integer , intent(in) :: nmos
      12       integer , intent(in) :: iocca1(nmos)
      13       integer , intent(in) :: ioccb1(nmos)
      14       integer , intent(in) :: iocca2(nmos)
      15       double precision , intent(in) :: xy(nmos,nmos,nmos,nmos)
      16 !-----------------------------------------------
      17 !   L o c a l   V a r i a b l e s
      18 !-----------------------------------------------
      19       integer :: i, ij, j, k
      20       double precision :: sum
      21 !-----------------------------------------------
      22 !**********************************************************************
      23 !
      24 ! AABABC EVALUATES THE C.I. MATRIX ELEMENT FOR TWO MICROSTATES DIFFERIN
 G
      25 !       BY ONE ALPHA ELECTRON. THAT IS, ONE MICROSTATE HAS AN ALPHA
      26 !       ELECTRON IN PSI(I) WHICH, IN THE OTHER MICROSTATE, IS IN PSI(J)
      27 !
      28 !**********************************************************************
      29       do i = 1, nmos
      30         if (iocca1(i) == iocca2(i)) cycle
      31         exit
      32       end do
      33       ij = ioccb1(i)
      34       do j = i + 1, nmos
      35         if (iocca1(j) /= iocca2(j)) exit
      36         ij = ij + iocca1(j) + ioccb1(j)
      37       end do
      38       sum = 0.D0
      39       do k = 1, nmos
      40         sum = sum + (xy(i,j,k,k)-xy(i,k,j,k))*(iocca1(k)-occa(k)) + &
      41         xy(i,j,k,k)*(ioccb1(k)-occa(k))
      42       end do
      43       if (mod(ij,2) == 1) sum = -sum
      44       aababc = sum
      45       return
      46       end function aababc
 
