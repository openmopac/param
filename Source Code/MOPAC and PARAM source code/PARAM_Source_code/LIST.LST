     473 !
     474       subroutine drotat(ni, xi, xj, e1b, enuc, rij)
     475 !-----------------------------------------------
     476 !   M o d u l e s
     477 !-----------------------------------------------
     478       USE rotate_C, only : ccore, css1, csp1, cpps1, cppp1
     479       use parameters_C, only : natorb, tore
     480 !**********************************************************************
     481 !  SUBROUTINE DROTAT TRANSFORMS THE INTEGRALS FROM LOCAL COORDINATES
     482 !  INTO MOLECULAR COORDINATES FOR PMEP COMPUTATIONS.
     483 !                                  WRITTEN BY BINGZE WANG, NOV. 1991
     484 !**********************************************************************
     485 !-----------------------------------------------
     486 !   I n t e r f a c e   B l o c k s
     487 !-----------------------------------------------
     488       implicit none
     489 !-----------------------------------------------
     490 !   D u m m y   A r g u m e n t s
     491 !-----------------------------------------------
     492       integer  :: ni
     493       double precision , intent(out) :: enuc
     494       double precision  :: rij
     495       double precision , intent(in) :: xi(3)
     496       double precision , intent(in) :: xj(3)
     497       double precision , intent(out) :: e1b(10)
     498 !-----------------------------------------------
     499 !   L o c a l   V a r i a b l e s
     500 !-----------------------------------------------
     501       double precision, dimension(3) :: x, y, z
     502       double precision, dimension(22) :: ri
     503       double precision :: rijx, gam, a, xx11, xx21, xx22, xx31, xx32, x
 x33, yy11, &
     504         yy21, yy22, zz11, zz21, zz22, zz31, zz32, zz33, yyzz11, yyzz21,
  yyzz22
     505 !-----------------------------------------------
     506       xx11 = 0.d0
     507       xx21 = 0.d0
     508       xx22 = 0.d0
     509       xx31 = 0.d0
     510       xx32 = 0.d0
     511       xx33 = 0.d0
     512       yyzz11 = 0.d0
     513       yyzz21 = 0.d0
     514       yyzz22 = 0.d0
     515       zz31 = 0.d0
     516       zz32 = 0.d0
     517       zz33 = 0.d0
     518
     519       x(1) = xi(1) - xj(1)
     520       x(2) = xi(2) - xj(2)
     521       x(3) = xi(3) - xj(3)
     522       rijx = rij
     523 !                                   COMPUTE INTEGRALS IN DIATOMIC FRAME
     524       call drepp2 (ni, rij, ri, ccore)
     525 !
     526       gam = ri(1)
     527       a = 1.D0/rijx
     528       x(1) = x(1)*a
 
 FORCHECK PC V13.5.13          DROTAT          2021-03-24 10:59:30   page:  3035
 pmep.F90  /FF
 
     529       x(2) = x(2)*a
     530       x(3) = x(3)*a
     531       if (dabs(x(3)) > 0.99999D0) then
     532         x(3) = dsign(1.D0,x(3))
     533         y(1) = 0.D0
     534         y(2) = 1.D0
     535         y(3) = 0.D0
     536         z(1) = 1.D0
     537         z(2) = 0.D0
     538         z(3) = 0.D0
     539       else
     540         z(3) = dsqrt(1.D0 - x(3)*x(3))
     541         a = 1.D0/z(3)
     542         y(1) = -a*x(2)*dsign(1.D0,x(1))
     543         y(2) = dabs(a*x(1))
     544         y(3) = 0.D0
     545         z(1) = -a*x(1)*x(3)
     546         z(2) = -a*x(2)*x(3)
     547       end if
     548       if (natorb(ni) > 1) then
     549         xx11 = x(1)*x(1)
     550         xx21 = x(2)*x(1)
     551         xx22 = x(2)*x(2)
     552         xx31 = x(3)*x(1)
     553         xx32 = x(3)*x(2)
     554         xx33 = x(3)*x(3)
     555         yy11 = y(1)*y(1)
     556         yy21 = y(2)*y(1)
     557         yy22 = y(2)*y(2)
     558         zz11 = z(1)*z(1)
     559         zz21 = z(2)*z(1)
     560         zz22 = z(2)*z(2)
     561         zz31 = z(3)*z(1)
     562         zz32 = z(3)*z(2)
     563         zz33 = z(3)*z(3)
     564         yyzz11 = yy11 + zz11
     565         yyzz21 = yy21 + zz21
     566         yyzz22 = yy22 + zz22
     567       end if
     568 !                               ROTATE THE NUCLEAR ATTRACTION INTEGRALS
     569       e1b(1) = -css1
     570       if (natorb(ni) == 4) then
     571         e1b(2) = -csp1*x(1)
     572         e1b(3) = (-cpps1*xx11) - cppp1*yyzz11
     573         e1b(4) = -csp1*x(2)
     574         e1b(5) = (-cpps1*xx21) - cppp1*yyzz21
     575         e1b(6) = (-cpps1*xx22) - cppp1*yyzz22
     576         e1b(7) = -csp1*x(3)
     577         e1b(8) = (-cpps1*xx31) - cppp1*zz31
     578         e1b(9) = (-cpps1*xx32) - cppp1*zz32
     579         e1b(10) = (-cpps1*xx33) - cppp1*zz33
     580       end if
     581       enuc = tore(ni)*gam
     582       return
     583       end subroutine drotat
 
