       1       subroutine swap(c, n, mdim, nocc, ifill)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE chanel_C, only : iw
       6       use iter_C, only : psi => pbold, stdpsi => pbold2
       7       implicit none
       8 !-----------------------------------------------
       9 !   D u m m y   A r g u m e n t s
      10 !-----------------------------------------------
      11       integer , intent(in) :: n
      12       integer , intent(in) :: mdim
      13       integer , intent(in) :: nocc
      14       integer , intent(inout) :: ifill
      15       double precision , intent(inout) :: c(mdim,mdim)
      16 !-----------------------------------------------
      17 !   L o c a l   V a r i a b l e s
      18 !-----------------------------------------------
      19       integer ::  i, jfill
      20       double precision :: sum, summax, x
      21       double precision, external :: ddot
      22
      23 !-----------------------------------------------
      24 !******************************************************************
      25 !
      26 !        SWAP ENSURES THAT A NAMED MOLECULAR ORBITAL IFILL IS FILLED
      27 ! ON INPUT
      28 !          C = EIGENVECTORS IN A MDIM*MDIM MATRIX
      29 !          N = NUMBER OF ORBITALS
      30 !          NOCC = NUMBER OF OCCUPIED ORBITALS
      31 !          IFILL = FILLED ORBITAL
      32 !******************************************************************
      33       if (ifill <= 0) then
      34 !
      35 !     WE NOW DEFINE THE FILLED ORBITAL
      36 !
      37         if (allocated(psi)) deallocate(psi)
      38         if (allocated(stdpsi)) deallocate(stdpsi)
      39         allocate (psi(n), stdpsi(n))
      40         ifill = -ifill
      41         stdpsi(:n) = c(:n,ifill)
      42         psi(:n) = c(:n,ifill)
      43         return
      44       end if
      45       sum = 0.D0
      46       sum = ddot(n,psi(:n),1,c(:n,ifill),1)
      47 !
