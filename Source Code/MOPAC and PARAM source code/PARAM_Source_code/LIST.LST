     383    function cvalence_contribution(atom_a, atom_b, d_list, nd_list)
     384     use common_arrays_C, only: nat
     385     use radii_C, only : covalent_radii
     386     implicit none
     387     integer, intent (in) :: atom_a, atom_b
     388     integer, intent (inout) :: d_list(20), nd_list
     389     integer :: i
     390     double precision :: r, ri, rj, r0, r1, x, cvalence_contribution
     391     double precision, external :: distance
     392     ri = covalent_radii(nat(atom_a))
     393     rj = covalent_radii(nat(atom_b))
     394     r0 = ri + rj
     395     r1 = r0*1.6d0
     396     r = distance(atom_a, atom_b)
     397     if (r == 0.d0 .or. r >= r1) then
     398       cvalence_contribution = 0.d0
     399     else if (r <= r0) then
     400       cvalence_contribution = 1.d0
     401     else
     402       x = (r - r0)/(r1 - r0)
     403       cvalence_contribution = 1.d0 - (-20.d0*x**7 + 70.d0*x**6 -84.d0*x
 **5 + 35.d0*x**4)
     404       do i = 1, nd_list
     405         if (d_list(i) == atom_b) exit
     406       end do
     407       if (i > nd_list) then
     408         nd_list = nd_list + 1
     409         d_list(nd_list) = atom_b
     410       end if
     411     end if
     412     return
     413   end function cvalence_contribution
 
