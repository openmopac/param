    1562 logical function core_core_OK(geo, nat, numat, ni, nj, ccp)
    1563   use parameters_C, only : alpb
    1564   implicit none
    1565   integer :: numat, ni, nj
    1566   integer, dimension (numat) :: nat
    1567   integer, dimension (107,107) :: ccp
    1568   double precision, dimension (3,*) :: geo
    1569   logical :: first = .true.
    1570   logical, save, dimension (107,107) :: cc_OK
    1571   integer :: i, j
    1572   double precision, dimension (3,600) :: coord
    1573   if (first) then
    1574     first = .false.
    1575 !
    1576 !   Determine which core-core terms are valid
    1577 !
    1578     cc_OK = .true.
    1579     do i = 1, 100
    1580       do j = 1, i
    1581         if (isnan(alpb(i,j))) alpb(i,j) = 0.d0
    1582         cc_OK(i,j) = (alpb(i,j) > 1.d-4)
    1583         cc_OK(j,i) = cc_OK(i,j)
    1584       end do
    1585     end do
    1586     cc_OK(:,98:) = .true.
    1587     cc_OK(98:,:) = .true.
    1588     cc_OK(:,57:71) = .true.
    1589     cc_OK(57:71,:) = .true.
    1590   end if
    1591 !
    1592 !  Find all pairs of atoms that are near to each other (less than 5 Ang
 stroms)
    1593 !
    1594   call gmetry (geo, coord)
    1595   do i = 2, numat
    1596     ni = nat(i)
    1597     do j = 1, i - 1
    1598       if((coord(1,i)-coord(1,j))**2 + &
    1599     &    (coord(2,i)-coord(2,j))**2 + &
    1600     &    (coord(3,i)-coord(3,j))**2 < 25.5d0) then
    1601         ccp(ni,nat(j)) =  ccp(ni,nat(j)) + 1
    1602         if(.not. cc_OK(ni, nat(j))) then
    1603           core_core_OK = .false.
    1604           nj = nat(j)
    1605           return
    1606         end if
    1607       end if
    1608     end do
    1609   end do
    1610   do i = 1, numat
    1611     ccp(nat(i), nat(i)) = ccp(nat(i), nat(i)) + 1
    1612   end do
    1613   ccp(:,98:) = 1
    1614   ccp(98:,:) = 1
    1615   core_core_OK = .true.
    1616 end  function core_core_OK
 
