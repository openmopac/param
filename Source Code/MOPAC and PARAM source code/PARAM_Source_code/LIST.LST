       1 subroutine empire (formla, nat, els)
       2     use molkst_C, only : numat, keywrd, natoms
       3     use common_arrays_C, only : labels
       4     implicit none
       5     character (len=40), intent (out) :: formla
       6     integer, dimension (numat), intent (in) :: nat
       7     character (len=8), intent (out) :: els
       8     logical :: first = .true.
       9     integer :: i, j
      10     integer :: maxele
      11     integer :: l, nc, ne, mers(3), k, nele(109), m, nelements
      12     character (len=2), dimension (107) :: elemnt, lowel
      13     character (len=3), dimension (14) :: presnt
      14     character :: num
      15     integer, dimension (10) :: ntype
      16     integer, dimension (107) :: nmap, nos, nosort, numz
      17     double precision, external :: reada
      18     save :: first, nmap,nos, nosort, numz, elemnt, lowel, presnt, maxel
 e
      19 !
      20 !.. Data Declarations ..
      21 !
      22 !  Sequence taken from the CRC Handbook page B-30
      23 !
      24     data lowel /       &
      25  & "Cs","Rb","K ","Na","Li", & !  Group I
      26  & "Ba","Sr","Ca","Mg","Be", & !  Group IIA
      27  & "La","Ce","Pr","Nd","Pm","Sm","Eu","Gd","Tb","Dy","Ho","Tm","Yb","Lu
 ", &
      28  &      "Y ","Sc",           & !  Group IIIB
      29  & "Hf","Zr","Ti",           & !  Group IVB
      30  & "Ta","Nb","V ",           & !  Group VB
      31  & "W ","Mo","Cr",           & !  Group VIB
      32  & "Re","Tc","Mn",           & !  Group VIIB
      33  & "Pt","Ir","Os",           & !  This is the sequence in CRC B-30
      34  & "Pd","Rh","Ru","Ni","Co","Fe","Au",      &
      35  & "Ag","Cu","Hg","Cd","Zn","Tl","In","Ga","Al","Pb","Sn","Ge","Bi", &
      36  & "B ","Si","C ","Sb","As","P ","N ","H ","Te","Se","S ","I ","Br", &
      37  & "Cl","O ","F ","He","Ne","Ar","Kr","Xe",25*"XX"/
      38
      39     data elemnt / "H ", "He", "Li", "Be", "B ", "C ", "N ", "O ", "F ",
  "Ne", &
      40    & "Na", "Mg", "Al", "Si", "P ", "S ", "Cl", "Ar", "K ", "Ca", "Sc",
 "Ti", "&
      41    &V ", "Cr", "Mn", "Fe", "Co", "Ni", "Cu", "Zn", "Ga", "Ge", "As", "S
 e", "Br&
      42    &", "Kr", "Rb", "Sr", "Y ", "Zr", "Nb", "Mo", "Tc", "Ru", "Rh", "Pd"
 , "Ag", &
      43    & "Cd", "In", "Sn", "Sb", "Te", "I ", "Xe", "Cs", "Ba", "La", "Ce",
 "Pr", "&
      44    &Nd", "Pm", "Sm", "Eu", "Gd", "Tb", "Dy", "Ho", "Er", "Tm", "Yb", "L
 u", "Hf&
      45    &", "Ta", "W ", "Re", "Os", "Ir", "Pt", "Au", "Hg", "Tl", "Pb", "Bi"
 , "Po", &
      46    & "At", "Rn", "Fr", "Ra", "Ac", "Th", "Pa", "U ", "Np", "Pu", "Am",
 "Cm", "&
      47    &Bk", "Cf", "XX", "Fm", "Md", "Cb", "++", " +", "--", " -", "Tv" /
      48   !
 
 FORCHECK PC V13.5.13          EMPIRE          2021-03-24 10:59:30   page:   889
 empire.F90  /FF
 
      49   ! ... Executable Statements ...
      50   !
      51     if (first) then
      52       first = .false.
      53     !
      54     !  CONSTRUCT THE MAP TO DETERMINE THE ORDER IN WHICH THE ELEMENTS W
 ILL
      55     !  BE PRINTED IN THE EMPIRIC FORMULA
      56     !
      57       do i = 1, 107
      58         if (lowel(i) =="XX") exit
      59         do j = 1, 107
      60           if (elemnt(j) == lowel(i)) go to 1000
      61         end do
      62         go to 1100
      63 1000    nmap(i) = j
      64       end do
      65       maxele = i - 1
      66       go to 1200
      67 1100  write (6,*) "   FAULT:", lowel (i), i
      68       stop
      69     end if
      70 1200 els = " "
      71     do i = 1, maxele
      72       if (lowel(i) (2:2) == " ") then
      73         numz(i) = 1
      74       else
      75         numz(i) = 2
      76       end if
      77     end do
      78   !
      79   !  INITIALIZE ELEMENT ARRAYS
      80   !
      81     do i = 1, 107
      82       nos(i) = 0
      83     end do
      84   !
      85   !  READ FORMULA AND WORK OUT ELEMENTAL COMPOSITION
      86   !
      87     do i = 1, numat
      88       j = nat(i)
      89       nos(j) = nos(j) + 1
      90     end do
      91   !
      92   !   SEQUENCE ELEMENTS TO LOOK NICE
      93   !
      94     do i = 1, maxele
      95       nosort(i) = nos(nmap(i))
      96     end do
      97   !
      98   !  REDUCE IT TO AN EMPIRICAL FORMULA
      99   !
     100     nelements = 0
     101     do i = 1, maxele
     102       if (nosort(i) /= 0) then
     103         nelements = nelements + 1
     104         ntype(nelements) = i
     105         presnt(nelements) = lowel(i)
     106       end if
 
 FORCHECK PC V13.5.13          EMPIRE          2021-03-24 10:59:30   page:   890
 empire.F90  /FF
 
     107     end do
     108     j = Index (keywrd, " MERS")
     109     if (j /= 0) then
     110       mers = 0
     111       k = 0
     112       i = Index (keywrd(j + 1:), " ") + j
     113       do l = 1, 3
     114         j = j + k
     115         if (l > 1 .and. k == 0) exit
     116         mers(l) = Nint (reada (keywrd(j:), 1))
     117         k = Index (keywrd(j:i), ",")
     118       end do
     119       i = Index(keywrd, " Z=")
     120       if (i /= 0) then
     121         k = Nint(reada(keywrd,i))
     122         k = mers(1)*mers(2)*mers(3)*k
     123         if (Index (keywrd, " BCC") /= 0) k = k/2
     124       else
     125         nele = 0
     126         do i = 1, natoms - 3
     127           nele(labels(i)) = nele(labels(i)) + 1
     128         end do
     129         j = 0
     130         do i = 1, 98
     131           if (nele(i) > 0) then
     132             j = j + 1
     133             nele(j) = nele(i)
     134           end if
     135         end do
     136         k = 1000
     137         do i = 1, j
     138           if(nele(i) < k) k = nele(i)
     139         end do
     140   !
     141   !  k is the smallest number of atoms of any element in the formula
     142   !
     143         do i = 1, 100
     144           m = 0
     145           do l = 1, j
     146             if (Abs((i*nele(l))/k - (i*1.d0*nele(l))/k) > 1.d-5) m = 1
     147           end do
     148           if (m == 0) exit
     149         end do
     150         k = k/i
     151       end if
     152       nosort = nosort/max(k,1)
     153     end if
     154 !
     155 !   CONVERT IT TO A CHARACTER FORMULA
     156 !
     157     formla = " "
     158     ne = 2
     159     nc = 2
     160     do i = 1, nelements
     161       formla(nc:) = presnt(i) (:numz(ntype(i)))
     162       nc = nc + numz(ntype(i))
     163       els(ne:) = presnt(i) (:numz(ntype(i)))
     164       ne = ne + numz(ntype(i))
     165       if (nosort(ntype(i)) /= 1) then
 
 FORCHECK PC V13.5.13          EMPIRE          2021-03-24 10:59:30   page:   891
 empire.F90  /FF
 
     166         if (nosort(ntype(i)) == 0) then
     167    !       write(*,'(a)')" Z definitely wrong in "//trim(title)
     168     !      write(31,'(a)')" Z definitely wrong in "//trim(title)
     169         else
     170           j = int(log10(nosort(ntype(i))*1.0)) + 1
     171           num = char(ichar("0") + j)
     172           write(formla(nc:),"(i"//num//")")nosort(ntype(i))
     173           nc = len_trim(formla) + 1
     174         end if
     175       end if
     176     end do
     177 end subroutine empire
 
