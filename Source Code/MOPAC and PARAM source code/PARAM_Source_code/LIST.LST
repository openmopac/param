 moldat.F90  /FF
 
 K"'
     881             num1 = char(Int(log10(max(ireal,jreal)     + 1.0)) + ichar(
 "1"))
     882             if (pdb_label) then
     883               write(iw,"(/10x,a,i"//num1//",a)")"(Label for atom ", ire
 al, ": """//txtatm(ireal)//""")"
     884               write(iw,"( 10x,a,i"//num1//",a)")"(Label for atom ", jre
 al, ": """//txtatm(jreal)//""")"
     885             end if
     886             if (log) write (ilog, '(//10x,a,//10x,a)')trim(line), 'TO C
 ONTINUE CALCULATION SPECIFY "GEO-OK"'
     887           end if
     888           write (iw, '(/,a)')'   NOTE THAT THE ATOM NUMBERS CORRESPOND
 TO THE'//&
     889             ' ''CARTESIAN COORDINATES'' ATOM LIST.'
     890           if (index(keywrd,' 0SCF') == 0) then
     891             if (index(keywrd,' ADD-H') /= 0) then
     892               write(line,'(a,i6,a,i6)')'SEVERE ERROR IN GEOMETRY, FIX F
 AULT BEFORE CONTINUING. Atoms:',ireal, ' and', jreal
     893               call mopend (trim(line))
     894               numat = 0
     895               natoms = 0
     896               return
     897             end if
     898             if (rmin < 1.d-4) then
     899               write(line,'(a,i6,a,i6)')'GEOMETRY IN ERROR, FIX FAULT BE
 FORE CONTINUING. Atoms:',ireal, ' and', jreal
     900               call mopend (trim(line))
     901             else
     902               call mopend ("GEOMETRY IN ERROR.  TO CONTINUE CALCULATION
  SPECIFY 'GEO-OK'.")
     903             end if
     904             return
     905           end if
     906         end if
     907       end if
     908       if (.not.debug) return
     909       write (iw, 290) numat, norbs, ndorbs, natoms
     910   290 format('   NUMBER OF REAL ATOMS:',i4,/,'   NUMBER OF ORBITALS:  '
 ,i4,/,&
     911         '   NUMBER OF D ORBITALS:',i4,/,'   TOTAL NO. OF ATOMS:  ',i4)
     912       write (iw, 300) (uspd(i),i=1,norbs)
     913   300 format('   ONE-ELECTRON DIAGONAL TERMS',/,10(/,10f8.3))
     914       write (iw, 310) (pdiag(i),i=1,norbs)
     915   310 format('   INITIAL P FOR ALL ATOMIC ORBITALS',/,10(/,10f8.3))
     916       return
     917 end subroutine moldat
 
