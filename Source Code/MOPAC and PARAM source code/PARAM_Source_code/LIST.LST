    1052         'REFERENCES  B.WANG AND G.P.FORD J.COMP.CHEM. 15, 200:207 (1994
 )',/,13x,&
    1053         'G.P.FORD AND B.WANG J.COMPT.CHEM. 14(1993)1101')
    1054       call meprot (c1, r0, t, xm, ym, icase, step, cmep, z0, iback)
