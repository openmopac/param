     374       m = m1 - 1
     375       lb = lb1 - 1
     376       la = la1 - 1
     377       r = r1/a0
     378       if (first) then
     379         first = .FALSE.
     380 !
     381 !           INITIALISE SOME CONSTANTS
     382 !
     383 !                  BINOMIALS
     384 !
     385         do i = 0, 12
     386           bi(i,0) = 1.D0
     387           bi(i,i) = 1.D0
     388         end do
     389         do i = 0, 11
     390           i1 = i - 1
     391           bi(i+1,1:i1+1) = bi(i,1:i1+1) + bi(i,:i1)
     392         end do
     393         aff(0,0,0) = 1.D0
 
 FORCHECK PC V13.5.13            SS            2021-03-24 10:59:30   page:  1224
 diat.F90  /FF
 
     394         aff(1,0,0) = 1.D0
     395         aff(1,1,0) = sqrt(0.5D0)
     396         aff(2,0,0) = 1.5D0
     397         aff(2,1,0) = sqrt(1.5D0)
     398         aff(2,2,0) = sqrt(0.375D0)
     399 !
     400 !   AFF(2,0,2) CORRESPONDS TO C(2,0,1) IN THE MANUAL
     401 !
     402         aff(2,0,2) = -0.5D0
     403       end if
     404       p = (ua + ub)*r*0.5D0
     405       b = (ua - ub)*r*0.5D0
     406       quo = 1/p
     407       af(0) = quo*exp((-p))
     408       do n = 1, 19
     409         af(n) = n*quo*af(n-1) + af(0)
     410       end do
     411       call bfn (b, bf)
     412       sum = 0.D0
     413       lam1 = la - m
     414       lbm1 = lb - m
     415 !
     416 !          START OF OVERLAP CALCULATION PROPER
     417 !
     418       do i = 0, lam1, 2
     419         ia = na + i - la
     420         ic = la - i - m
     421         do j = 0, lbm1, 2
     422           ib = nb + j - lb
     423           id = lb - j - m
     424           sum1 = 0.D0
     425           iab = ia + ib
     426 !
     427 !   In the Manual ka = K6
     428 !                 kb = K5
     429 !                 Pa = K1
     430 !                 Pb = K2
     431 !                 qa = K3
     432 !                 qb = K4
     433 !
     434           do k1 = 0, ia
     435             do k2 = 0, ib
     436               do k3 = 0, ic
     437                 do k4 = 0, id
     438                   do k5 = 0, m
     439                     iaf = iab - k1 - k2 + k3 + k4 + 2*k5
     440                     do k6 = 0, m
     441                       ibf = k1 + k2 + k3 + k4 + 2*k6
     442                       sum1 = sum1 + bi(id,k4)*bi(ic,k3)*bi(ib,k2)*bi(ia
 ,k1)*bi(m,k5)*bi(m,k6)* &
     443                       (1 - 2*mod(m + k2 + k4 + k5 + k6,2))*af(iaf)*bf(i
 bf)
     444                     end do
     445                   end do
     446                 end do
     447               end do
     448             end do
     449           end do
     450           sum = sum + sum1*aff(la,m,i)*aff(lb,m,j)
 
 FORCHECK PC V13.5.13            SS            2021-03-24 10:59:30   page:  1225
 diat.F90  /FF
 
     451         end do
     452       end do
     453       ss = sum*r**(na + nb + 1)*ua**na*ub**nb/2.D0* &
     454       sqrt(ua*ub/(fact(na+na)*fact(nb+ nb))*((la+la+1)*(lb+lb+1)))
     455       return
