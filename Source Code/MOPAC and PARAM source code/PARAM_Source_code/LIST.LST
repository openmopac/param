       1       subroutine ijkl(cp, cf, nelec, nmos, dijkl, cij, ckl, wcij, xy)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE molkst_C, only : norbs, numat, lm61
       6       USE cosmo_C, only : iseps
       7       use common_arrays_C, only : nfirst, nlast, w
       8 !-----------------------------------------------
       9 !   I n t e r f a c e   B l o c k s
      10 !-----------------------------------------------
      11       implicit none
      12 !-----------------------------------------------
      13 !   D u m m y   A r g u m e n t s
      14 !-----------------------------------------------
      15       integer , intent(in) :: nelec
      16       integer , intent(in) :: nmos
      17       double precision , intent(in) :: cp(norbs,nmos)
      18       double precision , intent(in) :: cf(norbs,norbs)
      19       double precision , intent(inout) :: dijkl(norbs,nmos,(nmos*(nmos
 + 1))/2)
      20       double precision  :: cij(lm61)
      21       double precision  :: ckl(lm61)
      22       double precision  :: wcij(lm61)
      23       double precision , intent(out) :: xy(nmos,nmos,nmos,nmos)
      24 !-----------------------------------------------
      25 !   L o c a l   V a r i a b l e s
      26 !-----------------------------------------------
      27       integer :: ij, i, j, ipq, ii, ip, k, l, kk
      28       double precision :: sum
      29 !-----------------------------------------------
      30 !**********************************************************************
 *
      31 !
      32 !   IJKL FILLS THE XY ARRAY.  XY HOLDS THE TWO-ELECTRON INTEGRALS OVER
      33 !        MOLECULAR ORBITALS IN THE ACTIVE SPACE.
      34 !        XY(I,J,K,L) = <IJ|1/R(1,2)|KL>
      35 !
      36 !           ON INPUT
      37 !
      38 ! CP     = M.O.'S OVER C.I. ACTIVE SPACE (NORMALLY 1 TO 5 M.O.S)
      39 ! CF     = ALL M.O.'S, INCLUDING THOSE IN CP
      40 ! NORBS  = NUMBER OF ATOMIC ORBITALS
      41 ! NELEC  = NUMBER OF OCCUPIED M.O.S NOT INVOLVED IN THE C.I.
      42 ! NMOS   = NUMBER OF M.O.S INVOLVED IN THE C.I. (NORMALLY 1 TO 5 M.O.S)
      43 !          ALSO CALLED THE ACTIVE SPACE OF THE C.I.
      44 !
      45 !  NOTE: THIS SUBROUTINE IS UNUSUAL IN THAT ONE FUNCTION IS TO
      46 !        FILL THE ARRAY XY WHICH IS NOT PASSED AS AN ARGUMENT,
      47 !        INSTEAD IT IS PASSED VIA COMMON BLOCK XYIJKL.
      48 !
      49 !**********************************************************************
 *
      50 !
      51 !  CALCULATE TWO-ELECTRON INTEGRALS FOR THE SET DIJKL(K,L,IJ)
      52 !  THE INDEX K RUNS OVER ALL M.O.'S, L OVER ACTIVE-SPACE M.O.'S,
      53 !  AND IJ OVER LOWER-HALF TRIANGLE OF ACTIVE-SPACE M.O.'S, J FASTER THA
 N
      54 !  I.
 
 FORCHECK PC V13.5.13           IJKL           2021-03-24 10:59:30   page:  3527
 ijkl.F90  /FF
 
      55 !  ALL ACTIVE-SPACE INTERACTIONS ARE COPIED INTO THE ARRAY XY
      56 !
      57       ij = 0
      58       do i = 1, nmos
      59         do j = 1, i
      60           ij = ij + 1
      61           ipq = 0
      62           do ii = 1, numat
      63             do ip = nfirst(ii), nlast(ii)
      64               if (ip - nfirst(ii) + 1 > 0) then
      65                 cij(ipq+1:ip-nfirst(ii)+1+ipq) = cp(ip,i)*cp(nfirst(ii)
 :ip,j)&
      66                    + cp(ip,j)*cp(nfirst(ii):ip,i)
      67                 ipq = ip - nfirst(ii) + 1 + ipq
      68               end if
      69             end do
      70           end do
      71 !
      72 !  CIJ HOLDS THE DENSITY DISTRIBUTION PSI(I)*PSI(J) OVER ATOMIC BASES
      73 !  I AND J ARE M.O. INDICES WITHIN THE ACTIVE SPACE.  CIJ(M,N) IS FOR
      74 !  THE ATOMIC BASES M AND N FOR M.O.'S I AND J.
      75 !
      76           call partxy (cij, wcij, w)
      77 !
      78 ! WCIJ HOLDS THE KET PART OF THE INTEGRAL <K,L|1/R(1,2)|I,J>
      79 ! THAT IS, |1/R(1,2)|I,J>.  WCIJ(M,N) IS FOR THE ATOMIC BASES M AND N
      80 ! FOR M.O.'S K AND L.
      81 !
      82           do k = 1, norbs
      83             do l = 1, nmos
      84 !
      85 !  ABOUT TO CALCULATE <I,J|1/R(1,2)|K,L>
      86 !
      87               ipq = 0
      88               do ii = 1, numat
      89                 do ip = nfirst(ii), nlast(ii)
      90                   if (ip - nfirst(ii) + 1 > 0) then
      91                     ckl(ipq+1:ip-nfirst(ii)+1+ipq) = cf(ip,k)*cp(nfirst
 (ii):ip,&
      92                       l) + cp(ip,l)*cf(nfirst(ii):ip,k)
