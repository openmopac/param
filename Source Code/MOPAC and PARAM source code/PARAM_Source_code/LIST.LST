       1 subroutine lewis (use_cvs)
       2    !*******************************************************************
 ****
       3    !
       4    !
       5    !  LEWIS works out what atom is bonded to what atom for the purpose
 of
       6    !  generating a Lewis structure.  It starts with the topography gene
 rated
       7    !  by "set_up_dentate" (this is the raw topography), then tidies up
 the
       8    !  topography using a series of filters - keywords such as CVB, and
 criteria
       9    !  such as a hydrogen atom must bond to exactly one other atom, and
 that must
      10    !  be a non-hydrogen atom.
      11    !
      12    ! On exit, NBONDS holds the number of bonds to each atom, and
      13    !          IBONDS contains the atom numbers, in order of increasing
      14    !                 atomic number.
      15    !
      16    ! The maximum number of bonded atoms per atom is 4.  More are allowe
 d
      17    ! for checking purposes, but for a SCF calculation, 4 is the maximum
 .
      18    !
      19    !*******************************************************************
 ****
      20     use molkst_C, only: natoms, numat, maxtxt, keywrd, &
      21       line, moperr, numcal, prt_topo
      22     use chanel_C, only: iw
      23     use elemts_C, only: elemnt
      24     use common_arrays_C, only: txtatm, nat, coord, &
      25       nbonds, ibonds
      26     implicit none
      27     logical, intent (in) :: use_cvs
      28 !
      29     logical :: debug, let
      30     integer :: i, ibad, j, jbad, k, l, m, n, icalcn = -1
      31     double precision, allocatable :: store_coord(:,:)
      32     integer, dimension (:), allocatable :: iz
      33     save :: store_coord
      34     l = 0
      35 !
      36 ! Most of the time, LET should be false, the commonest exceptions being
  0SCF and RESEQ
      37 !
      38     if (allocated (store_coord) .and. icalcn /= numcal) then
      39       deallocate (store_coord)
      40       icalcn = numcal
      41     end if
      42     allocate (iz(natoms))
      43     if (.not. allocated (store_coord)) then
      44       i = size(coord)/3
      45       allocate (store_coord(3,i))
      46       store_coord = coord
      47     end if
      48     let = (Index (keywrd, " 0SCF") + Index (keywrd, " RESEQ") + Index (
 
 FORCHECK PC V13.5.13          LEWIS           2021-03-24 10:59:30   page:  3758
 lewis.F90  /FF
 
 keywrd, " SITE=") +  &
      49       Index (keywrd, " GEO-OK") + Index (keywrd, " ADD-H") + Index (key
 wrd, " LET") /= 0)
      50     debug = (Index (keywrd, " LEWIS") /= 0)
      51 !
      52 !  Work out raw connectivity.  This depends only on the topology.
      53 !  Arrays nbonds and ibonds are filled here.
      54 !
      55     call set_up_dentate()
      56     if (use_cvs) call check_cvs(.true.)
      57 !
      58 !  Put limit on maximum number of bonds to an atom.
      59 !
      60 !  This is a practical issue.  In theory, it should be possible to make
  Lewis structures
      61 !  for all systems, but in practice some are just too difficult.  For e
 xample, [Fe(ii)(NH3)6](2+)
      62 !  and [Ni(ii)(NH3)6](2+).  In these systems, consider the metal as bon
 ding to a nitrogen atom.
      63 !  The metal obviously has a formal charge of -4 and the nitrogen atoms
  have a formal charge of +1,
      64 !  to give a net charge on the complex of +2.  However, writing softwar
 e for this has been too difficult,
      65 !  so it is easier to re-word such complexes as [Fe(ii)(NH3)5](2+).(NH3
 )  This does not affect the results,
      66 !  but is a useful expedient.
      67 !
      68     do i = 1, numat
      69       select case (nat(i))
      70       case (26, 28, 46, 78)  ! Fe, Ni, Pd, Pt
      71         do
      72           if (nbonds(i) > 5) then
      73             call remove_bond(i)
      74           else
      75             exit
      76           end if
      77         end do
      78       case default
      79       end select
      80     end do
      81 !
      82 !  Check bonding of hydrogen atoms - check for bridges
      83 !
      84     call check_H(ibad)
      85     if (ibad == 1) then
      86       write (iw,*)
      87     end if
      88     if (ibad /= 0 .and. .not. let) then
      89       write(iw,'(//10x,a)') "Add keyword ""LET"" to allow job to contin
 ue"
      90       call mopend ("A hydrogen atom is badly positioned")
      91     end if
      92     jbad = ibad
      93     ibad = 0
      94 !
      95 !  Special check for nitro groups
      96 !
      97     do i = 1, numat
      98       if (nat(i) == 7) then
 
 FORCHECK PC V13.5.13          LEWIS           2021-03-24 10:59:30   page:  3759
 lewis.F90  /FF
 
      99         k = 0
     100         l = 0
     101         do j = 1, nbonds(i)
     102           if (nat(ibonds(j,i)) == 8 .and. nbonds(ibonds(j,i)) == 1) the
 n
     103             k = ibonds(j,i)
     104             exit
     105           end if
     106         end do
     107         do j = j + 1, nbonds(i)
     108           if (nat(ibonds(j,i)) == 8 .and. nbonds(ibonds(j,i)) == 1) the
 n
     109             l = ibonds(j,i)
     110             exit
     111           end if
     112         end do
     113 !
     114 !  Found a system with N bonded to two oxygen atoms (k and l),
     115 !  which are not bonded to anything else.
     116 !
     117         if (k /= 0 .and. l /= 0) then
     118 !
     119 !  Put a bond between the two oxygen atoms
     120 !
     121           nbonds(k) = 2
     122           nbonds(l) = 2
     123           ibonds(2,k) = l
     124           ibonds(2,l) = k
     125         end if
     126       end if
     127     end do
     128 !
     129 !  End of special check for nitro groups
     130 !
     131 !
     132 !  Put atoms into order of atomic number
     133 !
     134     do i = 1, numat
     135       if (nbonds(i) > 1) then
     136         n = nbonds(i)
     137         iz(:n) = ibonds(:n,i)
     138         do j = 1, n
     139           k = 0
     140           do m = 1, n
     141             if (iz(m) /= 0) then
     142               if (nat(iz(m)) > k) then
     143                 l = m
     144                  k = nat(iz(m))
     145               end if
     146             end if
     147           end do
     148           ibonds(j,i) = iz(l)
     149           iz(l) = 0
     150         end do
     151       end if
     152     end do
     153     if (prt_topo .and. debug .and. jbad /= 0 .and. .not. let) then
     154       if (maxtxt == 0) then
     155         j = 1
 
 FORCHECK PC V13.5.13          LEWIS           2021-03-24 10:59:30   page:  3760
 lewis.F90  /FF
 
     156       else
     157         j = maxtxt/2 + 2
     158       end if
     159       write (iw, "(/,A,/)") "   TOPOGRAPHY OF SYSTEM"
     160       line = " "
     161       write (iw,*) "  ATOM No. "//line(:j)//"  LABEL  "//line(:j)//"Ato
 ms connected to this atom"
     162       if (j == 0) then
     163         do i = 1, numat
     164           write (iw, "(I7,9X,A,9I7)") i, elemnt (nat(i)) // "  ", (ibon
 ds(j, i), j=1, nbonds(i))
     165         end do
     166       else
     167         if (maxtxt > 2) then
     168           do i = 1, numat
     169             write (iw, "(I7,9X,A,9I7)") i, elemnt (nat(i)) // " (" // t
 xtatm(i) (:maxtxt) // ") ", (ibonds(j, i), j=1, nbonds(i))
     170           end do
     171         else
     172           do i = 1, numat
     173             write (iw, "(I7,9X,A,9I7)") i, elemnt (nat(i)), (ibonds(j,
 i), j=1, nbonds(i))
     174           end do
     175         end if
     176       end if
     177     end if
     178     if (jbad /= 0 .and. .not. let) call mopend ("Geometry is faulty")
     179     if (let) moperr = .false.
     180 end subroutine lewis
 
 FORCHECK PC V13.5.13          LEWIS           2021-03-24 10:59:30   page:  3761
 lewis.F90  /FF


