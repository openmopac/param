       1 module symmetry_C
       2     integer, parameter :: ntbs = 38
       3
       4     save
       5   integer :: &
       6   &  igroup, & !  Index of point-group
       7   &  nclass, & !  Number of classes used in the point-group
       8   &  nirred, & !  Number of irreducible representations
       9   &  nsym,   &
      10   &  nent,   &
      11   &  dummy
      12
      13   integer, dimension(20)               :: ielem
      14   integer, dimension(6)                :: jy
      15   integer, dimension (348)             :: nallop
      16   integer, dimension (ntbs)            :: ntab
      17   integer, dimension (764)             :: nallg
      18
      19   character, dimension(20)             :: jx*4      !
      20   character                            :: name*4
      21   character, dimension (406)           :: allrep*4
      22   character, dimension(:), allocatable :: namo*4             !  Names o
 f irreducible representations
      23   character                            :: state_spin*8       !  Spin-st
 ate, e.g., "TRIPLET"
      24   character                            :: state_Irred_Rep*4  !  Irreduc
 ible representation, e.g. "T2g"
      25   integer                              :: state_QN           !  Quantum
  number, e.g., 2, 3, 4.
      26
      27   integer, dimension(:), allocatable :: &
      28   &  jndex,  & !  Principal quantum number of irreducible representatio
 n
      29   &  dummys
      30
      31
      32   integer, dimension(:,:), allocatable :: &
      33   &  ipo,    & !
      34   &  jelem
      35   double precision, dimension(3,3)              :: cub
      36   double precision, dimension(9,120)            :: r
      37   double precision, dimension(3,3,20)           :: elem
      38   double precision, dimension(20,5)             :: group
      39   double precision, dimension(:), allocatable   :: depmul
      40   integer, dimension(:), allocatable        :: locpar, idepfn, locdep
      41
      42
      43
      44     !******************************************************************
 ***
      45    !
      46    !  BLOCK DATA FOR ALL THE POINT-GROUPS USED IN MOPAC
      47    !
      48    !  Point-Groups are stored in order of increasing symmetry.  Groups
      49    !   supported are, in order
      50    !
      51    ! C1, Cs, Ci, C2, D2, C2v, C2h, D2h, C3, C4, S4, D3, C3v, C3h, C5, C
 6,
 
 FORCHECK PC V13.5.13        SYMMETRY_C        2021-03-24 10:59:30   page:    83
 symmetry_C.F90  /FF
 
      52    ! S6, C7, C8, S8, C4v, D4, D2d, C5v, C6v, D6, C4h, D3h, D3d, C7v, C7
 h,
      53    ! C8v, D8, D4d, D4h, C5h, D5, D5h, D5d, C6h, D6h, D6d, D7, D7h, D7d,
      54    ! C8h, D8h, T, Td, O, Th, Oh, I, Ih, Cv, Dh, R3
      55    !
      56    !  Character tables are stored separately from the point groups, so
      57    !  that more than one group can use the same character table.
      58    !  The totally symmetric representation is assumed to exist, and
      59    !  has been suppressed from the character tables.
      60    !
      61    !  Each point group is represented by two arrays, a I<group symbol>
      62    !  and a R<group symbol> array.  The structure of these tables is as
      63    !  follows:
      64    !
      65    !      I<group symbol>
      66    !
      67    ! (1):    Number of classes of operation used.
      68    ! (2):    Number of Irreducible Representations.
      69    ! (3):    The number of the associated character table.
      70    ! (4):    A "Magic number" identifying the group.
      71    ! (5 on): Numbers indicating the operations of the group
      72    !
      73    !      R<group symbol>
      74    !
      75    ! (1):    The name of the group
      76    ! (2 on): The names of the irreducible representations.
      77    !
      78    !  Character tables are named arbitarily.  Each table has an associa
 ted
      79    !  entry in the NTAB array.  NTAB(i) holds the number of elements in
      80    !  table i.
      81    !
      82    !*******************************************************************
 **
      83    !   Storage of point-groups:  Point-Group Name,Number of Classes,
      84    !                             Names of Classes,Number of Irred. Reps
 .,
      85    !                             Names of Irred. Reps,Number of data in
      86    !                             point-group,Name of Representation
      87    !.. Implicit Declarations ..
      88  !
      89     ! IG11
      90     data ntab(1) / 1 /
      91     data nallg(1:1) / 1 /
      92     ! IG 21
      93     data ntab(2) / 2 /
      94     data nallg(2:3) / 1, -1 /
      95     ! IG42
      96     data ntab(3) / 9 /
