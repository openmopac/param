     383 !     *****************************************************************
 ********
     384
     385       subroutine irreg (k, xx, i1, i2, i3, i4)
     386
     387       use reimers_C, only : ig1, ig2, ig3, ig4, g, nirreg
     388       implicit none
     389       double precision ::   xx
     390       integer ::            i1, i2, i3, i4, k
     391
     392 !     **** stores one of Zerners rotational - invariance maintaining **
 **
     393 !     **** irregular two - electron integrals into integral list      *
 ***
     394
     395       if (nirreg >= 75) stop 'IRREGULAR INTEGRALS'
     396       nirreg = nirreg + 1
     397       g(nirreg, k) = xx
     398       ig1(nirreg, k) = i1
     399       ig2(nirreg, k) = i2
     400       ig3(nirreg, k) = i3
     401       ig4(nirreg, k) = i4
     402
     403       return
     404       end subroutine irreg
 
