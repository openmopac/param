     120 ! gradient of C6(iat, jat) wrt to coord of kat or iat
     121 ! interpolate c6
     122     subroutine getc6(maxc, max_elem, c6ab, mxc, iat, jat, nci, ncj, c6)
     123       implicit none
     124       integer maxc, max_elem
     125       integer iat, jat, i, j, mxc(max_elem)
     126       double precision ::  nci, ncj, c6, c6mem
     127       double precision ::    c6ab(max_elem, max_elem, maxc, maxc, 3)
     128 ! the exponential is sensitive to numerics
     129 ! when nci or ncj is much larger than cn1/cn2
     130       double precision ::    cn1, cn2, r, rsum, csum,  tmp1
     131       c6mem = -1.d99
     132       rsum = 0.d0
     133       csum = 0.d0
     134       c6   = 0.d0
     135       do i = 1, mxc(iat)
     136         do j = 1, mxc(jat)
     137           c6 = c6ab(iat, jat, i, j, 1)
     138           if (c6 > 0.d0) then
     139             c6mem = c6
     140             cn1 = c6ab(iat, jat, i, j, 2)
     141             cn2 = c6ab(iat, jat, i, j, 3)
     142 ! distance
     143             r = (cn1-nci)**2 + (cn2-ncj)**2
     144             tmp1 = exp(-4.d0*r)
     145             rsum = rsum + tmp1
     146             csum = csum + tmp1*c6
     147           end if
     148         end do
     149       end do
     150       if (rsum > 0)then
     151          c6 = csum/rsum
     152       else
     153          c6 = c6mem
     154       end if
     155     end subroutine getc6
 
