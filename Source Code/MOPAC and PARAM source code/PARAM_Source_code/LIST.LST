       1       subroutine tred2e(nm, n, a, d, e, z)
       2
       3       implicit none
       4       integer :: i, j, k, l, n, ii, nm, jp1
       5       double precision :: a(nm, n), d(n), e(n), z(nm, n)
       6       double precision :: f, g, h, hh, scale
       7
       8 !
       9 !     this subroutine is a translation of the algol procedure tred2,
      10 !     num. math. 11, 181 - 195(1968) by martin, reinsch, and wilkinson.
      11 !     handbook for auto. comp., vol.ii - linear algebra, 212 - 226(1971
 ).
      12 !
      13 !     this subroutine reduces a real symmetric matrix to a
      14 !     symmetric tridiagonal matrix using and accumulating
      15 !     orthogonal similarity transformations.
      16 !
      17 !     on input -
      18 !
      19 !        nm must be set to the row dimension of two - dimensional
      20 !          array parameters as declared in the calling program
      21 !          dimension statement,
      22 !
      23 !        n is the order of the matrix,
      24 !
      25 !        a contains the real symmetric input matrix.  only the
      26 !          lower triangle of the matrix need be supplied.
      27 !
      28 !     on output -
      29 !
      30 !        d contains the diagonal elements of the tridiagonal matrix,
      31 !
      32 !        e contains the subdiagonal elements of the tridiagonal
      33 !          matrix in its last n - 1 positions.  e(1) is set to zero,
      34 !
      35 !        z contains the orthogonal transformation matrix
      36 !          produced in the reduction,
      37 !
      38 !        a and z may coincide.  if distinct, a is unaltered.
      39 !
      40 !     questions and comments should be directed to b. s. garbow,
      41 !     applied mathematics division, argonne national laboratory
      42 !
      43 !    - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
      44 !
      45       do 100 i = 1, n
      46 !
      47          do 100 j = 1, i
      48             z(i, j) = a(i, j)
      49   100 continue
      50 !
      51       if (n  ==  1) go to 320
      52 !     ********** for i = n step - 1 until 2 do - - **********
      53       do 300 ii = 2, n
      54          i = n + 2 - ii
      55          l = i - 1
      56          h = 0.0
 
 FORCHECK PC V13.5.13          TRED2E          2021-03-24 10:59:30   page:   812
 ddiag.F90  /FF
 
      57          scale = 0.0
      58          if (l  <  2) go to 130
      59 !     ********** scale row (algol tol then not needed) **********
      60          do 120 k = 1, l
      61   120    scale = scale + abs(z(i, k))
      62 !
      63          if (scale /= 0.0) go to 140
      64   130    e(i) = z(i, l)
      65          go to 290
      66 !
      67   140    do 150 k = 1, l
      68             z(i, k) = z(i, k) / scale
      69             h = h + z(i, k) * z(i, k)
      70   150    continue
      71 !
      72          f = z(i, l)
      73          g = -sign(sqrt(h), f)
      74          e(i) = scale * g
      75          h = h - f * g
      76          z(i, l) = f - g
      77          f = 0.0
      78 !
      79          do 240 j = 1, l
      80             z(j, i) = z(i, j) / (scale * h)
      81             g = 0.0
      82 !     ********** form element of a*u **********
      83             do 180 k = 1, j
      84   180       g = g + z(j, k) * z(i, k)
      85 !
      86             jp1 = j + 1
      87             if (l  <  jp1) go to 220
      88 !
      89             do 200 k = jp1, l
      90   200       g = g + z(k, j) * z(i, k)
      91 !     ********** form element of p **********
      92   220       e(j) = g / h
      93             f = f + e(j) * z(i, j)
      94   240    continue
      95 !
      96          hh = f / (h + h)
      97 !     ********** form reduced a **********
      98          do 260 j = 1, l
      99             f = z(i, j)
     100             g = e(j) - hh * f
     101             e(j) = g
     102 !
     103             do 260 k = 1, j
     104                z(j, k) = z(j, k) - f * e(k) - g * z(i, k)
     105   260    continue
     106 !
     107          do 280 k = 1, l
     108   280    z(i, k) = scale * z(i, k)
     109 !
     110   290    d(i) = h
     111   300 continue
     112 !
     113   320 d(1) = 0.0
     114       e(1) = 0.0
     115 !     ********** accumulation of transformation matrices **********
 
 FORCHECK PC V13.5.13          TRED2E          2021-03-24 10:59:30   page:   813
 ddiag.F90  /FF
 
     116       do 500 i = 1, n
     117          l = i - 1
     118          if (d(i)  ==  0.0) go to 380
     119 !
     120          do 360 j = 1, l
     121             g = 0.0
     122 !
     123             do 340 k = 1, l
     124   340       g = g + z(i, k) * z(k, j)
     125 !
     126             do 360 k = 1, l
     127                z(k, j) = z(k, j) - g * z(k, i)
     128   360    continue
     129 !
     130   380    d(i) = z(i, i)
     131          z(i, i) = 1.d0
     132          if (l  <  1) go to 500
     133 !
     134          do 400 j = 1, l
     135             z(i, j) = 0.0
     136             z(j, i) = 0.0
     137   400    continue
     138 !
     139   500 continue
     140 !
     141       return
     142 !     ********** last card of tred2 **********
     143       end subroutine tred2e
 
