     100 !     *****************************************************************
 ********
     101
     102       subroutine ao2mo1 (a, f, c, d, i1, i2, j1, j2, weight)
     103
     104 !     **** this adds C(transp) . F . C onto A over MO range with weight
 ing ****
     105 !     **** as specified by Edwards and Zerner, eqn 24
     ****
     106 !     **** in MO basis, the proj operators simply limit the range of i,
  j   ****
     107       use reimers_C, only : n, nb2, matind
     108
     109       implicit none
     110       double precision ::  a(nb2), f(nb2), c(n, n), d(nb2, 2), wk(n, n)
 , weight, &
     111                         xx
     112       integer ::           i, j, k, i1, i2, j1, j2, nm
     113
     114 ! RMG edit
     115       do i = 1, n
     116         wk(i, 1) = d(i, 1)
     117         do j = 2, n
     118           wk(i, j) = 0.d0
     119         end do
     120       end do
     121 ! End RMG
     122
     123       do i = 1, n
     124         do j = j1, j2
     125           xx = 0.d0
     126           do k = 1, n
     127             nm = matind (max(i, k)) + min(i, k)
     128             xx = xx + f(nm) * c(j, k)
     129           end do
     130           wk(i, j) = xx
     131         end do
     132       end do
     133
     134       do j = j1, j2
     135         do i = i1, min(j, i2)
     136           xx = 0.d0
     137           do k = 1, n
     138             xx = xx + c(i, k) * wk(k, j)
     139           end do
     140           nm = matind(max(i, j)) + min(i, j)
     141           a(nm) = a(nm) + xx * weight
     142         end do
     143       end do
     144
     145 ! RMG edit
     146       do i = 1, n
     147          d(i, 1) = wk(i, 1)
     148       end do
     149 ! End RMG
     150
     151       return
     152       end subroutine ao2mo1
 
