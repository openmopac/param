 lor atom deeppink;}}"
     452         write(iprt,"(a)")"select @sel; lcharge_s= TRUE;"
     453         write(iprt,"(a)")"else lcharge_s= FALSE; var use = {visible}; v
 ar sel = {selected};"
     454         write(iprt,"(a)")"var z = 0; for (var i IN @sel){z = 3}"
     455         write(iprt,"(a)")"if (z = 3); use = sel; endif;"
     456         write(iprt,"(a)")"select @use; spacefill 15%; color cpk; select
  @sel; end if ')"">Charges as Sizes</a>"
