     210               j12 = j12 + c(a, mu + k3) * c(j, mu + k1) * aa
     211
     212 !             **** terms (k2, k1|k4, k3) ****
     213               aa = c(i, mu + k2) * c(b, mu + k3) * gk
     214               k12 = k12 + c(a, mu + k1) * c(j, mu + k4) * aa
     215               j12 = j12 + c(a, mu + k4) * c(j, mu + k1) * aa
