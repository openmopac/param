       1       subroutine symt(h, deldip, ha)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use symmetry_C, only : nsym, ipo, r
       6       use molkst_C, only : numat
       7 !**********************************************************************
 *
       8 !-----------------------------------------------
       9 !   I n t e r f a c e   B l o c k s
      10 !-----------------------------------------------
      11       implicit none
      12 !-----------------------------------------------
      13 !   G l o b a l   P a r a m e t e r s
      14 !-----------------------------------------------
      15 !-----------------------------------------------
      16 !   D u m m y   A r g u m e n t s
      17 !-----------------------------------------------
      18       double precision , intent(inout) :: h(*)
      19       double precision , intent(inout) :: deldip(3,*)
      20       double precision , intent(inout) :: ha(*)
      21 !-----------------------------------------------
      22 !   L o c a l   P a r a m e t e r s
      23 !-----------------------------------------------
      24 !-----------------------------------------------
      25 !   L o c a l   V a r i a b l e s
      26 !-----------------------------------------------
      27       integer :: i, n, i3, i6, j, k, l, j3, k3, k6, l3, l6, iel33
      28       double precision, dimension(9) :: temp, temp2
      29       double precision, dimension(3,3*numat) :: deltmp
      30 !-----------------------------------------------
      31 !****************************************************************
      32 !
      33 !   ON INPUT   H    = HESSIAN MATRIX, PACKED LOWER HALF TRIANGLE
      34 !              R    = SYMMETRY OPERATIONS
      35 !              IPO  = MAP OF ATOMS MOVED
      36 !              NSYM = NUMBER OF SYMMETRY OPERATIONS
      37 !
      38 !   ON OUTPUT  H    = SYMMETRIZED HESSIAN MATRIX
      39 !
      40 !****************************************************************
      41 !  A subroutine that will symmetrize the Hamiltonian, or other matrix
      42 !     by successive application of group operations.  The method used
      43 !     is R H R  added to HA then divided by the total number of symmetr
 y
      44 !     operations used.  This in effects averages all the values in a
      45 !     symmetry correct fashion.
      46 !
      47 !
      48 !
      49 !  Variables used:  (n represents the number of atomic centers)
      50 !     H(3n,3n):  Input/output matrix.  It is a packed lower half triang
 u
      51 !        matrix.  Commonly, the Hessian.
      52 !     HA(3n,3n): An internal matrix used to sum the symatrized Hessian
      53 !     NSYM:      Input, the value of this symmetry operation.
      54 !     TEMP(9), TEMP2(9):   Temporary matricies used to hold small parts
      55 !          larger matricies for specific matrix operations.
 
 FORCHECK PC V13.5.13           SYMT           2021-03-24 10:59:30   page:   692
 symt.F90  /FF
 
      56 !
      57 !    For the next two items, the last indicy represents the symmetry
      58 !        operation number.
      59 !     IPO(n,*):  A vector that contains the symmetry mapping of atomic
 c
      60 !
      61 !   Skip this subroutine if NSYMM <= 0.  This implies that only E is pr
 e
      62       if (nsym < 2) return
      63 !
      64       ha(:numat*(9*numat+3)/2) = 0.D0
      65 !
      66       deltmp(1,:numat*3) = 0.D0
      67       deltmp(2,:numat*3) = 0.D0
      68       deltmp(3,:numat*3) = 0.D0
      69 !
      70       do n = 1, nsym
      71 !
      72 !  Now, to actually perform R H R
      73         do i = 1, numat
      74           i3 = 3*i
      75           i6 = 6*i
      76           do j = 1, i - 1
      77 !
      78 !  Do this multiplication in a 3 by 3 block at a time.  Store H(i,j) in
      79 !    HA( IPO(I,N), IPO(J,N)) or HS( IPO(I,N), IPO(J,N))
      80 !
      81             k = ipo(i,n)
      82             l = ipo(j,n)
      83             j3 = 3*j
      84             k3 = 3*k
      85             k6 = 6*k
      86             l3 = 3*l
      87             l6 = 6*l
      88             if (k > l) then
      89               iel33 = (k3*(k3 - 1))/2 + l3
      90               temp(9) = h(iel33)
      91               temp(8) = h(iel33-1)
      92               temp(7) = h(iel33-2)
      93               temp(6) = h(iel33-k3+1)
      94               temp(5) = h(iel33-k3)
      95               temp(4) = h(iel33-k3-1)
      96               temp(3) = h(iel33-k6+3)
      97               temp(2) = h(iel33-k6+2)
      98               temp(1) = h(iel33-k6+1)
      99             else
     100               iel33 = (l3*(l3 - 1))/2 + k3
     101               temp(9) = h(iel33)
     102               temp(6) = h(iel33-1)
     103               temp(3) = h(iel33-2)
     104               temp(8) = h(iel33-l3+1)
     105               temp(5) = h(iel33-l3)
     106               temp(2) = h(iel33-l3-1)
     107               temp(7) = h(iel33-l6+3)
     108               temp(4) = h(iel33-l6+2)
     109               temp(1) = h(iel33-l6+1)
     110             end if
     111 !
     112             call mat33 (r(1,n), temp, temp2)
 
 FORCHECK PC V13.5.13           SYMT           2021-03-24 10:59:30   page:   693
 symt.F90  /FF
 
     113 !
     114             iel33 = (i3*(i3 - 1))/2 + j3
     115             ha(iel33) = temp2(9) + ha(iel33)
     116             ha(iel33-1) = temp2(8) + ha(iel33-1)
     117             ha(iel33-2) = temp2(7) + ha(iel33-2)
     118             ha(iel33-i*3+1) = temp2(6) + ha(iel33-i3+1)
     119             ha(iel33-i*3) = temp2(5) + ha(iel33-i3)
     120             ha(iel33-i*3-1) = temp2(4) + ha(iel33-i3-1)
     121             ha(iel33-6*i+3) = temp2(3) + ha(iel33-i6+3)
     122             ha(iel33-6*i+2) = temp2(2) + ha(iel33-i6+2)
     123             ha(iel33-6*i+1) = temp2(1) + ha(iel33-i6+1)
     124           end do
     125           k = ipo(i,n)
     126           k3 = 3*k
     127           k6 = 6*k
     128           iel33 = (k3*(k3 + 1))/2
     129           temp(9) = h(iel33)
     130           temp(8) = h(iel33-1)
     131           temp(7) = h(iel33-2)
     132           temp(6) = temp(8)
     133           temp(5) = h(iel33-k3)
     134           temp(4) = h(iel33-k3-1)
     135           temp(3) = temp(7)
     136           temp(2) = temp(4)
     137           temp(1) = h(iel33-k6+1)
     138 !
     139           call mat33 (r(1,n), temp, temp2)
     140 !
     141           iel33 = (i3*(i3 + 1))/2
     142           ha(iel33) = temp2(9) + ha(iel33)
     143           ha(iel33-1) = temp2(8) + ha(iel33-1)
     144           ha(iel33-2) = temp2(7) + ha(iel33-2)
     145           ha(iel33-i*3) = temp2(5) + ha(iel33-i3)
     146           ha(iel33-i*3-1) = temp2(4) + ha(iel33-i3-1)
     147           ha(iel33-6*i+1) = temp2(1) + ha(iel33-i6+1)
     148 !
     149 !  APPLY SYMMETRY TO DIPOLE TERM AS WELL
     150 !
     151           temp(9) = deldip(3,k*3)
     152           temp(8) = deldip(2,k*3)
     153           temp(7) = deldip(1,k*3)
     154           temp(6) = deldip(3,k*3-1)
     155           temp(5) = deldip(2,k*3-1)
     156           temp(4) = deldip(1,k*3-1)
     157           temp(3) = deldip(3,k*3-2)
     158           temp(2) = deldip(2,k*3-2)
     159           temp(1) = deldip(1,k*3-2)
     160 !
     161           call mat33 (r(1,n), temp, temp2)
     162 !
     163           deltmp(3,i*3) = temp2(9) + deltmp(3,i*3)
     164           deltmp(2,i*3) = temp2(8) + deltmp(2,i*3)
     165           deltmp(1,i*3) = temp2(7) + deltmp(1,i*3)
     166           deltmp(3,i*3-1) = temp2(6) + deltmp(3,i*3-1)
     167           deltmp(2,i*3-1) = temp2(5) + deltmp(2,i*3-1)
     168           deltmp(1,i*3-1) = temp2(4) + deltmp(1,i*3-1)
     169           deltmp(3,i*3-2) = temp2(3) + deltmp(3,i*3-2)
     170           deltmp(2,i*3-2) = temp2(2) + deltmp(2,i*3-2)
     171           deltmp(1,i*3-2) = temp2(1) + deltmp(1,i*3-2)
 
 FORCHECK PC V13.5.13           SYMT           2021-03-24 10:59:30   page:   694
 symt.F90  /FF
 
     172 !
     173         end do
     174       end do
     175 !
     176       h(:numat*(9*numat+3)/2) = ha(:numat*(9*numat+3)/2)/nsym
     177 !
     178       deldip(1,:3*numat) = deltmp(1,:3*numat)/nsym
     179       deldip(2,:3*numat) = deltmp(2,:3*numat)/nsym
     180       deldip(3,:3*numat) = deltmp(3,:3*numat)/nsym
     181 !
     182       return
     183       end subroutine symt
 
