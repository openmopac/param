       1       subroutine quadr(f0, f1, f2, x1, x2, a, b, c)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       implicit none
       6 !-----------------------------------------------
       7 !   D u m m y   A r g u m e n t s
       8 !-----------------------------------------------
       9       double precision , intent(in) :: f0
      10       double precision , intent(in) :: f1
      11       double precision , intent(in) :: f2
      12       double precision , intent(in) :: x1
      13       double precision , intent(in) :: x2
      14       double precision , intent(out) :: a
      15       double precision , intent(out) :: b
      16       double precision , intent(out) :: c
      17 !-----------------------------------------------
      18 !   L o c a l   V a r i a b l e s
      19 !-----------------------------------------------
      20 !-----------------------------------------------
      21 !***************************************************
      22 !                                                  *
      23 !    QUADR CALCULATES THE A, B AND C IN THE EQUNS. *
      24 !                                                  *
      25 !     A                   =   F0                   *
      26 !     A + B.X0 + C.X0**2  =   F1                   *
      27 !     A + B.X2 + C.X2**2  =   F2                   *
      28 !                                                  *
      29 !***************************************************
      30       c = (x2*(f1 - f0) - x1*(f2 - f0))/(x2*x1*(x1 - x2))
      31       b = (f1 - f0 - c*x1**2)/x1
      32       a = f0
      33       return
      34       end subroutine quadr
 
