  ", "O ", &
      25    & "F ", "NE", "NA", "MG", "AL", "SI", "P ", "S ", "CL", "AR", "K ",
 "CA", &
      26    & "SC", "TI", "V ", "CR", "MN", "FE", "CO", "NI", "CU", "ZN", "GA",
 "GE", &
      27    & "AS", "SE", "BR", "KR", "RB", "SR", "Y ", "ZR", "NB", "MO", "TC",
 "RU", "RH", &
      28    & "PD", "AG", "CD", "IN", "SN", "SB", "TE", "I ", "XE", "CS", "BA",
 "LA", &
      29    & "CE", "PR", "ND", "PM", "SM", "EU", "GD", "TB", "DY", "HO", "ER",
 "TM", &
      30    & "YB", "LU", "HF", "TA", "W ", "RE", "OS", "IR", "PT", "AU", "HG",
 "TL", "PB", &
      31    & "BI", "PO", "AT", "RN", "FR", "RA", "AC", "TH", "PA", "U ", "NP",
 "PU", &
      32    & "AM", "CM", "BK", "MI", "XX", "+3", "-3", "CB", "++", "+", "--", "
 -", "TV" /
      33     do i = 1,90
      34     if (main_group(i)) f0sd(i) = 0.d0
      35     if (main_group(i)) g2sd(i) = 0.d0
      36     if (f0sd_store(i) < 1.d-5) f0sd_store(i) = f0sd(i)
      37     if (g2sd_store(i) < 1.d-5) g2sd_store(i) = g2sd(i)
      38     dorbs(i) = (Abs(udd(i)) > 1.d-8 .and. zd(i) > 1.d-1)
