    1167       if (txtatm1(i) == " ") then
    1168         txtatm1(i) = txtatm(i)
    1169       else
    1170         txtatm(i) = txtatm1(i)
    1171       end if
    1172     end do
    1173     goto 99
    1174   end if
    1175 !
    1176 !  Add text to TXTATM to label hydrogen atoms and to add chain letter
    1177 !
    1178   if (index(keywrd," ADD-H") + index(keywrd," SITE=") + index(keywrd,"
 RESEQ") /= 0) &
    1179     call set_up_dentate()
