    2146                     stpmx = a2 / a1
    2147                   end if
    2148                 end if
    2149               end if
    2150             end do
    2151           end if
    2152         end if
    2153         if (iter == 0 .and. .not. boxed) then
    2154           stp = Min (one/dnorm, stpmx)
    2155         else
    2156           stp = one
    2157         end if
    2158        !
    2159         call dcopy (n, x, 1, t, 1)
    2160         call dcopy (n, g, 1, r, 1)
    2161         fold = f
    2162         ifun = 0
    2163         iback = 0
    2164         csave = "START"
    2165       end if
    2166       gd = ddot (n, g, 1, d, 1)
    2167       if (ifun == 0) then
    2168         gdold = gd
    2169         if (gd >= zero) then
    2170           !                               the directional derivative >=
 0.
    2171           !                               Line search is impossible.
    2172           info = -4
    2173           return
    2174         end if
    2175       end if
    2176     !
    2177       call dcsrch (f, gd, stp, ftol, gtol, xtol, zero, stpmx, csave, is
 ave, &
    2178      & dsave)
    2179     !
    2180       xstep = stp * dnorm
    2181     !
    2182       if (csave(1:4) == "CONV" .or. csave(1:4) == "WARN") then
    2183         task = "NEW_X"
    2184         return
    2185       end if
    2186       task = "FG_LNSRCH"
    2187       ifun = ifun + 1
    2188       nfgv = nfgv + 1
    2189       iback = ifun - 1
    2190       if (Abs(stp - one) < 1.d-20) then
    2191         call dcopy (n, z, 1, x, 1)
    2192       else
    2193         do i = 1, n
    2194           x(i) = stp * d(i) + t(i)
    2195         end do
    2196       end if
 
