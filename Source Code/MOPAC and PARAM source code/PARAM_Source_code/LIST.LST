    3556       subroutine nonbet(u1x, u1y, u1z, u2x, u2y, u2z, g1x, g1y, g1z, g2
 x, g2y, g2z)
    3557 !-----------------------------------------------
    3558 !   M o d u l e s
    3559 !-----------------------------------------------
    3560       use molkst_C, only : norbs, nclose, line
    3561       use chanel_C, only : iw
    3562        USE polar_C, only : omega
    3563 !
    3564 ! THIS SUBROUTINE CALCULATES SECOND HARMONIC GENERATION IN A
    3565 ! NONITERATIVE WAY.
    3566 !
    3567 !**********************************************************************
 *
    3568 !-----------------------------------------------
    3569 !   I n t e r f a c e   B l o c k s
    3570 !-----------------------------------------------
    3571       implicit none
    3572 !-----------------------------------------------
    3573 !   G l o b a l   P a r a m e t e r s
    3574 !-----------------------------------------------
    3575 !-----------------------------------------------
