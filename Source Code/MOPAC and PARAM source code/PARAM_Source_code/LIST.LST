    1517 !
    1518       subroutine packp(p, pp, mn)
    1519 !-----------------------------------------------
    1520 !   M o d u l e s
    1521 !-----------------------------------------------
    1522       use molkst_C, only : numat
    1523       use common_arrays_C, only : nfirst, nlast
    1524 !*********************************************************************
    1525 !  SUBROUTINE PACKP RE-WRITES THE DENSITY MATRIX.
    1526 !  WRITTEN BY BINGZE WANG, 20 OCTOBER 1991.
    1527 !*********************************************************************
    1528 !**********************************************************************
 *
    1529       implicit none
    1530 !-----------------------------------------------
    1531 !   G l o b a l   P a r a m e t e r s
    1532 !-----------------------------------------------
    1533 !-----------------------------------------------
    1534 !   D u m m y   A r g u m e n t s
    1535 !-----------------------------------------------
    1536       integer , intent(out) :: mn
    1537       double precision , intent(in) :: p(*)
    1538       double precision , intent(out) :: pp(*)
    1539 !-----------------------------------------------
    1540 !   L o c a l   V a r i a b l e s
    1541 !-----------------------------------------------
    1542       integer :: i, ia, ib, j, j1st
    1543 !-----------------------------------------------
    1544       mn = 0
    1545       do i = 1, numat
    1546         ia = nfirst(i)
    1547         ib = nlast(i)
    1548         do j = ia, ib
    1549           j1st = j*(j - 1)/2
    1550           if (j - ia + 1 > 0) then
    1551             pp(mn+1:j-ia+1+mn) = p(j1st+ia:j+j1st)
    1552             mn = j - ia + 1 + mn
    1553           end if
    1554         end do
    1555       end do
    1556       return
    1557       end subroutine packp
 
 FORCHECK PC V13.5.13          PACKP           2021-03-24 10:59:30   page:  3070
 pmep.F90  /FF


