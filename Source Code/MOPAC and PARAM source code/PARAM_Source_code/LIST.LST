     510       subroutine makopr(numat, coord, ierror, r)
     511 !-----------------------------------------------
     512 !   M o d u l e s
     513 !-----------------------------------------------
     514       use symmetry_C, only : ielem, jy, nclass
     515 !**********************************************************************
 *
     516 !-----------------------------------------------
     517 !   I n t e r f a c e   B l o c k s
     518 !-----------------------------------------------
     519       implicit none
     520 !-----------------------------------------------
     521 !   G l o b a l   P a r a m e t e r s
     522 !-----------------------------------------------
     523 !-----------------------------------------------
     524 !   D u m m y   A r g u m e n t s
     525 !-----------------------------------------------
     526       integer  :: numat
     527       integer , intent(out) :: ierror
     528       double precision  :: coord(3,numat)
     529       double precision  :: r(3,3)
     530 !-----------------------------------------------
     531 !   L o c a l   P a r a m e t e r s
     532 !-----------------------------------------------
     533 !-----------------------------------------------
     534 !   L o c a l   V a r i a b l e s
     535 !-----------------------------------------------
     536       integer :: i, iqual
     537       double precision :: toler
     538 !-----------------------------------------------
     539 !*********************************************************************
     540 !
     541 !   MAKOPR builds the operations based on the point group
     542 !          of the system.  A check is made to verify that the
     543 !          operations are valid.
     544 !
     545 !*********************************************************************
     546       call symopr (numat, coord, 1, r)
     547       if (nclass < 2) return
     548 !
     549 !   NCLASS is the number of Classes in the Group.
     550 !   Construct the Operations corresponding to the Classes
     551 !   These are stored in ELEM.
     552 !
     553       do i = 2, nclass
     554         call bldsym (jy(i), i)
     555       end do
     556 !
     557 !   Use a more tolerant criterion for recognizing operations because
     558 !   the point-group has already been identified.
     559 !
     560       toler = 0.2D0
     561       do i = 2, nclass
     562         call chi (toler, coord, i, iqual)
     563         if (ielem(i) >= 1) cycle
     564         ierror = 5
     565       end do
     566       call symopr (numat, coord, -1, r)
 
 FORCHECK PC V13.5.13          MAKOPR          2021-03-24 10:59:30   page:  3566
 molsym.F90  /FF
 
     567       if (iqual < 0) return ! dummy use of iqual
     568       return
     569       end subroutine makopr
 
