     244 !     *****************************************************************
 ********
     245
     246       function eec1 (i1, a1, c, gamma, nbtmo)
     247
     248 !     **** evaluates sum over core j of (i, a|j, j) with i, a in x spac
 e ****
     249       use reimers_C, only : n, matind, ncore, edef, eec
     250 !      USE chanel_C, only : iw
     251
     252       implicit none
     253       double precision ::  c(n, n), gamma(n, n), eec1
     254       integer ::           nbtmo(n)
     255       integer ::           a, a1, i, i1, j, nm
     256       double precision ::  j12, k12
     257       double precision ::            edefs
     258
     259       i = i1 - ncore
     260       a = a1 - ncore
     261       nm = matind(max(i, a)) + min(i, a)
     262       edefs = edef / 2.
     263       if (eec(nm) > edefs) then
     264 !       **** value not previously determined, calculate it ****
     265         eec(nm) = 0.0
     266         do j = 1, ncore
     267           call inttr (i1, a1, j, j, c, gamma, nbtmo, j12, k12, 0)
     268           eec(nm) = eec(nm) + 2.d0*j12 - k12
     269         end do
     270       end if
     271
     272       eec1 = eec(nm)
     273       return
     274
     275       end function eec1
 
