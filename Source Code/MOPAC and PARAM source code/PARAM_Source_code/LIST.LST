    1069     !
    1070     !       HERE THE CONSTRUCTION FOR A SINGLE ATOM ENDS
    1071     !
    1072
    1073     do i = 1, numat
    1074       din(i) = .true.
    1075     end do
    1076
    1077     do j = 1, nps
    1078       din(iatsp(j)) = .false.
