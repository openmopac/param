     109 !
     110 !   Switch from MOPAC (convert coordinates from Angstroms to au)
     111 !
     112       store_tvec = tvec
     113       allocate(dxyz_temp(3,numat*l123), store_coord(3,numat))
     114       store_coord = coord(:,:numat)
     115       coord(:,:numat) = coord(:,:numat)/a0
     116       tvec = tvec/a0
     117       call edisp(max_elem, maxc, numat, nat, c6ab, mxc, r2r4, r0ab, rco
 v, rs6, rs8, alp6, alp8, e6, e8)
     118       e6 = e6*s6
     119       e8 = e8*s18
     120       E_disp = (- e6 - e8)*au_to_kcal
     121       dxyz_temp = 0.0d0
     122 !
     123 ! HBOND
     124 !
     125       if (.not. D3H4) then
     126         call hbsimple(numat, nat, coord, hbscale, ehb, l_grad, dxyz_tem
 p)
     127       else
     128         ehb = 0.d0
     129       end if
     130       E_hb   = ehb*au_to_kcal
     131       dftd3  = E_disp + E_hb
     132       if(l_grad)then
     133         call gdisp(r0ab, rs6, alp6, c6ab, s6, s18,mxc, r2r4, rcov, rs8,
  alp8, dxyz_temp)
     134         dxyz = dxyz + 2.d0*dxyz_temp*au_to_kcal
     135         if (index(keywrd, " DERIV") > 0) then
     136           write (iw, '(/16X,a)')"GRIMME'S D3 CORRECTIONS"
     137           write (iw, '(" NUMBER  ATOM  ",5X,"X",12X,"Y",12X,"Z",/)')
 
 FORCHECK PC V13.5.13          DFTD3           2021-03-24 10:59:30   page:  3475
 dftd3.F90  /FF
 
     138           write (iw, '(I6,4x,a2,F13.6,2F13.6)') (i, elemnt(nat(i)), dxy
 z_temp(:,i)*2.d0*au_to_kcal, i = 1,numat)
     139         end if
     140       end if
     141       coord(:,:numat) = store_coord
     142       tvec = store_tvec
     143       deallocate(dxyz_temp, store_coord)
     144   end function dftd3
 
