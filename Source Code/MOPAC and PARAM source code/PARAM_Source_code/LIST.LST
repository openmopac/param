      99   subroutine print_post_scf_corrections
     100   use molkst_C, only : keywrd, E_disp, E_hb, P_Hbonds
     101   use common_arrays_C, only: H_energy, H_txt
     102   use chanel_C, only : iw
     103   implicit none
     104   double precision :: sum, sum1
     105   double precision, external :: reada
     106   integer :: i, j, k
     107     if (index(keywrd," DISP(") > 0) then
     108       write(iw,'(/47x,a)')" List of hydrogen bonds found"
     109       write(iw,'(3x,a,12x,a,16x,a,11x,a,23x,a,17x,a)')"No.", "Donor", &
     110       "R(D-H)", "Hydrogen",  "Acceptor", "H-bond energy"
     111       sum1 = -abs(reada(keywrd, index(keywrd," DISP(") + 5))
     112       k = 0
     113       do
     114         sum = 0.d0
     115         j = 0
     116         do i = 1, P_hbonds
     117           if (sum > H_energy(i)) then
     118             sum = H_energy(i)
     119             j = i
     120           end if
     121         end do
     122         if (sum > sum1) exit
     123         k = k + 1
     124         write(iw,'(i5,3x,a)')k, trim(H_txt(j))
     125         H_energy(j) = 10.d0
     126       end do
     127     end if
     128     if (index(keywrd, "0SCF") /= 0) then
     129       write(iw,'(/10x,"DISPERSION ENERGY       =", f17.5, a)') e_disp,
 " KCAL/MOL"
     130       write(iw,'(10x,"H-BOND ENERGY           =", f17.5, a,/)') e_hb, "
  KCAL/MOL"
     131     end if
     132   end subroutine print_post_scf_corrections
 
