       1       subroutine cnvg(pnew, p, p1, niter, pl)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use molkst_C, only : norbs, numcal, keywrd, mpack, method_indo
       6       implicit none
       7 !-----------------------------------------------
       8 !   D u m m y   A r g u m e n t s
       9 !-----------------------------------------------
      10       integer , intent(in) :: niter
      11       double precision , intent(out) :: pl
      12       double precision , intent(inout) :: pnew(mpack)
      13       double precision , intent(inout) :: p(mpack)
      14       double precision , intent(inout) :: p1(norbs)
      15 !-----------------------------------------------
      16 !   L o c a l   V a r i a b l e s
      17 !-----------------------------------------------
      18       integer :: icalcn, ii, k, i, ie, j
      19       double precision :: rhfuhf, faca, damp, facb, fac, sum1, a, sa, s
 um2, sum0, &
      20         sum
      21       logical :: extrap
      22
      23       save rhfuhf, icalcn
      24 !-----------------------------------------------
      25 !**********************************************************************
 *
      26 !
      27 !  CNVG IS A TWO-POINT INTERPOLATION ROUTINE FOR SPEEDING CONVERGENCE
      28 !       OF THE DENSITY MATRIX.
      29 !
      30 ! ON OUTPUT P      = NEW DENSITY MATRIX
      31 !           P1     = DIAGONAL OF OLD DENSITY MATRIX
      32 !           PL     = LARGEST DIFFERENCE BETWEEN OLD AND NEW DENSITY
      33 !                    MATRIX DIAGONAL ELEMENTS
      34 !**********************************************************************
 *
      35       data icalcn/ 0/
      36       if (icalcn /= numcal) then
      37         icalcn = numcal
      38         if (index(keywrd,'UHF') /= 0) then
      39           rhfuhf = 1.d0
      40         else
      41           rhfuhf = 2.d0
      42         end if
      43       end if
      44       pl = 0.0d0
      45       faca = 0.0d0
      46       damp = 1.D10
      47       if (niter > 3) damp = 0.05d0
      48       if (method_indo) then
      49         if (niter > 40) damp = 0.01D0
      50         if (niter > 200) damp = 0.002D0
      51         if (niter > 350) damp = 0.001D0
      52       end if
      53       facb = 0.0d0
      54       fac = 0.0d0
      55       ii = mod(niter,3)
 
 FORCHECK PC V13.5.13           CNVG           2021-03-24 10:59:30   page:   604
 cnvg.F90  /FF
 
      56       extrap = ii /= 0
      57       sum1 = 0.d0
      58       k = 0
      59       do i = 1, norbs
      60         k = k + i
      61         a = pnew(k)
      62         sum1 = sum1 + a
      63         sa = Abs (a - p(k))
      64         if (sa > pl) then
      65           pl = sa
      66         end if
      67         if ( .not. extrap) then
      68           faca = faca + sa ** 2
      69           facb = facb + (a - 2.d0*p(k) + p1(i)) ** 2
      70         end if
      71         p1(i) = p(k)
      72         p(k) = a
      73       end do
      74       if (facb > 1.d-10 .and. faca < (100.d0*facb)) then
      75         fac = Sqrt (faca/facb)
      76       end if
      77       ie = 0
      78       sum2 = 0.d0
      79       do i = 1, norbs
      80         ii = i - 1
      81         do j = 1, ii
      82           ie = ie + 1
      83           a = pnew(ie)
      84           p(ie) = a + fac*(a-p(ie))
      85           pnew(ie) = p(ie)
      86         end do
      87         ie = ie + 1
      88         if (Abs (p(ie) - p1(i)) > damp) then
      89           p(ie) = p1(i) + Sign (damp, p(ie) - p1(i))
      90         else
      91           p(ie) = p(ie) + fac * (p(ie) - p1(i))
      92         end if
      93         p(ie) = Min (rhfuhf, Max (p(ie), 0.d0))
      94         sum2 = sum2 + p(ie)
      95         pnew(ie) = p(ie)
      96       end do
      97    !
      98    !   RE-NORMALIZE IF ANY DENSITY MATRIX ELEMENTS HAVE BEEN TRUNCATED
      99    !
     100       sum0 = sum1
     101       do
     102         if (sum2 > 1.d-3) then
     103           sum = sum1/sum2
     104         else
     105           sum = 0.d0
     106         end if
     107         sum1 = sum0
     108         if (sum2 < 1.d-3 .or. Abs (sum-1.d0) < 1.d-5) exit
     109         sum2 = 0.d0
     110         do i = 1, norbs
     111           j = (i*(i + 1))/2
     112            !
     113            !   ADD ON A SMALL NUMBER IN CASE AN OCCUPANCY IS EXACTLY ZE
 RO
 
 FORCHECK PC V13.5.13           CNVG           2021-03-24 10:59:30   page:   605
 cnvg.F90  /FF
 
     114            !
     115           p(j) = p(j)*sum + 1.d-20
     116           p(j) = Max (p(j), 0.d0)
     117            !
     118            !  SET UP RENORMALIZATION OVER PARTLY OCCUPIED M.O.'S ONLY.
  FULL M.O.'S
     119            !  CAN'T BE FILLED ANY MORE
     120            !
     121           if (p(j) > rhfuhf) then
     122             p(j) = rhfuhf
     123             sum1 = sum1 - rhfuhf
     124           else
     125             sum2 = sum2 + p(j)
     126           end if
     127           pnew(j) = p(j)
     128         end do
     129       end do
     130       end subroutine cnvg
 
