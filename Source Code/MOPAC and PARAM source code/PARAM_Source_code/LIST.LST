       1     subroutine getsym (locpar, idepfn, locdep, depmul)
       2     use molkst_C, only: natoms, ndep, moperr, id
       3     use chanel_C, only : iw, ir
       4     use common_arrays_C, only : na
       5     use molkst_C, only : line
       6    !
       7    !.. Implicit Declarations ..
       8     implicit none
       9    !
      10    !.. Formal Arguments ..
      11     integer, dimension (3*natoms), intent (inout) :: idepfn, locpar
      12     integer, dimension (3*natoms), intent (inout) :: locdep
      13     double precision, dimension (natoms), intent (out) :: depmul
      14 !**********************************************************************
 *
      15 !-----------------------------------------------
      16 !   I n t e r f a c e   B l o c k s
      17 !-----------------------------------------------
      18
      19
      20 !-----------------------------------------------
      21 !   L o c a l   V a r i a b l e s
      22 !-----------------------------------------------
      23       integer , dimension(100) :: ivalue
      24       integer :: n, nvalue, i, ll, j, l, nerror, n_used, i_sym(4)
      25       double precision :: sum
      26       double precision, dimension(100) :: value
      27       character , dimension(19) :: texti*60, textx*60
      28       character, dimension(19,2) :: text*60
      29       character, dimension(38) :: used*60
      30       logical :: ok, sym_pdb
      31
      32       save text, i_sym
      33 !-----------------------------------------------
      34
      35       equivalence (text(1,1), texti), (text(1,2), textx)
      36       data i_sym/3, 6, 8, 12/
      37       data texti/ &
      38         ' BOND LENGTH    IS SET EQUAL TO THE REFERENCE BOND LENGTH   ',
  &
      39         ' BOND ANGLE     IS SET EQUAL TO THE REFERENCE BOND ANGLE    ',
  &
      40         ' DIHEDRAL ANGLE IS SET EQUAL TO THE REFERENCE DIHEDRAL ANGLE',
  &
      41         ' DIHEDRAL ANGLE VARIES AS  90 DEGREES - REFERENCE DIHEDRAL  ',
  &
      42         ' DIHEDRAL ANGLE VARIES AS  90 DEGREES + REFERENCE DIHEDRAL  ',
  &
      43         ' DIHEDRAL ANGLE VARIES AS 120 DEGREES - REFERENCE DIHEDRAL  ',
  &
      44         ' DIHEDRAL ANGLE VARIES AS 120 DEGREES + REFERENCE DIHEDRAL  ',
  &
      45         ' DIHEDRAL ANGLE VARIES AS 180 DEGREES - REFERENCE DIHEDRAL  ',
  &
      46         ' DIHEDRAL ANGLE VARIES AS 180 DEGREES + REFERENCE DIHEDRAL  ',
  &
      47         ' DIHEDRAL ANGLE VARIES AS 240 DEGREES - REFERENCE DIHEDRAL  ',
  &
 
 FORCHECK PC V13.5.13          GETSYM          2021-03-24 10:59:30   page:   685
 getsym.F90  /FF
 
      48         ' DIHEDRAL ANGLE VARIES AS 240 DEGREES + REFERENCE DIHEDRAL  ',
  &
      49         ' DIHEDRAL ANGLE VARIES AS 270 DEGREES - REFERENCE DIHEDRAL  ',
  &
      50         ' DIHEDRAL ANGLE VARIES AS 270 DEGREES + REFERENCE DIHEDRAL  ',
  &
      51         ' DIHEDRAL ANGLE VARIES AS - REFERENCE DIHEDRAL              ',
  &
      52         ' BOND LENGTH VARIES AS HALF THE REFERENCE BOND LENGTH       ',
  &
      53         ' BOND ANGLE VARIES AS HALF THE REFERENCE BOND ANGLE         ',
  &
      54         ' BOND ANGLE VARIES AS 180 DEGREES - REFERENCE BOND ANGLE    ',
  &
      55         ' DO NOT USE - USE SYMMETY FUNCTION 19 INSTEAD               ',
  &
      56         ' BOND LENGTH IS A MULTIPLE OF THE REFERENCE BOND LENGTH     '/
      57       data textx/ &
      58         ' X COORDINATE IS SET EQUAL TO   THE REFERENCE X COORDINATE  ',
  &
      59         ' Y COORDINATE IS SET EQUAL TO   THE REFERENCE Y COORDINATE  ',
  &
      60         ' Z COORDINATE IS SET EQUAL TO   THE REFERENCE Z COORDINATE  ',
  &
      61         ' X COORDINATE IS SET EQUAL TO - THE REFERENCE X COORDINATE  ',
  &
      62         ' Y COORDINATE IS SET EQUAL TO - THE REFERENCE Y COORDINATE  ',
  &
      63         ' Z COORDINATE IS SET EQUAL TO - THE REFERENCE Z COORDINATE  ',
  &
      64         ' X COORDINATE IS SET EQUAL TO   THE REFERENCE Y COORDINATE  ',
  &
      65         ' Y COORDINATE IS SET EQUAL TO   THE REFERENCE Z COORDINATE  ',
  &
      66         ' Z COORDINATE IS SET EQUAL TO   THE REFERENCE X COORDINATE  ',
  &
      67         ' X COORDINATE IS SET EQUAL TO - THE REFERENCE Y COORDINATE  ',
  &
      68         ' Y COORDINATE IS SET EQUAL TO - THE REFERENCE Z COORDINATE  ',
  &
      69         ' Z COORDINATE IS SET EQUAL TO - THE REFERENCE X COORDINATE  ',
  &
      70         ' X COORDINATE IS SET EQUAL TO   THE REFERENCE Z COORDINATE  ',
  &
      71         ' Y COORDINATE IS SET EQUAL TO   THE REFERENCE X COORDINATE  ',
  &
      72         ' Z COORDINATE IS SET EQUAL TO   THE REFERENCE Y COORDINATE  ',
  &
      73         ' X COORDINATE IS SET EQUAL TO - THE REFERENCE Z COORDINATE  ',
  &
      74         ' Y COORDINATE IS SET EQUAL TO - THE REFERENCE X COORDINATE  ',
  &
      75         ' Z COORDINATE IS SET EQUAL TO - THE REFERENCE Y COORDINATE  ',
  &
      76         ' NOT USED                                                   '/
      77       n_used = 0
      78       nerror = 0
      79       sym_pdb = .false.
      80 !
 
 FORCHECK PC V13.5.13          GETSYM          2021-03-24 10:59:30   page:   686
 getsym.F90  /FF
 
      81 ! TITLE OUTPUT
      82 !
      83       write (iw, 10)
      84    10 format(/,/,/,20x,'PARAMETER DEPENDENCE DATA'/,/,&
      85         '        REFERENCE ATOM      FUNCTION NO.    DEPENDENT ATOM(S)'
 )
      86 !
      87 ! INPUT SYMMETRY : FUNCTION, REFERANCE PARAMETER, AND DEPENDENT ATOMS
      88 !
      89       n = 0
      90       if (ndep > 0) then
      91         j = 2
      92         do i = 1, ndep
      93           j = j + 1
      94           ivalue(j) = locdep(i)
      95           ok = (i == ndep)
      96           if (.not. ok) ok = (locpar(i) /= locpar(i + 1) .or. idepfn(i)
  /= idepfn(i + 1))
      97           if (ok) then
      98             write (iw, "(i13, i19, i16, 6 i5, 10(/, 43 x, 7 i5))") &
      99             locpar(i), idepfn(i), (ivalue(l), l=3, j)
     100             j = 2
     101           end if
     102         end do
     103         goto 90
     104       end if
     105       depmul(1) = 0.D0
     106    20 continue
     107       read (ir, '(A)', end=90) line
     108       call upcase(line, len_trim(line))
     109       do
     110         i =index(line, '"')
     111         if (i == 0) exit
     112         call txt_to_atom_no(line, i, .false.)
     113         call  l_control("CONTROL_SYM_in_PDB", len_trim("CONTROL_SYM_in_
 PDB"), 1)
     114         sym_pdb = .true.
     115         if (moperr) return
     116       end do
     117       call nuchar (line, len_trim(line), value, nvalue)
     118 !   INTEGER VALUES
     119       do i = 1, nvalue
     120         ivalue(i) = nint(value(i))
     121       end do
     122 !   FILL THE LOCDEP ARRAY
     123       if (nvalue==0 .or. Abs(value(3)) < 1.d-20) go to 90
     124       if (ivalue(2) == 19) then
     125         if (na(ivalue(1)) == 0) then
     126             !
     127             !  Not allowed: a Cartesian coordinate cannot use function
 19
     128             !
     129           write (iw,*) "Atom ", ivalue (1), " is Cartesian.  " // &
     130                      & "Function 19 cannot be used here."
     131           call mopend ("Error in Symmetry Data")
     132           return
     133         end if
     134         do i = 4, nvalue
     135           if (ivalue(i) == 0) exit
 
 FORCHECK PC V13.5.13          GETSYM          2021-03-24 10:59:30   page:   687
 getsym.F90  /FF
 
     136           ndep = ndep + 1
     137           locdep(ndep) = ivalue(i)
     138           locpar(ndep) = ivalue(1)
     139           idepfn(ndep) = 19
     140           n = n + 1
     141 !
     142 !  Check:  Is multiplier a square root of a rational ratio?
     143 !
     144           sum = value(3) ** 2
     145           do ll = 1, 4
     146             l = i_sym(ll)
     147             j = Nint (sum*l)
     148             if (Abs (j-sum*l) < l*1.d-4) then
     149               value(3) = Sqrt ((1.d0*j)/l)
     150               exit
     151             end if
     152           end do
     153           depmul(n) = value(3)
     154         end do
     155       else
     156         if (na(ivalue(1)) /= 0 .and. ivalue(2) == 18) then
     157             !
     158             !  Not allowed: an internal coordinate cannot use function
 18
     159             !
     160           write (iw,*) "Atom ", ivalue (1), " is internal.  " // &
     161                      & "Function 18 cannot be used here."
     162           call mopend ("Error in Symmetry Data")
     163           return
     164         end if
     165         do i = 3, nvalue
     166           if (ivalue(i) == 0) exit
     167           ndep = ndep + 1
     168           locdep(ndep) = ivalue(i)
     169           locpar(ndep) = ivalue(1)
     170           idepfn(ndep) = ivalue(2)
     171           if (ivalue(i) > natoms + id) then
     172             nerror = 1
     173           end if
     174         end do
     175       end if
     176       ll = i - 1
     177       if (ivalue(2) == 19) then
     178           write (iw,'(i13, i13, f13.8, i9, 6 i5, 10(/, 43 x, 7 i5))') &
     179           ivalue(1), ivalue(2), value(3), (ivalue(j), j=4, ll)
     180       else
     181         if (sym_pdb) then
     182           line = " "
     183           call atom_no_to_txt(ivalue(1), line(9:))
     184           write(line(len_trim(line) + 1:),'(i13)')ivalue(2)
     185           call atom_no_to_txt(ivalue(3), line(len_trim(line) + 11:))
     186           do j = 4, ll
     187             call atom_no_to_txt(ivalue(j), line(len_trim(line) + 2:))
     188           end do
     189           write(iw, '(a)')trim(line)
     190         else
     191           write (iw, "(i13, i19, i16, 6 i5, 10(/, 43 x, 7 i5))") ivalue
 (1), ivalue(2), (ivalue(j), j=3, ll)
     192         end if
 
 FORCHECK PC V13.5.13          GETSYM          2021-03-24 10:59:30   page:   688
 getsym.F90  /FF
 
     193       end if
     194       if (na(ivalue(1)) == 0) then
     195         i = 2
     196       else
     197         i = 1
     198       end if
     199       line = text(ivalue(2), i)
     200       do i = 1, n_used
     201         if (used(i) == line) exit
     202       end do
     203       if (i > n_used) then
     204         n_used = n_used + 1
     205         used(n_used) = line(:len_trim(line))
     206       end if
     207       if (nerror == 1) then
     208         call mopend("A SYMMETRY FUNCTION IS USED TO DEFINE A NON-EXISTE
 NT ATOM")
     209         return
     210       end if
     211     goto 20
     212 !
     213 ! CLEAN UP
     214    90 continue
     215       write (iw, 100)
     216   100 format(/,10x,'   DESCRIPTIONS OF THE FUNCTIONS USED')
     217       do j = 1, 18
     218         do i = 1, n_used
     219           if (used(i) == texti(j)) go to 120
     220         end do
     221         cycle
     222   120   continue
     223          write (iw, 130) j, used(i)
     224   130   format(i4,5x,a)
     225       end do
     226       do j = 1, 18
     227         do i = 1, n_used
     228           if (used(i) == textx(j)) go to 121
     229         end do
     230         cycle
     231   121   continue
     232          write (iw, 130) j, used(i)
     233       end do
     234       write(iw,*)
     235       return
     236       end subroutine getsym
 
