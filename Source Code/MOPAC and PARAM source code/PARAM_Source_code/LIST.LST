     858 subroutine special
     859 !
     860 !  Use this subroutine for any special work.
     861 !  for example, to print a MOPAC data-set.
     862 !
     863   use molkst_C, only : jobnam, refkey, line
     864   implicit none
     865   integer :: iprt = 33, i, j, k, len_key
     866   open(unit=iprt, file=jobnam(:len_trim(jobnam) - 0)//"_(PM6).arc", sta
 tus='UNKNOWN', position='asis', iostat = i)
     867   do i = 1, 6
     868     if (index(refkey(i), " NULL") /= 0) exit
     869     line = refkey(i)
     870     len_key = len_trim(refkey(i))
     871     call upcase(line, len_key)
     872 !
     873 !  Put all changes in keywords here
     874 !
     875     j = index(line, " 1SCF")
     876     if (j /= 0) refkey(i)(j:j + 4) = " "
     877     j = index(line, " PM6")
     878     if (j /= 0) refkey(i)(j:j + 3) = " "
     879     j = index(line, " DENOUT")
     880     if (j /= 0) refkey(i)(j:j + 7) = " "
     881     j = index(line, " GRADIENTS")
     882     if (j /= 0) refkey(i)(j:j + 9) = " "
     883     j = index(line, " GNORM=")
     884     if (j == 0) then
     885       j = index(line, "        ")
     886       refkey(i)(j:j+8) = " GNORM=4"
     887     end if
     888 !
     889 !  Remove all extra blank spaces
     890 !
     891     len_key = len_trim(refkey(i))
     892     refkey(i)(len_key + 1:len_key + 1) = "@"
     893     do j = 1, len_key
     894       do k = 1,10
     895         if (refkey(i)(j:j + 1) == "  ") refkey(i)(j:) = refkey(i)(j + 1
 :)
     896       end do
     897     end do
     898     j = index(refkey(i), "@")
     899     refkey(i)(j:) = " "
     900     j = index(refkey(i),"     ")
     901     refkey(i)(j:) = " PM6"
     902   end do
     903   write(iprt,"(a)")"  MOPAC2016"
     904   write(iprt,"(a)")" FINAL GEOMETRY OBTAINED"
     905   call geout (iprt)
     906 end subroutine special
 
