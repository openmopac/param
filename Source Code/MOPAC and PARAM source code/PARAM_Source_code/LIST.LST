     114     subroutine rectify_sequence()
     115     use common_arrays_C, only : geo, coord, txtatm, txtatm1, nat, label
 s, coorda
     116     use molkst_C, only: numat, pdb_label
     117     implicit none
     118 !
     119 !  Search atom sequence for the following structure:
     120 !  A break in a chain: same chain letter, but the residue sequence incr
 eases suddenly.
     121 !  After the increase, atoms of a residue in the same chain that are ou
 t-of-sequence are found.
     122 !
     123 ! If this situation occurs, move the out-of-sequence atoms to their cor
 rect place.
     124 !
     125 ! This should only be done if RESEQ or similar keyword is present.
     126 !
     127     integer :: i_lower, res2, res1, res3, res, ii, jj, num_min, num_max
     128     character :: chain1*1, chain2*1, chain*1, used(numat)*1
     129     double precision, external :: reada
     130     if (pdb_label) return
     131     txtatm1(:numat) = txtatm(:numat)
     132     coorda(:,:numat) = coord(:,:numat)
     133     used(:numat) = txtatm1(:numat)(22:22)
     134     used(1) = "a"
     135     labels(:numat) = nat(:numat)
     136     geo(:,:numat) = coord(:,:numat)
     137     res1 = nint(reada(txtatm(1), 23))
     138     chain1 = "a"
     139 !
     140 !  ii keeps track of the new numbering sequence
     141 !
     142     ii = 1
     143     do i_lower = 2, numat
     144       chain2 = used(i_lower)
     145       if (chain2 == "a") cycle           ! Atom already used
     146 !
     147 !   res1: Residue number of previous residue
     148 !   res2: Residue number of current residue
     149 !
     150       res2 = nint(reada(txtatm1(i_lower), 23))
     151 !
     152 ! Look for a fault at the end of the first bit of chain
     153 ! This will occur in atoms in the domain res1 to res1 + 1
     154 !
     155       do res3 = res1, res1 + 1
     156         num_min = max(i_lower - 50, 1)
     157         num_max = min(i_lower + 50, numat)
     158         do
     159           do jj = num_min, num_max
     160             res = nint(reada(txtatm1(jj), 23))
     161             chain = used(jj)
     162             if (res == res3 .and. chain == chain1 .and. used(jj) /= "a"
 ) exit
     163           end do
     164           if (jj > num_max) exit
     165           ii = ii + 1
     166           coord(:,ii) = geo(:,jj)
 
 FORCHECK PC V13.5.13     RECTIFY_SEQUENCE     2021-03-24 10:59:30   page:  4100
 geochk_bits_1.F90  /FF
 
     167           txtatm(ii) = txtatm1(jj)
     168           nat(ii) = labels(jj)
     169           used(jj) = "a"
     170         end do
     171       end do
     172 !
     173 ! Look for a fault at the start of the next bit of chain
     174 ! This will occur in atoms in the domain res2 - 1 to res2
     175 !
     176       do res3 = res2 - 1, res2
     177         num_min = max(i_lower - 50, 1)
     178         num_max = min(i_lower + 50, numat)
     179         do
     180           do jj = num_min, num_max
     181             res = nint(reada(txtatm1(jj), 23))
     182             chain = used(jj)
     183             if (res == res3 .and. chain == chain1 .and. used(jj) /= "a"
 ) exit
     184           end do
     185           if (jj > num_max) exit
     186           ii = ii + 1
     187           coord(:,ii) = geo(:,jj)
     188           txtatm(ii) = txtatm1(jj)
     189           nat(ii) = labels(jj)
     190           used(jj) = "a"
     191         end do
     192       end do
     193       chain1 = chain2
     194       res1 = res2
     195     end do
     196     if (ii < numat) then
     197       do jj = 1, numat
     198         if (used(jj) /= "a") then
     199           ii = ii + 1
     200           coord(:,ii) = geo(:,jj)
     201           txtatm(ii) = txtatm1(jj)
     202           nat(ii) = labels(jj)
     203           used(jj) = "a"
     204         end if
     205       end do
     206     end if
     207     return
     208   end subroutine rectify_sequence
 
