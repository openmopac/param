     569   Subroutine CPE_energy(Ene, Pot, C)
     570 !
     571 ! Evaluates the total energy due to CPE (chemical-potential equalizatio
 n)
     572 !
     573     use molkst_C, only : numat
     574     use Common_arrays_C, only : nat, coord, chrg
     575     use funcon_C, only : a0, eV, fpc_9
     576     USE parameters_C, only : CPE_Zeta
     577     implicit none
     578     double precision :: Pot(numat)! Effective monopolar potential corre
 ction to be mapped into the Fock matrix
     579     double precision :: C(3*numat)! Response dipole coefs (zxy)
     580     double precision :: Ene       ! Response energy contribution
     581 !
     582 !  Local variables
     583 !
     584     double precision, allocatable :: Crd_qm(:,:), Zeta_qm(:)
     585 !======================================================================
 =======
     586 !  Initialization
     587 !======================================================================
 =======
     588     allocate(Zeta_qm(numat), Crd_qm(3, numat))
     589     Crd_qm(:,:numat) = coord(:,:numat)/a0 !  Convert geometry from Angs
 troms to Bohrs
     590     Zeta_qm(:numat) = CPE_Zeta(nat(:numat))
     591 !======================================================================
 =======
     592 ! Initialization complete.  Now do the calculation.
     593 !======================================================================
 =======
     594     call CPE_QdepDipole_Contribution( numat, nat, Crd_qm, chrg, Zeta_qm
 , Ene, Pot, C)
     595 !
     596 !  Convert energy into kcal.mol^(-1), Pot and C into eV. (This works in
  MOPAC, but does not work "stand-alone")
     597 !
     598     Ene = Ene * eV*fpc_9
     599     Pot(:numat) = Pot(:numat)*eV
     600     C(:3*numat) = C(:3*numat)
     601     return
     602   end subroutine CPE_energy
 
