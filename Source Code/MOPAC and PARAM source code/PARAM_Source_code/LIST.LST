       1 subroutine delsta (nat, iorbs, p, cdi, dstat, ii, jj)
       2    !*******************************************************************
 ****
       3    !
    *
       4    !   DELSTA calculates the derivative of the energy WRT Cartesian
    *
       5    !   coordinates.  Called by DCART only.
    *
       6    ! On input: CDI:    The coordinates of the two atoms
    *
       7    !           P:      The density matrix (only the diagonal will be us
 ed *
       8    !           II,JJ:  The atom numbers
    *
       9    ! On exit:  DSTAT:  Derivatives (3 numbers)
    *
      10    !
    *
      11    !*******************************************************************
 ****
      12     use molkst_C, only: numat, mpack, cutofp
      13     use funcon_C, only: fpc_9, ev
      14     use parameters_C, only: tore
      15    !
      16    !.. Implicit Declarations ..
      17     implicit none
      18    !
      19    !.. Formal Arguments ..
      20     integer, intent (in) :: ii, jj
      21     integer, dimension (numat), intent (in) :: iorbs, nat
      22     double precision, dimension (3), intent (out) :: dstat
      23     double precision, dimension (mpack), intent (in) :: p
      24     double precision, dimension (3, 2), intent (in) :: cdi
      25    !
      26    !.. Local Scalars ..
      27     integer :: k, l
      28     double precision :: qii, qjj, rij, sum
      29    !
      30    !.. Local Arrays ..
      31     double precision, dimension (3) :: vect
      32     integer, external :: ijbo
      33    !
      34    !.. Intrinsic Functions ..
      35     intrinsic Sqrt
      36    !
      37    ! ... Executable Statements ...
      38    !
      39     qii = tore(nat(ii))
      40     l = ijbo (ii, ii)
      41     do k = 1, iorbs(ii)
      42       l = l + k
      43       qii = qii - p(l)
      44     end do
      45     qjj = tore(nat(jj))
      46     l = ijbo (jj, jj)
      47     do k = 1, iorbs(jj)
      48       l = l + k
 
 FORCHECK PC V13.5.13          DELSTA          2021-03-24 10:59:30   page:  3956
 delsta.F90  /FF
 
      49       qjj = qjj - p(l)
      50     end do
      51     rij = Sqrt ((cdi(1, 1)-cdi(1, 2))**2+ (cdi(2, 1)-cdi(2, 2))**2+ (cd
 i(3, &
      52    & 1)-cdi(3, 2))**2)
      53     if (rij > cutofp) then
      54       do k = 1, 3
      55         dstat(k) = 0.d0
      56       end do
      57     else
      58       do k = 1, 3
      59         vect(k) = (cdi(k, 1)-cdi(k, 2)) / rij
      60       end do
      61       !
      62       !   This component of the derivative has an electrostatic term on
 ly
      63       !
      64       sum = fpc_9 * ev / rij ** 2
      65       do k = 1, 3
      66         dstat(k) = -0.5d0 * qjj * qii * sum * vect(k)
      67       end do
      68     end if
      69 end subroutine delsta
 
