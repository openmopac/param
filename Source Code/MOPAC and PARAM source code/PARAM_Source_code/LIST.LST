     119    !   DIVIDE AVAILABLE SPACE EQUALLY AMONG THE LMO'S
     120    !
     121     ispace = (n01-ln) / nmos_loc
     122     jspace = (n02-mn) / nmos_loc
     123    !
     124    !   LN     = Highest address in IC used
     125    !            (the end of the compressed LMOs)
     126    !   LN/NMOS= Average number of atoms in a LMO.
     127    !   ISPACE = Average amount of free space that LMOs can expand into.
     128    !
     129    !   Is there enough space for LMOs to expand?  If not, stop the run
     130    !
     131    !  In order to ensure that the next annihilation step can be run,
     132    !  the amount of storage for each LMO, (LN/NMOS+ISPACE), should be
     133    !  more than NUMAT, or ISPACE must be greater than the larger of
     134    !  20% of the available space and 20. That is, there must be at leas
 t
     135    !  20% unused space for a LMO to expand into.
     136    !
     137     i = n01 / nmos_loc
     138     if (i + ispace < numat .and. ispace < Max (i/5, 20)) then
     139       call pinout (1, .false.)
     140   !    write (iw, "(/,A,/,A,I8)") &
     141   !   & " There is not enough unused space left to ensure ", &
     142   !   & " that the next iteration can be done.  New memory being alloca
 ted:", &
     143   !   & Nint (n01*0.2)
     144       moperr = .true.
     145       return
     146     end if
     147     if (ispace > numat .and. jspace > nmos_loc) then
     148       !
     149       !   There is more than enough space to guarantee that every LMO c
 an
     150       !   be filled completely, therefore:
     151       ispace = 0
     152       jspace = 0
     153       if (debug) then
     154         write (iw, "(6(A,I5))") " MAX.:", momax, " MIN.:", momin, " AVE
 . IC:", &
     155        & ln / nmos_loc, " AVE. C:", mn / nmos_loc
     156       end if
     157     else if (debug) then
     158       write (iw, "(6(A,I5))") " MAX.:", momax, " MIN.:", momin, " AVE.
 IC:", &
     159            & ln / nmos_loc, " AVE. C:", mn / nmos_loc, " FREE IC:", &
     160            & ispace, " FREE C:", jspace
     161     end if
     162     jtop = n01
     163     mtop = n02
     164     jsav = n01 - ln - ispace * nmos_loc
     165     msav = n02 - mn - jspace * nmos_loc
     166     do i = nmos_loc, 2, -1
 
 FORCHECK PC V13.5.13           TIDY           2021-03-24 10:59:30   page:   680
 tidy.F90  /FF
 
     167       j = Min (nc(i)+ispace, numat)
     168       if (j < nc(i)+ispace) then
     169          !
     170          !   Some space is unused - save it for later
     171          !
     172         jsav = jsav + nc(i) + ispace - j
     173         jtop = jtop - j
     174       else
     175          !
     176          !  USE UP SOME OF THE SAVED SPACE
     177          !
     178         jdash = Min (numat, Max (jsav, 0)+j)
     179         jtop = jtop - jdash
     180         jsav = jsav - jdash + j
     181       end if
     182       l = nnc_loc(i)
     183       nnc_loc(i) = jtop
     184       do k = nc(i), 1, -1
     185         ic(jtop+k) = ic(l+k)
     186       end do
     187       n = iused(i) - iused(i-1)
     188       j = Min (n+jspace, norbs)
     189       if (j < n+jspace) then
     190          !
     191          !   Some space is unused - save it for later
     192          !
     193         msav = msav + n + jspace - j
     194         mtop = mtop - j
     195       else
     196          !
     197          !  USE UP SOME OF THE SAVED SPACE
     198          !
     199         mdash = Min (norbs, Max (msav, 0)+j)
     200         mtop = mtop - mdash
     201         msav = msav - mdash + j
     202       end if
     203       ncmo(i) = mtop
     204       do k = n, 1, -1
     205         c(k+mtop) = c(k+iused(i-1))
     206       end do
     207     end do
     208     if (debug .and. large) then
     209       !
     210       !   PRINT ADDRESSES SET UP BY TIDY
     211       !
     212       write (iw,*) " ADDRESSES IN TIDY"
     213       write (iw, "(A)") "               NNC       NC     NCMO "
     214       do i = 1, nmos_loc
     215         write (iw, "(7I9)") i, nnc_loc (i), nc (i), ncmo (i)
     216       end do
     217       write (iw,*) " Contents of IC"
     218       do i = 1, nmos_loc
     219         write (iw, "(I4,I7,18I4,10(/,I11,18I4))") i, (ic(j), j=nnc_loc(
 i)+1, &
     220        & nnc_loc(i)+nc(i))
     221       end do
     222     end if
     223     if (mode == 2) then
     224       nmol = numcal
 
 FORCHECK PC V13.5.13           TIDY           2021-03-24 10:59:30   page:   681
 tidy.F90  /FF
 
     225     end if
     226    !
     227     deallocate (iused, jused, kused, lused)
     228 100 continue
     229 end subroutine tidy
 
