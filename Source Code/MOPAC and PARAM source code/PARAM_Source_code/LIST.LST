       1  subroutine getpar()
       2 !**********************************************************************
       3 !
       4 !   GETPAR 1: Reads in any reference parameters from a previous run.
       5 !          2: Reads in the list of parameters to be optimized.
       6 !
       7 !**********************************************************************
       8     use param_global_C, only : valvar, valold, toplim, botlim,  &
       9     numvar, ifiles_8, locked, contrl, &
      10     maxpms, locvar
      11     use chanel_C, only: iw, ir
