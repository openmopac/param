       1       subroutine perm(iperm, nels, nmos, nperms, limci)
       2       use meci_C, only : maxci
       3       implicit none
       4 !-----------------------------------------------
       5 !   D u m m y   A r g u m e n t s
       6 !-----------------------------------------------
       7       integer , intent(in) :: nels
       8       integer , intent(in) :: nmos
       9       integer , intent(inout) :: nperms
      10       integer , intent(in) :: limci
      11       integer , intent(inout) :: iperm(nmos,maxci*4)
      12 !-----------------------------------------------
      13 !   L o c a l   V a r i a b l e s
      14 !-----------------------------------------------
      15       integer :: Upper, Lower, Prm, El, i
      16       integer, dimension (:), allocatable :: Occ
      17 !-----------------------------------------------
      18 !**********************************************************************
 *
      19 !
      20 !  PERM PERMUTES NELS ENTITIES AMONG NMOS LOCATIONS. THE ENTITIES AND
      21 !       LOCATIONS ARE EACH INDISTINGUISHABLE. THE PAULI EXCLUSION
      22 !       PRINCIPLE IS FOLLOWED. THE NUMBER OF STATES PRODUCED IS GIVEN
      23 !       BY NMOS!/(NELS!*(NMOS-NELS)!).
      24 ! ON INPUT: NELS  = NUMBER OF INDISTINGUISHABLE ENTITIES
      25 !           NMOS  = NUMBER OF INDISTINGUISHABLE LOCATIONS
      26 !
      27 ! ON OUTPUT IPERM = ARRAY OF PERMUTATIONS, A 0 INDICATES NO ENTITY,
      28 !                   A 1 INDICATES AN ENTITY.
      29 !           NPERM = NUMBER OF PERMUTATIONS.
      30 !
      31 !**********************************************************************
 *
      32     Upper = nmos - nels
      33     Lower = 1
      34     Prm = 1
      35     El = nels
      36     allocate (Occ(-1:nels))
      37 !
      38 !  Occ initially contains the upper bounds that the various electrons
      39 !  can go to.  Thus electron 1 can end up in M.O. "nmos",
      40 !  and electron "nels-1" will end up in M.O. "nmos-nels".
      41 !
      42     Occ(-1:nels-1) = (/(nmos+1-i, i=-1, nels-1) /)
      43 !
      44 !  For electron "El", the starting position is "1".
      45 !
      46     call rperm (iperm, nperms, nels, Occ, Lower, Upper, El, limci)
      47     nperms = Prm-1
      48     deallocate (Occ)
      49   contains
 
 FORCHECK PC V13.5.13  CVF compiler emulation  2021-03-24 10:59:30   page:   502
 perm.F90  /FF


      50     recursive subroutine rperm (iperm, nperms, nels, Occ, Lower, Upper,
  &
      51          & El, limci)
      52       use meci_C, only: nmos
      53     implicit none
      54       integer, intent (in) :: nperms, nels, limci
      55       integer, intent (in) :: Lower, Upper
      56       integer  :: El
      57       integer, dimension (-1:nels), intent(inout) :: Occ
      58       integer, dimension (nmos, nperms), intent(inout) :: iperm
      59       integer :: i, j, k
      60       if (El /= 0) then
      61         do j = Lower, Upper
      62           Occ(El) = j
      63           call rperm (iperm, nperms, nels, Occ, Occ(El)+1, Occ(El-2)-2,
  &
      64                & El-1, limci)
      65         end do
      66 !
      67 !  "do" loop is complete.  Now add in the final permutation.
      68 !  (This is the reason for the second "-2" in "Occ(El-2)-2" in the call
  above.)
      69 !
      70         Occ(El) = Upper + 1
      71 !
      72 !  Simplest test for exit - is the electron in an unacceptable M.O.,
      73 !  or have all the permutations been calculated.
      74 !
      75         if (Upper+1 > nmos .or. Prm > nperms) return
      76       end if
      77 !
      78 !  Generate the permutation.
      79 !
      80       iperm(1:nmos, Prm) = 0
      81       do i = 1, nels
      82         iperm(Occ(i), Prm) = 1
      83       end do
      84       ! This statement only has an effect during the first call to rper
 m
      85       El = nels + 1
      86 !
      87 !   Eliminate microstates which are not allowed by "limci".
      88 !
      89       if (limci /= 0 .and. Prm > 1) then
      90         k = 0
      91         do j = 1, nmos
      92           k = k + Abs (iperm(j, Prm)-iperm(j, 1))
      93         end do
      94         if (k > limci) then
      95           Prm = Prm - 1
      96         end if
      97       end if
      98       Prm = Prm + 1
      99       return
     100     end subroutine rperm
 
