       1 module to_screen_C
       2 !
       3 !  This module contains all the quantities relating to the system being
  calculated
       4 !  that are likely to be used in the subroutine "to_screen".
       5 !
       6   double precision :: &
       7   rot(3), &    ! Type          Rotational constants
       8                ! Definition    Frequencies of the three rotational cons
 tants
       9                ! Units         cm**(-1)
      10                ! Min inclusive 0.0
      11                ! Max inclusive no limit
      12                !
      13   xyzmom(3), & ! Type          Principal moments of inertia
      14                ! Definition    Moments of inertia for the system.
      15                ! Units         10**(-40)*gram-cm**2
      16                ! Min inclusive 0.0
      17                ! Max inclusive no limit
      18                !
      19   dip(4,3)     ! Type          Dipole moment array
      20                ! Definition    Point-charge and hybrid components of di
 pole in X, Y, and Z, and totals
      21                ! Units         Debye
      22                !
      23   double precision, dimension (:,:), allocatable :: &
      24   fcint,     & ! Type          Internal force constants
      25                ! Definition    Force constants for all coordinates of a
 ll atoms, using the coordinate system supplied
      26                ! Units         Millidynes/Angstrom and millidynes per r
 adian
      27                !
      28   to_a,      & ! Type          Generic two-dimensional matrix
      29                ! Definition    Used for transferring matrix "a" in mato
 u1 to here
      30                ! Units         Unknown
      31   redmas       ! Type          Reduced masses
      32                ! Definition    Effective mass of vibrational frequencie
 s
      33                ! Units         Atomic mass units (amu)
      34                !
      35   double precision, dimension (:), allocatable :: &
      36   dipt,      & ! Type          Transition dipoles for vibrational frequ
 encies
      37                ! Definition    <ground state|eR(x)|vibrational state>
      38                ! Units         electrons
      39 force_const, & ! Type          Force constant
      40                ! Definition    Force constant for of vibrational freque
 ncies
      41                ! Units         millidynes per Angstrom
      42                !
      43   travel,    & ! Type          Distance traveled during a vibration
      44                ! Definition
      45                ! Units         Angstroms
      46   freq,      & ! Type          Vibrational frequencies
      47                ! Definition    Normal mode frequencies
      48                ! Units         cm(-1)
      49
 
