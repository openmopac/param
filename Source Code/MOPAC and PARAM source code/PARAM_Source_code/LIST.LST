    2522   subroutine reset_breaks
    2523     use molkst_C,  only : numat, nbreaks, line, keywrd
    2524     use common_arrays_C,  only : coord, txtatm, break_coords, breaks
    2525     use chanel_C, only : iw
    2526     implicit none
    2527     integer :: i, j, k, l
    2528     double precision :: sum
    2529     logical :: first = .true.
    2530     double precision, external :: reada
    2531     save :: first
    2532 !
    2533 ! Re-set "breaks" - they move when RESEQ or ADD_H is called
    2534 !
    2535       do nbreaks = 1, 50
    2536         numat_loop: do j = 1, numat
    2537           sum = abs(coord(1,j) - break_coords(1,nbreaks)) + &
    2538                 abs(coord(2,j) - break_coords(2,nbreaks)) + &
    2539                 abs(coord(3,j) - break_coords(3,nbreaks))
    2540           if (sum < 0.1d0) then
    2541             exit numat_loop
    2542           end if
    2543         end do numat_loop
    2544         if (j > numat) exit
    2545   !
    2546   !  Now move to the end of the residue
    2547   !
    2548         line = txtatm(j)(23:)
    2549         k = nint(reada(line,1))
    2550         do
    2551           j = j + 1
    2552           if (j > numat) exit
    2553           line = txtatm(j)(23:)
    2554           l = nint(reada(line,1))
    2555           if (l /= k) exit
    2556         end do
    2557         breaks(nbreaks) = j - 1
    2558       end do
    2559 !
    2560 !  Sequence breaks into increasing order
    2561 !
    2562       j = 1
    2563       nbreaks = nbreaks - 1
    2564       do i = 1, nbreaks
    2565         l = breaks(i)
    2566         do k = i + 1, nbreaks
    2567           if (breaks(k) < l) then
    2568             breaks(i) = breaks(k)
    2569             breaks(k) = l
    2570             l = breaks(i)
    2571           end if
    2572         end do
    2573         if (i > 1) then
    2574           if (breaks(i) /= breaks(i - 1)) then
    2575             j = j + 1
    2576             breaks(j) = breaks(i)
    2577           end if
    2578         end if
    2579       end do
 
 FORCHECK PC V13.5.13       RESET_BREAKS       2021-03-24 10:59:30   page:   787
 add_hydrogen_atoms.F90  /FF
 
    2580       nbreaks = j
    2581       breaks(nbreaks + 1) = 0
    2582 !
    2583 !  The following block is probably never used - delete it sometime (not
 e date: 12/6/2015)
    2584 !
    2585       if (index(keywrd, " NORES") == 0) then
    2586         do i = 1, nbreaks
    2587           do j = i + 1, nbreaks
    2588             if (breaks(j) < breaks(i)) then
    2589               if (first .and. index(keywrd, "GEO-OK") == 0) then
    2590                 first = .false.
    2591 !
    2592 !   An entire block has moved, so the breaks are no longer valid
    2593 !
    2594 !   Print a warning and quit
    2595 !
    2596                 call mopend("WARNING: After RESEQ, PDB ""TER"" location
 s are incorrect")
    2597                 write(iw,'(5x,a)')" To correct this error, edit the dat
 a set or PDB file"// &
    2598                 " or add keyword NORESEQ"
    2599                 write(iw,'(5x,a)')" To suppress this error, add ""GEO-O
 K"" to the keywords"
    2600               end if
    2601             end if
    2602           end do
    2603         end do
    2604       end if
    2605       j = 1
    2606       do i = 2, nbreaks
    2607         if (breaks(i) - breaks(i - 1) > 0) then
    2608           j = j + 1
    2609           breaks(j) = breaks(i)
    2610         end if
    2611       end do
    2612       nbreaks = j
    2613       breaks(nbreaks + 1) = 0
    2614       j = 1
    2615       do i = 1, numat
    2616         write(line,'(a6,i5,a)')txtatm(i)(:6),i + j - 1,txtatm(i)(12:)
    2617         txtatm(i) = trim(line)
    2618         if (i == breaks(j)) j = j + 1
    2619       end do
    2620   end subroutine reset_breaks
 
