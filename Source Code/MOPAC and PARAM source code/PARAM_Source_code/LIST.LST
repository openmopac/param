     597 subroutine compare_sequence(n_new)
     598 !
     599 !  Compare calculated residue with residue name from data-set
     600 !  and print any differences
     601 !
     602   use common_arrays_C, only : txtatm, txtatm1, nat, chains, breaks
     603   use molkst_C, only: numat, line, maxtxt, keywrd
     604   use MOZYME_C, only : tyr, tyres
