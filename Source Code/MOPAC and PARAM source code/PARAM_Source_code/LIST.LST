     186       r0ab(4, 1)  =  5.75705004325974d0
     187       r0ab(4, 2)  =  5.42861568913110d0
     188       r0ab(4, 3)  =  5.22773805284199d0
     189       r0ab(4, 4)  =  6.61725321392116d0
     190       r0ab(5, 1)  =  5.49040984445458d0
     191       r0ab(5, 2)  =  5.44335574472965d0
     192       r0ab(5, 3)  =  5.16462109512098d0
     193       r0ab(5, 4)  =  6.27011084754718d0
     194       r0ab(5, 5)  =  6.25631558644032d0
     195       r0ab(6, 1)  =  5.28216218036620d0
     196       r0ab(6, 2)  =  5.18862031695641d0
     197       r0ab(6, 3)  =  5.07977251245376d0
     198       r0ab(6, 4)  =  6.03124949908998d0
     199       r0ab(6, 5)  =  5.95698288505716d0
     200       r0ab(6, 6)  =  5.86684309279986d0
     201       do i  =  1, 6
     202          do j  =  1, i
     203             r0ab(j, i)  =  r0ab(i, j)
     204          end do
     205       end do
     206       r0ab  =  r0ab*shortcutscale
     207
     208 ! count HBs for allocate
     209       nhb  =  0
     210       do i  =  1, n-1
     211          if (at(i) == 7 .or. at(i) == 8 .or. at(i) == 9 .or. at(i) == 1
 5 .or. at(i) == 16 .or. at(i) == 17)then
 
 FORCHECK PC V13.5.13         HBSIMPLE         2021-03-24 10:59:30   page:  2004
