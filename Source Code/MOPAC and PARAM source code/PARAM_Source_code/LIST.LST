       1       subroutine xyzint(xyz, numat, na, nb, nc, degree, geo)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use funcon_C, only : pi
       6 !-----------------------------------------------
       7 !   I n t e r f a c e   B l o c k s
       8 !-----------------------------------------------
       9       implicit none
      10 !-----------------------------------------------
      11 !   D u m m y   A r g u m e n t s
      12 !-----------------------------------------------
      13       double precision  :: degree
      14       integer :: numat
      15       integer  :: na(numat)
      16       integer  :: nb(numat)
      17       integer  :: nc(numat)
      18       double precision  :: xyz(3,numat)
      19       double precision  :: geo(3,numat)
      20 !-----------------------------------------------
      21 !   L o c a l   V a r i a b l e s
      22 !-----------------------------------------------
      23       integer :: i, j, im1, k, l
      24       double precision :: sum, r
      25 !-----------------------------------------------
      26 !**********************************************************************
      27 !
      28 ! XYZINT WORKS OUT THE INTERNAL COORDINATES OF A MOLECULE.
      29 !        THE "RULES" FOR THE CONNECTIVITY ARE AS FOLLOWS:
      30 !        ATOM I IS DEFINED AS BEING AT A DISTANCE FROM THE NEAREST
      31 !        ATOM J, ATOM J ALREADY HAVING BEEN DEFINED.
      32 !        ATOM I MAKES AN ANGLE WITH ATOM J AND THE ATOM K, WHICH HAS
      33 !        ALREADY BEEN DEFINED, AND IS THE NEAREST ATOM TO J
      34 !        ATOM I MAKES A DIHEDRAL ANGLE WITH ATOMS J, K, AND L. L HAVING
      35 !        BEEN DEFINED AND IS THE NEAREST ATOM TO K, AND J, K AND L
      36 !        HAVE A CONTAINED ANGLE IN THE RANGE 15 TO 165 DEGREES,
      37 !        IF POSSIBLE.
      38 !
      39 !        IF(NA(2).EQ.1 THEN THE ORIGINAL CONNECTIVITY IS USED.
      40 !
      41 !        NOTE THAT GEO AND XYZ MUST NOT BE THE SAME IN THE CALL.
      42 !
      43 !   ON INPUT XYZ    = CARTESIAN ARRAY OF NUMAT ATOMS
      44 !            DEGREE = 1 IF ANGLES ARE TO BE IN RADIANS
      45 !            DEGREE = 57.29578 IF ANGLES ARE TO BE IN DEGREES
      46 !
      47 !**********************************************************************
      48 !
      49 !  Use original connectivity, if present
      50 !
      51         geo = 0.d0
      52         do i = 1, numat
      53           im1 = i - 1
      54           j = na(i)
      55           if (j == 0) then
      56             na(i) = 2
      57             nb(i) = 3
      58             nc(i) = 4
 
 FORCHECK PC V13.5.13          XYZINT          2021-03-24 10:59:30   page:  3952
 xyzint.F90  /FF
 
      59             if (i == 1) cycle
      60             sum = 1.d30
      61             do j = 1, im1
      62               r = (xyz(1,i) - xyz(1,j))**2 + (xyz(2,i) - xyz(2,j))**2 +
  (xyz(3,i) - xyz(3,j))**2
      63               if (.not.(r < sum .and. na(j) /= j .and. nb(j) /=j )) cyc
 le
      64               sum = r
      65               k = j
      66             end do
      67   !
      68   !   ATOM I IS NEAREST TO ATOM K
      69   !
      70             na(i) = k
      71             j = k
      72             if (i > 2) nb(i) = na(k)
      73             nc(i) = nb(k)
      74 !
      75 !   FIND ANY ATOM TO RELATE TO NA(I)
      76 !
      77           end if
      78           if (i > 3) then
      79 !
      80 !  Check that the angle na(i) - nb(i) - nc(i) is meaningful
      81 !
      82             call bangle (xyz, na(i), nb(i), nc(i), sum)
      83             if (sum < 1.d-2 .or. Abs(pi - sum) < 1.d-2) then
      84 !
      85 !  Angle is zero or 180 degrees.  Search for an atom nearest to 90 degr
 ees
      86 !
      87               r = 2.d0
      88               l = 0
      89               do k = 1, im1
      90                 if (k == na(i) .or. k == nb(i)) cycle
      91                 call bangle (xyz, na(i), nb(i), k, sum)
      92                 if (Abs(pi*0.5d0 - sum)  < r) then
      93                   r =  Abs(pi*0.5d0 - sum)
      94                   l = k
      95                   end if
      96                   if (r < 0.5d0) exit ! angle is acceptable
      97               end do
      98               nc(i) = l
      99             end if
     100             call dihed (xyz, i, j, nb(i), nc(i), geo(3,i))
     101           end if
     102           geo(3,i) = geo(3,i)*degree
     103           if (i > 2) call bangle (xyz, i, j, nb(i), geo(2,i))
     104           geo(2,i) = geo(2,i)*degree
     105           geo(1,i) = sqrt((xyz(1,i)-xyz(1,j))**2 + &
     106                           (xyz(2,i)-xyz(2,j))**2 + &
     107                           (xyz(3,i)-xyz(3,j))**2)
     108         end do
     109         na(1) = 0
     110         nb(1) = 0
     111         nc(1) = 0
     112         if (numat > 1) then
     113           nb(2) = 0
     114           nc(2) = 0
 
 FORCHECK PC V13.5.13          XYZINT          2021-03-24 10:59:30   page:  3953
 xyzint.F90  /FF
 
     115           if (numat > 2) nc(3) = 0
     116           na(2) = 1
     117         end if
     118         return
     119       end subroutine xyzint
 
