     422 !     *****************************************************************
 ********
     423
     424       subroutine aux (pp, tt)
     425
     426 !     this subroutine calculates a and b fns. for molecular integrals.
     427 !     b - fns. of argument pp*tt and with indices of 0 to ix, a fns. of
     428 !     argument pp and indices from 0 to ix.
     429 ! **  references:
     430 ! **  (a) mullikan/rieke/orloff/orloff (1949) jcp 17, 1248;
     431 ! **      pp (= p or = rho) = 1/2*[mu(a) + mu(b)]*r/a(h)
     432 ! **      tt (= t or = tau) = [mu(a) - mu(b)]/[mu(a) + mu(b)]
     433 ! **  (b) kotani/amemiya/simose (1940) proc. phys. mat. soc. japan 22,
 1
     434
     435       use reimers_C, only : a, b
     436       implicit none
     437 !      implicit          double precision :: (a - h, o - z)
     438       double precision ::  pp, tt, upplim, zero, one, two, &
     439                         c, d, h, r, t, ra, rho2, tr
     440       integer ::           i, j, k, il, in, ir, is, ix, ixm, ixs, jy
     441
     442       data upplim       /1.0D36/
     443       data zero, one, two /0.0d0, 1.0d0, 2.d0/
     444
     445         ix = 32
     446         rho2 = pp*tt
     447         ir = int(abs(rho2 + rho2))
     448         if (ir > 170) go to 100
     449         is = min0(ir + 1, 15)
     450 !
     451 !     first the more difficult b - fn.
     452 !
     453         if (dabs(rho2) <  1.d-3) go to 35
     454            if (pp > 40.0d0) go to 100
     455               d = dexp(rho2)
     456               h = dexp(- rho2)
     457               r = d-h
     458 !
     459 !     if the value of rho is too small the sinh must be obtained by
     460 !     summing the infinite series rather than by addition of two
     461 !     exponentials
     462 !
     463         if (dabs(r) - 1.d-1 >= 0.d0) go to 28
     464            ra = zero
     465            t = rho2
     466               do 27 i = 2, 25
     467               if (dabs(t) < 1.d-18) go to 127
     468               t = t*rho2*rho2/dfloat((i + i - 1)*(i + i - 2))
     469               ra = ra + t
     470 27            continue
     471 127     continue
     472         r = (ra + rho2)*two
     473 28      b(1) = r/rho2
     474 !
     475 !     as many successive b functions are generated from b(0) by the
