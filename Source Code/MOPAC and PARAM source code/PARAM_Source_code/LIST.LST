       1 subroutine fock1(f, ptot, pa, mpack, w, kr, ia, ib, ilim)
       2         implicit none
       3         integer, intent (in) :: ia, ib, ilim, mpack
       4         integer, intent (inout) :: kr
       5         double precision, dimension (mpack), intent (in) :: pa, ptot
       6         double precision, dimension (mpack), intent (inout) :: f
       7         double precision, dimension (ilim, ilim), intent (in) :: w
       8         integer :: i, ij, ijp, ijw, ikw, im, ip, iw, j, jlw, jm, jp, jw
 , k, klw, &
       9        & kw, l, lw
      10         double precision :: sum
      11         intrinsic Max, Min
      12   ! *******************************************************************
 **
      13   !
      14   ! *** COMPUTE THE REMAINING CONTRIBUTIONS TO THE ONE-CENTER ELEMENTS.
      15   !
      16   ! *******************************************************************
 **
      17   !
      18   !   One-center coulomb and exchange terms for atom II.
      19   !
      20   !  F(i,j)=F(i,j)+sum(k,l)((PA(k,l)+PB(k,l))*<i,j|k,l>
      21   !                        -(PA(k,l)        )*<i,k|j,l>), k,l on atom I
 I.
      22   !
      23         do i = ia, ib
      24           iw = i - ia + 1
      25           do j = ia, i
      26             jw = j - ia + 1
      27              !
      28              !    Address in 'F'
      29              !
      30             ij = (i*(i - 1))/2 + j
      31              !
      32              !    'J' Address IJ in W
      33              !
      34             ijw = (iw*(iw - 1))/2 + jw
      35             sum = 0.d0
      36             do k = ia, ib
      37               kw = k - ia + 1
      38               do l = ia, ib
      39                 lw = l - ia + 1
      40                 ip = Max (k, l)
      41                 jp = Min (k, l)
      42                    !
      43                    !    Address in 'P'
      44                    !
      45                 ijp = (ip*(ip - 1))/2 + jp
      46                    !
      47                    !    'J' Address KL in W
      48                    !
      49                 im = Max (kw, lw)
      50                 jm = Min (kw, lw)
      51                 klw = (im*(im - 1))/2 + jm
      52                    !
      53                    !    'K' Address IK in W
      54                    !
 
 FORCHECK PC V13.5.13          FOCK1           2021-03-24 10:59:30   page:  1174
 fock1.F90  /FF
 
      55                 im = Max (kw, jw)
      56                 jm = Min (kw, jw)
      57                 ikw = (im*(im - 1))/2 + jm
      58                    !
      59                    !    'K' Address JL in W
      60                    !
      61                 im = Max (lw, iw)
      62                 jm = Min (lw, iw)
      63                 jlw = (im*(im - 1))/2 + jm
      64                    !
      65                    !   The term itself
      66                    !
      67                 sum = sum + ptot(ijp) * w(ijw, klw) - pa(ijp) * w(ikw,
 jlw)
      68               end do
      69             end do
      70             f(ij) = f(ij) + sum
      71           end do
      72         end do
      73         kr = kr + ilim**2
      74 end subroutine fock1
 
