       1       double precision function reada (string, istart)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5 !-----------------------------------------------
       6 !   I n t e r f a c e   B l o c k s
       7 !-----------------------------------------------
       8       implicit none
       9 !-----------------------------------------------
      10 !   D u m m y   A r g u m e n t s
      11 !-----------------------------------------------
      12       integer , intent(in) :: istart
      13       character  :: string*(*)
      14 !-----------------------------------------------
      15 !   L o c a l   V a r i a b l e s
      16 !-----------------------------------------------
      17       integer :: i0, i9, idot, ineg, ipos, icapd, icape, ismld, ismle,
 l, i, &
      18         iadd, n, j
      19       logical :: expnnt
      20       double precision, external :: digit
      21 !-----------------------------------------------
      22 !     FORTRAN FUNCTION TO EXTRACT NUMBER FROM STRING
      23 !
      24 !
      25 !     DEFINE ASCII VALUES OF NUMERIC FIELD CHARACTERS
      26       i0 = ichar('0')
      27       i9 = ichar('9')
      28       idot = ichar('.')
      29       ineg = ichar('-')
      30       ipos = ichar('+')
      31       icapd = ichar('D')
      32       icape = ichar('E')
      33       ismld = ichar('d')
      34       ismle = ichar('e')
      35 !
      36       l = len(string)
      37 !
      38 !     FIND THE START OF THE NUMERIC FIELD
      39       do i = istart, l
      40         iadd = 0
      41         n = ichar(string(i:i))
      42 !
      43 !       SIGNAL START OF NUMERIC FIELD IF DIGIT FOUND
      44         if (n>=i0 .and. n<=i9) go to 20
      45 !
      46 !       ACCOUNT FOR CONSECUTIVE SIGNS [- AND(OR) +]
      47         if (n==ineg .or. n==ipos) then
      48           iadd = iadd + 1
      49           if (i + iadd > l) go to 50
      50           n = ichar(string(i+iadd:i+iadd))
      51           if (n>=i0 .and. n<=i9) go to 20
      52         end if
      53 !
      54 !       ACCOUNT FOR CONSECUTIVE DECIMAL POINTS (.)
      55         if (n /= idot) cycle
      56         iadd = iadd + 1
      57         if (i + iadd > l) go to 50
 
 FORCHECK PC V13.5.13          READA           2021-03-24 10:59:30   page:   178
 reada.F90  /FF
 
      58         n = ichar(string(i+iadd:i+iadd))
      59         if (n>=i0 .and. n<=i9) go to 20
      60       end do
      61       go to 50
      62 !
      63 !     FIND THE END OF THE NUMERIC FIELD
      64    20 continue
      65       expnnt = .FALSE.
      66       do j = i + 1, l
      67         iadd = 0
      68         n = ichar(string(j:j))
      69 !
      70 !       CONTINUE SEARCH FOR END IF DIGIT FOUND
      71         if (n>=i0 .and. n<=i9) cycle
      72 !
      73 !       CONTINUE SEARCH FOR END IF SIGN FOUND AND EXPNNT TRUE
      74         if (n==ineg .or. n==ipos) then
      75           if (.not.expnnt) go to 40
      76           iadd = iadd + 1
      77           if (j + iadd > l) go to 40
      78           n = ichar(string(j+iadd:j+iadd))
      79           if (n>=i0 .and. n<=i9) cycle
      80         end if
      81         if (n == idot) then
      82           iadd = iadd + 1
      83           if (j + iadd > l) go to 40
      84           n = ichar(string(j+iadd:j+iadd))
      85           if (n>=i0 .and. n<=i9) cycle
      86           if (n==icape .or. n==ismle .or. n==icapd .or. n==ismld) cycle
      87         end if
      88         if (n==icape .or. n==ismle .or. n==icapd .or. n==ismld) then
      89           if (expnnt) go to 40
      90           expnnt = .TRUE.
      91           cycle
      92         end if
      93         go to 40
      94       end do
      95       j = l + 1
      96    40 continue
      97       n = ichar(string(j-1:j-1))
      98       if (n==icape .or. n==ismle .or. n==icapd .or. n==ismld) j = j - 1
      99 !
     100 !     FOUND THE END OF THE NUMERIC FIELD (IT RUNS 'I' THRU 'J-1')
     101       n = 0
     102       n = n + index(string(i:j-1),'e')
     103       n = n + index(string(i:j-1),'E')
     104       n = n + index(string(i:j-1),'d')
     105       n = n + index(string(i:j-1),'D')
     106       if (n == 0) then
     107         reada = digit(string(i:j-1),1)
     108       else
     109         reada = digit(string(:i+n-2),i)*1.D1**digit(string(:j-1),i+n)
     110       end if
     111       return
     112 !
     113 !     DEFAULT VALUE RETURNED BECAUSE NO NUMERIC FIELD FOUND
     114    50 continue
     115       reada = 0.D0
     116       return
 
 FORCHECK PC V13.5.13          READA           2021-03-24 10:59:30   page:   179
 reada.F90  /FF
 
     117       end function reada
 
