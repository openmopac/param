     214 subroutine reverse_aux
     215 !
     216 !  Read in the current AUX file, then write out everything down to the
 start of the IRC,
     217 !  then write out the IRC in reverse.
     218 !
     219   use molkst_C, only : npoints => itemp_1, line, keywrd
     220   use chanel_C, only : output_fn
     221   implicit none
     222   integer :: hook = 50, i, j, n_head, n_lines
     223   character, allocatable :: start(:)*100, irc(:,:)*100
     224   if (index(keywrd, " AUX") == 0) return
     225   close (hook)
     226   open(unit=hook,file=output_fn(:len_trim(output_fn) - 4)//".aux")
     227   do i = 1, 10000
     228     read(hook,'(a)') line
     229     if (index(line, "#               IRC                #") /= 0) exit
     230   end do
     231   n_head = i + 2
     232   read(hook,'(a)') line
     233   if (line /= "dummy") read(hook,'(a)') line! a clumsy way to "fool" fo
 rcheck
     234   if (line /= "dummy") read(hook,'(a)') line
     235   if (line == "dummy") return
     236   do i = n_head + 1, n_head + 10000
     237     read(hook,'(a)') line
     238     if (index(line, "REF_POINT") /= 0) exit
     239   end do
     240   n_lines = i - n_head
     241 !
     242 !  The sizes of the data blocks are now known,
     243 !  so rewind, and store everything.
     244 !
     245   rewind (hook)
     246   allocate (start(n_head), irc(n_lines, npoints))
     247   read(hook,'(a)')start
     248   read(hook,'(a)')irc
     249 !
     250 ! Now write out the AUX file again, in reverse
     251 !
     252   rewind (hook)
     253   do i = 1, n_head
     254     write(hook,'(a)')trim(start(i))
     255   end do
     256   do i = npoints, 2, -1
     257     write(hook,'(a,i5.5)')" REF_POINT=",npoints - i + 1
     258     irc(2,i)(21:21) = "-"
     259     do j = 2, n_lines
     260       write(hook,'(a)')trim(irc(j,i))
     261     end do
     262   end do
     263   write(hook,'(a)')" ######################################"
     264   write(hook,'(a)')" #                                    #"
     265   write(hook,'(a)')" # Next point is the transition state #"
     266   write(hook,'(a)')" #                                    #"
     267   write(hook,'(a)')" ######################################"
     268   deallocate(start, irc)
     269 end subroutine reverse_aux
 
