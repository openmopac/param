     610   subroutine write_data_to_html(iprt)
     611     use molkst_C, only : numat, formula, escf, nelecs, keywrd, arc_hof_
 1, arc_hof_2, keywrd_txt, &
     612       density, id, mol_weight, stress
     613     USE parameters_C, only : tore
     614     use common_arrays_C, only: nat, tvec
     615     use chanel_C, only: log
     616     use funcon_C, only : fpc_10
     617     implicit none
     618     integer :: iprt
     619     integer :: i, j, k, l, eqls, colon
     620     character :: idate*24, line*120
     621     logical :: store_log
     622     double precision :: sum
     623     double precision, external :: volume
     624 !
     625 !  Print out information on the system: formula, number of atoms, heat
 of formation, date, etc.
     626 !
     627     write(iprt,"(a)")"<TABLE>"
     628     call fdate (idate)
     629     write(iprt,"(a)")  "<TR><TD> Date:</TD><TD> &nbsp;&nbsp; &nbsp;</TD
 ><TD>"// &
     630       idate(5:11)//idate(21:)//idate(11:16)//"</TD></TR>"
     631     write(iprt,"(a,i5,a)")  "<TR><TD> No. atoms:</TD><TD> &nbsp;&nbsp;
 &nbsp;</TD><TD>", &
     632       numat,  "</TD></TR>"
     633     store_log = log
     634     log = .false.
     635     call empiri()
     636     log = store_log
     637     colon = index(formula, ":") + 1
     638     eqls = index(formula, "=") - 1
     639     line = " "
     640     do i = colon, eqls
     641       j = i + 1
     642       if ((formula(i:i) < "0" .or. formula(i:i) > "9") .and. formula(j:
 j) >= "0" .and. formula(j:j) <= "9") then
     643         line = trim(line)//formula(i:i)
     644         line = trim(line)//"<sub>"
     645       else if ((formula(j:j) < "0" .or. formula(j:j) > "9") .and. formu
 la(i:i) >= "0" .and. formula(i:i) <= "9") then
     646         line = trim(line)//formula(i:i)
     647         line = trim(line)//"</sub>"
     648       else
     649         line = trim(line)//formula(i:i)
     650       end if
     651     end do
     652     write(iprt,"(a)")  "<TR><TD> Formula:</TD><TD> &nbsp;&nbsp; &nbsp;<
 /TD><TD>"//trim(line)//"</TD></TR>"
     653     if (index(keywrd, " 0SCF") == 0 .or. index(keywrd_txt, " GEO_REF")
 == 0) then
     654        if (id == 3) then
     655         sum = volume(tvec,3)
     656         density = mol_weight*1.D24/fpc_10/sum
     657         if (density > 1.d-1) write(iprt,"(a,f7.3,a)")  &
     658         "<TR><TD> Density:</TD><TD> &nbsp;&nbsp; &nbsp;</TD><TD>",densi
 ty,"</TD></TR>"
 
 FORCHECK PC V13.5.13    WRITE_DATA_TO_HTML    2021-03-24 10:59:30   page:   877
 pdbout.F90  /FF
 
     659       end if
     660     else
     661       if (abs(arc_hof_1) > 1.d-4) then
     662         if (index(keywrd_txt, " GEO_DAT") /= 0) then
     663           write(iprt,"(a,f12.3,a)")  "<TR><TD> GEO_DAT:</TD><TD> &nbsp;
 &nbsp; &nbsp;</TD><TD>", &
     664           arc_hof_1," kcal/mol</TD></TR>"
     665         else
     666           write(iprt,"(a,f12.3,a)")  "<TR><TD> Dataset:</TD><TD> &nbsp;
 &nbsp; &nbsp;</TD><TD>", &
     667           arc_hof_1," kcal/mol</TD></TR>"
     668         end if
     669       end if
     670       if (abs(arc_hof_2) > 1.d-4) &
     671       write(iprt,"(a,f12.3,a)")  "<TR><TD> <span style=""color:green"">
  GEO_REF:</span></TD><TD> &nbsp;&nbsp; &nbsp;</TD><TD>", &
     672         arc_hof_2," kcal/mol</TD></TR>"
     673       i = index(keywrd, " RMS_DIFF")
     674       if (i > 0) then
     675         i = index(keywrd(i:), "F=") + i + 1
     676         j = index(keywrd(i:), " ") + i - 2
     677         k = index(keywrd, " DIFF=") + 6
     678         l = k
     679         do l = l, len_trim(keywrd)
     680           if (keywrd(l:l) >= "0" .and. keywrd(l:l) <= "9") exit
     681         end do
     682         l = index(keywrd(l:)," ") + l - 2
     683         write(iprt,"(a)")  "<TR><TD> RMSD: "//keywrd(i:j)//"&Aring;</TD
 ><TD> </TD><TD>Diff: "//keywrd(k:l)//"&Aring;</TD></TR>"
     684       end if
     685     end if
     686     if (index(line, "H") /= 0 .and. nelecs > 0) then
     687 !
     688 !  Net charge has to be worked out the hard way
     689 !
     690       sum = -nelecs
     691       do i = 1, numat
     692         sum = sum + tore(nat(i))
     693       end do
     694       i = nint(sum)
     695       if (i /= 0) then
     696         write(iprt,"(a,SP,i6,SS,a)")"<TR><TD> Net charge:</TD><TD> &nbs
 p;&nbsp; &nbsp;</TD><TD>",i,"</TD></TR>"
     697       else
     698           write(iprt,"(a)")"<TR><TD> Net charge:</TD><TD> &nbsp;&nbsp;
 &nbsp;</TD><TD>Zero</TD></TR>"
     699       end if
     700     end if
     701     if (abs(escf) > 1.d-10) then
     702       if (abs(escf) > 1.d-10) &
     703         write(iprt,"(a, f12.3)")"<TR><TD> Heat of Formation:</TD><TD> &
 nbsp;&nbsp; &nbsp;</TD><TD>", &
     704         escf - stress," Kcal/mol</TD></TR>"
     705     end if
     706     write(iprt,"(a)")  "</TABLE>"
     707   end subroutine write_data_to_html
 
