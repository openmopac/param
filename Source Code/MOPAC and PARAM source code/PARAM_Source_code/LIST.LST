     458   subroutine Cpt_FirstOrderMatrix( N_qm, Id_qm, Crd_qm, Q_qm, Zeta_qm,
 Mmat, dMdQa )
     459     use YGXX_SimpleGaussianInts, only : GSJPS_IntQ
     460     USE parameters_C, only : CPE_Z0, CPE_B, CPE_Xlo, CPE_Xhi
     461     implicit none
     462     integer, intent(in) :: N_qm          ! Number of qm atoms
     463     integer, intent(in) :: Id_qm( N_qm ) ! Parameter indices
     464     double precision, intent(in) :: Crd_qm( 3, N_qm ) ! qm coordinates
 (xyz)
     465     double precision, intent(in) :: Q_qm( N_qm )      ! qm electric par
 tial charges
     466     double precision, intent(in) :: Zeta_qm( N_qm )   ! qm aux slater e
 xponent
     467     double precision, intent(OUT) :: Mmat( 3*N_qm, N_qm), dMdQa( 3*N_qm
  )
     468 !
     469 !  Local variables
     470 !
     471     double precision :: Rab(3), X(3, 1), Xa(3, 1), Xb(3, 1), Za, dZadQa
 , Zb, dZbdQb
     472     integer :: i, i1, i2, ia, j, ib
     473     double precision :: rlo, rhi, r, s
     474     Mmat  = 0.d0
     475     dMdQa = 0.d0
     476     do i=1, N_qm
     477        i1 = (i-1)*3 + 1
     478        i2 = i1 + 2
     479        ia = Id_qm(i)
     480        Za = CPE_Z0(ia) * EXP( CPE_B(ia) * Q_qm(i) )
     481        dZadQa = CPE_B(ia) * Za
     482        do j=1, N_qm
     483           ib = Id_qm(j)
     484           Rab = Crd_qm(1:3, i) - Crd_qm(1:3, j)
     485           r   = sqrt( Rab(1)*Rab(1) + Rab(2)*Rab(2) + Rab(3)*Rab(3) )
     486           Zb = Zeta_qm(j)
     487           dZbdQb = 0.d0
     488           call GSJPS_IntQ(Rab, 1, (/1.d0/), (/Za/), (/dZadQa/), Zb, dZb
 dQb, X, Xa, Xb)
     489           rlo = CPE_Xlo(ia) + CPE_Xlo(ib)
     490           rhi = CPE_Xhi(ia) + CPE_Xhi(ib)
     491           call SwitchOn(r, rlo, rhi, s)
     492           X  = s * X
     493           Xa = s * Xa
     494           Mmat( i1:i2, j ) = Mmat( i1:i2, j ) + X(1:3, 1)
     495           dMdQa( i1:i2 ) = dMdQa( i1:i2 ) + Xa(1:3, 1) * Q_qm(j)
     496        end do
     497     end do
     498     if (xb(1, 1) > 1.d9) return
     499   end subroutine Cpt_FirstOrderMatrix
 
