 FORCHECK PC V13.5.13  CVF compiler emulation  2021-03-24 10:59:30   page:  2864
 lyse.F90  /FF


       1   subroutine lyse
       2 !
       3 !  Before a residue sequence can be worked out, all inter-protein bonds
       4 !  must first be broken.  These bonds are of type N-S, O-S, and S-S
       5 !
       6     use common_arrays_C, only : nat, nbonds, ibonds
       7     use molkst_C, only : numat
       8     implicit none
       9     integer :: i, j, k, l, ll, m, n
      10     logical :: special
      11     double precision :: r_min, r
      12     double precision, external :: distance
      13  !
      14  !   FIRST, GET RID OF H ATOMS AND ATOMS ALREADY DEFINED
      15  !
      16     do i = 1, numat
      17       if (nat(i) /= 1) then
      18         if (nat(i) == 6) then
      19           l = 0
      20           do k = 1, nbonds(i)
      21             l = l + 1
      22             ibonds(l, i) = ibonds(k, i)
      23           end do
      24         else
      25           special = .false.
      26           if (nat(i) == 8) then
      27 !
      28 !  Atom is oxygen - check to see if it's attached to a sulfate or phosp
 hate.
      29 !  If so, do NOT lyse the bond.
      30 !
      31             do k = 1, nbonds(i)
      32               if (nat(ibonds(k, i)) == 16 .or. nat(ibonds(k, i)) == 15)
  then
      33                 if (nbonds(ibonds(k,i)) == 4) special = .true.
      34               end if
      35             end do
      36           end if
      37           if (special) then
      38             l = nbonds(i)
      39             cycle
      40           end if
      41 !
      42 ! EXCLUDE ALL N-S, O-S, and S-S BONDS
      43 !
      44           l = 0
      45           do k = 1, nbonds(i)
      46             if (nat(ibonds(k, i)) /= 16) then
      47               l = l + 1
      48               ibonds(l, i) = ibonds(k, i)
      49             end if
      50           end do
      51           ll = 0
      52           do k = 1, l
      53             j = ibonds(k,i)
      54             if(nat(j) == 7 .or. nat(j) == 6) ll = 1
      55           end do
