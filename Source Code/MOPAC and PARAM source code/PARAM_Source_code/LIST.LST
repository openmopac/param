    1044               if (u_esp(i,j) <= tf(1)) then
    1045                 iref = nint(u_esp(i,j)*20.D0)
    1046                 ref = 0.05D0*iref
    1047                 res = u_esp(i,j) - ref
    1048                 term1 = 1.D0
    1049                 f1(i,j) = 0.D0
    1050                 do k = 0, 6
    1051                   fi = fv(k+1,iref+1)
    1052                   ts1 = fi*term1*fac(k)
    1053                   term1 = -term1*res
    1054                   f1(i,j) = f1(i,j) + ts1
    1055                 end do
    1056               else
    1057                 f1(i,j) = rnai(i,j)*0.25D0/u_esp(i,j)
    1058               end if
    1059             end do
    1060             u_esp(istart:is_esp,j) = 2.D0*pi*exs(istart:is_esp,j)*expn(
