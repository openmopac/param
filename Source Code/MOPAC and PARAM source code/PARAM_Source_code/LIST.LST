       1 subroutine add_more_interactions()
       2 !
       3 !   In a MOZYME calculation, during a geometry optimization, the distan
 ce between a
       4 !  pair of atoms might become less, so that instead of an interaction b
 eing considered as a
       5 !  point charge it might need to be considered as a point charge plus d
 ipole, or instead of being a
       6 !  point charge plus dipole, it might need to be considered using the f
 ull NDDO approximation.
       7 !
       8 !  Here, the matrix of interactions is re-evaluated and if an iteractio
 n needs to be promoted,
       9 !  it would be promoted.
      10 !
      11 !  The array nijbo is the only array whose contents are changed.
      12 !  other arrays might need to be increased in size.  If so, then they w
 ould be increased by
      13 !  20% more than needed, to leave room for future expansion.
      14 !
      15   use molkst_C, only: mpack, numcal
      16 !
      17   use common_arrays_C, only: p, f, h
      18 !
      19   use MOZYME_C, only : lijbo, direct, semidr, partp, parth, partf, &
      20     rapid
      21 !
      22   use iter_C, only : pold
      23 !
      24   implicit none
      25   double precision, dimension (:), allocatable :: temp_store
      26 !
      27 !  Write out the contents of ijbo at the entry to add_more_interactions
      28 !
      29   integer :: i, j, alloc_stat, imol = 0
      30   save imol
      31 !
      32 !  Method is limited to direct SCF
      33 !
      34   if (.not. direct .or. .not. semidr .or. .not. lijbo) return
      35   if (imol /= numcal) then
      36     imol = numcal
      37     return  !  First time add_more_interactions is called, do nothing
      38   end if
      39   i = mpack
      40   call fillij (.false.)
      41   if (mpack > i) then
      42 !
      43 ! Some arrays are now too small - increase their size, but also preserv
 e their contents
      44 !
      45     allocate (temp_store(i), stat=alloc_stat)
      46     if (alloc_stat /= 0) then
      47         call memory_error ("add_more_interactions")
      48         return
      49     end if
      50     j = Nint(mpack*1.2)
      51 !
 
 FORCHECK PC V13.5.13  ADD_MORE_INTERACTIONS   2021-03-24 10:59:30   page:  3516
 add_more_interactions.F90  /FF
 
      52     temp_store = pold
      53     deallocate(pold)
      54     allocate(pold(j), stat=alloc_stat)
      55     if (alloc_stat /= 0) then
      56         call memory_error ("add_more_interactions")
      57         return
      58     end if
      59     pold(1:i) = temp_store(1:i)
      60     pold(i+1:) = 0.d0
      61 !
      62     temp_store = p
      63     deallocate(p)
      64     allocate(p(j), stat=alloc_stat)
      65     if (alloc_stat /= 0) then
      66         call memory_error ("add_more_interactions")
      67         return
      68     end if
      69     p(1:i) = temp_store(1:i)
      70     p(i+1:) = 0.d0
      71 !
      72     temp_store = h
      73     deallocate(h)
      74     allocate(h(j), stat=alloc_stat)
      75     if (alloc_stat /= 0) then
      76         call memory_error ("add_more_interactions")
      77         return
      78     end if
      79     h(1:i) = temp_store(1:i)
      80 !
      81     temp_store = f
      82     deallocate(f)
      83     allocate(f(j), stat=alloc_stat)
      84     if (alloc_stat /= 0) then
      85         call memory_error ("add_more_interactions")
      86         return
      87     end if
      88     f(1:i) = temp_store(1:i)
      89     f(i+1:) = 0.d0
      90 !
      91 !
      92 !
      93     if (rapid) then
      94       temp_store = partp
      95       deallocate(partp)
      96       allocate(partp(j), stat=alloc_stat)
      97       if (alloc_stat /= 0) then
      98           call memory_error ("add_more_interactions")
      99           return
     100       end if
     101       partp(1:i) = temp_store(1:i)
     102       partp(i+1:) = 0.d0
     103   !
     104   !
     105       temp_store = parth
     106       deallocate(parth)
     107       allocate(parth(j), stat=alloc_stat)
     108       if (alloc_stat /= 0) then
     109           call memory_error ("add_more_interactions")
     110           return
 
 FORCHECK PC V13.5.13  ADD_MORE_INTERACTIONS   2021-03-24 10:59:30   page:  3517
 add_more_interactions.F90  /FF
 
     111       end if
     112       parth(1:i) = temp_store(1:i)
     113       parth(i+1:) = 0.d0
     114   !
     115       temp_store = partf
     116       deallocate(partf)
     117       allocate(partf(j), stat=alloc_stat)
     118       if (alloc_stat /= 0) then
     119           call memory_error ("add_more_interactions")
     120           return
     121       end if
     122       partf(1:i) = temp_store(1:i)
     123       partf(i+1:) = 0.d0
     124     end if
     125   end if
     126   return
     127 end subroutine add_more_interactions
 
