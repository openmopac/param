 _h_bonds), vector(numat), stat=i)
      62     if (i /= 0) then
      63     line = " Cannot allocate arrays for PM6-DH+"
      64     call to_screen(trim(line))
      65     call mopend(trim(line))
      66     PM6_DH_H_bond_corrections = 0.d0
      67     return
      68   end if
      69   hblist(:,:) = 0
      70   nrpairs = 0
      71   if (method_pm6_dh_plus .or. method_PM7) then
      72     call all_h_bonds(hblist(1,1), hblist(1,9), hblist(1,5), max_h_bonds
 , nrpairs)
      73     call setup_DH_Plus(nrpairs, nrbondsa, nrbondsb, n_h_bonds, covrad)
      74   else
      75     call all_h_bonds(hblist(1,1), hblist(1,2), hblist(1,3), max_h_bonds
 , nrpairs)
      76   end if
      77   if (method_pm6_dh2 .or. method_pm6_dh2x) then
      78     call chrge (p, vector)  ! PM6-DH2 needs partial charges
      79     do i = 1, numat
      80       j = nat(i)
      81       q(i) = tore(j) - vector(i)
      82     end do
      83   end if
      84 !
      85 !  Calculate Hydrogen bond energy correction
      86 !
      87 !    The hydrogen-bond acceptor types are as follows:
      88 !
      89 !    (1) nitrogen with no hydrogens bonded to it (mostly in aromatic ri
 ngs) interacting with any hydrogen,
      90 !    (2) nitrogen with one hydrogen (secondary amines) interacting with
  any hydrogen,
      91 !    (3) nitrogen with two or more hydrogens (primary amines, ammonia)
 interacting with any hydrogen,
      92 !    (4) oxygen except carbonyl interacting with HN,
      93 !    (5) carbonyl oxygen interacting with HN,
      94 !    (6) oxygen interacting with HO hydrogen different from 7 and 8,
      95 !    (7) oxygen interacting with H in a water molecule, and
      96 !    (8) oxygen interacting with H in a carboxyl group.
      97 !
      98
      99   N_Hbonds = 0
 
 FORCHECK PC V13.5.13                          2021-03-24 10:59:30   page:  1760
 H_bond_correction_PM6_DH_type.F90  /FF
 
     100   E_hb = 0.d0
     101   do ii = 1, nrpairs
     102     if (method_pm6_dh_plus .or. method_pm7) then
     103       H = hblist(ii,9)
     104       A = hblist(ii,1)
     105       D = hblist(ii,5)
     106       sum = EH_plus(ii, hblist, max_h_bonds, nrbondsa, nrbondsb)
     107       E_hb = E_hb + sum
     108       nd_list=0
     109       do i = 1, 9
     110         if (hblist(ii,i) > 0) then
     111           j = hblist(ii,i)
     112           do l = 1, nd_list
     113             if (d_list(l) == j) exit
     114           end do
     115           if (l > nd_list) then
     116             nd_list = nd_list + 1
     117             d_list(nd_list) = hblist(ii,i)
     118           end if
     119         end if
     120       end do
     121     else
     122       H = hblist(ii,2)
     123       A = hblist(ii,3)
     124       D = hblist(ii,1)
     125       sum = EC_plus_ER(hblist(ii,1), hblist(ii,2), hblist(ii,3), q(hbli
 st(ii,2)), q(hblist(ii,3)), EC, ER, d_list, nd_list)
     126       E_hb = E_hb + EC + ER
     127     end if
     128     if (sum < -1.d0) N_Hbonds = N_Hbonds + 1
     129     if (prt) call prt_hbonds(D, H, A, sum)
     130 !
     131 ! Add in gradient contribution, if requested
     132 !
     133     if (l_grad .and. sum < -0.01d0) then
     134       do j = 1, nd_list
     135         k = d_list(j)
     136         iii = l123*(k - 1)
     137         if (connected(H, k, 8.d0**2)) then
     138 !
     139 !   kkkk is the cell that atom k is in, relative to atom H
     140 !
     141           kkkk = (l3u - cell_ijk(3)) + (2*l3u + 1)*(l2u - cell_ijk(2) +
  (2*l2u + 1)*(l1u - cell_ijk(1)))
     142           i_cell = iii + kkkk
     143 !
     144 !  Delta is 10^(-5).  During the evaluation of simple functions such as
  sqrt and acos, half of the precision is lost
     145 !  This means that, instead of 16 digits of precision, there are only 8
 .  Tests with delta = 10^(-8) showed severe errors
     146 !  in the derivatives.  The "ideal" value of delta should be 10^(-4), b
 ut 10^(-5) was selected by JJPS as the best compromise,
     147 !  based on finding the middle of the plateau of constant derivatives.
     148 !
     149           do i = 1, 3
     150             coord(i,k) = coord(i,k) + delta
     151             if (method_pm6_dh_plus .or. method_pm7) then
     152               sum1 = EH_plus(ii, hblist, max_h_bonds, nrbondsa, nrbonds
 b)
 
 FORCHECK PC V13.5.13                          2021-03-24 10:59:30   page:  1761
 H_bond_correction_PM6_DH_type.F90  /FF
 
     153             else
     154               sum1 = EC_plus_ER(D, H, A, q(H), q(A), EC, ER, d_l, l)
     155             end if
     156             sum1 = (sum1 - sum)/delta
     157             if (Abs(sum1) < 50.d0) then
     158               dxyz(i_cell*3 + i) = dxyz(i_cell*3 + i) + sum1
     159             end if
     160             coord(i,k) = coord(i,k) - delta
     161           end do
     162         end if
     163       end do
     164     end if
     165   end do
     166   PM6_DH_H_bond_corrections = E_hb
     167   return
     168   end function PM6_DH_H_bond_corrections
 
