     169 subroutine minloc (vecs, nvec, n)
     170    !*******************************************************************
 ****
     171    !
    *
     172    ! MINLOC puts the hybrid orbitals that are ill-defined into a
    *
     173    ! definite form.  If a heavy atom bonds to one other atom, then only
    *
     174    ! the orientation of the sigma bond is defined, the orientations of
    *
     175    ! the two or three other hybrids is not well defined (is ill-defined
 ). *
     176    !
    *
     177    ! By using a simple unitary transform, the orientations of the two o
 r  *
     178    ! ill-defined hybrids becomes well-defined.  Note:  Although they ar
 e  *
     179    ! now well-defined, they do not need to make chemical sense.  This
    *
     180    ! operation is performed to allow MOZYME to be more easily ported.
    *
     181    ! As with the original hybrids, the new hybrids, although
    *
     182    ! well-defined, are not rotationally invariant.  Rotational
    *
     183    ! invariance is only achieved at self-consistency.
    *
     184    !*******************************************************************
 ****
     185    !
     186    !.. Implicit Declarations ..
     187     implicit none
     188    !
     189    !.. Formal Arguments ..
     190     integer, intent (in) :: nvec
     191     double precision, dimension (nvec, 4), intent (inout) :: vecs
     192     integer, intent (in) :: n
     193    !
     194    !.. Local Scalars ..
     195     integer :: i, j, l1, l2
     196     double precision :: beta
     197     double precision :: rot = 0.999d0
     198     double precision :: alpha, sum
     199    !
     200    !.. Intrinsic Functions ..
     201     intrinsic Sqrt
     202    !
     203    ! ... Executable Statements ...
     204    !
     205     if (n /= 2) then
     206       !
     207       !                             x   x   x   x  x
     208       !   Pattern of Coefficients:  x   x   x   x  x
     209       !                             x   x   x   x  x
     210       !                             x   x   x   x  x
     211       !
 
 FORCHECK PC V13.5.13          MINLOC          2021-03-24 10:59:30   page:  1992
 hybrid.F90  /FF
 
     212       !   Re-hybridize three orbitals.  First, annihilate element VECS(
 2,3)
     213       !
     214       do i = 2, 4
     215         sum = vecs(i, 2) ** 2 + vecs(i, 3) ** 2
     216         if (sum > 0.1d0) go to 1000
     217       end do
     218 1010  sum = vecs(i, 4) ** 2 + vecs(i, 2) ** 2
     219       !
     220       !                             x   x   x   x  x
     221       !   Pattern of Coefficients:  x   x   x   x  x
     222       !                             x   0   x   x  x
     223       !                             x   x   x   x  x
     224       !
     225       !                                  Next, annihilate element VECS(
 2,4)
     226       !
     227       sum = 1.d0 / Sqrt (sum)
     228       alpha = vecs(i, 4) * sum
     229       beta = vecs(i, 2) * sum
     230       do j = 1, nvec
     231         sum = alpha * vecs(j, 4) + beta * vecs(j, 2)
     232         vecs(j, 4) = -beta * vecs(j, 4) + alpha * vecs(j, 2)
     233         vecs(j, 2) = sum
     234       end do
     235       go to 1020
     236 1000  sum = 1.d0 / Sqrt (sum)
     237       alpha = vecs(i, 2) * sum
     238       beta = vecs(i, 3) * sum
     239       do j = 1, nvec
     240         sum = alpha * vecs(j, 2) + beta * vecs(j, 3)
     241         vecs(j, 3) = -beta * vecs(j, 2) + alpha * vecs(j, 3)
     242         vecs(j, 2) = sum
     243       end do
     244       go to 1010
     245     end if
     246    !
     247    !                             x   x   x   x  x
     248    !   Pattern of Coefficients:  x   x   x   x  x
     249    !                             x   0   x   x  x
     250    !                             x   0   x   x  x
     251    !
     252 1020 do i = 2, 4
     253            !
     254            !                                  Annihilate element VECS(i
 ,4)
     255            !
     256       sum = vecs(i, 4) ** 2 + vecs(i, 3) ** 2
     257       if (sum > 0.1d0) go to 1030
     258     end do
     259     return
     260 1030 sum = 1.d0 / Sqrt (sum)
     261     alpha = vecs(i, 4) * sum
     262     beta = vecs(i, 3) * sum
     263     do j = 1, nvec
     264       sum = alpha * vecs(j, 4) + beta * vecs(j, 3)
     265       vecs(j, 4) = -beta * vecs(j, 4) + alpha * vecs(j, 3)
     266       vecs(j, 3) = sum
     267     end do
 
 FORCHECK PC V13.5.13          MINLOC          2021-03-24 10:59:30   page:  1993
 hybrid.F90  /FF
 
     268    !
     269    !   Finally, make a small perturbation to destroy any accidental
     270    !   symmetry that might exist.  This symmetry can prevent an SCF
     271    !   from forming.
     272    !
     273     do l1 = 1, 4
     274       do l2 = l1 + 1, 4
     275         alpha = rot
     276         beta = Sqrt (1.d0-alpha**2)
     277         do j = 1, nvec
     278           sum = alpha * vecs(j, l1) + beta * vecs(j, l2)
     279           vecs(j, l1) = -beta * vecs(j, l1) + alpha * vecs(j, l2)
     280           vecs(j, l2) = sum
     281         end do
     282       end do
     283     end do
     284 !
     285 !                             x   x   x   x  x
     286 !   Pattern of Coefficients:  x   x   x   x  x
     287 !                             x   0   x   x  x
     288 !                             x   0   0   x  x
     289 !
     290 end subroutine minloc
 
