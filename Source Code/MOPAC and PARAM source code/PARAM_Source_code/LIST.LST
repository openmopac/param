    1372   subroutine minimize_gradient(loop, converged, extra_print, l_ts, l_nl
 lsq, l_sigma)
    1373     USE molkst_C, only : numat, line, nvar, time0, escf, title, moperr,
  iflepo
    1374     use common_arrays_C, only : xparam, geo, loc, geoa
    1375     use chanel_C, only : iw, input_fn, iarc
    1376     implicit none
    1377     integer, intent (in) :: loop
    1378     logical, intent (in) :: extra_print, l_ts, l_nllsq, l_sigma
    1379     logical, intent (out) :: converged
    1380 !
    1381 !  Local
    1382 !
    1383     integer :: i
    1384     double precision, external :: seconds
    1385     logical :: opend
    1386     character :: num*1
    1387     if (l_ts) then
    1388       line = "TS"
    1389     else if (l_nllsq) then
    1390       line = "NLLSQ"
    1391     else
    1392       line = "SIGMA"
    1393     end if
    1394     write(iw,'(a, i4 ,a)')"  Loop:", loop, &
    1395     "  Gradient minimization of atoms in the active site using "//trim(
 line)
    1396     i = int(log10(loop + 0.05))
    1397     num = char(ichar("1") + i)
    1398     write(line,'("(Loop", i'//num//',")", a)')loop, trim(title)
    1399     title = trim(line)
    1400     line = input_fn(:len_trim(input_fn) - 5)
    1401     write(line(len_trim(line) + 1:),'(a, i'//num//', a)')" Loop",loop,
 ".mop"
    1402     if (extra_print) then
    1403       call add_path(line)
    1404       inquire(unit=iarc, opened=opend)
    1405       if (opend) close(iarc)
    1406       open(unit=iarc, file=trim(line), status='UNKNOWN', position='asis
 ')
    1407       write(iw,'(/10x,a,i2,a,/10x,a,/)')"Transition state on cycle",loo
 p, " written to file:", &
    1408       &"'"//trim(line)//"'"
    1409       call geout (iarc)
    1410       close(iarc)
    1411       title = trim(title(8 + i:))
    1412     end if
    1413     call l_control("GNORM=3", len("GNORM=3"), 1)
    1414     geoa(:,:numat) = geo(:,:numat)
    1415     time0 = seconds(1)
    1416     if (loop == 2) call l_control("OLD_HESS", len("OLD_HESS"), 1)
    1417     if (l_ts) then
    1418       call l_control("TS", len("TS"), 1)
    1419       call l_control("OLD_SCF", len("OLD_SCF"), 1)
    1420       call l_control("tighten", len_trim("tighten"), 1)
    1421       call ef(xparam,escf)
    1422     else if (l_sigma) then
    1423       call powsq()
 
 FORCHECK PC V13.5.13    MINIMIZE_GRADIENT     2021-03-24 10:59:30   page:  1755
 big_swap.F90  /FF
 
    1424     else if (l_nllsq) then
    1425       call nllsq()
    1426     end if
    1427     if (moperr) then
    1428       write(iw,'(//2x,a,//)')" Gradient minimization failed.  The best
 geometry at this point will be output to ARC file"
    1429       converged = .true.
    1430       iflepo = 8
    1431       line = input_fn(:len_trim(input_fn) - 5)
    1432       write(line(len_trim(line) + 1:),'(a)')".arc"
    1433       call add_path(line)
    1434       inquire(unit=iarc, opened=opend)
    1435       if (opend) close(iarc)
    1436       open(unit=iarc, file=trim(line), status='UNKNOWN', position='asis
 ')
    1437       do i = 1, nvar
    1438         geo(loc(2,i),loc(1,i)) = xparam(i)
    1439       end do
    1440       call geout (iarc)
    1441       close(iarc)
    1442       return
    1443     end if
    1444     return
    1445   end subroutine minimize_gradient
 
