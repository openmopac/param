     808       real function snrm2 (n, sx, incx)
     809       implicit none
     810 !-----------------------------------------------
     811 !   D u m m y   A r g u m e n t s
     812 !-----------------------------------------------
     813       integer , intent(in) :: n
     814       integer , intent(in) :: incx
     815       real , intent(in) :: sx(1)
     816 !-----------------------------------------------
     817 !   L o c a l   V a r i a b l e s
     818 !-----------------------------------------------
     819       integer :: next, nn, i, j
     820       real :: cutlo, cuthi, hitest, sum, xmax, zero, one
     821 !-----------------------------------------------
     822       data zero, one/ 0.0E0, 1.0E0/
     823 !
     824 !     EUCLIDEAN NORM OF THE N-VECTOR STORED IN SX() WITH STORAGE
     825 !     INCREMENT INCX .
     826 !     IF    N .LE. 0 RETURN WITH RESULT = 0.
     827 !     IF N .GE. 1 THEN INCX MUST BE .GE. 1
     828 !
     829 !           C.L.LAWSON, 1978 JAN 08
     830 !
     831 !     FOUR PHASE METHOD     USING TWO BUILT-IN CONSTANTS THAT ARE
     832 !     HOPEFULLY APPLICABLE TO ALL MACHINES.
     833 !         CUTLO = MAXIMUM OF  SQRT(U/EPS)  OVER ALL KNOWN MACHINES.
     834 !         CUTHI = MINIMUM OF  SQRT(V)      OVER ALL KNOWN MACHINES.
     835 !     WHERE
     836 !         EPS = SMALLEST NO. SUCH THAT EPS + 1. .GT. 1.
     837 !         U   = SMALLEST POSITIVE NO.   (UNDERFLOW LIMIT)
     838 !         V   = LARGEST  NO.            (OVERFLOW  LIMIT)
     839 !
     840 !     BRIEF OUTLINE OF ALGORITHM..
     841 !
     842 !     PHASE 1    SCANS ZERO COMPONENTS.
     843 !     MOVE TO PHASE 2 WHEN A COMPONENT IS NONZERO AND .LE. CUTLO
     844 !     MOVE TO PHASE 3 WHEN A COMPONENT IS .GT. CUTLO
     845 !     MOVE TO PHASE 4 WHEN A COMPONENT IS .GE. CUTHI/M
     846 !     WHERE M = N FOR X() REAL AND M = 2*N FOR COMPLEX.
     847 !
     848 !     VALUES FOR CUTLO AND CUTHI..
     849 !     FROM THE ENVIRONMENTAL PARAMETERS LISTED IN THE IMSL CONVERTER
     850 !     DOCUMENT THE LIMITING VALUES ARE AS FOLLOWS..
     851 !     CUTLO, S.P.   U/EPS = 2**(-102) FOR  HONEYWELL.  CLOSE SECONDS AR
 E
     852 !                   UNIVAC AND DEC AT 2**(-103)
     853 !                   THUS CUTLO = 2**(-51) = 4.44089E-16
     854 !     CUTHI, S.P.   V = 2**127 FOR UNIVAC, HONEYWELL, AND DEC.
     855 !                   THUS CUTHI = 2**(63.5) = 1.30438E19
     856 !     CUTLO, D.P.   U/EPS = 2**(-67) FOR HONEYWELL AND DEC.
     857 !                   THUS CUTLO = 2**(-33.5) = 8.23181D-11
     858 !     CUTHI, D.P.   SAME AS S.P.  CUTHI = 1.30438D19
     859 !     DATA CUTLO, CUTHI / 8.232D-11,  1.304D19 /
     860 !     DATA CUTLO, CUTHI / 4.441E-16,  1.304E19 /
     861       data cutlo, cuthi/ 4.441E-16, 1.304E19/
     862       xmax = 0.0
     863 !
     864       if (n <= 0) then
 
 FORCHECK PC V13.5.13          SNRM2           2021-03-24 10:59:30   page:  1930
 esp_utilities.F90  /FF
 
     865         snrm2 = zero
     866       else
     867 !
     868         next = 30
     869         sum = zero
     870         nn = n*incx
     871 !                                                 BEGIN MAIN LOOP
     872         i = 1
     873    20   continue
     874         if (next == 30) go to 30
     875         if (next == 50) go to 50
     876         if (next == 70) go to 70
     877         if (next == 110) go to 110
     878    30   continue
     879         if (abs(sx(i)) > cutlo) go to 85
     880         next = 50
     881         xmax = zero
     882 !
     883 !                        PHASE 1.  SUM IS ZERO
     884 !
     885    50   continue
     886         if (Abs(sx(i)) < 1.d-20) go to 200
     887         if (abs(sx(i)) > cutlo) go to 85
     888 !
     889 !                                PREPARE FOR PHASE 2.
     890         next = 70
     891         go to 105
     892 !
     893 !                                PREPARE FOR PHASE 4.
     894 !
     895   100   continue
     896         i = j
     897         next = 110
     898         sum = (sum/sx(i))/sx(i)
     899   105   continue
     900         xmax = abs(sx(i))
     901         go to 115
     902 !
     903 !                   PHASE 2.  SUM IS SMALL.
     904 !                             SCALE TO AVOID DESTRUCTIVE UNDERFLOW.
     905 !
     906    70   continue
     907         if (abs(sx(i)) > cutlo) go to 75
     908 !
     909 !                     COMMON CODE FOR PHASES 2 AND 4.
     910 !                     IN PHASE 4 SUM IS LARGE.  SCALE TO AVOID OVERFLOW
 .
     911 !
     912   110   continue
     913         if (abs(sx(i)) <= xmax) go to 115
     914         sum = one + sum*(xmax/sx(i))**2
     915         xmax = abs(sx(i))
     916         go to 200
     917 !
     918   115   continue
     919         sum = sum + (sx(i)/xmax)**2
     920         go to 200
     921 !
     922 !
 
 FORCHECK PC V13.5.13          SNRM2           2021-03-24 10:59:30   page:  1931
 esp_utilities.F90  /FF
 
     923 !                  PREPARE FOR PHASE 3.
     924 !
     925    75   continue
     926         sum = (sum*xmax)*xmax
     927 !
     928 !
     929 !     FOR REAL OR D.P. SET HITEST = CUTHI/N
     930 !     FOR COMPLEX      SET HITEST = CUTHI/(2*N)
     931 !
     932    85   continue
     933         hitest = cuthi/float(n)
     934 !
     935 !                   PHASE 3.  SUM IS MID-RANGE.  NO SCALING.
     936 !
     937         do j = i, nn, incx
     938           if (abs(sx(j)) >= hitest) go to 100
     939           sum = sum + sx(j)**2
     940         end do
     941         snrm2 = sqrt(sum)
     942         go to 300
     943 !
     944   200   continue
     945         i = i + incx
     946         if (i <= nn) go to 20
     947 !
     948 !              END OF MAIN LOOP.
     949 !
     950 !              COMPUTE SQUARE ROOT AND ADJUST FOR SCALING.
     951 !
     952         snrm2 = xmax*sqrt(sum)
     953       end if
     954   300 continue
     955       return
     956       end function snrm2
 
