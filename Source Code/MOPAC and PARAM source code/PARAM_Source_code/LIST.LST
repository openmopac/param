     855 !     **** diagonalize energy block ****
     856       call tred2e (mspn, nperm, h, eval, wk, h)
     857       call tql2e  (mspn, nperm,  eval, wk, h, ier)
     858
     859 !     **** form S**2 matrix in det basis ****
     860
     861       do i = 1, nperm
     862         s2(i, i) = (nalpha + nbeta)*0.5D0 + (nalpha - nbeta)**2*0.25D0
