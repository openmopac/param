    2162 subroutine updhes (svec, tvec, grad, nvar, iupd, hess, oldf, d)
    2163     use molkst_C, only: numcal
    2164     use chanel_C, only: iw
    2165     use ef_C, only: iprnt, ddx
    2166     implicit none
    2167     integer, intent (in) :: iupd, nvar
    2168     double precision, dimension (nvar), intent (in) :: d, grad, oldf
    2169     double precision, dimension (nvar), intent (inout) :: svec, tvec
    2170     double precision, dimension (nvar, nvar), intent (inout) :: hess
    2171     integer :: i
    2172     integer, save :: icalcn = 0
    2173     integer :: j
    2174     double precision :: dds, ddtd, temp
    2175     double precision, save :: zero = 0.0d0
    2176     double precision, external :: dot, ddot
    2177 !
    2178
    2179
    2180    !
    2181    ! ... Executable Statements ...
    2182    !
    2183    !  UPDATING OF THE HESSIAN
    2184    !  DEPENDS ON CURRENT grad, OLD grad AND THE
    2185    !  CORRECTION VECTOR USED ON THE LAST CYCLE
    2186    !  SVEC & TVEC ARE FOR TEMPORARY STORAGE
    2187    !
    2188    !  2 UPDATING PROCEDURES ARE POSSIBLE
    2189    !  (I)   THE POWELL UPDATE
    2190    !        THIS PRESERVES THE SYMMETRIC CHARACTER OF THE HESSIAN
    2191    !        WHILST ALLOWING ITS EIGENVALUE STRUCTURE TO CHANGE.
    2192    !        IT IS THE DEFAULT UPDATE FOR A TRANSITION STATE SEARCH
    2193    !  (II)  THE BFGS UPDATE
    2194    !        THIS UPDATE HAS THE IMPORTANT CHARACTERISTIC OF RETAINING
    2195    !        POSITIVE DEFINITENESS (NOTE: THIS IS NOT RIGOROUSLY
    2196    !        GUARANTEED, BUT CAN BE CHECKED FOR BY THE PROGRAM).
    2197    !        IT IS THE DEFAULT UPDATE FOR A MINIMUM SEARCH
    2198    !
    2199    !     SWITCH : IUPD
    2200    !       IUPD = 0  :  SKIP UPDATE
    2201    !       IUPD = 1  :  POWELL
    2202    !       IUPD = 2  :  BFGS
    2203    !
    2204     if (icalcn /= numcal) then
    2205       icalcn = numcal
    2206       if (iprnt >= 2) then
    2207         if (iupd == 0) then
    2208 10000     format (/, 5x, "HESSIAN IS NOT BEING UPDATED", /)
    2209           write (iw, 10000)
    2210         end if
    2211         if (iupd == 1) then
    2212             !
    2213 10010     format (/, 5x, &
    2214                & "HESSIAN IS BEING UPDATED USING THE POWELL UPDATE", /)
    2215           write (iw, 10010)
    2216         end if
    2217         if (iupd == 2) then
    2218 10020     format (/, 5x, "HESSIAN IS BEING UPDATED USING THE BFGS UPDAT
 E", /)
 
 FORCHECK PC V13.5.13          UPDHES          2021-03-24 10:59:30   page:  2145
 ef.F90  /FF
 
    2219           write (iw, 10020)
    2220         end if
    2221       end if
    2222     end if
    2223     if (iupd == 0) return
    2224     do i = 1, nvar
    2225       tvec(i) = zero
    2226     end do
    2227     do j = 1, nvar
    2228       do i = 1, nvar
    2229         tvec(i) = tvec(i) + hess(i, j) * d(j)
    2230       end do
    2231     end do
    2232    !
    2233     if (iupd == 1) then
    2234       !
    2235       !   (I) POWELL UPDATE
    2236       !
    2237       do i = 1, nvar
    2238         tvec(i) = grad(i) - oldf(i) - tvec(i)
    2239         svec(i) = grad(i) - oldf(i)
    2240       end do
    2241       dds = ddx * ddx
    2242
    2243       ddtd = dot (tvec, d, nvar)
    2244       if (Abs(dds - zero) < 1.d-20) then
    2245         write (iw, "(' CALCULATION IS TERMINATED TO AVOID ZERO DIVIDE')
 ")
    2246         call mopend ("in UPDHES")
    2247         return
    2248       end if
    2249       ddtd = ddtd / dds
    2250       !
    2251       do i = 2, nvar
    2252         do j = 1, i - 1
    2253           temp = tvec(i) * d(j) + d(i) * tvec(j) - d(i) * ddtd * d(j)
    2254           hess(i, j) = hess(i, j) + temp / dds
    2255           hess(j, i) = hess(i, j)
    2256         end do
    2257       end do
    2258       do i = 1, nvar
    2259         temp = d(i) * (2.0d0*tvec(i)-d(i)*ddtd)
    2260         hess(i, i) = hess(i, i) + temp / dds
    2261       end do
    2262     end if
    2263     if (iupd /= 2) return
    2264    !
    2265    !  (II) BFGS UPDATE
    2266    !
    2267     do i = 1, nvar
    2268       svec(i) = grad(i) - oldf(i)
    2269     end do
    2270     dds = ddot (nvar, svec, 1, d, 1)
    2271     ddtd = ddot (nvar, d, 1, tvec, 1)
    2272 !
    2273    !
    2274     if (Abs(dds - zero) < 1.d-20 .or. Abs(ddtd) < 1.d-20) then
    2275       write (iw, "(' CALCULATION IS TERMINATED TO AVOID ZERO DIVIDE')")
    2276       call mopend ("in UPDHES")
 
 FORCHECK PC V13.5.13          UPDHES          2021-03-24 10:59:30   page:  2146
 ef.F90  /FF
 
    2277       return
    2278     end if
    2279     do i = 2, nvar
    2280       do j = 1, i - 1
    2281         temp = (svec(i)*svec(j)) / dds - (tvec(i)*tvec(j)) / ddtd
    2282         hess(i, j) = hess(i, j) + temp
    2283         hess(j, i) = hess(i, j)
    2284       end do
    2285     end do
    2286     do i = 1, nvar
    2287       temp = (svec(i)*svec(i)) / dds - (tvec(i)*tvec(i)) / ddtd
    2288       hess(i, i) = hess(i, i) + temp
    2289     end do
    2290 end subroutine updhes
 
