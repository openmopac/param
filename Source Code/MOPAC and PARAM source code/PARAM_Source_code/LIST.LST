       1 logical function connected(atom_i, atom_j, criterion)
       2 !
       3 !   "connected" is true if atom_i and atom_j are within sqrt(criterion)
  Angstroms
       4 !   of each other, false otherwise.
       5 !
       6 !   if "connected" then:
       7 !
       8 !   If the system is infinite (polymer, layer or solid),
       9 !   then cell_ijk will hold the unit cell translation indices that move
  atom_j near to
      10 !   atom_i, zero therwise.
      11 !
      12 !   Vab is the position of atom_i relative to atom_j
      13 !
      14 !   Rab is distance from atom_i to atom_j
      15 !
      16 !   if not "connected" then Rab, Vab, and cell_ijk are meaningless.
      17 !
      18   use molkst_C, only : id, Rab
      19   use common_arrays_C, only: coord, Vab
      20   implicit none
      21   double precision ::  criterion
      22   integer :: atom_i, atom_j
      23   double precision, external :: distance
      24 !
      25   if (id == 0) then
      26     Vab = coord(:,atom_i) - coord(:,atom_j)
      27     Rab = Vab(1)**2 + Vab(2)**2 + Vab(3)**2
      28   else
      29     Rab = distance(atom_i, atom_j)**2
      30   end if
      31   connected = (Rab < criterion)
      32   if (connected) Rab = sqrt(Rab)
      33   return
      34 end function connected
 
