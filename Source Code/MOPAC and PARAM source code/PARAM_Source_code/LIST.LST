     652 !     *****************************************************************
 *****
     653
     654       subroutine spclas (istsym, jconf, ao, bo, ao1, bo1, e, &
     655      &        aocc, bocc, nspn, spintr, beta, c, gamma, nbtmo, aii, nfa
 ct, &
     656      &        irefd, krefd, isrefd)
     657
     658 !     **** this takes a determinate AO, BO and finds all other DETs
  ****
     659 !     **** belonging to its CLASS (ie, dets coupled by S**2).  It calcs
  ****
     660 !     **** their interaction energies, diagonalizes S**2 to deduce the
  ****
     661 !     **** linear combinations which are eigenvalues of spin, and hence
  ****
     662 !     **** transforms the energy matrix to deduce the spin - adapted
  ****
     663 !     **** CONFiguration energies E.  Those of spin MULTCI are selected
  ****
     664 !     **** and the lowest NCONF stored if their energy is < EMAXCI.
  ****
     665 !     **** AOCC and BOCC store the dets if at least one energy included
  ****
     666 !     **** ISNG stores locn of all singly occ orbs in det
  ****
     667       use reimers_C, only: n, nb2, matind, nconf, multci, ncore, nol, &
     668           nvh, nov, fastci, icisym, ecore, ifst, afst, ixprd, ndiff, ne
 x, &
     669           mspn, nsym
     670       USE chanel_C, only : iw
     671       use cosmo_C, only : useps
     672
     673       implicit none
     674 !     **** MP2 storage in excite and spcls ****
     675       integer            isng(mspn), nbtmo(n), nel(nov), nspn(nconf), &
     676                          istsym(nconf), krefd(nconf), nfact(0:mspn)
     677       double precision   s2(mspn, mspn), eval(mspn), wk(mspn), &
     678                          h(mspn, mspn), s2eig(mspn, mspn), s2eval(mspn)
 , &
     679                          gamma(n, n), c(n, n), e(nconf), beta(nb2), &
     680                          aii(n), spintr(mspn, nov)
     681       integer            i, j, k, i0, i1, idet, ier, iisym, ih, il, ip,
  &
     682                          irefd, isync, j1, jconf, jdet, &
     683                          k1, k2, nalpha, nbeta, ndeg, &
     684                          nelj, nend, nperm, nsng
     685       double precision   ciener, e1, eec1, j12, k12, s1, tol
     686
     687       logical*1          ao(nov), bo(nov), ao1(nov, mspn), bo1(nov, msp
 n), &
     688                          aocc(nov, mspn, nex), bocc(nov, mspn, nex)
     689       logical            isrefd
     690       double precision       ediel
     691
     692 !     *********** check that its of the correct symmetry ************
     693       iisym = 1
     694       do j = 1, nov
 
 FORCHECK PC V13.5.13          SPCLAS          2021-03-24 10:59:30   page:  2485
 excite.F90  /FF
 
     695         if (ao(j) .neqv. bo(j)) iisym = ixprd (iisym, nsym(j + ncore))
     696       end do
     697       if (.not. isrefd .and. icisym(iisym).eq.0) then
     698         return
     699       end if
     700
     701 !     *********** check that this det isnt already included in CI list
 ********
     702
     703 !     **** calculate the total number of electrons in each orb ****
     704       do i = 1, nov
     705         nel(i) = 0
     706         if (ao(i)) nel(i) = 1
     707         if (bo(i)) nel(i) = nel(i) + 1
     708       end do
     709
     710       do 200 i = 1, jconf
     711         do j = 1, nov
     712           nelj = 0
     713           if (aocc(j, 1, i)) nelj = 1
     714           if (bocc(j, 1, i)) nelj = nelj + 1
     715           if (nelj.ne.nel(j)) goto 200
     716         end do
     717
     718 !       **** can only get here if two dets are in the same spin class *
 ***
     719         return
     720 200   continue
     721
     722 !     ***** if its closed shell with singles excitation; fast code ****
     723
     724       if (fastci) then
     725         if (ifst > 0) then
     726          call inttr (ifst, ifst, afst, afst, c, gamma, nbtmo, j12, k12,
  0)
     727
     728           eval(1) = aii(afst) - aii(ifst) - j12
     729           if (multci.eq.1) eval(1) = eval(1) + 2.D0*k12
     730         else
     731 !         **** ground state energy ****
     732           eval(1) = 0.D0
     733         end if
     734
     735         nperm = 1
     736         h(1, 1) = 1.D0
     737         wk(1) = multci
     738         do i = 1, nov
     739           ao1(i, 1) = ao(i)
     740           bo1(i, 1) = bo(i)
     741         end do
     742
     743         goto 500
     744       end if
     745
     746 !     **** determine nber of sngl occ alpha and beta orbitals ****
     747
     748       nsng = 0
     749       nalpha = 0
     750       nbeta = 0
 
 FORCHECK PC V13.5.13          SPCLAS          2021-03-24 10:59:30   page:  2486
 excite.F90  /FF
 
     751       do i = 1, nov
     752         if (nel(i).eq.1) then
     753           nsng = nsng + 1
     754           if (nsng > mspn) stop 'NSNG in SPCLAS'
     755           isng(nsng) = i + ncore
     756           if (ao(i)) then
     757             nalpha = nalpha + 1
     758           else
     759             nbeta = nbeta + 1
     760           end if
     761         end if
     762       end do
     763       i = abs (nalpha - nbeta) + 1
     764
     765 !     **** generate all possible perturbations ****
     766
     767       nperm = nfact(nsng) / nfact(nalpha) / nfact(nbeta)
     768       if (nperm > mspn) then
     769         write (iw, *) 'ERROR: max nber of spin components=', mspn, &
     770      &     ' found=', nperm, ' for det:'
     771         write (iw, '(1x, 131l1)') (ao(i), i=1, nov)
     772         write (iw, '(1x, 131l1)') (bo(i), i=1, nov)
     773         stop 'in SPCLAS'
     774       end if
     775
     776       isync = 0
     777       nend = nint (2.D0**nsng)
     778       idet = 1
     779
     780 !     **** PERTS generates next perturbation, is false if all done ****
     781
     782       do idet = 1, nperm
     783         call perms (ao, bo, ao1(1, idet), &
     784      &              bo1(1, idet), isng, nalpha, nbeta, isync, nend)
     785       end do
     786
     787 !     **** calculate the energy matrix for all dets in this class ****
     788
     789       do idet = 1, nperm
     790         e1 = 0.D0
     791
     792         do i1 = nol, nvh
     793           i = i1 - ncore
     794           if (nel(i) > 0) then
     795             e1 = e1 + beta(matind(i1) + i1) * nel(i)
     796
     797 !           **** matrix element <i, i_bar || i, i_bar> ****
     798             if (nel(i).eq.2) then
     799               call inttr (i1, i1, i1, i1, c, gamma, nbtmo, j12, k12, 0)
     800               e1 = e1 + j12
     801             end if
     802
     803 !           **** add core terms sum_j (i, i|j, j) ****
     804             e1 = e1 + eec1 (i1, i1, c, gamma, nbtmo) * nel(i)
     805
     806 !           **** inner loop over all non - core electrons up to current
  one ****
     807             do j1 = nol, i1 - 1
     808               j = j1 - ncore
 
