     176         subroutine unpack_matrix(packed, unpacked, size)
     177           implicit none
     178           integer :: info, i, j
     179           integer , intent(in) :: size
     180           double precision , intent(in) :: packed(*)
     181           double precision , intent(out) :: unpacked(size, size)
     182     !-----------------------------------------------
     183     !******************************************************************
 *****
     184     !
     185     !   CONVERT PACKED UPPER TRIANGLE INTO AN UNPACKED SYMMETRIC MATRIX
     186     !   (LAPACK DTPTTR CALLS & FILLING IN THE REST BY HAND)
     187     !
     188     ! ARGUMENTS:-
     189     !         ON INPUT PACKED   = PACKED UPPER TRIANGLE MATRIX
     190     !                  SIZE     = DIMENSION OF MATRIX
     191     !      ON OUTPUT   UNPACKED = UNPACKED SYMMETRIC MATRIX
     192     !
     193     !******************************************************************
 *****
     194           call dtpttr( 'U', size, packed, unpacked, size, info )
     195           if (info /= 0) stop 'error in dtpttr'
     196           do i = 1, size
     197             do j = i+1, size
     198               unpacked(j,i) = unpacked(i,j)
     199             end do
     200           end do
     201           return
     202           end subroutine unpack_matrix
 
