     196 !
     197 !
     198 !
     199   double precision function C_triple_bond_C()
     200 !
     201 ! Evaluate energy contribution from acetylenic bonds - this is
     202 ! a correction to account for the extra stabilization of yne bonds
     203 !
     204   use common_arrays_C, only : nat, coord, nbonds, ibonds
     205   use molkst_C, only : numat, method_pm6, method_pm7, method_pm8
     206   implicit none
     207   integer :: i, j, isum
     208   double precision :: rab
     209     if ( .not. (method_pm6 .or. method_pm7 .or. method_pm8)) then
     210       C_triple_bond_C = 0.d0
     211       return
     212     end if
     213     isum = 0
     214     do i = 1, numat
     215       if (nat(i) == 6 .and. nbonds(i) == 2) then
     216 !
     217 !  Possible triple bond
     218 !
     219         j = 0
     220         rab = 10.d0
     221         if(nat(ibonds(1,i)) == 6) then
     222          j = ibonds(1,i)
     223          rab = (coord(1,i) - coord(1,j))**2 + (coord(2,i) - coord(2,j))
 **2 + (coord(3,i) - coord(3,j))**2
     224         end if
     225         if(nat(ibonds(2,i)) == 6) then
     226           j = ibonds(2,i)
     227           rab = min(rab, (coord(1,i) - coord(1,j))**2 + &
     228           (coord(2,i) - coord(2,j))**2 + (coord(3,i) - coord(3,j))**2)
     229         end if
     230         if (j == 0) cycle
     231         if (rab > 1.65d0) cycle
     232 !
