    4129   double precision function pol_vol(average)
    4130   use molkst_C, only: numat, method_MNDO, method_AM1, method_PM3, metho
 d_PM6, method_PM7
    4131   use parameters_C, only: polvol
    4132   use common_arrays_C, only: labels
    4133   use funcon_C, only: a0
    4134   implicit none
    4135   !
    4136   !.. Formal Arguments ..
    4137   double precision, intent (in) :: average
    4138   double precision :: polarizability
    4139   integer :: i
    4140   double precision :: C_1, C_2
    4141 !
    4142 !  The corrected polarizability (alpha) is given by:
    4143 !
    4144 !          P = Sum_i C_i  +  P'*C_1 + C_2
    4145 !
    4146 !   where C_i are constants per atom, C_1 and C_2 are constants.
    4147 !
    4148 !  If these constants need to be altered, use v_par in PARAM to get new
  values.
    4149 !
    4150      if (method_MNDO) then
    4151       C_1 = 0.5651170d0
    4152       C_2 = 0.2859620d0
    4153     else if (method_AM1) then
    4154       C_1 = 0.54687d0
    4155       C_2 = 0.321973d0
    4156     else if (method_PM3) then
    4157       C_1 = 0.2465020d0
    4158       C_2 = 0.0d0
    4159      else if (method_PM6) then
    4160       C_1 = 0.791396d0
    4161       C_2 = 0.373638d0
    4162     else if (method_PM7) then
    4163       C_1 =  0.445109d0
    4164       C_2 =  0.351109d0
    4165     else
    4166       C_1 = 0.d0
    4167       C_2 = 0.d0
    4168     end if
    4169     polarizability = average*a0**3
    4170     if (C_1 > 1.d-4) then
    4171       polarizability = polarizability * C_1 + C_2
    4172       do i = 1, numat
    4173         polarizability = polarizability + polvol(labels(i))
    4174       end do
    4175     end if
    4176     pol_vol = polarizability/a0**3
    4177     return
    4178   end function pol_vol
 
