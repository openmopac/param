     221       subroutine surfac()
     222 !-----------------------------------------------
     223 !   M o d u l e s
     224 !-----------------------------------------------
     225       use common_arrays_C, only :geo, coord, labels, nat
     226       use molkst_C, only : numat, natoms
     227       use esp_C, only : nesp, rad, dens, scale, potpt, co, den
     228       use chanel_C, only : iw
     229 !**********************************************************************
 *
     230 !-----------------------------------------------
     231 !   I n t e r f a c e   B l o c k s
     232 !-----------------------------------------------
     233       implicit none
     234 !-----------------------------------------------
     235 !   L o c a l   V a r i a b l e s
     236 !-----------------------------------------------
     237       integer , dimension(numat) :: ias
     238       integer :: icntr, i, ipoint, iatom, nnbr, jatom, ncon
     239       double precision, dimension(100) :: vander
     240       double precision, dimension(3,1000) :: con
     241       double precision, dimension(3,200) :: cnbr
     242       double precision, dimension(200) :: rnbr
     243       double precision, dimension(3) :: ci, temp0
     244       double precision, dimension(3,2) :: cw
     245       double precision :: pi, rw, ri, d2
     246       logical :: si
     247       double precision, external :: distance
     248       logical, external :: collid
     249 !-----------------------------------------------
     250 !**********************************************************************
 *
     251 !
     252 !      THIS SUBROUTINE CALCULATES THE MOLECULAR SURFACE OF A MOLECULE
     253 !      GIVEN THE COORDINATES OF ITS ATOMS.  VAN DER WAALS' RADII FOR
     254 !      THE ATOMS AND THE PROBE RADIUS MUST ALSO BE SPECIFIED.
     255 !
     256 !      ON INPUT    SCALE = INITIAL VAN DER WAALS' SCALE FACTOR
     257 !                  DENS  = DENSITY OF POINTS PER UNIT AREA
     258 !
     259 !      THIS SUBROUTINE WAS LIFTED FROM MICHAEL CONNOLLY'S SURFACE
     260 !      PROGRAM FOR UCSF GRAPHICS SYSTEM BY U.CHANDRA SINGH AND
     261 !      P.A.KOLLMAN AND MODIFIED FOR USE IN QUEST. K.M.MERZ
     262 !      ADAPTED AND CLEANED UP THIS PROGRAM FOR USE IN AMPAC/MOPAC
     263 !      IN FEB. 1989 AT UCSF.
     264 !
     265 !**********************************************************************
 *
     266 !
     267 !
     268 !     NEIGHBOR ARRAYS
     269 !
     270 !     THIS SAME DIMENSION FOR THE MAXIMUM NUMBER OF NEIGHBORS
     271 !     IS USED TO DIMENSION ARRAYS IN THE LOGICAL FUNCTION COLLID
     272 !
     273 !#      DIMENSION INBR(200)
     274 !
     275 !     ARRAYS FOR ALL ATOMS
 
 FORCHECK PC V13.5.13          SURFAC          2021-03-24 10:59:30   page:  3210
 esp.F90  /FF
 
     276 !
     277 !     IATOM, JATOM AND KATOM COORDINATES
     278 !
     279 !
     280 !     GEOMETRIC CONSTRUCTION VECTORS
     281 !
     282 !
     283 !     LOGICAL VARIABLES
     284 !
     285 !
     286 !     LOGICAL FUNCTIONS
     287 !
     288 !
     289 !     DATA FOR VANDER VALL RADII
     290 !
     291       data vander/ 1.20D0, 1.20D0, 1.37D0, 1.45D0, 1.45D0, 1.50D0, 1.50
 D0, &
     292         1.40D0, 1.35D0, 1.30D0, 1.57D0, 1.36D0, 1.24D0, 1.17D0, 1.80D0,
  1.75D0&
     293         , 1.70D0, 17*0.0D0, 2.3D0, 65*0.0D0/
     294 !
     295       pi = 4.D0*atan(1.D0)
     296 !     INSERT VAN DER WAAL RADII FOR ZINC
     297       vander(30) = 1.00D0
     298 !
     299 !     CONVERT INTERNAL TO CARTESIAN COORDINATES
     300 !
     301       call gmetry (geo, coord)
     302 !
     303 !     STRIP COORDINATES AND ATOM LABEL FOR DUMMIES (I.E. 99)
     304 !
     305       icntr = 0
     306       co(:,:numat) = coord(:,:numat)
     307       do i = 1, natoms
     308         if (labels(i) == 99) cycle
     309         icntr = icntr + 1
     310         nat(icntr) = labels(i)
     311       end do
     312 !
     313 !     ONLY VAN DER WAALS' TYPE SURFACE IS GENERATED
     314 !
     315 !#      NESP=0
     316       rw = 0.0D0
     317       numat = icntr
     318       dens = den
     319       do i = 1, numat
     320         ipoint = nat(i)
     321         rad(i) = vander(ipoint)*scale
     322         if (rad(i) < 0.01D0) write (iw, &
     323       '(T2,''VAN DER WAALS'''' RADIUS FOR ATOM '',I3,'' IS ZERO, SUPPLY
  A VALUE IN SUBROUTINE SURFAC)''                )')
     324         ias(i) = 2
     325       end do
     326 !
     327 !     BIG LOOP FOR EACH ATOM
     328 !
     329       do iatom = 1, numat
     330         if (ias(iatom) == 0) cycle
     331 !
 
 FORCHECK PC V13.5.13          SURFAC          2021-03-24 10:59:30   page:  3211
 esp.F90  /FF
 
     332 !     TRANSFER VALUES FROM LARGE ARRAYS TO IATOM VARIABLES
     333 !
     334         ri = rad(iatom)
     335         si = ias(iatom) == 2
     336         ci = co(:,iatom)
     337 !
     338 !     GATHER THE NEIGHBORING ATOMS OF IATOM
     339 !
     340         nnbr = 0
     341         do jatom = 1, numat
     342           if (iatom==jatom .or. ias(jatom)==0) cycle
     343           d2 = distance(iatom,jatom)
     344           if (d2 >= (2*rw + ri + rad(jatom))**2) cycle
     345 !
     346 !     WE HAVE A NEW NEIGHBOR
     347 !     TRANSFER ATOM COORDINATES, RADIUS AND SURFACE REQUEST NUMBER
     348 !
     349           nnbr = nnbr + 1
     350           if (nnbr > 200) then
     351             write (iw, '(''ERROR'',2X,''TOO MANY NEIGHBORS:'',I5)') nnb
 r
     352             call mopend ('ERROR.  TOO MANY NEIGHBORS')
     353             return
     354           end if
     355 !#            INBR(NNBR) = JATOM
     356           cnbr(:,nnbr) = co(:,jatom)
     357           rnbr(nnbr) = rad(jatom)
     358         end do
     359 !
     360 !     CONTACT SURFACE
     361 !
     362         if (.not.si) cycle
     363         ncon = int((4*pi*ri**2)*den)
     364         ncon = min0(1000,ncon)
     365 !
     366 !     THIS CALL MAY DECREASE NCON SOMEWHAT
     367 !
     368         if (ncon == 0) then
     369           write (iw, '(T2,''VECTOR LENGTH OF ZERO IN SURFAC'')')
     370           call mopend ('VECTOR LENGTH OF ZERO IN SURFAC')
     371           return
     372         end if
     373         call genun (con, ncon)
     374 !#         AREA = (4 * PI * RI ** 2) / NCON
     375 !
     376 !     CONTACT PROBE PLACEMENT LOOP
     377 !
     378         do i = 1, ncon
     379           cw(:,1) = ci + (ri + rw)*con(:,i)
     380 !
     381 !     CHECK FOR COLLISION WITH NEIGHBORING ATOMS
     382 !
     383           if (collid(cw(1,1),rw,cnbr,rnbr,nnbr,1)) cycle
     384           temp0 = ci + ri*con(:,i)
     385 !
     386 !     STORE POINT IN POTPT AND INCREMENT NESP
     387 !
     388           nesp = nesp + 1
     389           potpt(1,nesp) = temp0(1)
 
 FORCHECK PC V13.5.13          SURFAC          2021-03-24 10:59:30   page:  3212
 esp.F90  /FF
 
     390           potpt(2,nesp) = temp0(2)
     391           potpt(3,nesp) = temp0(3)
     392         end do
     393       end do
     394       return
     395       end subroutine surfac
 
 FORCHECK PC V13.5.13          SURFAC          2021-03-24 10:59:30   page:  3213
 esp.F90  /FF


