       1 subroutine convert_mat_packed_to_triangle (matrix_packed, matrix_triang
 le)
       2    !*******************************************************************
 ****
       3    !
    *
       4    !        Converts matrix from the storage format used
    *
       5    !        in MOZYME into lower triangular form.
       6    !
    *
       7    !*******************************************************************
 ****
       8     use molkst_C, only: numat, norbs, mpack
       9     use common_arrays_C, only: nfirst, nlast
      10     implicit none
      11     double precision, dimension (norbs*(norbs+1)/2), intent (out) :: &
      12          & matrix_triangle
      13     double precision, dimension (mpack), intent (in) :: matrix_packed
      14     integer :: i, ii, ij, il, iu, j, jj, jl, ju, linear
      15     integer, external :: ijbo
      16    !
      17     linear = (norbs*(norbs+1)) / 2
      18     do i = 1, linear
      19       matrix_triangle(i) = 0.d0
      20     end do
      21     do i = 1, numat
      22       do j = 1, i
      23         if (ijbo(i, j) >= 0) then
      24           ij = ijbo (i, j)
      25           il = nfirst(i)
      26           iu = nlast(i)
      27           jl = nfirst(j)
      28           ju = nlast(j)
      29           do ii = il, iu
      30             do jj = jl, min(ju, ii)
      31               ij = ij + 1
      32               matrix_triangle((ii*(ii-1))/2+jj) = matrix_packed(ij)
      33             end do
      34           end do
      35         end if
      36       end do
      37     end do
      38 end subroutine convert_mat_packed_to_triangle
 
 FORCHECK PC V13.5.13                          2021-03-24 10:59:30   page:  2513
 convert_storage.F90  /FF


