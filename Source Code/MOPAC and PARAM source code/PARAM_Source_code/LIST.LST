     120   subroutine GGJPP_Int(Rab, na, Ca, Za, nb, Cb, Zb, X)
     121     implicit none
     122     double precision, intent(in) :: Rab(3)
     123     integer, intent(in) :: na, nb
     124     double precision, intent(in) :: Ca(na), Za(na)
     125     double precision, intent(in) :: Cb(nb), Zb(nb)
     126     double precision, intent(OUT) :: X( 3, 3 )
     127 !
     128 !  Local variables
     129 !
     130
     131     integer :: i, j
     132     double precision :: r2, r
     133     double precision :: b, br, cc
     134     double precision :: j00, d00dr, d00dr2
     135     double precision :: j10
     136     double precision :: j11
     137     double precision :: e, dedr
     138     double precision :: U(3)
     139     double precision :: dUda(3, 3)
     140     integer :: ix, iy, jx, jy
     141     X = 0.d0
     142     r2 = Rab(1)*Rab(1) + Rab(2)*Rab(2) + Rab(3)*Rab(3)
     143     if ( r2 < 1.d-25 ) then
     144        e = 0.d0
     145        do i=1, na
     146           do j=1, nb
     147              b  = sqrt( Za(i) * Zb(j) / ( Za(i) + Zb(j) ) )
     148              cc = Ca(i) * Cb(j)
     149              e = e + cc * 4.d0 * b**3 / ( 3.d0 * sqrt_PI )
     150           end do
     151        end do
     152        do i=1, 3
     153           X(i, i) = e
     154        end do
     155     else
     156        r = sqrt(r2)
     157        U = Rab/r
     158        do i=1, 3
     159           do j=1, 3
     160              dUda(i, j) = -U(i)*U(j)/r
     161           end do
     162           dUda(i, i) = dUda(i, i) + 1.d0/r
     163        end do
     164        j10 = 0.d0
     165        j11 = 0.d0
     166        do i=1, na
     167           do j=1, nb
     168              b  = sqrt( Za(i) * Zb(j) / ( Za(i) + Zb(j) ) )
     169              br = b * r
     170              cc = Ca(i) * Cb(j)
     171              e     =  (2.d0 / sqrt_PI) * b * EXP(-br*br)
     172              dedr  = -2*b*br * e
     173              j00    = erf(br)/r
     174              d00dr  = e/r - j00/r
     175              d00dr2 = dedr/r - e/r2 - d00dr/r + j00/r2
     176              j10    = j10 + cc * d00dr
     177              j11    = j11 + cc * d00dr2
 
