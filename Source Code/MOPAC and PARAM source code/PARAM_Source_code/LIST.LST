     494   subroutine print_dxyz(header)
     495 !
     496 ! Generic print of the array dxyz.  Use this wherever array dxyz needs
 to be printed
     497 !
     498     use common_arrays_C, only : dxyz, nat
     499 !
     500     USE molkst_C, only : numat, keywrd, l123, l11, l21, l31
     501     USE chanel_C, only : iw
     502     USE elemts_C, only : elemnt
     503 !
     504     implicit none
     505     character :: header*(*)
     506     integer :: i1, j1, k1, i, k, j, l
     507     double precision :: sum
     508     logical :: large
     509     large = index(keywrd,'LARGE') /= 0
     510     write (iw, '(2/10X,''CARTESIAN COORDINATE DERIVATIVES'')')
     511     write (iw, '(7X,a)')trim(header)
     512     if (l123 == 1) then
     513       write (iw, '(/1X, a, /)')" NUMBER ATOM           X
  Y                Z              Total"
     514       write (iw, '(I6,4x,a2,4F17.6)') (i, elemnt(nat(i)),(dxyz(i*3 - 3
 + j), j = 1, 3), &
     515         sqrt(dxyz(i*3)**2 + dxyz(i*3 - 1)**2 + dxyz(i*3 - 2)**2), i = 1
 , numat)
     516     else if (large) then
     517       write (iw, '(/1X, a, /)')"       CELL           ATOM            X
                 Y                Z            Total"
     518       k = 0
     519       l = 0
     520       do i1 = -l11, l11
     521         do j1 = -l21, l21
     522           do k1 = -l31, l31
     523             l = l + 1
     524             do i = 1, numat
     525               k = k + 1
     526               sum = dxyz(k*3 - 2)**2 + dxyz(k*3 - 1)**2 + dxyz(k*3)**2
     527               if (sum > 0.1d0) &
     528               write (iw, '(I6, 2i4, i8, i4, 1x,a2,F13.6,3F17.6)')  i1,
 j1, k1, k, i, &
     529                 elemnt(nat(i)), (dxyz(k*3 - 3 + j), j = 1, 3), sqrt(sum
 )
     530             end do
     531           end do
     532         end do
     533       end do
     534     end if
     535     end subroutine print_dxyz
 
