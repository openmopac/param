      71       if (index(keywrd(i:j), '"')  + index(keywrd(i:j), "'") == 0) then
      72         write(line,'(a)')" File name after GEO_REF must be in quotation
  marks."
      73         call mopend(trim(line))
      74         return
      75       end if
      76       j = index(keywrd(i + 10:),'"')
      77       if (j == 0) then
      78         write(line,'(a)')" File name after GEO_REF must end with a quot
 ation mark."
      79         call mopend(trim(line))
      80         return
      81       end if
      82       do j = i + 10, i + 200
