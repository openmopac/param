     780   subroutine afmm_step2
     781     implicit none
     782     double precision :: dx, dy, dz, tt, r, cos_t, phi
     783     complex (kind=dcmplx_kind) :: tc, tc1
     784     integer :: i, j, j1, k, m, n1, m1, n2, m2
     785     intrinsic Sqrt, Exp, Cmplx, Atan2, Abs, Conjg
     786
     787     !
     788     !       Step 2. For each parent box form a multipole expansion
     789     !       ======  around it's centre by merging multipole expansion
     790     !               from it's children
     791     !
     792     do i = nlev-1, 2, -1
     793       do j = level(i), level(i+1) - 1
     794         do k = 1, b(j)%n_childs
     795           j1 = b(j)%childs(k)
     796
     797           dx = b(j1)%x0 - b(j)%x0
     798           dy = b(j1)%y0 - b(j)%y0
     799           dz = b(j1)%z0 - b(j)%z0
     800
     801           r = Sqrt (dx**2 + dy**2 + dz**2)
     802           cos_t = dz / r
     803           phi = Atan2 (dy, dx)
     804
     805           call get_legendre (p, cos_t, pmn)
     806
     807           do n1 = 0, p
     808            do m1 = 0, n1
     809               tc = Cmplx (0.d0, 0.d0, dcmplx_kind)
     810               do n2 = 0, n1
     811                 do m2 = -n2, n2
     812
     813                   if (Abs (m1-m2) > n1-n2) then
     814                     cycle
     815                   end if
     816
     817                   m = Abs (m1) - Abs (m2) - Abs (m1-m2)
     818
     819                   tt = amn(m2, n2) * amn(m1-m2, n1-n2) &
     820                        & / amn(m1, n1) * r**n2 &
     821                        & * y_norm(-m2, n2) * pmn(-m2, n2)
     822
     823                   tc1 = Exp (Cmplx (0, -m2*phi, dcmplx_kind)) &
     824                        & * b(j1)%phi(m1-m2, n1-n2) &
     825                        & * (Cmplx (0, 1, dcmplx_kind)) **m
     826
     827                   tc = tc + tt * tc1
     828
     829                 end do
     830               end do
     831
     832               b(j)%phi(m1, n1) = b(j)%phi(m1, n1) + tc
     833             end do
     834           end do
     835
     836         end do
     837
 
 FORCHECK PC V13.5.13        AFMM_STEP2        2021-03-24 10:59:30   page:  1130
 afmm_mod.F90  /FF
 
     838         do n1 = 1, p
     839           do m1 = 1, n1
     840             b(j)%phi(-m1, n1) = Conjg (b(j)%phi(m1, n1))
     841           end do
     842         end do
     843       end do
     844     end do
     845   end subroutine afmm_step2
 
