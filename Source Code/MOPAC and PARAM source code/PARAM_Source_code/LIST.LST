     242               if (loc(2,1) == 1) then
     243                 sum = 1.d0
     244               else
     245                 sum = 180/pi
     246               end if
     247               write(line,"(5x,'NEW    ...',f17.8,4f17.7)")alpha, funct,
  funct - fin, xparam(1)*sum
