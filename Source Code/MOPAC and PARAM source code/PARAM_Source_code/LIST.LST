       1 subroutine resetp (mode, loop)
       2     use molkst_C, only : mpack, keywrd
       3     use param_global_C, only : pas, pbs
       4     use common_arrays_C, only : p, pa, pb
       5 !--------------------------------------------------------------------
       6     implicit none
       7     integer, intent (in) :: loop, mode
       8 !--------------------------------------------------------------------
       9     integer :: i
      10     integer, save :: ilin
      11     if (loop == 1) then
      12       ilin = 0
      13     end if
      14     if (mode == 0) then
      15     !
      16     !  Restore density matrix from store (PAS and PBS) to current array
  (P)
      17     !
      18       do i = 1, mpack
      19         pa(i) = pas(i+ilin)
      20         pb(i) = pbs(i+ilin)
      21         p(i) = pa(i) + pb(i)
      22       end do
      23     else
      24     !
      25     !  Store density matrix
      26     !
      27       if(index(keywrd," UHF") /=0)then
      28         do i = 1, mpack
      29           pas(i+ilin) = pa(i)
      30           pbs(i+ilin) = pb(i)
      31         end do
      32       else
      33        do i = 1, mpack
      34           pas(i+ilin) = pa(i)
      35           pbs(i+ilin) = pa(i)
      36         end do
      37       end if
      38     end if
      39     ilin = ilin + mpack
      40 end subroutine resetp
 
