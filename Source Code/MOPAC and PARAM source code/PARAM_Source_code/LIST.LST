       1 subroutine epseta (eps, eta)
       2    !
       3    !.. Implicit Declarations ..
       4     implicit none
       5    !
       6    !.. Formal Arguments ..
       7     double precision, intent (out) :: eps, eta
       8    !
       9    !.. Intrinsic Functions ..
      10     intrinsic Max, Tiny, Epsilon
      11
      12    ! ... Executable Statements ...
      13    !
      14    !     RETURN ETA, THE SMALLEST REPRESENTABLE NUMBER,
      15    !     AND EPS, THE SMALLEST NUMBER FOR WHICH 1+EPS.NE.1.
      16    !
      17     eps = Max (Tiny (1.d0), 1.d-39)
      18     eta = Max (Epsilon (1.d0), 1.d-17)
      19 end subroutine epseta
 
