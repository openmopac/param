     107                 dii = dii + psi1(k-1+kl)*psi1(k-1+kl)
     108                 djj = djj + psi2(k-1+kl)*psi2(k-1+kl)
     109               end do
     110               k = ku + 1
     111             end if
     112             xijjj = xijjj + dij*djj
     113             xjiii = xjiii + dij*dii
     114             xiiii = xiiii + dii*dii
     115             xjjjj = xjjjj + djj*djj
     116             xijij = xijij + dij*dij
