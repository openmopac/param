     422 !     *****************************************************************
 ********
     423
     424       subroutine serch (op, jrels, jsymt, xz, natm, na)
     425
     426       use reimers_C, only: ef
     427
     428       implicit none
     429       integer           i, j, k, na, jrels(na), jsymt(0:8), natm(na)
     430       double precision  tol, xz(na, 3)
     431
     432       logical           op, nm
     433       data tol /1.D-5/
     434
     435 !     **** determins if symm op is present, hence atoms related by symm
  ****
     436
     437       do i = 1, na
     438         jrels(i) = 0
     439       end do
     440       op = .false.
     441       do k = 1, 3
     442         if (jsymt(k) == -1 .and. ef(k).ne.0.0) return
     443       end do
     444
     445       do 300 i = 1, na
     446         if (jrels(i) > 0) goto 300
     447
     448 !       **** check for not moved by symm op ****
     449         nm = .true.
     450         do k = 1, 3
     451           if (jsymt(k) == -1 .and. abs(xz(i, k)) > tol) nm = .false.
     452         end do
     453
     454         if (.not.nm) then
     455
     456 !         **** check for pairs of atoms related by symm ****
     457           do 200 j = 1, na
     458 !           **** check if symmetry pair ****
     459             if (j == i) goto 200
     460             if (natm(i) .ne. natm(j)) goto 200
     461             do k = 1, 3
     462               if (abs(xz(i, k)-xz(j, k)*jsymt(k)) > tol) goto 200
     463             end do
     464 !           **** matching atom found ****
     465             jrels(i) = j
     466             jrels(j) = i
     467             goto 300
     468 200       continue
     469
     470 !         **** only can get here if its moved and no matching atom ****
