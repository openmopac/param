    1327   subroutine setup_nhco(ii)
    1328   USE molmec_C, only : nnhco, nhco, htype
    1329   USE molkst_C, only : numat,  method_am1, method_pm3, method_mndo, met
 hod_pm6, method_PM7, method_rm1, &
    1330    keywrd
    1331   use common_arrays_C, only : nat
    1332   implicit none
    1333   integer, intent (out) :: ii
    1334 !
    1335 !  Local
    1336 !
    1337   integer :: j, i, k, l, m, jj
    1338   double precision, external :: distance
    1339
    1340   nnhco = 0
    1341   !
    1342   !   SET UP MOLECULAR-MECHANICS CORRECTION TO -(C=O)-(NH)- LINKAGE
    1343   !   THIS WILL BE USED IF NOMM HAS NOT BEEN SPECIFIED.
    1344   !
    1345                       htype = 0.d0
    1346     if (method_mndo) htype = 6.1737D0
    1347     if (method_am1)  htype = 3.3191D0
    1348     if (method_pm3)  htype = 7.1853D0
    1349     if (method_rm1)  htype = 2.4127D0
    1350     if (method_pm7)  htype = 3.1595D0
    1351     if (method_pm6)  htype = 2.5000D0
    1352     ii = 0
    1353     if (index(keywrd,'NOMM') /= 0) ii = 1
    1354   !
    1355   !   IDENTIFY O=C-N-H SYSTEMS VIA THE INTERATOMIC DISTANCES MATRIX
    1356   !
    1357   l230: do j = 1, numat
    1358       if (nat(j) /= 6) cycle  l230
    1359       do i = 1, numat
    1360         if (nat(i) /= 8) cycle
    1361         if (distance(i, j) > 1.3D0) cycle
    1362         do k = 1, numat
    1363           if (nat(k) /= 7) cycle
    1364           if (distance(k, j) > 1.6D0) cycle
    1365           do l = 1, numat
    1366             if (nat(l) /= 1) cycle
    1367             if (distance(k, l) > 1.3D0) cycle
    1368   !
    1369   !   WE HAVE A H-N-C=O SYSTEM.  THE ATOM NUMBERS ARE L-K-J-I
    1370   !   NOW SEARCH OUT ATOM ATTACHED TO NITROGEN, THIS SPECIFIES
    1371   !   THE SYSTEM X-N-C=O
    1372   !
    1373             l190: do m = 1, numat
    1374               if (m==k .or. m==l .or. m==j) cycle  l190
    1375               if (distance(m, k) > 1.7D0) cycle  l190
    1376               do jj = 1, nnhco, 2
    1377                 if (nhco(3,jj) /= k) cycle
    1378                 cycle  l190
    1379               end do
    1380               nnhco = nnhco + 1
    1381               nhco(1,nnhco) = i
    1382               nhco(2,nnhco) = j
    1383               nhco(3,nnhco) = k
 
 FORCHECK PC V13.5.13        SETUP_NHCO        2021-03-24 10:59:30   page:  3881
 moldat.F90  /FF
 
    1384               nhco(4,nnhco) = m
    1385               nnhco = nnhco + 1
    1386               nhco(1,nnhco) = i
    1387               nhco(2,nnhco) = j
    1388               nhco(3,nnhco) = k
    1389               nhco(4,nnhco) = l
    1390               if (ii /= 0) then
    1391                 ii = ii + 2
    1392                 nnhco = nnhco - 2
    1393               end if
    1394               cycle  l230
    1395             end do l190
    1396           end do
    1397         end do
    1398       end do
    1399   end do l230
    1400     end subroutine setup_nhco
 
