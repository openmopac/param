       1 subroutine local_for_MOZYME (type)
       2     use molkst_C, only: norbs, numat, nelecs
       3     use MOZYME_C, only : cocc_dim, icocc_dim, &
       4        & cvir_dim, icvir_dim, cocc, icocc, ncf, ncocc, iorbs, nncf, &
       5        & cvir, icvir, nce, ncvir, nnce
       6     use chanel_C, only: iw
       7     implicit none
       8     character (len=*), intent (in) :: type
       9     integer :: i, nocc, nvir, alloc_stat
      10     double precision :: totij, sum
      11     double precision, dimension(:), allocatable :: psi1, psi2, axiiii
      12     integer, dimension(:), allocatable :: nf, nl
      13     integer, dimension(:,:), allocatable :: ioc
      14     allocate (psi1(norbs), psi2(norbs), axiiii(norbs), nf(numat), &
      15          & nl(numat), ioc(2,numat), stat=alloc_stat)
      16     if (alloc_stat /= 0) then
      17       call memory_error ("localz")
      18       goto 1100
      19     end if
      20     if (type == "OCCUPIED") then
      21       nocc = nelecs / 2
      22       !
      23       do i = 1, 100
      24         call localize_for_MOZYME (cocc, cocc_dim, icocc, icocc_dim, ncf
 , ncocc, &
      25              & nocc, iorbs, psi1, psi2, axiiii, nf, nl, ioc, nncf, toti
 j, sum)
      26    !     write (iw, "(10x,'NUMBER OF ITERATIONS =',i4,/,10x,'LOCALIZATI
 ON VALUE =',f14.9)") i, sum
      27         if (totij < 1.d-5) exit
      28       end do
      29       write (iw, "(10x,'NUMBER OF ITERATIONS =',i4,/,10x,'LOCALIZATION
 VALUE =',f14.9,/)") i, sum
      30 !
      31       call MOZYME_eigs(nocc)
      32 !
      33     else if (type == "VIRTUAL") then
      34       nvir = norbs - nelecs / 2
      35       !
      36       do i = 1, 100
      37         call localize_for_MOZYME (cvir, cvir_dim, icvir, icvir_dim, nce
 , ncvir, &
      38              & nvir, iorbs, psi1, psi2, axiiii, nf, nl, ioc, &
      39              & nnce, totij, sum)
      40         if (totij < 1.d-5) exit
      41       end do
      42     else
      43       write (iw,*) " Error"
      44       call mopend ("Error in LOCAL")
      45     end if
      46     deallocate (psi1, psi2, axiiii, nf, nl, ioc)
      47 1100 continue
      48 end subroutine local_for_MOZYME
 
