     325             jj = 0
     326             if (nat(ibonds(2,i)) == 1) jj = 1
     327             if (nat(ibonds(3,i)) == 1) jj = jj + 1
     328             if (nat(ibonds(4,i)) == 1) jj = jj + 1
     329             if ( jj < 2) then
     330               do j = 1,4
