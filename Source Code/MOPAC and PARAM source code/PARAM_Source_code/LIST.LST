     740 subroutine efsav (tt0, hess, funct, grad, xparam, pmat, il, bmat, ipow,
  &
     741      & oldf, d, vmode)
     742   USE maps_C, only : rxn_coord, latom, kloop
     743   use molkst_C, only : nvar, keywrd, nscf, is_PARAM, norbs, numat, mozy
 me, prt_gradients
     744   use common_arrays_C, only : profil
     745   USE ef_C, ONLY: ddx, ef_mode, &
     746    nstep, negreq, alparm, x0, x1, x2, iloop
     747   USE chanel_C, only : iw, ires, restart_fn
     748   implicit none
     749   integer :: il
     750   double precision  :: tt0
     751   double precision  :: funct
     752   integer  :: ipow(9)
     753   double precision  :: hess(nvar,nvar)
     754   double precision  :: grad(nvar), oldf(*), d(nvar), vmode(nvar)
     755   double precision  :: xparam(nvar)
     756   double precision  :: pmat(*)
     757   double precision  :: bmat(nvar,nvar)
     758 !
     759   integer ::  i, j, linear, io_stat, old_numat, old_norbs
     760   double precision :: funct1
     761   logical :: opend
     762   double precision, external :: ddot
     763 !*********************************************************************
     764 !
     765 ! EFSAV STORES AND RETRIEVE DATA USED IN THE EF GEOMETRY
     766 !        OPTIMISATION. VERY SIMILAR TO POWSAV.
     767 !
     768 !  ON INPUT HESS   = HESSIAN MATRIX, PARTIAL OR WHOLE.
     769 !           GRAD   = GRADIENTS.
     770 !           XPARAM = CURRENT STATE OF PARAMETERS.
     771 !           IL     = INDEX OF HESSIAN,
     772 !           JL     = CYCLE NUMBER REACHED SO-FAR.
     773 !           BMAT   = "B" MATRIX!
     774 !           IPOW   = INDICES AND FLAGS.
     775 !           IPOW(9)= 0 FOR RESTORE, 1 FOR DUMP, 2 FOR SILENT DUMP
     776 !
     777 !*********************************************************************
     778   if (is_PARAM) return
     779   inquire(unit=ires, opened=opend)
     780   if (opend) close(unit=ires, status='KEEP')
     781   open(unit=ires, file=restart_fn, status='UNKNOWN', form=&
     782   'UNFORMATTED', position='asis', iostat = io_stat)
     783   if (io_stat /= 0) then
     784     write(iw,*)" Restart file either does not exist or is not available
  for reading"
     785     call mopend ("Restart file either does not exist or is not availabl
 e for reading")
     786     return
     787   end if
     788   rewind ires
     789   if (ipow(9)==1 .or. ipow(9)==2) then
     790     funct1 = dsqrt(ddot(nvar, grad, 1, grad, 1))
     791     if (ipow(9) == 1 .and. index(keywrd,'STEP1') == 0) then
     792       write (iw, '(2/10X,''CURRENT VALUE OF GRADIENT NORM ='',F12.6)')
 funct1
 
