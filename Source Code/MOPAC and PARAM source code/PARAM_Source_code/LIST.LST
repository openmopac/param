     277         iturn = iturn - 5
     278         if (debug) then
     279           write (iw, '(A)') ' after checking 8-18'
     280           write (iw, '(20I3)') ielem
     281         end if
     282 !
     283 !  Now use two adjacent equivalent atoms, not on the
     284 !  Z axis, to define the X-axis.
     285 !
     286         do i = 1, numat
     287           distxy = coord(1,i)**2 + coord(2,i)**2
     288           if (distxy < toler) cycle
     289 !
     290 !   Atom I is the first atom.
 
 FORCHECK PC V13.5.13          MOLSYM          2021-03-24 10:59:30   page:  3556
 molsym.F90  /FF
 
     291 !
     292           rmin = 1000.D0
     293           kndex = 0
     294           do j = i + 1, numat
     295             if (abs(abs(coord(3,i)) - abs(coord(3,j))) > 0.2D0) cycle
     296             rxy = coord(1,j)**2 + coord(2,j)**2
     297             if (abs(rxy - distxy) > toler .or. nat(i) /= nat(j)) cycle
     298 !
     299 !   Atoms i and j are equidistant from the Z axis, and are of the same
 type.
     300 !   Now check that the atoms connected to them are also identical.
     301 !
     302             if (nbonds(i) /= nbonds(j)) cycle
     303             used(:nbonds(i)) = .false.
     304             do k = 1, nbonds(i)
     305               do l = 1, nbonds(j)
     306                 if (nat(ibonds(k,i)) == nat(ibonds(l,j)) .and. .not. us
 ed(l)) exit
     307               end do
     308               if (l <= nbonds(i)) used(l) = .true.
     309             end do
     310             l = 0
     311             do k = 1, nbonds(i)
     312               if (used(k)) l = l + 1
     313             end do
     314             if (l < nbonds(i)) cycle
     315             rxy = (coord(1,i) - coord(1,j))**2 + (coord(2,i) - coord(2,
 j))**2
     316             if (rxy > rmin) cycle
     317             kndex = j
     318             rmin = rxy
     319           end do
     320 !
     321 !   Atom KNDEX is the second, adjacent, atom, equivalent to I.
     322 !
     323           exit
     324         end do
     325         if (kndex < 1) then
     326 !
     327 !  System does not have a Cn axis!  Go back and treat it as an Abelian
     328 !  system.
     329 !
     330           axis = .FALSE.
     331           go to 190
     332         end if
     333         help(1) = coord(1,i) + coord(1,kndex)
     334         help(2) = coord(2,i) + coord(2,kndex)
     335         distxy = sqrt(help(1)**2+help(2)**2)
     336         sina = help(2)/distxy
     337         cosa = help(1)/distxy
     338         call rotmol (numat, coord, sina, cosa, 1, 2, r)
     339 !
     340 !   Is there a Sigma(XZ) plane of symmetry?
     341 !
     342         call chi (toler, coord, 5, iqual)
     343         if (ielem(5) /= 1) then
     344 !
     345 !    Is there a C2(X) axis of rotation?
     346 !
 
 FORCHECK PC V13.5.13          MOLSYM          2021-03-24 10:59:30   page:  3557
 molsym.F90  /FF
 
     347           call chi (toler, coord, 1, iqual)
     348           if (ielem(1) /= 0) then
     349 !
     350 !    Check for an improper axis of rotation.
     351 !
     352             theta = 1.5707963268D0/dble(iturn)
     353             sina = sin(theta)
     354             cosa = cos(theta)
     355             icheck = 0
     356   180       continue
     357             call rotmol (numat, coord, sina, cosa, 1, 2, r)
     358             if (icheck > 0) then
     359               axis = (iturn /= 2)
     360               go to 190
     361             end if
     362             call chi (toler, coord, 5, iqual)
     363             if (ielem(5) > 0) go to 190
     364             icheck = 1
     365             sina = -sina
     366             go to 180
     367           end if
     368         end if
     369       end if
     370   190 continue
     371       if (cubic) call orient (numat, coord, r)
     372       if (debug) then
     373         write (iw, '(A)') ' C2 and sigma-v     '
     374         write (iw, '(20I3)') ielem
     375       end if
     376       if (.not.axis) then
     377         toler = 0.2D0
     378 !
     379 !   Molecule belongs to one of the 8 Abelian groups
     380 !   (C1, C2, Ci, Cs, C2v, D2, C2h, or D2h)
     381 !
     382         do i = 1, 6
     383           call chi (toler, coord, i, iqual)
     384           icyc(i) = (1 + iqual)*ielem(i)
     385         end do
     386         if (reorie) then
     387           naxes = ielem(1) + ielem(2) + ielem(3)
     388 !
     389 !    Special handling for the Abelian Groups:  Determine
     390 !    the principal axis by atom counts.
     391 !
     392           if (naxes <= 1) then
     393             iz = 1
     394             if (ielem(1) == 1) go to 220
     395             iz = 2
     396             if (ielem(2) == 1) go to 220
     397             iz = 3
     398             if (ielem(3) == 1) go to 220
     399             if (icyc(5) > icyc(4)) iz = 2
     400             if (icyc(6) > icyc(7-iz)) iz = 1
     401             go to 220
     402           end if
     403           iz = 1
     404           if (icyc(2) > icyc(1)) iz = 2
     405           if (icyc(3) > icyc(iz)) iz = 3
 
 FORCHECK PC V13.5.13          MOLSYM          2021-03-24 10:59:30   page:  3558
 molsym.F90  /FF
 
     406   220     continue
     407           icyc(7-iz) = -1
     408           ix = 1
     409           if (icyc(5) > icyc(6)) ix = 2
     410           if (icyc(4) > icyc(7-ix)) ix = 3
     411           iy = 6 - ix - iz
     412 !
     413 !  Whew!   Now to re-orient the molecule so the the principal
     414 !  axis is 'Z'
     415 !
     416           rhelp(:,1) = r(:,ix)
     417           rhelp(:,2) = r(:,iy)
     418           rhelp(1,3) = r(2,ix)*r(3,iy) - r(3,ix)*r(2,iy)
     419           rhelp(2,3) = r(3,ix)*r(1,iy) - r(1,ix)*r(3,iy)
     420           rhelp(3,3) = r(1,ix)*r(2,iy) - r(2,ix)*r(1,iy)
     421           call symopr (numat, coord, -1, r)
     422           r = rhelp
     423           call symopr (numat, coord, 1, r)
     424         end if
     425 !
     426 !   And re-calculate the first 7 Characters.
     427 !   (C2(X), C2(Y), C2(Z), Sigma(XY), Sigma(XZ), Sigma(YZ), i)
     428 !
     429       end if
     430   250 continue
     431       do i = 1, 7
     432         call chi (toler, coord, i, iqual)
     433       end do
     434       if (debug) then
     435         write (iw, '(A)') ' After re-doing 1-7'
     436         write (iw, '(20I3)') ielem
     437       end if
     438   270 continue
     439       call symopr (numat, coord, -1, r)
     440       total = ew(1) + ew(2) + ew(3)
     441       ew = total - ew
     442       call cartab
     443       return
     444       end subroutine molsym
 
