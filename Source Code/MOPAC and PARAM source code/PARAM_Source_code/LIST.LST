      82       subroutine bintgs(x, k)
      83 !-----------------------------------------------
      84 !   M o d u l e s
      85 !-----------------------------------------------
      86       USE overlaps_C, only : b, fact
      87       implicit none
      88 !-----------------------------------------------
      89 !   D u m m y   A r g u m e n t s
      90 !-----------------------------------------------
      91       integer , intent(in) :: k
      92       double precision , intent(in) :: x
      93 !-----------------------------------------------
      94 !   L o c a l   V a r i a b l e s
      95 !-----------------------------------------------
      96       integer :: io, last, i, m
      97       double precision :: absx, expx, expmx, y, xf
      98 !-----------------------------------------------
      99 !**********************************************************************
     100 !
     101 !     BINTGS FORMS THE "B" INTEGRALS FOR THE OVERLAP CALCULATION.
     102 !
     103 !**********************************************************************
     104       io = 0
     105       absx = abs(x)
     106       if (absx > 3.D00) go to 40
     107       if (absx > 2.D00) then
     108         if (k <= 10) go to 40
     109         last = 15
     110         go to 60
     111       end if
     112       if (absx > 1.D00) then
     113         if (k <= 7) go to 40
     114         last = 12
     115         go to 60
     116       end if
     117       if (absx > 0.5D00) then
     118         if (k <= 5) go to 40
     119         last = 7
     120         go to 60
     121       end if
     122       if (absx <= 1.D-6) go to 90
     123       last = 6
     124       go to 60
     125    40 continue
     126       expx = exp(x)
     127       expmx = 1.D00/expx
     128       b(1) = (expx - expmx)/x
     129       do i = 1, k
     130         b(i+1) = (i*b(i)+(-1.D00)**i*expx-expmx)/x
     131       end do
     132       go to 110
     133    60 continue
     134       do i = io, k
     135         y = 0.0D00
     136         do m = io, last
     137           xf = 1.0D00
     138           if (m /= 0) xf = fact(m)
     139           y = y + (-x)**m*(2*mod(m + i + 1,2))/(xf*(m + i + 1))
 
 FORCHECK PC V13.5.13          BINTGS          2021-03-24 10:59:30   page:  1581
 set.F90  /FF
 
     140         end do
     141         b(i+1) = y
     142       end do
     143       go to 110
     144    90 continue
     145       do i = io, k
     146         b(i+1) = (2*mod(i + 1,2))/(i + 1.D0)
     147       end do
     148   110 continue
     149       return
     150 !
     151       end subroutine bintgs
 
