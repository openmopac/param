       1 double precision function dipole_for_MOZYME (dipvec, mode)
       2     use molkst_C, only: numcal, numat, keywrd
       3     use chanel_C, only: iw
       4     use MOZYME_C, only : iorbs
       5     use common_arrays_C, only : nat, q, p, coord
       6     use parameters_C, only: dd, ams, ddp
       7     use funcon_C, only: fpc_8, fpc_1, a0
       8     implicit none
       9     double precision, intent(out) :: dipvec(3)
      10     integer, intent (in) :: mode
      11 !.
      12     logical, save :: chargd, first, force
      13     integer, save :: icalcn = 0
      14     integer :: i, j, k, l, ni
      15     double precision :: const, sum, dx, dy, dz, hyfpd, xt
      16     double precision, save :: wtmol_loc
      17     double precision, dimension (3) :: center
      18     double precision, dimension (107), save :: hyf
      19     double precision, dimension (4, 3), save :: dip
      20     integer, external :: ijbo
      21     data hyf(1) / 0.0d00 /
      22     first = (icalcn /= numcal)
      23     icalcn = numcal
      24    !
      25    !   CONST = c.C.a0.2
      26    !
      27     const = fpc_8 * fpc_1 * a0 * 2.d0 * 1.d-10
      28     if (first) then
      29       hyf(2:107) = const * dd(2:107)
      30       wtmol_loc = 0.d0
      31       sum = 0.d0
      32       do i = 1, numat
      33         wtmol_loc = wtmol_loc + ams(nat(i))
      34         sum = sum + q(i)
      35       end do
      36       chargd = (Abs (sum) > 0.5d0)
      37       force = index(keywrd,'FORCE') + index(keywrd," THERMO") + index(k
 eywrd,'IRC') /= 0
      38     end if
      39     if (chargd) then
      40       !
      41       !   NEED TO RESET ION'S POSITION SO THAT THE CENTER OF MASS IS AT
  THE
      42       !   ORIGIN.
      43       !
      44       center = 0.d0
      45       do i = 1, 3
      46         do j = 1, numat
      47           center(i) = center(i) + ams(nat(j)) * coord(i, j)
      48         end do
      49       end do
      50       center = center / wtmol_loc
      51       do i = 1, 3
      52         do j = 1, numat
      53           coord(i, j) = coord(i, j) - center(i)
      54         end do
      55       end do
      56     end if
 
 FORCHECK PC V13.5.13    DIPOLE_FOR_MOZYME     2021-03-24 10:59:30   page:  2047
 dipole_for_MOZYME.F90  /FF
 
      57     dip = 0.0d00
      58     do i = 1, numat
      59       ni = nat(i)
      60       l = iorbs(i) - 1
      61       if (l >= 3) then
      62         do j = 1, 3
      63           k = ijbo (i, i) + 1 + (j*(j+1)) / 2
      64           dip(j, 2) = dip(j, 2) - hyf(ni) * p(k)
      65         end do
      66         if (l == 8) then
      67           xt = 1.d0 / Sqrt (3.d00)
      68           hyfpd = 2.0d0 * ddp(5, ni) * a0 * fpc_8 * fpc_1 * 1.d-10
      69           k = ijbo (i, i)
      70           !
      71           ! x:   <x|x|x2-y2> + <z|x|xz> - 1/root(3)<x|x|z2> + <y|x|xy>
      72           ! y: - <y|y|x2-y2> - 1/root(3)<y|y|z2> + <z|y|yz> + <x|y|xy>
      73           ! z:   <x|z|xz> + 2/root(3)<z|z|z2> + <y|z|yz>
      74           !
      75           dx = p(k+12) + p(k+19) - p(k+23) * xt + p(k+39)
      76           dy = -p(k+13) - p(k+24) * xt + p(k+32) + p(k+38)
      77           dz = p(k+17) + 2.d0 * p(k+25) * xt + p(k+31)
      78           dip(1, 2) = dip(1, 2) - dx * hyfpd
      79           dip(2, 2) = dip(2, 2) - dy * hyfpd
      80           dip(3, 2) = dip(3, 2) - dz * hyfpd
      81         end if
      82       end if
      83       do j = 1, 3
      84          !
      85          !  FPC(8)=SPEED OF LIGHT,  FPC(1)=CHARGE ON ELECTRON.
      86          !
      87         dip(j, 1) = dip(j, 1) + fpc_8 * fpc_1 * 1.d-10 * q(i) * coord(j
 , i)
      88       !
      89       !  FPC(8)=SPEED OF LIGHT,  FPC(1)=CHARGE ON ELECTRON.
      90       !
      91       end do
      92     end do
      93     do j = 1, 3
      94       dip(j, 3) = dip(j, 2) + dip(j, 1)
      95     end do
      96     dip(4, :) = Sqrt (dip(1, :)**2+dip(2, :)**2+dip(3, :)**2)
      97     if (force) then
      98       dipvec(1) = dip(1,3)
      99       dipvec(2) = dip(2,3)
     100       dipvec(3) = dip(3,3)
     101     end if
     102     dipole_for_MOZYME = dip(4, 3)
     103     if ( chargd) then
     104       do i = 1, 3
     105         coord(i, :numat) = coord(i, :numat) + center(i)
     106       end do
     107     end if
     108     if (mode == 0) return
     109    !
     110 10000 format (" DIPOLE", 11x, "X         Y         Z       TOTAL", / &
     111    & , " POINT-CHG.", 4f10.3/, " HYBRID", 4x, 4f10.3/, " SUM", 7 x, 4 f
 10.3)
     112     write (iw, 10000) ((dip(i, j), i=1, 4), j=1, 3)
     113 !
 
