      81        subroutine pdgrid()
      82 !-----------------------------------------------
      83 !   M o d u l e s
      84 !-----------------------------------------------
      85       use molkst_C, only : numat, natoms
      86       use common_arrays_C, only : geo, coord, labels, nat
      87       use esp_C, only : nesp, potpt, co
      88       use chanel_C, only : iw
      89 !
      90 !     ROUTINE TO CALCULATE WILLIAMS SURFACE
      91 !
      92 !**********************************************************************
 *
      93 !-----------------------------------------------
      94 !   I n t e r f a c e   B l o c k s
      95 !-----------------------------------------------
      96       implicit none
      97 !-----------------------------------------------
      98 !   L o c a l   V a r i a b l e s
      99 !-----------------------------------------------
     100       integer :: icntr, i, j, ia, npnt, l, jz
     101       double precision, dimension(53) :: vderw
     102       double precision, dimension(100) :: dist
     103       double precision, dimension(3) :: xmin, xmax
     104       double precision :: shell, grid, closer, vdmax, xstart, ystart, z
 start, zgrid&
     105         , ygrid, xgrid
     106 !-----------------------------------------------
     107 !
     108       data vderw/ 53*0.0D0/
     109       vderw(1) = 2.4D0
     110       vderw(5) = 3.0D0
     111       vderw(6) = 2.9D0
     112       vderw(7) = 2.7D0
     113       vderw(8) = 2.6D0
     114       vderw(9) = 2.55D0
     115       vderw(15) = 3.1D0
     116       vderw(16) = 3.05D0
     117       vderw(17) = 3.0D0
     118       vderw(35) = 3.15D0
     119       vderw(53) = 3.35D0
     120       shell = 1.2D0
     121       nesp = 0
     122       grid = 0.8D0
     123       closer = 0.D0
     124 !     CHECK IF VDERW IS DEFINED FOR ALL ATOMS
     125 !
     126 !     CONVERT INTERNAL TO CARTESIAN COORDINATES
     127 !
     128       call gmetry (geo, coord)
     129 !
     130 !     STRIP COORDINATES AND ATOM LABEL FOR DUMMIES (I.E. 99)
     131 !
     132       icntr = 0
     133       do i = 1, natoms
     134         co(:,i) = coord(:,i)
     135         if (labels(i) == 99) cycle
     136         icntr = icntr + 1
 
 FORCHECK PC V13.5.13          PDGRID          2021-03-24 10:59:30   page:  3205
 esp.F90  /FF
 
     137         nat(icntr) = labels(i)
     138       end do
     139       numat = icntr
     140 !
     141       do i = 1, numat
     142         j = nat(i)
     143         if (vderw(j) == 0.0D0) go to 40
     144       end do
     145       go to 50
     146    40 continue
     147       write (iw, *) 'VAN DER WAALS'' RADIUS NOT DEFINED FOR ATOM', i
     148       write (iw, *) 'IN WILLIAMS SURFACE ROUTINE PDGRID!'
     149       call mopend (&
     150       'VAN DER WAALS'' RADIUS NOT DEFINED FOR ATOM IN WILLIAMS SURFACE
 ROUTINE &
     151       &PDGRID!')
     152       return
     153 !     NOW CREATE LIMITS FOR A BOX
     154    50 continue
     155       xmin = 100000.0D0
     156       xmax = -100000.0D0
     157       do ia = 1, numat
     158         where (co(:,ia) - xmin < 0.D0)
     159           xmin = co(:,ia)
     160         end where
     161         where (co(:,ia) - xmax > 0.D0)
     162           xmax = co(:,ia)
     163         end where
     164       end do
     165 !     ADD (OR SUBTRACT) THE MAXIMUM VDERW PLUS SHELL
     166       vdmax = 0.0D0
     167       vdmax = dmax1(maxval(vderw),vdmax)
     168       xmin = xmin - vdmax - shell
     169       xmax = xmax + vdmax + shell
     170 ! STEP GRID BACK FROM ZERO TO FIND STARTING POINTS
     171       xstart = 0.0D0
     172       xstart = xstart - grid
     173       do while(xstart > xmin(1))
     174         xstart = xstart - grid
     175       end do
     176       ystart = 0.0D0
     177       ystart = ystart - grid
     178       do while(ystart > xmin(2))
     179         ystart = ystart - grid
     180       end do
     181       zstart = 0.0D0
     182       zstart = zstart - grid
     183       do while(zstart > xmin(3))
     184         zstart = zstart - grid
     185       end do
     186       npnt = 0
     187       zgrid = zstart
     188   160 continue
     189       ygrid = ystart
     190   170 continue
     191       xgrid = xstart
     192   180 continue
     193       do l = 1, numat
     194         jz = nat(l)
 
 FORCHECK PC V13.5.13          PDGRID          2021-03-24 10:59:30   page:  3206
 esp.F90  /FF
 
     195         dist(l) = sqrt((co(1,l)-xgrid)**2+(co(2,l)-ygrid)**2+(co(3,l)-z
 grid)**2)
     196 !     REJECT GRID POINT IF ANY ATOM IS TOO CLOSE
     197         if (dist(l) < vderw(jz) - closer) go to 220
     198       end do
     199 ! BUT AT LEAST ONE ATOM MUST BE CLOSE ENOUGH
     200       do l = 1, numat
     201         jz = nat(l)
     202         if (dist(l) > vderw(jz) + shell) cycle
     203         go to 210
     204       end do
     205       go to 220
     206   210 continue
     207       npnt = npnt + 1
     208       nesp = nesp + 1
     209       potpt(1,nesp) = xgrid
     210       potpt(2,nesp) = ygrid
     211       potpt(3,nesp) = zgrid
     212   220 continue
     213       xgrid = xgrid + grid
     214       if (xgrid <= xmax(1)) go to 180
     215       ygrid = ygrid + grid
     216       if (ygrid <= xmax(2)) go to 170
     217       zgrid = zgrid + grid
     218       if (zgrid <= xmax(3)) go to 160
     219       return
     220       end subroutine pdgrid
 
 FORCHECK PC V13.5.13          PDGRID          2021-03-24 10:59:30   page:  3207
 esp.F90  /FF


