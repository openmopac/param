     495   character (len = 300) function get_text(line, i_start, zero)
     496     implicit none
     497     character :: line*(*)
     498     integer :: i_start, zero
     499 !
     500 !  Return text between character i_start and the next space.
     501 !  If character i_start is '"' or ''', return text between character i_
 start + 1 and the closing character.
     502 !
     503     integer, parameter :: num_lim = 2
     504     character :: limit(num_lim)*1, ch*1
     505     integer :: i, j
     506     data limit /"""","'"/
     507     do i = 1, num_lim
     508       if (line(i_start:i_start) == limit(i)) exit
     509     end do
     510     j = i_start
     511     if (i > num_lim) then
     512       ch = " "
     513       i = i_start
     514     else
     515       j = j + 1
     516       ch = limit(i)
     517       i = i_start + 1
     518     end if
     519     do
     520       if (line(i + 1:i + 1) == ch) exit
     521       i = i + 1
     522     end do
     523     get_text = line(j:i)
     524     if (zero == 0) line(i_start:i + 1) = " "
     525     return
     526   end function get_text
 
