       1 subroutine selmos (nmos_loc, nc, ic, n01, c, n02, nnc_loc, ncmo, ln, mn
 , iws, &
       2 & jopt, ncnew, ncmnew, nncnew, mode)
       3     use molkst_C, only: numat
       4     use MOZYME_C, only : numred, nelred, norred
       5     use chanel_C, only: iw
       6     implicit none
       7     integer, intent (in) :: ln, mn, mode, n01, n02, nmos_loc
       8     integer, dimension (n01), intent (inout) :: ic
       9     integer, dimension (nmos_loc), intent (inout) :: iws, nc, ncmnew, n
 cmo, &
      10    & ncnew, nnc_loc, nncnew
      11     integer, dimension (numat), intent (in) :: jopt
      12     double precision, dimension (n02), intent (inout) :: c
      13     integer :: i, ibot, itop, j, jbot, jtop, l, l1, l2, m, n, nbot, nco
 efs, &
      14    & nreal, ntop
      15    !
      16    !   Move LMOs for atoms in JOPT to start of storage space
      17    !
      18    !    MN, LN   = END OF STORAGE ALREADY USED
      19    !    N02, N01 = END OF STORAGE
      20    !
      21    !   FIRST, MOVE ALL VECTORS TO END OF STORAGE
      22    !
      23     l = n02 - mn
      24     do i = mn, 1, -1
      25       c(i+l) = c(i)
      26     end do
      27    !
      28    !  Modify pointers
      29    !
      30     do i = 1, nmos_loc
      31       ncmo(i) = ncmo(i) + l
      32     end do
      33    !
      34    !  Move atom addresses
      35    !
      36     l = n01 - ln
      37     do i = ln, 1, -1
      38       ic(i+l) = ic(i)
      39     end do
      40    !
      41    !  Modify atom address pointers
      42    !
      43     do i = 1, nmos_loc
      44       nnc_loc(i) = nnc_loc(i) + l
      45     end do
      46    !
      47    !        NBOT       refers to IC                -> IC
      48    !        JBOT, JTOP refer to C                  -> C
      49    !        IBOT, ITOP refer to NC, NNC, and NCMO -> NCNEW, NNCNEW, NCM
 NEW
      50    !
      51    !   Select those LMOs that are to be used in the SCF.  Move these to
  the
      52    !   start of the storage
      53    !
 
 FORCHECK PC V13.5.13          SELMOS          2021-03-24 10:59:30   page:  4219
 selmos.F90  /FF
 
      54     jbot = 0
      55     nbot = 0
      56     jtop = n02 - mn - 1
      57     ntop = n01 - ln - 1
      58     ibot = 0
      59     itop = nmos_loc + 1
      60     nreal = 0
      61    !
      62    !   Put number of coefficients into IWS.
      63    !
      64     do i = nmos_loc, 2, -1
      65       iws(i) = iws(i) - iws(i-1)
      66     end do
      67     do i = 1, nmos_loc
      68       l = nnc_loc(i)
      69       l1 = ic(1+l)
      70       l2 = ic(2+l)
      71       do m = 1, numred
      72         if (l1 == jopt(m) .or. l2 == jopt(m)) go to 1000
      73       end do
      74       !
      75       ! PUT VECTOR AT END OF IC AND C.  This is the default: the LMO is
      76       ! NOT selected.
      77       !
      78       itop = itop - 1
      79       nncnew(itop) = nnc_loc(i)
      80       ncnew(itop) = nc(i)
      81       ncmnew(itop) = ncmo(i)
      82       cycle
      83 1000  if (nbot+nc(i) > ntop .or. jbot+iws(i) > jtop) then
      84         !
      85         !   There is no space for the remaining vectors.  Remove unused
  space
      86         !   from between the vectors that will not be used in the SCF.
      87         !
      88         call compct (nncnew, ncnew, ncmnew, itop, nc, ic, iws, n01, c,
 n02, &
      89        & nmos_loc, i, ntop, jtop, l, ncmo(i))
      90       end if
      91       !
      92       ! PUT VECTOR AT START OF IC AND C
      93       !
      94       ibot = ibot + 1
      95       nncnew(ibot) = nbot
      96       ncnew(ibot) = nc(i)
      97       ncmnew(ibot) = jbot
      98       do n = 1, nc(i)
      99         ic(nbot+n) = ic(l+n)
     100       end do
     101       nbot = nbot + nc(i)
     102       nc(i) = 0
     103       j = ncmo(i)
     104       ncoefs = iws(i)
     105       do n = 1, ncoefs
     106         c(jbot+n) = c(j+n)
     107       end do
     108       jbot = jbot + ncoefs
     109       nreal = nreal + 1
     110     end do
 
 FORCHECK PC V13.5.13          SELMOS          2021-03-24 10:59:30   page:  4220
 selmos.F90  /FF
 
     111     do i = 1, ibot
     112       nc(i) = ncnew(i)
     113       nnc_loc(i) = nncnew(i)
     114       ncmo(i) = ncmnew(i)
     115     end do
     116     j = nmos_loc + 1
     117     do i = itop, nmos_loc
     118       j = j - 1
     119       nc(i) = ncnew(j)
     120       nnc_loc(i) = nncnew(j)
     121       ncmo(i) = ncmnew(j)
     122     end do
     123    !
     124    !  HAVE ARRAY BOUNDS BEEN DAMAGED?
     125    !
     126     if (jbot > jtop) then
     127       if (mode == 1) then
     128         write (iw,*) " OCCUPIED C VECTOR DAMAGED IN SELMOS"
     129         write (iw,*) " (THIS IS A BUG IN THE PROGRAM)"
     130       else
     131         write (iw,*) " VIRTUAL C VECTOR DAMAGED IN SELMOS"
     132         write (iw,*) "  (THIS IS A BUG IN THE PROGRAM)"
     133       end if
     134       call mopend ("BUG IN SELMOS")
     135     end if
     136     if (nbot > ntop) then
     137       if (mode == 1) then
     138         write (iw,*) " OCCUPIED IC VECTOR DAMAGED IN SELMOS"
     139         write (iw,*) "  (THIS IS A BUG IN THE PROGRAM)"
     140       else
     141         write (iw,*) " VIRTUAL IC VECTOR DAMAGED IN SELMOS"
     142         write (iw,*) "  (THIS IS A BUG IN THE PROGRAM)"
     143       end if
     144       call mopend ("BUG IN SELMOS")
     145     end if
     146     if (mode == 1) then
     147       !
     148       !   Number of electrons to be used in the SCF is NELRED.
     149       !
     150       nelred = 2 * nreal
     151     else
     152       !
     153       !   Number of LMOs to be used in the SCF is NORRED.
     154       !
     155       norred = nreal + nelred / 2
     156     end if
     157     norred = norred
     158     nelred = nelred
     159 end subroutine selmos
 
