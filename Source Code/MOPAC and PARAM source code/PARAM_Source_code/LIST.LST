       1       double precision function seconds (mode)
       2 !
       3 !  If mode = 1:   Get current CPU time - CPU_0, and return without chec
 king for <file>.end
       4 !     mode = 2:   Get current CPU time - CPU_0, and return after checki
 ng for <file>.end,
       5 !                 if <file>.end exists, and contains anything, increase
  time by 10^8 seconds.
       6 !
       7       USE chanel_C, only : iw, iend, end_fn, output_fn
       8       use molkst_C, only : is_PARAM, wall_clock_0, wall_clock_1, CPU_1,
  CPU_0, prt_coords
       9       implicit none
      10       integer , intent(in) :: mode
      11       double precision :: shut
      12       logical :: setok, exists, first = .true., opend
      13       character :: x
      14       integer :: i99, l
      15       integer :: itim1(8), ihour, imin, isec, imsec, jhour = 100, idays
  = -1
      16       save
      17 !******************************************************
      18 !
      19 !   SECONDS, ON EXIT, CONTAINS THE NUMBER OF CPU SECONDS
      20 !   SINCE THE START OF THE CALCULATION.
      21 !
      22 !   NOTE: THIS FUNCTION WAS NAMED 'SECOND' IN OLDER
      23 !         MOPAC VERSIONS, WHICH IS THE NAME OF A GNU
      24 !         FORTRAN INTRINSIC FUNCTION
      25 !
      26 !******************************************************
      27       data setok/ .TRUE./
      28       data shut/ 0.D0/
      29       seconds = 0.D0 ! dummy time upon failure
      30       if (first) then
      31         first = .false.
      32 !
      33 !   CHECK TO SEE IF AN OLD '.end' FILE EXISTS.  IF IT DOES, DELETE IT.
      34 !
      35         rewind iend
      36         open(unit=iend, file=end_fn, status='UNKNOWN', position='asis',
  iostat = i99)
      37         if (i99 /= 0) then
      38           write(iw,"(a)")" File '"//trim(end_fn)//"' is unavailable for
  use"
      39           write(iw,"(a)")" Correct the error and re-submit"
      40           call to_screen(" File '"//trim(end_fn)//"' is unavailable for
  use")
      41           call to_screen(" Correct the error and re-submit")
      42           call mopend("File '"//trim(end_fn)//"' is unavailable for use
 ")
      43           return
      44         end if
      45         read (iend, '(A)', end=20, err=20, iostat = i99) x
      46 !
      47 !   FILE EXISTS.  DELETE IT.
      48 !
      49         if (ichar(x) /= (-1)) close(iend, status='DELETE')
 
 FORCHECK PC V13.5.13         SECONDS          2021-03-24 10:59:30   page:   272
 seconds.F90  /FF
 
      50 !
      51 !  Set the zero of time
      52 !
      53 20      call cpu_time(CPU_0)
      54         call date_and_time(values = itim1)
      55         ihour = itim1(5)
      56         imin  = itim1(6)
      57         isec  = itim1(7)
      58         imsec = itim1(8)
      59         wall_clock_0 = float(3600*ihour + 60*imin + isec) + (float(imse
 c)/1.e3 )
      60       end if
      61
      62 !**********************************************************************
      63 !
      64 !   NOW TO SEE IF A FILE CALLED <FILENAME>.end EXISTS, IF IT DOES
      65 !   THEN INCREMENT CPU TIME BY 10,000,000 SECONDS.
      66 !
      67 !**********************************************************************
 *
      68       if (mode == 2) then
      69         shut = 0.D0
      70         inquire (file=end_fn, exist = exists)
      71         if (exists) then
      72           open(unit=iend, file=end_fn, status='UNKNOWN', position='asis
 ', iostat=i99)
      73           if (i99 /= 0) then
      74             close(iend, err=99)   ! Do not stop job if shutdown is faul
 ty
      75     99      return
      76           end if
      77           read (iend, '(A)', end=10, err=10) x
      78   !
      79   !          FILE EXISTS, THEREFORE INCREMENT TIME
      80   !
      81           shut = 1.D7
      82           if (setok) then
      83             write (iw, '(3/10X,''****   JOB STOPPED BY OPERATOR   ****'
 ')')
      84             if (prt_coords) then
      85               write (iw, '(3/10X,''****   GEOMETRY AT THIS POINT    ***
 *'')')
      86               call geout (1)
      87             end if
      88             setok = .FALSE.
      89           end if
      90      10   continue
      91           close(iend, iostat = i99)
      92         end if
      93       end if
      94 !
      95 !  Every call to second executes the following code
      96 !
      97       call cpu_time(CPU_1)
      98       call date_and_time(values = itim1)
      99       ihour = itim1(5)
     100       if (ihour < jhour) idays = idays + 1
     101       jhour = ihour
     102       ihour = ihour + 24*idays
 
 FORCHECK PC V13.5.13         SECONDS          2021-03-24 10:59:30   page:   273
