  'GEO-OK'"
    1057         return
    1058         end if
    1059       end if
    1060       l1u = Int ((cutofp*4.d0/3.d0)/tv1) + 1
    1061       l2u = Int ((cutofp*4.d0/3.d0)/tv2) + 1
    1062       l3u = Int ((cutofp*4.d0/3.d0)/tv3) + 1
    1063     end if
    1064     l123 = (2*l1u + 1)*(2*l2u + 1)*(2*l3u + 1)
    1065     l11 = min(l1u,1)
    1066     l21 = min(l2u,1)
    1067     l31 = min(l3u,1)
    1068 end subroutine setcup
 
