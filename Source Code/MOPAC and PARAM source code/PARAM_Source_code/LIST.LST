     741   logical function peptide_n(l)
     742     use common_arrays_C, only : nat, ibonds, nbonds
     743     implicit none
     744     integer :: l
     745     integer :: i, j, k, nc, nh, nco
     746     if (nat(l) /= 7) then
     747       peptide_n = .false.
     748       return
     749     else
     750 !
     751 !  "l" is a nitrogen.  Check that it has three bonds, two to carbon and
  one to hydrogen,
     752 !  and that one carbon is attached to an oxygen
     753 !
     754       if (nbonds(l) /= 3) then
     755         peptide_n = .false.
     756         return
     757       end if
     758       nc = 0
     759       nh = 0
     760       nco = 0
     761       do i = 1, 3
     762         if (nat(ibonds(i,l)) == 6)then
     763           nc = nc + 1
     764           k = ibonds(i,l)
     765           if (nbonds(k) == 3) then
     766             do j = 1, 3
     767               if (nat(ibonds(j,k)) == 8) then
     768                 if (nbonds(ibonds(j,k)) == 1) then
     769                   nco = nco + 1
     770                 else
     771                   peptide_n = .false.         ! Structure N-C-O-R detec
 ted
     772                   return
     773                 end if
     774               end if
     775             end do
     776           else if (nbonds(k) == 4) then
     777             do j = 1, 4
     778               if (nat(ibonds(j,k)) == 8) then ! Structure N-C-O-R detec
 ted
     779                 peptide_n = .false.
     780                 return
     781               end if
     782             end do
     783           end if
     784         end if
     785         if (nat(ibonds(i,l)) == 1) nh = nh + 1
     786       end do
     787       if (nc /= 2 .or. nh /= 1 .or. nco /= 1) then
     788         peptide_n = .false.   ! Structure C-NH-C=O not detected
     789         return
     790       end if
     791 !
     792 !  "l" is a nitrogen.  Check that it has three bonds, two to carbon and
  one to hydrogen
     793 !
     794       peptide_n = .true.
 
 FORCHECK PC V13.5.13        PEPTIDE_N         2021-03-24 10:59:30   page:  1884
 atomrs.F90  /FF
 
     795       return
     796     end if
     797   end function peptide_n
 
