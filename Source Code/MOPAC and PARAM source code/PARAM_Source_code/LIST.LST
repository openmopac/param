       1       double precision function charvi (vects, jorb, ioper, r, nvecs)
       2 !-----------------------------------------------
       3 !   M o d u l elem s
       4 !-----------------------------------------------
       5       use symmetry_C, only : elem, jelem
       6       use molkst_C, only : numat
       7 !**********************************************************************
 *
       8       implicit none
       9 !-----------------------------------------------
      10 !   G l o b a l   P a r a m elem t elem r s
      11 !-----------------------------------------------
      12 !-----------------------------------------------
      13 !   D u m m y   A r g u m elem n t s
      14 !-----------------------------------------------
      15       integer , intent(in) :: jorb
      16       integer , intent(in) :: ioper
      17       integer , intent(in) :: nvecs
      18       double precision , intent(in) :: vects(nvecs,nvecs)
      19       double precision , intent(in) :: r(3,3)
      20 !-----------------------------------------------
      21 !   L o c a l   V a r i a b l elem s
      22 !-----------------------------------------------
      23       integer :: iatom, jatom
      24       double precision, dimension(:), allocatable :: vect1, vect2
      25       double precision, dimension(5) :: h
      26       double precision, dimension(3) :: p
      27       double precision :: sum
      28 ! For Mopac BLAS
      29       double precision, external :: ddot
      30 !
      31
      32 !-----------------------------------------------
      33       charvi = 1.D0
      34       if (ioper == 1) return
      35 !
      36 !   Non-trivial case
      37 !
      38       allocate(vect1(nvecs), vect2(nvecs))
      39       vect1(:nvecs) = 0.D0
      40       vect2(:nvecs) = 0.D0
      41 !#      WRITE(IW,*)' Vibration, raw'
      42 !#      WRITE(IW,'(3f12.6)')(VECTS(i,jorb),i=1,3*NUMAT)
      43       do iatom = 1, numat
      44         jatom = jelem(ioper,iatom)
      45         p(1) = vects(iatom*3-2,jorb)
      46         p(2) = vects(iatom*3-1,jorb)
      47         p(3) = vects(iatom*3-0,jorb)
      48         h(1) = r(1,1)*p(1) + r(2,1)*p(2) + r(3,1)*p(3)
      49         h(2) = r(1,2)*p(1) + r(2,2)*p(2) + r(3,2)*p(3)
      50         h(3) = r(1,3)*p(1) + r(2,3)*p(2) + r(3,3)*p(3)
      51         p(1) = elem(1,1,ioper)*h(1) + elem(1,2,ioper)*h(2) + elem(1,3,i
 oper)*h(3)
      52         p(2) = elem(2,1,ioper)*h(1) + elem(2,2,ioper)*h(2) + elem(2,3,i
 oper)*h(3)
