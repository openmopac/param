       1   subroutine nxtmer (iatom, nbackb)
       2     use common_arrays_C, only : nat, ibonds, nbonds
       3     implicit none
       4     integer, intent (in) :: iatom
       5     integer, dimension (4), intent (inout) :: nbackb
       6 !
       7     integer :: i, ii, iii, j, jatom, jj, jjofco = 0, jofco = 0, k, kk,
 l, ihcr, ico, ico1
       8     ico = 0
       9     ico1 = 0
      10     ihcr = 0
      11 !
      12     jatom = nbackb(4)
      13     do i = 1, nbonds(iatom)
      14        if (nat(ibonds(i, iatom)) == 6) ihcr = ibonds(i, iatom)
      15     end do
      16    !
      17    !   START WITH NITROGEN
      18    !
      19     outer_loop: do i = 1, nbonds(iatom)
      20       !
      21       !    IS THERE A CARBON ATTACHED TO THE NITROGEN?
      22       !
      23       if (nat(ibonds(i, iatom)) == 6) then
      24         l = ibonds(i, iatom)
      25         jj = 0
      26         jjofco = 0
      27         do k = 1, nbonds(l)
      28             !
      29             !    IS THERE A CARBON ATTACHED TO THE CARBON ATTACHED TO T
 HE NITROGEN?
      30             !
      31           if (nat(ibonds(k, l)) == 6) then
      32             j = ibonds(k, l)
      33             do ii = 1, nbonds(j)
      34 !
      35 !   IS THERE AN OXYGEN ATOM THAT IS BONDED ONLY TO THE CARBON ATTACHED
 TO THE
      36 !   CARBON ATTACHED TO THE NITROGEN?
      37 !
      38               if (nat(ibonds(ii, j)) == 8 .and. nbonds(ibonds(ii, j)) =
 = 1) go to 1000
      39             end do
      40             cycle
      41 1000        jofco = ibonds(ii, j)
      42             ico1 = ico
      43             ico = j
      44             iii = ii
      45             ihcr = l
      46             do ii = 1, nbonds(j)
      47                   !
      48                   !   IS THERE A NITROGEN ATTACHED TO THE
      49                   !   CARBON ATTACHED TO THE CARBON ATTACHED TO THE NIT
 ROGEN?
      50                   !
      51               if (nat(ibonds(ii, j)) == 7) go to 1010
      52             end do
      53             kk = 0
 
 FORCHECK PC V13.5.13          NXTMER          2021-03-24 10:59:30   page:  2542
 nxtmer.F90  /FF
 
      54             do ii = 1, nbonds(j)
      55                   !
      56                   !   ARE THERE TWO OXYGEN ATOMS ATTACHED TO THE
      57                   !   CARBON ATTACHED TO THE CARBON ATTACHED TO THE NIT
 ROGEN?
      58                   !
      59               if (nat(ibonds(ii, j)) == 8) kk = kk + 1
      60             end do
      61             if (kk == 2) then
      62 !
      63 ! A -COO group detected
      64 !
      65               jatom = 0
      66               exit outer_loop
      67             end if
      68                !
      69                !   NO BOND TO NITROGEN, THEREFORE NOT BACKBONE
      70                !
      71             kk = 0
      72             do ii = 1, nbonds(j)
      73               if (nat(ibonds(ii, j)) == 6) then
      74                 kk = kk + 1
      75               end if
      76             end do
      77                !
      78                !  IF THERE IS MORE THAN ONE CARBON ATOM ATTACHED TO THE
      79                !  SECOND CARBON ATOM THEN IT CANNOT BE A BACKBONE ATOM
      80                !
      81             if (kk == 1) then
      82               jj = j
      83               jjofco = ibonds(iii, j)
      84             end if
      85             cycle
      86 1010        jatom = ibonds(ii, j)
      87             do ii = 1, nbonds(jatom)
      88               if (nat(ibonds(ii, jatom)) == 6) exit outer_loop
      89             end do
      90           end if
      91         end do
      92          !
      93          !  IN ORDER TO GET HERE, THE BACKBONE HAS NOT BEEN RECOGNIZED,
      94          !  THEREFORE SET CARBON OF C=O TO JJ
      95          !
      96         if (jj /= 0) then
      97           j = jj
      98         end if
      99         if (jjofco /= 0) then
     100           jofco = jjofco
     101         end if
     102       end if
     103     end do outer_loop
     104    !
     105    !    IATOM = STARTING NITROGEN
     106    !    L     = CARBON OF -(HCR)-
     107    !    J     = CARBON OF -(C=O)-
     108    !    JATOM = NITROGEN OF -(C=O)-NH-
     109    !    JOFCO = OXYGEN OF -(C=O)-
     110     if (ico1 /= 0) then
     111 !
 
 FORCHECK PC V13.5.13          NXTMER          2021-03-24 10:59:30   page:  2543
 nxtmer.F90  /FF
 
     112 ! Distinguish a terminal threonine with "CO" instead of "COOH"
     113 !
     114       do i = 1, nbonds(ico1)
     115         if (ibonds(i,ico1) == jofco) ico = ico1
     116       end do
     117     end if
     118     nbackb(1) = ihcr
     119     nbackb(2) = ico
     120     nbackb(3) = jofco
     121     nbackb(4) = jatom
     122     return
     123   end subroutine nxtmer
 
