       1       subroutine dijkl2(dc)
       2       use meci_C, only : dijkl, xy, nmos
       3       use molkst_C, only : norbs
       4       implicit none
       5       double precision  :: dc(norbs,nmos)
       6 !
       7       integer :: ij, i, j, kl, k, ll, l
       8       double precision :: val, val2
       9       logical :: lij, lkl
      10       double precision, external :: ddot
      11 !**********************************************************************
 *
      12 !     RELAXATION OF 2-ELECTRONS INTEGRALS IN M.O BASIS.
      13 !
      14 !   INPUT
      15 !   DC(NORBS,NMOS) : C.I-ACTIVE M.O DERIVATIVES IN M.O BASIS, IN COLUMN
 .
      16 !   NORBS          : TOTAL NUMBER OF M.O.
      17 !   NMOS           : NUMBER OF C.I-ACTIVE M.O.
      18 !   DIJKL(I,J,KL)  : <I(1),J(1)|K(2),L(2)> WITH
      19 !                     I              OVER     ALL    M.O.
      20 !                     J,KL CANONICAL OVER C.I-ACTIVE M.O.
      21 !   OUTPUT
      22 !     xy(I,J,K,L)= d< I(1),J(1) | K(2),L(2) >
      23 !                   = <dI,J|K,L> + <I,dJ|K,L> + <I,J|dK,L> + <I,J|K,dL>
      24 !                     WITH I,J,K,L OVER ALL C.I-ACTIVE M.O.
      25 !     WRITTEN BY DANIEL LIOTARD
      26 ! (NOTE BY JJPS: AS THIS CODE IS HIGHLY EFFICIENT, NO CHANGES WERE MADE
 )
      27 !**********************************************************************
 *
      28 !
      29       ij = 0
      30       do i = 1, nmos
      31         do j = 1, i
      32           ij = ij + 1
      33           lij = i == j
      34           kl = 0
      35           do k = 1, i
      36             if (k == i) then
      37               ll = j
      38             else
      39               ll = k
      40             end if
      41             do l = 1, ll
      42               kl = kl + 1
      43               lkl = k == l
      44               val = ddot(norbs,dc(1,i),1,dijkl(1,j,kl),1)
      45               if (lij .and. lkl .and. j==k) then
      46                 val = val*4.D0
      47               else
      48                 if (lij) then
      49                   val = val*2.D0
      50                 else
      51                   val = val + ddot(norbs,dc(1,j),1,dijkl(1,i,kl),1)
      52                 end if
      53                 val2 = ddot(norbs,dc(1,k),1,dijkl(1,l,ij),1)
      54                 if (lkl) then
 
 FORCHECK PC V13.5.13          DIJKL2          2021-03-24 10:59:30   page:  2447
 dijkl2.F90  /FF
 
      55                   val = val + val2*2.D0
      56                 else
      57                   val = val + val2 + ddot(norbs,dc(1,l),1,dijkl(1,k,ij)
 ,1)
      58                 end if
      59               end if
      60               xy(i,j,k,l) = val
      61               xy(i,j,l,k) = val
      62               xy(j,i,k,l) = val
      63               xy(j,i,l,k) = val
      64               xy(k,l,i,j) = val
      65               xy(k,l,j,i) = val
      66               xy(l,k,i,j) = val
      67               xy(l,k,j,i) = val
      68             end do
      69           end do
      70         end do
      71       end do
      72       return
      73       end subroutine dijkl2
 
