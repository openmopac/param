       1       subroutine mecip()
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use meci_C, only : nmos, lab, occa, nalmat, microa, microb, nelec
 , &
       6       & nstate, vectci, deltap
       7       use common_arrays_C, only : c, p
       8       use molkst_C, only : norbs
       9
      10 !**********************************************************************
 *
      11 !-----------------------------------------------
      12 !   I n t e r f a c e   B l o c k s
      13 !-----------------------------------------------
      14       implicit none
      15 !-----------------------------------------------
      16 !   L o c a l   V a r i a b l e s
      17 !-----------------------------------------------
      18       integer :: i, j, id, jd, ix, iy, ij, k
      19       double precision :: sum,  delta(norbs, nmos)
      20 !-----------------------------------------------
      21 !**********************************************************************
 *
      22 !
      23 !   MECIP WILL CORRECT THE TOTAL DENSITY MATRIX FOR THE EFFECT OF THE
      24 !   C.I.
      25 !              ON INPUT
      26 !
      27 !  COEFFS       : ALL M.O.'S (NORBS M.O.S)
      28 !  NORBS        : NUMBER OF MOLECULAR ORBITALS = NUMBER OF A.O.'S
      29 !  P            : TOTAL DENSITY MATRIX
      30 !  NMOS         : NUMBER OF M.O.'S IN ACTIVE SPACE
      31 !  VECTCI       : STATE VECTOR OF LENGTH LAB
      32 !  MICROA(I,J)  : ALPHA OCCUPANCY OF M.O. 'I' IN MICROSTATE 'J'
      33 !  MICROB(I,J)  : BETA  OCCUPANCY OF M.O. 'I' IN MICROSTATE 'J'
      34 !
      35 !  NOTE: THIS IS A MODIFICATION OF CODE ORIGINALLY WRITTEN BY
      36 !        PROF. DANIEL LIOTARD
      37 !**********************************************************************
 *
      38 !     INITIALIZE WITH THE OPPOSITE OF THE 'SCF' DENSITY.
      39       do i = 1, nmos
      40         deltap(i,i) = -occa(i)*2.D0
      41         deltap(i,:i-1) = 0.D0
      42       end do
      43 !
      44 !     ADD THE C.I. CORRECTION
      45       do id = 1, lab
      46         do jd = 1, id
      47 !     CHECK SPIN AGREEMENT
      48           if (nalmat(id) /= nalmat(jd)) cycle
      49           ix = 0
      50           iy = 0
      51           do j = 1, nmos
      52             ix = ix + abs(microa(j,id)-microa(j,jd))
      53             iy = iy + abs(microb(j,id)-microb(j,jd))
      54           end do
 
 FORCHECK PC V13.5.13          MECIP           2021-03-24 10:59:30   page:  1696
 mecip.F90  /FF
 
      55 !     CHECK NUMBER OF DIFFERING M.O.
      56           if (ix + iy > 2) cycle
      57           if (ix == 2) then
      58 !        DETERMINANTS ID AND JD DIFFER BY M.O I IN ID AND M.O J IN JD:
      59             do i = 1, nmos
      60               if (microa(i,id) == microa(i,jd)) cycle
      61               exit
      62             end do
      63             ij = microb(i,id)
      64             do j = i + 1, nmos
      65               if (microa(j,id) /= microa(j,jd)) exit
      66               ij = ij + microa(j,id) + microb(j,id)
      67             end do
      68 !        IJ GIVES THE SIGN OF THE PERMUTATION
      69             sum = 0.D0
      70             do k = 1, nstate
      71               sum = sum + vectci(id+(k-1)*lab)*vectci(jd+(k-1)*lab)
      72             end do
      73             deltap(j,i) = deltap(j,i) + sum*dble(1 - 2*mod(ij,2))/nstat
 e
      74           else if (iy == 2) then
      75 !        DETERMINANTS ID AND JD DIFFER BY M.O J IN ID AND M.O I IN JD:
      76             do i = 1, nmos
      77               if (microb(i,id) == microb(i,jd)) cycle
      78               exit
      79             end do
      80             ij = 0
      81             do j = i + 1, nmos
      82               if (microb(j,id) /= microb(j,jd)) exit
      83               ij = ij + microa(j,id) + microb(j,id)
      84             end do
      85             ij = ij + microa(j,id)
      86             sum = 0.D0
      87             do k = 1, nstate
      88               sum = sum + vectci(id+(k-1)*lab)*vectci(jd+(k-1)*lab)
      89             end do
      90             deltap(j,i) = deltap(j,i) + sum*dble(1 - 2*mod(ij,2))/nstat
 e
      91           else
      92 !        DETERMINANTS ID AND JD ARE IDENTICAL:
      93             sum = 0.D0
      94             do k = 1, nstate
      95               sum = sum + vectci(id+(k-1)*lab)**2
      96             end do
      97             do i = 1, nmos
      98               deltap(i,i) = deltap(i,i) + (microa(i,id)+microb(i,id))*s
 um/nstate
      99             end do
     100           end if
     101         end do
     102       end do
     103 !
     104 !     BACK TRANSFORM INTO A.O. BASIS.
     105 !     -------------------------------
     106 !     P(C.I.) = P(SCF) + C * DELTAP * C'
     107       do i = 1, nmos
     108         deltap(:i-1,i) = deltap(i,:i-1)
     109       end do
     110 !     STEP 1: DELTAP = C * DELTAP
 
 FORCHECK PC V13.5.13          MECIP           2021-03-24 10:59:30   page:  1697
 mecip.F90  /FF
 
     111       call mxm (c(1,nelec+1), norbs, deltap, nmos, delta, nmos)
     112 !     STEP 2: P = P + DELTAP * C'
     113       ij = 0
     114       do i = 1, norbs
     115         do j = 1, i
     116           ij = ij + 1
     117           sum = 0.D0
     118           do k = 1, nmos
     119             sum = sum + delta(i,k)*c(j,nelec+k)
     120           end do
     121           p(ij) = p(ij) + sum
     122         end do
     123       end do
     124 !     NOTE FROM D.L.: AT THIS POINT THE 'NATURAL ORBITALS' OF THIS STAT
 E
     125 !     CAN BE OBTAINED STRAIGHTWAY AS EIGENVECTORS OF THE DENSITY MATRIX
 .
     126       return
     127       end subroutine mecip
 
 FORCHECK PC V13.5.13          MECIP           2021-03-24 10:59:30   page:  1698
 mecip.F90  /FF


