    1035       double precision, dimension(3,numat) :: cmep
    1036       double precision :: step, cut, z0, xm, ym, t11, t12, t13, t21, t2
 2, t23, t31&
    1037         , t32, t33, xx0, yy0, zz0, xxw, yyw, zzw, step1, xx1, yy1, zz1,
  stepm, &
    1038         xx2, yy2, zz2, stepn, rmin, rr, ui
    1039       logical :: prtmep, minmep
    1040 !-----------------------------------------------
    1041       data t/ 1.0D0, 3*0.0D0, 1.0D0, 3*0.0D0, 1.0D0/
    1042       data step/ 0.1D0/
    1043       data need1/ 0/
    1044       data natm/ 0/
    1045       data r0/ 3*0.0D0/
    1046       data cut/ 999.0D0/
    1047       data icase/ 0/
    1048       data z0/ 0.0D0/
    1049       data iback/ 0/
 
 FORCHECK PC V13.5.13          MEPMAP          2021-03-24 10:59:30   page:  3053
