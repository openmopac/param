       1 subroutine prtlmo ()
       2     use molkst_C, only: norbs, keywrd, numat
       3 !
       4     use MOZYME_C, only: isort, nncf, icocc, ncocc, &
       5        & cocc, ncf, nnce, icvir, ncvir, cvir, nce, noccupied, nvirtual
       6 !
       7     use common_arrays_C, only : eigs
       8 !
       9     use chanel_C, only: iw
      10     implicit none
      11     integer :: i
      12     character :: num_1*1
      13     if (.not. Allocated (isort)) then
      14       allocate (isort(norbs), stat=i)
      15       if (i /= 0) then
      16         call memory_error ("prtlmo")
      17         return
      18       end if
      19       isort = 0
      20     end if
      21     num_1 = char(ichar("1") +int(log10(numat + 0.05)))
      22     write (iw,'(10x,a)') "LOCALIZED MOLECULAR ORBITALS"
      23    !
      24    !                Print the occupied set of LMOs
      25    !
      26     write (iw,'(/10x,a,/)') " Occupied Set"
      27     write (iw, "("//num_1//"x,'NUMBER OF CENTERS  LMO ENERGY     COMPOS
 ITION OF ORBITALS ')")
      28     write (iw, "("//num_1//"x,34x,'(AS PERCENT OF THE LMO)',/)")
      29     call prtlmn (nncf, icocc, ncocc, cocc, ncf, isort, eigs, noccupied,
  0)
      30     if (index(keywrd, " ALLVEC") /= 0) then
      31    !
      32    !                Print the virtual set of LMOs
      33    !
      34       write (iw,'(/10x,a,/)') " Virtual Set (NOT re-localized!)"
      35       write (iw, "("//num_1//"x,'NUMBER OF CENTERS  LMO ENERGY     COMP
 OSITION OF ORBITALS ')")
      36       write (iw, "("//num_1//"x,34x,'(AS PERCENT OF THE LMO)',/)")
      37       call prtlmn (nnce, icvir, ncvir, cvir, nce, isort(noccupied + 1:)
 , &
      38            & eigs(noccupied + 1:), nvirtual, noccupied)
      39     else
      40       write (iw,'(/10x,a,/)') "To print Virtual Set as well, use keywor
 d ""ALLVEC"""
      41     end if
      42     return
      43 end subroutine prtlmo
 
