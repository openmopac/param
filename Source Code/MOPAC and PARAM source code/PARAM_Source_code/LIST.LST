     357
     358       subroutine output (c, aii)
     359
     360       USE chanel_C, only : iw
     361       use reimers_C, only : n, nshell, norbl, norbh, &
     362           nmrep, nptg, nr, nsym
     363
     364       implicit none
     365       double precision ::  aii(n), c(n, n)
     366       character*1       ll(5)
     367       integer ::           notype(8, 5), notot(8)
     368       integer ::           i, ir, is, nmoou1, nmoou2
     369
     370 !     **** write number of each orb of each symmetry in each shell ****
     371 !     **** get shell operator name ****
     372
     373       nmoou1 = 1
     374       nmoou2 = n
     375       nr = 1
     376       nptg = 1
     377
     378       if (nshell == 1) then
     379         ll(1) = '1'
     380         ll(2) = 'v'
     381       else
     382         ll(1) = '1'
     383         ll(2) = '2'
     384         ll(3) = 'v'
     385       end if
     386
     387       if (.not. allocated(nsym)) allocate(nsym(n))
     388       do i = 1, n
     389         nsym(i) = 1
     390       end do
     391
     392       do is = 1, nshell + 1
     393         do ir = 1, nr
     394           notype(ir, is) = 0
     395         end do
     396       end do
     397
     398       do is = 1, nshell
     399         do i = norbl(is), norbh(is)
     400           notype(1, is) = notype(1, is) + 1
     401         end do
     402       end do
     403       is = nshell + 1
     404       do i = norbh(nshell) + 1, n
     405           notype(1, is) = notype(1, is) + 1
 
 FORCHECK PC V13.5.13          OUTPUT          2021-03-24 10:59:30   page:   195
 scf.F90  /FF
 
     406       end do
     407       do ir = 1, nr
     408         notot(ir) = 0
     409         do is = 1, nshell + 1
     410           notot(ir) = notot(ir) + notype(ir, is)
     411         end do
     412       end do
     413
     414       write (iw, "(/' Summary of symmetry occupancy in each shell:'//'
 SHELL  ', 9(a3, 1x))") &
     415         (nmrep(ir, nptg), ir = 1, nr)
     416       do is = 1, nshell + 1
     417         write (iw, '(4x, a1, 1x, 8i4)') ll(is), (notype(ir, is), ir = 1
 , nr)
     418       end do
     419       write (iw, '(1x, a5, 8i4)') 'TOTAL', (notot(ir), ir = 1, nr)
     420
     421 !     ***** page eject for MO dump ****
     422
     423
     424       if (nmoou1 > nmoou2) return
     425
     426 !     **** first eigenvalues before main dump ****
     427
     428 !     **** dump of molecular orbitals ****
     429       call matout(c, aii, n, n, n)
     430       return
     431       end subroutine output
 
