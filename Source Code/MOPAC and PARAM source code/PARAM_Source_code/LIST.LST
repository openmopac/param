    2262     subroutine prn1lb (n, m, l, u, x, iprint, itfile, epsmch)
    2263
    2264       use chanel_C, only: iw
    2265       implicit none
    2266       integer, intent (in) :: iprint, itfile, m, n
    2267       double precision, intent (in) :: epsmch
    2268       double precision, dimension (n), intent (in) :: l, u, x
    2269       integer :: i
    2270     !
    2271     !
    2272       if (iprint < 0) return
    2273 10000 format ("RUNNING THE L-BFGS-B CODE",/,/, "           * * *",/,/,
 &
    2274      & "Machine precision =", 1 p, d10.3)
    2275       write (iw, 10000) epsmch
    2276       write (iw,*) "N = ", n, "    M = ", m
    2277       if (iprint >= 1) then
    2278 10010   format ("RUNNING THE L-BFGS-B CODE",/,/, &
    2279        & "it    = iteration number"/ &
    2280        & "nf    = number of function evaluations",/, &
    2281        & "nint  = number of segments explored during the Cauchy search"
 ,/, &
    2282        & "nact  = number of active bounds at the generalized Cauchy poi
 nt",/, &
    2283        & "sub   = manner in which the subspace minimization terminated:
 ",/, &
    2284        & "        con = converged, bnd = a bound was reached",/, &
    2285        & "itls  = number of iterations performed in the line search",/,
  &
    2286        & "stepl = step length used",/, &
    2287        & "tstep = norm of the displacement (total step)",/, &
    2288        & "projg = norm of the projected gradient",/, &
    2289        & "f     = function value",/,/, "           * * *",/,/, &
    2290        & "Machine precision =", 1 p, d10.3)
    2291         write (itfile, 10010) epsmch
    2292         write (itfile,*) "N = ", n, "    M = ", m
    2293 10020   format (/, 3 x, "it", 3 x, "nf", 2 x, "nint", 2 x, "nact", 2 x,
  "sub", &
    2294        & 2 x, "itls", 2 x, "stepl", 4 x, "tstep", 5 x, "projg", 8 x, "f
 ")
    2295         write (itfile, 10020)
    2296         if (iprint > 100) then
    2297           !
    2298 10030     format (/, a4, 1 p, 6(1 x, d11.4), /, (4 x, 1 p, 6(1 x, d11.4
 )))
    2299           write (iw, 10030) "L =", (l(i), i=1, n)
    2300           write (iw, 10030) "X0 =", (x(i), i=1, n)
    2301           write (iw, 10030) "U =", (u(i), i=1, n)
    2302         end if
    2303       end if
    2304     !
    2305     end subroutine prn1lb
 
