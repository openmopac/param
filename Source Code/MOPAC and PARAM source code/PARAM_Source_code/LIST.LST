       1       subroutine dernvo()
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE molkst_C, only : numcal, numat, nopen, nclose, norbs, gnorm,
 &
       6       & fract, keywrd, mpack, moperr, lm61, n2elec
       7       use meci_C, only : nbo, nmos, nelec, lab
       8       use common_arrays_C, only : eigs, dxyz
       9       use chanel_C, only : iw
      10 !**********************************************************************
 *
      11 !-----------------------------------------------
      12 !   I n t e r f a c e   B l o c k s
      13 !-----------------------------------------------
      14       implicit none
      15       double precision, dimension(:), allocatable  :: scalar, diag, fmo
 off, &
      16       work
      17 !-----------------------------------------------
      18 !   L o c a l   V a r i a b l e s
      19 !-----------------------------------------------
      20       integer ::  minear, ninear, nvax, icalcn, i, ilast, ifirst, j, k,
  l, ll, &
      21       n1, n2
      22       double precision, dimension(nmos*norbs + 1) :: fmoon
      23       double precision, dimension(3*numat) :: dxyzr
      24       double precision, dimension(nmos*norbs*20) :: eigbb
      25       double precision :: sum, throld, sumx, sumy, sumz
      26       logical :: debug, dcar, large, relaxd
      27       character :: blank*60
      28
      29       save  debug, dcar, large,  minear, ninear, nvax, icalcn, &
      30       & diag, scalar, fmooff
      31 !-----------------------------------------------
      32 !**********************************************************************
      33 !
      34 !    IMPLEMENTATION OF ANALYTICAL FORMULATION FOR OPEN SHELL OR CI,
      35 !                      VARIABLES FINITE DIFFERENCE METHODS,
      36 !                      STATISTICAL ESTIMATE OF THE ERRORS,
      37 !                   BY D. LIOTARD
      38 !                      LABORATOIRE DE CHIMIE STRUCTURALE
      39 !                      UNIVERSITE DE PAU ET DES PAYS DE L'ADOUR
      40 !                      AVENUE DE L'UNIVERSITE, 64000, PAU (FRANCE)
      41 !
      42 !
      43 !   MODIFIED BY JJPS TO CONFORM TO MOPAC CONVENTIONS
      44 !   (NOTE BY JJPS:  PROF. LIOTARD'S TECHNIQUE WORKS.  IF THIS
      45 !   IMPLEMENTATION DOES NOT WORK, THE REASON IS A FAULT INTRODUCED
      46 !   BY JJPS, AND DOES NOT REFLECT ON PROF. LIOTARD'S ABILITY)
      47 !
      48 !
      49 !    AS THE WAVE FUNCTION IS NOT VARIATIONALLY OPTIMIZED, I.E.
      50 !    HALF-ELECTRON OR CI, THE DERIVATIVES OF THE 1 AND 2-ELECTRON
      51 !    INTEGRALS IN A.O. BASIS ARE EVALUATED IN CARTESIAN COORDINATES
      52 !    BY A 1 OR 2 POINTS FINITE DIFFERENCE FORMULA AND STORED.
      53 !    THUS ONE GETS THE NON-RELAXED (I.E. FROZEN ELECTRONIC CLOUD)
      54 !    CONTRIBUTION TO THE FOCK EIGENVALUES AND 2-ELECTRON INTEGRALS IN
 
 FORCHECK PC V13.5.13          DERNVO          2021-03-24 10:59:30   page:  1300
 dernvo.F90  /FF
 
      55 !    AN M.O. BASIS.  THE NON-RELAXED GRADIENT COMES FROM THE
      56 !    NON-RELAXED C.I. MATRIX DERIVATIVE (SUBROUTINE DERI1).
      57 !    THE DERIVATIVES OF THE M.O. COEFFICIENTS ARE THEN WORKED OUT
      58 !    ITERATIVELY (OK FOR BOTH CLOSED SHELLS AND HALF-ELECTRON CASES)
      59 !    AND STORED. THUS ONE GETS THE ELECTRONIC RELAXATION CONTRIBUTION T
 O
      60 !    THE FOCK EIGENVALUES AND 2-ELECTRON INTEGRALS IN M.O. BASIS.
      61 !    FINALLY THE RELAXATION CONTRIBUTION TO THE C.I. MATRIX DERIVATIVE
      62 !    GIVES THE RELAXATION CONTRIBUTION TO THE GRADIENT (ROUTINE DERI2).
      63 !
      64 !
      65 !        COORD  HOLDS THE CARTESIAN COORDINATES.
      66 !    INPUT
      67 !        DXYZ   NOT DEFINED.
      68 !    EXIT
      69 !        DXYZ   DERIVATIVES OF ENERGY W.R.T CARTESIAN COORDINATES,
      70 !               IN KCAL/MOL/ANGSTROM (3 * NUMAT OF THESE)
      71 !
      72 !**********************************************************************
      73       data icalcn/ 0/
      74 !        ACTUAL SIZES FOR C.I. GRADIENT CALCULATION.
      75         nbo(1) = nclose
      76         nbo(2) = nopen - nclose
      77         nbo(3) = norbs - nopen
      78         minear = nbo(2)*nbo(1) + nbo(3)*nopen
      79         ninear = nmos
      80         k = 0
      81         l = 0
      82         n2 = 0
      83         do i = 1, 3
      84           l = k + 1
      85           k = k + nbo(i)
      86           n1 = Max (0, nelec - l)
      87           n2 = Min (k, nelec + nmos) - l
      88           if (n2 > n1) then
      89             ninear = ninear + (n2*(n2 + 1) - n1*(n1 + 1))/2
      90           end if
      91         end do
      92         j = n2 + 1
      93         n2 = n2 + l
      94         if (j > 0 .and. n2 < norbs) then
      95           ninear = ninear + j * (norbs-n2)
      96         else if (ninear <= 0) then
      97           ninear = 1
      98         end if
      99         i = max(norbs**2 + 45*lm61, (lab*(lab+1))/2, n2elec + mpack)
     100         allocate(work(i))
     101         if(allocated(scalar)) deallocate(scalar)
     102         allocate(scalar(minear))
     103         if(allocated(diag)) deallocate(diag)
     104         allocate(diag(minear))
     105         if(allocated(fmooff)) deallocate(fmooff)
     106         allocate(fmooff(2*minear))
     107 !
     108 !     SELECT THE REQUIRED OPTION AND READ KEYWORDS
     109 !     --------------------------------------------
     110 !
     111       if (icalcn /= numcal) then
     112         icalcn = numcal
 
 FORCHECK PC V13.5.13          DERNVO          2021-03-24 10:59:30   page:  1301
 dernvo.F90  /FF
 
     113         debug = index(keywrd,'DERNVO') /= 0
     114         large = index(keywrd,'LARGE') /= 0
     115         dcar = index(keywrd,'FORC') + index(keywrd,'PREC') /= 0
     116         nvax = 3*numat
     117       end if
     118       dxyzr(:nvax) = 0.D0
     119 !        SCALING ROW FACTORS TO SPEED CV OF RELAXATION PROCEDURE.
     120       call deri0 (eigs, norbs, scalar, diag, fract, nbo)
     121 !
     122 !   BECAUSE DERI2 IS CPU INTENSIVE, AND THE CONTRIBUTION TO THE
     123 !   DERIVATIVE DUE TO RELAXATION OF THE ELECTRON CLOUD IS RELATIVELY
     124 !   INSENSITIVE TO CHANGES IN GEOMETRY, WHERE POSSIBLE ONLY CALCULATE
     125 !   THE DERIVATIVE EVERY 2 CALLS TO DERNVO
     126 !
     127       eigbb = 0.D0
     128       sum = 0.D0
     129       if (gnorm<1.D0 .or. dcar) then
     130         dxyzr(:nvax) = 0.D0
     131         relaxd = .FALSE.
     132       end if
     133       do i = 1, nvax
     134         sum = sum + abs(dxyzr(i))
     135       end do
     136       relaxd = sum > 1.D-7
     137 !
     138 !  IF DXYZR CONTAINS DATA, USE IT AND FLUSH AFTER USE.
     139 !
     140       ilast = 0
     141    50 continue
     142       ifirst = ilast + 1
     143       ilast = min(nvax,ilast + 1)
     144       j = 1 - minear
     145       k = 1 - ninear
     146       do i = ifirst, ilast
     147         k = k + ninear
     148         j = j + minear
     149 !
     150 !        NON-RELAXED CONTRIBUTION (FROZEN ELECTRONIC CLOUD) IN DXYZ
     151 !        AND NON-RELAXED FOCK MATRICES IN FMOOFF AND FMOON.
     152 !   CONTENTS OF F-MO-OFF: OPEN-CLOSED, VIRTUAL-CLOSED, AND VIRTUAL-OPEN
     153 !   CONTENTS OF F-MO-ON:  CLOSED-CLOSED, OPEN-OPEN AND VIRTUAL-VIRTUAL
     154 !   OVER M.O. INDICES
     155 !
     156         call deri1 (i, dxyz(i), fmooff(j), minear, fmoon(k), scalar, wo
 rk)
     157       end do
     158       if (debug) then
     159         if (ifirst==1 .and. large) then
     160           write (iw, *) ' CONTENTS OF FMOOFF '
     161           write (iw, *) ' OPEN-CLOSED'
     162           write (iw, '(7X,I3,5I12)') (j,j=nclose + 1,nopen)
     163           do i = 1, nclose
     164             write (iw, '(I3,6F12.6)') i, (fmooff(j),j=(i - 1)*nbo(2) +
 1,i*nbo(2))
     165           end do
     166 !
     167 !
     168           write (iw, *) ' VIRTUAL-CLOSED'
     169           k = nclose*nbo(2)
 
 FORCHECK PC V13.5.13          DERNVO          2021-03-24 10:59:30   page:  1302
 dernvo.F90  /FF
 
     170           write (iw, '(7X,I3,5I12)') (j,j=nopen + 1,min(nopen + 6,norbs
 ))
     171           do i = 1, nclose
     172             write (iw, '(I3,6F12.6)') i, &
     173             (fmooff(j+k),j=(i - 1)*nbo(3) + 1,min(6 + (i - 1)*nbo(3),i*
 nbo(3)))
     174           end do
     175           k = nclose*nbo(2) + nbo(3)*nclose
     176 !
     177 !
     178           write (iw, *) ' VIRTUAL-OPEN'
     179           write (iw, '(7X,I3,4I12)') (j,j=nclose + 1,nopen)
     180           do i = 1, min(6,nbo(3))
     181             write (iw, '(I3,6F12.6)') i + nopen, &
     182             (fmooff(j+k),j=(i - 1)*nbo(2) + 1,min((i - 1)*nbo(2)+6,i*nb
 o(2)))
     183           end do
     184           write (iw, *) ' CONTENTS OF FMOON (ACTIVE-SPACE -- ACTIVE SPA
 CE)'
