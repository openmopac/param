     104       lprtgra = (index(keywrd,' GRAD') /= 0 .and. nvar > 0)
     105       ci = index(keywrd,' C.I.') /= 0
     106       call fdate (idate)
     107       degree = 57.29577951308232D0
     108       gnorm = 0.D0
     109       if (nvar /= 0) gnorm = dsqrt(dot(grad,grad,nvar))
     110       write (iw, '(/,'' ----'',15(''-----''))')
     111       call wrttxt (iw)
     112       if (iflepo == 15 .and. index(keywrd,' TS') /=0 ) iflepo = 17
     113       if (iflepo == 0)                             iflepo =  7
     114       if (iflepo == 1 .and. nvar == 0 .and. index(keywrd,"1SCF") == 0)
 iflepo = 16
     115       write (iw, '(2/4X,A58)') flepo(iflepo)
     116       iscf = max(1,iscf)
     117       write (iw, '(4X,A58)') iter(iscf)
     118       write (iw, "(2/29X,A,' CALCULATION')") trim(caltyp)
     119       write (iw, '(55X,''MOPAC2016 (Version: '',a,a)') verson, ")"
     120       write (iw, '(55X,A24)') idate
     121       if (ijulian < 500) write (iw, '(55x,a,i3)')"No. of days remaining
  = ",ijulian
     122       if (iscf == 2) then
     123 !
     124 !   RESULTS ARE MEANINGLESS. DON'T PRINT ANYTHING!
     125 !
     126         write (iw, '(A)') ' '
     127         write (iw, '(A)') ' '
     128         write (iw, '(A)') ' FOR SOME REASON THE SCF CALCULATION FAILED.
 '
     129         write (iw, '(A)') ' '
     130         write (iw, '(A)') &
     131           ' THE RESULTS WOULD BE MEANINGLESS, SO WILL NOT BE PRINTED.'
     132         write (iw, '(A)') &
     133           ' TRY TO FIND THE REASON FOR THE FAILURE BY USING ''PL''.'
     134         write (iw, '(A)') ' '
     135         write (iw, '(A)') &
     136           ' CHECK YOUR GEOMETRY AND ALSO TRY USING SHIFT OR PULAY. '
     137         call geout (1)
     138         call mopend ('THE SCF CALCULATION FAILED.')
     139         return
     140       end if
     141       if ( Abs (pressure) > 1.d-4) then
     142       !
     143       ! Remove energy term arising from the external pressure,
     144       !
     145         if( id == 1) then
     146           escf = escf + pressure * dsqrt(dot(tvec(1,1), tvec(1,1),3))
     147         else if (id == 3) then
     148           escf = escf + pressure * volume(tvec,3)
     149         end if
     150       end if
     151       if (use_ref_geo) then
     152         write (iw, &
     153       '(4/10X,''FINAL H.O.F PLUS STRESS ='',F17.5,'' KCAL/MOL''  ,'' ='
 ',F14.5,'' KJ/MOL'')') escf, escf*4.184D0
     154         write (iw, &
 
 FORCHECK PC V13.5.13          WRITMO          2021-03-24 10:59:30   page:  4336
 writmo.F90  /FF
 
     155       '(10X,''FINAL STRESS            ='',F17.5,'' KCAL/MOL''  ,'' ='',
 F14.5,'' KJ/MOL'')') stress, stress*4.184D0
     156         write (iw, &
     157       '(10X,''FINAL HEAT OF FORMATION ='',F17.5,'' KCAL/MOL''  ,'' ='',
 F14.5,'' KJ/MOL'')') escf - stress, (escf - stress)*4.184D0
     158         call  geo_diff(sum, rms, .false.)
     159         sum = 0.d0
     160         rms = 0.d0
