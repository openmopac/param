     355     integer function end_of_keyword(input, len, start)
     356 !
     357 ! Given a keyword, input(start:), find the end of the keyword
     358 !
     359   integer, intent (in) :: len, start
     360   character, intent (in) :: input*(len)
     361 !
     362 ! Local
     363 !
     364   integer :: j, k
     365   logical :: quotation_mark
     366     quotation_mark = .false.
     367     k = start
     368     do
     369       if (input(k:k) /= " ") exit
     370       k = k + 1
     371     end do
     372     j = k - 1
     373     do
     374       j = j + 1
     375       if (j > len) exit
     376       if (input(j:j) == ' ') exit
     377       if (input(j:j) == '"')  quotation_mark = (.not.  quotation_mark)
     378       if (quotation_mark) then
     379         do
     380           j = j + 1
     381           if (j > len) exit
     382           if (input(j:j) == '"')  quotation_mark = (.not.  quotation_ma
 rk)
     383           if (.not. quotation_mark) exit
     384         end do
     385       end if
     386     end do
     387     end_of_keyword = j
     388     return
     389   end function end_of_keyword
 
