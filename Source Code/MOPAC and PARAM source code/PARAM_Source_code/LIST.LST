       1       subroutine symopr(numat, coord, jump, r)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5 !**********************************************************************
 *
       6       implicit none
       7 !-----------------------------------------------
       8 !   G l o b a l   P a r a m e t e r s
       9 !-----------------------------------------------
      10 !-----------------------------------------------
      11 !   D u m m y   A r g u m e n t s
      12 !-----------------------------------------------
      13       integer , intent(in) :: numat
      14       integer , intent(in) :: jump
      15       double precision , intent(inout) :: coord(3,numat)
      16       double precision , intent(in) :: r(3,3)
      17 !-----------------------------------------------
      18 !   L o c a l   P a r a m e t e r s
      19 !-----------------------------------------------
      20 !-----------------------------------------------
      21 !   L o c a l   V a r i a b l e s
      22 !-----------------------------------------------
      23       integer :: i, j
      24       double precision, dimension(3) :: help
      25 !-----------------------------------------------
      26 !**********************************************************************
 *
      27 !
      28 !   SYMOPR performs the symmetry operation stored in the 3 by 3 array
      29 !          R on the coordinates.   If JUMP is +1, the operation is
      30 !          X.R, if JUMP is -1, the operation is R.X
      31 !
      32 !   On output, COORD = COORD.R or R.COORD
      33 !
      34 !**********************************************************************
 *
      35       if (jump >= 0) then
      36         do i = 1, numat
      37           help = coord(:,i)
      38           do j = 1, 3
      39             coord(j,i) = 0.D0
      40             coord(j,i) = coord(j,i) + sum(r(:,j)*help)
      41           end do
      42         end do
      43         return
      44       end if
      45       do i = 1, numat
      46         help = coord(:,i)
      47         do j = 1, 3
      48           coord(j,i) = 0.D0
      49           coord(j,i) = coord(j,i) + sum(r(j,:)*help)
      50         end do
      51       end do
      52       return
      53       end subroutine symopr
 
