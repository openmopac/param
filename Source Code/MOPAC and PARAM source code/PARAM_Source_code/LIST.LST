       1 subroutine modgra ()
       2    !*******************************************************************
 ****
       3    !
       4    !   MODGRA prints the gradients due to (a) backbone residue atoms, a
 nd
       5    !   (b) all side-chain atoms in each residue.
       6    !
       7    !*******************************************************************
 ****
       8     use molkst_C, only: numat, nvar, maxtxt, natoms
       9     use chanel_C, only: iw
      10     use common_arrays_C, only : grad, loc, txtatm
      11     use MOZYME_C, only : nres, at_res, res_start
      12     implicit none
      13     double precision, allocatable :: rgrad(:), res_grad_b(:), res_grad_
 s(:)
      14     double precision :: sum
      15     integer :: i, j
      16     logical :: L_protein
      17     allocate(rgrad(natoms), res_grad_b(natoms), res_grad_s(natoms))
      18     call build_res_start_etc()
      19 !
      20 !  Put atomic gradients into an atom-based array
      21 !
      22     rgrad      = 0.d0
      23     res_grad_b = 0.d0
      24     res_grad_s = 0.d0
      25     do i = 1, nvar
      26       j = loc(1, i)
      27       rgrad(j) = rgrad(j) + grad(i) ** 2
      28     end do
      29     l_protein = .false.
      30     do i = 1, numat
      31       j = at_res(i)
      32       if (txtatm(i)(:6) == "ATOM  " .and. &
      33       (txtatm(i)(13:15) == " CA" .or. txtatm(i)(13:15) == " N " .or. tx
 tatm(i)(13:15) == " C ")) then
      34         res_grad_b(j) = res_grad_b(j) + rgrad(i)
      35         l_protein = .true.
      36       else
      37         res_grad_s(j) = res_grad_s(j) + rgrad(i)
      38       end if
      39     end do
      40     sum = 0.d0
      41     do i = 1, nres
      42       res_grad_b(i) = sqrt(res_grad_b(i))
      43       res_grad_s(i) = sqrt(res_grad_s(i))
      44       sum = sum + res_grad_b(i) + res_grad_s(i)
      45     end do
      46     if (l_protein) then
      47       if (sum < 0.5d0) then
      48         write (iw,"(/12x,a,/)") " ALL GRADIENTS FOR ALL BACKBONES PLUS
 SIDE CHAINS ARE VERY SMALL"
      49       else
      50         write (iw,"(/12x,a,/)") " GRADIENTS FOR ALL BACKBONES"
      51         write (iw,"(a)")"     Residue        Backbone    Side-Chain
     Total"
 
 FORCHECK PC V13.5.13          MODGRA          2021-03-24 10:59:30   page:   621
 modgra.F90  /FF
 
      52         write(iw,*)
      53         do i = 1, nres
      54           if (txtatm(res_start(i))(18:20) /= "HOH" .or. abs(res_grad_s(
 i)) > 1.d0) &
      55             write(iw,'(4x, a, f15.3, f12.3, f15.3)')txtatm(res_start(i)
 )(18:maxtxt), &
      56             res_grad_b(i), res_grad_s(i), res_grad_b(i) + res_grad_s(i)
      57           end do
      58       end if
      59     else
      60       if (sum < 0.5d0) then
      61         write (iw,"(/12x,a,/)") " ALL GRADIENTS FOR ALL GROUPS ARE VERY
  SMALL"
      62       else
      63         write (iw,"(/13x,a,/)") " GRADIENTS FOR ALL GROUPS"
      64         write (iw,"(11x,a)")"     Group       Gradient"
      65         write(iw,*)
      66         write(iw,'(14x, a, f13.3)')(txtatm(res_start(i))(18:20)//" "//t
 xtatm(res_start(i))(23:26),  &
      67           res_grad_s(i),i = 1, nres)
      68       end if
      69     end if
      70     return
      71 end subroutine modgra
 
