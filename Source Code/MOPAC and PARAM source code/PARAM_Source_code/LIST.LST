      28   &1.40d0,  1.25d0,  1.13d0,  1.04d0,  1.10d0,  1.02d0,  0.99d0,  0.96d
 0,  1.76d0,  1.54d0, &
      29   &1.33d0,  1.22d0,  1.21d0,  1.10d0,  1.07d0,  1.04d0,  1.00d0,  0.99d
 0,  1.01d0,  1.09d0, &
      30   &1.12d0,  1.09d0,  1.15d0,  1.10d0,  1.14d0,  1.17d0,  1.89d0,  1.67d
 0,  1.47d0,  1.39d0, &
      31   &1.32d0,  1.24d0,  1.15d0,  1.13d0,  1.13d0,  1.08d0,  1.15d0,  1.23d
 0,  1.28d0,  1.26d0, &
      32   &1.26d0,  1.23d0,  1.32d0,  1.31d0,  2.09d0,  1.76d0,  1.62d0,  1.47d
 0,  1.58d0,  1.57d0, &
      33   &1.56d0,  1.55d0,  1.51d0,  1.52d0,  1.51d0,  1.50d0,  1.49d0,  1.49d
 0,  1.48d0,  1.53d0, &
      34   &1.46d0,  1.37d0,  1.31d0,  1.23d0,  1.18d0,  1.16d0,  1.11d0,  1.12d
 0,  1.13d0,  1.32d0, &
      35   &1.30d0,  1.30d0,  1.36d0,  1.31d0,  1.38d0,  1.42d0,  2.01d0,  1.81d
 0,  1.67d0,  1.58d0, &
      36   &1.52d0,  1.53d0,  1.54d0,  1.55d0 /
      37 !
      38   if (first) then
      39     covrad = 4.d0/3.d0*covrad !  This must be done once per entire run
      40     first = .false.
      41   end if
      42   if (icalcn /= numcal) then
      43     max_h_bonds = 0
