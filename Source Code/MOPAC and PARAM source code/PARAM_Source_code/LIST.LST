      28     if (lxyz) then   !  All coordinates are Cartesian
      29       write (iw, '("       ", a, "     Cartesian Gradients         Cart
 esian Coordinates          |Gradient|")') &
      30         blank(:i)
      31       write (iw, '("  Atom ", a, "     X        Y        Z        X
       Y          Z")') blank(:i)
      32     else if (lint) then  !  All coordinates are internal
      33       write (iw, '("  Atom ", a, "         Gradients
    Geometry    ")') blank(:i)
      34       write (iw, '("  Atom ", a, "    Bond    Angle  Dihedral    Bond
      Angle    Dihedral")') blank(:i)
      35     else !  Coordinates are mixed - Cartesian and internal
      36       write (iw, '("  Atom ", a, "         Gradients
    Geometry                  |Grad|")')  &
      37         blank(:i)
      38     end if
      39     write (iw,*)
      40     l = 1
      41     do i = 1, natoms
      42       !
      43       !                       1         2         3         4
      44       !              12345678901234567890123456789012345678901234567
      45       !
      46       fmat = "(I5,A,"
      47       j = 0
      48       gmax = 0.d0
      49       if (l <= nvar) then
      50         k = 7
      51         n = 38
      52         do m = 1, 3
 
 FORCHECK PC V13.5.13          PRTGRA          2021-03-24 10:59:30   page:  1783
