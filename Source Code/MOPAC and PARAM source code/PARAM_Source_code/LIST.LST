       1 subroutine compct (nncnew, ncnew, ncmnew, itop, nc, ic, iws, n01, c, n0
 2, &
       2 & nmos, idone, lb, mb, icref, inref)
       3     implicit none
       4     integer, intent (in) :: icref, idone, inref, itop, n01, n02, nmos
       5     integer, intent (out) :: lb, mb
       6     integer, dimension (n01), intent (inout) :: ic
       7     integer, dimension (nmos), intent (inout) :: iws, nc, ncmnew, nncne
 w
       8     integer, dimension (nmos), intent (out) :: ncnew
       9     double precision, dimension (n02), intent (inout) :: c
      10     integer :: i, ii, inco, inew, inic, ioco, ioic, n, natom, ncoef
      11    !
      12    !   Start the compression at the LMO below the current LMO.  Gaps ca
 n
      13    !   only exist in the domain IDONE-1 to 1.
      14    !
      15     inic = icref
      16     inco = inref
      17    !   The last array element of  C used is INCO
      18    !   The last array element of IC used is INIC
      19     inew = itop - 1
      20     ii = idone
      21     do i = idone - 1, 1, -1
      22       if (nc(i) /= 0) then
      23         ii = ii - 1
      24         inew = inew + 1
      25         natom = nc(i)
      26         ncoef = iws(i)
      27          !
      28          !  Decrement counters by number of atoms in LMO and by number
 of
      29          !  coefficients in LMO.
      30          !
      31         inic = inic - natom
      32         inco = inco - ncoef
      33          !
      34          !  Get starting address of atoms and coefficients.
      35          !
      36         ioic = nncnew(inew)
      37         ioco = ncmnew(inew)
      38          !
      39          !  Move atom index addresses.  Count backwards to prevent over
 writing.
      40          !
      41         do n = natom, 1, -1
      42           ic(inic+n) = ic(ioic+n)
      43         end do
      44          !
      45          !  Move orbital coefficients. Count backwards to prevent overw
 riting.
      46          !
      47         do n = ncoef, 1, -1
      48           c(inco+n) = c(ioco+n)
      49         end do
      50          !
      51          !  RESET starting addresses
      52          !
 
 FORCHECK PC V13.5.13          COMPCT          2021-03-24 10:59:30   page:   262
 compct.F90  /FF
 
      53         ncnew(inew) = natom
      54         nncnew(inew) = inic
      55         ncmnew(inew) = inco
      56         nc(ii) = natom
      57         iws(ii) = ncoef
      58         if (inew == nmos) exit
      59       end if
      60     end do
      61    !
      62    !   ZERO OUT ALL LOWER LMOs
      63    !
      64     do i = ii - 1, 1, -1
      65       nc(i) = 0
      66     end do
      67    !
      68    !   RESET LOWER BOUNDARY OF LMOs. (THIS IS USED BY SELMOS)
      69    !
      70     lb = inic
      71     mb = inco
      72 end subroutine compct
 
