      53           if (loc(1, l) == i .and. loc(2, l) == m) then
      54             j = j + 1
      55             tmp(j, 1) = grad(l)
      56             tmp(j, 2) = xparam(l)
      57             if (na1 /= 99 .and. m > 1 .and. na(i) /= 0) then
      58               tmp(j, 2) = tmp(j, 2) * 180.d0 / 3.14159265358979d0
      59             end if
      60             gmax = Max (gmax, Abs (grad(l)))
      61             fmat (k:k+4) = "F9.3,"
      62             fmat (n:n+5) = "F11.5,"
      63             l = l + 1
      64             k = k + 5
      65             n = n + 6
      66           else
      67             fmat (k:k+12) = "'     -   ',"
      68             fmat (n:n+14) = "'     -     ',"
      69             k = k + 13
      70             n = n + 15
      71           end if
      72         end do
      73         fmat (n:n+8) = "f12.3,1X)"
      74       end if
      75       if (j /= 0 .and. glim < gmax) then
      76         if (maxtxt == 0) then
      77           if (j == 3 .and. na(i) == 0) then
      78             sum = sqrt(tmp(1, 1)**2 + tmp(2, 1)**2 + tmp(3, 1)**2)
      79             write (iw, fmat) i, " " // elemnt (labels(i)), ((tmp(m, n),
  m=1, j), n=1, 2), sum
      80           else
      81             write (iw, fmat) i, " " // elemnt (labels(i)), ((tmp(m, n),
  m=1, j), n=1, 2)
      82           end if
      83         else
      84          if (j == 3 .and. na(i) == 0) then
      85             sum = sqrt(tmp(1, 1)**2 + tmp(2, 1)**2 + tmp(3, 1)**2)
      86             write (iw, fmat) i, " " // elemnt (labels(i)) // "(" // txt
 atm (i) &
      87          & (:maxtxt) // ")" // blank (maxtxt+3:17), ((tmp(m, n), m=1, j
 ), n=1, 2), sum
      88           else
      89             write (iw, fmat) i, " " // elemnt (labels(i)) // "(" // txt
 atm (i) &
      90          & (:maxtxt) // ")" // blank (maxtxt+3:17), ((tmp(m, n), m=1, j
 ), n=1, 2)
      91           end if
      92         end if
      93       end if
