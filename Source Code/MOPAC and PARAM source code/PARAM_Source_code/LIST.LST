     404   subroutine evec(aVector, x, y, z, coord, numat)
     405     integer :: numat
     406     double precision :: coord(3,numat), x, y, z
     407     real :: aVector(7*numat)
     408 !
     409 !
     410     integer :: i, j
     411     real :: shellRi, shellR2, shellR2i, shellR3i, &
     412     u, v, w, uu, vv, ww
     413     j = 1
     414     do i = 1, numat
     415       u = sngl(x - coord(1,i))
     416       v = sngl(y - coord(2,i))
     417       w = sngl(z - coord(3,i))
     418       uu = u * u
     419       vv = v * v
     420       ww = w * w
     421       shellR2 = max(uu + vv + ww, 1.e-2)
     422       shellR2i = 1.e0/(shellR2 + 1.e-7)
     423       shellRi = sqrt(shellR2i)
     424
     425       aVector(j + 0) =  shellRi
     426       shellR3i = shellRi * shellR2i
     427       aVector(j + 1) = u * shellR3i
     428       aVector(j + 2) = v * shellR3i
     429       aVector(j + 3) = w * shellR3i
     430       aVector(j + 4) = shellR2i
     431       aVector(j + 5) = shellR3i
     432       aVector(j + 6) = shellR2i * shellR2i
     433       j = j + 7
     434     end do
     435   end subroutine evec
 
