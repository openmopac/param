       1       subroutine nuchar(line, l_line, value, nvalue)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5 !-----------------------------------------------
       6 !   I n t e r f a c e   B l o c k s
       7 !-----------------------------------------------
       8       implicit none
       9 !-----------------------------------------------
      10 !   D u m m y   A r g u m e n t s
      11 !-----------------------------------------------
      12       integer, intent(in) :: l_line
      13       integer , intent(out) :: nvalue
      14       character  :: line*(*)
      15       double precision , intent(out) :: value(40)
      16 !-----------------------------------------------
      17 !   L o c a l   V a r i a b l e s
      18 !-----------------------------------------------
      19       integer , dimension(40) :: istart
      20       integer :: i
      21       logical :: leadsp
      22       character :: tab, comma, space
      23       double precision, external :: reada
      24
      25       save comma, space
      26 !-----------------------------------------------
      27 !**********************************************************************
 *
      28 !
      29 !   NUCHAR  DETERMINS AND RETURNS THE REAL VALUES OF ALL NUMBERS
      30 !           FOUND IN 'LINE'. ALL CONNECTED SUBSTRINGS ARE ASSUMED
      31 !           TO CONTAIN NUMBERS
      32 !   ON ENTRY LINE    = CHARACTER STRING
      33 !   ON EXIT  VALUE   = ARRAY OF NVALUE REAL VALUES
      34 !
      35 !**********************************************************************
 *
      36       data comma, space/ ',', ' '/
      37       tab = char(9)
      38 !
      39 ! CLEAN OUT TABS AND COMMAS
      40 !
      41       do i = 1, l_line
      42         if (line(i:i)/=tab .and. line(i:i)/=comma) cycle
      43         line(i:i) = space
      44       end do
      45 !
      46 ! FIND INITIAL DIGIT OF ALL NUMBERS, CHECK FOR LEADING SPACES FOLLOWED
      47 !     BY A CHARACTER
      48 !
      49       leadsp = .TRUE.
      50       nvalue = 0
      51       do i = 1, l_line
      52         if (leadsp .and. line(i:i)/=space) then
      53           nvalue = nvalue + 1
      54           istart(nvalue) = i
      55         end if
      56         leadsp = line(i:i) == space
 
 FORCHECK PC V13.5.13          NUCHAR          2021-03-24 10:59:30   page:   925
 nuchar.F90  /FF
 
      57       end do
      58 !
      59 ! FILL NUMBER ARRAY
      60 !
      61       do i = 1, nvalue
      62         value(i) = reada(line,istart(i))
      63       end do
      64       return
      65       end subroutine nuchar
 
