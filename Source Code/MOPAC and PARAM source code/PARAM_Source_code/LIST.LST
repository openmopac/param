    1287           xb(kp1:n) = 0.0E0
    1288         end if
    1289         if (cr) then
    1290           rsd(:k) = 0.0E0
    1291         end if
    1292         if (cb) then
    1293 !
    1294 !           COMPUTE B.
    1295 !
    1296           do jj = 1, k
    1297             j = k - jj + 1
    1298             if (x(j,j) == 0.0E0) then
    1299               info = j
    1300 !           ......EXIT
    1301               exit
    1302             end if
    1303             b(j) = b(j)/x(j,j)
    1304             if (j == 1) cycle
    1305             t = -b(j)
    1306             call saxpy (j - 1, t, x(1,j), 1, b, 1)
    1307           end do
    1308         end if
    1309         if (.not.(.not.cr .and. .not.cxb)) then
    1310 !
    1311 !           COMPUTE RSD OR XB AS REQUIRED.
    1312 !
    1313           do jj = 1, ju
    1314             j = ju - jj + 1
    1315             if (qraux(j) == 0.0E0) cycle
    1316             temp = x(j,j)
    1317             x(j,j) = qraux(j)
    1318             if (cr) then
    1319               t = -sdot(n - j + 1,x(j,j),1,rsd(j),1)/x(j,j)
    1320               call saxpy (n - j + 1, t, x(j,j), 1, rsd(j), 1)
    1321             end if
    1322             if (cxb) then
    1323               t = -sdot(n - j + 1,x(j,j),1,xb(j),1)/x(j,j)
    1324               call saxpy (n - j + 1, t, x(j,j), 1, xb(j), 1)
    1325             end if
    1326             x(j,j) = temp
    1327           end do
    1328         end if
    1329       end if
    1330       return
    1331       end subroutine sqrsl
 
