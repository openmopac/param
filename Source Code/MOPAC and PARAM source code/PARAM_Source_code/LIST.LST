       4
       5       subroutine excite (istsym, e, ci)
       6
       7 !     **** This generates spin - adapted determinates as SCF excitation
 s        ****
       8 !     **** Uses fast code for single excitations from SCF reference det
  ****
       9 !     **** or uses completely general code for Complete Active Space,
  ****
      10 !     **** single or double excitations from any number of reference
  ****
      11 !     **** determinates.
  ****
      12 !     **** The routine makes two passes: first, do determine the CI
  ****
      13 !     **** state identity, second to generate the MP2 perturbation
  ****
      14 !     **** corrections to all of the CI matrix elements.
  ****
      15       use reimers_C, only:  n, nb2, matind, nbt, nel, nshell, norb, &
      16           norbl, norbh, vnn, ixprd, nmrep, stwt, nptg, nr, ns, nslwr, &
      17           nsupr, istr, nsym, mofrag, icifrag, nconf, multci, nci, &
      18           ncore, nol, noh, nvl, nvh, nov, fastci, emaxci, nese, nciout,
  &
      19           icisym, nmp2, edef, ecore, eec, ee2, &
      20           ifst, afst, aor1, bor1, isc, tr1, nfact, vv, ifbinc, krefd, &
      21           aor, bor, aod, bod, ao1, bo1, aos, bos, cc0, gamma, beta, tot
 , &
      22           nbtmo, aocc, bocc, spintr, evalmo, nspn, nex, dbls, mspn, nol
 d, &
      23           nvhd, nolc, nvhc, mrci
      24
      25       USE molkst_C, only : norbs, nopen, nclose
      26       USE chanel_C, only : iw
      27       use cosmo_C, only  : useps
      28
      29       implicit none
      30 !     **** MP2 storage in excite and spcls ****
      31       double precision  e(nconf), ci(matind(nconf) + nconf + 1), &
      32                         ener, tel, xj12, xk12
      33       integer           vvs(4), vvd(4), a1, a, b, b1, maxunp, &
      34                         istsym(nconf), &
      35                         i1, icifrag1, iirefd, irefd, ismin, ispn, &
      36                         isynca, isyncb, &
      37                         j1, jconf, jconfm, &
      38                         jmin, maxoc, &
      39                         nalpha, nbeta, ndif, nelopn, nend, norbopn, nov
 2, nov4, &
      40                         nperm,  nv, nvs, nvd
      41       double precision, allocatable :: aii(:)
      42       logical           exok, maxmp2
      43       logical*1, allocatable :: aoc(:), boc(:)
 
 FORCHECK PC V13.5.13          EXCITE          2021-03-24 10:59:30   page:  2467
