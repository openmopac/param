     193 !     *****************************************************************
 ********
     194
     195       subroutine mo2ao (a, c, d, nn)
     196       use reimers_C, only : nb2, matind
     197
     198 !     **** this transforms a matrix A from MO to AO basis set ****
     199 !     **** or from CI state basis to spin - adapted configuration basis
     200       implicit none
     201       integer ::           i, j, k, nm, nn
     202       double precision ::  a(*), c(nn, nn), wk(nn, nn), d(nb2, 2), xx
     203
     204 ! RMG edit
     205       do i = 1, nn
     206         wk(i, 1) = d(i, 1)
     207         do j = 2, nn
     208           wk(i, j) = 0.d0
     209         end do
     210       end do
     211 ! End RMG
     212       do i = 1, nn
     213         do j = 1, nn
     214           xx = 0.d0
     215           do k = 1, nn
     216             nm = matind(max(i, k)) + min(i, k)
     217             xx = xx + a(nm) * c(k, j)
     218
     219           end do
     220           wk(i, j) = xx
     221         end do
     222       end do
     223
     224       nm = 0
     225       do j = 1, nn
     226         do i = 1, j
     227           nm = nm + 1
     228           xx = 0.d0
     229           do k = 1, nn
     230             xx = xx + c(k, i) * wk(k, j)
     231           end do
     232           a(nm) = xx
     233         end do
     234       end do
     235 ! RMG edit
     236       do i = 1, nn
     237          d(i, 1) = wk(i, 1)
     238       end do
     239 ! End RMG
     240       return
     241       end subroutine mo2ao
 
