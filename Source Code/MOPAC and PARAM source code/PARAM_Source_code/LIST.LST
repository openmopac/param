     906 subroutine add_Lewis_element(atom_i, atom_j, charge, element_type)
     907 !
     908 !  All the elements of the Lewis structure are stored in Lewis_elem
     909 !  These are used in constructing the starting LMOs
     910 !
     911 !  atom_i : If atom_j is non-zero, atom_i is the atom number of one of
 the two atoms in a bond.
     912 !  atom_i : If atom_j is zero, atom_i is the atom number of an occupied
  (normal) lone-pair
     913 !           If atom_i is negative, -atom_i is the atom number of either
  an anion or a cation,
     914 !           the choice is made later.
     915 !  atom_j : If atom_i is non-zero, atom_j is the atom number of the oth
 er of the two atoms in a bond.
     916 !  atom_j : If atom_i is zero, atom_j is the atom number of a virtual l
 one-pair
     917 !  charge : The charge implied by this Lewis element (If Na virtual lon
 e pair, then +1)
     918 !  Element_type : Type of Lewis structural element (sigma, lone pair, p
 i bond, etc.)
     919 !
     920   use MOZYME_C, only: ions, Lewis_elem, Lewis_tot, iz, ib
     921   integer, intent (in) :: atom_i, atom_j, charge
     922   integer, intent (inout) :: element_type
     923     Lewis_tot = Lewis_tot + 1
     924     Lewis_elem(1,Lewis_tot) = atom_i
     925     Lewis_elem(2,Lewis_tot) = atom_j
     926     if (atom_i > 0 .and. atom_j > 0) then
     927 !
     928 ! Diatomic bond (a line in the Lewis structure)
     929 ! Decrement both atoms by one electron and one atomic orbital
     930 !
     931       iz(atom_i) = iz(atom_i) - 1
     932       iz(atom_j) = iz(atom_j) - 1
     933       ib(atom_i) = ib(atom_i) - 1
     934       ib(atom_j) = ib(atom_j) - 1
     935       element_type = element_type + 1
     936     else if (atom_i /= 0) then
     937       if (atom_i > 0) then
     938         if (charge == -1) then
     939 !
     940 ! A lone pair (two dots in the Lewis structure) arising from a unit neg
 ative charge
     941 ! Decrement the atom by one electron and one atomic orbital.  The other
  electron
     942 ! comes from the negative charge
     943 !
     944           iz(atom_i) = iz(atom_i) - 1
     945         else if (charge == 0) then
     946 !
     947 ! A normal lone pair (two dots in the Lewis structure)
     948 ! Decrement the atom by two electrons and one atomic orbital.
     949 !
     950           iz(atom_i) = iz(atom_i) - 2
     951         end if
     952         ib(atom_i) = ib(atom_i) - 1
     953         element_type = element_type + 1  ! Lone pair
     954       else
 
 FORCHECK PC V13.5.13    ADD_LEWIS_ELEMENT     2021-03-24 10:59:30   page:  3351
 chklew.F90  /FF
 
     955 !
     956 ! At this point, the type is unknown, so simply decrement ib,
     957 ! and don't change iz.
     958 !
     959         ib(-atom_i) = ib(-atom_i) - 1
     960       end if
     961     else
     962       if (charge == 2) then
     963 !
     964 ! A virtual lone pair arising from a di-cation
     965 ! Decrement the atom by two electrons and one atomic orbital.
     966 ! (Think of Ca(++) - this is calcium after removal of two electrons
     967 !
     968         iz(atom_j) = iz(atom_j) - 2
     969       else if (charge == 1) then
     970 !
     971 ! A virtual lone pair arising from a cation
     972 ! Decrement the atom by one electrons and one atomic orbital.
     973 ! (Think of Na(+) - this is sodium after removal of one electron
     974 !
     975         iz(atom_j) = iz(atom_j) - 1
     976       end if
     977       ib(atom_j) = ib(atom_j) - 1
     978     end if
     979     if (charge == 0) return
     980     ions(atom_i + atom_j) = ions(atom_i + atom_j) + charge
     981 end subroutine add_Lewis_element
 
