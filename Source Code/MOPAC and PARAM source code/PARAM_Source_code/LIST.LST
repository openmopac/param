    1139   subroutine compare_txtatm(bug, any_bug)
    1140     use molkst_C, only : numat, maxtxt, keywrd, line, keywrd_txt
    1141     use common_arrays_C, only : txtatm, txtatm1, nat
    1142     use chanel_C, only : iw, job_fn
    1143     implicit none
    1144     logical, intent (inout) :: bug, any_bug
    1145     integer :: i, j, ii,jj
    1146     if (index(keywrd, "GEO-OK") /= 0) return
    1147     if (index(keywrd, "GEO_REF") == 0) return
    1148     bug = .false.
    1149     if (maxtxt /= 27) return
    1150     do i = 1, numat
    1151       do j = 1, 2
    1152         if (txtatm(i)(20:20) /= " ") exit
    1153         txtatm(i)(18:20) = " "//txtatm(i)(18:19)
    1154       end do
    1155       do j = 1, 2
    1156         if (txtatm1(i)(20:20) /= " ") exit
    1157         txtatm1(i)(18:20) = " "//txtatm1(i)(18:19)
    1158       end do
    1159     end do
    1160     do i = 1, numat
    1161       do j = i + 1, numat
    1162         if (txtatm1(i)(12:) == txtatm1(j)(12:)) exit
    1163       end do
    1164       if (j <= numat .and. nat(i) /= 1) then
    1165         if ( .not. bug) then
    1166           ii = index(keywrd_txt, "GEO_DAT=")
    1167          if (ii > 0) then
    1168             jj = index(keywrd(ii + 9:),'"') + ii + 7
    1169             line = keywrd(ii + 9:jj)
    1170             write(iw,'(/10x,a,/)')"Atoms in the GEO_DAT file '"// &
    1171             trim(line)//"' with the same labels"
    1172           else
    1173             write(iw,'(/10x,a,/)')"Atoms in the data-set file '"// &
    1174             trim(job_fn)//"' with the same labels"
    1175           end if
    1176           write(iw,'(10x,a,i6,a,i6,a)')"Atoms", i, " and", j, &
    1177           ";  Labels: ("//txtatm1(i)//") and ("//txtatm1(j)//")"
    1178         end if
    1179         bug = .true.
    1180       end if
    1181     end do
    1182     if (bug) then
    1183       call mopend("Error in data detected while using GEO_REF")
    1184       write(iw,"(5x,a)")"(To continue with the current data set, use 'G
 EO-OK')"
    1185       any_bug = .true.
    1186     end if
    1187     return
    1188   end subroutine compare_txtatm
 
