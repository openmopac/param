      94             end do
      95           end do
      96 !         **** nuclear repulsion energy, gav = weighted s, p, d gammas
 ****
      97
      98           if (i == j) then
      99 !           **** calculation of core matrix elements for this atom ****
     100             call uform (i, fg(1, ia), f0, zcore(i))
