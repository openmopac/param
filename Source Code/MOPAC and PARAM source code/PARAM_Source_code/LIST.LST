     154 !
     155 !
     156 !
     157   double precision function nsp2_atom_correction(vectors,n,i,j,k)
     158   implicit none
     159   double precision :: vectors(3,*)
     160   integer :: n,i,j,k
     161
     162   double precision :: a, b, c, ab, ac, bc, tot, cosa, cosb, cosc
     163 !
     164 !  Evaluate the penalty for non-planarity
     165 !  - done by working out the three angles about the central atom
     166 !  (here "n") subtended by the lines to atoms "i", "j", and "k".
     167 !
     168   a = sqrt((vectors(1,n) - vectors(1,i))**2 + &
     169            (vectors(2,n) - vectors(2,i))**2 + &
     170            (vectors(3,n) - vectors(3,i))**2)
     171   b = sqrt((vectors(1,n) - vectors(1,j))**2 + &
     172            (vectors(2,n) - vectors(2,j))**2 + &
     173            (vectors(3,n) - vectors(3,j))**2)
     174   c = sqrt((vectors(1,n) - vectors(1,k))**2 + &
     175            (vectors(2,n) - vectors(2,k))**2 + &
     176            (vectors(3,n) - vectors(3,k))**2)
     177   ab = sqrt((vectors(1,j) - vectors(1,i))**2 + &
     178             (vectors(2,j) - vectors(2,i))**2 + &
     179             (vectors(3,j) - vectors(3,i))**2)
     180   ac = sqrt((vectors(1,k) - vectors(1,i))**2 + &
     181             (vectors(2,k) - vectors(2,i))**2 + &
     182             (vectors(3,k) - vectors(3,i))**2)
     183   bc = sqrt((vectors(1,j) - vectors(1,k))**2 + &
     184             (vectors(2,j) - vectors(2,k))**2 + &
     185             (vectors(3,j) - vectors(3,k))**2)
     186 !
     187   cosa = dacos((b**2 +c**2 -bc**2)/(2.d0*b*c))
     188   cosb = dacos((a**2 +c**2 -ac**2)/(2.d0*a*c))
     189   cosc = dacos((b**2 +a**2 -ab**2)/(2.d0*b*a))
     190 !
     191 !  tot = difference between the sum of the three angles and
     192 !        360 degrees, expressed as radians.
     193   tot = 4.d0*asin(1.d0) - (cosa + cosb + cosc)
     194   nsp2_atom_correction = -0.5d0*exp(-10.d0*tot)
     195   end function nsp2_atom_correction
 
