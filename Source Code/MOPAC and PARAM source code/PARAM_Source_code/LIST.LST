    1185 !
    1186       subroutine empiri ()
    1187       use molkst_C, only : numat, formula
    1188       use Common_arrays_C, only : nat
    1189       use chanel_C, only : log, ilog
    1190       implicit  none
    1191       integer :: i, j, k, nlab
    1192       character  :: elemnt(107)*2, line*120
    1193       integer, dimension (50) :: llab, mlab
    1194       intrinsic Char, Ichar, Int, Log10
    1195       data elemnt / "H ", "He", "Li", "Be", "B ", "C ", "N ", "O ", "F
 ", "Ne", &
    1196      & "Na", "Mg", "Al", "Si", "P ", "S ", "Cl", "Ar", "K ", "Ca", "Sc"
 , "Ti", &
    1197      & "V ", "Cr", "Mn", "Fe", "Co", "Ni", "Cu", "Zn", "Ga", "Ge", "As"
 , "Se", "Br", &
    1198      & "Kr", "Rb", "Sr", "Y ", "Zr", "Nb", "Mo", "Tc", "Ru", "Rh", "Pd"
 , "Ag", &
    1199      & "Cd", "In", "Sn", "Sb", "Te", "I ", "Xe", "Cs", "Ba", "La", "Ce"
 , "Pr", &
    1200      & "Nd", "Pm", "Sm", "Eu", "Gd", "Tb", "Dy", "Ho", "Er", "Tm", "Yb"
 , "Lu", &
    1201      & "Hf", "Ta", "W ", "Re", "Os", "Ir", "Pt", "Au", "Hg", "Tl", "Pb"
 , "Bi", "Po", &
    1202      & "At", "Rn", "Fr", "Ra", "Ac", "Th", "Pa", "U ", "Np", "Pu", "Am"
 , "Cm", &
    1203      & "Bk", "Mi", "XX", "+3", "-3", "Cb", "++", "+ ", "--", "- ", "Tv"
  /
    1204      !
    1205      !    The order of elements in the empirical formula is C H N O, th
 en
    1206      !    whatever else there is, in no particular order.  (The order o
 f the
    1207      !    remaining elements is the order in which they occur in the
    1208      !    molecule.
    1209      !
    1210       nlab = 4
    1211       llab(1) = 6
    1212       llab(2) = 1
    1213       llab(3) = 7
    1214       llab(4) = 8
    1215       do i = 1, 4
    1216         mlab(i) = 0
    1217       end do
    1218       do i = 1, numat
    1219         j = nat(i)
    1220         do k = 1, nlab
    1221           if (j == llab(k)) go to 1000
    1222         end do
    1223         nlab = nlab + 1
    1224         llab(nlab) = j
    1225         mlab(nlab) = 1
    1226         cycle
    1227   1000  mlab(k) = mlab(k) + 1
    1228       end do
    1229       j = 0
    1230       do i = 1, nlab
    1231         if (mlab(i) /= 0) then
 
 FORCHECK PC V13.5.13          EMPIRI          2021-03-24 10:59:30   page:  4370
 writmo.F90  /FF
 
    1232           j = j + 1
    1233           mlab(j) = mlab(i)
    1234           llab(j) = llab(i)
    1235         end if
    1236       end do
    1237       nlab = j
    1238      !
    1239      !   BUILD THE FORMAT STATEMENT
    1240       line = "(10X,A,1X,"
    1241       j = 11
    1242       do i = 1, nlab
    1243         if (i /= 1) then
    1244           j = j + 1
    1245           line (j:j) = ","
    1246         end if
    1247         j = j + 1
    1248         !                       CHARACTER FORMAT
    1249         line (j:j) = "A"
    1250         k = 2
    1251         if (elemnt(llab(i)) (2:2) == " ") then
    1252           k = 1
    1253         end if
    1254         j = j + 1
    1255         line (j:j) = Char (k+Ichar ("0"))
    1256         j = j + 1
    1257         !                       NUMBER FORMAT
    1258         if (mlab(i) > 1) then
    1259            !***********************************************************
 ************
    1260           line (j:j+5) = ",I" // Char (Int(Log10(1.0*mlab(i)))+Ichar ("
 1")) // ",1X"
    1261           j = j + 5
    1262         else
    1263           mlab(i) = 0
    1264   !
    1265   !  If formula goes over nline characters, exit.  The system is obviou
 sly artificial
    1266   !
    1267         if ( j + 4 > 400 ) return
    1268           line (j:j+4) = ",I1.0"
    1269           j = j + 4
    1270         end if
    1271       end do
    1272       j = j + 1
    1273       line (j:j+2) = ")"
    1274       write (formula, line) " Empirical Formula:", (elemnt(llab(i)), ml
 ab(i), i=1, nlab)
    1275       write(formula(len_trim(formula) + 1:),"(a,i6,a)")"  =",numat," at
 oms"
    1276       if (log) write(ilog, line(1:len_trim(line) - 1)//",a,i6,a)") " Em
 pirical Formula:", &
    1277         (elemnt(llab(i)), mlab(i), i=1, nlab),"  =",numat," atoms"
    1278   end subroutine empiri
 
