     553
     554        subroutine molpab (n1, n2, l1, l2, m1, m2, sk1, sk2, r, vest)
     555 !
     556 !     this subroutine calculates two centered overlap integrals
     557 !
     558       use reimers_C, only : fact
     559
     560 !      implicit          double precision :: (a - h, o - z)
     561       implicit none
     562       double precision ::   sk1, sk2, r, vest, &
     563                          f1, f2, f3, f4, f5, f6, &
     564                          f11, f12, f13, f14, f15, f16, f17, f18, &
     565                          q1, q2, rhoa, rhob, strad, strad1, term, value
     566       integer ::            j, k, iff, jend, ju, kend, ku, &
     567                          l1, l2, m1, m2, n1, n2
     568
     569       vest = 0.0d0
     570       if (m1 /= m2)  go to 500
     571       strad = 0.0d0
     572       rhoa = r*sk1
     573       rhob = r*sk2
     574       f1 = fact(2*n1 + 1)
     575       f2 = fact(2*n2 + 1)
     576       iff = l1 - m1 + 1
     577       f3 = fact(iff)
     578       iff = l2 - m2 + 1
     579       f4 = fact(iff)
     580       iff = l1 + m1 + 1
     581       f5 = fact(iff)
     582       iff = l2 + m2 + 1
     583       f6 = fact(iff)
     584       q1 = (sk1**n1/dsqrt(f1))*r**n1
     585       q2 = (sk2**n2/dsqrt(f2))*r**n2
     586       term = dsqrt(dfloat((2*l1 + 1)*(2*l2 + 1))*&
     587      &  (f3/f5)*(f4/f6)*rhoa*rhob)/2.d0**(l1 + l2 + 1)
     588       term = q1*term*q2
     589       jend = 1 + ((l1 - m1)/2)
     590       kend = 1 + ((l2 - m2)/2)
     591       do 501 j = 1, jend
     592       ju = j - 1
     593       iff = 2*l1 - 2*ju + 1
     594       f11 = fact(iff)
     595       iff = l1 - m1 - 2*ju + 1
     596       f13 = fact(iff)
     597       f15 = fact(ju + 1)
     598       iff = l1 - ju + 1
     599       f17 = fact(iff)
     600       do 502 k = 1, kend
     601       ku = k - 1
     602       iff = 2*l2 - 2*ku + 1
     603       f12 = fact(iff)
     604       iff = l2 - m2 - 2*ku + 1
     605       f14 = fact(iff)
     606       f16 = fact(ku + 1)
     607       iff = l2 - ku + 1
     608       f18 = fact(iff)
 
 FORCHECK PC V13.5.13          MOLPAB          2021-03-24 10:59:30   page:  2072
 ovlp.F90  /FF
 
     609       call cfunct (n1 - l1 + 2*ju, n2 - l2 + 2*ku, l1 - m1 - 2*ju, l2 -
  m2 - 2*ku, m1, value)
     610       strad1 = value * (f11/f13/f15/f17) * (f12/f14/f16/f18)
     611       if (mod(ju + ku, 2) == 1) strad1 = -strad1
     612       strad = strad + strad1
     613   502 continue
     614   501 continue
     615       vest = term*strad
     616   500 return
     617       end subroutine molpab
 
