    1541       double precision function rsc (k, na, ea, nb, eb, nc, ec, nd, ed)
    1542 !-----------------------------------------------
    1543 !   M o d u l e s
    1544 !-----------------------------------------------
    1545       USE mndod_C, only : fx, b
    1546       use funcon_C, only : ev
    1547 !     *
    1548 !     CALCULATE THE RADIAL PART OF ONE-CENTER TWO-ELECTRON INTEGRALS
    1549 !     (SLATER-CONDON PARAMETER)
    1550 !     K- TYPE OF INTEGRAL ,   CAN BE EQUAL TO 0,1,2,3,4 IN SPD-BASIS
    1551 !     NA,NB -PRINCIPLE QUANTUM NUMBER OF AO,CORRESPONDING ELECTRON 1
    1552 !     EA,EB -EXPONENTS OF AO,CORRESPONDING ELECTRON 1
    1553 !     NC,ND -PRINCIPLE QUANTUM NUMBER OF AO,CORRESPONDING ELECTRON 2
    1554 !     EC,ED -EXPONENTS OF AO,CORRESPONDING ELECTRON 2
    1555 !     *
    1556       implicit none
    1557 !-----------------------------------------------
    1558 !   D u m m y   A r g u m e n t s
    1559 !-----------------------------------------------
    1560       integer , intent(in) :: k
    1561       integer , intent(in) :: na
    1562       integer , intent(in) :: nb
    1563       integer , intent(in) :: nc
    1564       integer , intent(in) :: nd
    1565       double precision , intent(in) :: ea
    1566       double precision , intent(in) :: eb
    1567       double precision , intent(in) :: ec
    1568       double precision , intent(in) :: ed
    1569 !-----------------------------------------------
    1570 !   L o c a l   V a r i a b l e s
    1571 !-----------------------------------------------
    1572       integer :: nab, ncd, n, m, i, m1, m2
    1573       double precision :: aea, aeb, aec, aed, ecd, eab, e, ae, a2, acd,
  aab, ff, c, s0, s1, s2, s3
    1574 !-----------------------------------------------
    1575       aea = log(ea)
    1576       aeb = log(eb)
    1577       aec = log(ec)
    1578       aed = log(ed)
    1579       nab = na + nb
    1580       ncd = nc + nd
    1581       ecd = ec + ed
    1582       eab = ea + eb
    1583       e = ecd + eab
    1584       n = nab + ncd
    1585       ae = log(e)
    1586       a2 = log(2.d0)
    1587       acd = log(ecd)
    1588       aab = log(eab)
    1589       ff = fx(n)/sqrt(fx(2*na+1)*fx(2*nb+1)*fx(2*nc+1)*fx(2*nd+1))
    1590       c = ev*ff*exp(na*aea + nb*aeb + nc*aec + nd*aed + 0.5d0*(aea + ae
 b + aec + &
    1591         aed) + a2*(n + 2) - ae*n)
    1592       s0 = 1.d0/e
    1593       s1 = 0.d0
    1594       s2 = 0.d0
    1595       m = ncd - k
    1596       do i = 1, m
 
 FORCHECK PC V13.5.13           RSC            2021-03-24 10:59:30   page:  1478
 mndod.F90  /FF
 
    1597         s0 = s0*e/ecd
    1598         s1 = s1 + s0*(b(ncd-k,i)-b(ncd+k+1,i))/b(n,i)
    1599       end do
    1600       m1 = m + 1
    1601       m2 = ncd + k + 1
    1602       do i = m1, m2
    1603         s0 = s0*e/ecd
    1604         s2 = s2 + s0*b(m2,i)/b(n,i)
    1605       end do
    1606       s3 = exp(ae*n - acd*m2 - aab*(nab - k))/b(n,m2)
    1607       rsc = c*(s1 - s2 + s3)
    1608       return
    1609       end function rsc
 
