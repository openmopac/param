       1       subroutine partxy(c34, pq34, w)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use molkst_C, only : numcal, numat, lm61
       6       use common_arrays_C, only : nfirst, nlast
       7 !**********************************************************************
 *
       8 !-----------------------------------------------
       9 !   I n t e r f a c e   B l o c k s
      10 !-----------------------------------------------
      11       implicit none
      12 !-----------------------------------------------
      13 !   D u m m y   A r g u m e n t s
      14 !-----------------------------------------------
      15       double precision  :: c34(*)
      16       double precision  :: pq34(lm61)
      17       double precision  :: w(*)
      18 !-----------------------------------------------
      19 !   L o c a l   P a r a m e t e r s
      20 !-----------------------------------------------
      21 !-----------------------------------------------
      22 !   L o c a l   V a r i a b l e s
      23 !-----------------------------------------------
      24       integer , dimension(-1:8) :: nb
      25       integer :: icalcn, iband, kr, ls, ii, ia, ib, lsp, i, &
      26         j, lsw, k, l, jband, js, jj
      27       double precision :: aa, sum, bb
      28       save nb, icalcn
      29 !-----------------------------------------------
      30 !------------------------------------------------------------------
      31 !
      32 !    PARTXY WORKS OUT  IN MNDO FORMALISM THE FIRST 2-INDICES TRANSFO.
      33 !          REQUIRED IN THE COMPUTATION OF 2-ELECTRONS REPULSION OVER M.
 O
      34 !  INPUT
      35 !     C34   : VECTOR OF THE CURRENT CHARGE DISTRIBUTION BETWEEN TWO M.O
 .
      36 !  OUTPUT
      37 !     PQ34(PQ) : <P(1),Q(1)|C3(2),C4(2)> WHERE P ,Q  ARE A.O.
      38 !                                          AND C3,C4 ARE M.O.
      39 !                P AND Q RUN IN CANONICAL ORDER OVER THE A.O BELONGING
      40 !                TO AN ATOM 'A' ONLY (BASIC ASSUMPTION OF MNDO SCHEME)
      41 !                AND 'A' RUNS OVER THE ATOMS OF THE SYSTEM.
      42 !     D.L. (DEWAR GROUP) 1986
      43 !----------------------------------------------------------------------
      44       data nb/ 0, 1, 0, 0, 10, 0, 0, 0, 0, 45/
      45       data icalcn/ 0/
      46       if (numcal /= icalcn) then
      47         icalcn = numcal
      48       end if
      49 !     KK    : POINTER OF SUPPORTING ATOM, SPARKLES SKIPPED OUT.
      50  !     KK    : POINTER OF SUPPORTING ATOM, SPARKLES SKIPPED OUT.
      51    !
      52    !     LOOP OVER OUTER ATOM A, SPARKLES EXCLUDED.
      53    !     ------------------------------------------
      54     iband = 1
      55     kr = 1
 
 FORCHECK PC V13.5.13          PARTXY          2021-03-24 10:59:30   page:  3637
 partxy.F90  /FF
 
      56     ls = 0
      57     pq34 = 0.d0
      58     do ii = 1, numat
      59       ia = nfirst(ii)
      60       ib = nlast(ii)
      61       if (ib >= ia) then
      62         ls = ls + iband
      63         iband = nb(ib-ia)
      64          !
      65          !     PQ34(IJ) = <IJ|KL> * C34(KL)  , 1-CENTRE CONTRIBUTIONS.
      66         lsp = ls - 1
      67          !
      68          !        LOOP OVER CHARGE DISTRIBUTION OF INNER ATOMS  B < A .
      69          !        -----------------------------------------------------
      70          !        PQ34(IJ)=<IJ|KL>*C34(KL) 2-CENTRES CONTRIBUTIONS.
      71          !
      72         jband = 1
      73         js = 0
      74         do jj = 1, ii - 1
      75           js = js + jband
      76           jband = nb(nlast(jj)-nfirst(jj))
      77           if (jband /= 0) &
      78           call formxy (w(kr), kr, pq34(ls), pq34(js), c34(ls), iband,
 c34(js), jband)
      79         end do
      80         lsp = ls - 1
      81         do i = ia, ib
      82           aa = 1.d0
      83           do j = ia, i
      84             if (i == j) then
      85               aa = 0.5d0
      86             end if
      87             lsp = lsp + 1
      88                !
      89                !    'J' Address IJ in W
      90                !
      91             sum = 0.d0
      92             lsw = ls - 1
      93             do k = ia, ib
      94               bb = 1.d0
      95               do l = ia, k
      96                 if (l == k) then
      97                   bb = 0.5d0
      98                 end if
      99                 lsw = lsw + 1
     100                      !
     101                      !   The term itself
     102                      !
     103                 sum = sum + c34(lsw) * w(kr) * bb
     104                 kr = kr + 1
     105               end do
     106             end do
     107             pq34(lsp) = pq34(lsp) + sum * aa
     108           end do
     109         end do
     110       end if
     111     end do
     112 end subroutine partxy
 
