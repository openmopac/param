     548 !     *****************************************************************
 ********
     549
     550       function gamma1 (gammk, gammk1, r)
     551
     552       use reimers_C, only : nham, au2ev, au2ang, tomk
     553       implicit none
     554       double precision ::   r, gamma1, gamma2, gammk, gammk1
     555
     556 !     **** two - electron repulsion integrals ****
     557
     558       nham = 2
     559 !     **** mataga integrals (with Tomono/Weiss modifications) ****
     560       gamma2 = au2ev / (r/au2ang + tomk*2.d0*au2ev/(gammk + gammk1) )
     561
     562       if (nham /= 3) gamma2 = gamma2 * tomk
     563       gamma1 = gamma2
     564       return
     565       end function gamma1
 
