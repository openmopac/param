     181                     k = k + 1
     182                     padi(l) = p(k) * 0.5d0
     183                     pdi(l) = p(k)
     184                   end do
     185                 end do
     186               end if
     187                   ! GET SECOND ATOM
     188               k = ijbo (ii, ii)
     189               ij = iorbs(jj)
     190               do i = 1, iorbs(ii)
     191                 ij = ij + 1
     192                 l = (ij*(ij-1)) / 2 + iorbs(jj)
     193                 do j = 1, i
     194                   k = k + 1
     195                   l = l + 1
     196                   padi(l) = p(k) * 0.5d0
     197                   pdi(l) = p(k)
     198                 end do
     199               end do
     200               pbdi = padi
     201               point = .false.
     202             else
     203               point = .true.
     204             end if
     205           else
     206           point = .false.
     207           ij = 0
     208             do i = jf, jl
     209               k = (i*(i - 1))/2 + jf - 1
     210               if (i - jf + 1 > 0) then
     211                 padi(ij+1:i-jf+1+ij) = pa(k+1:i-jf+1+k)
     212                 pbdi(ij+1:i-jf+1+ij) = pb(k+1:i-jf+1+k)
     213                 pdi(ij+1:i-jf+1+ij) = p(k+1:i-jf+1+k)
     214                 ij = i - jf + 1 + ij
     215               end if
     216             end do
     217 ! GET SECOND ATOM FIRST ATOM INTERSECTION
     218             do i = if, il
