    1284
    1285       subroutine twopho (i0, ener, dm, istsym)
    1286
    1287 !     **** this calculates 2 - photon relative einstein - B coefficient
 s        ****
    1288 !     **** for absorption from state i0 which must be non - degenerate
  ****
    1289 !     **** D.P. Craig and T. Thirunamachandran Molecular Quantum
  ****
    1290 !     **** Electrodynamics (Academic, London, 1984) P109
  ****
    1291       use reimers_C, only : matind, nconf, nptg, nmrep, ixprd, nciout
    1292       USE chanel_C, only : iw
    1293
    1294       implicit none
    1295       double precision ::   ener(nconf), dm(nconf*(nconf + 1)/2, 3), &
    1296                          alp11, alp21, alp22, alp31, alp32, alp33, &
    1297                          d, trace, od, planar, circ
    1298       integer ::            istsym(nconf), j, k, i0, isym, nj, nk
    1299       write (iw, "('1Single - Beam 2 - photon relative Einstein B coeff
 icients', &
    1300      &        ' exciting from state', i4 /&
    1301      &        ' transition  energy  lin    cir!       xx        xy', &
    1302      &        '        yy        xz        yz        zz' / )") i0
    1303
    1304 !     **** loop over all outputted states j ****
    1305
    1306       do j = 1, nciout
    1307         if (j /= i0) then
    1308           alp11 = 0.d0
    1309           alp21 = 0.d0
    1310           alp22 = 0.d0
    1311           alp31 = 0.d0
    1312           alp32 = 0.d0
    1313           alp33 = 0.d0
    1314
    1315 !         **** loop over all intermediate states k ****
    1316           do k = 1, nconf
    1317             if (k /= i0 .and. k /= j) then
    1318               nj = matind (max(i0, k)) + min(i0, j)
    1319               nk = matind (max(k, j)) + min(k, j)
    1320               d = 1.d0 / (ener(k) - ener(j))
    1321               alp11 = alp11 + dm(nj, 1)*dm(nk, 1) * d
    1322               alp22 = alp22 + dm(nj, 2)*dm(nk, 2) * d
    1323               alp33 = alp33 + dm(nj, 3)*dm(nk, 3) * d
    1324               alp21 = alp21 + (dm(nj, 2)*dm(nk, 1) + dm(nj, 1)*dm(nk, 2
 )) * d
    1325               alp31 = alp31 + (dm(nj, 3)*dm(nk, 1) + dm(nj, 1)*dm(nk, 3
 )) * d
    1326               alp32 = alp32 + (dm(nj, 3)*dm(nk, 2) + dm(nj, 2)*dm(nk, 3
 )) * d
    1327             end if
    1328           end do
    1329
    1330 !         **** double count diag terms, calc single - beam intensities
 ****
 
 FORCHECK PC V13.5.13          TWOPHO          2021-03-24 10:59:30   page:  4006
 ci.F90  /FF
 
    1331           alp11 = alp11 * 2.d0
    1332           alp22 = alp22 * 2.d0
    1333           alp33 = alp33 * 2.d0
    1334           trace = alp11 + alp22 + alp33
    1335           od = alp11**2 + alp22**2 + alp33**2 + 2.d0 * &
    1336      &       (alp21**2 + alp31**2 + alp32**2)
    1337           planar = trace**2 + 2.d0 * od
    1338           circ = -trace**2 + 3.d0 * od
    1339           isym = ixprd (istsym(i0), istsym(j))
    1340           write (iw, '(i4, 1x, a3, f8.3, 2f8.3, 6f10.7)') j, nmrep(isym
 , nptg), &
    1341             ener(j) - ener(i0), planar, circ, alp11, alp21, alp22, alp3
 1, alp32, alp33
    1342         end if
    1343       end do
    1344
    1345       return
    1346       end subroutine twopho
 
