     204           subroutine sym_commute(mat1, mat2, mat3, size)
     205             implicit none
     206             integer :: i, j
     207             integer , intent(in) :: size
     208             double precision , intent(in) :: mat1(size, size)
     209             double precision , intent(in) :: mat2(size, size)
     210             double precision , intent(out) :: mat3(size, size)
     211     !-----------------------------------------------
     212     !******************************************************************
 *****
     213     !
     214     !   COMPUTE THE COMMUTATOR BETWEEN TWO SYMMETRIC MATRICES
     215     !   (DGEMM & AN IN-PLACE EVALUATION OF THE SECOND TERM)
     216     !
     217     ! ARGUMENTS:-
     218     !         ON INPUT MAT1   = FIRST SYMMETRIC MATRIX IN COMMUTATOR
     219     !                  MAT2   = SECOND SYMMETRIC MATRIX IN COMMUTATOR
     220     !                  SIZE   = DIMENSION OF MATRIX
     221     !      ON OUTPUT   MAT3   = MAT1*MAT2 - MAT2*MAT1
     222     !
     223     !******************************************************************
 *****
     224             call dsymm('L', 'U', size, size, 1.D0, mat1, size, mat2, si
 ze, 0.D0, mat3, size)
     225             do i = 1, size
     226               do j = i, size
     227                 mat3(i,j) = mat3(i,j) - mat3(j,i)
     228                 mat3(j,i) = -mat3(i,j)
     229               end do
     230             end do
     231             return
     232             end subroutine sym_commute
 
