       1 subroutine greek (n1)
       2     use MOZYME_C, only: nbackb
       3     use common_arrays_C, only : txtatm, nat, nbonds, ibonds
       4     implicit none
       5     integer, intent (in) :: n1
       6 !
       7     integer :: i, ico, ihcr, ii, j, jatom1, jjj, k1, l, ll, m, ncurr, n
 next
       8     integer :: nold4 = 0, nprev = 0
       9     character, dimension (22) :: types
      10     integer, dimension (150) :: icurr, inext, iprev
      11     logical :: Trp, Ile
      12     data types / "G", "D", "E", "Z", "H", "T", "I", "K", "L", "M", &
      13    & "N", "X", "O", "P", "R", "S", "T", "U", "F", "C", "Y", "W" /
      14    !
      15    !             NBACKB(1) =  Carbon CHR  of N-CHR-CO-N'
      16    !             NBACKB(2) =  Carbon CO   of N-CHR-CO-N'
      17    !             NBACKB(4) =  Nitrogen N' of N-CHR-CO-N'
      18     ihcr = nbackb(1)
      19     ico  = nbackb(2)
      20     jatom1 = nold4
      21     nold4 = nbackb(4)
      22    !
      23    !  Backbone atom 'IHCR' is ALPHA.
      24    !
      25    !   Special case:  avoid last residue being re-labeled.
      26    !
      27     do i = 1, nbonds(ihcr)
      28       if (nat(ibonds(i, ihcr)) == 8) go to 1000
      29     end do
      30     txtatm (ihcr) (15:15) = "A"
      31    !
      32    !  Find the BETA carbon, if present
      33    !
      34 1000 do i = 1, nbonds(ihcr)
      35       j = ibonds(i, ihcr)
      36       if (nat(j) == 6) then
      37         if (j /= ico) go to 1010
      38       end if
      39     end do
      40     return
      41 1010 txtatm (j) (15:15) = "B"
      42    !
      43    !  Now slowly go through the rest of the residue, assigning
      44    !  letters and numbers.
      45    !
      46     Trp = txtatm(j)(18:20) == "TRP"
      47     Ile = txtatm(j)(18:20) == "ILE"
      48     nnext = 1
      49     icurr(1) = j
      50     ncurr = 1
      51     iprev(1) = ihcr
      52     do jjj = 1, 22
      53       !
      54       !   NNEXT  =           Number of atoms of next type
      55       !   INEXT =     Atom numbers of atoms of next type
      56       !
      57       !   NCURR  =        Number of atoms of current type
 
 FORCHECK PC V13.5.13          GREEK           2021-03-24 10:59:30   page:  2332
 greek.F90  /FF
 
      58       !   ICURR =  Atom numbers of atoms of current type
      59       !
      60       !   NPREV  =       Number of atoms of previous type
      61       !   IPREV = Atom numbers of atoms of previous type
      62       !
      63       nprev = ncurr
      64       ncurr = nnext
      65       nnext = 0
      66       do ii = 1, ncurr
      67         j = icurr(ii)
      68         if (j == n1) cycle  !  Unconditionally, do not label the N of t
 he peptide.
      69         k1 = nbonds(j)
      70         loop1: do l = 1, k1
      71           m = ibonds(l, j)
      72             !
      73             !  Check that atom 'M' is not (a) a previous atom,
      74             !  (b) a current atom, or (c) the backbone nitrogen of a pr
 oline.
      75             !
      76           do ll = 1, nprev
      77             if (m == iprev(ll)) cycle loop1
      78           end do
      79           do ll = 1, ncurr
      80             if (m == icurr(ll)) cycle loop1
      81           end do
      82           if (m /= jatom1) then
      83             nnext = nnext + 1
      84             inext(nnext) = m
      85           end if
      86           if (nat(m) == 7 .and. txtatm(ihcr)(18:20) == "PRO") then
      87             nnext = max(0, nnext - 1)
      88           end if
      89         end do loop1
      90       end do
      91       if (nnext == 0) exit
      92       if (Trp) then
      93         if (jjj == 2) then
      94 !
      95 !  Make sure that the carbon attached to a nitrogen is first
      96 !
      97           j = inext(1)
      98           do l = 1, nbonds(j)
      99             if (nat(ibonds(l,j)) == 7) exit
     100           end do
     101           if (l > nbonds(j)) then
     102             l = inext(1)
     103             inext(1) = inext(2)
     104             inext(2) = j
     105           end if
     106         end if
     107       else if (Ile) then
     108         if (jjj == 1) then
     109 !
     110 !  Make sure that CG1 is the carbon of the ethyl group in isoleucine
     111 !
     112          j = inext(1)
     113           m = 0
     114           do l = 1, nbonds(j)
 
 FORCHECK PC V13.5.13          GREEK           2021-03-24 10:59:30   page:  2333
