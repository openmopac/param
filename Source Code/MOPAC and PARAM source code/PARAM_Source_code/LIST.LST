     504     if (nres > 0) then
     505       write(iprt,"(a)")"<p align=""center"">Toggle Individual Residues<
 /p>"
     506       write(iprt,"(a)") "<TABLE>"
     507       write(iprt,"(a)") "<TR>"
     508 !
     509 ! Number of rows is a maximum of 36.
     510 ! If the number of residues is small, put 8 residues on a line
     511 !
     512       ncol = max(7, nres/16) + 1
     513       nprt = 1
     514       do i = 1, nres
     515         n_res = "["//res_txt(i)(:3)//"]"
     516         j = nint(reada(res_txt(i),4))
     517         if (j < 0) then
     518           num = char(Int(log10(-j + 1.0)) + ichar("2"))
     519           write(n_res(6:),'(i'//num//',a)')j, res_txt(i)(8:9)
     520         else
     521           num = char(Int(log10(j + 1.0)) + ichar("1"))
     522           write(n_res(6:),'(i'//num//',a)')j, res_txt(i)(8:9)
     523         end if
     524         if (maxtxt == 27 .and. res_txt(i)(10:10) /= " ") then
     525           j = index(n_res,":")
     526           n_res = n_res(:j - 1)//"^"//res_txt(i)(10:10)//trim(n_res(j:)
 )
     527         end if
     528         wrt_res = n_res(2:4)//n_res(6:)
     529         l_res = res_txt(i)(:7)//res_txt(i)(9:10)
     530   !
     531   !  Residue names must not start with a number.  If they do, convert t
 hem into a letter
     532   !  0 => A, 1 => B, etc.
     533   !
     534         if (l_res(1:1) >= "0" .and. l_res(1:1) <= "9") &
     535           l_res(1:1) = char(ichar("A") + ichar(l_res(1:1)) - ichar("0")
 )
     536         do j = 1, 23
     537           if (n_res(2:4) == tyres(j)) exit
     538         end do
     539         if (j > 23) then
     540           n_res(:5) = " "
     541           wrt_res(1:1) = "X"
     542         else
     543           wrt_res(1:1) = tyr(j)
     544           if (wrt_res(1:1) == "?") wrt_res(1:1) = "X"
     545         end if
     546         j = index(l_res, "-")
     547         if (j > 0) l_res(j:j) = "_"
     548         if (n_res(2:4) == "UNK") then
     549           if (res_txt(i)(1:3) == "UNK") then
     550             n_res = "[UNK]"//res_txt(i)(4:7)
     551           else
     552             n_res = res_txt(i)(4:7)
     553           end if
     554         end if
     555         write(iprt,"(2a)") "<TD> <a href=""javascript:Jmol.script(jmolA
 pplet0,'if (!"//l_res, &
     556         ");   display ADD "//trim(n_res)//";  "//l_res//" = TRUE; else
 "
 
