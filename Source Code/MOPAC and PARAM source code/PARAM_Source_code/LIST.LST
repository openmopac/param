      68         multiplier_nh4 = 3.61d0
      69         multiplier_coo = 1.41d0
      70       end if
      71     end if
      72     d_list(1) = i
      73     d_list(2) = j
      74     d_list(3) = H_i
      75     nd_list = 3
      76 !
      77 ! Iterate over donor/acceptor pairs
      78 !
      79     e_corr_sum = 0.d0
      80     N_Hbonds = 0
      81 ! Calculate donor-acceptor distance
      82 !
      83     rda = distance(i, j)
      84 !
      85 ! Iterate over hydrogens
      86 !
      87
      88 !
      89 ! Distances to hydrogen
      90 !
      91     rih = distance(i, h_i)
      92     rjh = distance(j, h_i)
      93     call bangle(coord, i, h_i, j, angle)
      94     angle = M_PI - angle
      95     if (angle >= M_PI/2.d0) then
      96       continue
      97     end if
      98 !
      99 ! Here, we have filtered out everything but correct H-bonds
     100 ! Determine donor and acceptor - donor is the closer one
     101 !
     102     if (rih < rjh) then
     103       d_i = i
     104       a_i = j
     105       rdh = rih
     106       rah = rjh
     107     else
     108       d_i = j
     109       a_i = i
     110       rdh = rjh
     111       rah = rih
     112     end if
     113 !
     114 ! Radial term
     115 !
     116     e_radial = -0.00303407407407313510d0*rda**7 &
     117                 +0.07357629629627092382d0*rda**6 &
     118                 -0.70087111111082800452d0*rda**5 &
     119                 +3.25309629629461749545d0*rda**4 &
     120                 -7.20687407406838786983d0*rda**3 &
     121                 +5.31754666665572184314d0*rda**2 &
     122                 +3.40736000001102778967d0*rda  &
     123                 -4.68512000000450434811d0
     124 !
     125 !  The e_radial function has a minimum at rda = 5.5 Angstroms:
     126 !  rda  e_radial   rda    e_radial
 
