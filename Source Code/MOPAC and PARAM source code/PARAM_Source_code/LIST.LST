    1025 !     *****************************************************************
 *****
    1026
    1027       logical*1 function permca (aoi, ao, nalpha, icas, ntot, isync)
    1028
    1029 !     **** this forms all possible permutations of NALPHA electrons in
  ***
    1030 !     **** in the NTOT orbitals specified by ISNG
  ***
    1031 !     **** ISYNC is decreased one per call; 0 is terminating value
  ***
    1032       use reimers_C, only: ncore, nov
    1033
    1034       implicit none
    1035       integer :: nalpha, icas, ntot, isync
    1036       logical*1         aoi(nov), ao(nov)
    1037       dimension         icas(nov)
    1038       integer :: i, j, kk, io, jsync, ialpha
    1039
    1040 !     **** copy accross initial determinate ****
    1041       do i = 1, nov
    1042         ao(i) = aoi(i)
    1043       end do
    1044
    1045       permca = .false.
    1046
    1047 !     **** loop increasing isync looking for allowed pattern ****
    1048
    1049 100   continue
    1050
    1051       isync = isync - 1
    1052       if (isync < 0) return
    1053
    1054       ialpha = 0
    1055       jsync = isync
    1056       do i = 1, ntot
    1057         io = icas(i) - ncore
    1058         j = jsync / 2
    1059         kk = jsync - 2*j
    1060         jsync = j
    1061         ao(io) = kk.eq.0
    1062         if (ao(io)) then
    1063           ialpha = ialpha + 1
    1064           if (ialpha > nalpha) goto 100
    1065         end if
    1066       end do
    1067       if (ialpha.ne.nalpha) goto 100
    1068
    1069 !     **** it can only get here if pattern is allowed ****
    1070       permca = .true.
    1071
    1072       return
    1073       end function permca
 
