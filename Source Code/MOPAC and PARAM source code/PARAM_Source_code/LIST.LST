    2394          & 2 x, "Nact", 5 x, "Projg", 8 x, "F")
    2395           write (iw, 10010)
    2396 10020     format (i5, 2(1 x, i4), (1 x, i6), (2 x, i4), (1 x, i5), 1 p,
  2(2 x, &
    2397          & d10.3))
