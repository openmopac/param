    1038 integer function nheavy(icc)
    1039   use common_arrays_C, only : nat, nbonds, ibonds
    1040   implicit none
    1041   integer, intent (in) :: icc
    1042   integer :: i, n
    1043   n = 0
    1044   do i = 1, nbonds(icc)
    1045     if (nat(ibonds(i,icc)) > 1) n = n + 1
    1046   end do
    1047   nheavy = n
    1048   return
    1049 end function nheavy
 
