 *****
    1076
    1077       subroutine sortst (k, ener, e, ao1, bo1, aocc, bocc, nperm, nspn,
  &
    1078      &                tr, spintr, irefd, krefd, iisym, istsym, isrefd)
    1079
    1080 !     **** this keeps track of the lowest - energy NCONF determinates
  ****
    1081 !     **** a new state is inserted into the list in energy order
  ****
    1082 !     **** a new state is inserted into the list in energy order
  ****
    1083       use reimers_C, only: nconf, nci, icisym, emaxci, nov, fastci, &
    1084           nex, mspn
    1085
    1086       implicit none
    1087       double precision  e(nconf), tr(mspn), spintr(mspn, nconf), &
    1088                         ener
    1089       integer           nspn(nconf), krefd(nconf), istsym(nconf), &
    1090                         k, nperm, irefd, iisym, &
    1091                         i, j, iii, ispn, j1, jo
    1092       logical           isrefd
    1093       logical*1         aocc(nov, mspn, nex), bocc(nov, mspn, nex), &
    1094      &                  ao1(nov, mspn), bo1(nov, mspn)
    1095
    1096 !     **** first, check the energy max cuttoff criterion ****
    1097       if (ener > emaxci) then
    1098         return
    1099       end if
    1100
    1101 !     **** first check to see if max states of this symmetry exceeded *
 ***
    1102       if (.not. isrefd .and. nci(iisym).eq.icisym(iisym)) then
    1103 !       **** find locn of state ****
    1104         i = k
    1105         do while (istsym(i).ne.iisym)
    1106           i = i - 1
    1107         end do
    1108         if (ener > e(i)) then
    1109           return
    1110         end if
    1111 !       **** remove this state ****
    1112         k = k - 1
    1113         nci(iisym) = nci(iisym) - 1
    1114         do j1 = i, k
    1115           j = j1 + 1
    1116           e(j1) = e(j)
    1117           istsym(j1) = istsym(j)
    1118           nspn(j1) = nspn(j)
    1119           krefd(j1) = krefd(j)
    1120           do ispn = 1, nspn(j)
    1121             spintr(ispn, j1) = spintr(ispn, j)
    1122             do jo = 1, nov
    1123               aocc(jo, ispn, j1) = aocc(jo, ispn, j)
    1124               bocc(jo, ispn, j1) = bocc(jo, ispn, j)
    1125             end do
    1126           end do
 
 FORCHECK PC V13.5.13          SORTST          2021-03-24 10:59:30   page:  2499
 excite.F90  /FF
 
    1127         end do
    1128       end if
    1129
    1130 !     **** if full, spot check to see if its energy is too large ****
    1131       if (k.eq.nconf) then
    1132         if (abs(ener - e(k))  <  1.d-5) then
    1133 !         **** degenerate with last state, remove them both ****
    1134           nci(istsym(k)) = nci(istsym(k)) - 1
    1135           k = k - 1
    1136           return
    1137         else
    1138           if (ener > e(k)) then
    1139             return
    1140           end if
    1141         end if
    1142 !       **** insert new into filled list, pop top one off ****
    1143         nci(istsym(k)) = nci(istsym(k)) - 1
    1144         k = k - 1
    1145       end if
    1146
    1147 !     **** see where new state fits in energy order (crap code to fool
 Intel debugger) ****
    1148       i = k
    1149       iii = 1
    1150       do while (i.ge.1 .and. iii.eq.1)
    1151         if (ener < e(i)) then
    1152           i = i - 1
    1153         else
    1154           iii = 0
    1155         end if
    1156       end do
    1157       i = i + 1
    1158
    1159 ! RMG - add to avoid moving 1st config to solve triplet fastci issues
    1160       if (fastci .and. i.eq.1 .and. k.ge.1) i = i + 1
    1161
    1162 !     **** move those above it up one spot ****
    1163       do j = k, i, - 1
    1164         j1 = j + 1
    1165         e(j1) = e(j)
    1166         istsym(j1) = istsym(j)
    1167         nspn(j1) = nspn(j)
    1168         krefd(j1) = krefd(j)
    1169         do ispn = 1, nspn(j)
    1170           spintr(ispn, j1) = spintr(ispn, j)
    1171           do jo = 1, nov
    1172             aocc(jo, ispn, j1) = aocc(jo, ispn, j)
    1173             bocc(jo, ispn, j1) = bocc(jo, ispn, j)
    1174           end do
    1175         end do
    1176       end do
    1177
    1178 !     **** insert new state ****
    1179       e(i) = ener
    1180       istsym(i) = iisym
    1181       nspn(i) = nperm
    1182       krefd(i) = irefd
    1183
    1184       do ispn = 1, nperm
 
 FORCHECK PC V13.5.13          SORTST          2021-03-24 10:59:30   page:  2500
 excite.F90  /FF
 
    1185         spintr(ispn, i) = tr(ispn)
    1186         do jo = 1, nov
    1187           aocc(jo, ispn, i) = ao1(jo, ispn)
    1188           bocc(jo, ispn, i) = bo1(jo, ispn)
    1189         end do
    1190       end do
    1191
    1192       nci(iisym) = nci(iisym) + 1
    1193       k = k + 1
    1194
    1195       return
    1196       end subroutine sortst
 
