       4
       5       subroutine ovlap (s, x, y, z)
       6
       7       use reimers_C, only : n, na, natm, iat, nbt, nprn, nbeta, &
       8           zeta, zetad, zetawt, fssig, fpsig, fppi, fdsig, fdpi, &
       9           fddel, pp, bincoe, fact, d, e, fspdf, kflag, jflag
