       1 subroutine hbonds (fao, nocc, nvir, iused, nij_loc, cutoff)
       2    !*******************************************************************
 ***
       3    !
   *
       4    !   HBONDS IDENTIFIES HYDROGEN BONDS WHICH HAVE NOT BEEN CREATED IN
   *
       5    !          EARLIER STEPS
   *
       6    !
   *
       7    !*******************************************************************
 ***
       8    !
   *
       9    !  FAO:      Fock matrix over atomic orbitals
   *
      10    !  FMO:      Fock matrix over molecular orbitals
   *
      11    !  VECTOR:   Eigenvectors of M.O.s
   *
      12    !  FILLED:   Occupied M.O.s
   *
      13    !  EMPTY:    Virtual M.O.s
   *
      14    !  NOCC:     Number of occupied M.O.s
   *
      15    !  EIG:      All the eigenvalues
   *
      16    !  N:        Number of M.O.s = number of A.O.s*
   *
      17    !
   *
      18    !  On exit:  NIJ = NUMBER OF HYDROGEN BONDS WHICH NEED TO BE CREATED
   *
      19    !
   *
      20    !*******************************************************************
 ***
      21     use molkst_C, only: numat, norbs, mpack
      22     use MOZYME_C, only : nncf, ncf, nnce, nce, iorbs, icocc, icvir, &
      23     fmo, ifmo
      24     use common_arrays_C, only:  p
      25     implicit none
      26     integer, intent (out) :: nij_loc
      27     integer, intent (in) :: nocc, nvir
      28     double precision, intent (in) :: cutoff
      29     integer, dimension (norbs), intent (out) :: iused
      30     double precision, dimension (mpack), intent (in) :: fao
      31     integer :: i
      32     integer :: j, k, kk, l, ll, m
      33     double precision :: sumf, sump
      34     integer, external :: ijbo
      35     intrinsic Min
      36    !
      37    !   CHECK FOCK MATRIX AND DENSITY MATRIX TO ENSURE THAT ALL
      38    !   FOCK MATRIX ELEMENTS ARE BEING CORRECTLY HANDLED BY THE
      39    !   DIAGONALISER.
 
 FORCHECK PC V13.5.13          HBONDS          2021-03-24 10:59:30   page:  2869
 hbonds.F90  /FF
 
      40    !
      41     nij_loc = 0
      42     do i = 1, numat
      43       do j = 1, i - 1
      44         if (ijbo(i, j) >= 0) then
      45           ll = ijbo (i, j)
      46           sumf = 0.d0
      47           sump = 0.d0
      48           do k = 1, iorbs(i)
      49             do l = 1, iorbs(j)
      50               ll = ll + 1
      51               sumf = sumf + fao(ll) ** 2
      52               sump = sump + p(ll) ** 2
      53             end do
      54           end do
      55           if (sump < 1.d-10 .and. sumf > cutoff) then
      56             m = 0
      57             do k = 1, nocc
      58               !
      59               !  If the LMO only contains one atom, do NOT check the
      60               !  second atom.
      61               !
      62               kk = Min (ncf(k)-1, 1)
      63               l = nncf(k) + 1
      64               if (icocc(l) == i .or. icocc(l+kk) == i .or. icocc(l) ==
 j .or. &
      65              & icocc(l+kk) == j) then
      66                 m = m + 1
      67                 iused(m) = k
      68               end if
      69             end do
      70             do k = 1, nvir
      71               !
      72               !  If the LMO only contains one atom, do NOT check the
      73               !  second atom.
      74               !
      75               kk = Min (nce(k)-1, 1)
      76               l = nnce(k) + 1
      77               if (icvir(l) == i .or. icvir(l+kk) == i .or. icvir(l) ==
 j .or. &
      78              & icvir(l+kk) == j) then
      79                 do l = 1, m
      80                   nij_loc = nij_loc + 1
      81                   fmo(nij_loc) = 0.1d0
      82                   ifmo(2, nij_loc) = iused(l)
      83                   ifmo(1, nij_loc) = k
      84                 end do
      85               end if
      86             end do
      87           end if
      88         end if
      89       end do
      90     end do
      91 end subroutine hbonds
 
