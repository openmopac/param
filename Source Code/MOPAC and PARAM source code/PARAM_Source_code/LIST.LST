     109 subroutine reverse_trajectory(mode)
     110 !
     111 ! Read in a trajectory that was created earlier in this run, and
     112 ! write it back out, in reverse order of points.
     113 !
     114   use molkst_C, only : step_num, jloop => itemp_1, line, nl_atoms, keyw
 rd, backslash
     115   use chanel_C, only : ixyz, xyz_fn
     116   implicit none
     117   integer, intent (in) :: mode
     118   integer :: icalcn = 0, i, k, io_stat, ipdb = 14, imodel = 0, npdb, np
 t, ixyzn
     119   character :: dummy_char*1, xyz_fnn*200
     120   character, allocatable :: store_path(:,:)*200, store_hofs(:)*200
     121   save :: icalcn, ipdb, imodel, npt
     122   ixyzn = 0
     123   if (icalcn /= step_num) then
     124     do i = len_trim(xyz_fn), 1, -1
     125       if (xyz_fn(i:i) == "/" .or. xyz_fn(i:i) == backslash) exit
     126     end do
     127     if (mode == 1) then
     128       ixyzn = ixyz
     129       xyz_fnn = trim(xyz_fn)
     130     else
     131       ixyzn = ixyz + 1
     132       xyz_fnn = xyz_fn(:len_trim(xyz_fn) - 4)//" for dipole.xyz"
     133     end if
     134     open(unit=ixyzn, file=xyz_fnn)
     135     if (index(keywrd, " PDBOUT") /= 0) &
     136       open(unit = ipdb, file = xyz_fnn(:len_trim(xyz_fnn) - 3)//"pdb")
     137     if (mode == 1) icalcn = step_num
     138   end if
     139
     140   close (ixyzn)
     141   open(ixyzn, file = xyz_fnn)
     142   rewind(ixyzn)
     143   allocate (store_path(nl_atoms, jloop), store_hofs(jloop))
     144 !
     145 !  Read in the path already generated
     146 !
     147   do i = 1, 100000
     148     read(ixyzn,*, iostat=io_stat)dummy_char
     149     if (dummy_char =="0" .and. i < 0) return  ! dummy use of dummy_char
     150     read(ixyzn,'(a)', iostat=io_stat)line
     151     if (io_stat /= 0) exit
     152     store_hofs(i) = trim(line)
     153     read(ixyzn,"(a)", iostat=io_stat) &
     154       (store_path(k,i), k = 1, nl_atoms)
     155   end do
     156   close (ixyzn)
     157   open(ixyzn, file = xyz_fnn)
     158   rewind(ixyzn)
     159 !
     160 ! Write out the path already generated, in reverse
     161 !
     162   jloop = i - 1
     163   npt = 0
     164   do i = jloop, 2, -1  ! Exclude the first point - it's common to both
 
 FORCHECK PC V13.5.13    REVERSE_TRAJECTORY    2021-03-24 10:59:30   page:  3396
 write_trajectory.F90  /FF
 
 paths
     165     write(ixyzn,"(i6,a)") nl_atoms," "
     166     k = index(store_hofs(i), "HEAT") + index(line, "DIPO")
     167     npt = npt + 1
     168     write(ixyzn,'(a,i4,1x,a)')store_hofs(i)(:8), npt,trim(store_hofs(i)
 (k:))
     169     do k = 1, nl_atoms
     170       write(ixyzn,"(a)") trim(store_path(k,i))
     171     end do
     172   end do
     173 !
     174 !  Do the same with the PDB file
     175 !
     176   if (index(keywrd, " PDBOUT") /= 0) then
     177     deallocate (store_path)
     178     open(unit = ipdb, file = xyz_fnn(:len_trim(xyz_fnn) - 3)//"pdb")
     179     rewind (ipdb)
     180 !
     181 ! How many lines are there in each PDB file?
     182 !
     183     do npdb = 0, 10000
     184       read(ipdb,'(a)') line
     185       if (line(:6) == "ENDMDL") exit
     186     end do
     187     allocate (store_path(npdb, jloop))
     188     rewind (ipdb)
     189     do i = 1, 100000
     190       read(ipdb,*, iostat=io_stat)dummy_char
     191       if (dummy_char =="0" .and. i < 0) return  ! dummy use of dummy_ch
 ar
     192       read(ipdb,"(a)", iostat=io_stat) &
     193         (store_path(k,i), k = 1, npdb)
     194       if (io_stat /= 0) exit
     195     end do
     196     close (ipdb)
     197     open(unit = ipdb, file = xyz_fnn(:len_trim(xyz_fnn) - 3)//"pdb")
     198     rewind(ipdb)
     199 !
     200 ! Write out the path already generated, in reverse
     201 !
     202     imodel = 0
     203     jloop = i - 1
     204     do i = jloop, 2, -1! Exclude the first point - it's common to both
 paths
     205       imodel = imodel + 1
     206       write(ipdb,"(a,i6)") "MODEL ", imodel
     207       do k = 1, npdb
     208         write(ipdb,"(a)") trim(store_path(k,i))
     209       end do
     210     end do
     211   end if
     212   deallocate (store_path)
     213 end subroutine reverse_trajectory
 
