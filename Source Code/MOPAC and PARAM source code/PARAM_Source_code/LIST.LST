     840           call staticsolv(ao, bo, ediel)
     841         end if
     842         h(idet, idet) = e1 + ecore + ediel
     843       end do
     844
     845 !     ***** determine interaction energies between all dets in class **
 **
     846
     847       do idet = 2, nperm
     848         do jdet = 1, idet - 1
     849           h(idet, jdet) = ciener (ao1(1, idet), bo1(1, idet), &
     850      &      ao1(1, jdet), bo1(1, jdet), c, gamma, nbtmo, beta)
     851           h(jdet, idet) = h(idet, jdet)
     852         end do
     853       end do
