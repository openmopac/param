     124             arot(irot(1,i1),irot(2,i1)) = c(irot(3,i1),irot(4,i1),irot(
 5,i1))
     125           end do
     126           l1 = isp(ii)
     127           l2 = isp(jj)
     128           vect = -1.D0
     129           j1 = 10
     130           j1 = 1
     131           if (l2 > 0) then
     132             vect(:l1,:l2) = 0.D0
     133             j1 = l2 + 1
     134           end if
     135           if (i /= j) then
     136             ij = max(ii,jj)
     137             do i1 = 1, ii
     138               do j1 = 1, jj
     139                 sum = 0.D0
     140                 do l1 = 1, ij
     141                   do l2 = 1, ij
     142                     sum = sum + arot(l1,i1)*pab(l1,l2)*arot(l2,j1)
     143                   end do
     144                 end do
     145                 vect(isp(i1),isp(j1)) = vect(isp(i1),isp(j1)) + sum**2
     146               end do
     147             end do
     148           end if
     149           k = 0
     150           do i1 = if, il
     151             k = k + 1
     152             l = 0
     153             do j1 = jf, jl
     154               l = l + 1
     155               if (j1 > i1) cycle
     156               b(j1+(i1*(i1-1))/2) = vect(k,l)
 
 FORCHECK PC V13.5.13          DENROT          2021-03-24 10:59:30   page:  1687
 denrot.F90  /FF
 
     157             end do
     158           end do
     159         end do
     160       end do
     161 !
     162 ! NOW TO REMOVE ALL THE DEAD SPACE IN P, CHARACTERIZED BY -1.0
     163 !
     164       l = 0
     165       do i = 1, mpack
     166         if (b(i) <= (-0.1D0)) cycle
     167         l = l + 1
     168         b(l) = b(i)
     169       end do
     170 !
     171 !   PUT ATOMIC ORBITAL VALENCIES ONTO THE DIAGONAL
     172 !
     173       do i = 1, iprt
     174         sum = 0.D0
     175         ii = (i*(i - 1))/2
     176         do j = 1, i
     177           sum = sum + b(j+ii)
     178         end do
     179         do j = i + 1, iprt
     180           sum = sum + b((j*(j-1))/2+i)
