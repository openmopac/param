     201   subroutine vint(xint, yint, zint, ni, nj, x0, y0, z0, xi, yi, zi, xj,
  yj, zj, t)
     202 !
     203 !  Gauss-Hermite Quadrature
     204 !
     205     double precision, intent (in) :: x0, y0, z0, xi, yi, zi, xj, yj, zj
 , t
     206     double precision, intent (out) :: xint, yint, zint
     207     integer, intent (in) :: ni, nj
     208 !
     209 !  Local variables
     210 !
     211     double precision :: dum, ptx, pty, ptz, ax, ay, az, bx, by, bz, px,
  py, pz
     212     integer ::  i, j, min, max, npt
     213     double precision :: Hermite_roots(21) = (/ &
     214                    0.0d0,
         & ! 1
     215                   -0.7071067811865d0,  0.7071067811865d0,
         & ! 2
     216                   -1.224744871391d0,   0.0d0,              1.2247448713
 915d0,  & ! 3
     217                   -1.6506801238857d0, -0.52464762327529d0, 0.5246476232
 7529d0, & ! 4
     218                      1.6506801238857d0,
         &
     219                   -2.020182870456d0,  -0.9585724646138d0,  0.0d0,
         & ! 5
     220                         0.9585724646138d0,  2.020182870456d0,
         &
     221                   -2.350604973674d0,  -1.335849074014d0,  -0.4360774119
 28d0,   & ! 6
     222                         0.436077411928d0,   1.335849074014d0,   2.35060
 4973674d0 /)
     223
     224     double precision ::   Hermite_weights(21)  = (/ &
     225             1.772453850905d0,
         & ! 1
     226             0.886226925452d0,     0.886226925452d0,
         & ! 2
     227             0.295408975150d0,     1.18163590060d0,      0.295408975150d
 0,      & ! 3
     228             8.131283544725d-02, 0.8049140900055d0,    8.049140900055d-0
 1,      & ! 4
     229               8.131283544725d-02,
         &
     230             1.995324205905d-02, 3.936193231522d-01, 9.453087204829d-01,
         & ! 5
     231               3.936193231522d-01, 1.995324205905d-02,
         &
     232             4.530009905509d-03, 1.570673203229d-01, 7.246295952244d-01,
         & ! 6
     233             7.246295952244d-01, 1.570673203229d-01, 4.530009905509d-03
 /)
     234     integer :: start_index(6) = (/ 0, 1, 3, 6, 10, 15/), &
     235                  end_index(6) = (/ 0, 2, 5, 9, 14, 20/)
     236
     237
 
 FORCHECK PC V13.5.13           VINT           2021-03-24 10:59:30   page:  1908
 esp_utilities.F90  /FF
 
     238     xint = 0.0d0
     239     yint = 0.0d0
     240     zint = 0.0d0
     241
     242     npt  = (ni + nj)/2 + 1      ! form the index into the start_index a
 rray
     243     min  = start_index(npt) + 1 ! get the starting index in the roots,w
 eights arrays.
     244     max  = end_index(npt) + 1   ! get the ending index in the roots,wei
 ghts arrays.
     245
     246     do i = min, max
     247       px   = 1.0d0
     248       py   = 1.0d0
     249       pz   = 1.0d0
     250       dum  = Hermite_roots(i) * t
     251       ptx  = dum + x0
     252       pty  = dum + y0
     253       ptz  = dum + z0
     254       ax   = ptx - xi
     255       ay   = pty - yi
     256       az   = ptz - zi
     257       bx   = ptx - xj
     258       by   = pty - yj
     259       bz   = ptz - zj
     260
     261       do j = 2, ni
     262         px = px*ax
     263         py = py*ay
     264         pz = pz*az
     265       end do
     266
     267       do j = 2, nj
     268         px = px*bx
     269         py = py*by
     270         pz = pz*bz
     271       end do
     272       dum    = Hermite_weights(i)
     273       xint = xint + dum * px
     274       yint = yint + dum * py
     275       zint = zint + dum * pz
     276     end do
     277   end subroutine vint
 
