     810 logical function arom2 (ii, jj, mpii)
     811     use common_arrays_C, only : nbonds, ibonds
     812     use molkst_C, only : numat
     813     implicit none
     814     integer, intent (in) :: ii, jj
     815     integer, dimension (numat), intent (in) :: mpii
     816     integer :: i, i1, iia, iib, iic, j, j1, jja, jjb, jjc, ni, nia, nib
 , nj, &
     817    & nja, njb
     818 !**********************************************************************
 *
     819 !
     820 !  AROM2 determines if the PI bond between II and JJ is part of an
     821 !        aromatic ring.  It does this by detecting a second PI bond
     822 !        in the ring, and then identifying the final PI bond.
     823 !        The atom numbers of the final PI bond are put into II and JJ
     824 !
     825 !**********************************************************************
 *
     826     ni = nbonds(ii)
     827     nj = nbonds(jj)
     828 !
     829 !  Was II attached to a PI bonded system?
     830 !
     831     do i = 1, ni
     832       iia = ibonds(i, ii)
     833       if (iia /= jj) then
     834         nia = nbonds(iia)
     835         if (mpii(iia) /= 0) then
     836           iib = mpii(iia)
     837 !
     838 !   IIA is attached to to II
     839 !   IIB is pi bonded to IIA
     840 !
     841           nib = nbonds(iib)
     842           do j = 1, nj
     843             jja = ibonds(j, jj)
     844             if (jja /= ii) then
     845               nja = nbonds(jja)
     846 !
     847 !   JJA is attached to JJ
     848 !
     849               do i1 = 1, nib
     850                 iic = ibonds(i1, iib)
     851                 do j1 = 1, nja
     852 !
     853 !   Is any atom attached to IIB also attached to JJA?
     854 !
     855                   if (iic == ibonds(j1, jja)) then
     856                     arom2 = .true.
     857                     return
     858                   end if
     859                 end do
     860               end do
     861             end if
     862           end do
     863         end if
     864       end if
 
 FORCHECK PC V13.5.13          AROM2           2021-03-24 10:59:30   page:  3348
 chklew.F90  /FF
 
     865     end do
     866 !
     867 !  Was JJ attached to a PI bonded system?
     868 !
     869     do j = 1, nj
     870       jja = ibonds(j, jj)
     871       if (jja /= ii) then
     872         nja = nbonds(jja)
     873         if (mpii(jja) /= 0) then
     874           jjb = mpii(jja)
     875 !
     876 !   JJA is attached to to JJ
     877 !   JJB is pi bonded to JJA
     878 !
     879           njb = nbonds(jjb)
     880           do i = 1, ni
     881             iia = ibonds(i, ii)
     882             if (iia /= jj) then
     883               nia = nbonds(iia)
     884 !
     885 !  IIA is attached to II
     886 !
     887               do j1 = 1, njb
     888                 jjc = ibonds(j1, jjb)
     889                 do i1 = 1, nia
     890 !
     891 !   Is any atom attached to JJB also attached to IIA?
     892 !
     893                   if (jjc == ibonds(i1, iia)) then
     894                     arom2 = .true.
     895                     return
     896                   end if
     897                 end do
     898               end do
     899             end if
     900           end do
     901         end if
     902       end if
     903     end do
     904     arom2 = .false.
     905 end function arom2
 
