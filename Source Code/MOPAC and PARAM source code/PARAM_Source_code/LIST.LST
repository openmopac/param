       1       subroutine getval(line, x, t)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5 !-----------------------------------------------
       6 !   I n t e r f a c e   B l o c k s
       7 !-----------------------------------------------
       8       implicit none
       9 !-----------------------------------------------
      10 !   D u m m y   A r g u m e n t s
      11 !-----------------------------------------------
      12       double precision , intent(out) :: x
      13       character  :: line*80
      14       character , intent(out) :: t*12
      15 !-----------------------------------------------
      16 !   L o c a l   V a r i a b l e s
      17 !-----------------------------------------------
      18       integer :: i
      19       character :: ch1, ch2
      20       double precision, external :: reada
      21 !-----------------------------------------------
      22       ch1 = line(1:1)
      23       ch2 = line(2:2)
      24       if ((ichar(ch1)<ichar('A') .or. ichar(ch1)>ichar('Z')) .and. (ich
 ar(ch2)<&
      25         ichar('A') .or. ichar(ch2)>ichar('Z'))) then
      26 !
      27 !   IS A NUMBER
      28 !
      29         x = reada(line,1)
      30         t = ' '
      31       else
      32         i = index(line,' ')
      33         t = line(:i)
      34         x = -999.D0
      35       end if
      36       return
      37       end subroutine getval
 
