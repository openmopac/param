     323               if (r < rmin) then
     324                 rmin = r
     325                 k = ibonds(j,i)
     326               end if
     327             end do
     328           end if
     329 !
     330 ! Write out error message
     331 !
     332           if (m == 2 .and. prt) then
 
 FORCHECK PC V13.5.13         CHECK_H          2021-03-24 10:59:30   page:  3767
