    2335   logical function aromatic_5(atom_1, atom_2, atom_5, hybrid)
    2336 !
    2337 !  Given three adjacent atoms, atom_2 - atom_1 - atom_5, determine if t
 hey belong
    2338 !  to an five-membered aromatic ring.  If so, "aromatic_5" return .true
 .
    2339 !
    2340     use common_arrays_C,  only : coord,  nbonds,  ibonds
    2341     use molkst_C, only : numat
    2342     use funcon_C,  only : pi
    2343     implicit none
    2344     integer, intent (in) :: atom_1, atom_2, atom_5, hybrid(numat)
    2345     integer :: atom_3, i, j, k, nii, njj, kka, atom_4, l
    2346     double precision :: bent = 0.4d0, sum
    2347       if (numat < 5) then
    2348         aromatic_5 = .false.
    2349         return
    2350       end if
    2351       nii = nbonds(atom_2)
    2352       njj = nbonds(atom_5)
    2353       do i = 1, nii
    2354         atom_3 = ibonds(i,atom_2)
    2355         if (atom_3 == atom_1) cycle
    2356         do j = 1, njj
    2357           atom_4 = ibonds(j,atom_5)
    2358           if (atom_4 == atom_1) cycle
    2359           do k = 1, nbonds(atom_4)
    2360             kka = ibonds(k,atom_4)
    2361             if (kka == atom_3) then
    2362               l = max(hybrid(2), hybrid(3), hybrid(4), hybrid(5))
    2363               if (l == 3) cycle  ! if any atom in the ring is sp3, the
 ring cannot be aromatic
    2364 !
    2365 !  five-membered ring, with atoms numbered atom_1, atom_2, atom_3 = kka
 , atom_4, atom_5
    2366 !
    2367               call dihed(coord, atom_1, atom_2, atom_3, atom_4, sum)
    2368               if (min(2*pi - sum, sum) < bent) then
    2369                 call dihed(coord, atom_2, atom_3, atom_4, atom_5, sum)
    2370                 if (min(2*pi - sum, sum) < bent) then
    2371                   call dihed(coord, atom_3, atom_4, atom_5, atom_1, sum
 )
    2372                   if (min(2*pi - sum, sum) < bent) then
    2373                     call dihed(coord, atom_4, atom_5, atom_1, atom_2, s
 um)
    2374                     if (min(2*pi - sum, sum) < bent) then
    2375                       call dihed(coord, atom_5, atom_1, atom_2, atom_3,
  sum)
    2376                       if (min(2*pi - sum, sum) < bent) then
    2377 !
    2378 ! Flat five-membered ring
    2379 !
    2380                         aromatic_5 = .true.
    2381                         return
    2382                       end if
    2383                     end if
    2384                   end if
    2385                 end if
 
 FORCHECK PC V13.5.13        AROMATIC_5        2021-03-24 10:59:30   page:   778
 add_hydrogen_atoms.F90  /FF
 
    2386               end if
    2387             end if
    2388           end do
    2389         end do
    2390       end do
    2391       aromatic_5 = .false.
    2392       return
    2393   end function aromatic_5
 
