       1       subroutine inttr (i, j, a, b, c, gamma, nbtmo, j12, k12, ifstor)
       2
       3 !     **** generates J and K integrals in MO basis for CI routines   **
 **
       4 !     **** by index transformation on the AO - basis integrals       **
 **
       5 !     **** is set up for notation (ij||ab) = <ia||jb> of Georges notes*
 ***
       6
       7 !     **** J = [ij|ab] = <phi_i(1) phi_j(1) | 1/r | phi_a(2) phi_b(2)>
 ****
       8 !     **** K = [ia|jb] = <phi_i(1) phi_a(1) | 1/r | phi_j(2) phi_b(2)>
 ****
       9
      10 !     **** integrals in the AO basis set are:
     ****
      11 !     **** (mu, mu|nu, nu) = gamma(mu, nu) = CNDO Coulomb integrals
             ****
      12 !     **** (mu, nu|mu, nu) = gamma(nu, mu) = INDO one - centre Exchange
  integrals ****
      13 !     **** (mu, nu|nu, mu) = gamma(nu, mu) = INDO one - centre Exchange
  integrals ****
      14 !     **** (ig1, ig2|ig3, ig4) INDO trans metal irregular integrals
     ****
      15
      16 !     **** nb, in an alternate notation used in Georges notes, we have
 *
      17 !     **** J = <ib|ja> = <phi_i(1) phi_b(2) | 1/r | phi_j(1) phi_a(2)>
 ****
      18 !     **** K = <ib|aj> = <phi_i(1) phi_b(2) | 1/r | phi_a(1) phi_j(2)>
 ****
      19 !     **** ie, <ib||ja> = (ij||ab), and parameter definition reverses *
 ***
      20
      21 !     **** J = <ij|ab> = <phi_i(1) phi_j(2) | 1/r | phi_a(1) phi_b(2)>
 ****
      22 !     **** K = <ij|ba> = <phi_i(1) phi_j(2) | 1/r | phi_b(1) phi_a(2)>
 ****
      23 !     **** ie, <ia||jb> = (ia||jb), and parameter definition reverses *
 ***
      24       use reimers_C, only : n, matind, nham, ibf, iat, nslwr, nsupr, &
      25           istr, nsym, ixprd, ig1, ig2, ig3, ig4, g, ntrmet, itrmet, &
      26           nirreg, natt, ncore, edef, ee2, wk1, wk2, isc
      27 !      USE chanel_C, only : iw
      28
      29       implicit none
      30       double precision ::  c(n, n), gamma(n, n), aa, gk
      31       integer ::           nbtmo(n), a, b, i, j, k, &
      32                         ifstor, imu, imu0, ir, irreg, &
      33                         k1, k2, k3, k4, ka, kt, mu, mu1, &
      34                         nm1, nm2, nmc, nme, nu, nu1, nu1l
