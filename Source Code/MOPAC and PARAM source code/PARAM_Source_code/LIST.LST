     350   double precision function poly(r, l_grad, dpoly)
     351     implicit none
     352     double precision :: r, dpoly
     353     logical :: l_grad
     354 !
     355 !  poly is the hydrogen-hydrogen correction for two atoms separated by
 "r" Angstroms
     356 !  dpoly is the gradient of the internal coordinate
     357 !
     358     if (r <= 1.d0) then
     359       poly = 25.46293603147693d0
     360       dpoly = 0.d0
     361     else if ( r > 1.d0 .and. r < 1.5d0) then
     362       poly =  -2714.952351603469651d0 * r**5 &
     363              +17103.650110591705015d0 * r**4 &
     364              -42511.857982217959943d0 * r**3 &
     365              +52063.196799138342612d0 * r**2 &
     366              -31430.658335972289933d0 * r    &
     367               +7516.084696095140316d0
     368       if (l_grad) &
     369         dpoly = -2714.952351603469651d0*5.d0 * r**4 &
     370                +17103.650110591705015d0*4.d0 * r**3 &
     371                -42511.857982217959943d0*3.d0 * r**2 &
     372                +52063.196799138342612d0*2.d0 * r    &
     373                -31430.658335972289933d0
     374     else
     375       poly = 118.7326d0*exp(-1.53965d0*(r**1.72905d0))
     376       if (l_grad) &
     377       dpoly = -1.53965d0*1.72905d0*r**0.72905d0*118.7326d0*exp(-1.53965
 d0*(r**1.72905d0))
     378     end if
     379     return
     380   end function poly
 
