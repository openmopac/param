     143       subroutine unsolv(cimat, cist, diagsl, ucener)
     144       use reimers_C, only : nconf, matind
     145       implicit none
     146       double precision :: cimat(nconf*(nconf + 1)/2), cist(nconf, nconf
 ), &
     147                       diagsl(nconf), ucener(nconf)
     148       integer :: iconf, ist, nm, jconf
     149       double precision :: ener, etmp
     150 !**********************************************************************
 *
     151 !   RMG - Compute the energies of the CI states without the diagonal
     152 !   energy corrections. Un - correct the CI matrix, then multiply with
 the
     153 !   earlier eigenvectors to get the new 'eigenvalues'.
     154 !**********************************************************************
 *
     155 ! Uncorrect the CI matrix
     156       do iconf = 1, nconf
     157         nm = matind(iconf) + iconf
     158         cimat(nm) = cimat(nm) - diagsl(iconf)
     159       end do
     160 !
     161 ! Compute expectation values for the energies of the old eigenvectors
     162 ! with the new CI matrix to get uncorrected energies
     163       do ist = 1, nconf
     164         ener = 0.d0
     165         do iconf = 1, nconf
     166           etmp = 0.d0
     167           do jconf = 1, nconf
     168             nm = matind(max(iconf, jconf)) + min(iconf, jconf)
     169             etmp = etmp + cimat(nm)*cist(jconf, ist)
     170           end do
     171           ener = ener + cist(iconf, ist)*etmp
     172         end do
     173         ucener(ist) = ener
     174       end do
     175
     176       return
     177       end subroutine unsolv
 
