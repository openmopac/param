       1       subroutine dhcore(coord, h, ww, enuclr, nati, natx, step)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use molkst_C, only : norbs, numat, n2elec
       6       use common_arrays_C, only : nat, nfirst, nlast
       7 !**********************************************************************
 *
       8 !-----------------------------------------------
       9 !   I n t e r f a c e   B l o c k s
      10 !-----------------------------------------------
      11       implicit none
      12 !-----------------------------------------------
      13 !   D u m m y   A r g u m e n t s
      14 !-----------------------------------------------
      15       integer , intent(in) :: nati
      16       integer , intent(in) :: natx
      17       double precision , intent(out) :: enuclr
      18       double precision , intent(in) :: step
      19       double precision  :: coord(3,numat)
      20       double precision , intent(inout) :: h(*)
      21       double precision , intent(out) :: ww(n2elec)
      22 !-----------------------------------------------
      23 !   L o c a l   P a r a m e t e r s
      24 !-----------------------------------------------
      25 !-----------------------------------------------
      26 !   L o c a l   V a r i a b l e s
      27 !-----------------------------------------------
      28       integer :: i, kr, ia, ib, ni, j, ja, jb, nj, i2, i1, ij, &
      29         kro, ii, k
      30       double precision, dimension(45) :: e1b, de1b, e2a, de2a
      31       double precision, dimension(9,9) :: di, ddi
      32       double precision, dimension(2026) :: wjd = 0.d0, dwjd = 0.d0
      33       double precision :: csave, enuc, denuc
      34 !-----------------------------------------------
      35 !
      36 !  DHCORE GENERATES THE 1-ELECTRON  AND 2-ELECTRON INTEGRALS DERIVATIVE
 S
      37 !         WITH RESPECT TO THE CARTESIAN COORDINATE COORD (NATX,NATI).
      38 !
      39 !  INPUT
      40 !      COORD     : CARTESIAN  COORDINATES OF THE MOLECULE.
      41 !      NATI,NATX : INDICES OF THE MOVING COORDINATE.
      42 !      STEP      : STEP SIZE OF THE 2-POINTS FINITE DIFFERENCE.
      43 !  OUTPUT
      44 !      H         : 1-ELECTRON INTEGRALS DERIVATIVES (PACKED CANONICAL).
      45 !      W         : 2-ELECTRON INTEGRALS DERIVATIVES (ORDERED AS REQUIRE
 D
      46 !                             IN DFOCK2 AND DIJKL1).
      47 !      ENUCLR    : NUCLEAR ENERGY DERIVATIVE.
      48 !
      49 !-----------------------------------------------
      50       h(:norbs*(norbs+1)/2) = 0
      51       enuclr = 0.D0
      52       kr = 1
      53       i = nati
      54       csave = coord(natx,nati)
      55       ia = nfirst(nati)
 
 FORCHECK PC V13.5.13          DHCORE          2021-03-24 10:59:30   page:   624
 dhcore.F90  /FF
 
      56       ib = nlast(nati)
      57       ni = nat(nati)
      58       do j = 1, numat
      59         if (j == nati) cycle
      60         ja = nfirst(j)
      61         jb = nlast(j)
      62         nj = nat(j)
      63         coord(natx,nati) = csave + step
      64         call h1elec (ni, nj, coord(1,nati), coord(1,j), di)
      65         coord(natx,nati) = csave - step
      66         call h1elec (ni, nj, coord(1,nati), coord(1,j), ddi)
      67 !
      68 !     FILL THE ATOM-OTHER ATOM ONE-ELECTRON MATRIX.
      69 !
      70         i2 = 0
      71         if (ia > ja) then
      72           do i1 = ia, ib
      73             ij = (i1*(i1 - 1))/2 + ja - 1
      74             i2 = i2 + 1
      75             h(ij+1:jb-ja+1+ij) = h(ij+1:jb-ja+1+ij) + (di(i2,:jb-ja+1)-
 ddi(i2,:&
      76               jb-ja+1))
      77           end do
      78         else
      79           do i1 = ja, jb
      80             ij = (i1*(i1 - 1))/2 + ia - 1
      81             i2 = i2 + 1
      82             h(ij+1:ib-ia+1+ij) = h(ij+1:ib-ia+1+ij) + (di(:ib-ia+1,i2)-
 ddi(:ib-&
      83               ia+1,i2))
      84           end do
      85         end if
      86 !
      87 !     CALCULATE THE TWO-ELECTRON INTEGRALS, W; THE ELECTRON NUCLEAR TER
 M
      88 !     E1B AND E2A; AND THE NUCLEAR-NUCLEAR TERM ENUC.
      89 !
      90         kro = kr
      91         coord(natx,nati) = csave + step
      92 !
      93 !     Two-electron one and two center terms.
      94 !
      95         call rotate (ni, nj, coord(1,nati), coord(1,j), wjd, kr, e1b, e
 2a, enuc)
      96         kr = kro
      97         coord(natx,nati) = csave - step
      98         call rotate (ni, nj, coord(1,nati), coord(1,j), dwjd, kr, de1b,
  de2a, denuc)
      99         k = kr - kro
     100         if ( kr > 0) then
     101           wjd(:k + 1) = wjd(:k + 1) - dwjd(:k + 1)
     102           do i = 0, k - 1
     103             ww(i + kro) = wjd(i + 1)
     104           end do
     105         end if
     106         coord(natx,nati) = csave
     107         enuclr = enuclr + enuc - denuc
     108 !
     109 !   ADD ON THE ELECTRON-NUCLEAR ATTRACTION TERM FOR ATOM I.
 
 FORCHECK PC V13.5.13          DHCORE          2021-03-24 10:59:30   page:   625
 dhcore.F90  /FF
 
     110 !
     111         i2 = 0
     112         do i1 = ia, ib
     113           ii = (i1*(i1 - 1))/2 + ia - 1
     114           if (i1 - ia + 1 > 0) then
     115             h(ii+1:i1-ia+1+ii) = h(ii+1:i1-ia+1+ii) + e1b(i2+1:i1-ia+1+
 i2) - &
     116               de1b(i2+1:i1-ia+1+i2)
     117             i2 = i1 - ia + 1 + i2
     118           end if
     119         end do
     120 !
     121 !   ADD ON THE ELECTRON-NUCLEAR ATTRACTION TERM FOR ATOM J.
     122 !
     123         i2 = 0
     124         do i1 = ja, jb
     125           ii = (i1*(i1 - 1))/2 + ja - 1
     126           if (i1 - ja + 1 > 0) then
     127             h(ii+1:i1-ja+1+ii) = h(ii+1:i1-ja+1+ii) + e2a(i2+1:i1-ja+1+
 i2) - &
     128               de2a(i2+1:i1-ja+1+i2)
     129             i2 = i1 - ja + 1 + i2
     130           end if
     131         end do
     132       end do
     133       return
     134       end subroutine dhcore
 
