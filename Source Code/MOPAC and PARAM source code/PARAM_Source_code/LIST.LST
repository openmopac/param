       1       subroutine getocc(aoc, boc, ao1, bo1, io, iv, nio)
       2       use reimers_C, only : nov, ncore
       3       implicit none
       4       logical*1 ::     aoc(nov), boc(nov), &
       5                       ao1(nov), bo1(nov)
       6       integer ::       io(4), iv(4), nio
       7       integer ::      i, j, niv
       8
       9 !**********************************************************************
 *
      10 !   RMG - get the occupied/virtual orbitals involved in a configuration
      11 !   aoc, boc = occupations of excited configuration
      12 !   ao1, bo1 = occupations of ground configuration
      13 !   io, iv = lists of occupied/virtural orbitals
      14 !   nio     = number of excitations in the configuration
      15 !**********************************************************************
 *
      16       do i = 1, 4
      17         io(i) = 0
      18         iv(i) = 0
      19       end do
      20
      21       nio = 0
      22       niv = 0
      23
      24 !      write (6, *) aoc, boc
      25 !      write (6, *) ao1, bo1
      26
      27 !     **** loop over orbitals, check diffs from first ref det ****
      28       do j = 1, nov
      29         if (ao1(j) .neqv. aoc(j)) then
      30 !         **** alpha differs from first ref det ****
      31           if (ao1(j)) then
      32             nio = nio + 1
      33             io(nio) = j + ncore
      34           else
      35             niv = niv + 1
      36             iv(niv) = j + ncore
      37           end if
      38         end if
      39
      40         if (bo1(j) .neqv. boc(j)) then
      41 !         **** beta differs from first ref det ****
      42           if (bo1(j)) then
      43             nio = nio + 1
      44             io(nio) = j + ncore
      45           else
      46             niv = niv + 1
      47             iv(niv) = j + ncore
      48           end if
      49         end if
      50       end do
      51       if (nio /= niv) write (6, *) 'Error: Different number of occ ', &
      52          'and vir orbitals found', nio, niv, io, iv
      53       return
      54       end subroutine getocc
 
