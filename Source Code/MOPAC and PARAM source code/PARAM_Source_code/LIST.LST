     793  1006 format (4x, a7, 2x, i5, 1x, f12.8, f12.8)
     794  1007 format (a24, 7x, f12.8)
     795  1150 format (/' Depression of ground-state after CI=', &
     796      &         f12.0, ' cm**-1', ' Energy=', f14.7, ' eV' /&
     797      &         ' Dipole moment=', 3f10.6, ' tot=', f10.6, ' Debyes'/)
     798  1170 format (i4, i2, 1x, a3, f8.1, f10.6, f8.3)
     799       nr = 1
     800       nciouv = nciout
     801       nese = 1
     802       ndtype = 1
     803       if(.not. allocated(occ)) allocate(occ(nov))
     804
     805 !     **** determine CI state symmetry ****
     806       if(.not.allocated(istate)) allocate(istate(nconf))
     807       do il = 1, nconf
     808         j = 1
     809         do while (abs(ci(il, j)) < 1.d-2)
     810           j = j + 1
     811         end do
     812         nsy = istsym(j)
     813         istate(il) = nsy
     814       end do
     815
     816 !     **** determine MO occupancy CI states ****
     817       do j = 1, nconf
     818 !       **** determine nber of electrons in MO i in all configs j ****
     819         do i = 1, nov
