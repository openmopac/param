      47       double precision :: q2(numat), degree, xreact, eionis, vol, tim,
 xi, sum, &
      48       dip, dumy(3), pKa_unsorted(numat), distortion, rms, gnorm_norm, e
 scf_min
      49       logical :: ci, lprtgra, still, bcc, opend, bigcycles
      50       character  :: type(3)*11, idate*24, gtype*13, grtype*14, &
      51       flepo(18)*58, iter(2)*58, namfil*241, num*2
      52       character, allocatable :: old_arc_file(:)*1000
      53       double precision, external :: dipole, dipole_for_MOZYME, dot, mec
 i, seconds, volume
      54       integer, external :: ijbo
      55       save type, flepo, iter, namfil, icalcn, i, bigcycles, escf_min
      56 !**********************************************************************
 *
      57 !
      58 !   WRITMO PRINTS OUT MOST OF THE RESULTS.
      59 !         IT SHOULD NOT ALTER ANY PARAMETERS, SO THAT IT CAN BE CALLED
      60 !         AT ANY CONVENIENT TIME.
      61 !
      62 !**********************************************************************
 *
      63       data icalcn/ 0/
      64       data flepo(1), flepo(2), flepo(3)/ &
      65         ' 1SCF WAS SPECIFIED, SO BFGS WAS NOT USED                 ', &
      66         ' GRADIENTS WERE INITIALLY ACCEPTABLY SMALL                ', &
      67         ' HERBERTS TEST WAS SATISFIED IN BFGS                      '/
      68       data flepo(4), flepo(5), flepo(6)/ &
      69         ' THE LINE MINIMIZATION FAILED TWICE IN A ROW.   TAKE CARE!', &
      70         ' BFGS FAILED DUE TO COUNTS EXCEEDED. TAKE CARE!           ', &
      71         ' PETERS TEST WAS SATISFIED IN BFGS OPTIMIZATION           '/
      72       data flepo(7), flepo(8), flepo(9)/ &
      73         ' THIS MESSAGE SHOULD NEVER APPEAR, THERE IS A BUG IN MOPAC', &
      74         ' GRADIENT TEST NOT PASSED, BUT FURTHER WORK NOT JUSTIFIED ', &
      75         ' A FAILURE HAS OCCURRED, TREAT RESULTS WITH CAUTION!!     '/
      76       data flepo(10), flepo(11), flepo(12)/ &
      77         ' GEOMETRY OPTIMIZED USING NLLSQ. GRADIENT NORM MINIMIZED  ', &
      78         ' GEOMETRY OPTIMIZED USING POWSQ. GRADIENT NORM MINIMIZED  ', &
      79         ' CYCLES EXCEEDED, GRADIENT NOT FULLY MINIMIZED IN NLLSQ   '/
      80       data flepo(13), flepo(14), flepo(15)/ &
      81         ' 1SCF RUN AFTER RESTART.  GEOMETRY MIGHT NOT BE OPTIMIZED ', &
      82         ' HEAT OF FORMATION MINIMIZED IN ONE LINE SEARCH           ', &
      83         ' GEOMETRY OPTIMISED USING EIGENVECTOR FOLLOWING (EF).     '/
      84       data flepo(16), flepo(17), flepo(18)/ &
      85         ' NO PARAMETERS MARKED FOR OPTIMIZATION, SO 1SCF WAS USED  ', &
      86         ' GEOMETRY OPTIMISED USING EIGENVECTOR FOLLOWING (TS).     ', &
      87         ' TRANSITION STATE LOCATED USING THE "SADDLE" TECHNIQUE    '/
      88       data iter/ ' SCF FIELD WAS ACHIEVED
      ', &
      89         '  ++++----**** FAILED TO ACHIEVE SCF. ****----++++        '/
      90 !
      91 ! SUMMARY OF RESULTS (NOTE: THIS IS IN A SUBROUTINE SO IT
      92 !          CAN BE USED BY THE PATH OPTION)
      93       if (icalcn == 0) then
      94         namfil = '**NULL**'
      95         escf_min = escf
      96         bigcycles = (index(keywrd, " BIGCYC") /= 0)
      97       end if
      98       if (bigcycles) then
      99         if (escf > escf_min) return
 
 FORCHECK PC V13.5.13          WRITMO          2021-03-24 10:59:30   page:  4335
