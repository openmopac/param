      21     double precision function fn (x, qn, mode)
      22    !
      23    !.. Implicit Declarations ..
      24       implicit none
      25    !
      26    !.. Formal Arguments ..
      27       integer, intent (in) :: qn, mode
      28       double precision, intent (in) :: x
      29    !
      30    !.. External Calls ..
      31       double precision, external :: rsc
      32       select case (mode)
      33       case (0)
      34     !
      35     !  Calculate Gss given the principal quantum number
      36     !  and Slater exponent for the "s" orbital.
      37     !
      38         fn = rsc (0, qn, x, qn, x, qn, x, qn, x)
      39       case (1)
      40     !
      41     !  Calculate Gpp given the principal quantum number
      42     !  and Slater exponent for the "p" orbital.
      43     !
      44         fn = rsc (0, qn, x, qn, x, qn, x, qn, x) + 0.16d0 * rsc (2, qn,
  x, qn, &
      45        & x, qn, x, qn, x)
      46       case (2)
      47     !
      48     !  Calculate Gdd given the principal quantum number
      49     !  and Slater exponent for the "d" orbital.
      50     !
      51         fn = rsc (0, qn, x, qn, x, qn, x, qn, x) + 4.d0 / 49.d0 * (rsc
 (2, qn, &
      52        & x, qn, x, qn, x, qn, x)+rsc (4, qn, x, qn, x, qn, x, qn, x))
      53       end select
      54       return
      55     end function fn
 
