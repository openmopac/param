      92       subroutine corrci(cimat, cist, aocc, bocc, diagsl, eval)
      93       use molkst_C, only : mpack, keywrd
      94       use reimers_C, only : nconf, nov, nex, mspn
      95       USE chanel_C, only : iw
      96       implicit none
      97       double precision :: cimat(nconf*(nconf + 1)/2), deltap(mpack), &
      98                       diagsl(nconf), eval(nconf), cist(nconf, nconf), &
      99 !                      dpall(mpack, nconf), ucener(nconf), eorig(nconf)
     100                       ucener(nconf), eorig(nconf)
     101       logical*1 :: aocc(nov, mspn, nex), bocc(nov, mspn, nex)
     102
     103       integer :: ist
     104       double precision :: ener
     105 !**********************************************************************
 *
     106 !   RMG - compute the correction to the final CI states. First compute
     107 !   the energies without the diagonal corrections. Then compute the
     108 !   state densities and updated energy corrections for the proper
     109 !   densities.
     110 !**********************************************************************
 *
     111
     112       do ist = 1, nconf
     113         eorig(ist) = eval(ist)
     114       end do
     115
     116 ! Compute uncorrected state energies if necessary
     117       if (index(keywrd, ' KL2') == 0) then
     118         call unsolv(cimat, cist, diagsl, ucener)
     119       else
     120         ucener = eorig
     121       end if
     122
     123 ! For each state, compute the proper energetic correction
     124       do ist = 1, nconf
     125         call stdeltap(cist, aocc, bocc, deltap, ist)
     126         call solenr(deltap, ener)
     127         eval(ist) = ucener(ist) + ener
     128       end do
     129
     130 !      write (6, *) 'Energy corrections'
     131       write (iw, *) ''
     132       write (iw, *) 'COSMO corrections to state energies'
     133       write (iw, *) 'State    Diag E (eV)   Uncorr E (eV)   Final E (eV
 )'
     134       do ist = 1, nconf
     135         !write (6, '(i6, 3f15.5)') ist, eorig(ist), ucener(ist), eval(i
 st)
     136         write (iw, '(i6, 3f15.5)') ist, eorig(ist), ucener(ist), eval(i
 st)
     137       end do
     138
     139       return
     140       end subroutine corrci
 
