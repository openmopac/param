     175             gamma(ib + 8, ib + 1) = gamma(ib + 5, ib + 3)
     176 !           **** p - d exchange terms ****
     177             gamma(ib + 1, ib + 4) =  fg(mg1pd, ia) + 18*fg(mg3pd, ia)
     178             gamma(ib + 2, ib + 4) = gamma(ib + 1, ib + 4)
