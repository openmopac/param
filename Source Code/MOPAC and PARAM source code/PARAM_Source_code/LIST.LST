    1061             f0(istart:is_esp,j)
    1062             np = is_esp + 1
    1063             rnai(np:ipe,j) = 2.D0*pi*exs(np:ipe,j)*expn(np:ipe,j)*f0(np
 :ipe,j)
    1064             rnai1(np:ipe,j) = 2.D0*pi*exs(np:ipe,j)*expn(np:ipe,j)*f1(n
 p:ipe,j)
    1065 !
    1066 !     CALCULATE (S||P) ESP INTEGRALS
    1067 !
    1068             if (iam(ipr,1)/=0 .or. is_esp==ip) cycle
    1069             u_esp(np:ipe,j) = (ewcx(np:ipe,j)-cen(np:ipe,1))*rnai(np:ip
 e,j) - &
    1070             (ewcx(np:ipe,j)-potp1)*rnai1(np:ipe,j)
    1071             u_esp(ipe+1:1+ipx+ipe,j) = (ewcy(ipe+1-ipx:1+ipe,j)-cen(ipe
 +1-ipx:1+ipe,2))* &
    1072             rnai(ipe+1-ipx:1+ipe,j) - (ewcy(ipe+1-ipx:1+ipe,j)-potp2)*&
    1073               rnai1(ipe+1-ipx:1+ipe,j)
    1074             u_esp(ipe+1+ipx:npr,j) = (ewcz(ipe+1+ipx-ipx2:npr-ipx2,j) -
