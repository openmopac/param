     232         cp298 = cptot
     233         s298  = stot
     234       end if
     235       write (iw, &
     236       '(/3X,''*: NOTE: HEATS OF FORMATION ARE RELATIVE TO THE'',/12X,&
     237         &''ELEMENTS IN THEIR STANDARD STATE AT 298K'')')
     238 !     INSERTED BY PROF.HIRANO
     239       write (iw, '(12X,''  (=  Standard Enthalpy of Formation).'')')  !
 ,        /12X,&
     240    !     &''Heat of Formation at T is calculated as [Escf + (HT - H298.
 15)-.'')')
     241       write (iw, &
     242       & '(/12X,''Hvib:  Zero-point energy is not included.'',    /12X,&
     243       &''       frequencies of less than zero cm-1 are not included.'',
  &
     244       & /12X,''Hrot = (3/2)RT''/12X,''Htra = (3/2)RT + pV = (5/2)RT'')'
 )
     245       write (iw, '(/12X,''Heat capacity is Cp, not Cv'')')
