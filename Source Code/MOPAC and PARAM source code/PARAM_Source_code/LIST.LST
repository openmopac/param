       1       subroutine schmit(u, n, ndim)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5 !**********************************************************************
 *
       6       implicit none
       7 !-----------------------------------------------
       8 !   D u m m y   A r g u m e n t s
       9 !-----------------------------------------------
      10       integer , intent(in) :: n
      11       integer , intent(in) :: ndim
      12       double precision , intent(inout) :: u(ndim,ndim)
      13 !-----------------------------------------------
      14 !   L o c a l   P a r a m e t e r s
      15 !-----------------------------------------------
      16 !-----------------------------------------------
      17 !   L o c a l   V a r i a b l e s
      18 !-----------------------------------------------
      19       integer :: ii, k, k1, npass, j
      20       double precision :: zero, small, one, dot, scale
      21
      22       save zero, small, one
      23 !-----------------------------------------------
      24       data zero, small, one/ 0.D0, 0.01D0, 1.D0/
      25       ii = 0
      26       do k = 1, n
      27         k1 = k - 1
      28 !
      29 !     NORMALIZE KTH COLUMN VECTOR
      30 !
      31         dot = zero
      32         dot = dot + sum(u(:n,k)*u(:n,k))
      33         if (Abs(dot) < 1.d-20) go to 100
      34         scale = one/sqrt(dot)
      35         u(:n,k) = scale*u(:n,k)
      36    30   continue
      37         if (k1 == 0) cycle
      38         npass = 0
      39 !
      40 !     PROJECT OUT K-1 PREVIOUS ORTHONORMAL VECTORS FROM KTH VECTOR
      41 !
      42    40   continue
      43         npass = npass + 1
      44         do j = 1, k1
      45           dot = zero
      46           dot = dot + sum(u(:n,j)*u(:n,k))
      47           u(:n,k) = u(:n,k) - dot*u(:n,j)
      48         end do
      49 !
      50 !     SECOND NORMALIZATION (AFTER PROJECTION)
      51 !     IF KTH VECTOR IS SMALL BUT NOT ZERO THEN NORMALIZE
      52 !     AND PROJECT AGAIN TO CONTROL ROUND-OFF ERRORS.
      53 !
      54         dot = zero
      55         dot = dot + sum(u(:n,k)*u(:n,k))
      56         if (Abs(dot) < 1.d-20) go to 100
      57         if (dot<small .and. npass>2) go to 100
 
 FORCHECK PC V13.5.13          SCHMIT          2021-03-24 10:59:30   page:     7
 schmit.F90  /FF
 
      58         scale = one/sqrt(dot)
      59         u(:n,k) = scale*u(:n,k)
      60         if (dot < small) go to 40
      61         cycle
      62 !
      63 !     REPLACE LINEARLY DEPENDENT KTH VECTOR BY A UNIT VECTOR.
      64 !
      65   100   continue
      66         ii = ii + 1
      67 !     IF(II.GT.N) CALL MOPEND
      68         u(ii,k) = one
      69         go to 30
      70       end do
      71       return
      72       end subroutine schmit
 
