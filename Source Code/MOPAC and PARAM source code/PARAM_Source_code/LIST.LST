       1   subroutine wrt_diffs
       2 !
       3 ! Given two geometries, work out the differences in bond-lengths
       4 ! and print the resulting values, largest first
       5 !
       6 ! The two geometries are in geo and geoa
       7 !
       8    use chanel_C, only : iw, job_fn
       9    use molkst_C, only : numat, refkey, line, geo_dat_name, keywrd_txt,
 maxtxt
      10 !
      11    use elemts_C, only : elemnt
      12 !
      13    use common_arrays_C, only : geo, geoa, nat, nbonds, ibonds, txtatm,
 coord
      14 !
      15    implicit none
      16    integer :: i, j, j1, k, l, m, n, npairs, ijbonds(15)
      17    integer, allocatable :: pairs(:,:)
      18    logical :: first = .TRUE.
      19    double precision :: sum, sum_a, sum_b, sum_aa, sum_bb
      20    double precision, allocatable :: dist(:,:)
      21    integer, allocatable :: jbonds(:,:), njbonds(:)
      22      allocate(pairs(2,numat*10), dist(3,numat*10), jbonds(15,numat), nj
 bonds(numat))
      23 !
      24 ! Work out connectivity twice - the sequence of atoms on one set might
 be
      25 ! different to that in the other set.
      26 !
      27      coord(:,:numat) = geoa(:,:numat)
      28      call set_up_dentate()
      29      jbonds(:,:numat) = ibonds(:,:numat)
      30      njbonds(:numat) = nbonds(:numat)
      31      coord(:,:numat) = geo(:,:numat)
      32      call set_up_dentate()
      33 !
      34 !  Decide on bonds to an atom by whichever system has the more bonds to
  that atom
      35 !
      36      do i = 1, numat
      37        if (njbonds(i) > nbonds(i)) then
      38          nbonds(i) = njbonds(i)
      39          ibonds(:nbonds(i),i) = jbonds(:nbonds(i),i)
      40        end if
      41        if (nbonds(i) > njbonds(i)) then
      42          njbonds(i) = nbonds(i)
      43         jbonds(:nbonds(i),i) = ibonds(:nbonds(i),i)
      44        end if
      45      end do
      46      npairs = 0
      47      do i = 1, numat
      48        do j = 1, nbonds(i)
      49          k = ibonds(j,i)
      50 !
      51 ! Decide which atom(s) in the first system matche(s) atom "k" in the se
 cond system
      52 ! If the choice is unambiguous, use that atom, otherwise use all atoms
 
 FORCHECK PC V13.5.13        WRT_DIFFS         2021-03-24 10:59:30   page:   357
 wrt_diffs.F90  /FF
 
 that are bonded to atom "i"
      53 ! and then pick the best match.
      54 !
      55          m = 0
      56          n = 0
      57          do j1 = 1, nbonds(i)
      58            l = jbonds(j1,i)
      59            if (txtatm(l)(12:) == txtatm(k)(12:)) then
      60              m = l
      61              n = n + 1
      62            end if
      63          end do
      64          if (n == 1) then
      65 !
      66 !  The label on one and only one atom matches atom "i"
      67 !
      68            ijbonds(1) = m
      69            m = 1
      70          else
      71            m = nbonds(i)
      72            ijbonds(:m) = jbonds(:m,i)
      73          end if
      74          sum = 10.d0
      75          sum_aa = 0.d0
      76          sum_bb = 0.d0
      77          do j1 = 1, m
      78            l = ijbonds(j1)
      79            if (l > i .or. k > i .or. k == 0 .or. l == 0) cycle
      80            if (nat(k) /= nat(l)) cycle
      81            if (maxtxt == 26) then
      82              if (txtatm(k)(13:16) /= txtatm(l)(13:16)) cycle
      83            end if
      84            sum_a = sqrt((geo(1,i) - geo(1,k))**2 + (geo(2,i) - geo(2,k)
 )**2 + (geo(3,i) - geo(3,k))**2)
      85            sum_b = sqrt((geoa(1,i) - geoa(1,l))**2 + (geoa(2,i) - geoa(
 2,l))**2 + (geoa(3,i) - geoa(3,l))**2)
      86            if (sum > abs(sum_a - sum_b)) then
      87              sum = abs(sum_a - sum_b)
      88              sum_aa = sum_a
      89              sum_bb = sum_b
      90            end if
      91          end do
      92          if (sum < 9.d0) then
      93            npairs = npairs + 1
      94            pairs(1, npairs) = i
      95            pairs(2, npairs) = k
      96            dist(1,npairs) = sum
      97            dist(2,npairs) = sum_aa
      98            dist(3,npairs) = sum_bb
      99          end if
     100        end do
     101      end do
     102     !
     103     ! Write out differences,largest first
     104     !
     105     do i = 1, min(25, npairs)
     106       sum = 0.d0
     107       k = 0
     108       do j = 1, npairs
 
 FORCHECK PC V13.5.13        WRT_DIFFS         2021-03-24 10:59:30   page:   358
 wrt_diffs.F90  /FF
 
     109         if (sum < dist(1,j)) then
     110           sum = dist(1,j)
     111           k = j
     112         end if
     113       end do
     114       if (sum < 0.01d0) exit
     115       j = pairs(1,k)
     116       l = pairs(2,k)
     117       if (nat(l) == nat(j) .and. j > l .or. nat(l) > nat(j)) then
     118         j = pairs(2,k)
     119         l = pairs(1,k)
     120       end if
     121       if (first) then
     122         if (trim(job_fn) == trim(geo_dat_name)) then
     123           line = "dataset"
     124         else
     125           line = "GEO_DAT"
     126         end if
     127         write(iw,'(/28x,a)')" Differences between bond-lengths for the
 two geometries"
     128         write(iw,'(/,a)')"           Diff.                 Atom 1
      "//&
     129           &"            Atom 2                  Bond length      Bond l
 ength"
     130         write(iw,'(85x,a)')" in "//trim(line)//"      in GEO_REF"
     131         first = .false.
     132       end if
     133       write(iw,'(i4, f12.3, 4x, a, 3x, a, f11.3, 5x, f12.3)') &
     134         i, dist(1,k), elemnt(nat(j))//"("//trim(txtatm(j))//")",  elemn
 t(nat(l))//"("//trim(txtatm(l))//")", dist(2,k), dist(3,k)
     135       dist(1,k) = -10.d0
     136     end do
     137     if ( .not. first) then
     138       i = index(keywrd_txt," GEO_DAT")
     139       if (i > 0) then
     140         do k = 1, 6
     141           line = " "//trim(refkey(k))
     142           call upcase(line, len_trim(line))
     143           i = index(line," GEO_DAT")
     144           if (i /= 0) exit
     145         end do
     146         j = index(refkey(k)(i + 10:),'"') + index(refkey(k)(i + 10:),"'
 ") + i + 8
     147         line = refkey(k)(i + 9:j)
     148         write(iw,'(/3x,a)')" GEO_DAT:  '"//trim(line)//"'"
     149       else
     150         write(iw,'(/3x,a)')" Data set: '"//trim(job_fn)//"'"
     151       end if
     152       do k = 1, 6
     153         line = " "//trim(refkey(k))
     154         call upcase(line, len_trim(line))
     155         i = index(line," GEO_REF")
     156         if (i /= 0) exit
     157       end do
     158       j = index(refkey(k)(i + 10:),'"') + index(refkey(k)(i + 10:),"'")
  + i + 8
     159       line = refkey(k)(i + 9:j)
     160       write(iw,'(3x,a)')" GEO_REF:  '"//trim(line)//"'"
     161     end if
 
 FORCHECK PC V13.5.13        WRT_DIFFS         2021-03-24 10:59:30   page:   359
 wrt_diffs.F90  /FF
 
     162   end subroutine wrt_diffs
 
