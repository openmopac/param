     608 !
     609 ! Local
     610 !
     611   integer :: i_atom, i, j, i_delta = 0, new_res, old_res, previous = -2
 00, &
     612     mbreaks, loop
     613   character :: old*3, new*3
     614   double precision, external :: reada
     615   logical :: first = .true.
     616   character :: num
     617   first = .true.
     618   mbreaks = 1
     619   i_atom = 0
     620   do loop = 1, numat
     621 !
     622 !  Find first non-hydrogen atom
     623 !
     624     do
     625       i_atom = i_atom + 1
     626       if (i_atom > numat) exit
     627        if (i_atom == breaks(mbreaks)) mbreaks = mbreaks + 1
     628       if (nat(i_atom) /= 1) exit
     629     end do
     630     if (i_atom > numat) exit
     631     new_res = nint(reada(txtatm(i_atom),23))
     632     new = txtatm (i_atom)(18:20)
     633     if (maxtxt == 14) then
     634       old_res = nint(reada(txtatm1(i_atom),12))
     635       old = txtatm1(i_atom)(8:10)
     636     else
     637       old_res = nint(reada(txtatm1(i_atom),23))
     638       old = txtatm1(i_atom)(18:20)
     639     end if
     640     if (new_res - i_delta /= old_res) then
     641       i_delta = new_res - old_res
     642     end if
     643     if (new_res /= previous) then
     644       if (old /= new .and. index(keywrd, "CHANGED ALREADY PRINTED") ==
 0) then
     645         if (old /= "HET" .or. new /= "HOH") then
     646           if (first) then
     647             write(iw,'(/16x,a)')"Residue names that have changed"
     648             write(iw,'(7x,a,/)')"Original residue name   Calculated res
 idue name"
     649             if (log) then
     650               write(ilog,'(/16x,a)')"Residue names that have changed"
     651               write(ilog,'(7x,a,/)')"Original residue name   Calculated
 
