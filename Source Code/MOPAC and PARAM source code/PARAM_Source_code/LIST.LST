     671 !     *****************************************************************
 ********
     672
     673       subroutine geome (ct, cp, sp, m, h)
     674 !
     675 !     this subroutine gives the transformation matrix necessary for the
     676 !     expression of p, d, and f tensors in the simplest canonical terms
 .
     677 !
     678 !     m = 0, 1, 2, 3, 4, 5, 6, 7, 8 for s, x, y, z, 3z2 - r2, x2 - y2,
 xy, xz, yz respectively
     679 !     ____________ deleted to save space ______________
     680 !     m = 9, 10, 11, 12, 13, 14, 15 for z3, xz2, yz2, z(x2 - y2), xyz,
 x(x2 - 3y2), and
     681 !        y(3x2 - y2)
     682 !     m = 51, 52, 53 for x2, y2, z2
     683 !
     684 !     h(i) returns as sigma, pi - x, pi - y, delta - (x**2 - y**2), del
 ta - xy, phi -
     685 !          x(x2 - 3y2), phi - y(3x2 - y2), and s component if any.
     686 !
     687 !     the phases of the real fns. are those of frank harris in the upps
     688 !     ala monograph.
     689 !     spherical coordinates. ct = cos(theta), cp = cos(phi), sp = sin(p
 hi).
     690 !     h returns as trans elements of 3 - dim. space for p orb. and of 5
  - di
     691 !     m space for the d orb., etc.
     692
     693 !      implicit          double precision :: (a - h, o - z)
     694       implicit none
     695       double precision ::   h(8), ct, cp, sp, dsqrt3, one, two, three,
 zero, &
     696                          r, st, z
     697       integer ::            m
     698
     699       data dsqrt3/1.732050807d0/one/1.d0/zero/0.d0/two/2.d0/three/3.d0/
     700
     701       h(1) = one
     702       h(2) = zero
     703       h(3) = zero
     704       h(4) = zero
     705       h(5) = zero
     706       h(6) = zero
     707       h(7) = zero
     708       h(8) = zero
     709       if (m == 0) go to 50
     710       continue
     711       r = two*sp*cp
     712       st = dabs (one - ct**2)
     713       if (1.D-7 - st <= 0.d0) go to 22
     714       st = zero
     715       go to 24
     716    22 continue
     717       st = dsqrt(st)
     718    24 continue
     719       z = cp**2 - sp**2
     720       go to (1, 2, 3, 4, 5, 6, 7, 8), m
 
 FORCHECK PC V13.5.13          GEOME           2021-03-24 10:59:30   page:  2079
 ovlp.F90  /FF
 
     721 !     p type fn.
     722     1 h(1) = cp*st
     723       h(2) = cp*ct
     724       h(3) = -sp
     725       go to 50
     726     2 h(1) = sp*st
     727       h(2) = sp*ct
     728       h(3) = cp
     729       go to 50
     730     3 h(1) = ct
     731       h(2) = -st
     732       h(3) = zero
     733       go to 50
     734 !     d type fn .
     735     4 h(1) = (three*ct*ct - one)/two
     736       h(2) = -dsqrt3*ct*st
     737       h(3) = zero
     738       h(4) = dsqrt3*(one - ct**2)/two
     739       h(5) = zero
     740       go to 50
     741     5 h(1) = dsqrt3*z*(one - ct*ct)/two
     742       h(2) = ct*z*st
     743       h(3) = -st*r
     744       h(4) = z*(one + ct*ct)/two
     745       h(5) = -r*ct
     746       go to 50
     747     6 h(1) = dsqrt3*cp*sp*(one - ct*ct)
     748       h(2) = ct*st*r
     749       h(3) = z*st
     750       h(4) = cp*sp*(one + ct*ct)
     751       h(5) = ct*z
     752       go to 50
     753     7 h(1) = dsqrt3*cp*ct*st
     754       h(2) = cp*(two*ct*ct - one)
     755       h(3) = -sp*ct
     756       h(4) = -h(1)/dsqrt3
     757       h(5) = sp*st
     758       go to 50
     759     8 h(1) = dsqrt3*sp*ct*st
     760       h(2) = sp*(two*ct*ct - one)
     761       h(3) = cp*ct
     762       h(4) = -h(1)/dsqrt3
     763       h(5) = -cp*st
     764    50 continue
