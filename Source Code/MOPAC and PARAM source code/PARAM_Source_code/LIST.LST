       1       subroutine schmib(u, n, ndim)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5 !**********************************************************************
 *
       6       implicit none
       7 !-----------------------------------------------
       8 !   D u m m y   A r g u m e n t s
       9 !-----------------------------------------------
      10       integer , intent(in) :: n
      11       integer , intent(in) :: ndim
      12       double precision , intent(inout) :: u(ndim,ndim)
      13 !-----------------------------------------------
      14 !   L o c a l   P a r a m e t e r s
      15 !-----------------------------------------------
      16 !-----------------------------------------------
      17 !   L o c a l   V a r i a b l e s
      18 !-----------------------------------------------
      19       integer :: n1, ii, k, k1, npass, j
      20       double precision :: zero, small, one, dot, scale
      21
      22       save zero, small, one
      23 !-----------------------------------------------
      24 !
      25 !     SAME AS SCHMIDT BUT WORKS FROM RIGHT TO LEFT.
      26 !
      27       data zero, small, one/ 0.0D0, 0.01D0, 1.0D0/
      28       n1 = n + 1
      29       ii = 0
      30       do k = 1, n
      31         k1 = k - 1
      32 !
      33 !     NORMALIZE KTH COLUMN VECTOR
      34 !
      35         dot = zero
      36         dot = dot + sum(u(:n,n1-k)*u(:n,n1-k))
      37         if (Abs(dot) < 1.d-20) go to 100
      38         scale = one/sqrt(dot)
      39         u(:n,n1-k) = scale*u(:n,n1-k)
      40    30   continue
      41         if (k1 == 0) cycle
      42         npass = 0
      43 !
      44 !     PROJECT OUT K-1 PREVIOUS ORTHONORMAL VECTORS FROM KTH VECTOR
      45 !
      46    40   continue
      47         npass = npass + 1
      48         do j = 1, k1
      49           dot = zero
      50           dot = dot + sum(u(:n,n1-j)*u(:n,n1-k))
      51           u(:n,n1-k) = u(:n,n1-k) - dot*u(:n,n1-j)
      52         end do
      53 !
      54 !     SECOND NORMALIZATION (AFTER PROJECTION)
      55 !     IF KTH VECTOR IS SMALL BUT NOT ZERO THEN NORMALIZE
      56 !     AND PROJECT AGAIN TO CONTROL ROUND-OFF ERRORS.
      57 !
 
 FORCHECK PC V13.5.13          SCHMIB          2021-03-24 10:59:30   page:    31
 schmib.F90  /FF
 
      58         dot = zero
      59         dot = dot + sum(u(:n,n1-k)*u(:n,n1-k))
      60         if (Abs(dot) < 1.d-20) go to 100
      61         if (dot<small .and. npass>2) go to 100
      62         scale = one/sqrt(dot)
      63         u(:n,n1-k) = scale*u(:n,n1-k)
      64         if (dot < small) go to 40
      65         cycle
      66 !
      67 !     REPLACE LINEARLY DEPENDENT KTH VECTOR BY A UNIT VECTOR.
      68 !
      69   100   continue
      70         ii = ii + 1
      71 !     IF(II.GT.N) CALL MOPEND
      72         u(ii,n1-k) = one
      73         go to 30
      74       end do
      75       return
      76       end subroutine schmib
 
