       1 double precision function PM6_DH_Dispersion(l_grad)
       2   use molkst_C, only : numat, E_disp
       3   use common_arrays_C, only: coord, dxyz
       4   implicit none
       5   logical, intent (in) :: l_grad
       6   double precision, external :: PM6_DH_Disp
       7 !
       8 !  Local
       9 !
      10   double precision :: sum, sum1, sum2, delta = 1.d-5
      11   integer :: i, k
      12   E_disp = PM6_DH_Disp(0, numat)
      13   PM6_DH_Dispersion = E_disp
      14   if (l_grad) then
      15 !
      16 !   Dispersion contribution is small, so only calculate the CUC.
      17 !
      18     do k = 1, numat
      19       sum2 = PM6_DH_Disp(k, 1)
      20       do i = 1, 3
      21         coord(i,k) = coord(i,k) + delta
      22         sum = PM6_DH_Disp(k, 1)
      23         sum1 = (sum2 - sum)/delta
      24         if (Abs(sum1) < 50.d0) then
      25           dxyz((k - 1)*3 + i) = dxyz((k - 1)*3 + i) - sum1
      26         end if
      27         coord(i,k) = coord(i,k) - delta
      28       end do
      29     end do
      30   end if
      31   return
      32 end function PM6_DH_Dispersion
 
