     438 subroutine lmo_to_eigenvectors(nlmo, ncx, nncx, ncxxx, n_dim, &
     439      & icxxx, icxxx_dim, cxxx, cxxx_dim, eigs, c)
     440   use molkst_C, only : numat, norbs
     441   use common_arrays_C, only : nfirst, nlast
     442   implicit none
     443   integer, intent (in) :: nlmo, icxxx_dim, cxxx_dim, n_dim
     444   integer, dimension (n_dim), intent (in) :: ncx, ncxxx, nncx
     445   integer, dimension (icxxx_dim), intent (in) :: icxxx
     446   double precision, dimension (norbs), intent (out) :: eigs
     447   double precision, dimension (norbs, nlmo), intent (out) :: c
     448   double precision, dimension (cxxx_dim), intent (in) :: cxxx
     449 !
     450   integer :: i, ka, jj, j, k, l
     451   double precision, dimension(:), allocatable :: fmo_expanded, &
     452   vec_lmo, c_lmo, ws, ac
     453   logical, allocatable, dimension (:) :: latoms
     454   allocate (fmo_expanded (nlmo*nlmo), vec_lmo(nlmo*nlmo), c_lmo(norbs),
  &
     455          & latoms(numat), ws(norbs), &
     456          & ac(numat), stat=i)
     457
     458   if (i /= 0) then
     459     call memory_error ("DiagonaliseFockLMOScheme")
     460     return
     461   end if
     462   call FlmoFromFao (nlmo, ncx, nncx, ncxxx, nlmo, &
     463            & latoms, ws, icxxx, icxxx_dim, cxxx, cxxx_dim, &
     464            & ac, fmo_expanded)
     465 !
     466 ! Diagonalise Fock matrix
     467    call rsp(fmo_expanded, nlmo, eigs, vec_lmo)
     468 !
     469 ! Reconstruct eigenvectors in AO basis
     470 !
     471    c(:norbs,:nlmo) = 0.d0
     472   do i = 1, nlmo
     473     !
     474     ! Expand i'th LMO into uncompressed format
     475     c_lmo = 0.d0
     476     ka = ncxxx(i)
     477     do jj = nncx(i) + 1, nncx(i) + ncx(i)
     478       j = icxxx(jj)
     479       do k = nfirst(j), nlast(j)
     480         ka = ka + 1
     481         c_lmo(k) = cxxx(ka)
     482       end do
     483     end do
     484     !
     485     ! Add contribution from i'th LMO to all eigenstates
     486     !
     487     do k = 1, norbs
     488       if (Abs (c_lmo(k)) > 1.0d-10) then
     489         l = i
     490         do j = 1, nlmo
     491           c(k,j) = c(k,j) + vec_lmo(l) * c_lmo(k)
     492           l = l + nlmo
     493         end do
     494       end if
 
 FORCHECK PC V13.5.13   LMO_TO_EIGENVECTORS    2021-03-24 10:59:30   page:   643
 eigen.F90  /FF
 
     495     end do
     496   end do
     497   deallocate (fmo_expanded, vec_lmo, c_lmo, latoms, ws, ac)
     498   end subroutine lmo_to_eigenvectors
 
