     253          A  =  nint(hbs(1, m))
     254          B  =  nint(hbs(2, m))
     255          H  =  nint(hbs(3, m))
     256          typa  =  hbpar(at(A))
     257          typb  =  hbpar(at(B))
     258          shortcut  =  r0ab(typa, typb)
     259          cab  =  0.50d0*(scalehb(typa)  +  scalehb(typb))
     260          call eabh(n, A, B, H, coord, shortcut, cab, e)
     261          if (e < -1.d0/627.51d0) N_Hbonds  =  N_Hbonds  +  1
