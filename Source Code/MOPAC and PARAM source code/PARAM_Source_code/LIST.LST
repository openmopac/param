 chkion.F90  /FF
 
     288                  else if (jj < -1) then
     289                   call add_Lewis_element(i,0,-2, n_lone_pairs) ! di-Ani
 on
     290                   ox_calc(i) = ox_calc(i) - 2
     291                 end if
     292               end do
     293             else  if (iz(i) > 1) then
     294               call add_Lewis_element(i,0,0, n_lone_pairs)  ! Lone pair
     295             else
     296               call add_Lewis_element(0,i,0, dummy)  ! Virtual lone pair
     297             end if
     298           end if
     299         end do
     300       end do atom_loop
     301     end do
     302     nocc_local = 0
     303     do i = 1, Lewis_tot
     304       if (Lewis_elem(1,i) /= 0) nocc_local = nocc_local + 1
     305     end do
     306     mm = nocc_local - nelecs/2
     307 !
     308 !  mm is the number of undetermined Lewis elements that should be
     309 !  virtual.  These elements are always charged carbon atoms.
     310 !
     311     do i = 1, mm
     312       do j = 1, Lewis_tot
     313         jj = Lewis_elem(1,j)
     314         if (jj < 0) then
     315           jj = -jj              ! Convert undetermined charged carbon
     316           Lewis_elem(2,j) = jj   ! into a cation
     317           Lewis_elem(1,j) = 0
     318           iz(jj) = iz(jj) - 1
     319           if (ib(jj) == 1) then
     320             write (iw,'(/10x,a,i6,a)') " WARNING: Carbon atom ", jj, "
 has an unexpected valency!   PDB Label: """// &
     321             txtatm(jj)//""""
     322             if (nbonds(jj) > 0) then
     323               num = "1"
     324               do k = 1, nbonds(jj)
     325                 num(k) = char(ichar("1") +int(log10(ibonds(k,jj) + 0.05
 )))
     326               end do
     327               line = '(10x,a,a,i'//num(1)//',3x,a,i'//num(2)//',3x,a,i'
 //num(3)
     328               line = trim(line)//',3x,a,i'//num(4)//',3x,a,i'//num(5)//
 ',3x,a,i'//num(6)
     329               line = trim(line)//',3x,a,i'//num(7)//',3x,a,i'//num(8)//
 ',3x,a,i'//num(9)//',3x,a,i'//num(10)//',a)'
     330               write (iw,trim(line))" It is connected to:  ",(elemnt(nat
 (ibonds(k,jj))),ibonds(k,jj), k = 1, nbonds(jj)), "only"
     331             else
     332               write (iw,'(a)')" It is not connected to any other atom."
     333             end if
     334             write(iw,"(/)")
     335           end if
     336 !
     337 ! Convert all remaining unused atomic orbitals into virtual lone pairs
     338 !
     339           do
 
