       1 subroutine fock1_for_MOZYME (f, ptot, w, kr, iab, ilim)
       2     implicit none
       3     integer, intent (in) :: iab, ilim
       4     integer, intent (inout) :: kr
       5     double precision, dimension ((iab*(iab+1))/2), intent (in) :: ptot
       6     double precision, dimension ((iab*(iab+1))/2), intent (inout) :: f
       7     double precision, dimension (ilim, ilim), intent (in) :: w
       8 !
       9     integer :: i, ij, ijp, ijw, ikw, im, ip, j, jlw, jm, jp, k, klw, l
      10     double precision :: sum
      11    ! ******************************************************************
 ***
      12    !
      13    ! *** COMPUTE THE REMAINING CONTRIBUTIONS TO THE ONE-CENTER ELEMENTS
 .
      14    !
      15    ! ******************************************************************
 ***
      16    !
      17    !   One-center coulomb and exchange terms for atom II.
      18    !
      19    !  F(i,j)=F(i,j)+sum(k,l)((PA(k,l)+PB(k,l))*<i,j|k,l>
      20    !                        -(PA(k,l)        )*<i,k|j,l>), k,l on atom
 II.
      21    !
      22     do i = 1, iab
      23       do j = 1, i
      24          !
      25          !    Address in 'F'
      26          !
      27         ij = (i*(i-1)) / 2 + j
      28          !
      29          !    'J' Address IJ in W
      30          !
      31         ijw = (i*(i-1)) / 2 + j
      32         sum = 0.d0
      33         do k = 1, iab
      34           do l = 1, iab
      35             ip = Max (k, l)
      36             jp = Min (k, l)
      37                !
      38                !    Address in 'P'
      39                !
      40             ijp = (ip*(ip-1)) / 2 + jp
      41                !
      42                !    'J' Address KL in W
      43                !
      44             im = Max (k, l)
      45             jm = Min (k, l)
      46             klw = (im*(im-1)) / 2 + jm
      47                !
      48                !    'K' Address IK in W
      49                !
      50             im = Max (k, j)
      51             jm = Min (k, j)
      52             ikw = (im*(im-1)) / 2 + jm
      53                !
      54                !    'K' Address JL in W
 
 FORCHECK PC V13.5.13     FOCK1_FOR_MOZYME     2021-03-24 10:59:30   page:    36
 fock1_for_MOZYME.F90  /FF
 
      55                !
      56             im = Max (l, i)
      57             jm = Min (l, i)
      58             jlw = (im*(im-1)) / 2 + jm
      59                !
      60                !   The term itself
      61                !
      62             sum = sum + ptot(ijp) * w(ijw, klw) - 0.5d0 * ptot(ijp) * w
  &
      63            & (ikw, jlw)
      64           end do
      65         end do
      66         f(ij) = f(ij) + sum
      67       end do
      68     end do
      69     kr = kr + ilim ** 2
      70 end subroutine fock1_for_MOZYME
 
