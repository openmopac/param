    2585       subroutine hplusf(f, h, norbs)
    2586 !-----------------------------------------------
    2587 !   M o d u l e s
    2588 !-----------------------------------------------
    2589       use funcon_C, only : ev
    2590       implicit none
    2591 !-----------------------------------------------
    2592 !   D u m m y   A r g u m e n t s
    2593 !-----------------------------------------------
    2594       integer , intent(in) :: norbs
    2595       double precision , intent(inout) :: f(norbs,norbs)
    2596       double precision , intent(in) :: h(norbs,norbs)
    2597 !-----------------------------------------------
    2598 !   L o c a l   V a r i a b l e s
    2599 !-----------------------------------------------
    2600       double precision :: hartr
    2601 !-----------------------------------------------
    2602 !
    2603 ! HPLUSF ADDS THE 1 AND 2-ELECTRON PARTS OF THE FOCK MATRIX
    2604 !
    2605       hartr = ev
    2606       f = h + f/hartr
    2607       return
    2608       end subroutine hplusf
 
