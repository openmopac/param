 )**2)&
     885      &                * debye
     886           if (i0 == 1 .and. solv) then
     887             beta = 0.d0
     888             solva = 0.d0
     889             solve = 0.d0
     890             do kk = 1, 3
     891               deldip = dmci(nmd, kk) - dmci(nm0, kk)
     892               beta = beta + deldip**2
     893               solva = solva + dmci(nm0, kk)*deldip
     894               solve = solve + dmci(nmd, kk)*deldip
     895             end do
     896             beta =  fref * beta * 0.5
     897             solva = -feps * solva - beta
     898             solve = -feps * solve + beta
     899
     900 !           **** Jeffs special code to evaluate polarizability after sh
 ift ****
     901             evalci(il) = evalci(il) + solva * au2ev / au2cm
     902             eng = evalci(il) - evalci(i0)
     903             freq = eng / au2ev * au2cm
     904             wl = 0.d0
     905             if (abs(freq) > 1.d0) wl = 1.D7/abs(freq)
     906           end if
     907
     908 !         **** transition moments and oscillator strengths ****
     909           nm = matind(max(i0, il)) + min(i0, il)
     910           mom = dmci(nm, 1)**2 + dmci(nm, 2)**2 + dmci(nm, 3)**2
     911 !         write (iy, '(3i4, 4f10.5)') i0, il, nm, sqrt(mom)*debye,
     912 !     $                            (dmci(nm, k)*debye, k = 1, 3)
     913           if (ndtype /= 2) then
     914 !           **** f = 2/3*m**2*e with m, e in au; with m in Ang and e in
  cm** - 1
     915             fosc = foscf * freq * mom
     916             if (ndtype == 3) fosc = fosc * 1000.d0
     917           else
     918 !           **** f = 2/3*m**2/e with m, e in au; with m in Ang** - 1 an
 d e in cm** - 1
     919             fosc = foscm / freq * mom
     920           end if
     921           call polizn (dmci(nm, 1), dmci(nm, 2), dmci(nm, 3), freq)
     922
     923           dipch = sqrt ((dmci(nmd, 1) - dmci(1, 1))**2 + &
     924      &      (dmci(nmd, 2) - dmci(1, 2))**2 + (dmci(nmd, 3) - dmci(1, 3)
 )**2)
     925           if (irrtyp > 0 .and. freq < 4.D5) write (40, 1170)&
     926      &      il - 1, nst, nmrep(nst, nptg), freq, fosc, dipch
     927
     928           if (il > i0 .and. fosc > 0.00000001d0) then
     929
 
 FORCHECK PC V13.5.13          CIOUT           2021-03-24 10:59:30   page:  3992
 ci.F90  /FF
 
     930 !           **** main output to log file ****
