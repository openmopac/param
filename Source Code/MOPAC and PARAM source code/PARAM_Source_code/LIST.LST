       1 subroutine addhb (nocc1, nvir1,  idiagg, nij, nhb)
       2    !*******************************************************************
 ****
       3    !
       4    !   CHECK FOCK MATRIX AND DENSITY MATRIX TO ENSURE THAT ALL
       5    !   FOCK MATRIX ELEMENTS ARE BEING CORRECTLY HANDLED BY THE
       6    !   DIAGONALISER.
       7    !
       8    !*******************************************************************
 ***
       9    !
      10    !  nocc1    Number of occupied M.O.s (might be a subset of noccupied
 )
      11    !  nvir1    Number of virtual M.O.s (might be a suset of nvirtual)
      12    !
      13    !*******************************************************************
 ***
      14     use molkst_C, only : numat, norbs
      15     use common_arrays_C, only: eigs, f
      16     implicit none
      17     integer, intent (in) :: idiagg, nhb, nocc1, nvir1
      18     integer, intent (out) :: nij
      19     integer :: alloc_stat
      20     logical, dimension (:), allocatable :: latom_loc
      21     double precision, dimension(:), allocatable :: storei, storej
      22     integer, allocatable, dimension(:) :: iused
      23     double precision, dimension (4) :: hblims
      24     data hblims / 1.d0, 0.1d0, 0.01d0, 0.001d0 /
      25     allocate (latom_loc(numat), iused(Max (norbs, numat)), &
      26          & storei(norbs), storej(norbs), &
      27          & stat=alloc_stat)
      28     if (alloc_stat /= 0) then
      29       call memory_error ("addhb")
      30       return
      31     end if
      32     call hbonds (f, nocc1, nvir1, iused, nij, hblims(nhb))
      33     if (nij /= 0) then
      34       call diagg2 (nocc1, nvir1, eigs(nocc1+1:), iused, latom_loc, &
      35       nij, idiagg, storei, storej)
      36     end if
      37     deallocate (latom_loc, iused, storei, storej)
      38     if (alloc_stat /= 0) then
      39       call memory_error ("addhb")
      40     end if
      41 end subroutine addhb
 
