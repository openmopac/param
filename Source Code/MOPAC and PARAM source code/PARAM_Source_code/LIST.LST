    2106 subroutine prthes (eigval, nvar, hess, u)
    2107     use chanel_C, only: iw
    2108     use ef_C, only: iprnt
    2109    !
    2110    !.. Implicit Declarations ..
    2111     implicit none
    2112    !
    2113    !.. Formal Arguments ..
    2114     integer, intent (in) :: nvar
    2115     double precision, dimension (nvar), intent (in) :: eigval
    2116     double precision, dimension (nvar, nvar), intent (in) :: hess, u
    2117    !
    2118    !.. Local Scalars ..
    2119     integer :: i, j, low, nup
    2120    !
    2121    !.. Intrinsic Functions ..
    2122     intrinsic Min
    2123    !
    2124    ! ... Executable Statements ...
    2125    !
    2126     if (iprnt >= 4) then
    2127       write (iw,*) " "
    2128       write (iw,*) "              HESSIAN MATRIX"
    2129       low = 1
    2130       nup = 8
    2131       do
    2132         nup = Min (nup, nvar)
    2133 10000   format (/, 3 x, 8 i9)
    2134         write (iw, 10000) (i, i=low, nup)
    2135         do i = 1, nvar
    2136 10010     format (1 x, i3, 8 f9.1)
    2137           write (iw, 10010) i, (hess(i, j), j=low, nup)
    2138         end do
    2139         nup = nup + 8
    2140         low = low + 8
    2141         if (low > nvar) exit
    2142       end do
    2143     end if
    2144     write (iw,*) " "
    2145     write (iw,*) "              HESSIAN EIGENVALUES AND -VECTORS"
    2146     low = 1
    2147     nup = 8
    2148     do
    2149       nup = Min (nup, nvar)
    2150       write (iw, 10000) (i, i=low, nup)
    2151 10020 format (/, 4 x, 8 f9.1, /)
    2152       write (iw, 10020) (eigval(i), i=low, nup)
    2153       do i = 1, nvar
    2154 10030   format (1 x, i3, 8 f9.4)
    2155         write (iw, 10030) i, (u(i, j), j=low, nup)
    2156       end do
    2157       nup = nup + 8
    2158       low = low + 8
    2159       if (low > nvar) exit
    2160     end do
    2161 end subroutine prthes
 
