       1       subroutine upcase(keywrd, n)
       2       implicit none
       3 !-----------------------------------------------
       4 !   D u m m y   A r g u m e n t s
       5 !-----------------------------------------------
       6       integer , intent(in) :: n
       7       character , intent(inout) :: keywrd*(*)
       8 !-----------------------------------------------
       9 !   L o c a l   V a r i a b l e s
      10 !-----------------------------------------------
      11       integer :: icapa, ilowa, ilowz, i, iline, j
      12       character :: keybuf*2000
      13 !-----------------------------------------------
      14 !
      15 !  UPCASE WILL TAKE A CHARACTER STRING, IN KEYWRD, AND PUT IT INTO
      16 !  UPPER CASE.  KEYWRD IS LIMITED TO 80 CHARACTERS
      17 !
      18       icapa = ichar('A')
      19       ilowa = ichar('a')
      20       ilowz = ichar('z')
      21       keybuf = keywrd
      22       do i = 1, n
      23         iline = ichar(keywrd(i:i))
      24         if (iline>=ilowa .and. iline<=ilowz) &
      25         keywrd(i:i) = char(iline + icapa - ilowa)
      26         if (iline /= 9) cycle
      27 !
      28 !  Change tabs to spaces.  A tab is ASCII character 9.
      29 !
      30         keywrd(i:i) = ' '
      31       end do
      32 !
      33 !   If the word EXTERNAL is present, do NOT change case of the followin
 g
      34 !   character string.
      35 !
      36       i = index(keywrd,'EXTERNAL=')
      37       if (i /= 0) then
      38         j = index(keywrd(i+1:),' ') + i
      39         keywrd(i+9:j) = keybuf(i+9:j)
      40       end if
      41       return
      42       end subroutine upcase
 
