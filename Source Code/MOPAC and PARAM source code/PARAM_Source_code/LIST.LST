     470                 phinet(ipm, ix) = phinet(ipm, ix) + dirtm(ix, j) * dirv
 ec &
     471                & (4, j)
     472               end do
     473             end if
     474           end do
     475           ips = nps0 - 1
     476           loop1: do
     477             ips = ips + 1
     478             do while (nar_csm(ips) == 0)
     479               niter = 1
     480               nps = nps - 1
     481               if (ips > nps) exit loop1
     482               do jps = ips, nps
     483                 nar_csm(jps) = nar_csm(jps + 1)
     484                 phinet(jps, 1) = phinet(jps + 1, 1)
     485                 if (Abs(phinet(1, 1)) > 1.d-20) then
     486                   ips = ips
     487                end if
     488                 phinet(jps, 2) = phinet(jps + 1, 2)
     489                 phinet(jps, 3) = phinet(jps + 1, 3)
     490               end do
     491             end do
     492             dists = 0.d0
     493             do ix = 1, 3
     494               dists = dists + phinet(ips, ix) ** 2
     495             end do
     496             dists = Max (dists, 1.d-20)
     497             dist = 1.d0 / Sqrt (dists)
     498             do ix = 1, 3
     499               cosurf(ix, ips) = phinet(ips, ix) * dist
     500             end do
     501             if (ips >= nps) exit
     502           end do loop1
     503           if (niter >= 2) exit
     504         end do
     505          ! NOW ALL SEGMENTS ARE FINALLY DEFINED AND THE ASSOCIATED
     506          ! BASIC GRID POINTS ARE CLOSE - PACKED
     507         do ips = nps0, nps
     508           nsetf(ips) = inset
     509           inset = inset + nar_csm(ips)
     510           nar_csm(ips) = 0
     511           cosurf(4, ips) = 0.d0
     512           do ix = 1, 3
     513             cosurf(ix, ips) = cosurf(ix, ips) * ri + xa(ix)
     514           end do
