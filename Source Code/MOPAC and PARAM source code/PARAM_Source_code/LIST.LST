       2       subroutine formxy(w, kr, wca, wcb, ca, na, cb, nb)
       3 !-----------------------------------------------
       4 !   M o d u l e s
       5 !-----------------------------------------------
       6       USE molkst_C, only : numcal
       7       implicit none
       8 !-----------------------------------------------
       9 !   D u m m y   A r g u m e n t s
      10 !-----------------------------------------------
      11       integer , intent(inout) :: kr
      12       integer , intent(in) :: na
      13       integer , intent(in) :: nb
      14       double precision , intent(in) :: w(*)
      15       double precision , intent(inout) :: wca(45)
      16       double precision , intent(inout) :: wcb(45)
      17       double precision , intent(in) :: ca(45)
      18       double precision , intent(in) :: cb(45)
      19 !-----------------------------------------------
      20 !   L o c a l   V a r i a b l e s
      21 !-----------------------------------------------
      22       integer :: icalcn, ij, i, j, kl, k, l, nna, nnb, n1, n2
      23       double precision :: aa, sum, bb
      24       integer, dimension (45) :: in
      25
      26       save icalcn
      27 !-----------------------------------------------
      28 !**********************************************************************
 *
      29 !
      30 !    EACH OF THE NA ELEMENTS OF WCA WILL ADD ON THE NB ELECTROSTATIC
      31 !    TERMS FROM ATOM B IN CB
      32 !
      33 !    EACH OF THE NB ELEMENTS OF WCB WILL ADD ON THE NA ELECTROSTATIC
      34 !    TERMS FROM ATOM A IN CA
      35 !
      36 !    BOTH SUMS WILL INVOLVE THE NA*NB TERMS IN ARRAY W.  ONCE USED,
      37 !    W WILL BE INCREMENTED BY NA*NB.
      38 !
      39 ! NA=NUMBER OF ATOMIC ORBITALS ON ATOM 'A'.
      40 ! NB=NUMBER OF ATOMIC ORBITALS ON ATOM 'B'.
      41 !
      42 !**********************************************************************
 *
      43       data icalcn/ 0/
      44       in(1)  = 1
      45       in(10) = 4
      46       in(45) = 9
      47       if (icalcn /= numcal) icalcn = numcal
      48       ij = 0
      49       n1 = 0
      50       nna = in(na)
      51       nnb = in(nb)
      52       do i = 1, nna
      53         aa = 1.d0
      54         do j = 1, i
      55           n1 = n1 + 1
      56           if (i == j) then
      57             aa = 0.5d0
 
 FORCHECK PC V13.5.13          FORMXY          2021-03-24 10:59:30   page:   277
 formxy.F90  /FF
 
      58           end if
      59           ij = ij + 1
      60           sum = 0.d0
      61           kl = 0
      62           n2 = 0
      63           do k = 1, nnb
      64             bb = 1.d0
      65             do l = 1, k
      66               n2 = n2 + 1
      67               if (k == l) then
      68                 bb = 0.5d0
      69               end if
      70               kl = kl + 1
      71               sum = sum + cb(kl) * w((n1-1)*nb+n2) * bb
      72             end do
      73           end do
      74           wca(ij) = wca(ij) + sum * aa
      75         end do
      76       end do
      77       ij = 0
      78       n1 = 0
      79       do i = 1, nnb
      80         aa = 1.d0
      81         do j = 1, i
      82           n1 = n1 + 1
      83           if (i == j) then
      84             aa = 0.5d0
      85           end if
      86           ij = ij + 1
      87           sum = 0.d0
      88           kl = 0
      89           n2 = 0
      90           do k = 1, nna
      91             bb = 1.d0
      92             do l = 1, k
      93               n2 = n2 + 1
      94               if (k == l) then
      95                 bb = 0.5d0
      96               end if
      97               kl = kl + 1
      98               sum = sum + ca(kl) * w((n2-1)*nb+n1) * bb
      99             end do
     100           end do
     101           wcb(ij) = wcb(ij) + sum * aa
     102         end do
     103       end do
     104       kr = kr + na * nb
