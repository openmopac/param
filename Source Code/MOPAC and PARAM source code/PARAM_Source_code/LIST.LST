     150                   ! GET FIRST ATOM
     151               k = ijbo (jj, jj)
     152               ij = 0
     153               do i = 1, iorbs(jj)
     154                 do j = 1, i
     155                   ij = ij + 1
     156                   k = k + 1
     157                   padi(ij) = p(k) * 0.5d0
     158                   pdi(ij) = p(k)
     159                 end do
     160               end do
     161                   ! GET SECOND ATOM FIRST ATOM INTERSECTION
     162               if (ii == jj) then
