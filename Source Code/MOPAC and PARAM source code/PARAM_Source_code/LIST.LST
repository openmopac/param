     603 !     *****************************************************************
 ********
     604
     605       subroutine dipol (x, y, z, dm)
     606
     607 !     **** calculates dipole moment matrix elements in AO basis   ****
     608 !     **** units of dipole are eA                                 ****
     609       use reimers_C, only : n, na, nb2, matind, au2ang, &
     610           natm, nbf, ibf, iat, nbt, nprn, zeta, zetad, zetawt, &
     611           dipsym, ndtype, fact
     612 !      USE chanel_C, only : iw
     613
     614       implicit none
     615       double precision ::  x(na), y(na), z(na), dm(nb2, 3), &
     616                         two, three, bohrmg, &
     617                         sqrt3, &
     618                         al, aaa, am, amu, bmu, delx, dely, delz, &
     619                         pd, r, sp, t, zj, zk
     620       integer ::           i, j, &
     621                         i1, ia, ib, iss, &
     622                         j2, j3, ja, jb, jnat, &
     623                         k3, ka, kb, knat, mmmm, mu, nm, nu
     624
     625
     626       data two, three    /2.d0, 3.d0/
     627 !     **** the Borh magneton ehbar/(2.mass_e.c) in units of e Ang ****
     628       data bohrmg       /0.0019308d0/
     629
     630       sqrt3 = sqrt (three)
     631       pd = 0.d0
     632
     633 !     **** start by zeroing all elements ****
     634       ndtype = 1
     635       do i = 1, nb2
     636         do j = 1, 3
     637           dm(i, j) = 0.d0
     638         end do
     639       end do
     640       if (ndtype <= 1) then
     641
     642 !       **** usual length formalism of dipole integrals, REAL ****
     643
     644         dipsym = 1.d0
     645         do i = 1, na
     646           ia = natm(i)
     647           ib = ibf(i)
     648           do i1 = ib, ib + nbf(i) - 1
     649 !           **** contribution from atomic charges ****
     650             nm = matind(i1) + i1
     651             dm(nm, 1) = -x(i)
     652             dm(nm, 2) = -y(i)
     653             dm(nm, 3) = -z(i)
     654            end do
     655
     656           if (nbf(i) > 1 .and. ndtype == 1) then
     657 !           **** include one - centre hybridization terms ****
     658
     659 !           **** sp polarization term ****
 
 FORCHECK PC V13.5.13          DIPOL           2021-03-24 10:59:30   page:  1973
 integral.F90  /FF
 
     660             j2 = 2*nprn(ib) + 1
     661             amu = zeta(ia)
     662             sp = -au2ang * j2 / amu / two / sqrt3
     663             if (nbf(i) > 4) then
     664 !             **** pd polarization term ****
     665               j3 = j2 - 2
     666               k3 = j2
     667               pd = 0.d0
     668               do iss = 1, 2
     669                 bmu = zetad(iss, ia)
     670                 t = dsqrt ((two*amu)**j2 * (two*bmu)**j3 /&
     671      &             (fact(j2)*fact(j3)*5.d0) ) * fact(k3) / (amu + bmu)*
 *k3
     672                 pd = pd + t * zetawt(iss, ia)
     673               end do
     674             end if
     675
     676             do mu = ib + 1, ib + nbf(i) - 1
     677               do nu = ib, mu - 1
     678                 nm = matind(mu) + nu
     679                 if (nbt(nu) == 0) then
     680 !                 **** store any sp terms ****
     681                   if (nbt(mu) == 1) then
     682                     dm(nm, 1) = sp
     683                   else if (nbt(mu) == 2) then
     684                     dm(nm, 2) = sp
     685                   else if (nbt(mu) == 3) then
     686                     dm(nm, 3) = sp
     687                   end if
     688                 else if (nbt(nu) <= 3 .and. nbt(mu) > 3) then
     689 !                 **** pd polarization terms ****
     690                   mmmm = nbt(nu) + 3*(nbt(mu) - 4)
     691       go to (1302, 1304, 1306, 1308, 1310, 1800, 1312, 1308, 1800, 1314
 , &
     692      & 1800, 1308, 1800, 1314, 1312), mmmm
     693  1302 dm(nm, 1) = au2ang*pd/sqrt3
     694       go to 1800
     695  1304 dm(nm, 2) = au2ang*pd/sqrt3
     696       go to 1800
     697  1306 dm(nm, 3) = -au2ang*pd*two/sqrt3
     698       go to 1800
     699  1308 dm(nm, 1) = -au2ang*pd
     700       go to 1800
     701  1310 dm(nm, 2) = au2ang*pd
     702       go to 1800
     703  1312 dm(nm, 2) = -au2ang*pd
     704       go to 1800
     705  1314 dm(nm, 3) = -au2ang*pd
     706       go to 1800
     707
     708  1800       continue
     709                 end if
     710               end do
     711             end do
     712
     713           end if
     714         end do
     715       else if (ndtype == 2) then
     716 !       **** dipole velocity eqns of Hush and Williams CPL 8 (1971) 179
 
 FORCHECK PC V13.5.13          DIPOL           2021-03-24 10:59:30   page:  1974
 integral.F90  /FF
 
  ****
     717 !       **** but note their last two eqns for Iz must be mult by two **
 **
     718 !       **** only p - p integrals hence only programmed for PPP calc **
 **
     719 !       **** mx, my, mz are imaginary and have units of Angstrom** - 1
 ****
     720 !       **** works only for 2nd row elements                       ****
     721 !       **** Integrals are actually IMAGINARY                      ****
     722
     723         dipsym = -1.d0
     724         nm = 0
     725         do jb = 1, n
     726           ja = iat(jb)
     727           jnat = natm(ja)
     728 !         **** zeta is in bohr, convert to Ang** - 1 ****
     729           zj = zeta(jnat) / au2ang
     730
     731           do kb = 1, jb
     732             nm = nm + 1
     733             if (jb /= kb) then
     734               ka = iat(kb)
     735               knat = natm(ka)
     736               zk = zeta(knat) / au2ang
     737
     738               delx = x(ka) - x(ja)
     739               dely = y(ka) - y(ja)
     740               delz = z(ka) - z(ja)
     741               r = sqrt (delx**2 + dely**2 + delz**2)
     742               al = 0.5d0 * r * (zk + zj)
     743               if (abs(zk - zj) > 1.d-10) then
     744 !               **** different atom types ****
     745                 am = 0.5d0 * r * (zk - zj)
     746                 aaa = -32.d0 / (r/2.d0)**4 * &
     747      &            (zk*zj)**3 * sqrt (zk*zj) / (zk**2 - zj**2)**5 *&
     748      &            (3.d0 + 3.d0*al + al**2) *&
     749      &            (exp(- zk*r)*(3.d0 + 3.d0*am + am**2) - &
     750      &             exp(- zj*r)*(3.d0 - 3.d0*am + am**2) )
     751               else
     752 !               **** same type of atom (Chong formula) ****
     753                 aaa = -zk * al/15.d0 * exp(- al) * (3.d0 + 3.d0*al + al
 **2)
     754               end if
     755               aaa = aaa / r
     756               dm(nm, 1) = aaa * delx
     757               dm(nm, 2) = aaa * dely
     758               dm(nm, 3) = aaa * delz
     759             end if
     760           end do
     761         end do
     762
     763       else if (ndtype == 3) then
     764
     765 !       **** Magnetic transition moments, IMAGINARY ****
     766
     767         dipsym = -1.d0
     768         do i = 1, na
     769           if (nbf(i) /= 1) then
     770 !           **** include p - p one - centre hybridization terms ****
 
 FORCHECK PC V13.5.13          DIPOL           2021-03-24 10:59:30   page:  1975
 integral.F90  /FF
 
     771             ib = ibf(i)
     772             dm(matind(ib + 3) + ib + 2, 1) =  bohrmg
     773             dm(matind(ib + 3) + ib + 1, 2) = -bohrmg
     774             dm(matind(ib + 2) + ib + 1, 3) =  bohrmg
     775           end if
     776         end do
     777
     778       end if
     779
     780       return
     781       end subroutine dipol
 
