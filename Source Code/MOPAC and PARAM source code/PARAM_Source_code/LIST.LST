     730       subroutine ders(m, n, rr, del1, del2, del3, is, iol)
     731 !-----------------------------------------------
     732 !   M o d u l e s
     733 !-----------------------------------------------
     734       USE overlaps_C, only :  ccc,  zzz
     735       use funcon_C, only : a0
     736       USE analyt_C, only : ds
     737       implicit none
     738 !-----------------------------------------------
     739 !   D u m m y   A r g u m e n t s
     740 !-----------------------------------------------
     741       integer , intent(in) :: m
     742       integer , intent(in) :: n
     743       integer , intent(in) :: is
     744       integer , intent(in) :: iol
     745       double precision , intent(in) :: rr
     746       double precision , intent(in) :: del1
     747       double precision , intent(in) :: del2
     748       double precision , intent(in) :: del3
     749 !-----------------------------------------------
     750 !   L o c a l   V a r i a b l e s
     751 !-----------------------------------------------
     752       integer :: i, j
     753       double precision, dimension(6,6) :: ss
     754       double precision :: apb, amb, adb, adr, abn
     755 !-----------------------------------------------
     756 !**********************************************************************
 *
     757 !
 *
     758 !    ON INPUT M    = INDEX OF FIRST ATOMIC ORBITAL
 *
     759 !             N    = INDEX OF SECOND ATOMIC ORBITAL
 *
     760 !             RR   = SQUARE IF INTERATOMIC DIATANCE (IN BOHR)
 *
     761 !             DEL1 = CATERSIAN DISTANCE IN DERIVATIVE DIRECTION
 *
     762 !             DEL2 = CARTESIAN DISTANCE IN M A.O.'S DIRECTION
 *
     763 !             DEL3 = CARTESIAN DISTANCE IN N A.O.'S DIRECTION
 *
     764 !             IS   = INDICATES TYPE OF A.O.-A.O. INTERACTION
 *
     765 !                  = 1 S/S, 2 S/P', 3 S/P, 4 P'/S, 5 P/S, 6 P/P',
 *
     766 !                    7 P'/P", 8 P'P', 9 P/P
 *
     767 !             IOL  = INDEX FOR STORING DERIVATIVES IN DS
 *
     768 !
 *
     769 !**********************************************************************
 *
     770       do i = 1, 6
     771         do j = 1, 6
     772           ss(i,j) = 0.0D0
     773           apb = zzz(m,i)*zzz(n,j)
 
 FORCHECK PC V13.5.13           DERS           2021-03-24 10:59:30   page:  3695
 analyt.F90  /FF
 
     774           amb = zzz(m,i) + zzz(n,j)
     775           adb = apb/amb
     776           adr = min(adb*rr,35.D0)
     777           select case (is)
     778           case default
     779             abn = -2.0D0*adb*del1/a0**2
     780           case (2)
     781             abn = -4.0D0*adb**2*del1*del2/(sqrt(zzz(n,j))*a0**3)
     782           case (3)
     783             abn = (2.0D0*adb/(sqrt(zzz(n,j))*a0))*(1.0D0 - 2.0D0*adb*de
 l1**2/a0&
     784               **2)
     785           case (4)
     786             abn = 4.0D0*adb**2*del1*del2/(sqrt(zzz(m,i))*a0**3)
     787           case (5)
     788             abn = -(2.0D0*adb/(sqrt(zzz(m,i))*a0))*(1.0D0 - 2.0D0*adb*d
 el1**2/a0&
     789               **2)
     790           case (6)
     791             abn = -(4.0D0*adb**2*del2/(sqrt(apb)*a0**2))*(1.0D0 - 2.0D0
 *adb*&
     792               del1**2/a0**2)
     793           case (7)
     794             abn = 8.0D0*adb**3*del1*del2*del3/(sqrt(apb)*a0**4)
     795           case (8)
     796             abn = -(8.0D0*adb**2*del1/(sqrt(apb)*a0**2))*(0.5D0 - adb*d
 el2**2/&
     797               a0**2)
     798           case (9)
     799             abn = -(8.0D0*adb**2*del1/(sqrt(apb)*a0**2))*(1.5D0 - adb*d
 el1**2/&
     800               a0**2)
