    1775       subroutine betall(u2a, g2a, u1b, g1b, u1c, g1c, nclose, norbs, te
 rm)
    1776 !-----------------------------------------------
    1777 !   M o d u l e s
    1778 !-----------------------------------------------
    1779 !
    1780 ! THIS SUBROUTINE CALCULATES TRACE OF UGU MATRICES
    1781 ! WHEN A,B,C DIRECTIONS ARE DIFFERENT
    1782 !
    1783 !-----------------------------------------------
    1784 !   I n t e r f a c e   B l o c k s
