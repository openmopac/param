     241   subroutine get_bvec (x1, x2, nao, ni, w)
     242     use funcon_C, only : a0
     243     use parameters_C, only : dd, qq
     244     implicit none
     245     double precision, dimension(3), intent (in) :: x1, x2
     246     integer, intent (in) :: nao, ni
     247     double precision, dimension(*), intent (out) :: w
     248     double precision, dimension(3) :: dx
     249     double precision :: r, dip, quad
     250     integer :: i
     251     intrinsic Sqrt
     252     !
     253     dx(1) = x1(1) - x2(1)
     254     dx(2) = x1(2) - x2(2)
     255     dx(3) = x1(3) - x2(3)
     256
     257     r = 1.d0 / Sqrt (dx(1)**2 + dx(2)**2 + dx(3)**2)
     258
     259     w(1) = r
     260
     261     if (nao == 0) then ! --- H
     262       return
     263     else ! --- sp - element
     264       dip = dd(ni) * a0 * r * r
     265       quad = (a0 *qq(ni))** 2 * r * r * r
     266       dx(1) = dx(1) * r
     267       dx(2) = dx(2) * r
     268       dx(3) = dx(3) * r
     269
     270       w(2) =  dx(1) * dip
     271       w(4) =  dx(2) * dip
     272       w(7) =  dx(3) * dip
     273
     274       w(3)  = r + (3.d0*dx(1)**2 - 1.d0) * quad
     275       w(6)  = r + (3.d0*dx(2)**2 - 1.d0) * quad
     276       w(10) = r + (3.d0*dx(3)**2 - 1.d0) * quad
     277
     278       w(5) = 3.d0*dx(1)*dx(2) * quad
     279       w(8) = 3.d0*dx(1)*dx(3) * quad
     280       w(9) = 3.d0*dx(2)*dx(3) * quad
     281
     282       if (nao < 4) then
     283         return
     284       else ! --- d - element
     285         do i = 11, 45
     286           w(i) = 0
     287         end do
     288         w(15) = r
     289         w(21) = r
     290         w(28) = r
     291         w(36) = r
     292         w(45) = r
     293       end if
     294     end if
     295   end subroutine get_bvec
 
