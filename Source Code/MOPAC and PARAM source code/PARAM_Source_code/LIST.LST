      47 !
      48 ! compute energy
      49 !
      50       subroutine edisp(max_elem, maxc, n, nat, c6ab, mxc, r2r4, r0ab, r
 cov, &
      51         rs6, rs8, alp6, alp8, e6, e8)
      52       use funcon_C, only : a0
      53       implicit none
      54       integer :: n, nat(*), max_elem, maxc, mxc(max_elem)
      55       double precision :: r0ab(max_elem, max_elem), r2r4(*)
      56       double precision :: rs6, rs8, alp6, alp8, rcov(max_elem)
      57       double precision :: c6ab(max_elem, max_elem, maxc, maxc, 3)
      58       double precision :: e6,  e8
      59
      60       integer :: iat, jat
      61       double precision :: r, r2, r6, r8, tmp, c6, c8, rthr, rthr2
      62       double precision :: damp6, damp8, rr
      63       double precision :: cn(n)
      64       double precision, external :: distance
      65 !
      66 ! In this subroutine, array "coord" is in atomic units, not Angstroms.
      67 !
      68 !
      69 !  Set cutoff for Edisp interactions, in Angstroms
      70 !
      71       rthr = 15.d0
      72 !
      73       rthr2 = (rthr/a0)**2
      74       e6  =  0.d0
      75       e8  =  0.d0
      76       call ncoord(n, rcov, nat, cn)
      77       do iat  =  1, n-1
      78         do jat  =  iat + 1, n
      79           r = distance(iat, jat)
      80           r2 = r**2
      81 !THR
      82           if (r2 > rthr2) cycle
      83           rr  =  r0ab(nat(jat), nat(iat))/r
      84 ! damping
      85           tmp  =  rs6*rr
      86           damp6  =  1.d0/( 1.d0 + 6.d0*tmp**alp6 )
      87           tmp  =  rs8*rr
      88           damp8  =  1.d0/( 1.d0 + 6.d0*tmp**alp8 )
      89 ! get C6
      90           call getc6(maxc, max_elem, c6ab, mxc, nat(iat), nat(jat), cn(
 iat), cn(jat), c6)
      91           r6  =  r2**3
      92           r8  =  r6*r2
      93 ! r2r4 stored in main as sqrt
      94           c8  =  3.0d0*c6*r2r4(nat(iat))*r2r4(nat(jat))
      95           e6  =  e6 + c6*damp6/r6
      96           e8  =  e8 + c8*damp8/r8
      97         end do
      98       end do
      99       return
     100       end
 
