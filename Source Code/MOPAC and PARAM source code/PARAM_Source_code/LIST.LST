     125   subroutine point (r, ni, nj, w, kr, e1b, e2a, enuc)
     126   use funcon_C, only : a0, ev
     127   use parameters_C, only : tore, natorb
     128   implicit none
     129   integer, intent (in) :: ni, nj
     130   integer, intent (out) :: kr
     131   double precision, intent (inout) :: r
     132   double precision, intent (out) :: enuc
     133   double precision, dimension (45), intent (out) :: e1b, e2a
     134   double precision, dimension (*), intent (out) :: w
     135   integer :: i, j, ii, jj, nii, njj
     136   double precision :: ee, ee1, ee2
     137   double precision, external :: trunk
     138 !
     139 !   In solid-state work, if an interatomic distance is larger than
     140 !   clower, then the NDDO approximation is replaced by a point-charge
     141 !   approximation, in which the point-charge is located at a distance
     142 !   that depends on the interatomic distance (see trunk)
     143 !
     144     r = trunk (r)
     145     ee = ev * a0 / r
     146     ee1 = -ee * tore(nj)
     147     ee2 = -ee * tore(ni)
     148     i = natorb(ni)
     149     j = natorb(nj)
     150     nii = (i*(i+1)) / 2
     151     njj = (j*(j+1)) / 2
     152     kr = nii * njj
     153     !
     154     !  Fill "w" array
     155     !
     156     w(1:kr) = 0.d0
     157     i_loop: do ii = 1, i
     158       j_loop: do jj = 1, j
     159         w(((ii*(ii+1))/2-1)*njj+ (jj*(jj+1))/2) = ee
     160       end do j_loop
     161     end do i_loop
     162     !
     163     ! Fill e1b and e2a
     164     !
     165     e1b(1:nii) = 0
     166     e2a(1:njj) = 0
     167     do ii = 1, i
     168       e1b((ii*(ii+1))/2) = ee1
     169     end do
     170     do jj = 1, j
     171       e2a((jj*(jj+1))/2) = ee2
     172     end do
     173     !
     174     !  Compute nuclear contribution
     175     !
     176     enuc = -ee1 * tore(ni)
     177 end subroutine point
 
