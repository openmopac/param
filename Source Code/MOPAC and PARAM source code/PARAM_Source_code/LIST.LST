       1       module rotate_C
       2 !
       3 !   Set up an equivalence between the core-core array ccore and the ind
 ividual
       4 !   terms, for use in ROTATE
       5 !
       6       double precision :: css1, csp1, cpps1, cppp1, css2, csp2, cpps2,
 cppp2
       7       double precision, dimension(4,2) :: ccore = 0.d0
       8       equivalence (ccore(1,1), css1), (ccore(2,1), csp1), (ccore(3,1),
 cpps1), &
       9       & (ccore(4,1), cppp1), (ccore(1,2), css2), (ccore(2,2), csp2), &
      10       & (ccore(3,2), cpps2), (ccore(4,2), cppp2)
      11       end module rotate_C
 
