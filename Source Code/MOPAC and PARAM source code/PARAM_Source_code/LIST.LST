       1 subroutine optgeo (xparam, yparam, nvar, refgeo, glim)
       2   !********************************************************************
 **
       3   !
       4   !   OPTGEO 1:  Optimizes the current geometry
       5   !              If the geometry is a geometry reference, the reference
       6   !              data are restored before exit.
       7   !  On exit, xparam holds the optimized geometry; geometric references
  are
       8   !           NOT changed.
       9   !           yparam holds to optimized geometric references
      10   !
      11   !********************************************************************
 **
      12     use param_global_C, only : ifiles_8, molnam, contrl
      13     use molkst_C, only : moperr, errtxt, escf, keywrd
      14     use common_arrays_C, only : gradients => grad, loc
      15     implicit none
      16     integer, intent (inout) :: nvar
      17     double precision, intent (in) :: glim
      18     character (len=12), dimension (300), intent (in) :: refgeo
      19     double precision, dimension (nvar), intent (inout) :: xparam
      20     double precision, dimension (nvar), intent (out) ::  yparam
      21     logical :: lsav
      22     integer :: i, lim, j
      23     double precision :: sum
      24     double precision, dimension (nvar) :: x_store
      25     integer, dimension (2,nvar) :: loc_store
      26     external compfg, ef
      27     double precision, external :: dot
      28     intrinsic Min, Sqrt
      29 !----------------------------------------------------------------------
 ---
      30   !
      31   !  Compute the gradient.
      32   !
      33        lim = Min (300, nvar)
      34        j = 0
      35        do i = 1, lim
      36         if (refgeo(i) /= " ") j = j + 1
      37       end do
      38       if(nvar - j > 0 .or. nvar == 0)then
      39         escf = 0.d0
      40         call compfg (xparam, .true., escf, .true., gradients, .true.)
      41           if (moperr) then
      42             write (ifiles_8, "(2A)") " Deadly error detected in COMPFG
 in OPTGEO, in system ", &
      43            & molnam
      44             write (ifiles_8, "(2A)") " Error message:", errtxt (1:50)
      45           end if
      46   !
      47   !  Compute the GNORM.  First, set gradients due to geometric referenc
 es to zero.
      48   !
      49           do i = 1, lim
      50             if (refgeo(i) /= " ") then
      51             gradients(i) = 0.d0
      52           end if
 
 FORCHECK PC V13.5.13          OPTGEO          2021-03-24 10:59:30   page:  3464
 optgeo.F90  /FF
 
      53         end do
      54       if (nvar > 0) then
      55         sum = Sqrt (dot(gradients, gradients, nvar))
      56       else
      57         sum = 0.d0
      58       end if
      59     else
      60       sum=0.d0
      61     endif
      62   !
      63   !  Store the geometric variables - they might be used if PARTAB is
      64   !  called.
      65   !
      66     do i = 1, nvar
      67       x_store(i) = xparam(i)
      68       loc_store(1,i) = loc(1,i)
      69       loc_store(2,i) = loc(2,i)
      70     end do
      71   !
      72   !  If the GNORM is large, re-optimize the geometry
      73   !
      74     lsav = (sum > glim)
      75     if (lsav) then
      76       if( glim > 0.d0) then
      77     !
      78     !  Arrange to optimize only the variables that are NOT geometric re
 ferences
      79     !  This is for parameter optimization.  If PARTAB is called, then g
 lim < 0
      80     !  and the whole geometry is optimized.
      81     !
      82         j = 0
      83         do i = 1,nvar
      84           if (i > lim .or. refgeo(i) == " ") then
      85             j = j + 1
      86             loc(1,j) = loc(1,i)
      87             loc(2,j) = loc(2,i)
      88             xparam(j) = xparam(i)
      89           end if
      90         end do
      91         i = nvar
      92         nvar = j
      93       end if
      94       if(nvar == 1) then
      95        call flepo (xparam, nvar, escf)
      96       else if(nvar > 1) then
      97         if (index(keywrd,' LBFGS') + index(contrl,' LBFGS')  /= 0) then
      98           call lbfgs(xparam, escf)
      99         else
     100           call ef (xparam, escf)
     101         end if
     102       end if
     103       if (glim < 0) then
     104 !
     105 !  This is used for PARTAB: restore reference data to xparam,
     106 !  put optimized geometry into yparam
     107 !
     108         do i = 1, lim
     109           if (refgeo(i) /= " ") then
 
 FORCHECK PC V13.5.13          OPTGEO          2021-03-24 10:59:30   page:  3465
 optgeo.F90  /FF
 
     110             yparam(i) = xparam(i)
     111             xparam(i) = x_store(i)
     112             if (abs(gradients(i)) < 1.d-4) gradients(i) = 1.d-4
     113           end if
     114         end do
     115       else
     116 !
     117 !  Restore geometry.  x_store contains the reference geometric data plu
 s the
     118 !  un-optimized geometry.  xparam contains the optimized geometry
     119 !
     120         nvar = i
     121         j = 0
     122         do i = 1, nvar
     123           if (i > lim .or. refgeo(i) == " ") then
     124             j = j + 1
     125             x_store(i) = xparam(j)
     126           end if
     127         end do
     128         do i = 1, nvar
     129           loc(1,i) = loc_store(1,i)
     130           loc(2,i) = loc_store(2,i)
     131           xparam(i) = x_store(i)
     132         end do
     133         if (moperr) then
     134           write (ifiles_8, "(2A)") " Deadly error detected in EF, in sy
 stem ", molnam
     135           write (ifiles_8, "(2A)") " Error message:", errtxt (1:50)
     136         end if
     137       end if
     138     end if
     139     return
     140 end subroutine optgeo
 
