     167           qv = qv/ewjr
     168           e0 = wi*ewj/ewjr
     169           hv = hv + e0
     170           cpv = cpv + e0*e0/ewj
     171           sv1 = sv1 + dlog(ewjr)
     172         end do
     173 !   ***   FINISH CALCULATION OF VIBRATIONAL PARTS   ***
