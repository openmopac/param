     393   subroutine Invert_Symmetric_Matrix( N, A, AI )
     394     implicit none
     395     integer, intent(in) :: N
     396     double precision, intent(in) :: A(N, N)
     397     double precision, intent(OUT) :: AI(N, N)
     398 !
     399 !  Local variables
     400 !
     401     integer :: INFO, i, j
     402     AI = A
     403     call dpotrf( "U", N, AI(1, 1), N, INFO )
     404     call dpotri( "U", N, AI(1, 1), N, INFO )
     405     do j=2, N
     406       do i=1, j-1
     407           AI(j, i) = AI(i, j)
     408       end do
     409     end do
     410   end subroutine Invert_Symmetric_Matrix
 
