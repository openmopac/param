    2418                   h(m) = h(m) + cored(7,n)*d_d(idd,1,1) + cored(9,n)*(d
 _d(idd,2,2)+&
    2419                     d_d(idd,3,3)) + cored(10,n)*(d_d(idd,4,4)+d_d(idd,5
 ,5))
    2420                 end if
    2421               end if
