     350       integer function hbpar(elem)
     351       integer :: elem
     352       if (elem == 7) hbpar  =  1
     353       if (elem == 8) hbpar  =  2
     354       if (elem == 9) hbpar  =  3
     355       if (elem == 15)hbpar  =  4
     356       if (elem == 16)hbpar  =  5
     357       if (elem == 17)hbpar  =  6
     358       end
 
