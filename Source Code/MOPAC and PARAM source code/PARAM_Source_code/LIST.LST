       1       subroutine bfn(x, bf)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use overlaps_C, only : fact
       6       implicit none
       7 !-----------------------------------------------
       8 !   D u m m y   A r g u m e n t s
       9 !-----------------------------------------------
      10       double precision , intent(in) :: x
      11       double precision , intent(out) :: bf(13)
      12 !-----------------------------------------------
      13 !   L o c a l   V a r i a b l e s
      14 !-----------------------------------------------
      15       integer :: k, io, last, i, m
      16       double precision :: absx, expx, expmx, y, xf
      17 !-----------------------------------------------
      18 !**********************************************************************
      19 !
      20 !     BINTGS FORMS THE "B" INTEGRALS FOR THE OVERLAP CALCULATION.
      21 !
      22 !**********************************************************************
      23       k = 12
      24       io = 0
      25       absx = abs(x)
      26       if (absx <= 3.D00) then
      27         if (absx > 2.D00) then
      28           last = 15
      29           go to 60
      30         end if
      31         if (absx > 1.D00) then
      32           last = 12
      33           go to 60
      34         end if
      35         if (absx > 0.5D00) then
      36           last = 7
      37           go to 60
      38         end if
      39         if (absx <= 1.D-6) go to 90
      40         last = 6
      41         go to 60
      42       end if
      43       expx = exp(x)
      44       expmx = 1.D00/expx
      45       bf(1) = (expx - expmx)/x
      46       do i = 1, k
      47         bf(i+1) = (i*bf(i)+(-1.D00)**i*expx-expmx)/x
      48       end do
      49       go to 110
      50    60 continue
      51       do i = io, k
      52         y = 0.0D00
      53         do m = io, last
      54           xf = 1.0D00
      55           if (m /= 0) xf = fact(m)
      56           y = y + (-x)**m*(2*mod(m + i + 1,2))/(xf*(m + i + 1))
      57         end do
      58         bf(i+1) = y
 
 FORCHECK PC V13.5.13           BFN            2021-03-24 10:59:30   page:   847
 bfn.F90  /FF
 
      59       end do
      60       go to 110
      61    90 continue
      62       do i = io, k
      63         bf(i+1) = (2*mod(i + 1,2))/(i + 1.D0)
      64       end do
      65   110 continue
      66       return
      67 !
      68       end subroutine bfn
 
