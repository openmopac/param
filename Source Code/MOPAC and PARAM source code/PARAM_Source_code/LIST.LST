    2499   !
    2500     subroutine projgr (n, l, u, nbd, x, g, sbgnrm)
    2501     !
    2502       implicit none
    2503       double precision, parameter :: zero = 0.0d0
    2504       integer, intent (in) :: n
    2505       double precision, intent (out) :: sbgnrm
    2506       integer, dimension (n), intent (in) :: nbd
    2507       double precision, dimension (n), intent (in) :: g, l, u, x
    2508       integer :: i
    2509       double precision :: gi
    2510       intrinsic Abs, Max, Min
    2511     !
    2512     !
    2513       sbgnrm = zero
    2514       do i = 1, n
    2515         gi = g(i)
    2516         if (nbd(i) /= 0) then
    2517           if (gi < zero) then
    2518             if (nbd(i) >= 2) then
    2519               gi = Max ((x(i)-u(i)), gi)
    2520             end if
    2521           else if (nbd(i) <= 2) then
    2522             gi = Min ((x(i)-l(i)), gi)
    2523           end if
    2524         end if
    2525         sbgnrm = Max (sbgnrm, Abs (gi))
    2526       end do
    2527     !
    2528     end subroutine projgr
 
