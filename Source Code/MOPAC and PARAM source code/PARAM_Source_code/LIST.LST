     176             go to 90
     177          end if
     178
     179          if (kb <= jb) then
     180             la = jb
     181             lh = kb
     182          else
     183            la = kb
     184            lh = jb
     185            rij = -rij
     186          end if
     187
     188 !         **** geometrical matrices ****
     189
     190           if (abs(rij) < 1.0D-4) then
     191             u1 = one
     192             u2 = one
     193             u3 = zero
     194           else
     195             u1 = (z(ja) - z(ka))/rij
     196             g = one - u1**2
     197             if (g  <=  1.D-7) then
     198               u2 = one
     199               if (u1 < zero) u2 = -one
     200               u3 = zero
     201             else
     202               g = one/dsqrt(g)
