       1       subroutine deri2(minear, f, fd, fci, ninear, nvar_nvo, dxyzr,  th
 rold, &
       2       diag, scalar, work)
       3       USE funcon_C, only : fpc_9
       4       USE meci_C, only : nelec, nstate, lab, nmeci, nmos, xy, &
       5       & vectci, maxci
       6       USE molkst_C, only : keywrd, mpack, numcal, norbs
       7       USE chanel_C, only : iw
       8       use derivs_C, only : b, ab, fb
       9       use common_arrays_C, only : c, w, eigs
      10       implicit none
      11       integer  :: minear
      12       integer  :: ninear
      13       integer  :: nvar_nvo
      14       double precision , intent(in) :: throld
      15       double precision  :: f(minear,nvar_nvo)
      16       double precision  :: fd(ninear,nvar_nvo)
      17       double precision  :: fci(ninear,nmeci*(nmeci + 1)*10/ninear)
      18       double precision  :: work(*)
      19       double precision , intent(inout) :: dxyzr(nvar_nvo)
      20       double precision  :: diag(mpack)
      21       double precision  :: scalar(mpack)
      22       double precision, allocatable  :: bab(:,:), babinv(:)
      23       double precision  :: bcoef(1000)
      24       integer :: icalcn, maxite, ifirst, i, nbsize, ilast, j, l, &
      25         nres, ivar, nadd, nbsze = 0, k, ll, iindex, jindex, limci, ib
      26       double precision :: const, time1, deter, test2 = 0.d0, test, time
 2, sum, gse
      27       logical , dimension(nvar_nvo) :: lconv
      28       logical :: fail, debug, lbab
      29       double precision, external :: ddot, seconds
      30       save debug, icalcn, maxite, ifirst, limci, ib, const
      31 !********************************************************************
      32 !
      33 !     DERI2 COMPUTE THE RELAXATION PART OF THE DERIVATIVES OF THE
      34 !     NON-VARIATIONALLY OPTIMIZED ENERGY WITH RESPECT TO TWO
      35 !     COORDINATES AT A TIME. THIS IS DONE IN THREE STEPS.
      36 !
      37 !     THE M.O DERIVATIVES ARE SOLUTION [X] OF A LINEAR SYSTEM
      38 !                        (D-A) * X = F
      39 !     WHERE D IS A DIAGONAL SUPER-MATRIX OF FOCK EIGENVALUE DIFFERENCES
      40 !     AND A IS A SUPER-MATRIX OF 2-ELECTRONS INTEGRALS IN M.O BASIS.
      41 !     SUCH A SYSTEM IS TOO LARGE TO BE INVERTED DIRECTLY THUS ONE MUST
      42 !     USES A RELAXATION METHOD TO GET A REASONABLE ESTIMATE OF [X].
      43 !     THIS REQUIRES A BASIS SET [B] TO BE GENERATED ITERATIVELY, AFTER
      44 !     WHICH WE SOLVE BY DIRECT INVERSION THE LINEAR SYSTEM PROJECTED
      45 !     IN THIS BASIS [B]. IT WORKS QUICKLY BUT DOES REQUIRE A LARGE
      46 !     CORE MEMORY.
      47 !
      48 !     USE A FORMALISM WITH FOCK OPERATOR THUS AVOIDING THE EXPLICIT
      49 !     COMPUTATION (AND STORAGE) OF THE SUPER-MATRIX A.
      50 !     THE SEMIEMPIRICAL METHODS DO NOT INVOLVE LARGE C.I CALCULATIONS.
      51 !     THEREFORE FOR EACH GRADIENT COMPONENT WE BUILD THE C.I MATRIX
      52 !     DERIVATIVE FROM THE M.O. INTEGRALS <IJ|KL> AND FOCK EIGENVALUES
      53 !     DERIVATIVES, THUS PROVIDING THE RELAXATION CONTRIBUTION TO THE
      54 !     GRADIENT WITHOUT COMPUTATION AND STORAGE OF THE 2ND ORDER DENSITY
      55 !     MATRIX.
      56 !
 
 FORCHECK PC V13.5.13          DERI2           2021-03-24 10:59:30   page:   834
 deri2.F90  /FF
 
      57 !   STEP 1)
      58 !     USE THE PREVIOUS B AND THE NEW F VECTORS TO BUILD AN INITIAL
      59 !     BASIS SET B.
      60 !   STEP 2)
      61 !     BECAUSE THE ELECTRONIC HESSIAN (D-A) IS THE SAME FOR EACH
      62 !     DERIVATIVE, WE ONLY NEED TO ENLARGE ITERATIVELY THE ORTHONORMAL
      63 !     BASIS SET [B] USED TO INVERT THE PROJECTED HESSIAN.
      64 !     (DERIVED FROM THE LARGEST RESIDUAL VECTOR ).
      65 !     THIS SECTION IS CARRIED OUT IN THE DIAGONAL METRIC 'SCALAR'.
      66 !   STEP 3) ... LOOP ON THE GEOMETRIC VARIABLE :
      67 ! 3.1 FOR EACH GEOMETRIC VARIABLE, GET THE M.O DERIVATIVES IN A.O.
      68 ! 3.2 COMPUTE THE FOCK EIGENVALUES AND 2-ELECTRON INTEGRAL RELAXATION.
      69 ! 3.3 BUILD THE ELECTRONIC RELAXATION CONTRIBUTION TO THE C.I MATRIX
      70 !     AND GET THE ASSOCIATED EIGENSTATE DERIVATIVE WITH RESPECT TO
      71 !     THE GEOMETRIC VARIABLE.
      72 !
      73 !   INPUT
      74 !     C(NORBS,NORBS) : M.O. COEFFICIENTS, IN COLUMN.
      75 !     eigs(NORBS)       : EIGENVALUES OF THE FOCK MATRIX.
      76 !     MINEAR         : NUMBER OF NON REDUNDANT ROTATION OF THE M.O.
      77 !     F(MINEAR,nvar_nvo) : NON-RELAXED FOCK MATRICES DERIVATIVES
      78 !                    IN M.O BASIS, OFF-DIAGONAL BLOCKS.
      79 !     FD(NINEAR,nvar_nvo): IDEM, DIAGONAL BLOCKS, C.I-ACTIVE ONLY.
      80 !     WORK           : WORK ARRAY OF SIZE N*N.
      81 !     B(MINEAR,NBSIZE) : INITIAL ORTHONORMALIZED BASIS SET [B].
      82 !     dxyzr(nvar_nvo)     : GRADIENT VECTOR BEFORE RELAXATION CORRECTIO
 N.
      83 !     AB(MINEAR,*): STORAGE FOR THE (D-A) * B VECTORS.
      84 !     FB(nvar_nvo,*)  : STORAGE FOR THE MATRIX PRODUCT F' * B.
      85 !   OUTPUT
      86 !     dxyzr   : DERIVATIVE OF THE HEAT OF FORMATION WITH RESPECT TO
      87 !              THE nvar_nvo OPTIMIZED VARIABLES.
      88 !
      89 !**********************************************************************
 *
      90       data icalcn/ 0/
      91       time1 = 0.d0
      92       time2 = 0.d0
      93       allocate (bab(70,70), babinv(4900))
      94       bab = 0.d0
      95 !
      96 !     * * * STEP 1 * * *
      97 !     BUILD UP THE INITIAL ORTHONORMALIZED BASIS.
      98 !
      99       if (icalcn /= numcal) then
     100         limci = nmos*norbs*20/ninear
     101         ib = max(lab,20)
     102         debug = index(keywrd,' DERI2') /= 0
     103         const = fpc_9
     104         icalcn = numcal
     105         i = max(20*minear, (lab*(lab + 1))/2, mpack)
     106         if (allocated(ab)) deallocate(ab)
     107         allocate(ab(minear, i*2/minear))
     108         ab = 0.d0
     109         maxite = min(min(60,int(sqrt(dble(nmeci**3)))),10000*2/nvar_nvo
 , i/minear)
     110         ifirst = min(nvar_nvo,1 + maxite/4)
     111         k = max((lab*(lab + 1))/2, 20*mpack)
     112         if (allocated(b))  deallocate(b)
 
 FORCHECK PC V13.5.13          DERI2           2021-03-24 10:59:30   page:   835
 deri2.F90  /FF
 
     113         if (allocated(fb)) deallocate(fb)
     114         i = max(k, (maxci*(maxci + 1))/2)
     115         allocate(b(minear,i/minear))
     116         i = max(ninear, i/minear)
     117         allocate(fb(1,i))
     118       end if
     119       fail = .FALSE.
     120       nbsize = 0
     121       if (debug) time1 = seconds(1)
     122 !
     123 !        NORMAL CASE. USE F ONLY.
     124 !
     125       call deri21 (f, nvar_nvo, minear, ifirst, work, work(nvar_nvo*nva
 r_nvo+1), b, ilast)
     126       lbab = .FALSE.
     127       ifirst = nbsize + 1
     128       ilast = nbsize + ilast
     129       lconv(:nvar_nvo) = .FALSE.
     130 !
     131 !     * * * STEP 2 * * *
     132 !     RELAXATION METHOD WITH OPTIMUM INCREASE OF THE BASIS SET.
     133 !     ---------------------------------------------------------
     134 !
     135 !     UPDATE AB ,FCI AND BAB. (BAB IS SYMMETRIC)
     136    30 continue
     137       if (ilast > limci .or. ilast > ib) then
     138         write (iw, &
     139              & "(' Derivatives cannot be evaluated using analytical met
 hods')")
     140         call mopend &
     141              & (" Derivatives cannot be evaluated using analytical meth
 ods")
     142         write (iw, &
     143          &"(' Use ""NOANCI"", however, this will slow down the calculat
 ion.')")
     144         write (iw, "(/10X,'FINAL GEOMETRY')")
     145         call geout (iw)
     146         goto 99
     147       end if
     148       do j = ifirst, ilast
     149         call deri22 (c, b(1,j), work, work, ab(1,j), minear, fci(1,j),
 w, diag, scalar, ninear)
     150         call mxm (ab(1,j), 1, b, minear, bab(1,j), ilast)
     151         bab(j,:ifirst-1) = bab(:ifirst-1,j)
     152       end do
     153 !     INVERT BAB, STORE IN BABINV.
     154    50 continue
     155       l = 0
     156       do j = 1, ilast
     157         babinv(l+1:ilast+l) = bab(:ilast,j)
     158         l = ilast + l
     159       end do
     160       call osinv (babinv, ilast, deter)
     161       if (Abs(deter) < 1.d-20) then
     162         if (ilast /= 1) write (iw, &
     163       '('' THE BAB MATRIX OF ORDER'',I3,'' IS SINGULAR IN DERI2''/ &
     164       & '' THE RELAXATION IS STOPPED AT THIS POINT.'')') ilast
     165         lbab = .TRUE.
     166         ilast = ilast - 1
 
 FORCHECK PC V13.5.13          DERI2           2021-03-24 10:59:30   page:   836
 deri2.F90  /FF
 
     167         go to 50
     168       end if
     169 !        UPDATE F * B'
     170       ! TODO: GBR future modifications
     171       if (.not.lbab) call mtxm (f, nvar_nvo, b(1,ifirst), minear, fb(1,
 ifirst), &
     172         ilast - ifirst + 1)
     173 !     NEW SOLUTIONS IN BASIS B , STORED IN BCOEF(nvar_nvo,*).
     174 !     BCOEF = BABINV * FB'
     175       if (ilast /= 0) call mxmt (babinv, ilast, fb, ilast, bcoef, nvar_
 nvo)
     176       if (lbab) go to 100
     177 !
     178 !     SELECT THE NEXT BASIS VECTOR AS THE LARGEST RESIDUAL VECTOR.
     179 !     AND TEST FOR CONVERGENCE ON THE LARGEST RESIDUE.
     180       nres = 0
     181       test2 = 0.D0
     182       do ivar = 1, nvar_nvo
     183         if (lconv(ivar)) cycle
     184 !     GET ONE NOT-CONVERGED RESIDUAL VECTOR (# IVAR),
     185 !     STORED IN WORK.
     186         call mxm (ab, minear, bcoef(ilast*(ivar-1)+1), ilast, work, 1)
     187         test = 0.D0
     188         do i = 1, minear
     189           work(i) = f(i,ivar) - work(i)
     190           test = max(abs(work(i)),test)
     191         end do
     192         if (debug) write (iw, *) ' TEST:', test
     193         test2 = max(test2,test)
     194         if (test <= throld) then
     195           lconv(ivar) = .TRUE.
     196           if (nvar_nvo == 1) go to 100
     197           cycle
     198         else if (ilast + nres == maxite) then
     199 !
     200 !   COMPLETELY OUT OF STORAGE
     201 !
     202           fail = nres == 0
     203           exit
     204         else if (ilast + nres >= maxite - 1) then
     205 !        RUNNING OUT OF STORAGE
     206           if (test <= max(0.01D0,throld*2)) then
     207             lconv(ivar) = .TRUE.
     208             cycle
     209           end if
     210         else
     211 !        STORE THE FOLLOWING RESIDUE IN AB(CONTINUED).
     212           nres = nres + 1
     213           call dcopy (minear, work, 1, ab(1,ilast+nres), 1)
     214         end if
     215       end do
     216       if (nres == 0) go to 100
     217 !     FIND OPTIMUM FOLLOWING SUBSET, ADD TO B AND LOOP.
     218       ifirst = ilast + 1
     219       call deri21 (ab(1,ifirst), nres, minear, nres, work, work(nres*nr
 es+1)&
     220         , b(1,ifirst), nadd)
     221       ilast = ilast + nadd
     222       go to 30
 
 FORCHECK PC V13.5.13          DERI2           2021-03-24 10:59:30   page:   837
 deri2.F90  /FF
 
     223 !
     224 !     CONVERGENCE ACHIEVED OR HALTED.
     225 !     -------------------------------
     226 !
     227   100 continue
     228       nbsze = nbsize
     229       if (debug .or. lbab) then
     230         write (iw, &
     231       '('' RELAXATION ENDED IN DERI2 AFTER'',I3,'' CYCLES''/'' REQUIRED
  CONVERGENCE&
     232       & THRESHOLD ON RESIDUALS =''    ,F12.9/'' HIGHEST RESIDUAL ON'',I
 3,&
     233       & '' GRADIENT COMPONENTS = ''    ,F12.9)') ilast - nbsze, &
     234           throld, nvar_nvo, test2
     235         if (ilast - nbsze == 0) then
     236           write (iw, '(A)') &
     237             ' ANALYTIC C.I. DERIVATIVES DO NOT WORK FOR THIS SYSTEM'
     238           write (iw, '(A)') ' ADD KEYWORD ''NOANCI'' AND RESUBMIT'
     239           call mopend (&
     240        'ANALYTIC C.I. DERIVATIVES DO NOT WORK FOR THIS SYSTEM.  ADD &
     241        & KEYWORD "NOANCI" AND RESUBMIT')
     242           goto 99
     243         end if
     244         if (debug) then
     245           time2 = seconds(1)
     246           write (iw, &
     247             '('' ELAPSED TIME IN RELAXATION'',F15.3,'' SECOND'')') time
 2 - time1
     248         end if
     249       end if
     250       if (fail) then
     251         write (iw, '(A)') ' ANALYTICAL DERIVATIVES TOO INACCURATE FOR T
 HIS'
     252         write (iw, '(A)') ' WORK.  JOB STOPPED HERE.  SEE MANUAL FOR ID
 EAS'
     253         call mopend (&
     254        'ANALYTICAL DERIVATIVES TOO INACCURATE FOR THIS WORK.  JOB STOPP
 ED HERE. &
     255        & SEE MANUAL FOR IDEAS')
     256         goto 99
     257       else
     258         nbsize = 0
     259 !        UNSCALED SOLUTION SUPERVECTORS, STORED IN F.
     260         if (ilast /= 0) call mxm (b, minear, bcoef, ilast, f, nvar_nvo)
     261         do j = 1, nvar_nvo
     262           f(:minear,j) = f(:minear,j)*scalar(:minear)
     263         end do
     264 !        FOCK MATRIX DIAGONAL BLOCKS OVER C.I-ACTIVE M.O.
     265 !        STORED IN FB.
     266         if (ilast /= 0) call mxm (fci, ninear, bcoef, ilast, fb, nvar_n
 vo)
     267       end if
     268 !
     269 !     * * * STEP 3 * * *
     270 !     FINAL LOOP (390) ON THE GEOMETRIC VARIABLES.
     271 !     --------------------------------------------
     272 !
     273       do ivar = 1, nvar_nvo
     274 !
 
 FORCHECK PC V13.5.13          DERI2           2021-03-24 10:59:30   page:   838
 deri2.F90  /FF
 
     275 !     C.I-ACTIVE M.O DERIVATIVES INTO THE M.O BASIS,
     276 !         RETURNED IN AB (N,NELEC+1,...,NELEC+NMOS).
     277 !     C.I-ACTIVE EIGENVALUES DERIVATIVES,
     278 !         RETURNED IN BCOEF(NELEC+1,...,NELEC+NMOS).
     279         call deri23 (f(1,ivar), fd(1,ivar), eigs, fb(ninear*(ivar-1)+1,
 1), ab, &
     280           bcoef, ninear, minear)
     281 !
     282 !     DERIVATIVES OF THE 2-ELECTRONS INTEGRALS OVER C.I-ACTIVE M.O.
     283 !     STORED IN /XYIJKL/.
     284       iindex = Mod (norbs*nelec+1, minear)
     285       jindex = (norbs*nelec+1) / minear + 1
     286       if (iindex == 0) then
     287         iindex = minear
     288         jindex = jindex - 1
     289       end if
     290         call dijkl2 (ab(iindex, jindex))
     291         if (debug) then
     292           write (iw, '('' * * * GRADIENT COMPONENT NUMBER'',I4)') ivar
     293           if (index(keywrd,'DEBU') /= 0) then
     294             write (iw, &
     295       '('' C.I-ACTIVE M.O. DERIVATIVES IN M.O BASIS'','', IN ROW.'')')
     296             l = norbs*nelec + 1
     297             do i = nelec + 1, nelec + nmos
     298               write (iw, '(8F10.4)') (ab(mod(k-1, minear) + 1, (k-1)/mi
 near + 1),k=l,l + norbs - 1)
     299               l = l + norbs
     300             end do
     301           end if
     302           write (iw, &
     303       '('' C.I-ACTIVE FOCK EIGENVALUES RELAXATION (eigs.V.)'')')
     304           write (iw, '(8F10.4)') (bcoef(i),i=nelec + 1,nelec + nmos)
     305           write (iw, '('' 2-ELECTRON INTEGRALS RELAXATION (eigs.V.)'',2
 / &
     306           &''    I    J    K    L       d<I(1)J(1)|K(2)L(2)> RELAXATION
  ONLY'')')
     307           do i = 1, nmos
     308             do j = 1, i
     309               do k = 1, i
     310                 ll = k
     311                 if (k == i) ll = j
     312                 do l = 1, ll
     313                   write (iw, '(4I5,F20.10)') nelec + i, nelec + j, nele
 c + k, &
     314                     nelec + l, xy(i,j,k,l)
     315                 end do
     316               end do
     317             end do
     318           end do
     319         end if
     320 !
     321 !     BUILD THE C.I MATRIX DERIVATIVE, STORED IN AB.
     322         call mecid (bcoef(1+nelec), gse, work(lab+1), work, xy)
     323         call mecih (work, ab, nmos, lab, xy)
     324 !     RELAXATION CORRECTION TO THE C.I ENERGY DERIVATIVE.
     325         sum = 0.D0
     326         if (gse > 1.d10) sum = -sum ! dummy use of gse
     327         do i = 1, nstate
     328           j = (i - 1)*lab + 1
 
 FORCHECK PC V13.5.13          DERI2           2021-03-24 10:59:30   page:   839
 deri2.F90  /FF
 
     329           call supdot (work, ab, vectci(j), lab)
     330           sum = sum + ddot(lab,vectci(j),1,work,1)
     331         end do
     332         dxyzr(ivar) = dxyzr(ivar) + sum*const/nstate
     333         if (.not.debug) cycle
     334         write (iw, &
     335           '('' RELAXATION OF THE GRADIENT COMPONENT'',F10.4, '' KCAL/MO
 LE'')') &
     336           ddot(lab,vectci,1,work,1)*const
     337 !
     338 !     THE END .
     339       end do
     340       if (debug) write (iw, &
     341       '('' ELAPSED TIME IN C.I-ENERGY RELAXATION'',F15.3,'' SECOND'')')
  seconds(1) - time2
     342   99  deallocate(bab, babinv)
     343       return
     344       end subroutine deri2
 
