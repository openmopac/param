    2381        !
    2382         if (iprint >= 0) then
    2383 10000     format (/, "           * * *",/,/, &
    2384          & "Tit   = total number of iterations",/, &
    2385          & "Tnf   = total number of function evaluations",/, &
    2386          & "Tnint = total number of segments explored during Cauchy sea
 rches",/, &
    2387          & "Skip  = number of BFGS updates skipped",/, &
    2388          & "Nact  = number of active bounds at final generalized Cauchy
  point",/, &
    2389          & "Projg = norm of the final projected gradient",/, &
    2390          & "F     = final function value",/,/, &
    2391          & "           * * *")
    2392           write (iw, 10000)
    2393 10010     format (/, 3 x, "N", 3 x, "Tit", 2 x, "Tnf", 2 x, "Tnint", 2
