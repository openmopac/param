     163             do l = 1, 3
     164               x(l) = xi(l) + tvec(l, 1) * i + tvec(l, 2) * j + tvec(l,
 3) &
     165              & * k - xj(l)
     166             end do
     167             rij = x(1) * x(1) + x(2) * x(2) + x(3) * x(3)
     168             if (rij >  cutof2) then
     169 !
     170 !  Interaction distance is greater than cutoff, so use point-charge
     171 !
     172               rij = sqrt(rij)
