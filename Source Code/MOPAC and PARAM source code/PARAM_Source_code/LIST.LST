      47       subroutine haddon(w, l, m, loc, a,  fact)
      48 !-----------------------------------------------
      49 !   M o d u l e s
      50 !-----------------------------------------------
      51       use chanel_C, only : iw
      52       use molkst_C, only : numcal
      53       use common_arrays_C, only : na
      54       use funcon_C, only : pi
      55 !-----------------------------------------------
      56 !   I n t e r f a c e   B l o c k s
      57 !-----------------------------------------------
      58       implicit none
      59 !-----------------------------------------------
      60 !   D u m m y   A r g u m e n t s
      61 !-----------------------------------------------
      62       integer , intent(out) :: l
      63       integer , intent(in) :: m
      64       integer , intent(in) :: loc
      65       double precision , intent(out) :: w
      66       double precision , intent(in) :: fact
      67       double precision , intent(in) :: a(3,*)
      68 !-----------------------------------------------
      69 !   L o c a l   V a r i a b l e s
      70 !-----------------------------------------------
      71       integer :: icalcn, i
      72       save icalcn
      73 !-----------------------------------------------
      74       data icalcn/ 0/
      75       if (numcal /= icalcn) then
      76         icalcn = numcal
      77       end if
      78      !*****************************************************************
 *****
      79     if (m > 19 .or. m < 1) then
      80       write (iw, "(///10X,'UNDEFINED SYMMETRY FUNCTION',I3, ' USED')")
 m
      81       call mopend ("UNDEFINED SYMMETRY FUNCTION USED")
      82     end if
      83     i = loc
      84     if (na(i) == 0) then
      85       select case (m)
      86       case (1)
      87          !
      88          !   Start of Cartesian relationships.
      89          !
      90          !                          X = X
      91         l = 1
      92         w = a(1, i)
      93         return
      94       case (2)
      95          !                          Y = Y
      96         l = 2
      97         w = a(2, i)
      98         return
      99       case (3)
     100          !                          Z = Z
     101         l = 3
     102         w = a(3, i)
 
 FORCHECK PC V13.5.13          HADDON          2021-03-24 10:59:30   page:  3495
 symtry.F90  /FF
 
     103         return
     104       case (4)
     105          !                          X = -X
     106         l = 1
     107         w = -a(1, i)
     108         return
     109       case (5)
     110          !                          Y = -Y
     111         l = 2
     112         w = -a(2, i)
     113         return
     114       case (6)
     115          !                          Z = -Z
     116         l = 3
     117         w = -a(3, i)
     118         return
     119       case (7)
     120          !                          X = Y
     121         l = 1
     122         w = a(2, i)
     123         return
     124       case (8)
     125          !                          Y = Z
     126         l = 2
     127         w = a(3, i)
     128         return
     129       case (9)
     130          !                          Z = X
     131         l = 3
     132         w = a(1, i)
     133         return
     134       case (10)
     135          !                          X = -Y
     136         l = 1
     137         w = -a(2, i)
     138         return
     139       case (11)
     140          !                          Y = -Z
     141         l = 2
     142         w = -a(3, i)
     143         return
     144       case (12)
     145          !                          Z = -X
     146         l = 3
     147         w = -a(1, i)
     148         return
     149       case (13)
     150          !                          X = Z
     151         l = 1
     152         w = a(3, i)
     153         return
     154       case (14)
     155          !                          Y = X
     156         l = 2
     157         w = a(1, i)
     158         return
     159       case (15)
     160          !                          Z = Y
     161         l = 3
 
 FORCHECK PC V13.5.13          HADDON          2021-03-24 10:59:30   page:  3496
 symtry.F90  /FF
 
     162         w = a(2, i)
     163         return
     164       case (16)
     165          !                          X = -Z
     166         l = 1
     167         w = -a(3, i)
     168         return
     169       case (17)
     170          !                          Y = -X
     171         l = 2
     172         w = -a(1, i)
     173         return
     174       case (18, 19)
     175          !                          Z = -Y
     176         l = 3
     177         w = -a(2, i)
     178         return
     179       case default
     180       end select
     181     else
     182       select case (m)
     183       case (2)
     184          !
     185          !  Set bond-angles equal
     186          !
     187         l = 2
     188         w = a(2, i)
     189         return
     190       case (3)
     191          !
     192          !  Set dihedrals equal
     193          !
     194         w = a(3, i)
     195       case (4)
     196         w = (pi/2.0d00) - a(3, i)
     197       case (5)
     198         w = (pi/2.0d00) + a(3, i)
     199       case (6)
     200         w = (2.0d00*pi/3.0d00) - a(3, i)
     201       case (7)
     202         w = (2.0d00*pi/3.0d00) + a(3, i)
     203       case (8)
     204         w = pi - a(3, i)
     205       case (9)
     206         w = pi + a(3, i)
     207       case (10)
     208         w = (4.0d00*pi/3.0d00) - a(3, i)
     209       case (11)
     210         w = (4.0d00*pi/3.0d00) + a(3, i)
     211       case (12)
     212         w = (3.0d00*pi/2.0d00) - a(3, i)
     213       case (13)
     214         w = (3.0d00*pi/2.0d00) + a(3, i)
     215       case (14)
     216         w = -a(3, i)
     217       case (15)
     218         l = 1
     219         w = a(1, i) / 2.0d00
     220         return
 
 FORCHECK PC V13.5.13          HADDON          2021-03-24 10:59:30   page:  3497
 symtry.F90  /FF
 
     221       case (16)
     222         l = 2
     223         w = a(2, i) / 2.0d00
     224         return
     225       case (17)
     226         l = 2
     227         w = pi - a(2, i)
     228         return
     229       case (18, 19)
     230         l = 1
     231         w = a(1, i) * fact
     232         return
     233       case default
     234         go to 1000
     235       end select
     236       l = 3
     237       return
     238     end if
     239    !
     240    !  Set bond-lengths equal
     241    !
     242 1000 l = 1
     243     w = a(1, i)
     244       end subroutine haddon
 
