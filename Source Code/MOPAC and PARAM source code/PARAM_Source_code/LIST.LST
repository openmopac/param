       1 subroutine eimp ()
       2 !
       3 !   Store in the s-s location of array p the value of the Fock terms re
 lating
       4 !   atom A and atom B, for all pairs of atoms.  This quantity will be u
 sed by
       5 !   the diagonalizer
       6 !
       7   use molkst_C, only: numat
       8   use common_arrays_C, only : p, f
       9   use MOZYME_C, only : iorbs
      10   implicit none
      11   integer :: i, j, k, l, m
      12   double precision :: sum
      13   integer, external :: ijbo
      14   do i = 1, numat
      15     do j = 1, i - 1
      16       k = ijbo (i, j)
      17       if (k >= 0) then
      18         l = iorbs(i) * iorbs(j)
      19         if (l /= 0) then
      20           l = k + l
      21           sum = 0.d0
      22           do m = k + 1, l
      23             sum = sum + f(m) ** 2
      24           end do
      25           p(k+1) = sum
      26         end if
      27       end if
      28     end do
      29   end do
      30 end subroutine eimp
 
