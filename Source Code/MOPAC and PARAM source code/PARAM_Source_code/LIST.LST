    2154 !
    2155 !
    2156   subroutine add_a_sp3_hydrogen_atom(icc, nb_icc, nc_icc, nd_icc, bond_
 length, metals, nmetals)
    2157     use molkst_C,  only : numat
    2158     use common_arrays_C,  only : coord, nbonds, ibonds, nat
    2159     implicit none
    2160     integer,  intent (in) :: icc, nmetals, metals(nmetals)
    2161     integer ::  nb_icc, nc_icc, nd_icc
    2162     double precision :: bond_length
    2163     double precision :: x, y, z, ax, ay, az, r1, r2, sum, angle, dihedr
 al
    2164     logical, external :: near_a_metal
    2165 !
    2166 !  Adding a hydrogen atom to a heavy atom.  The heavy atom is atom numb
 er "icc"
    2167 !  In this subroutine, a hydrogen atom is added to a single heavy atom.
    2168 !  Four atoms are needed: atom icc, which will have the hydrogen atom a
 ttached,
    2169 !  and atoms nb_icc, nc_icc, and nd_icc which are attached to icc.
    2170 !  These atoms form a triangle, this triangle is used in determining th
 e direction that the hydrogen
    2171 !  atom is pointed.
    2172 !
    2173     ax = coord(1, icc)
    2174     ay = coord(2, icc)
    2175     az = coord(3, icc)
    2176     x = (coord(1,nb_icc) + coord(1,nc_icc) + coord(1,nd_icc))/3.d0
    2177     y = (coord(2,nb_icc) + coord(2,nc_icc) + coord(2,nd_icc))/3.d0
    2178     z = (coord(3,nb_icc) + coord(3,nc_icc) + coord(3,nd_icc))/3.d0
    2179     r1 = sqrt((x-ax)**2+(y-ay)**2+(z-az)**2)
    2180     if (r1 < 0.4d0 .and. nat(icc) == 6 .or. r1 < 0.3d0) then
    2181 !
    2182 !  System is almost flat, so put hydrogen perpendicular to the plane
    2183 !
    2184       angle = 1.570796d0
    2185       dihedral = 1.57d0
    2186       call add_a_generic_hydrogen_atom(icc, nb_icc, nc_icc, bond_length
 , angle, dihedral, metals, nmetals)
    2187       r1 =         (coord(1,nb_icc) - coord(1,numat))**2 + &
    2188         (coord(2,nb_icc) - coord(2,numat))**2 + (coord(3,nb_icc) - coor
 d(3,numat))**2
    2189       r1 = min(r1, (coord(1,nc_icc) - coord(1,numat))**2 + &
    2190         (coord(2,nc_icc) - coord(2,numat))**2 + (coord(3,nc_icc) - coor
 d(3,numat))**2)
    2191       r1 = min(r1, (coord(1,nd_icc) - coord(1,numat))**2 + &
    2192         (coord(2,nd_icc) - coord(2,numat))**2 + (coord(3,nd_icc) - coor
 d(3,numat))**2)
    2193       nbonds(icc) = nbonds(icc) - 1
    2194       dihedral = -dihedral
    2195       call add_a_generic_hydrogen_atom(icc, nb_icc, nc_icc, bond_length
 , angle, dihedral, metals, nmetals)
    2196       r2 =         (coord(1,nb_icc) - coord(1,numat))**2 + &
    2197         (coord(2,nb_icc) - coord(2,numat))**2 + (coord(3,nb_icc) - coor
 d(3,numat))**2
    2198       r2 = min(r2, (coord(1,nc_icc) - coord(1,numat))**2 + &
    2199         (coord(2,nc_icc) - coord(2,numat))**2 + (coord(3,nc_icc) - coor
 d(3,numat))**2)
 
 FORCHECK PC V13.5.13 ADD_A_SP3_HYDROGEN_ATOM  2021-03-24 10:59:30   page:   770
 add_hydrogen_atoms.F90  /FF
 
    2200       r2 = min(r2, (coord(1,nd_icc) - coord(1,numat))**2 + &
    2201         (coord(2,nd_icc) - coord(2,numat))**2 + (coord(3,nd_icc) - coor
 d(3,numat))**2)
    2202       if (r2 > r1) coord(:,numat - 1) = coord(:,numat)
    2203       numat = numat - 1
    2204       return
    2205     end if
    2206     sum=bond_length/r1
    2207     numat = numat + 1
    2208     coord(1, numat) = ax + sum*(ax-x)
    2209     coord(2, numat) = ay + sum*(ay-y)
    2210     coord(3, numat) = az + sum*(az-z)
    2211     nbonds(icc) = nbonds(icc) + 1
    2212     nbonds(numat) = 1
    2213     nat(numat) = 1
    2214     ibonds(1,numat) = icc
    2215     ibonds(nbonds(icc),icc) = numat
    2216     if (near_a_metal(icc, numat, metals, nmetals)) numat = numat - 1
    2217   end subroutine add_a_sp3_hydrogen_atom
 
