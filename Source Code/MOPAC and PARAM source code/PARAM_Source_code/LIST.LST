       1 subroutine dgedi (a, lda, n, ipvt, det, work, job)
       2    !
       3    !.. Implicit Declarations ..
       4     implicit none
       5    !
       6    !.. Formal Arguments ..
       7     integer, intent (in) :: job, lda, n
       8     integer, dimension (n), intent (in) :: ipvt
       9     double precision, dimension (2), intent (out) :: det
      10     double precision, dimension (n), intent (out) :: work
      11     double precision, dimension (lda, n), intent (inout) :: a
      12    !
      13    !.. Local Scalars ..
      14     integer :: i, j, k, kb, kp1, l, nm1
      15     double precision :: t, ten
      16    !
      17    !.. External Calls ..
      18    !
      19    !.. Intrinsic Functions ..
      20     intrinsic Abs, Mod
      21    !
      22    ! ... Executable Statements ...
      23    !
      24    !     DGEDI COMPUTES THE DETERMINANT AND INVERSE OF A MATRIX
      25    !     USING THE FACTORS COMPUTED BY DGECO OR DGEFA.
      26    !
      27    !     ON ENTRY
      28    !
      29    !        A       DOUBLE PRECISION(LDA, N)
      30    !                THE OUTPUT FROM DGECO OR DGEFA.
      31    !
      32    !        LDA     INTEGER
      33    !                THE LEADING DIMENSION OF THE ARRAY  A .
      34    !
      35    !        N       INTEGER
      36    !                THE ORDER OF THE MATRIX  A .
      37    !
      38    !        IPVT    INTEGER(N)
      39    !                THE PIVOT VECTOR FROM DGECO OR DGEFA.
      40    !
      41    !        WORK    DOUBLE PRECISION(N)
      42    !                WORK VECTOR.  CONTENTS DESTROYED.
      43    !
      44    !        JOB     INTEGER
      45    !                = 11   BOTH DETERMINANT AND INVERSE.
      46    !                = 01   INVERSE ONLY.
      47    !                = 10   DETERMINANT ONLY.
      48    !
      49    !     ON RETURN
      50    !
      51    !        A       INVERSE OF ORIGINAL MATRIX IF REQUESTED.
      52    !                OTHERWISE UNCHANGED.
      53    !
      54    !        DET     DOUBLE PRECISION(2)
      55    !                DETERMINANT OF ORIGINAL MATRIX IF REQUESTED.
      56    !                OTHERWISE NOT REFERENCED.
      57    !                DETERMINANT = DET(1) * 10.0**DET(2)
      58    !                WITH  1.0 .LE. ABS(DET(1)) .LT. 10.0
 
 FORCHECK PC V13.5.13          DGEDI           2021-03-24 10:59:30   page:   370
 linpack.F90  /FF
 
      59    !                OR  DET(1) .EQ. 0.0 .
      60    !
      61    !     ERROR CONDITION
      62    !
      63    !        A DIVISION BY ZERO WILL OCCUR IF THE INPUT FACTOR CONTAINS
      64    !        A ZERO ON THE DIAGONAL AND THE INVERSE IS REQUESTED.
      65    !        IT WILL NOT OCCUR IF THE SUBROUTINES ARE CALLED CORRECTLY
      66    !        AND IF DGECO HAS SET RCOND .GT. 0.0 OR DGEFA HAS SET
      67    !        INFO .EQ. 0 .
      68    !
      69    !     LINPACK. THIS VERSION DATED 08/14/78 .
      70    !     CLEVE MOLER, UNIVERSITY OF NEW MEXICO, ARGONNE NATIONAL LAB.
      71    !
      72    !     SUBROUTINES AND FUNCTIONS
      73    !
      74    !     BLAS DAXPY,DSCAL,DSWAP
      75    !     FORTRAN ABS,MOD
      76    !
      77    !     COMPUTE DETERMINANT
      78    !
      79     if (job/10 /= 0) then
      80       det(1) = 1.0d0
      81       det(2) = 0.0d0
      82       ten = 10.0d0
      83       do i = 1, n
      84         if (ipvt(i) /= i) then
      85           det(1) = -det(1)
      86         end if
      87         det(1) = a(i, i) * det(1)
      88          !        ...EXIT
      89         if (det(1) == 0.0d0) exit
      90         do while (Abs (det( 1)) < 1.0d0)
      91           det(1) = ten * det(1)
      92           det(2) = det(2) - 1.0d0
      93         end do
      94         do while (Abs (det( 1)) >= ten)
      95           det(1) = det(1) / ten
      96           det(2) = det(2) + 1.0d0
      97         end do
      98       end do
      99     end if
     100    !
     101    !     COMPUTE INVERSE(U)
     102    !
     103     if (Mod(job, 10) == 0) return
     104     do k = 1, n
     105       a(k, k) = 1.0d0 / a(k, k)
     106       t = -a(k, k)
     107       call dscal (k-1, t, a(1, k), 1)
     108       kp1 = k + 1
     109       if (n >= kp1) then
     110         do j = kp1, n
     111           t = a(k, j)
     112           a(k, j) = 0.0d0
     113           call daxpy (k, t, a(1, k), 1, a(1, j), 1)
     114         end do
     115       end if
     116     end do
     117    !
 
 FORCHECK PC V13.5.13          DGEDI           2021-03-24 10:59:30   page:   371
 linpack.F90  /FF
 
     118    !        FORM INVERSE(U)*INVERSE(L)
     119    !
     120     nm1 = n - 1
     121     if (nm1 < 1) return
     122     do kb = 1, nm1
     123       k = n - kb
     124       kp1 = k + 1
     125       do i = kp1, n
     126         work(i) = a(i, k)
     127         a(i, k) = 0.0d0
     128       end do
     129       do j = kp1, n
     130         t = work(j)
     131         call daxpy (n, t, a(1, j), 1, a(1, k), 1)
     132       end do
     133       l = ipvt(k)
     134       if (l /= k) then
     135         call dswap (n, a(1, k), 1, a(1, l), 1)
     136       end if
     137     end do
     138 end subroutine dgedi
 
 FORCHECK PC V13.5.13          DGEDI           2021-03-24 10:59:30   page:   372
 linpack.F90  /FF


