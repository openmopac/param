     102   subroutine ncoord(natoms, rcov, nat, cn)
     103   implicit none
     104   integer nat(*),natoms, i, j
     105   double precision cn(*), rcov(94)
     106   double precision r, damp, xn, rr, rco
     107   double precision, external :: distance
     108   do i = 1, natoms
     109     xn = 0.0d0
     110     do j = 1, natoms
     111         if (j /= i) then
     112           r = distance(i, j)
     113 ! covalent distance in Bohr
     114           rco = rcov(nat(i)) + rcov(nat(j))
     115           rr = rco/r
     116 ! counting function exponential has a better long - range behavior than
  MHGs inverse damping
     117           damp = 1.d0/(1.d0 + exp( -16.d0*(rr - 1.0d0)))
     118           xn = xn + damp
     119         end if
     120     end do
     121     cn(i) = xn
     122   end do
     123   return
     124   end subroutine ncoord
 
