     653 !
     654 subroutine fz2n (f, ptot, iorbs, nat, ifact, q, qe, wj, wk, ptot2, mode
 , &
     655      & kopt, ione, coord)
     656     use molkst_C, only: numat, norbs, mpack, numcal, l_feather
     657     use MOZYME_C, only : nijbo, &
     658        & direct, semidr
     659     use parameters_C, only: am, dd, ad, tore
     660     use cosmo_C, only: useps
     661     use funcon_C, only: ev, a0
     662    ! use permanent_arrays, only: iatsp, ipiden, phinet, &
     663    !      & qdenet, qscnet, gden, qscat
     664
     665      use linear_cosmo, only: addfckz
     666
     667     implicit none
     668    !*******************************************************************
 ****
     669    !
     670    ! FOCK2 FORMS THE TWO-ELECTRON TWO-CENTER REPULSION PART OF THE FOCK
     671    ! MATRIX
     672    ! ON INPUT  PTOT = TOTAL DENSITY MATRIX.
     673    !           W    = TWO-ELECTRON INTEGRAL MATRIX.
     674    !
     675    !  ON OUTPUT F   = PARTIAL FOCK MATRIX
     676    !*******************************************************************
 ****
     677     integer, intent (in) :: ione, mode
     678     integer, dimension (numat), intent (in) :: iorbs, kopt, nat
     679     integer, dimension (norbs), intent (in) :: ifact
     680     double precision, dimension (numat), intent (inout) :: q, qe
     681     double precision, dimension (mpack), intent (in) :: ptot
     682     double precision, dimension (mpack), intent (inout) :: f
     683     double precision, dimension (*), intent (in) :: wj, wk
     684     double precision, dimension (3, numat), intent (in) :: coord
     685     double precision, dimension (numat, 81), intent (inout) :: ptot2
     686    !
     687    !.. Local Scalars ..
     688     logical :: calci, calcj
     689     integer, save :: icalcn = 0, krinc = 0
     690     integer :: i, i1, iab, ii, iim1, ij, ilim, ired, j, j1, jba, ji, jj
 , jk, &
     691    & jred, k, kj, kl, kr, l, li, lii, lij, lj, ljj, lk, m, ni, nj
     692     double precision :: sum, sumdia, sumoff, ade, aee, da, dx, dy, dz,
 r, r2, &
     693    & ri2, ri5, rm, rp, w1, w2, w3, w4, w5, w6, w7, enuc, rij, point, co
 nst
     694     integer, dimension (256), save :: jindex
     695     double precision, dimension (16) :: pja, pjb
     696     double precision, dimension (45) :: e1b, e2a
     697     double precision, dimension (171) :: fdummy = 0.d0
     698     double precision, dimension (2025) :: wjloc = 0.d0
     699    !
     700     dx = 0.d0
     701     dy = 0.d0
     702     dz = 0.d0
     703     r2 = 0.d0
     704     w2 = 0.d0
 
 FORCHECK PC V13.5.13           FZ2N           2021-03-24 10:59:30   page:  4256
 fock2z.F90  /FF
 
     705     w3 = 0.d0
     706     w4 = 0.d0
     707     w5 = 0.d0
     708     w6 = 0.d0
     709     w7 = 0.d0
     710     ni = 0
     711     nj = 0
     712    !
     713     if (icalcn /= numcal) then
     714       icalcn = numcal
     715       !
     716       !   SET UP GATHER-SCATTER TYPE ARRAYS FOR USE WITH TWO-ELECTRON
     717       !   INTEGRALS.  JINDEX ARE THE INDICES OF THE J-INTEGRALS FOR ATO
 M I
     718       !               JJNDEX ARE THE INDICES OF THE J-INTEGRALS FOR ATO
 M J
     719       !
     720       m = 0
     721       do i = 1, 4
     722         do j = 1, 4
     723           ij = Min (i, j)
     724           ji = i + j - ij
     725           do k = 1, 4
     726             do l = 1, 4
     727               m = m + 1
     728               kl = Min (k, l)
     729               lk = k + l - kl
     730               jindex(m) = (ifact(ji)+ij) * 10 + ifact(lk) + kl - 10
     731             end do
     732           end do
     733         end do
     734       end do
     735     end if
     736    !
     737    !  Put P(A,A) density into array PTOT2
     738    !
     739     call chrge_for_MOZYME (ptot, qe)
     740    !
     741    !   MODE=1:   ADD TO EXISTING FOCK MATRIX
     742    !   MODE=0:   CALCULATE FOCK MATRIX STARTING WITH H MATRIX
     743    !   MODE=-1:  REMOVE TERMS FROM FULL FOCK MATRIX.
     744    !
     745     if (mode ==-1) then
     746       f(1:mpack) = -f(1:mpack)
     747     end if
     748     l = 0
     749     do ii = 1, numat
     750       q(ii) = tore(nat(ii)) - qe(ii)
     751       i = nijbo (ii, ii)
     752       iab = iorbs(ii)
     753       m = 0
     754       do j = 1, iab
     755         do k = 1, iab
     756           m = m + 1
     757           jk = Min (j, k)
     758           kj = k + j - jk
     759           ptot2(ii, m) = ptot(i+ (kj*(kj-1))/2+jk)
