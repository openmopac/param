       1 subroutine output_cc_rep_fn
       2 !
       3 !  Output the core-core repulsion function in a form suitable for EXCEL
  plotting.
       4 !
       5   use Param_global_C, only : ifiles_8
       6   use funcon_C, only: a0, ev
       7   use parameters_C, only: tore, po
       8   implicit none
       9   integer :: i, j, ni, nj, pair
      10   double precision :: r, gab
      11   double precision, dimension (100,10) :: vab
      12   double precision, dimension (100) :: rab
      13   integer, parameter  :: np = 7
      14   integer, dimension (2,np) :: nij
      15   data nij /1,8,6,8,8,8,7,7,1,1,6,1,6,6/
      16   do pair = 1, np
      17     do i = 5,60
      18       r = 0.1d0 * i / a0
      19       ni = nij(1,pair)
      20       nj = nij(2,pair)
      21         gab = ev / Sqrt (r*r/(a0*a0)+ (po(9, ni)+po(9, nj))**2)
      22       call ccrep (ni, nj, r, vab(i,pair), gab)
      23
      24    !
      25    ! Multiply by core charges
      26       vab(i,pair) = 23.06*(vab(i,pair) - tore(ni) * tore(nj) * gab)
      27        rab(i) = r
      28     end do
      29   end do
      30   write(ifiles_8,"(a)")" Distance    O-H         C-O         O-O
   N-N         H-H         C-H         C-C"
      31   do i = 5, 60
      32     write(ifiles_8,"(f6.2,9f12.3)")rab(i),(vab(i,j), j=1,np)
      33   end do
      34 end subroutine output_cc_rep_fn
 
