     755 logical function arom (ii, jj, mpii)
     756     use common_arrays_C, only : nbonds, ibonds
     757     use molkst_C, only : numat
     758     implicit none
     759     integer, intent (in) :: ii, jj
     760     integer, dimension (numat), intent (in) :: mpii
     761 !
     762     integer :: i, iia, iib, j, j2, jja, jjb, jjc, ni, nj, njb
     763 !**********************************************************************
 *
     764 !
     765 !  AROM determines if the PI bond between II and JJ is part of an
     766 !       aromatic ring.  It does this by checking to see if two other pi
     767 !       bonds already exist in the ring.  If they do, then II and JJ
     768 !       form the third and final pi bond.
     769 !
     770 !**********************************************************************
 *
     771     ni = nbonds(ii)
     772     nj = nbonds(jj)
     773     do i = 1, ni
     774       iia = ibonds(i, ii)
     775       if (iia /= jj) then
     776         if (mpii(iia) /= 0) then
     777 !
     778 !  IIA is attached to II and forms a pi bond
     779 !  IIB is a pi-bonded atom attached to IIA
     780 !
     781           iib = mpii(iia)
     782           do j = 1, nj
     783             jja = ibonds(j, jj)
     784             if (jja /= ii) then
     785               if (mpii(jja) /= 0) then
     786 !
     787 !  JJA is attached to JJ and forms a pi bond
     788 !  JJB is a pi-bonded atom attached to JJA
     789 !
     790                 jjb = mpii(jja)
     791                 njb = nbonds(jjb)
     792                 do j2 = 1, njb
     793                   jjc = ibonds(j2, jjb)
     794 !
     795 ! Is any atom attached to JJB the same as IIB?
     796 !
     797                   if (jjc == iib) then
     798                     arom = .true.
     799                     return
     800                   end if
     801                 end do
     802               end if
     803             end if
     804           end do
     805         end if
     806       end if
     807     end do
     808     arom = .false.
     809 end function arom
 
