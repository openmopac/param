    1998    subroutine wstore (w, kr, ni, ilim)
    1999    !     *
    2000    !     COMPLETE DEFINITION OF SQUARE MATRIX OF MNDO TWO-ELECTRON
    2001    !     INTEGRALS BY INCLUDING THE ONE-CENTER TERMS AND THE TERMS
    2002    !     WITH TRANSPOSED INDICES.
    2003    !     *
    2004    !     *
    2005     use mndod_C, only: intij, intkl, intrep, repd
    2006     use parameters_C, only: gss, gsp, gpp, gp2, hsp, natorb
    2007    !
    2008    !.. Implicit Declarations ..
    2009     implicit none
    2010    !
    2011    !.. Formal Arguments ..
    2012     integer, intent (in) :: ilim
    2013     double precision, dimension (ilim, ilim), intent (out) :: w
    2014     integer, intent (inout) :: kr
    2015     integer, intent (in) :: ni
    2016    !
    2017    !.. Local Scalars ..
    2018     integer :: i, ij, ij0, Int, ip, ipx, ipy, ipz, j, kl
    2019    !
    2020    ! ... Executable Statements ...
    2021    !
    2022    ! *** INCLUDE NONZERO ONE-CENTER TERMS.
    2023     do i = 1, ilim
    2024       do j = 1, ilim
    2025         w(i, j) = 0.d0
    2026       end do
    2027     end do
    2028     ip = 1
    2029     w(ip, ip) = gss(ni)
    2030     if (natorb(ni) > 2) then
    2031       ipx = ip + 2
    2032       ipy = ip + 5
    2033       ipz = ip + 9
    2034       w(ipx, ip) = gsp(ni)
    2035       w(ipy, ip) = gsp(ni)
    2036       w(ipz, ip) = gsp(ni)
    2037       w(ip, ipx) = gsp(ni)
    2038       w(ip, ipy) = gsp(ni)
    2039       w(ip, ipz) = gsp(ni)
    2040       w(ipx, ipx) = gpp(ni)
    2041       w(ipy, ipy) = gpp(ni)
    2042       w(ipz, ipz) = gpp(ni)
    2043       w(ipy, ipx) = gp2(ni)
    2044       w(ipz, ipx) = gp2(ni)
    2045       w(ipz, ipy) = gp2(ni)
    2046       w(ipx, ipy) = gp2(ni)
    2047       w(ipx, ipz) = gp2(ni)
    2048       w(ipy, ipz) = gp2(ni)
    2049       w(ip+1, ip+1) = hsp(ni)
    2050       w(ip+3, ip+3) = hsp(ni)
    2051       w(ip+6, ip+6) = hsp(ni)
    2052       w(ip+4, ip+4) = 0.5d0*(gpp(ni)-gp2(ni))
    2053       w(ip+7, ip+7) = 0.5d0*(gpp(ni)-gp2(ni))
    2054       w(ip+8, ip+8) = 0.5d0*(gpp(ni)-gp2(ni))
    2055       if (ilim > 10) then
 
 FORCHECK PC V13.5.13          WSTORE          2021-03-24 10:59:30   page:  1496
 mndod.F90  /FF
 
    2056         ij0 = ip - 1
    2057         do i = 1, 243
    2058           ij = intij(i)
    2059           kl = intkl(i)
    2060           Int = intrep(i)
    2061           w(ij+ij0, kl+ij0) = repd(Int, ni)
    2062         end do
    2063       end if
    2064     end if
    2065     kr = kr + ilim ** 2
    2066 end subroutine wstore
 
