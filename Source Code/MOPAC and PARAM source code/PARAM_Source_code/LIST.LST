       1       subroutine hcore()
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE molkst_C, only : numcal, numat, norbs, id, l1u, l2u, l3u, &
       6       & keywrd, enuclr, n2elec, efield, mpack, line
       7       use common_arrays_C, only : nfirst, nlast, nat, uspd, &
       8       & coord, h, w, wk, tvec
       9       use cosmo_C, only : useps
      10       USE funcon_C, only : a0, ev, fpc_9
      11       USE parameters_C, only : tore, dd
      12       use MOZYME_C, only : cutofs
      13       use overlaps_C, only : cutof1, cutof2
      14       USE chanel_C, only : iw
      15
      16 !-----------------------------------------------
      17 !   I n t e r f a c e   B l o c k s
      18 !-----------------------------------------------
      19       implicit none
      20 !-----------------------------------------------
      21 !   L o c a l   V a r i a b l e s
      22 !-----------------------------------------------
      23       integer :: icalcn, ione
      24       integer :: i, j, k, kr, ia, ib, ni, i1, i2, j1, io1, jo1, im1, &
      25         ja, jb, nj, ii, jj, kro, q_at, link_at, mol_at
      26       double precision, dimension(45) :: e1b(45), e2a(45), di(9,9), wjd
 (2025), wkd(2025), xj(3), dibits(9,9)
      27       double precision, allocatable:: vqc(:)
      28       double precision ::  xf, yf, zf, const, fldcon, hterme, fnuc, hal
 f, enuc
      29       logical :: fldon, first, debug, lmolaris_qmmm, exists
      30       character :: tmpkey*241
      31       double precision, external :: reada
      32       save first, debug, icalcn, ione, vqc, lmolaris_qmmm
      33 !**********************************************************************
 *
      34 !
      35 !   HCORE GENERATES THE ONE-ELECTRON MATRIX AND TWO ELECTRON INTEGRALS
      36 !         FOR A GIVEN MOLECULE WHOSE GEOMETRY IS DEFINED IN CARTESIAN
      37 !         COORDINATES.
      38 !
      39 !  ON INPUT  COORD   = COORDINATES OF THE MOLECULE.
      40 !
      41 !  ON OUTPUT  H      = ONE-ELECTRON MATRIX.
      42 !             W      = TWO-ELECTRON INTEGRALS.
      43 !             ENUCLR = NUCLEAR ENERGY
      44 !**********************************************************************
 *
      45       data icalcn/ 0/
      46       fnuc = 0.d0
      47       fldcon = 0.d0
      48       first = icalcn /= numcal
      49       icalcn = numcal
      50       if (first) then
      51         ione = 1
      52         cutofs = 1.d4
      53         cutof2 = 1.D10
      54         cutof1 = 225.d0 ! (Cutoff distance)**2 for overlap integrals
 
 FORCHECK PC V13.5.13          HCORE           2021-03-24 10:59:30   page:  3652
 hcore.F90  /FF
 
      55         if (id /= 0) then
      56           if (allocated(wk)) deallocate (wk)
      57           allocate(wk(n2elec))
      58         end if
      59         if (id /= 0) ione = 0
      60         debug = (index(keywrd,'HCORE') /= 0)
      61         lmolaris_qmmm = (index(keywrd,'QMMM') /= 0)
      62         if (lmolaris_qmmm) then
      63 !
      64 !  Read in the energy in kcal/mol that an electron on each atom would h
 ave, arising from
      65 !  the partial charges on all atoms.
      66 !
      67           line="mol.in"
      68           call add_path(line)
      69           inquire (file=trim(line), exist = exists)
      70           if (.not. exists) then
      71              call mopend("A file named '"//trim(line)//"' was expected,
  but was not found.")
      72              return
      73           end if
      74           open(85, file=line, status='unknown', form='formatted')
      75           read(85, *, iostat = i)
      76           if (i /= 0) then
      77              call mopend("A file named '"//trim(line)//"' exists, but i
 s empty.")
      78              return
      79           end if
      80           read(85, *, iostat = i)q_at, link_at
      81           if (i /= 0) then
      82              call mopend("A file named '"//trim(line)//"' exists, but i
 s corrupt.")
      83              return
      84           end if
      85           mol_at = q_at + link_at
      86           if(mol_at /= numat) then
      87             write(line,'(a,i5,a,i5,a)') &
      88               " The number of atoms in 'mol.in':",mol_at," and in the M
 OPAC data set:",numat," are different."
      89             call mopend(trim(line))
      90             write(iw,'(10x,a)')" Correct fault and resubmit."
      91             return
      92           end if
      93           if (allocated(vqc)) deallocate(vqc)
      94           allocate(vqc(numat))
      95           do i = 1, numat
      96             read(85,*)line,line,line,line,vqc(i)
      97             if (debug) write(iw,'(a, i4, a, f9.3)')"ATOM No.",i," VQC(I
 )",vqc(i)
      98           end do
      99           close(85)
     100         end if
     101         xf = 0.D0
     102         yf = 0.D0
     103         zf = 0.D0
     104         tmpkey = trim(keywrd)
     105         i = index(tmpkey,' FIELD(') + index(tmpkey,' FIELD=(')
     106         if (i /= 0) then
     107 !
 
 FORCHECK PC V13.5.13          HCORE           2021-03-24 10:59:30   page:  3653
 hcore.F90  /FF
 
     108 !   ERASE ALL TEXT FROM TMPKEY EXCEPT FIELD DATA
     109 !
     110           tmpkey(:i) = ' '
     111           tmpkey(index(tmpkey,')'):) = ' '
     112 !
     113 !   READ IN THE EFFECTIVE FIELD IN X,Y,Z COORDINATES
     114 !
     115           xf = reada(tmpkey,i)
     116           i = index(tmpkey,',')
     117           if (i /= 0) then
     118             tmpkey(i:i) = ' '
     119             yf = reada(tmpkey,i)
     120             i = index(tmpkey,',')
     121             if (i /= 0) then
     122               tmpkey(i:i) = ' '
     123               zf = reada(tmpkey,i)
     124             end if
     125           end if
     126           write (iw, '(/10X,''THE ELECTRIC FIELD IS'',3F10.5,'' VOLTS/A
 NGSTROM'',/)') xf, yf, zf
     127         end if
     128         const = a0/ev
     129 !
     130         efield(1) = xf*const
     131         efield(2) = yf*const
     132         efield(3) = zf*const
     133       end if
     134       fldon = .FALSE.
     135       if (efield(1) /= 0.0D00 .or. efield(2) /= 0.0D00 .or. efield(3) /
 = 0.0D00) then
     136 !
     137 !   FLDCON = h/Ao
     138 !
     139         fldcon = ev/a0
     140         fldon = .TRUE.
     141       end if
     142       enuclr = 0.d0
     143       h(:mpack) = 0.d0
     144       kr = 1
     145       do i = 1, numat
     146         ia = nfirst(i)
     147         ib = nlast(i)
     148         ni = nat(i)
     149 !
     150 ! FIRST WE FILL THE DIAGONALS, AND OFF-DIAGONALS ON THE SAME ATOM
     151 !
     152         if (.not.fldon) then
     153           do i1 = ia, ib
     154             i2 = i1*(i1 - 1)/2 + ia - 1
     155             if (i1 - ia + 1 > 0) then
     156               h(i2+1:i1-ia+1+i2) = 0.D0
     157               i2 = i1 - ia + 1 + i2
     158             end if
     159             h(i2) = uspd(i1)
     160             if(lmolaris_qmmm) then
     161               if (debug) write(iw,'(''OLD 1e MATRIX ELEMENT '',i5,f12.5
 ,'' i'',i5,&
     162             & '' vqc(i)'',f12.5)')i2,h(i2),i,-vqc(i)/fpc_9
     163               h(i2) = h(i2) - vqc(i)/fpc_9
 
 FORCHECK PC V13.5.13          HCORE           2021-03-24 10:59:30   page:  3654
 hcore.F90  /FF
 
     164               if (debug) write(iw,'(''UPD 1e MATRIX ELEMENT '',i5,f12.5
 )')i2,h(i2)
     165             end if
     166             cycle
     167           end do
     168         else
     169           do i1 = ia, ib
     170             i2 = i1*(i1 - 1)/2 + ia - 1
     171             do j1 = ia, i1
     172               i2 = i2 + 1
     173               h(i2) = 0.D0
     174               io1 = i1 - ia
     175               jo1 = j1 - ia
     176               if (jo1==0 .and. io1==1) then
     177                 hterme = -a0*dd(ni)*efield(1)*fldcon
     178                 h(i2) = hterme
     179               end if
     180               if (jo1==0 .and. io1==2) then
     181                 hterme = -a0*dd(ni)*efield(2)*fldcon
     182                 h(i2) = hterme
     183               end if
     184               if (jo1/=0 .or. io1/=3) cycle
     185               hterme = -a0*dd(ni)*efield(3)*fldcon
     186               h(i2) = hterme
     187             end do
     188             h(i2) = uspd(i1)
     189             fnuc = -(efield(1)*coord(1,i) + efield(2)*coord(2,i) + efie
 ld(3)*coord(3,i))*fldcon
     190             h(i2) = h(i2) + fnuc
     191           end do
     192         end if
     193         if (fldon) enuclr = enuclr - fnuc*tore(nat(i))
     194         if (lmolaris_qmmm) enuclr = enuclr + vqc(i)/fpc_9*tore(nat(i))
     195 !
     196 !   FILL THE ATOM-OTHER ATOM ONE-ELECTRON MATRIX<PSI(LAMBDA)|PSI(SIGMA)
 >
     197 !
     198         im1 = i - ione
     199         do j = 1, im1
     200           half = 1.D0
     201           if (i == j) half = 0.5D0
     202           ja = nfirst(j)
     203           jb = nlast(j)
     204           nj = nat(j)
     205           if (id == 0) then
     206             call h1elec (ni, nj, coord(1,i), coord(1,j), di)
     207           else
     208             di = 0.D0
     209             do ii = -l1u, l1u
     210               do jj = -l2u, l2u
     211                 do k = -l3u, l3u
     212                   xj = coord(:,j) + tvec(:,1)*ii + tvec(:,2)*jj + tvec(
 :,3)*k
     213                   call h1elec (ni, nj, coord(1,i), xj, dibits)
     214                   di = di + dibits
     215                 end do
     216               end do
     217             end do
     218           end if
 
