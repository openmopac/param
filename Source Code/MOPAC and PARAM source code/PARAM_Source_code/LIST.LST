     153       m = na + m - 1
     154       !
     155 10000 format (/,/,13x,10(1x,a2,1x,a2,i3,2x))
     156       write (iw, 10000) (itext(i), jtext(i), natom(i), i=na, m)
     157 10010 format (" ", 21 a6)
