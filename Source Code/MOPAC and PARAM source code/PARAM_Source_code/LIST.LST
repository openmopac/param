     762       subroutine sscal(n, da, dx, incx)
     763       implicit none
     764 !-----------------------------------------------
     765 !   D u m m y   A r g u m e n t s
     766 !-----------------------------------------------
     767       integer , intent(in) :: n
     768       integer , intent(in) :: incx
     769       real , intent(in) :: da
     770       real , intent(inout) :: dx(1)
     771 !-----------------------------------------------
     772 !   L o c a l   V a r i a b l e s
     773 !-----------------------------------------------
     774       integer :: m, mp1, nincx
     775 !-----------------------------------------------
     776 !
     777 !     SCALES A VECTOR BY A CONSTANT.
     778 !     USES UNROLLED LOOPS FOR INCREMENT EQUAL TO ONE.
     779 !     JACK DONGARRA, LINPACK, 3/11/78.
     780 !
     781 !
     782       if (n <= 0) return
     783       if (incx /= 1) then
     784 !
     785 !        CODE FOR INCREMENT NOT EQUAL TO 1
     786 !
     787         nincx = n*incx
     788         dx(:nincx:incx) = da*dx(:nincx:incx)
     789         return
     790       end if
     791 !
     792 !        CODE FOR INCREMENT EQUAL TO 1
     793 !
     794 !
     795 !        CLEAN-UP LOOP
     796 !
     797       m = mod(n,5)
     798       if (m /= 0) then
     799         dx(:m) = da*dx(:m)
     800         if (n < 5) return
     801       end if
     802       mp1 = m + 1
     803       dx(mp1:((n-mp1+5)/5)*5-1+mp1) = da*dx(mp1:((n-mp1+5)/5)*5-1+mp1)
     804       return
     805       end subroutine sscal
 
