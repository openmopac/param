     211                 cycle atom_loop
     212   1012        call add_Lewis_element(i,0,-1, n_lone_pairs)    ! Lone pa
 ir
     213                 cycle atom_loop
     214       !
     215       !     If there is a nearby atom of Group VI, make the atom an ani
 on
     216       !
     217     99          do m = 1, nbonds(i)
     218                   mm = ibonds(m, i)
     219                      !
     220                      !   IS ANY ATOM ATTACHED TO THE ATOM OF GROUP 5?
     221                      !
     222                   if (Nint(tore(nat(mm))) == 6) go to 1011
     223                   do j = 1, nbonds(mm)
     224                     jj = ibonds(j, mm)
     225                         !
     226                         !   IS ANY ATOM ATTACHED TO ANY ATOM ATTACHED
     227                         !   TO THE ATOM OF GROUP 6?
     228                         !
     229                     if (Nint(tore(nat(jj))) == 6) go to 1011
     230                   end do
     231                 end do
 
 FORCHECK PC V13.5.13          CHKION          2021-03-24 10:59:30   page:  4081
 chkion.F90  /FF
 
     232                 cycle atom_loop
     233   1011          call add_Lewis_element(i,0, -1, n_lone_pairs)   ! Lone
 pair
     234                 cycle atom_loop
     235               end if
     236             else
     237   !
     238   !  To get here, there are no obvious indications of the charge on
     239   !  carbon, so postpone assigning the charge until after all other
     240   !  charges are known.
     241   !
     242               call add_Lewis_element(-i,0, 0, dummy) ! Anion or cation
 - decide later
     243               cycle atom_loop
     244             end if
     245           else  !  Atom is not a carbon - use generic rules
     246             if (loop == 1) then
     247 !
     248 !  Adjust oxidation state to match that expected.
     249 !
     250               ni = nat(i)
     251               do
     252                 if (atom_charge(i) == " ") then
     253                   if (Abs(ox_calc(i)) > Abs(ox_ref_spd1(ni))) then
     254                     jj = ox_ref_spd2(ni) - ox_calc(i)
     255                   else if (Abs(ox_calc(i)) > Abs(ox_ref_sp(ni))) then
     256                     jj = ox_ref_spd1(ni) - ox_calc(i)
     257                   else if (nbonds(i) > 0) then
     258                     jj = ox_ref_sp(ni) - ox_calc(i)
     259                   else
     260                     jj = ox_ref(ni) - ox_calc(i)
     261                   end if
     262                 else if (atom_charge(i) == "+") then
     263                   jj = 1
     264                 else if (atom_charge(i) == "-") then
     265                   jj = -1
     266                 else if (atom_charge(i) == "0") then
     267                   jj = 0
     268                 end if
     269 !
     270 !  jj is the presumed charge on the atom.
     271 !  "presumed" = difference between calculated oxidation state and defau
 lt oxidation state,
     272 !               or charge specified by the user.
     273 !
     274                 if (jj == 0) exit
     275                 if (jj >= 2 .and. nat(i) == 7) then
     276                   jj = -2 ! Azide
     277                 end if
     278                 if (ib(i) == 0) exit
     279                   if (jj > 1) then
     280                   call add_Lewis_element(0,i,2, dummy)  ! di-cation
     281                   ox_calc(i) = ox_calc(i) + 2
     282                  else if (jj == 1) then
     283                   call add_Lewis_element(0,i,1, dummy)  ! Cation
     284                    ox_calc(i) = ox_calc(i) + 1
     285                  else if (jj == -1) then
     286                   call add_Lewis_element(i,0,-1, n_lone_pairs) ! Anion
     287                   ox_calc(i) = ox_calc(i) - 1
 
