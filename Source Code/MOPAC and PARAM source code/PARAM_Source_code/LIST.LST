    2012   subroutine delete_ref_key(beginning, length_beginning, ending, length
 _ending)
    2013 !
    2014 ! Delete keyword from refkey so that it will not appear in an ARC file
    2015 !
    2016 !   beginning :        Start of keyword to be deleted (MUST be uppercas
 e)
    2017 !   length_beginning : Length of string in "beginning"
    2018 !   ending :           End of keyword (MUST be uppercase)
    2019 !   length_ending :    Length of string "ending"
    2020 !
    2021   use molkst_C, only : refkey, line
    2022   implicit none
    2023   integer, intent (in) :: length_beginning, length_ending
    2024   character, intent (in) :: beginning*(length_beginning), ending*(lengt
 h_ending)
    2025   integer :: i, j, k
    2026   logical :: in_text
    2027   do
    2028     k = 0
    2029     do i = 1, 6
    2030       line = " "//trim(refkey(i))
    2031       call upcase(line, len_trim(line))
    2032       k = index(line," "//beginning)
    2033       if (k /= 0) exit
    2034     end do
    2035     if (k == 0) exit
    2036 !
    2037 !  Search from the start of the keyword (k) to find the end of the keyw
 ord (j)
    2038 !
    2039     j = index(refkey(i)(k + length_beginning:), ending) + k + length_be
 ginning
    2040 !
    2041 !  Search for the first non-blank character (j) after the keyword, if i
 t exists.
    2042 !
    2043     do j = j, len_trim(refkey(i))
    2044       if (refkey(i)(j:j) /= " ") exit
    2045     end do
    2046 !
    2047 !  Search for the first non-blank character (k) before the keyword, if
 it exists.
    2048 !
    2049     do k = k - 1, 1, -1
    2050       if (refkey(i)(k:k) /= " ") exit
    2051     end do
    2052 !
    2053 ! Eliminate the keyword
    2054 !
    2055     refkey(i) = refkey(i)(:k)//" "//refkey(i)(j:)
    2056 !
    2057 ! Cycle, in case there is more than one instance of the keyword.
    2058 !
    2059   end do
    2060 !
    2061 !  Compress keywords, if possible.
    2062 !  This involves deleting " + " and " & ", if present and the resulting
 
 FORCHECK PC V13.5.13      DELETE_REF_KEY      2021-03-24 10:59:30   page:  3943
 readmo.F90  /FF
 
  line is not too long,
    2063 !  and removing excess spaces between keywords
    2064 !
    2065   if (index(refkey(1), " + ") + index(refkey(1), " & ") > 0) then
    2066     if (index(refkey(2), " + ") + index(refkey(2), " & ") > 0) then
    2067       i = len_trim(refkey(3))
    2068       j = len_trim(refkey(2))
    2069       if (j < 120) then
    2070         k = index(refkey(2), " + ") + index(refkey(2), " & ") + 1
    2071         refkey(2)(k:k) = " "
    2072         refkey(2) = refkey(2)(:j)//refkey(3)(:i)
    2073         refkey(3) = "    NULL"
    2074       end if
    2075     end if
    2076     i = len_trim(refkey(2))
    2077     j = len_trim(refkey(1))
    2078     if (j < 60) then
    2079       k = index(refkey(1), " + ") + index(refkey(1), " & ") + 1
    2080       refkey(1)(k:k) = " "
    2081       refkey(1) = refkey(1)(:j)//refkey(2)(:i)
    2082       if (index(refkey(2), " + ") + index(refkey(2), " & ") > 0) then
    2083         refkey(2) = trim(refkey(3))
    2084         refkey(3) = "    NULL"
    2085       else
    2086         refkey(2) = "    NULL"
    2087       end if
    2088     end if
    2089 !
    2090 ! First line of keywords MUST be printed
    2091 !
    2092     i = index(refkey(1), " NULL")
    2093     if (i /= 0) refkey(1) = refkey(1)(:i)//refkey(1)(i + 5:)
    2094     do i = 1, 3
    2095       in_text = .false.
    2096       k = 1
    2097       do j = 2, len_trim(refkey(i))
    2098         if (refkey(i)(j:j) == '"') in_text = (.not. in_text)
    2099         if (in_text .or. refkey(i)(j-1:j) /= "  ") then
    2100           k = k + 1
    2101           refkey(i)(k:k) = refkey(i)(j:j)
    2102         end if
    2103       end do
    2104       refkey(i)(k + 1:) = " "
    2105     end do
    2106   end if
    2107   do i = 1, 3
    2108     if (len_trim(refkey(i)) > 0) then
    2109       do
    2110         if (refkey(i)(1:1) /= " ") refkey(i) = " "//trim(refkey(i))
    2111         if (refkey(i)(1:2) == "  ") refkey(i) = trim(refkey(i)(2:))
    2112         if (refkey(i)(2:2) /= " ") exit
    2113       end do
    2114     end if
    2115   end do
    2116   return
    2117   end subroutine delete_ref_key
 
