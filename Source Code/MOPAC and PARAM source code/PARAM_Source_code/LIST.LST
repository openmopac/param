     783 !     *****************************************************************
 ********
     784
     785       subroutine efmods (beta, zcore, dm)
     786       use reimers_c, only : n, na, nb2, matind, ibf, vnn, ef
     787
     788       implicit none
     789       double precision ::   dm(nb2, 3), zcore(na), beta(nb2), ecoref
     790       integer ::            i, mu, nm, nu
     791
     792
     793 !     **** Electric field effect on core energies and 1 el operators **
 **
     794 !     **** using the definition: Energy = -F * sum RiQi ****
     795 !     **** U(i) = -beta(i, i) = -electron_charge * (- F.r) = -F.r ****
     796 !     **** beta(i, j) = electron_charge * (- F<s|x|px>) ****
     797
     798 !     **** mods to one - electron integrals ****
     799       nm = 0
     800       do mu = 1, n
     801         do nu = 1, mu
     802           nm = nm + 1
     803           beta(nm) = beta(nm) - (ef(1)*dm(nm, 1) + ef(2)*dm(nm, 2) + &
     804      &                          ef(3)*dm(nm, 3) )
     805         end do
     806       end do
     807
     808 !     **** nuclear interaction ****
     809       ecoref = 0.d0
     810       do i = 1, na
     811         mu = ibf(i)
     812         nm = matind(mu) + mu
     813         ecoref = ecoref + zcore(i) * (ef(1)*dm(nm, 1) + ef(2)*dm(nm, 2)
  + &
     814      &                               ef(3)*dm(nm, 3))
     815       end do
     816       vnn = vnn + ecoref
     817       return
     818       end subroutine efmods
 
