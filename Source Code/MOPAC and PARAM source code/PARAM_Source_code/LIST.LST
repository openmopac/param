    2394                   (idd,3,3)) + cored(10,n)*(d_d(idd,4,4)+d_d(idd,5,5))
    2395               end if
    2396             end if
    2397 !
    2398           end do
    2399         else
    2400           if (ind1 < 4) then
    2401             do j = k, i
    2402               ind2 = j - k
    2403               m = (i*(i - 1))/2 + j
    2404               if (ind2 == 0) then
    2405 ! -- (SP/)
    2406                 h(m) = h(m) + sp(1,ind1)*cored(2,n)
    2407 ! -- (SD/)
    2408               else
    2409                 if (ind2 < 4) then
    2410 ! -- (PP/)
    2411                   ipp = indpp(ind1,ind2)
    2412                   h(m) = h(m) + cored(3,n)*pp(ipp,1,1) + cored(4,n)*(pp
 (ipp,2,2)+&
    2413                     pp(ipp,3,3))
    2414 ! -- (PD/)
    2415                 else
    2416 ! -- (d_d/)
