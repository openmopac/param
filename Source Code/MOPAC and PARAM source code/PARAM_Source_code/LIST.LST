      44       character*8       param
      45       integer           i, j, k
      46       double precision  ediel
      47       logical*1, external :: permca
      48       param = " "
      49       if (param == "xxxxxxxx") return
      50       ecore = 0.d0
      51
      52 !     **** determine n! ****
      53       n = norbs
      54       nb2 = n*(n + 1)/2
      55       icisym(1) = nconf
      56       emaxci = 1.d6
      57
      58       nfact(0) = 1
      59       do i = 1, 10
      60         nfact(i) = nfact(i - 1) * i
      61       end do
      62
      63       maxunp = multci
      64       if (dbls) maxunp = maxunp + 1
      65       if (mrci) maxunp = maxunp + min(noh - nolc + 1, nvhc - nvl + 1)
      66       mspn = nfact(maxunp*2) / nfact(maxunp)**2
      67
      68 !     **** determine basis - vector type of each MO ****
      69 !     **** if type j = s, px, py, etc is present, then nbtmo bit j is s
 et to 1 ****
      70       if(.not.allocated(nbtmo)) allocate(nbtmo(n))
      71       do i = 1, n
      72         do j = 0, 8
      73           ifbinc(j) = 0
      74         end do
      75         do k = 1, n
      76           if (abs(cc0(i, k)) > 1.d-5) ifbinc(nbt(k)) = 1
      77         end do
      78         nbtmo(i) = 0
      79         do j = 8, 0, - 1
      80           nbtmo(i) = nbtmo(i)*2 + ifbinc(j)
      81         end do
      82       end do
      83 !     **** apply symmetry weights to MO coeffs ****
      84
      85       if (allocated(stwt))  deallocate(stwt)
      86       if (allocated(isc))   deallocate(isc)
      87       if (allocated(istr))  deallocate(istr)
      88       if (allocated(nsym))  deallocate(nsym)
      89       allocate(stwt(n))
      90       allocate(isc(n))
      91       allocate(istr(8, n))
      92       allocate(nsym(n))
      93
      94 !     ************** debug: use this to turn off symmetry info ********
 ***
