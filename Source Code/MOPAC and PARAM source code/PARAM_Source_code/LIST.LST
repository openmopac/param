    1095 subroutine mfinel (ips, k, finel, nar_csm, nsetf, nset, rsc, nipsrs, di
 rvec, tm, &
    1096 & x, r, nfl, ioldcv, maxrs, lenabc, numat)
    1097    !  THIS ROUTINE GENERATES THE LIST OF ALL BASIC GRID POINTS AND
    1098    !  RING - SEGMENTS BELONGING TO SEGMENT IPS
    1099     implicit none
    1100     integer, intent (in) :: ioldcv, ips, k, lenabc, maxrs, numat
    1101     integer, intent (out) :: nfl
    1102     double precision, intent (in) :: r
    1103     integer, dimension (1082*numat), intent (in) :: nset
    1104     integer, dimension (lenabc), intent (in) :: nar_csm, nipsrs, nsetf
    1105     double precision, dimension (3), intent (in) :: x
    1106     double precision, dimension (3, 3), intent (in) :: tm
    1107     double precision, dimension (4, 1082), intent (in) :: dirvec
    1108     double precision, dimension (4, maxrs), intent (in) :: rsc
    1109     double precision, dimension (4, 500, 2), intent (out) :: finel
    1110     integer :: idir, irs, irs0, irs1, ix, l, nari
    1111     double precision, dimension (3) :: y
    1112    !
    1113    ! FIRST THE TRANSFORMED BASIC GRID POINTS
    1114     nfl = 0
    1115     nari = nar_csm(ips)
    1116     do l = nsetf(ips), nsetf(ips) + nari - 1
    1117       idir = nset(l)
    1118       nfl = nfl + 1
    1119       do ix = 1, 3
    1120         y(ix) = dirvec(ix, idir) * r
    1121       end do
    1122       finel(1, nfl, k) = y(1) * tm(1, 1) + y(2) * tm(2, 1) + y(3) * tm
 &
    1123      & (3, 1) + x(1)
    1124       finel(2, nfl, k) = y(1) * tm(1, 2) + y(2) * tm(2, 2) + y(3) * tm
 &
    1125      & (3, 2) + x(2)
    1126       finel(3, nfl, k) = y(1) * tm(1, 3) + y(2) * tm(2, 3) + y(3) * tm
 &
    1127      & (3, 3) + x(3)
    1128       finel(4, nfl, k) = dirvec(4, idir) * r * r
    1129     end do
    1130     if (ioldcv == 1) return
    1131    ! NOW THE ASSOCIATED RINGSEGMENTS
    1132     irs0 = 1
    1133     if (ips > 1) then
    1134       irs0 = nipsrs(ips - 1) + 1
    1135     end if
    1136     irs1 = nipsrs(ips)
    1137     do irs = irs0, irs1
    1138       nfl = nfl + 1
    1139       do ix = 1, 4
    1140         finel(ix, nfl, k) = rsc (ix, irs)
    1141       end do
    1142     end do
    1143 end subroutine mfinel
 
