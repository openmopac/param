    2018   !
    2019     subroutine hpsolb (n, t, iorder, iheap)
    2020       implicit none
    2021       integer, intent (in) :: n
    2022       double precision, dimension (n), intent (inout) :: t
    2023       integer, dimension (n), intent (inout) :: iorder
    2024       integer, intent (in) :: iheap
    2025       integer :: i, indxin, indxou, j, k
    2026       double precision :: ddum, out
    2027     !
    2028       if (iheap == 0) then
    2029        !
    2030        !        Rearrange the elements t(1) to t(n) to form a heap.
    2031        !
    2032         do k = 2, n
    2033           ddum = t(k)
    2034           indxin = iorder(k)
    2035           !
    2036           !           Add ddum to the heap.
    2037           i = k
    2038           do while (i >  1)
    2039             j = i / 2
    2040             if (ddum < t(j)) then
    2041               t(i) = t(j)
    2042               iorder(i) = iorder(j)
    2043               i = j
    2044             else
    2045               exit
    2046             end if
    2047           end do
    2048           t(i) = ddum
    2049           iorder(i) = indxin
    2050         end do
    2051       end if
    2052     !     Assign to 'out' the value of t(1), the least member of the he
 ap,
    2053     !        and rearrange the remaining members to form a heap as
    2054     !        elements 1 to n-1 of t.
    2055       if (n <= 1) return
    2056     !
    2057       i = 1
    2058       out = t(1)
    2059       indxou = iorder(1)
    2060       ddum = t(n)
    2061       indxin = iorder(n)
    2062       do
    2063        !
    2064        !        Restore the heap
    2065         j = i + i
    2066         if (j > n-1) exit
    2067         if (t(j+1) < t(j)) then
    2068           j = j + 1
    2069         end if
    2070         if (t(j) < ddum) then
    2071           t(i) = t(j)
 
 FORCHECK PC V13.5.13          HPSOLB          2021-03-24 10:59:30   page:  2945
 lbfgs.F90  /FF
 
    2072           iorder(i) = iorder(j)
    2073           i = j
    2074         else
    2075           exit
    2076         end if
    2077       end do
    2078       t(i) = ddum
    2079       iorder(i) = indxin
    2080     !     Put the least member in t(n).
    2081     !
    2082       t(n) = out
    2083       iorder(n) = indxou
    2084     !
    2085     end subroutine hpsolb
 
