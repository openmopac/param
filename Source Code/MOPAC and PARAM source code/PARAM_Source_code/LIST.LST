     699       implicit none
     700 !-----------------------------------------------
     701 !   G l o b a l   P a r a m e t e r s
     702 !-----------------------------------------------
     703 !-----------------------------------------------
     704 !   D u m m y   A r g u m e n t s
     705 !-----------------------------------------------
     706       logical, intent(out) :: cubic
     707       double precision  :: coord(3,numat)
