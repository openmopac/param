    1339   subroutine afmm_ini
    1340     !
    1341     !.. Implicit Declarations ..
    1342     implicit none
    1343
    1344     !
    1345     !.. Local Scalars ..
    1346     integer :: i, j
    1347     double precision :: t
    1348     !
    1349     !.. Intrinsic Functions ..
    1350     intrinsic Sqrt
    1351     !
    1352     ! ... Executable Statements ...
    1353
    1354     ! --- factorials
    1355
    1356     t = 1.d0
    1357     fact(0) = t
    1358     fact(1) = t
    1359
    1360     do i = 2, 2*p
    1361       t = t * i
    1362       fact(i) = t
    1363     end do
    1364
    1365     ! --- Spherical harmonics norm
    1366
    1367     y_norm(0, 0) = 1.d0
    1368     do i = 1, p
    1369       do j = 0, i
    1370         t = Sqrt (fact(i-j) / fact(i+j))
    1371         y_norm(j, i) = t
    1372         y_norm(-j, i) = t
    1373       end do
    1374     end do
    1375
    1376     ! --- amn
    1377
    1378     t = 1.d0
    1379     amn(0, 0) = 1.d0
    1380     do i = 1, p
    1381       t = -t
    1382       do j = -i, i
    1383         amn(j, i) = t / Sqrt (fact(i-j) * fact(i+j))
    1384       end do
    1385     end do
    1386
    1387   end subroutine afmm_ini
 
