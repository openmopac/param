     126   subroutine get_dC6_dCNij(maxc ,max_elem, c6ab, mxci, mxcj,  &
     127     cni, cnj, izi, izj, c6check, dc6i, dc6j)
     128     implicit none
     129     integer, intent (in) :: maxc ,max_elem, mxci, mxcj
     130     double precision, intent (in) :: c6ab(max_elem,max_elem,maxc,maxc,3
 ), cni, cnj
     131     integer :: izi, izj, a, b
     132     double precision :: dc6i, dc6j, c6check, term
     133     double precision :: zaehler, nenner, dzaehler_i, dnenner_i, dzaehle
 r_j, dnenner_j
     134     double precision :: expterm, cn_refi, cn_refj, c6ref, r
     135     double precision :: c6mem, r_save
     136     c6mem =  -1.d99
     137     r_save = 9999.d0
     138     zaehler = 0.0d0
     139     nenner = 0.0d0
     140     dzaehler_i = 0.d0
     141     dnenner_i = 0.d0
     142     dzaehler_j = 0.d0
     143     dnenner_j = 0.d0
     144     do a = 1,mxci
     145       do b = 1,mxcj
     146         c6ref = c6ab(izi, izj, a, b, 1)
     147         if (c6ref > 0.d0) then
     148           cn_refi = c6ab(izi, izj, a, b, 2)
     149           cn_refj = c6ab(izi, izj, a, b, 3)
     150           r = (cn_refi - cni)*(cn_refi - cni) + (cn_refj - cnj)*(cn_ref
 j - cnj)
     151           if (r < r_save) then
     152             r_save = r
     153             c6mem = c6ref
     154           end if
     155           expterm = exp(-4.d0*r)
     156           zaehler = zaehler + c6ref*expterm
     157           nenner = nenner + expterm
     158           expterm = -4.d0*expterm*2.d0
     159           term = expterm*(cni - cn_refi)
     160           dzaehler_i = dzaehler_i + c6ref*term
     161           dnenner_i  = dnenner_i + term
     162           term = expterm*(cnj - cn_refj)
     163           dzaehler_j = dzaehler_j + c6ref*term
     164           dnenner_j  = dnenner_j +      term
     165         end if
     166       end do
     167     end do
     168
     169     if (nenner > 1.0d-99) then
     170       c6check = zaehler/nenner
     171       dc6i = ((dzaehler_i*nenner) - (dnenner_i*zaehler))/(nenner*nenner
 )
     172       dc6j = ((dzaehler_j*nenner) - (dnenner_j*zaehler))/(nenner*nenner
 )
     173     else
     174       c6check = c6mem
     175       dc6i = 0.0d0
     176       dc6j = 0.0d0
     177     end if
     178 end subroutine get_dC6_dCNij
 
