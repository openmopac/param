     221 !
     222 !       G2OLD = X + 1.0*DELTA
     223 !       GROLD = X + 0.5*DELTA
     224 !       GRAD  = X - 0.5*DELTA
     225 !       G2RAD = X - 1.0*DELTA
     226 !
     227             dumy(:lu-ll+1) = (8.D0*(grold(:lu-ll+1)-grad(:lu-ll+1)) - &
     228               (g2old(:lu-ll+1)-g2rad(:lu-ll+1)))/delta*fact/12.D0
     229             eigs(:lu-ll+1) = (2.D0*(grold(:lu-ll+1)-grad(:lu-ll+1)) - &
     230               (g2old(:lu-ll+1)-g2rad(:lu-ll+1)))/delta**3*fact/28.D0
     231 !
     232 !  CORRECT FOR 4'TH ORDER CONTAMINATION
     233 !
     234             fmatrx(ll:lu) = fmatrx(ll:lu) + dumy(:lu-ll+1)
     235             l = lu - ll + 1
     236           end if
     237           l = l - 1
     238           do k = i, nvar
     239             l = l + 1
     240             kk = (k*(k - 1))/2 + i
     241             dumy(l) = (8.D0*(grold(l)-grad(l))-(g2old(l)-g2rad(l)))/del
 ta*fact/12.D0
     242             eigs(l) = (2.D0*(grold(l)-grad(l))-(g2old(l)-g2rad(l)))/del
 ta**3*fact/28.D0
     243 !
     244 !  CORRECT FOR 4'TH ORDER CONTAMINATION
