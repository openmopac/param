     401   subroutine check_CVS(let)
     402   use molkst_C, only: numat, keywrd, line, numcal, moperr, nscf, maxtxt
     403   use common_arrays_C, only: txtatm, nat, coord, &
     404       nbonds, ibonds
     405   use elemts_C, only: elemnt
     406   use mod_atomradii, only: radius, is_metal
     407   use chanel_C, only: iw
     408   implicit none
     409   logical, intent (in) :: let
     410   integer :: i, j, k, l, n, m, ii, ncvb, icalcn = -1, ik, cvb_atoms(60)
     411   logical :: lbond, error, PDB_input, OO_first = .true., made, first =
 .true.
     412   double precision :: r
     413   double precision, external :: reada
     414   double precision, allocatable :: store_coord(:,:)
     415   double precision, external :: distance
     416   character :: num*1, store*2000
     417   save :: store_coord, OO_first, first
     418   error = .false.
     419   PDB_input = .false.
     420 !
     421 ! Most of the time, LET should be false, the commonest exceptions being
  0SCF and RESEQ
     422 !
     423     if (allocated (store_coord) .and. icalcn /= numcal) then
     424       deallocate (store_coord)
     425       icalcn = numcal
     426     end if
     427     if (.not. allocated (store_coord)) then
     428       i = size(coord)/3
     429       allocate (store_coord(3,i))
     430       store_coord = coord
     431     end if
     432 !
     433 !  Parse CVB(2:3,45:65)
     434 !
     435      store = keywrd
     436      i = index(keywrd, " CVB")
     437      if (i > 0) then
     438        j = index(keywrd(i:), ") ") + i
     439        line = keywrd(i + 1: j - 1)
     440        ii = len_trim(line)
     441 !
     442 !    If everything is in quotation marks, use the CVB keyword
     443 !
     444        k = 0
     445        do
     446          k = k + 1
     447          if (k >= ii) exit
     448          if (line(k:k) == '"') then
     449            do
     450              k = k + 1
     451              if (line(k:k) == '"') exit
     452            end do
     453          end if
     454          if (line(k:k) >= "0" .and. line(k:k) <= "9") exit
     455        end do
     456        PDB_input = (k > ii - 3)
 
 FORCHECK PC V13.5.13        CHECK_CVS         2021-03-24 10:59:30   page:  3772
 lewis.F90  /FF
 
     457     end if
     458     i = Index (keywrd, " CVB")
     459     k = 0
     460     if (i /= 0) then
     461       k = Index (keywrd(i:), ")") + i
     462       if (keywrd(k:k) /= " ") then
     463         write(iw,"(//10x,a)")" There must be a space after the closing
 parenthesis of the CVB keyword"
     464         do
     465           k = k + 1
     466           if (keywrd(k:k) == " ") exit
     467         end do
     468         write(iw,'(/10x,a)')" CVB keyword: """//keywrd(i + 1:k-1)//'"'
     469         if (index(keywrd, " 0SCF") /= 0) return
     470         call mopend ("ERROR IN CVB KEYWORD")
     471         return
     472       end if
     473     end if
