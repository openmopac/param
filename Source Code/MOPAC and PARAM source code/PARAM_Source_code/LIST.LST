    1664   !
    1665     subroutine errclb (n, m, factr, l, u, nbd, task, info, k)
    1666       implicit none
    1667       double precision, parameter :: zero = 0.0d0
    1668       character (len=60), intent (inout) :: task
    1669       integer, intent (in) :: m, n
    1670       integer, intent (inout) :: info
    1671       integer, intent (out) :: k
    1672       double precision, intent (in) :: factr
    1673       integer, dimension (n), intent (in) :: nbd
    1674       double precision, dimension (n), intent (in) :: l, u
    1675       integer :: i
    1676     !
    1677     !     Check the input arguments for errors.
    1678     !
    1679       if (n <= 0) then
    1680         task = "ERROR: N .LE. 0"
    1681       end if
    1682       if (m <= 0) then
    1683         task = "ERROR: M .LE. 0"
    1684       end if
    1685       if (factr < zero) then
    1686         task = "ERROR: FACTR .LT. 0"
    1687       end if
    1688     !
    1689     !     Check the validity of the arrays nbd(i), u(i), and l(i).
    1690     !
    1691       do i = 1, n
    1692         if (nbd(i) < 0 .or. nbd(i) > 3) then
    1693           !                                                   return
    1694           task = "ERROR: INVALID NBD"
    1695           info = -6
    1696           k = i
    1697         end if
    1698         if (nbd(i) == 2) then
    1699           if (l(i) > u(i)) then
    1700              !                                    return
    1701             task = "ERROR: NO FEASIBLE SOLUTION"
    1702             info = -7
    1703             k = i
    1704           end if
    1705         end if
    1706       end do
    1707     !
    1708     end subroutine errclb
 
