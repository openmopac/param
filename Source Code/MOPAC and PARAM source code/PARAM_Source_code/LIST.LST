     586 !
     587       subroutine genvec(u, n)
     588 !-----------------------------------------------
     589 !   M o d u l e s
     590 !-----------------------------------------------
     591 !*******************************************************************
     592 !  GENERATE UNIT VECTORS OVER SPHERE. FOR CONNOLLY SURFACE ONLY
     593 !*******************************************************************
     594       implicit none
     595 !-----------------------------------------------
     596 !   D u m m y   A r g u m e n t s
     597 !-----------------------------------------------
     598       integer , intent(inout) :: n
     599       double precision , intent(out) :: u(3,n)
     600 !-----------------------------------------------
     601 !   L o c a l   V a r i a b l e s
     602 !-----------------------------------------------
     603       integer :: nequat, nvert, nu, i, nhor, j
     604       double precision :: pi, fi, z, xy, fj, x, y
     605 !-----------------------------------------------
     606       pi = 4.D0*atan(1.D0)
     607       nequat = int(sqrt(n*pi))
     608       nvert = nequat/2
     609       nu = 0
     610       l20: do i = 1, nvert + 1
     611         fi = (pi*(i - 1))/nvert
     612         z = cos(fi)
     613         xy = sin(fi)
     614         nhor = int(nequat*xy)
     615         nhor = max0(1,nhor)
     616         do j = 1, nhor
     617           fj = (2.D0*pi*(j - 1))/nhor
     618           x = dcos(fj)*xy
     619           y = dsin(fj)*xy
     620           if (nu >= n) exit  l20
     621           nu = nu + 1
     622           u(1,nu) = x
     623           u(2,nu) = y
     624           u(3,nu) = z
     625         end do
     626       end do l20
     627       n = nu
     628       return
     629       end subroutine genvec
 
