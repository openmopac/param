       1 subroutine filusp (nat, nfirst, nlast, uspd)
       2     use molkst_C, only :  norbs, numat
       3     use parameters_C, only : uss, upp, udd
       4   !
       5   !.. Implicit Declarations ..
       6     implicit none
       7   !
       8   !.. Formal Arguments ..
       9     integer, dimension (numat), intent (in) :: nat, nfirst, nlast
      10     double precision, dimension (norbs), intent (out) :: uspd
      11   !
      12   !.. Local Scalars ..
      13     integer :: i, ia, ib, j, ni_loc
      14   !
      15   ! ... Executable Statements ...
      16   !
      17     do i = 1, numat
      18       ni_loc = nat(i)
      19       ia = nfirst(i)
      20       ib = nlast(i)
      21       if (ia <= ib) then
      22       !
      23       !  Atom has an "s" orbital.
      24       !
      25         uspd(ia) = uss(ni_loc)
      26         if (ia /= ib) then
      27         !
      28         !  Atom has a "p" shell.
      29         !
      30           do j = ia + 1, ia + 3
      31             uspd(j) = upp(ni_loc)
      32           end do
      33         !
      34         !  Set the "d" shell, if present.
      35         !
      36           do j = ia + 4, ib
      37             uspd(j) = udd(ni_loc)
      38           end do
      39         end if
      40       end if
      41     end do
      42 end subroutine filusp
 
