     178 !
     179 ! *** COMPUTE INTEGRALS IN DIATOMIC FRAME
     180 !
     181               call reppd (ni, nj, rij, ri, gab)
     182             end if
     183 !
     184               a = 1.d0 / rij
     185               x(1) = x(1) * a
     186               x(2) = x(2) * a
     187               x(3) = x(3) * a
     188               if (Abs (x(3)) > 0.99999999d0) x(3) = Sign (1.d0, x(3))
     189               wb(1) = ri(1)
     190               e1b(1) = e1b(1) - wb(1) * tore(nj)
     191               e2a(1) = e2a(1) - wb(1) * tore(ni)
     192               if (sj) then
     193                 wb(2) = -ri(5) * x(1)
     194                 wb(3) = -ri(5) * x(2)
     195                 wb(4) = -ri(5) * x(3)
     196                 e2a(2) = e2a(2) - wb(2) * tore(ni)
     197                 e2a(3) = e2a(3) - wb(1) * tore(ni)
     198                 e2a(4) = e2a(4) - wb(3) * tore(ni)
     199                 e2a(6) = e2a(6) - wb(1) * tore(ni)
     200                 e2a(7) = e2a(7) - wb(4) * tore(ni)
     201                 e2a(10) = e2a(10) - wb(1) * tore(ni)
     202               end if
     203 !
     204               if (si) then
     205                 if (sj) then
     206                   wb(5) = -ri(2) * x(1)
     207                   wb(6) = -ri(2) * x(2)
     208                   wb(7) = -ri(2) * x(3)
     209                   e1b(2) = e1b(2) - wb(5) * tore(nj)
     210                   e1b(3) = e1b(3) - wb(1) * tore(nj)
     211                   e1b(4) = e1b(4) - wb(6) * tore(nj)
     212                   e1b(6) = e1b(6) - wb(1) * tore(nj)
     213                   e1b(7) = e1b(7) - wb(7) * tore(nj)
     214                   e1b(10) = e1b(10) - wb(1) * tore(nj)
     215                 else
     216                   wb(2) = -ri(2) * x(1)
     217                   wb(3) = -ri(2) * x(2)
     218                   wb(4) = -ri(2) * x(3)
     219                   e1b(2) = e1b(2) - wb(2) * tore(nj)
     220                   e1b(3) = e1b(3) - wb(1) * tore(nj)
     221                   e1b(4) = e1b(4) - wb(3) * tore(nj)
     222                   e1b(6) = e1b(6) - wb(1) * tore(nj)
     223                   e1b(7) = e1b(7) - wb(4) * tore(nj)
     224                   e1b(10) = e1b(10) - wb(1) * tore(nj)
     225               end if
     226             end if
     227             do l = 1, ki
     228               w(l) = w(l) + wb(l)
     229             end do
     230           end do
     231         end do
     232       end do
     233       enuc = tore(ni) * tore(nj) * w(1)
 
 FORCHECK PC V13.5.13          OUTER2          2021-03-24 10:59:30   page:  3523
 outer2.F90  /FF
 
     234     end if
     235 !
     236     if ( .not. direct) then
     237       if (natorb(ni)*natorb(nj) == 0) then
     238         ki = 0
     239       end if
     240       kr = kr + ki
     241     end if
     242 end subroutine outer2
 
