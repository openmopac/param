     150       double precision function poij (l, d, fg)
     151 !-----------------------------------------------
     152 !   M o d u l e s
     153 !-----------------------------------------------
     154       use funcon_C, only : ev
     155 !     *
     156 !     DETERMINE ADDITIVE TERMS RHO=POIJ FOR TWO-CENTER TWO-ELECTRON
     157 !     INTEGRALS FROM THE REQUIREMENT THAT THE APPROPRIATE ONE-CENTER
     158 !     TWO-ELECTRON INTEGRALS ARE REPRODUCED.
     159 !     *
     160       implicit none
     161 !-----------------------------------------------
     162 !   D u m m y   A r g u m e n t s
     163 !-----------------------------------------------
     164       integer , intent(in) :: l
     165       double precision , intent(in) :: d
     166       double precision , intent(in) :: fg
     167 !-----------------------------------------------
     168 !   L o c a l   P a r a m e t e r s
     169 !-----------------------------------------------
     170       double precision, parameter :: epsil = 1.0D-08
     171       double precision, parameter :: g1 = 0.382D0
     172       double precision, parameter :: g2 = 0.618D0
     173       integer, parameter :: niter = 100
     174 !-----------------------------------------------
     175 !   L o c a l   V a r i a b l e s
     176 !-----------------------------------------------
     177       integer :: i
     178       double precision :: dsq, ev4, ev8, a1, a2, delta, y1, y2, f1, f2
     179 !-----------------------------------------------
     180       f1 = 0.d0
     181       f2 = 0.d0
     182       if (l == 0) then
     183         poij = 0.5d0*ev/fg
     184         return
     185       end if
     186 ! *** HIGHER TERMS.
     187       dsq = d*d
     188       ev4 = ev*0.25d0
     189       ev8 = ev/8.0D0
     190       a1 = 0.1D0
     191       a2 = 5.0D0
     192       if (l == 1) then
     193         do i = 1, niter
     194           delta = a2 - a1
     195           if (delta < epsil) exit
     196           y1 = a1 + delta*g1
     197           y2 = a1 + delta*g2
     198           f1 = (ev4*(1.d0/y1 - 1.d0/sqrt(y1**2 + dsq)) - fg)**2
     199           f2 = (ev4*(1.d0/y2 - 1.d0/sqrt(y2**2 + dsq)) - fg)**2
     200           if (f1 < f2) then
     201             a2 = y2
     202           else
     203             a1 = y1
     204           end if
     205         end do
     206       else
     207         if (l == 2) then
 
 FORCHECK PC V13.5.13           POIJ           2021-03-24 10:59:30   page:  1433
 mndod.F90  /FF
 
     208           do i = 1, niter
     209             delta = a2 - a1
     210             if (delta < epsil) exit
     211             y1 = a1 + delta*g1
     212             y2 = a1 + delta*g2
     213             f1 = (ev8*(1.d0/y1 - 2.d0/sqrt(y1**2 + dsq*0.5d0) + 1.d0/sq
 rt(y1**2 + &
     214               dsq)) - fg)**2
     215             f2 = (ev8*(1.d0/y2 - 2.d0/sqrt(y2**2 + dsq*0.5d0) + 1.d0/sq
 rt(y2**2 + &
     216               dsq)) - fg)**2
     217             if (f1 < f2) then
     218               a2 = y2
     219             else
     220               a1 = y1
     221             end if
     222           end do
     223         end if
     224       end if
     225 !     DEFINE ADDITIVE TERM AFTER CONVERGENCE OF ITERATIONS.
     226       if (f1 >= f2) then
     227         poij = a2
     228       else
     229         poij = a1
     230       end if
     231       return
     232       end function poij
 
