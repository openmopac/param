      79               istep = 2
      80             else if (istep <  10) then
      81               istep = 5
      82             else if (istep <  20) then
      83               istep = 10
      84             else if (istep <  50) then
      85               istep = 20
      86             else if (istep < 100) then
      87               istep = 50
      88             else
      89               istep = 100
      90             end if
      91           case (2)
      92 !
      93 !  Starting, step-size, and ending temperatures provided
