       1 subroutine buildf (f, partf, mode)
       2     use molkst_C, only: numat, mpack, id
       3     use common_arrays_C, only : w, h, wk
       4     implicit none
       5     integer, intent (in) :: mode
       6     double precision, dimension (mpack), intent (in) :: partf
       7     double precision, dimension (mpack), intent (inout) :: f
       8     integer :: alloc_stat
       9     double precision, dimension(:), allocatable :: q, qe
      10     double precision, dimension(:,:), allocatable :: ptot2
      11    !
      12    !  MODE= 1:  Add on terms to a partial Fock matrix to make it comple
 te.
      13    !  MODE= 0:  Build a Fock matrix, starting with the one-electron mat
 rix.
      14    !  MODE=-1:  Remove terms from a complete Fock matrix to make a part
 ial.
      15    !
      16     allocate (q(numat), qe(numat), ptot2(numat,81), stat=alloc_stat)
      17     if (alloc_stat /= 0) then
      18        call memory_error ("buildf")
      19        goto 100
      20     end if
      21     if (mode ==-1) f(:mpack) = partf(:mpack) - h(:mpack)
      22     if (mode == 0) f(:mpack) =                 h(:mpack)
      23     if (mode == 1) f(:mpack) = partf(:mpack) + h(:mpack)
      24     if (id == 0) then
      25       !
      26       !  Discrete system
      27       !
      28       call fock2z (f, q, qe, w, w, ptot2, mode, 1)
      29     else
      30       !
      31       !  A solid (polymer, layer, or 3-D solid)
      32       !
      33       call fock2z (f, q, qe, w, wk, ptot2, mode, 0)
      34     end if
      35 100 continue
      36     deallocate (q, qe, ptot2)
      37 end subroutine buildf
 
