       1 subroutine chkion (ox_calc, n_lone_pairs, atom_charge)
       2    !*******************************************************************
 ****
       3    !
       4    !   CHKION works out which atoms are ionized.  By the time CHKION is
       5    !          called, all the obvious elements of the Lewis structure h
 ave
       6    !   been determined (bonds, groups such as -NH3(+), etc.).
       7    !
       8    !   An atom is ionized if it has unused atomic orbitals. Using table
 s of
       9    !   normal oxidation states (ox_ref_sp) and hypervalent oxidation st
 ates
      10    !   (ox_ref_spd1), the degree of ionization is worked out.  To do th
 is,
      11    !   the starting oxidation state (ox_calc) is compared to that expec
 ted.
      12    !
      13    !   This should work for all elements in their common oxidation stat
 es.
      14    !
      15    !   A limitation is that the sum of atomic number and oxidation stat
 e
      16    !   must be even.  This means that Cr must be Cr(II) and not Cr(III)
 .
      17    !
      18    !*******************************************************************
 ****
      19     use chanel_C, only: iw
      20     use parameters_C, only: tore
      21     use common_arrays_C, only : nat, nbonds, ibonds, txtatm
      22     use molkst_C, only : numat, nelecs, line, keywrd
      23     use elemts_C, only : elemnt
      24     use mod_atomradii, only: is_metal
      25     use elemts_C, only : cap_elemnt
      26     use MOZYME_C, only: ions, Lewis_tot, Lewis_elem, &
      27       iz, ib
      28     implicit none
      29     character, intent (in) :: atom_charge(numat)
      30     integer, intent (inout) :: n_lone_pairs, ox_calc(numat)
      31     integer :: i, j, k, jj, loop, m, mm, outer_loop, ni, dummy, nocc_lo
 cal
      32     integer :: ox_ref(107), ox_ref_sp(107), ox_ref_spd1(107), ox_ref_sp
 d2(107)
      33     character :: num(10)*1
      34     double precision, external :: reada
      35 !
      36 !           H           Default formal oxidation states
      He
      37 !           Li Be                                            B  C  N  O
   F  Ne
      38 !           Na Mg                                            Al Si P  S
   Cl Ar
      39 !           K  Ca Sc            Ti V  Cr Mn Fe Co Ni Cu Zn   Ga Ge As S
 e Br Kr
      40 !           Rb Sr Y             Zr Nb Mo Tc Ru Rh Pd Ag Cd   In Sn Sb T
 e I  Xe
      41 !           Cs Ba La Ce-Lu      Hf Ta W  Re Os Ir Pt Au Hg   Tl Pb Bi P
 
 FORCHECK PC V13.5.13          CHKION          2021-03-24 10:59:30   page:  4077
