       1       subroutine set(s1, s2, na, nb, rab, ii)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE overlaps_C, only : isp, ips, sa, sb
       6 !-----------------------------------------------
       7 !   I n t e r f a c e   B l o c k s
       8 !-----------------------------------------------
       9       implicit none
      10 !-----------------------------------------------
      11 !   D u m m y   A r g u m e n t s
      12 !-----------------------------------------------
      13       integer , intent(in) :: na
      14       integer , intent(in) :: nb
      15       integer , intent(in) :: ii
      16       double precision , intent(in) :: s1
      17       double precision , intent(in) :: s2
      18       double precision , intent(in) :: rab
      19 !-----------------------------------------------
      20 !   L o c a l   V a r i a b l e s
      21 !-----------------------------------------------
      22       integer :: j, jcall
      23       double precision :: alpha, beta
      24 !-----------------------------------------------
      25 !**********************************************************************
 *
      26 !
      27 !     SET IS PART OF THE OVERLAP CALCULATION, CALLED BY OVERLP.
      28 !         IT CALLS AINTGS AND BINTGS
      29 !
      30 !**********************************************************************
 *
      31       if (na <= nb) then
      32         isp = 1
      33         ips = 2
      34         sa = s1
      35         sb = s2
      36       else
      37         isp = 2
      38         ips = 1
      39         sa = s2
      40         sb = s1
      41       end if
      42       j = ii + 2
      43       if (ii > 3) j = j - 1
      44       alpha = 0.5D00*rab*(sa + sb)
      45       beta = 0.5D00*rab*(sb - sa)
      46       jcall = j - 1
      47       call aintgs (alpha, jcall)
      48       call bintgs (beta, jcall)
      49       return
      50 !
      51       end subroutine set
 
