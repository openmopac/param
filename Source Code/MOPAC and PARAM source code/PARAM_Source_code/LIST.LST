       2       subroutine mxmt(a, nar, b, nbr, c, ncc)
       3       implicit none
       4       integer  :: nar
       5       integer  :: nbr
       6       integer  :: ncc
       7       double precision  :: a(nar,nbr)
       8       double precision  :: b(ncc,nbr)
       9       double precision  :: c(nar,ncc)
      10 !
      11 !     MATRIX PRODUCT C(NAR,NCC) = A(NAR,NBR) * (B(NCC,NBR))'
      12 !     ALL MATRICES RECTANGULAR , PACKED.
      13 !
      14       call dgemm ('N', 'T', nar, ncc, nbr, 1.0D0, a, nar, b, ncc, 0.0D0
 , c, nar)
      15       return
      16       end subroutine mxmt
 
