     155           call mopend("RESIDUE NAMES IN KEYWORD XENO MUST BE ONE OR THR
 EE CHARACTERS LONG")
     156           return
     157         end if
     158       end do
     159     end if
     160     do
     161       i = Index (keywrd, " xeno")
