       1 double precision function Hydrogen_bond_corrections(l_grad, prt)
       2 !
       3 !    Add in hydrogen-bond corrections
       4 !
       5   use molkst_C, only : numat, E_hb, N_Hbonds, method_pm7, l123, l1u, l2
 u, l3u, &
       6     method_pm6_dh_plus, method_pm6_dh2, method_pm6_d3h4, method_pm6_d3h
 4x, method_pm6_dh2x, &
       7     line, id, numcal
       8   use parameters_C, only : tore
       9   use common_arrays_C, only: coord, nat, q, p, hblist, dxyz, cell_ijk
      10   implicit none
      11   logical, intent (in) :: l_grad, prt
      12 !
      13 ! Local variables
      14 !
      15   integer :: i, j, k, l, D, H, A, nd_list, d_list(20), d_l(20), i_cell,
  ii, iii, kkkk, &
      16     nrpairs, max_h_bonds, icalcn = -1
      17   logical :: n_h_bonds, first = .true.
      18   integer, allocatable :: nrbondsa(:), nrbondsb(:)
      19   double precision :: EC, ER, vector(numat), sum, sum1, delta = 1.d-5,
 covrad(94)
      20   double precision, external :: EC_plus_ER, EH_plus, h_bonds4
      21   logical, external :: connected
      22
      23   save
      24    data covrad /&
      25   &0.32d0,  0.46d0,  1.20d0,  0.94d0,  0.77d0,  0.75d0,  0.71d0,  0.63d
 0,  0.64d0,  0.67d0, &
      26   &1.40d0,  1.25d0,  1.13d0,  1.04d0,  1.10d0,  1.02d0,  0.99d0,  0.96d
 0,  1.76d0,  1.54d0, &
      27   &1.33d0,  1.22d0,  1.21d0,  1.10d0,  1.07d0,  1.04d0,  1.00d0,  0.99d
 0,  1.01d0,  1.09d0, &
      28   &1.12d0,  1.09d0,  1.15d0,  1.10d0,  1.14d0,  1.17d0,  1.89d0,  1.67d
 0,  1.47d0,  1.39d0, &
      29   &1.32d0,  1.24d0,  1.15d0,  1.13d0,  1.13d0,  1.08d0,  1.15d0,  1.23d
 0,  1.28d0,  1.26d0, &
      30   &1.26d0,  1.23d0,  1.32d0,  1.31d0,  2.09d0,  1.76d0,  1.62d0,  1.47d
 0,  1.58d0,  1.57d0, &
      31   &1.56d0,  1.55d0,  1.51d0,  1.52d0,  1.51d0,  1.50d0,  1.49d0,  1.49d
 0,  1.48d0,  1.53d0, &
      32   &1.46d0,  1.37d0,  1.31d0,  1.23d0,  1.18d0,  1.16d0,  1.11d0,  1.12d
 0,  1.13d0,  1.32d0, &
      33   &1.30d0,  1.30d0,  1.36d0,  1.31d0,  1.38d0,  1.42d0,  2.01d0,  1.81d
 0,  1.67d0,  1.58d0, &
      34   &1.52d0,  1.53d0,  1.54d0,  1.55d0 /
      35 !
      36   if (first) then
      37     covrad = 4.d0/3.d0*covrad !  This must be done once per entire run
      38     first = .false.
      39   end if
      40   if (icalcn /= numcal) then
      41     max_h_bonds = 0
      42     do j = 1, numat
      43       if (nat(j) == 8 .or. nat(j) == 7) max_h_bonds = max_h_bonds + 1
      44     end do
      45     if (id == 0) then
 
 FORCHECK PC V13.5.13                          2021-03-24 10:59:30   page:   578
 Hydrogen_bond_corrections.F90  /FF
 
      46       max_h_bonds = max_h_bonds*125
      47     else
      48       max_h_bonds = max_h_bonds*250
      49     end if
      50   end if
      51   if (max_h_bonds == 0) then
      52     Hydrogen_bond_corrections = 0.d0
      53     return
      54   end if
      55   if (allocated(nrbondsa))   deallocate(nrbondsa)
      56   if (allocated(nrbondsb))   deallocate(nrbondsb)
      57   if (allocated(hblist))     deallocate(hblist)
      58   allocate (hblist(max_h_bonds,10), nrbondsa(max_h_bonds), nrbondsb(max
 _h_bonds), stat=i)
      59     if (i /= 0) then
      60     line = " Cannot allocate arrays for PM6-DH+"
      61     call to_screen(trim(line))
      62     call mopend(trim(line))
      63     Hydrogen_bond_corrections = 0.d0
      64     return
      65   end if
      66   hblist(:,:) = 0
      67   nrpairs = 0
      68   if (method_pm6_dh_plus .or. method_PM7) then
      69     call all_h_bonds(hblist(1,1), hblist(1,9), hblist(1,5), max_h_bonds
 , nrpairs)
      70     call setup_DH_Plus(nrpairs, nrbondsa, nrbondsb, n_h_bonds, covrad)
      71   else
      72     call all_h_bonds(hblist(1,1), hblist(1,2), hblist(1,3), max_h_bonds
 , nrpairs)
      73   end if
      74   if (method_pm6_dh2 .or. method_pm6_dh2x) then
      75     call chrge (p, vector)  ! PM6-DH2 needs partial charges
      76     do i = 1, numat
      77       j = nat(i)
      78       q(i) = tore(j) - vector(i)
      79     end do
      80   end if
      81 !
      82 !  Calculate Hydrogen bond energy correction
      83 !
      84 !    The hydrogen-bond acceptor types are as follows:
      85 !
      86 !    (1) nitrogen with no hydrogens bonded to it (mostly in aromatic ri
 ngs) interacting with any hydrogen,
      87 !    (2) nitrogen with one hydrogen (secondary amines) interacting with
  any hydrogen,
      88 !    (3) nitrogen with two or more hydrogens (primary amines, ammonia)
