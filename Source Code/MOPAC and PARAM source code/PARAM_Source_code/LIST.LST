 tor', &
     859      & '--------- polarization---------  dipole  ', &
     860      & '------ components-----')")
     861         write (iw, "(' st.  symm.    eV      cm - 1       nm      stren
 gth ', &
     862      & '      x          y         z       moment     x       y  ', &
     863      & '     z ' /)")
     864         call polzro
     865         nm0 = matind(i0) + i0
     866
     867         do il = 1, nciout
     868          if (il /= i0) then
     869           eng = evalci(il) - evalci(i0)
     870           freq = eng / au2ev * au2cm
     871 ! RMG - add option to write transition dipoles between excited states
     872           if (index(keywrd, ' TDIP') /= 0) then
     873             write(14, *) eng
     874           end if
     875 ! End RMG
 
 FORCHECK PC V13.5.13          CIOUT           2021-03-24 10:59:30   page:  3991
 ci.F90  /FF
 
     876
     877           wl = 0.d0
     878           if (abs(freq) > 1.d0) wl = 1.D7/abs(freq)
     879           nsy = istate(il)
     880           nst = ixprd(nsx, nsy)
     881
     882 !         **** dipole moments and solvent shifts ****
     883           nmd = matind(il) + il
