      53 !
      54         80  continue
      55     if (nmol /= numcal) then
      56       !
      57       !  INITIALIZE
      58       !
      59       !     THRESH          ERROR IN H.O.F., RELATIVE TO THRESH=1.D-13
      60       !
      61       !     1.D-8             0.21??     SCF unstable
      62       !     1.D-9             0.0294     SCF stable
      63       !     1.D-10            0.0112     SCF stable
      64       !     1.D-11            0.0040     SCF stable
      65       !     1.D-12            0.0011     SCF stable
      66       !
      67       !   IF THRESH IS CHANGED, THEN ALSO CHANGE DEFAULT IN WRTKEY
      68       !
      69       thresh = 1.d-13
      70       scfref = 0.d0
      71       i = Index (keywrd, " RELTHR")
      72       if (i /= 0) then
      73         thresh = reada (keywrd, i) * thresh
      74       end if
      75       i = Index (keywrd, " THRESH")
      76       if (i /= 0) then
      77         thresh = reada (keywrd, i)
      78       end if!
      79
      80       thresh = Max (thresh, 1.d-25)
      81       prtpls = (Index (keywrd, " PL ") /= 0)
      82       orthog = (Index (keywrd, " REORTH") /= 0)
      83       times = (Index (keywrd, " TIMES") /= 0)
      84       i = Index (keywrd, " DENOUT=")
      85       if (i /= 0) then
      86         idnout = Nint (reada (keywrd, i+8))
      87       else
      88         idnout = 10000000
      89       end if
      90       itrmax = 2000
      91       if (Index (keywrd, " ITRY") /= 0) then
      92         itrmax = Nint (reada (keywrd, Index (keywrd, " ITRY")))
      93       end if
      94       re_local = 100000000
      95       i = index(keywrd," RE-LOC")
      96       if (i /= 0) then
      97         j = index(keywrd(i + 7:), " ") + i + 7
      98         if (index(keywrd(i:j), "=") /= 0) then ! Allow for RE-LOC=, RE-
 LOCAL=, etc.
      99           i = index(keywrd(i:j), "=") + i
     100           re_local = nint(reada(keywrd,i))
     101         end if
     102       end if
     103       nocc1 = 0
     104       nvir1 = 0
     105       scf1 = (Index (keywrd, " 1SCF") /= 0)
     106       bigscf = (Index (keywrd, " BIGSCF") /= 0)
     107       if (Index (keywrd, " OLDEN") == 0) then
     108         bigscf = .true.
     109       end if
     110       debug = (Index (keywrd, " DEBUG") /= 0)
 
 FORCHECK PC V13.5.13     ITER_FOR_MOZYME      2021-03-24 10:59:30   page:  3073
