     249 ! EVALUATE THE TOTAL ATOMIC SPIN POPULATIONS
     250       k = 0
     251       do i = 1, numat
     252         do j = 1, i
     253           k = k + 1
     254           aux(i,j) = spinab(k)
     255           aux(j,i) = spinab(k)
     256         end do
     257       end do
     258       do i = 1, numat
     259         da = 0.D0
     260         do j = 1, numat
     261           if (j == i) cycle
     262           da = da + aux(i,j)
     263         end do
     264         spsa(i) = da
     265         spsq(i) = aux(i,i)
     266         spna(i) = da + aux(i,i)
     267       end do
     268       write (iw, '(2/20X,''SELF UNPAIRED AND BOND SPIN POPULATIONS ''/)
 ')
     269       call vecprt (spinab, numat)
     270       write (iw, '(2/)')
     271       write (iw, '(10X,'' TOTAL ATOMIC SPIN POPULATIONS''/)')
     272       write (iw, &
     273       '(1X,''ATOM    SELF UNCPLD SPIN    SHARED UNCPLD SPIN     TOTAL U
 NCPLD SP&
     274       &IN '',3/(1X,I3,3F20.5))') (i,spsq(i),spsa(i),spna(i),i=1,numat)
     275       return
     276       end subroutine bonds
 
