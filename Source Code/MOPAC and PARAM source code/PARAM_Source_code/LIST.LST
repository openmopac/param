     178       subroutine surfa(co, potpt, nmep)
     179 !-----------------------------------------------
     180 !   M o d u l e s
     181 !-----------------------------------------------
     182       use chanel_C, only : iw
     183       use molkst_C, only : keywrd, numat, mxmep => itemp_1
     184       use common_arrays_C, only : nat
     185 !**********************************************************************
 *
     186 !   THIS SUBROUTINE CALCULATED THE MOLECULAR SURFACE AND WAS LIFTED
     187 !   FROM M. CONNOLLY'S PROGRAM BY U.C.SINGH AND P.A.KOLLMAN.
     188 !   IN THIS MODIFIED VERSION IT GENERATES THE SAMPLE POINTS ON FOUR
     189 !   LAYERS OF VAN DER WAAL'S SURFACES.
     190 !                                     BY BINGZE WANG ON 19 AUGUST 1993
     191 !**********************************************************************
 *
     192 !**********************************************************************
 *
     193 !-----------------------------------------------
     194 !   I n t e r f a c e   B l o c k s
     195 !-----------------------------------------------
     196       implicit none
     197 !-----------------------------------------------
     198 !   D u m m y   A r g u m e n t s
     199 !-----------------------------------------------
     200       integer , intent(inout) :: nmep
     201       double precision , intent(in) :: co(3,*)
     202       double precision , intent(out) :: potpt(3,*)
     203 !-----------------------------------------------
     204 !   L o c a l   V a r i a b l e s
     205 !-----------------------------------------------
     206       integer , dimension(:), allocatable :: ias
     207       integer ::  layer, ishel, i, ipoint, iatom, nnbr, jatom, ncon
     208       double precision, dimension(100) :: vander
     209       double precision, dimension(3,1000) :: con
     210       double precision, dimension(:), allocatable :: rad
     211       double precision, dimension(3,200) :: cnbr
     212       double precision, dimension(200) :: rnbr
     213       double precision, dimension(3) :: ci, temp0
     214       double precision, dimension(3,2) :: cw
     215       double precision :: scale, dens, scincr, pi, rw, den, ri, d2
     216       logical :: si
     217       double precision, external :: reada
     218       logical, external :: collis
     219 !-----------------------------------------------
     220 !
     221 !     NEIGHBOR ARRAYS
     222 !
     223 !     THIS SAME DIMENSION FOR THE MAXIMUM NUMBER OF NEIGHBORS
     224 !     IS USED TO DIMENSION ARRAYS IN THE LOGICAL FUNCTION COLLID
     225 !
     226 !
     227 !              ARRAYS FOR ALL ATOMS, IATOM, JATOM AND KATOM COORDINATES
     228 !                                        GEOMETRIC CONSTRUCTION VECTORS
     229 !                                                     LOGICAL VARIABLES
     230 !                                                     LOGICAL FUNCTIONS
     231 !                                            DATA FOR VANDER VALL RADII
     232       data scale/ 1.4D0/
 
 FORCHECK PC V13.5.13          SURFA           2021-03-24 10:59:30   page:  3025
 pmep.F90  /FF
 
     233       data dens/ 1.0D0/
     234       data scincr/ 0.20D0/
     235       data layer/ 4/
     236       data vander/ 1.20D0, 1.20D0, 1.37D0, 1.45D0, 1.45D0, 1.50D0, 1.50
 D0, &
     237         1.40D0, 1.35D0, 1.30D0, 1.57D0, 1.36D0, 1.24D0, 1.17D0, 1.80D0,
  1.75D0&
     238         , 1.70D0, 17*0.0D0, 2.3D0, 65*0.0D0/
     239 !
     240       mxmep = 50*numat + 1000
     241       allocate (ias(mxmep), rad(mxmep))
     242       pi = 4.D0*atan(1.D0)
     243 !                                    INSERT VAN DER WAAL RADII FOR ZINC
     244       vander(30) = 1.00D0
     245 !
     246       if (index(keywrd,'SCALE=') /= 0) scale = reada(keywrd,index(keywr
 d,&
     247         'SCALE='))
     248       if (index(keywrd,'DEN=') /= 0) dens = reada(keywrd,index(keywrd,'
 DEN='))
     249       if (index(keywrd,'SCINCR=') /= 0) &
     250         scincr = reada(keywrd,index(keywrd,'SCINCR='))
     251       if (index(keywrd,'NSURF=') /= 0) &
     252         layer = nint(reada(keywrd,index(keywrd,'NSURF=')))
     253 !
     254       do ishel = 1, layer
     255 !                         ONLY VAN DER WAALS' TYPE SURFACE IS GENERATED
     256         rw = 0.0D0
     257         den = dens
     258         do i = 1, numat
     259           ipoint = nat(i)
     260           rad(i) = vander(ipoint)*scale
     261           if (rad(i) < 0.01D0) write (iw, &
     262       '(T2,''VAN DER WAALS'''' RADIUS FOR ATOM '',I3,          '' IS ZE
 RO, SUPP&
     263       &LY A VALUE IN SUBROUTINE SURFAC)'' )')
     264           ias(i) = 2
     265         end do
     266 !
     267 !     BIG LOOP FOR EACH ATOM
     268 !
     269         do iatom = 1, numat
     270           if (ias(iatom) == 0) cycle
     271 !
     272 !     TRANSFER VALUES FROM LARGE ARRAYS TO IATOM VARIABLES
     273 !
     274           ri = rad(iatom)
     275           si = ias(iatom) == 2
     276           ci = co(:,iatom)
     277 !                                GATHER THE NEIGHBORING ATOMS OF IATOM
     278           nnbr = 0
     279           do jatom = 1, numat
     280             if (iatom==jatom .or. ias(jatom)==0) cycle
     281             d2 = (ci(1)-co(1,jatom))**2 + (ci(2)-co(2,jatom))**2 + (ci(
 3)-co(3,&
     282               jatom))**2
     283             if (d2 >= (2*rw + ri + rad(jatom))**2) cycle
     284 !
     285 !     WE HAVE A NEW NEIGHBOR
 
 FORCHECK PC V13.5.13          SURFA           2021-03-24 10:59:30   page:  3026
 pmep.F90  /FF
 
     286 !     TRANSFER ATOM COORDINATES, RADIUS AND SURFACE REQUEST NUMBER
     287 !
     288             nnbr = nnbr + 1
     289             if (nnbr > 200) then
     290               write (iw, '(''ERROR'',2X,''TOO MANY NEIGHBORS:'',I5)') n
 nbr
     291               call mopend ('TOO MANY NEIGHBORS')
     292               return
     293             end if
     294             cnbr(:,nnbr) = co(:,jatom)
     295             rnbr(nnbr) = rad(jatom)
     296           end do
     297 !
     298 !     CONTACT SURFACE
     299 !
     300           if (.not.si) cycle
     301           ncon = int((4*pi*ri**2)*den)
     302           ncon = min0(1000,ncon)
     303 !
     304 !     THIS CALL MAY DECREASE NCON SOMEWHAT
     305 !
     306           if (ncon == 0) then
     307             write (iw, '(T2,''VECTOR LENGTH OF ZERO IN SURFAC'')')
     308             call mopend ('VECTOR LENGTH OF ZERO IN SURFAC')
     309             return
     310           end if
     311           call genvec (con, ncon)
     312 !
     313 !     CONTACT PROBE PLACEMENT LOOP
     314 !
     315           do i = 1, ncon
     316             cw(:,1) = ci + (ri + rw)*con(:,i)
     317 !
     318 !     CHECK FOR COLLISION WITH NEIGHBORING ATOMS
     319 !
     320             if (collis(cw(1,1),rw,cnbr,rnbr,nnbr,1)) cycle
     321             temp0 = ci + ri*con(:,i)
     322 !
     323 !     STORE POINT IN POTPT AND INCREMENT NMEP
     324 !
     325             nmep = nmep + 1
     326             if (nmep > mxmep) go to 100
     327             potpt(1,nmep) = temp0(1)
     328             potpt(2,nmep) = temp0(2)
     329             potpt(3,nmep) = temp0(3)
     330           end do
     331         end do
     332         scale = scale + scincr
     333       end do
     334       return
     335   100 continue
     336       write (iw, 110)
     337       call mopend ('ERROR - TOO MANY POINTS GENERATED IN SURFAC.')
     338       return
     339   110 format(/,'ERROR - TO MANY POINTS GENERATED IN SURFAC'/,&
     340         '    REDUCE NSURF, SCALE, DEN, OR SCINCR')
     341       end subroutine surfa
 
