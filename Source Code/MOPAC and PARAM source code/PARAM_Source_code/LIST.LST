     360       write (iw, 200) dipe4t, dipdpt, dipe4d, dipdpd
     361   200 format(/,/,' MAGNITUDE:  ',2f15.6,'  (A.U.)',/,' ',12x,2f15.6,'
 (DEBYE)')
     362 !
     363 ! FIND EIGENVALUES AND EIGENVECTORS OF POLARIZATION MATRIX.
     364 !
