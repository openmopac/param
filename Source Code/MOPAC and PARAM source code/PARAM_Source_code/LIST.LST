    1011
    1012       subroutine foscil (dmci, dm, istsym, e, aocc, bocc, spintr, nspn,
  xz, zcore)
    1013
    1014 !     **** uses dipole moment in MO basis to construct dipole integrals
  ****
    1015 !     **** between CI configurations
  ****
    1016       use reimers_C, only : na, nb2, matind, au2ev, au2ang, au2cm, deby
 e, &
    1017           icifrag, nconf, multci, ncore, nov, fastci, n2phot, nciouv, &
    1018           nmrep, nptg, aor1, bor1, dipsym, ndtype, nex, mspn
    1019       USE chanel_C, only : iw
    1020
    1021       implicit none
    1022       double precision ::  dmci(nconf*(nconf + 1)/2, 3), dm(nb2, 3), &
    1023                         e(nconf), spintr(mspn, nconf), xz(na, 3), &
    1024                         zcore(na), dcore(3), sqrt2, foscf, foscm, &
    1025                         xx, align, emin, freq, diplen, tmsq, f
    1026       integer ::           istsym(nconf), nspn(nconf), &
    1027                         i, j, k, i1, ilow, iov, ivo, j1, k1, k2, kk, &
    1028                         maxx, ndiff, nel, nio, niv, nm, nspni
    1029       logical*1 ::         aocc(nov, mspn, nex), bocc(nov, mspn, nex),
 &
    1030      &                  same, adiff, bdiff, abdiff
    1031       character*4       lo(9), lv(9), ll
    1032       character*3       rep
    1033
    1034       write (iw, "(' The lowest ', i4, ' spin-adapted configurations of
  ', &
    1035      &        'multiplicity=', i3 /&
    1036      &        5x, 'sym   eV   cm**-1 -dets- dipole oscilator X FRAG ...
 .', &
    1037      &        'Excitations named from first reference determinate' /&
    1038      &        23x, 'tot  #  Debye  strength')") nconf, multci
    1039       nciouv = nconf
    1040
    1041       if (ndtype == 3) write (iw, "(45x, ' x 1000')")
    1042       write (iw, *)
    1043       call polzro
    1044       sqrt2 = sqrt (2.d0)
    1045       foscf = 2.d0/3.d0/au2ang**2/au2cm
    1046       foscm = 2.d0/3.d0*au2ang**2*au2cm
    1047
    1048       if (ndtype == 4) then
    1049 !       **** dont do any dipole or transition moment calcs ****
    1050         do i = 1, 3
    1051           do j = 1, nconf*(nconf + 1)/2
    1052             dmci(j, i) = 0.d0
    1053           end do
    1054         end do
    1055         goto 500
    1056       end if
    1057
    1058 !     **** determine dipole moment of (nucleas + inner shells) + valenc
 e core ****
 
