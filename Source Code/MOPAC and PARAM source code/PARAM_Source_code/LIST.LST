     512     subroutine mainlb (n, m, x, l, u, nbd, f, g, factr, pgtol, ws, wy,
 sy, ss, &
     513    & wt, wn, snd, z, r, d, t, wa, Index, iwhere, indx2, task, iprint, c
 save, &
     514    & lsave, isave, dsave)
     515     !
     516     use chanel_C, only: lbfgs_it, iw
     517       implicit none
     518       double precision, parameter :: one = 1.0d0
     519       double precision, parameter :: zero = 0.0d0
