    1038         return
    1039       end if
    1040       tv1 = vol / area23
    1041       tv2 = vol / area13
    1042       tv3 = vol / area12
    1043       sum = 4.0d0
    1044       if ((tv1 < sum .or. tv2 < sum .or. tv3 < sum) .and. Index (keywrd
 , " GEO-OK") == 0) then
    1045         write(iw,"(//10x,a,f9.3,a   )") "Translation vector length 1:",
  r1," Angstroms"
    1046         write(iw,"(  10x,a,f9.3,a   )") "Translation vector length 2:",
  r2," Angstroms"
    1047         write(iw,"(  10x,a,f9.3,a,/ )") "Translation vector length 3:",
  r3," Angstroms"
    1048         if (tv1 < sum) write (iw,'(10X,A,F6.3,A,f6.3)') &
    1049              & "Distance between faces 2 and 3 is unreasonably small:",
  tv1," Angstroms, min:", sum
    1050         if (tv2 < sum) write (iw,'(10X,A,F6.3,A,f6.3)') &
    1051              & "Distance between faces 1 and 3 is unreasonably small:",
  tv2," Angstroms, min:", sum
    1052         if (tv3 < sum) write (iw,'(10X,A,F6.3,A,f6.3)') &
    1053              & "Distance between faces 1 and 2 is unreasonably small:",
  tv3," Angstroms, min:", sum
    1054         if (tv1 < sum .or. tv2 < sum .or. tv3 < sum) then
    1055           call mopend("One or more translation vectors are unreasonably
  small")
