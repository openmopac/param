       1       subroutine mamult(a, b, c, n, one)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       implicit none
       6 !-----------------------------------------------
       7 !   D u m m y   A r g u m e n t s
       8 !-----------------------------------------------
       9       integer , intent(in) :: n
      10       double precision , intent(in) :: one
      11       double precision , intent(in) :: a(*)
      12       double precision , intent(in) :: b(*)
      13       double precision , intent(inout) :: c(*)
      14 !-----------------------------------------------
      15 !   L o c a l   V a r i a b l e s
      16 !-----------------------------------------------
      17       integer :: l, i, ii, j, jj, k, kk
      18       double precision :: sum
      19 !-----------------------------------------------
      20 !**********************************************************************
 *
      21 !
      22 !   MAMULT MULTIPLIES A BY B AND PUTS THE RESULT IN C
      23 !
      24 !**********************************************************************
 *
      25       l = 0
      26       do i = 1, n
      27         ii = ((i - 1)*i)/2
      28         do j = 1, i
      29           jj = ((j - 1)*j)/2
      30           l = l + 1
      31           sum = 0.D0
      32           do k = 1, j
      33             sum = sum + a(ii+k)*b(jj+k)
      34           end do
      35           do k = j + 1, i
      36             sum = sum + a(ii+k)*b(((k-1)*k)/2+j)
      37           end do
      38           do k = i + 1, n
      39             kk = (k*(k - 1))/2
      40             sum = sum + a(kk+i)*b(kk+j)
      41           end do
      42           c(l) = sum + one*c(l)
      43         end do
      44       end do
      45       return
      46       end subroutine mamult
 
