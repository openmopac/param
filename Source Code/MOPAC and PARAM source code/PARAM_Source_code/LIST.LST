 tvec(:,3)*kl
     242                 if (id /= 0) then
     243                   rij = (cdi(1, 1)-cdi(1, 2)) ** 2 &
     244                        & + (cdi(2, 1)-cdi(2, 2)) ** 2 &
     245                        & + (cdi(3, 1)-cdi(3, 2)) ** 2
     246                   if (rij > (2.d0/3.d0*cutofp)**2) then
     247                         !
     248                         !   Use point-charge approximation
     249                         !
     250                     rij = Sqrt (rij)
     251                     der = derp (rij)
     252                     ee = q(ii) * q(jj) * fpc_9 * ev * a0 * der
     253                     do k = 1, 3
     254                       deriv = half * ee * (cdi(k, 1)-cdi(k, 2)) / rij
     255                       dxyz(k, iii+icuc) = dxyz(k, iii+icuc) - deriv
     256                       dxyz(k, jjj+kkkk) = dxyz(k, jjj+kkkk) + deriv
     257                     end do
     258                     cycle
     259                   end if
     260                 end if
     261                 if (point) then
     262                   do l = 1, 3
     263                     cdi(l, 1) = coord(l, jj) + tvec(l, 1) * ik &
     264                          & + tvec(l, 2) * jk + tvec(l, 3) * kl
     265                   end do
     266                   call delsta (nat, iorbs, p, cdi, dstat, ii, jj)
     267                   dxyz(1:3, iii+icuc) = dxyz(1:3, iii+icuc) - dstat(1:3
 )
     268                   dxyz(1:3, jjj+kkkk) = dxyz(1:3, jjj+kkkk) + dstat(1:3
 )
     269                 else
     270                   if (.not.force) then
     271                    cdi(1,1) = cdi(1,1) + chnge2
     272                    cdi(2,1) = cdi(2,1) + chnge2
     273                    cdi(3,1) = cdi(3,1) + chnge2
     274                    call dhc (pdi, padi, pbdi, cdi, ndi, jf, jl, if, il,
  aa, 1)
     275                   end if
     276                   do k = 1, 3
     277                     if (force) then
     278                       cdi(k,2) = cdi(k,2) - chnge2
     279                       call dhc (pdi, padi, pbdi, cdi, ndi, jf, jl, if,
 il, aa, 1)
 
 FORCHECK PC V13.5.13          DCART           2021-03-24 10:59:30   page:  4153
 dcart.F90  /FF
 
     280                     end if
     281                     cdi(k,2) = cdi(k,2) + chnge
     282                     call dhc (pdi, padi, pbdi, cdi, ndi, jf, jl, if, il
 , ee, 2)
     283                     cdi(k,2) = cdi(k,2) - chnge2
     284                     if (.not.force) cdi(k,2) = cdi(k,2) - chnge2
     285                     deriv = half*(aa - ee)*const/chnge
     286                     dxyz(k,iii+icuc) = dxyz(k,iii+icuc) - deriv
     287                     dxyz(k,jjj+kkkk) = dxyz(k,jjj+kkkk) + deriv
     288                   end do
     289                 end if
     290               end do
     291             end do
     292           end do
     293         end do
     294       end do
     295       if (nnhco /= 0) then
     296 !
     297 !   NOW ADD IN MOLECULAR-MECHANICS CORRECTION TO THE H-N-C=O TORSION
     298 !
     299         del = 1.D-8
     300         do i = 1, nnhco
     301           do j = 1, 4
     302             do k = 1, 3
     303               coord(k,nhco(j,i)) = coord(k,nhco(j,i)) - del
     304               call dihed (coord, nhco(1,i), nhco(2,i), nhco(3,i), nhco(
 4,i), &
     305                 angle)
     306               refh = htype*sin(angle)**2
     307               coord(k,nhco(j,i)) = coord(k,nhco(j,i)) + del*2.D0
     308               call dihed (coord, nhco(1,i), nhco(2,i), nhco(3,i), nhco(
 4,i), &
     309                 angle)
     310               coord(k,nhco(j,i)) = coord(k,nhco(j,i)) - del
     311               heat = htype*sin(angle)**2
     312               sum = (refh - heat)/(2.D0*del)
     313               dxyz(k,nhco(j,i)) = dxyz(k,nhco(j,i)) - sum
     314             end do
     315           end do
     316         end do
     317       end if
     318       if (method_pm6 .and. N_3_present) then
