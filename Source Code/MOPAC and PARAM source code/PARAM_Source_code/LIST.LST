       1 subroutine vecprt_for_MOZYME(aa, numm)
       2     use molkst_C, only: mpack, numat, gui
       3     use chanel_C, only: iw
       4     use elemts_C, only: elemnt
       5     use common_arrays_C, only : nat, nfirst, nlast, l_atom
       6     implicit none
       7     double precision, dimension (mpack), intent (in) :: aa
       8     integer, intent (in) :: numm
       9     integer, parameter :: maxarr = 200
      10 !
      11     integer :: i, ii, ij, j, jhi, jj, jlo, k, kk, l, limit, linear, ll,
  m, ma, &
      12    & n, na, numb
      13     double precision :: fact, sumax
      14     character (len=2), dimension (9), save :: atorbs
      15     character (len=2), dimension (maxarr) :: itext, jtext
      16     character (len=6), dimension (21) :: line
      17     integer, dimension (maxarr) :: natom
      18     double precision, dimension (:), allocatable :: a
      19     integer, external :: ijbo
      20     data atorbs / " S", "PX", "PY", "PZ", "X2", "XZ", "Z2", "YZ", "XY"
 /
      21 !
      22     l = 0
      23     ll = 0
      24     numb = Abs (numm)
      25     if (numb > maxarr) then
      26       write (iw,'(/10x,a,i5)') "VECPRT CAN ONLY PRINT ARRAYS OF SIZE LE
 SS THAN", maxarr
      27       write (iw,'(10x,a,i5)') "AN ATTEMPT WAS MADE TO PRINT AN ARRAY OF
  SIZE ", numb
      28       numb = maxarr
      29     end if
      30     linear = (numb*(numb+1)) / 2
      31     allocate (a(linear))
      32    !
      33    !    Decide what type of array to print.  Options are:
      34    !        (1)   Over atoms
      35    !        (2)   Over atomic orbitals
      36    !        (3)   All other types.
      37    !
      38     if (numat /= 0 .and. numat == numm) then
      39       !
      40       !    OPTION (1):  PRINT OVER ATOM COUNT
      41       !
      42       j = 0
      43       l = 0
      44       do i = 1, numb
      45         if (l_atom(i)) then
      46           j = j + 1
      47           itext(j) = "  "
      48           jtext(j) = elemnt(nat(i))
      49           if (gui) then
      50             natom(j) = j
      51           else
      52             natom(j) = i
      53           end if
      54           do k = 1, i
 
