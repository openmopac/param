     649       subroutine saxpy(n, sa, sx, incx, sy, incy)
     650       implicit none
     651 !-----------------------------------------------
     652 !   D u m m y   A r g u m e n t s
     653 !-----------------------------------------------
     654       integer , intent(in) :: n
     655       integer , intent(in) :: incx
     656       integer , intent(in) :: incy
     657       real , intent(in) :: sa
     658       real , intent(in) :: sx(1)
     659       real , intent(inout) :: sy(1)
     660 !-----------------------------------------------
     661 !   L o c a l   V a r i a b l e s
     662 !-----------------------------------------------
     663       integer :: ix, iy, m, mp1
     664 !-----------------------------------------------
     665 !
     666 !     CONSTANT TIMES A VECTOR PLUS A VECTOR.
     667 !     USES UNROLLED LOOPS FOR INCREMENTS EQUAL TO ONE.
     668 !     JACK DONGARRA, LINPACK, 3/11/78.
     669 !
     670 !
     671       if (n <= 0) return
     672       if (sa == 0.0E0) return
     673       if (incx/=1 .or. incy/=1) then
     674 !
     675 !        CODE FOR UNEQUAL INCREMENTS OR EQUAL INCREMENTS
     676 !          NOT EQUAL TO 1
     677 !
     678         ix = 1
     679         iy = 1
     680         if (incx < 0) ix = ((-n) + 1)*incx + 1
     681         if (incy < 0) iy = ((-n) + 1)*incy + 1
     682         sy(iy:(n-1)*incy+iy:incy) = sy(iy:(n-1)*incy+iy:incy) + sa*sx(i
 x:(n-1)*&
     683           incx+ix:incx)
     684         return
     685       end if
     686 !
     687 !        CODE FOR BOTH INCREMENTS EQUAL TO 1
     688 !
     689 !
     690 !        CLEAN-UP LOOP
     691 !
     692       m = mod(n,4)
     693       if (m /= 0) then
     694         sy(:m) = sy(:m) + sa*sx(:m)
     695         if (n < 4) return
     696       end if
     697       mp1 = m + 1
     698       sy(mp1:((n-mp1+4)/4)*4-1+mp1) = sy(mp1:((n-mp1+4)/4)*4-1+mp1) + s
 a*sx(mp1&
     699         :((n-mp1+4)/4)*4-1+mp1)
     700       return
     701       end subroutine saxpy
 
