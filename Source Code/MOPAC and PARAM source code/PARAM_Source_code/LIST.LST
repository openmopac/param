     397      subroutine potcal()
     398 !-----------------------------------------------
     399 !   M o d u l e s
     400 !-----------------------------------------------
     401       use molkst_C, only : keywrd, numat, ux, uy, uz, method_mndo
     402       USE common_arrays_C, only : q, nat
     403       use funcon_C, only : a0
     404       use elemts_C, only : elemnt
     405       use esp_C, only : cf, cequiv, co, qsc, nesp, &
     406       & rms, rrms, dx, dy, dz, iz, idip
     407       use chanel_C, only : iw
     408 !**********************************************************************
 *
     409 !-----------------------------------------------
     410 !   I n t e r f a c e   B l o c k s
     411 !-----------------------------------------------
     412       implicit none
     413 !-----------------------------------------------
     414 !   L o c a l   V a r i a b l e s
     415 !-----------------------------------------------
     416       integer :: i, j, ieq
     417       double precision :: dipx, dipy, dipz, slope, dip
     418       double precision, external :: reada
     419 !-----------------------------------------------
     420 !**********************************************************************
 *
     421 !
     422 !     THIS SUBROUTINE CALCULATES THE TOTAL ELECTROSTATIC POTENTIAL
     423 !     THE NUCLEAR CONTRIBUTION IS EVALUATED BY NUCPOT
     424 !     THE ELECTRONIC CONTRIBUTION IS EVALUATED BY ELESP
     425 !     ESPFIT FITS THE QUANTUM POTENTIAL TO A CLASSICAL POINT CHARGE
     426 !     MODEL.
     427 !     THIS SUBROUTINE WAS WRITTEN BY B.H.BESLER AND K.M.MERZ IN FEB.
     428 !     1989 AT UCSF
     429 !
     430 !**********************************************************************
 *
     431       data dipx, dipy, dipz/ 3*0.D0/
     432 !
     433 !
     434       call elesn ()
     435       rms = 0.D0
     436       rrms = 0.D0
     437       slope = 0.d0
     438 !
     439 !     NOW FIT THE ELECTROSTATIC POTENTIAL
     440 !
     441       write (iw, '(2/12X,''ELECTROSTATIC POTENTIAL CHARGES'',/)')
     442       iz = 0
     443       if (index(keywrd,'CHARGE=') /= 0) iz = nint(reada(keywrd,index(ke
 ywrd,&
     444         'CHARGE=')))
     445 !
     446 !     DIPOLAR CONSTRAINTS IF DESIRED
     447 !
     448       if (index(keywrd,'DIPOLE') /= 0) then
     449         idip = 1
     450         if (iz /= 0) then
 
 FORCHECK PC V13.5.13          POTCAL          2021-03-24 10:59:30   page:  3216
 esp.F90  /FF
 
     451           idip = 0
     452           write (iw, '(/12X,''  DIPOLE CONSTRAINTS NOT USED'')')
     453           write (iw, '(12X,''        CHARGED MOLECULE'',/)')
     454         end if
     455       else
     456         idip = 0
     457       end if
     458       if (idip == 1) write (iw, '(/12X,''DIPOLE CONSTRAINTS WILL BE USE
 D'',/)')
     459 !
     460 !     GET X,Y,Z DIPOLE COMPONENTS IF DESIRED
     461 !
     462       if (index(keywrd,'DIPX=') /= 0) then
     463         dx = reada(keywrd,index(keywrd,'DIPX='))
     464       else
     465         dx = ux
     466       end if
     467       if (index(keywrd,'DIPY=') /= 0) then
     468         dy = reada(keywrd,index(keywrd,'DIPY='))
     469       else
     470         dy = uy
     471       end if
     472       if (index(keywrd,'DIPZ=') /= 0) then
     473         dz = reada(keywrd,index(keywrd,'DIPZ='))
     474       else
     475         dz = uz
     476       end if
     477       call espfit ()
     478 !
     479 !     WRITE OUT OUR RESULTS TO CHANNEL 6
     480 !     THE CHARGES ARE SCALED TO REPRODUCE 6-31G* CHARGES FOR MNDO ONLY
     481 !     AM1 CHARGES ARE NOT SCALED DUE TO THE LOW COORELATION
     482 !     COEFFICIENT. SEE BESLER,MERZ,KOLLMAN IN J. COMPUT. CHEM.
     483 !     (IN PRESS)
