       1  subroutine add_hydrogen_atoms()
       2 !
       3 !   Adds hydrogen atoms.
       4 !
       5 !   Intended for use in converting PDB files into files suitable for ru
 nning in MOPAC
       6 !
       7   use molkst_C,  only : numat, natoms, keywrd, isok, maxatoms, moperr,
 refkey, line, id
       8   use common_arrays_C,  only : nat,  coord,  nbonds,  ibonds, txtatm, l
 abels, atmass, geo, &
       9     lopt, na, l_atom, loc, xparam, nfirst, nlast, txtatm1, coorda, tvec
      10   use parameters_C, only : ams
      11   use MOZYME_C, only : atomname, afn, n_add
