       1       subroutine analyt(psum, palpha, pbeta, coord, nat, jja, jjd, iia,
  iid, &
       2         eng)
       3 !-----------------------------------------------
       4 !   M o d u l e s
       5 !-----------------------------------------------
       6       USE funcon_C, only : a0, fpc_9
       7       USE molkst_C, only : keywrd, numcal, mpack
       8       USE analyt_C, only : ds, dg, dr, g, nztype
       9       USE parameters_C, only : alp, natorb, tore, guess1, guess2, guess
 3, &
      10       betas, betap
      11       use chanel_C, only : irot
      12 !**********************************************************************
 *
      13 !-----------------------------------------------
      14 !   I n t e r f a c e   B l o c k s
      15 !-----------------------------------------------
      16       implicit none
      17 !-----------------------------------------------
      18 !   D u m m y   A r g u m e n t s
      19 !-----------------------------------------------
      20       integer , intent(in) :: jja
      21       integer , intent(in) :: jjd
      22       integer , intent(in) :: iia
      23       integer , intent(in) :: iid
      24       integer , intent(in) :: nat(2)
      25       double precision , intent(in) :: psum(mpack)
      26       double precision , intent(in) :: palpha(mpack)
      27       double precision , intent(in) :: pbeta(mpack)
      28       double precision  :: coord(3,2)
      29       double precision , intent(inout) :: eng(3)
      30 !-----------------------------------------------
      31 !   L o c a l   V a r i a b l e s
      32 !-----------------------------------------------
      33       integer :: icalcn, jd, ja, id, ia, j, i, ni, istart, nj, jstart&
      34         , ix, isp, iol, k, ka, kg, l, la, lg, is, ig, m, mn&
      35         , n, kk, ll, kl, mk, nk, ml, nl, i22
      36       double precision, dimension(3) :: eaa, eab, enuc
      37       double precision, dimension(4) :: bi, bj
      38       double precision ::  r2, rij, r0, rr, del1, termaa, termab&
      39         , del2, del3, c1, termnc, &
      40         part1, part2, part3, f3, dd, anam1, termk, bb, aa
      41       logical :: am1
      42
      43       save icalcn, am1
      44 !-----------------------------------------------
      45 !**********************************************************************
 *
      46 !
 *
      47 !         CALCULATION OF ANALYTICAL DERIVATIVES
 *
      48 !
 *
      49 !**********************************************************************
 *
      50       data icalcn/ 0/
 
 FORCHECK PC V13.5.13          ANALYT          2021-03-24 10:59:30   page:  3670
 analyt.F90  /FF
 
      51       if (icalcn /= numcal) then
      52         icalcn = numcal
      53         am1 = index(keywrd,'AM1') + index(keywrd,'PM3') /= 0
      54       end if
      55       jd = jjd - jja + 1
      56       ja = 1
      57       id = iid - iia + 1 + jd
      58       ia = jd + 1
      59       eaa = 0.0D0
      60       eab = 0.0D0
      61       enuc = 0.0D0
      62       eng = 0.0D0
      63       i = 2
      64       ni = nat(i)
      65       istart = nztype(ni)*4 - 3
      66       j = 1
      67       nj = nat(j)
      68       jstart = nztype(nj)*4 - 3
      69       r2 = (coord(1,i)-coord(1,j))**2 + (coord(2,i)-coord(2,j))**2 + (c
 oord(3,i&
      70         )-coord(3,j))**2
      71       rij = sqrt(r2)
      72       r0 = rij/a0
      73       rr = r2/(a0*a0)
      74       do ix = 1, 3
      75         del1 = coord(ix,i) - coord(ix,j)
      76         termaa = 0.0D0
      77         termab = 0.0D0
      78         isp = 0
      79         iol = 0
      80 !   THE FIRST DERIVATIVES OF OVERLAP INTEGRALS
      81         do k = ia, id
      82           ka = k - ia
      83           kg = istart + ka
      84           do l = ja, jd
      85             la = l - ja
      86             lg = jstart + la
      87             iol = iol + 1
      88             ds(iol) = 0.0D0
      89             if (ka==0 .and. la==0) then
      90 !   (S/S) TERM
      91               if (abs(del1) <= 1.0D-6) cycle
      92               is = 1
      93             else if (ka==0 .and. la>0) then
      94 !   (S/P) TERM
      95               is = 3
      96               if (ix == la) go to 20
      97               if (abs(del1) <= 1.0D-6) cycle
      98               is = 2
      99               del2 = coord(la,i) - coord(la,j)
     100             else if (ka>0 .and. la==0) then
     101 !   (P/S) TERM
     102               is = 5
     103               if (ix == ka) go to 20
     104               if (abs(del1) <= 1.0D-6) cycle
     105               is = 4
     106               del2 = coord(ka,i) - coord(ka,j)
     107             else
     108 !   (P/P) TERM
 
 FORCHECK PC V13.5.13          ANALYT          2021-03-24 10:59:30   page:  3671
 analyt.F90  /FF
 
     109               if (ka == la) then
     110 !    P/P
     111                 is = 9
     112                 if (ix == ka) go to 20
     113                 if (abs(del1) <= 1.0D-6) cycle
     114 !    P'/P'
     115                 is = 8
     116                 del2 = coord(ka,i) - coord(ka,j)
     117               else if (ix/=ka .and. ix/=la) then
     118 !    P'/P"
     119                 if (abs(del1) <= 1.0D-6) cycle
     120                 is = 7
     121                 del2 = coord(ka,i) - coord(ka,j)
     122                 del3 = coord(la,i) - coord(la,j)
     123               else
     124 !    P/P' OR P'/P
     125                 del2 = coord(ka+la-ix,i) - coord(ka+la-ix,j)
     126                 is = 6
     127               end if
     128             end if
     129 !
     130 !        CALCULATE OVERLAP DERIVATIVES, STORE RESULTS IN DS
     131 !
     132    20       continue
     133             call ders (kg, lg, rr, del1, del2, del3, is, iol)
     134           end do
     135         end do
     136         if (ix==1) read (irot) (g(i22),i22=1,22)
     137         call delri (dg, ni, nj, r0, del1)
     138         call delmol (coord, i, j, ni, nj, ia, id, ja, jd, ix, rij, del1
 , isp)
     139 !
     140 !   THE FIRST DERIVATIVE OF NUCLEAR REPULSION TERM
     141 !
     142 !      CORE-CORE TERMS, MNDO AND AM1
     143 !
     144 !
     145 !  SPECIAL TREATMENT FOR N-H AND O-H TERMS
     146 !
     147           if (rij<1.D0 .and. natorb(ni)*natorb(nj)==0) then
     148             termnc = 0.D0
     149             go to 50
     150           end if
     151           c1 = tore(ni)*tore(nj)
     152           if (ni==1 .and. (nj==7 .or. nj==8)) then
     153             f3 = 1.0D0 + exp((-alp(1)*rij)) + rij*exp((-alp(nj)*rij))
     154             dd = (dg(1)*f3-g(1)*(del1/rij)*(alp(1)*exp((-alp(1)*rij))+(
 alp(&
     155               nj)*rij-1.0D0)*exp((-alp(nj)*rij))))*c1
     156           else if ((ni==7 .or. ni==8) .and. nj==1) then
     157             f3 = 1.0D0 + exp((-alp(1)*rij)) + rij*exp((-alp(ni)*rij))
     158             dd = (dg(1)*f3-g(1)*(del1/rij)*(alp(1)*exp((-alp(1)*rij))+(
 alp(&
     159               ni)*rij-1.0D0)*exp((-alp(ni)*rij))))*c1
     160           else
     161 !
     162 !  SPECIAL CASE OF TWO SPARKLES
