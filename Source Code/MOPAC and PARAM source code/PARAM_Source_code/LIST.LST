      12     integer :: i, i1, ii, ij, imax, io, ipq, is_loc, j, j1, jj, jo, jpq
 , js, &
      13    & ks, l, l1, l2, lsp
      14     double precision :: delx, dely, delz, r, rmin, sum
      15     integer, dimension (4), save :: isp
      16     integer, dimension (5, 10), save :: irot
      17     double precision, dimension (3) :: xjuc
      18     double precision, dimension (4) :: sigpi
      19     double precision, dimension (4, 4) :: arot, pab, vect
      20     double precision, dimension (3, 5, 5) :: c
      21     integer, external :: ijbo
      22     data irot / 1, 1, 1, 3, 3, 2, 2, 2, 4, 3, 3, 2, 2, 2, 3, 4, 2, 2, 3
 , 3, 2, &
      23    & 3, 2, 4, 2, 3, 3, 2, 2, 2, 4, 3, 2, 3, 2, 2, 4, 2, 4, 4, 3, 4, 2,
 2, 4, &
      24    & 4, 4, 2, 3, 4 /
      25     data isp / 1, 2, 3, 3 /
      26     blank = " "
      27     if (maxtxt /= 0) then
      28       write (iw, "(2A)") blank(:maxtxt/2 + 3)//"ATOM"//blank(:maxtxt +
 4)//"ATOM" //&
      29       & blank(:maxtxt/2 + 7)//"s-s Sig  s-p Sig  p-p Sig  p-p Pi"
      30     else
      31       write (iw, "(2A)") "   ATOM    ATOM    S-S (Sig) " // &
      32                        & "  S-P (Sig)   P-P (Sig)    P-P (PI)"
      33     end if
      34     write (iw,*)
      35     imax = maxtxt + 10
      36     pab(:,:) = 0.d0
      37     do i = 1, numat
      38       io = min(iorbs(i),4)  !  Sometime this subroutine should be expan
 ded to include "d" orbitals
      39       first = .true.
      40       ipq = Max (1, io-2)
      41       do j = 1, numat
      42         if (i /= j .and. ijbo (i, j) >= 0) then
      43           ij = ijbo (i, j)
      44           jo = min(iorbs(j),9)
      45           jpq = Max (1, jo-2)
      46           if (id == 0) then
      47             delx = coord(1, j) - coord(1, i)
      48             dely = coord(2, j) - coord(2, i)
      49             delz = coord(3, j) - coord(3, i)
      50           else
      51             rmin = 1.d6
      52             do is_loc = -l1u, l1u
      53               do js = -l2u, l2u
 
