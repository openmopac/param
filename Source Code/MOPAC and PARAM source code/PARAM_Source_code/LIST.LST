       2       subroutine mullik()
       3 !-----------------------------------------------
       4 !   M o d u l e s
       5 !-----------------------------------------------
       6 !
       7       use molkst_C, only : numat, nelecs, nclose, nopen, fract,  &
       8         keywrd, norbs, id, verson, method_pm6, uhf, nalpha, nbeta, &
       9         numcal, escf, line
      10 !
      11       use symmetry_C, only : jndex, namo
      12 !
      13       use maps_C, only : rxn_coord
      14 !
      15       use common_arrays_C, only : nfirst, nlast, nat, coord, &
      16       & c, h, pb, tvec, eigs, q, eigb, p, ifact, cb
      17 !
      18       use parameters_C, only : zs, zp, zd, betas, betap, tore
      19 !
      20       use chanel_C, only : igpt, gpt_fn, iw
      21 !
      22       implicit none
      23 !-----------------------------------------------
      24 !   L o c a l   V a r i a b l e s
      25 !-----------------------------------------------
      26       integer :: i, if, il, im1, k, ii, j, jf, jl, ij, icalcn=0, mo_l,
 mo_u
      27       character, dimension(:), allocatable :: namo_tmp*4
      28       character :: paras*1
      29       double precision, dimension(norbs) :: eig
      30       double precision, dimension(:), allocatable :: store, vecs, store
 _h
      31       double precision, dimension(:, :), allocatable :: work
      32       double precision :: bi, bj, sum, summ, q2(numat)
      33       logical :: graph, graph_formatted, namo_ok
      34 ! GBR_new_addition
      35       integer :: nlower
      36 !
      37       save :: graph, graph_formatted, icalcn, mo_l, mo_u
      38 !
      39
      40 !-----------------------------------------------
      41 !*********************************************************************
      42 !
      43 !  MULLIK DOES A MULLIKEN POPULATION ANALYSIS
      44 ! ON INPUT     C      =  SQUARE ARRAY OF EIGENVECTORS.
      45 !              H      =  PACKED ARRAY OF ONE-ELECTRON MATRIX
      46 !              VECS   =  WORKSTORE OF SIZE AT LEAST NORBS*NORBS
      47 !              STORE  =  WORKSTORE OF SIZE AT LEAST (NORBS*(NORBS+1))/2
      48 !
      49 !*********************************************************************
      50
      51
      52      allocate(store((norbs*(norbs + 1))/2), store_h((norbs*(norbs + 1))
 /2), &
      53        vecs(norbs**2), stat = i)
      54      if (i /= 0) then
      55         write(iw,*)" Unable to allocate memory for eigenvector matrices
  in MULLIK"
 
 FORCHECK PC V13.5.13          MULLIK          2021-03-24 10:59:30   page:  3644
 mullik.F90  /FF
 
      56         call mopend("Unable to allocate memory for eigenvector matrices
  in MULLIK")
      57         return
      58       end if
      59 !*********************************************************************
      60 !
      61 !  FIRST, RE-CALCULATE THE OVERLAP MATRIX
      62 !
      63 !*********************************************************************
      64       if (icalcn /= numcal) then
      65         icalcn = numcal
      66         graph = index(keywrd,'GRAPH') /= 0
      67         graph_formatted = index(keywrd,'GRAPHF') /= 0
      68         if (allocated(ifact)) deallocate(ifact)
      69         allocate (ifact(norbs + 1))
      70         do i = 1, norbs
      71           ifact(i) = (i*(i - 1))/2
      72         end do
      73         ifact(norbs+1) = (norbs*(norbs + 1))/2
      74         if (graph) then
      75           close (unit=igpt, iostat=i)
      76           if (graph_formatted) then
      77             open(unit=igpt, file=gpt_fn(:len_trim(gpt_fn) - 3)//"mgf",
 form='FORMATTED', &
      78               status="UNKNOWN", iostat = i)
      79           else
      80             open(unit=igpt, file=gpt_fn, form='UNFORMATTED', status="UN
 KNOWN", iostat = i)
      81           end if
      82           if (i /= 0) then
      83             write(iw,*)" File '"//gpt_fn(:len_trim(gpt_fn))//"' is unav
 ailable for use"
      84             call mopend("File '"//gpt_fn(:len_trim(gpt_fn))//"' is unav
 ailable for use")
      85             return
      86           end if
      87           rewind igpt
      88         end if
      89         mo_l = 1
      90         mo_u = norbs
      91       end if
      92       call chrge (p, q2)
      93       do i = 1, numat
      94         q(i) = tore(nat(i) ) - q2(i)
      95       end do
      96       store_h = h
      97       do i = 1, numat
      98         if = nfirst(i)
      99         il = nlast(i)
     100         im1 = i - 1
