       1       subroutine bonds()
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE molkst_C, only : norbs, numat, nopen, fract, nclose, nelecs,
 nalpha, &
       6       nbeta, keywrd, mozyme, maxtxt
       7       use common_arrays_C, only : nfirst, nlast, nat, p, c, pa, pb, cb,
  bondab
       8       USE parameters_C, only : tore
       9       USE chanel_C, only : iw
      10 !**********************************************************************
 *
      11 !-----------------------------------------------
      12 !   I n t e r f a c e   B l o c k s
      13 !-----------------------------------------------
      14       implicit none
      15 !-----------------------------------------------
      16 !   G l o b a l   P a r a m e t e r s
      17 !-----------------------------------------------
      18 !-----------------------------------------------
      19 !   D u m m y   A r g u m e n t s
      20 !-----------------------------------------------
      21       double precision, allocatable  :: b(:,:),  sdm(:), aux(:,:), &
      22       pspin(:), spinab(:)
      23
      24 !-----------------------------------------------
      25 !   L o c a l   P a r a m e t e r s
      26 !-----------------------------------------------
      27 !-----------------------------------------------
      28 !   L o c a l   V a r i a b l e s
      29 !-----------------------------------------------
      30       integer :: nopn, k, i, j, n, m, mu, l, ij, ll, kk, il, ih, &
      31         ilih, ibab(100)
      32       double precision, dimension(numat) :: spna, v, fv, sq, aq, tq, pm
 , sp, sd, &
      33         spsa, spsq
      34       double precision :: zkappa, sum, a, x, da, aa, valenc, bab(100),
 sumlim
      35       logical :: ci, nci, kci, lall
      36 !-----------------------------------------------
      37 !
      38 !*********************************************************************
      39 !   CALCULATES AND PRINTS THE BOND INDICES AND VALENCIES OF ATOMS
      40 !   FOR REFERENCE, SEE "BOND INDICES AND VALENCY", J.C.S.DALTON,
      41 !   ARMSTRONG,D.R., PERKINS,P.G. AND STEWART,J.J.P., 838 (1973)
      42 !
      43 !  ON INPUT
      44 !           P = DENSITY MATRIX, LOWER HALF TRIANGLE, PACKED.
      45 !               P IS NOT ALTERED BY BONDS
      46 !
      47 !*********************************************************************
      48       if (mozyme) then
      49         call bonds_for_MOZYME()
      50         return
      51       end if
      52 !
      53       i = (numat*(numat + 1))/2
 
 FORCHECK PC V13.5.13          BONDS           2021-03-24 10:59:30   page:  3415
 bonds.F90  /FF
 
      54       j = (norbs*(norbs + 1))/2
      55       if (allocated(bondab)) deallocate(bondab)
      56       allocate (b(norbs,norbs), bondab(i), sdm(j), aux(numat,numat), &
      57       pspin(j), spinab(i))
      58       ci = index(keywrd,'C.I.') + index(keywrd,'MECI') /= 0
      59       kci = index(keywrd,'MICROS') == 0
      60       nci = index(keywrd,'ROOT') + index(keywrd,'OPEN') == 0
      61       nopn = nopen - nclose
      62       nelecs = nclose + nclose + nopn + nalpha + nbeta
      63       lall = (Index (keywrd, " ALLBOND") /= 0)
      64       sumlim = 0.01d0                  !  Report all bonds greater than
  0.01 not involving hydrogen
      65       if (lall) sumlim = sumlim*0.1d0  !  Report all bonds greater than
  0.001
      66 !*****   CALCULATE THE DEGREE OF BONDING   ************
      67 !
      68       k = 0
      69       do i = 1, norbs
      70         do j = 1, i
      71           k = k + 1
      72           b(i,j) = p(k)
      73           b(j,i) = p(k)
      74         end do
      75       end do
      76 !
      77 ! *******  CALCULATE KAPPA FACTOR FOR UHF OR ROHF  ******************
      78 !
      79       if (index(keywrd,'UHF') /= 0) then
      80 !****** UHF CASE
      81         zkappa = 0.D0
      82         do n = 1, nalpha
      83           do m = 1, nbeta
      84             sum = 0.D0
      85             do mu = 1, norbs
      86               sum = sum + c(mu,n)*cb(mu,m)
      87             end do
      88             zkappa = zkappa + sum**2
      89           end do
      90         end do
      91         zkappa = 1.D0/(zkappa/dble(nalpha + nbeta) + 0.5D0)
      92       else
      93         if (.not.ci .and. nopn==0 .and. nci .and. kci) then
      94           zkappa = 1.D0
      95         else
      96 !****** ROHF CASE
      97           zkappa = 1.D0/(1.D0 - (dble(nopn)/dble(nelecs))/2.D0)
      98         end if
      99       end if
     100       ij = 0
     101       do i = 1, numat
     102         a = 0.0D00
     103         l = nfirst(i)
     104         ll = nlast(i)
     105         do j = 1, i
     106           ij = ij + 1
     107           k = nfirst(j)
     108           kk = nlast(j)
     109           x = 0.0D0
     110           do il = l, ll
 
 FORCHECK PC V13.5.13          BONDS           2021-03-24 10:59:30   page:  3416
 bonds.F90  /FF
 
     111             do ih = k, kk
     112               x = x + b(il,ih)*b(il,ih)
     113             end do
     114           end do
     115           bondab(ij) = x
     116         end do
     117         x = -bondab(ij)
     118         do j = l, ll
     119           a = a + b(j,j)
     120           x = x + 2.D0*b(j,j)
     121         end do
     122         v(i) = x
     123         sd(i) = a
     124       end do
     125 !
     126 !
     127 ! ***** CALCULATE ACTIVE CHARGE (AQ), SELF CHARGE (SQ), FREE VALENCE(FV
 )
     128 !        TOTAL CHARGE (TQ), MULLIKEN TYPE PROMOTION (PM) AND STATISTICA
 L
     129 !          PROMOTION (SP)  ********************************************
     130 !
     131       k = 0
     132       do i = 1, numat
     133         do j = 1, i
     134           k = k + 1
     135           bondab(k) = bondab(k)*zkappa
     136           aux(i,j) = bondab(k)
     137           aux(j,i) = bondab(k)
     138         end do
     139         bondab(k) = v(i)
     140       end do
     141       do i = 1, numat
     142         da = 0.0D0
     143         do j = 1, numat
     144           if (j == i) cycle
     145           da = da + aux(i,j)
     146         end do
     147         aq(i) = da
     148         sq(i) = (aux(i,i)-da)/2.D00
     149         fv(i) = v(i) - aq(i)
     150         tq(i) = aq(i) + sq(i)
     151         pm(i) = sd(i) - tore(nat(i))
     152         sp(i) = tq(i) - tore(nat(i))
     153       end do
     154 !
     155 !
     156 !  ********   OUTPUT    *****************
     157 !
     158 !
     159       write (iw, '(2/)')
     160       if (maxtxt > 25) then
     161         write (iw, '(1X,2/37X,"(VALENCIES)",1x,"BOND ORDER       TO",/)
 ')
     162       else
     163         write (iw, '(1X,2/12X,"(VALENCIES)   BOND ORDERS",/)')
     164       end if
     165       do i = 1, numat
     166         l = 0
 
 FORCHECK PC V13.5.13          BONDS           2021-03-24 10:59:30   page:  3417
 bonds.F90  /FF
 
     167         valenc = aux(i,i)
     168         aux(i,i) = 0.d0
     169         do j = 1, numat
     170           if (aux(i,j) > sumlim) then
     171             l = l + 1
     172             ibab(l) = j
     173             bab(l) = aux(i,j)
     174           end if
     175         end do
     176         aux(i,i) = valenc
     177         call print_bonds_compact(i,l, v(i), bab, ibab)
     178       end do
     179   !    call vecprt (bondab, numat)
     180
     181   call to_screen("To_file: Bonds")
     182       if (index(keywrd,' LARGE') == 0) return
     183       write (iw, '(3/)')
     184       write (iw, '(A)') ' SELF-Q:    SELF OR INACTIVE CHARGE'
     185       write (iw, '(A)') ' ACTIV-Q:   CHARGE WHICH IS USED TO FORM BONDS
 '
     186       write (iw, '(A)') ' TOTAL-Q:   SELF-Q + ACTIV-Q'
     187       write (iw, '(A)') ' FREE-VA:   TOTAL-Q - VALENCE'
     188       write (iw, '(A)') ' STAT.PROM: TOTAL-Q - CORE CHARGE'
     189       write (iw, '(A)') ' MULL.PROM: -CHARGE (SEE ABOVE)'
     190       write (iw, &
     191       '(/,7X,''SELF-Q'',4X,''ACTIV-Q'',3X,''TOTAL-Q'',3X,   ''VALENCE''
 ,3X,'&
     192       &'FREE-VA'',1X,''STAT.PROM'',1X,''MULL.PROM'',2/)')
     193       write (iw, '(I4,7F10.5/)') (i,sq(i),aq(i),tq(i),v(i),fv(i),sp(i),
 pm(i)&
     194         ,i=1,numat)
     195 !****** PERFORM SPIN POPULATION STATISTICAL ANALYSIS
     196       if (index(keywrd,'UHF') == 0) then
     197         if (.not.ci .and. nopn==0 .and. nci .and. kci) then
     198           write (iw, '(1X,''CLOSED SHELL'',2/)')
     199           return
     200         else
     201           call dopen (c, norbs, norbs, nclose, nopen, fract, sdm)
     202           pspin = sdm
     203 !       WRITE(IW,'(1X,''SDM'',10E12.3)')(SDM(J),J=1,LINEAR)
     204           write (iw, '(1X,''ROHF'',2/)')
     205           go to 160
     206         end if
     207       end if
     208       write (iw, '(1X,''UHF '',2/)')
     209       pspin = pa - pb
     210       sum = 0.D0
     211       l = 0
     212       do i = 1, norbs
     213         do j = 1, i
     214           aa = 2.D0
     215           if (i == j) aa = 1.D0
     216           l = l + 1
     217           sum = sum + aa*(pspin(l)*p(l))
     218         end do
     219       end do
     220       write (iw, '(2/)')
     221       write (iw, '(10X,''NALPHA-NBETA= '',F10.5,2/)') sum
     222   160 continue
 
 FORCHECK PC V13.5.13          BONDS           2021-03-24 10:59:30   page:  3418
 bonds.F90  /FF
 
     223       write (iw, '(1X,''OPEN SHELL & UHF CASE'',2/)')
     224 !#      WRITE(IW,'(1X,10X,51(''* '')//1X,10X,''* '',9X,''STATISTICAL SP
 I
     225 !#     + POPULATION ANALYSIS'',9X,''* '',//1X,10X,51(''* ''))')
     226 ! EVALUATE  THE CORRESPONDING INACTIVE ATOMIC AND BOND SPIN POPULATIONS
     227       ij = 0
     228       do i = 1, numat
     229         l = nfirst(i)
     230         ll = nlast(i)
     231         do j = 1, i
     232           ij = ij + 1
     233           k = nfirst(j)
     234           kk = nlast(j)
     235           x = 0.D0
     236           do il = l, ll
     237             do ih = k, kk
     238               if (il >= ih) then
     239                 ilih = (il*(il - 1))/2 + ih
     240               else
     241                 ilih = (ih*(ih - 1))/2 + il
     242               end if
