 |ij] ****
     811                 call inttr (i1, i1, j1, j1, c, gamma, nbtmo, j12, k12,
 0)
     812
     813                 if (nel(i).eq.1) then
     814                   if (nel(j).eq.1) then
     815 !                   **** only one electron in each orbital ****
     816                     e1 = e1 + j12
     817                     if (ao1(i, idet) .eqv. ao1(j, idet))&
     818      &                e1 = e1 - k12
     819                   else
     820 !                   **** one double occ, one single ****
     821                     e1 = e1 + 2.D0*j12 - k12
     822                   end if
     823                 else
     824                   if (nel(j).eq.1) then
     825 !                   **** one double occ, one single ****
     826                     e1 = e1 + 2.D0*j12 - k12
     827                   else
     828 !                   **** both double occ ****
     829                     e1 = e1 + 4.D0*j12 - 2.D0*k12
     830                   end if
     831                 end if
     832               end if
     833             end do
     834
     835           end if
     836         end do
     837 ! RMG - add solvent correction
     838         ediel = 0.D0
