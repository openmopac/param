    2239       subroutine epsab(eigsab, eigs, gab, ga, gb, ua, ub, uab, udms, no
 rbs, &
    2240         nclose, iwflb)
    2241 !-----------------------------------------------
    2242 !   M o d u l e s
    2243 !-----------------------------------------------
    2244       use funcon_C, only : ev
    2245       USE polar_C, only : omega
    2246 !-----------------------------------------------
    2247 !   I n t e r f a c e   B l o c k s
    2248 !-----------------------------------------------
    2249       implicit none
    2250 !-----------------------------------------------
    2251 !   D u m m y   A r g u m e n t s
    2252 !-----------------------------------------------
    2253       integer  :: norbs
    2254       integer , intent(in) :: nclose
    2255       integer , intent(in) :: iwflb
    2256       double precision  :: eigsab(norbs,norbs)
    2257       double precision , intent(in) :: eigs(norbs)
    2258       double precision , intent(in) :: gab(norbs,norbs)
    2259       double precision , intent(in) :: ga(norbs,norbs)
    2260       double precision , intent(in) :: gb(norbs,norbs)
    2261       double precision , intent(in) :: ua(norbs,norbs)
    2262       double precision , intent(in) :: ub(norbs,norbs)
    2263       double precision , intent(in) :: uab(norbs,norbs)
    2264       double precision  :: udms(norbs,norbs)
    2265 !-----------------------------------------------
    2266 !   L o c a l   V a r i a b l e s
    2267 !-----------------------------------------------
    2268       integer :: i, j
    2269       double precision :: hartr, omval, s1, s2
    2270 !-----------------------------------------------
    2271 !
    2272 !  THIS SUBROUTINE CREATES THE NEW EPSILON MATRIX AND UDMS MATRIX
    2273 !
    2274       hartr = ev
    2275       omval = 0.d0
    2276 !
    2277 !  ZERO EPSILON OMEGA OMEGA MATRIX INITIALLY
    2278 !
    2279       call zerom (eigsab, norbs)
    2280 !
    2281 !  ZERO UAB MINUS OMEGA,OMEGA MATRIX INITIALLY
    2282 !
    2283       call zerom (udms, norbs)
    2284 !
    2285       if (iwflb==0 .or. iwflb==1) then
    2286         omval = 2.0D00*omega
    2287       else if (iwflb == 3) then
    2288         omval = 0.0D00
    2289       else if (iwflb == 2) then
    2290         omval = omega
    2291       end if
    2292       do i = 1, nclose
    2293         do j = 1, nclose
    2294           s1 = 0.0D00
    2295 !
 
 FORCHECK PC V13.5.13          EPSAB           2021-03-24 10:59:30   page:  2632
 polar.F90  /FF
 
    2296 ! CALCULATION FOR EPSAB
    2297 !
    2298           s1 = sum(ga(i,nclose+1:norbs)*ub(nclose+1:norbs,j)+gb(i,nclos
 e+1:&
    2299             norbs)*ua(nclose+1:norbs,j))
    2300 !
    2301           eigsab(i,j) = gab(i,j) + s1 + uab(i,j)*(eigs(i)-eigs(j)+omval
 )/hartr
    2302         end do
    2303       end do
    2304 !
    2305 ! CALCULATION FOR UMS
    2306 !
    2307       do i = 1, norbs
    2308         do j = 1, norbs
    2309           s2 = 0.0D00
    2310           s2 = sum(ua(i,:norbs)*ub(:norbs,j)+ub(i,:norbs)*ua(:norbs,j))
    2311 !
    2312           udms(i,j) = s2 - uab(i,j)
    2313         end do
    2314       end do
    2315 !
    2316       return
    2317       end subroutine epsab
 
