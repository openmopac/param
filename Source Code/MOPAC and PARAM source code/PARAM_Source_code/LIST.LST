       1       subroutine matou1(a, b, ncx, nr, ndim, iflag)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use molkst_C, only : numat, norbs, nalpha, nclose, keywrd
       6       use common_arrays_C, only : nfirst, nlast, nat
       7       use chanel_C, only : iw
       8       use elemts_C, only : elemnt
       9       use to_screen_C, only : to_a, to_b
      10       USE symmetry_C, only :  jndex, namo
      11 !**********************************************************************
 *
      12 !-----------------------------------------------
      13 !   I n t e r f a c e   B l o c k s
      14 !-----------------------------------------------
      15       implicit none
      16 !-----------------------------------------------
      17 !   D u m m y   A r g u m e n t s
      18 !-----------------------------------------------
      19       integer , intent(in) :: ncx
      20       integer , intent(inout) :: nr
      21       integer , intent(in) :: ndim
      22       integer , intent(in) :: iflag
      23       double precision , intent(in) :: a(nr,nr)
      24       double precision , intent(in) :: b(ndim)
      25
      26 !-----------------------------------------------
      27 !   L o c a l   V a r i a b l e s
      28 !-----------------------------------------------
      29       integer , dimension(nr) :: natom
      30       integer :: nc, nsave, nfix, i, jlo, jhi, l, j, ka, kc, kb, la, lc
 , lb, &
      31         nup, ndown
      32       logical :: allprt
      33       character , dimension(9) :: atorbs*2
      34       character , dimension(nr) :: itext*2, jtext*2
      35       character, dimension(3) :: xyz*2
      36
      37       save atorbs, xyz
      38 !-----------------------------------------------
      39 !**********************************************************************
      40 !
      41 !      MATOUT PRINTS A SQUARE MATRIX OF EIGENVECTORS AND EIGENVALUES
      42 !
      43 !    ON INPUT A CONTAINS THE MATRIX TO BE PRINTED.
      44 !             B CONTAINS THE EIGENVALUES.
      45 !             NC NUMBER OF MOLECULAR ORBITALS TO BE PRINTED.
      46 !             NR IS THE SIZE OF THE SQUARE ARRAY TO BE PRINTED.
      47 !             NDIM IS THE ACTUAL SIZE OF THE SQUARE ARRAY "A".
      48 !             NFIRST AND NLAST CONTAIN ATOM ORBITAL COUNTERS.
      49 !             NAT = ARRAY OF ATOMIC NUMBERS OF ATOMS.
      50 !
      51 !
      52 !     OUTPUT TYPE (ROW LABELING)
      53 !       IFLAG=1 : ORBITALS
      54 !       IFLAG=2 : ORBITALS + SYMMETRY-DESIGNATORS
      55 !       IFLAG=3 : ATOMS
      56 !       IFLAG=4 : NUMBERS ONLY
 
 FORCHECK PC V13.5.13          MATOU1          2021-03-24 10:59:30   page:  3946
 matou1.F90  /FF
 
      57 !       IFLAG=5 : VIBRATIONS + SYMMETRY-DESIGNATIONS
      58 !
      59 !
      60 !**********************************************************************
 *
      61       data xyz/ ' x', ' y', ' z'/
      62       data atorbs/ 'S ', 'Px', 'Py', 'Pz', 'x2', 'xz', 'z2', 'yz', 'xy'
 /
      63 !      -------------------------------------------------
      64       nfix = 0
      65       allprt = index(keywrd,'ALLVEC') /= 0
      66       i = index(keywrd," VECTORS")
      67       nup = 7
      68       ndown = 9
      69       if (i > 0) then
      70         do j = i + 1, i + 20
      71           if (keywrd(j:j) == " ") exit
      72         end do
      73         if (index(keywrd(i:j), ")") > 0) then
      74 !
      75 !  User has specified number of occupied and virtual M.O.s to be printe
 d
      76 !  Format:  VECTORS=(12,34)
      77 !
      78         do i = i + 1, j
      79             if (keywrd(i:i) >= "0" .and. keywrd(i:i) <= "9") exit
      80           end do
      81           ndown = ichar(keywrd(i:i)) - ichar("0")
      82           do i = i + 1, j
      83             if (keywrd(i:i) < "0" .or. keywrd(i:i) > "9") exit
      84             ndown = ndown*10 + ichar(keywrd(i:i)) - ichar("0")
      85           end do
      86           do i = i, j
      87             if (keywrd(i:i) >= "0" .and. keywrd(i:i) <= "9") exit
      88           end do
      89           nup = ichar(keywrd(i:i)) - ichar("0")
      90           do i = i + 1, j
      91             if (keywrd(i:i) < "0" .or. keywrd(i:i) > "9") exit
      92             nup = nup*10 + ichar(keywrd(i:i)) - ichar("0")
      93           end do
      94         end if
      95         ndown = ndown - 1
      96         if (nup == -16) then
      97           nup = (ndown + 1)/2
      98           ndown = ndown - nup
      99         end if
     100       end if
     101       nc = ncx
     102       if (iflag > 2 .and. iflag /= 5) go to 50
     103       if ( .not. allprt) then
     104         nsave = ncx
     105         nfix = max(nalpha,nclose)
     106         if (iflag == 2 .and. nc > 16) nc = nfix + nup
     107         nc = min0(nsave,nc)
     108       end if
     109       if (numat == 0) go to 50
     110       if (nlast(numat) /= nr) go to 50
     111       do i = 1, numat
     112         jlo = nfirst(i)
 
 FORCHECK PC V13.5.13          MATOU1          2021-03-24 10:59:30   page:  3947
 matou1.F90  /FF
 
     113         jhi = nlast(i)
     114         l = nat(i)
     115         if (iflag <= 2) then
     116           itext(jlo:jhi) = atorbs(:jhi-jlo+1)
     117           jtext(jlo:jhi) = elemnt(l)
     118           natom(jlo:jhi) = i
     119         else
     120           jhi = 3*(i - 1)
     121           itext(1+jhi:3+jhi) = xyz
     122           jtext(1+jhi:3+jhi) = elemnt(l)
     123           natom(1+jhi:3+jhi) = i
     124         end if
     125       end do
     126       go to 70
     127    50 continue
     128       nr = abs(nr)
     129       if (iflag == 3) then
     130         do i = 1, nr
     131           itext(i) = '  '
     132           jtext(i) = elemnt(nat(i))
     133           natom(i) = i
     134         end do
     135       else
     136         do i = 1, nr
     137           itext(i) = '  '
     138           jtext(i) = '  '
     139           natom(i) = i
     140         end do
     141       end if
     142    70 continue
     143       ka = 1
     144       kc = 8
     145       if (.not.allprt) then
     146         if (iflag == 2 .and. norbs > 16) ka = nfix - ndown
     147         ka = max0(1,ka)
     148         if (iflag == 2 .and. norbs > 16) kc = ka + 7
     149       end if
     150    90 continue
     151       kb = min0(kc,nc)
     152       write (iw, 130) (i,i=ka,kb)
     153       if (iflag == 2 .or. iflag == 5) write (iw, 180) (jndex(i),namo(i)
 ,i=ka,kb)
     154       if (b(1) /= 0.D0) then
     155         if (iflag == 5) then
     156           write (iw, 150) (b(i),i=ka,kb)
     157         else
     158           write (iw, 140) (b(i),i=ka,kb)
     159         end if
     160       end if
     161       write (iw, 160)
     162       la = 1
     163       lc = 40
     164   100 continue
     165       lb = min0(lc,nr)
     166       do i = la, lb
     167         if (itext(i) == ' S') write (iw, 160)
     168         write (iw, 170) itext(i), jtext(i), natom(i), (a(i,j),j=ka,kb)
     169       end do
     170       if (lb == nr) go to 120
 
 FORCHECK PC V13.5.13          MATOU1          2021-03-24 10:59:30   page:  3948
 matou1.F90  /FF
 
     171       la = lc + 1
     172       lc = lc + 40
     173       go to 100
     174   120 continue
     175       if (kb == nc) then
     176         if (allocated (to_a)) deallocate(to_a)
     177         if (allocated (to_b)) deallocate(to_b)
     178         allocate(to_a(nr,nr), to_b(ndim))
     179         to_a = a
     180         to_b = b
     181         deallocate(to_a, to_b)
     182         return
     183       end if
     184       ka = kc + 1
     185       kc = kc + 8
     186       go to 90
     187
     188   130 format(/,/,2x,' Root No.',i8,11i10)
     189   140 format(/,12x,10f10.3)
     190   150 format(/,12x,10f10.1)
     191   160 format('  ')
     192   170 format(' ',2(1x,a2),i5,f10.4,10f10.4)
     193   180 format(/,13x,10(i5,1x,a4))
     194       end subroutine matou1
 
