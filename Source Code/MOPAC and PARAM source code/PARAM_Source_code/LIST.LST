       1       subroutine superd(c, eigs, norbs, nelecs, numat, nat)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use chanel_C, only : iw
       6       use elemts_C, only : elemnt
       7       use parameters_C, only: natorb
       8       implicit none
       9 !-----------------------------------------------
      10 !   D u m m y   A r g u m e n t s
      11 !-----------------------------------------------
      12       integer , intent(in) :: norbs
      13       integer , intent(in) :: nelecs
      14       integer , intent(in) :: numat
      15       integer , intent(in) :: nat(numat)
      16       double precision , intent(in) :: c(norbs,norbs)
      17       double precision , intent(in) :: eigs(norbs)
      18 !-----------------------------------------------
      19 !   L o c a l   V a r i a b l e s
      20 !-----------------------------------------------
      21       integer :: ihomo, isize, i, ii, k, j, l, ll
      22       double precision, dimension(4) :: orb
      23       double precision :: alpha, totloc, totnuc, cdens, deloc, denuc, s
 eltot, &
      24         selpol, sum
      25 !-----------------------------------------------
      26       ihomo = nelecs/2
      27       isize = norbs
      28       alpha = (eigs(ihomo)+eigs(ihomo+1))/2.D0
      29       write (iw, '(A,F12.6)') ' Mulliken electronegativity:    ', (-alp
 ha)
      30       write (iw, '(A,F12.6)') ' Parr & Pople absolute hardness:', (eigs
 (ihomo+1&
      31         )-eigs(ihomo))/2.D0
      32       write (iw, '(A,F12.6)') ' Schuurmann MO shift alpha:     ', alpha
      33       write (iw, *)
      34       write (iw, '(A,F12.6)') ' Ehomo:                         ', eigs(
 ihomo)
      35       write (iw, '(A,F12.6)') ' Elumo:                         ', eigs(
 ihomo+1)
      36       write (iw, '(2/,A,/)') '  a   n        Dn(r)        De(r)   q(r)
 - Z(r)'
      37       totloc = 0.D0
      38       totnuc = 0.D0
      39       i = 1
      40       do ii = 1, numat
      41         if (nat(ii) == 1) then
      42           i = i + 1
      43         else
      44 !
      45 !   CALCULATE DELOCALIZABILITY
      46 !
      47           cdens = 0.D0
      48           deloc = 0.D0
      49           denuc = 0.D0
      50           do k = i, i + natorb(nat(ii)) - 1
      51             do j = 1, ihomo
      52               cdens = cdens + c(k,j)*c(k,j)
 
 FORCHECK PC V13.5.13          SUPERD          2021-03-24 10:59:30   page:  3015
 superd.F90  /FF
 
      53               deloc = deloc + c(k,j)*c(k,j)/(eigs(j)-alpha)
      54             end do
      55             do j = ihomo + 1, isize
      56               denuc = denuc - c(k,j)*c(k,j)/(eigs(j)-alpha)
      57             end do
      58           end do
      59           write (iw, '(1X,A2,1X,I3,3F13.6)') elemnt(nat(ii)), ii, 2.D0*
 denuc, &
      60             2.D0*deloc, (-2.D0*cdens)
      61           i = i + 4
      62           totnuc = totnuc + 2.D0*denuc
      63           totloc = totloc + 2.D0*deloc
      64         end if
      65       end do
      66       write (iw, '(/,A,2F13.6)') ' Total:', totnuc, totloc
      67       write (iw, '(/,A,/)') '  a   n        piS(r)'
      68       seltot = 0.D0
      69       i = 1
      70       do ii = 1, numat
      71         if (nat(ii) == 1) then
      72           i = i + 1
      73         else
      74           selpol = 0.D0
      75           do l = i, i + natorb(nat(ii)) - 1
      76             do j = 1, ihomo
      77               do k = ihomo + 1, isize
      78                 selpol = selpol + c(l,j)*c(l,j)*c(l,k)*c(l,k)/(eigs(k)-
 eigs(j))
      79               end do
      80             end do
      81           end do
      82           selpol = -4.D0*selpol
      83           write (iw, '(1X,A2,1X,I3,F13.6)') elemnt(nat(ii)), ii, selpol
      84           seltot = seltot + selpol
      85           i = i + natorb(nat(ii))
      86         end if
      87       end do
      88       write (iw, '(/,A,F13.6,/)') ' Total:', seltot
      89       write (iw, '(A,/)') &
      90         '  a   n       homo-1         homo         lumo       lumo+1'
      91       i = 1
      92       do ii = 1, numat
      93         if (nat(ii) == 1) then
      94           i = i + 1
      95         else
      96           ll = 0
      97           do j = ihomo - 1, ihomo + 2
      98             ll = ll + 1
      99             sum = 0.D0
     100             do l = i, i + natorb(nat(ii)) - 1
     101               sum = sum + c(l,j)*c(l,j)
     102             end do
     103             orb(ll) = sum*100.D0
     104           end do
     105           write (iw, '(1X,A2,1X,I3,4F13.6)') elemnt(nat(ii)), ii, orb
     106           i = i + 4
     107         end if
     108       end do
     109       return
 
