     126           ca = (1.0D0 + sqrt((1.0D0 + ca)/2.0D0))/2.0D0
     127           if ((2.0D0*ca - 1.0D0)*bij < 0.0D0) ca = 1.0D0 - ca
     128           sa = sqrt(1.0D0 - ca)
