     172       end do
     173       if (l >= limit) exit
     174       kk = kk + ll + 4
     175       na = m + 1
     176       if ((kk+numb+1-na) > 50) then
     177         kk = 4
     178       end if
     179     end do
     180     deallocate (a)
     181     return
     182 !
     183 end subroutine vecprt_for_MOZYME
 
