       1 subroutine makvec ()
       2 !
       3 !   Construct the starting occupied and virtual localized molecular orb
 itals.
       4 !   These are on one or two atoms.  The LMOs are stored in
       5 !     Occupied   Virtual
       6 !      cocc        cvir    Coefficients (this is a dilute array)
       7 !      ncocc       ncvir   Starting addresses of LMO coefficients (dens
 e)
       8 !      icocc       icvir   Atoms numbers (this is a dilute array)
       9 !      nncf        nnce    Starting addresses of atom numbers (dense)
      10 !      ncf         nce     Number of atoms in LMOs (dense)
      11 !
      12     use MOZYME_C, only: iorbs, icocc, icvir, nce, ncf, morb, Lewis_elem
 , &
      13          & ncocc, ncvir, nnce, nncf, Lewis_tot, &
      14          & cocc, cvir, partf, cocc_dim, cvir_dim
      15 !
      16     use common_arrays_C, only : nfirst, nlast, pdiag, f, p
      17     use molkst_C, only: numat, norbs, keywrd, moperr, mpack
      18     implicit none
      19     logical :: lok, times
      20     integer :: i, ii, j, jj, k, locc, lvir, m, m1, ne, nf_loc, ni, nj,
 &
      21          & nocc, nvir, alloc_stat, nLewis
      22     double precision, dimension(:,:), allocatable :: catom
      23     integer, dimension(:), allocatable :: iz, ib
      24     logical, dimension (:), allocatable :: u
      25     integer, external :: ijbo
      26     times = (Index (keywrd, " TIMES") /= 0)
      27     !***************************************************************
      28     !
      29     !  Set up starting eigenvector matrix, based on the Fock matrix
      30     !  and the type of atom
      31     !
      32     !***************************************************************
      33     p = 0.d0
      34     m = 0
      35     do i = 1, numat
      36       j = ijbo (i, i)
      37       do k = 1, iorbs(i)
      38         m = m + 1
      39         j = j + k
      40         p(j) = pdiag(m)
      41       end do
      42     end do
      43     if (times) call timer (" After entry to Makvec")
      44     call buildf (f, partf, 0)
      45     if (times) call timer (" After BUILDF in MAKV")
      46    !
      47     allocate (iz(numat), ib(numat), catom(morb, norbs), u(norbs), stat=
 alloc_stat)
      48     if (alloc_stat /= 0) then
      49       call memory_error ("makvec")
      50       go to 1200
      51     end if
      52    !
      53     moperr = .false.
 
 FORCHECK PC V13.5.13          MAKVEC          2021-03-24 10:59:30   page:  1087
 makvec.F90  /FF
 
      54 !
      55 !   Construct hybrid atomic orbitals for each atom. Put these in catom
      56 !
      57     call hybrid (catom)
      58     !
      59     !     Now to make the starting localized molecular orbitals
      60     !
      61     u(:norbs) = .false.
      62     nocc = 0
      63     nvir = 0
      64     nf_loc = 0
      65     ne = 0
      66     locc = 0
      67     lvir = 0
      68     do nLewis = 1, Lewis_tot
      69       ii = Lewis_elem(1, nLewis)
      70       jj = Lewis_elem(2, nLewis)
      71       if (ii > 0 .and. jj > 0) then
      72 !
      73 ! Di-atomic Lewis element
      74 !
      75         ni = nfirst(ii)
      76         nj = nfirst(jj)
      77         call mbonds (locc, lvir, f, catom, nfirst, ii, jj, u(ni), u(nj)
 , &
      78                & lok, iorbs, cocc, cvir, cocc_dim, cvir_dim, numat, nor
 bs, &
      79                & morb, mpack)
      80         if (lok) then
      81           nncf(nocc+1) = nf_loc
      82           nnce(nvir+1) = ne
      83           call mlmo (locc, lvir, ii, jj, nf_loc, ne, nocc, nvir, iz, ib
 , &
      84                  & nce, ncf, ncocc, ncvir, iorbs, icocc, icvir, cocc, c
 vir)
      85         else
      86          ii = 0 ! Use for error trap
      87         end if
      88       else if (ii > 0) then
      89 !
      90 ! Lone pair
      91 !
      92         do k = nlast(ii), nfirst(ii), -1
      93           if ( .not. u(k)) then
      94             u(k) = .true.
      95             m = locc
      96             do m1 = 1, iorbs(ii)
      97               m = m + 1
      98               cocc(m) = catom(m1, k)
      99             end do
     100             nncf(nocc+1) = nf_loc
     101             call mlmo (locc, lvir, ii, 0, nf_loc, ne, nocc, nvir, iz, i
 b, &
     102                & nce, ncf, ncocc, ncvir, iorbs, icocc, icvir, cocc, cvi
 r)
     103             exit
     104           end if
     105         end do
     106       else
 
 FORCHECK PC V13.5.13          MAKVEC          2021-03-24 10:59:30   page:  1088
 makvec.F90  /FF
 
     107 !
     108 ! Virtual Lone pair
     109 !
     110         do k = nlast(jj), nfirst(jj), -1
     111           if ( .not. u(k)) then
     112             u(k) = .true.
     113             m = lvir
     114             do m1 = 1, iorbs(jj)
     115               m = m + 1
     116               cvir(m) = catom(m1, k)
     117             end do
     118             nnce(nvir+1) = ne
     119             call mlmo (locc, lvir, 0, jj, nf_loc, ne, nocc, nvir, iz, i
 b, &
     120                  & nce, ncf, ncocc, ncvir, iorbs, icocc, icvir, cocc, c
 vir)
     121             exit
     122           end if
     123         end do
     124       end if
     125     end do
     126  1200 continue
     127     if (Allocated (iz))   deallocate ( iz, ib, catom, u)
     128 end subroutine makvec
 
