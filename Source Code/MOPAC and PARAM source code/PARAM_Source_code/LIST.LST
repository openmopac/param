     619 !     *****************************************************************
 ********
     620
     621       subroutine cfunct (ia, ib, ic, id, ie, snag)
     622
     623       use reimers_C, only : bincoe, a, b
     624 !      implicit          double precision :: (a - h, o - z)
     625       implicit none
     626       double precision ::   count, b1, b2, b3, b4, b5, b6, snag, term
     627       integer ::            i, i1, i2, i3, i4, i5, i6, &
     628                          ia, ib, ic, id, ie, ip, ir, &
     629                          iab, ibb, icb, idb, ieb, &
     630                          inda, indb, indc, indd, inde, nin
     631
     632       nin(i) = i * (i - 1) / 2
     633
     634       count = 0.0d0
     635       iab = ia + 1
     636       ibb = ib + 1
     637       icb = ic + 1
     638       idb = id + 1
     639       ieb = ie + 1
     640       inde = nin(ieb)
     641       indd = nin(idb)
     642       indc = nin(icb)
     643       indb = nin(ibb)
     644       inda = nin(iab)
     645       do 901 i6 = 1, ieb
     646       b6 = bincoe(inde + i6)
     647       do 902 i5 = 1, ieb
     648       b5 = bincoe(inde + i5)
     649       do 903 i4 = 1, idb
     650       b4 = bincoe(indd + i4)
     651       do 904 i3 = 1, icb
     652       b3 = bincoe(indc + i3)
     653       do 905 i2 = 1, ibb
     654       b2 = bincoe(indb + i2)
     655       do 906 i1 = 1, iab
     656       b1 = bincoe(inda + i1)
     657       term = b1*b2*b3*b4*b5*b6
     658       if (mod(i2 + i5 + i6 + i4 + ie + id, 2) == 1) term = -term
     659       ir = i1 + i2 - i3 - i4 + ie + ie - i6 - i6 + ic + id + 3
     660       ip = ia - i1 + ib - i2 + ie + ie - i5 - i5 + ic - i3 + id-i4 + 7
     661       count = count + a(ip)*b(ir)*term
     662   906 continue
     663   905 continue
     664   904 continue
     665   903 continue
     666   902 continue
     667   901 continue
     668       snag = count
     669       end subroutine cfunct
 
