       1       double precision function aabacd (iocca1, ioccb1, iocca2, ioccb2,
  nmos, xy)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5 !**********************************************************************
 *
       6       implicit none
       7 !-----------------------------------------------
       8 !   D u m m y   A r g u m e n t s
       9 !-----------------------------------------------
      10       integer , intent(in) :: nmos
      11       integer , intent(in) :: iocca1(nmos)
      12       integer , intent(in) :: ioccb1(nmos)
      13       integer , intent(in) :: iocca2(nmos)
      14       integer , intent(in) :: ioccb2(nmos)
      15       double precision , intent(in) :: xy(nmos,nmos,nmos,nmos)
      16 !-----------------------------------------------
      17 !   L o c a l   P a r a m e t e r s
      18 !-----------------------------------------------
      19 !-----------------------------------------------
      20 !   L o c a l   V a r i a b l e s
      21 !-----------------------------------------------
      22       integer :: ij, i, j, k, l
      23       double precision :: sum
      24 !-----------------------------------------------
      25 !**********************************************************************
      26 !
      27 ! AABACD EVALUATES THE C.I. MATRIX ELEMENT FOR TWO MICROSTATES DIFFERIN
 G
      28 !       BY TWO ALPHA MOS. ONE MICROSTATE HAS ALPHA ELECTRONS IN
      29 !       M.O.S PSI(I) AND PSI(J) FOR WHICH THE OTHER MICROSTATE HAS
      30 !       ELECTRONS IN PSI(K) AND PSI(L)
      31 !
      32 !**********************************************************************
      33       ij = 0
      34       do i = 1, nmos
      35         if (iocca1(i) >= iocca2(i)) cycle
      36         exit
      37       end do
      38       do j = i + 1, nmos
      39         if (iocca1(j) < iocca2(j)) exit
      40         ij = ij + iocca2(j) + ioccb2(j)
      41       end do
      42       do k = 1, nmos
      43         if (iocca1(k) <= iocca2(k)) cycle
      44         exit
      45       end do
      46       do l = k + 1, nmos
      47         if (iocca1(l) > iocca2(l)) exit
      48         ij = ij + iocca1(l) + ioccb1(l)
      49       end do
      50       ij = ij + ioccb2(i) + ioccb1(k)
      51       sum = xy(i,k,j,l) - xy(i,l,k,j)
      52       if (mod(ij,2) == 1) sum = -sum
      53       aabacd = sum
      54       return
      55       end function aabacd
 
