    1841       subroutine tx(ii, kk, rep, logv, v)
    1842 !-----------------------------------------------
    1843 !   M o d u l e s
    1844 !-----------------------------------------------
    1845       use mndod_C, only : indexd, indx, ind2, sp, sd, pp, dp, d_d
    1846 !     *
    1847 !     ROTATION OF TWO-ELECTRON TWO-CENTER INTEGRALS IN SPD BASIS
    1848 !     FIRST STEP
    1849 !     *
    1850       implicit none
    1851 !-----------------------------------------------
    1852 !   D u m m y   A r g u m e n t s
    1853 !-----------------------------------------------
    1854       integer , intent(in) :: ii
    1855       integer , intent(in) :: kk
    1856       double precision , intent(in) :: rep(491)
    1857       double precision , intent(out) :: v(45,45)
    1858       logical , intent(out) :: logv(45,45)
    1859 !-----------------------------------------------
    1860 !   L o c a l   V a r i a b l e s
    1861 !-----------------------------------------------
    1862       integer , dimension(45) :: met
    1863       integer :: limkl, k, i1, j1, ij, k1, l1, kl, nd, ll, mm, l
    1864       double precision :: wrepp
    1865 !-----------------------------------------------
    1866       data met/ 1, 2, 3, 2, 3, 3, 2, 3, 3, 3, 4, 5, 5, 5, 6, 4, 5, 5, 5
 , 6, 6, &
    1867         4, 5, 5, 5, 6, 6, 6, 4, 5, 5, 5, 6, 6, 6, 6, 4, 5, 5, 5, 5*6/
    1868 !
    1869       limkl = indx(kk,kk)
    1870       logv(:,:limkl) = .FALSE.
    1871       v(:,:limkl) = 0.D0
    1872 !
    1873       do i1 = 1, ii
    1874         do j1 = 1, i1
    1875           ij = indexd(i1,j1)
    1876 !
    1877           do k1 = 1, kk
    1878 !
    1879             do l1 = 1, k1
    1880               kl = indexd(k1,l1)
    1881               nd = ind2(ij,kl)
    1882               if (nd == 0) cycle
    1883 !
    1884               wrepp = rep(nd)
    1885               ll = indx(k1,l1)
    1886               mm = met(ll)
    1887 !
    1888               select case (mm)
    1889               case (1)
    1890                 v(ij,1) = wrepp
    1891               case (2)
    1892                 k = k1 - 1
    1893                 v(ij,2) = v(ij,2) + sp(k,1)*wrepp
    1894                 v(ij,4) = v(ij,4) + sp(k,2)*wrepp
    1895                 v(ij,7) = v(ij,7) + sp(k,3)*wrepp
    1896               case (3)
    1897                 k = k1 - 1
 
