     691 subroutine diegrd (dxyz)
     692     use molkst_C, only : numat
     693     use cosmo_C, only : nps, fepsi, nipc, &
     694      cosurf, iatsp, isude, sude, qscnet, qdenet, qscat, arat
     695     use parameters_C, only : dd, qq
     696     use common_arrays_c, only : coord, nfirst, nlast, nat
     697     use funcon_C, only : ev, a0, fpc_9
     698     implicit none
     699     integer :: i, ia, iak, ial, ib, idel, iden, ix, j, k, l, nati, iii
     700     double precision :: bsurf, ddi, deab, dist2, dx, fact, ff, ff0, &
     701    & qqi2, qsk, rm2, rm4, xxx
     702     double precision, dimension (3) :: xk, xl, xx
     703     double precision, dimension (0:3, 10) :: db
     704     double precision, dimension (3, numat), intent (inout) :: dxyz
     705     intrinsic Min, Sqrt
     706     do i = 1, 10
     707       do ix = 1, 3
     708         db(ix, i) = 0.d0
     709       end do
     710     end do
     711     db(0, 1) = 1.d0
     712     fact = -ev * a0 * fpc_9
     713     do k = 1, nps
     714       iak = iatsp(k)
     715       do ix = 1, 3
     716         xk(ix) = cosurf(ix, k)
     717       end do
     718       qsk = qscnet(k, 3)
     719       do l = 1, k - 1
     720         ial = iatsp(l)
     721         if (ial /= iak) then
     722           dist2 = 0.d0
     723           do ix = 1, 3
     724             xxx = cosurf(ix, l) - xk(ix)
     725             xl(ix) = xxx
     726             dist2 = dist2 + xxx * xxx
     727           end do
     728           ff = qsk * qscnet(l, 3) * fact * dist2 ** (- 1.5d0) / fepsi
     729           do ix = 1, 3
     730             dxyz(ix, iak) = dxyz(ix, iak) - xl(ix) * ff
     731             dxyz(ix, ial) = dxyz(ix, ial) + xl(ix) * ff
     732           end do
     733         end if
     734       end do
     735     end do
     736    ! NOW THE CONTRIBUTIONS FROM ANALYTIC SURFACE DERIVATIVES
     737    ! FOR THE SURFACE CLOSURE
     738     bsurf = 0.d0
     739     do i = 1, nipc
     740       ia = isude(1, i)
     741       ib = isude(2, i)
     742       deab = -0.25d0 * (qscat(ia)**2*sude(1, i)/arat(ia) + qscat(ib)**2
 *sude(2, &
     743      & i)/arat(ib) + bsurf*(sude(1, i) + sude(2, i)))
     744       xk(1) = coord(1, ib) - coord(1, ia)
     745       xk(2) = coord(2, ib) - coord(2, ia)
     746       xk(3) = coord(3, ib) - coord(3, ia)
     747       deab = deab / Sqrt (xk(1)**2 + xk(2)**2 + xk(3)**2)
 
 FORCHECK PC V13.5.13          DIEGRD          2021-03-24 10:59:30   page:  1615
 cosmo.F90  /FF
 
     748       do ix = 1, 3
     749         dxyz(ix, ia) = dxyz(ix, ia) - xk(ix) * deab
     750         dxyz(ix, ib) = dxyz(ix, ib) + xk(ix) * deab
     751       end do
     752     end do
     753     do k = 1, nps
     754       iak = iatsp(k)
     755       do ix = 1, 3
     756         xk(ix) = cosurf(ix, k)
     757       end do
     758       qsk = qscnet(k, 3)
     759       iden = 0
     760       do i = 1, numat
     761         idel = nlast(i) + 1 - nfirst(i)
     762         if (i /= iak) then
     763           nati = nat(i)
     764           dist2 = 0.d0
     765           do ix = 1, 3
     766             xxx = xk(ix) - coord(ix, i)
     767             xx(ix) = xxx
     768             dist2 = dist2 + xxx * xxx
     769           end do
     770           ddi = dd(nati) * a0
     771           qqi2 = (a0*qq(nati)) ** 2
     772           ff0 = -qsk * fact * dist2 ** (- 1.5d0)
     773           if (idel  >  1) then
     774             rm2 = 1.d0 / dist2
     775             rm4 = rm2 ** 2
     776             db(0, 2) = ddi * 3 * xx(1) * rm2
     777             db(0, 4) = ddi * 3 * xx(2) * rm2
     778             db(0, 7) = ddi * 3 * xx(3) * rm2
     779             db(0, 3) = 1.d0 + qqi2 * (15*xx(1)**2*rm2 - 3.d0) * rm2
     780             db(0, 6) = 1.d0 + qqi2 * (15*xx(2)**2*rm2 - 3.d0) * rm2
     781             db(0, 10) = 1.d0 + qqi2 * (15*xx(3)**2*rm2 - 3.d0) * rm2
     782             db(0, 5) = qqi2 * 15 * xx(1) * xx(2) * rm4
     783             db(0, 8) = qqi2 * 15 * xx(1) * xx(3) * rm4
     784             db(0, 9) = qqi2 * 15 * xx(3) * xx(2) * rm4
     785             db(1, 2) = ddi
     786             db(2, 4) = db(1, 2)
     787             db(3, 7) = db(1, 2)
     788             db(1, 3) = 6 * qqi2 * xx(1) * rm2
     789             db(2, 6) = 6 * qqi2 * xx(2) * rm2
     790             db(3, 10) = 6 * qqi2 * xx(3) * rm2
     791             db(1, 5) = db(2, 6)
     792             db(2, 5) = db(1, 3)
     793             db(1, 8) = db(3, 10)
     794             db(3, 8) = db(1, 3)
     795             db(2, 9) = db(3, 10)
     796             db(3, 9) = db(2, 6)
     797           end if
     798           do j = 1, min(10, (idel*(idel + 1))/2)
     799             ff = -ff0 * qdenet(iden + j, 3)
     800             if(j == 1 .and. idel == 9) then
     801               do iii = 5, 9
     802                 ff = ff - ff0 * qdenet(iden + (iii*(iii + 1))/2, 3)
     803               end do
     804             end if
     805             do ix = 1, 3
     806               dx = (xx(ix)*db(0, j) - db(ix, j)) * ff
 
 FORCHECK PC V13.5.13          DIEGRD          2021-03-24 10:59:30   page:  1616
 cosmo.F90  /FF
 
     807               dxyz(ix, iak) = dxyz(ix, iak) + dx
     808               dxyz(ix, i) = dxyz(ix, i) - dx
     809             end do
     810           end do
     811         end if
     812         iden = iden + (idel*(idel + 1))/2
     813       end do
     814     end do
     815 end subroutine diegrd
 
