     996               x2 = dirtm(2, j)
     997               x3 = dirtm(3, j)
     998               do ips = nps0, nps
     999                 sp = x1*cosurf(1, ips)+ x2*cosurf(2, ips)+ x3*cosurf(3,
  ips)
    1000                 if (sp >= spm) then
    1001                   spm = sp*(1.d0+1.d-14)
    1002                   ipm = ips
    1003                 end if
    1004               end do
    1005
    1006               iseg(j) = ipm
    1007               nar_loc(ipm) = nar_loc(ipm) + 1
    1008               phinet(ipm, 1)=phinet(ipm, 1) + dirtm(1, j) * dirvec(4, j
 )
    1009               phinet(ipm, 2)=phinet(ipm, 2) + dirtm(2, j) * dirvec(4, j
 )
    1010               phinet(ipm, 3)=phinet(ipm, 3) + dirtm(3, j) * dirvec(4, j
 )
    1011             end if
    1012           end do
    1013
    1014           ips = nps0 - 1
    1015           loop1: do
    1016             ips = ips + 1
    1017             do while (nar_loc(ips) == 0)
    1018               niter = 1
    1019               nps = nps - 1
    1020               if (ips > nps) exit loop1
    1021               do jps = ips, nps
    1022                 nar_loc(jps) = nar_loc(jps+1)
    1023                 phinet(jps, 1) = phinet(jps+1, 1)
    1024                 phinet(jps, 2) = phinet(jps+1, 2)
    1025                 phinet(jps, 3) = phinet(jps+1, 3)
 
