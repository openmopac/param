    1065   subroutine build_active_site(active_site, ninsite)
    1066 !
    1067 !  The set of atoms in the active site is constructed.
    1068 !  Given the topology of the reactants and products (in nbonds and ibon
 ds),
    1069 !  the active site atoms are identified by the differences in topology.
    1070 !  This is typically 2 - 6 atoms.  By using the nearest neighbors and s
 econd nearest neighbors,
    1071 !  a good approximation to the active site can be constructed.
    1072 !
    1073     use molkst_C, only : numat, line, keywrd, nvar, pdb_label, maxtxt
    1074 !
    1075     use common_arrays_C, only : nbonds, ibonds, txtatm, nat, loc
    1076 !
    1077     USE chanel_C, only : iw
    1078 !
    1079     use elemts_C, only: elemnt
    1080     implicit none
    1081     integer, intent (out) :: active_site(200), ninsite(3)
    1082     integer i, ii, j, jj, k, l, nsite
    1083     integer, allocatable :: nbonds_b(:), ibonds_b(:,:)
    1084     character :: ch*2
    1085     active_site(1) = 0
    1086     if (index(keywrd," LOCATE-TS(SET") /= 0) then
    1087       nsite = 0
    1088       do i = 1, nvar
    1089         do j = 1, nsite
    1090           if (loc(1,i) == active_site(j)) exit
    1091         end do
    1092         if (j > nsite) then
    1093           nsite = j
    1094           active_site(nsite) = loc(1,i)
    1095         end if
    1096       end do
    1097       ninsite(1) = nsite
    1098       return
    1099     end if
    1100     allocate (nbonds_b(numat), ibonds_b(15,numat))
    1101     call big_swap(1,1)!  Extract system 1 - the input data set
    1102     nbonds_b = nbonds
    1103     ibonds_b = ibonds
    1104     call big_swap(1,2)!  Extract system 2 - the reference geometry
    1105     call set_up_dentate
    1106     call big_swap(0,2)!  Store system 2 - this adds nbonds and ibonds t
 o the store
    1107 !
    1108 !  Compare topologies
    1109 !
    1110     nsite = 0
    1111     active_site = 0
    1112     do i = 1, numat
    1113       if (nbonds(i) /= nbonds_b(i)) then
    1114         do k = 1, nsite
    1115           if (active_site(k) == i) exit
    1116         end do
    1117         if (k <= nsite) cycle
    1118         nsite = nsite + 1
    1119         active_site(nsite) = i
 
 FORCHECK PC V13.5.13    BUILD_ACTIVE_SITE     2021-03-24 10:59:30   page:  1743
 big_swap.F90  /FF
 
    1120       else
    1121         do j = 1, nbonds(i)
    1122 !
    1123 !  At this point, atoms are in exactly the same sequence, so no need to
  check every permutation
    1124 !
    1125           if (ibonds(j,i) /= ibonds_b(j,i)) then
    1126             do k = 1, nsite
    1127               if (active_site(k) == i) exit
    1128             end do
    1129             if (k <= nsite) cycle
    1130             nsite = nsite + 1
    1131             active_site(nsite) = i
    1132           end if
    1133         end do
    1134       end if
    1135     end do
    1136     if (nsite == 0) then
    1137       call mopend( "No atoms involved in bond-making or bond-breaking!"
 )
    1138       return
    1139     end if
    1140     k = 0
    1141     do i = 1, nsite
    1142       k = max(k,nbonds_b(active_site(i)))
    1143     end do
    1144     write(ch,'(i2)')k*6 - 6
    1145
    1146     if (pdb_label) then
    1147       write(iw,'(/,a,'//ch//'x,a,/16x,a)') &
    1148       " Set 1: Atoms involved in covalent bond-breaking and bond-making
 ", "Connectivity of atoms"
    1149       write(iw,'(77x,a,'//ch//'x,a)')"Data-set", "Reference"
    1150       write(iw,'(37x,a)')"(PDB labels from GEO-REF)"
    1151     else
    1152       write(iw,'(/6x,a,'//ch//'x,a)')" Set 1: Atoms involved in covalen
 t", "Connectivity of atoms"
    1153       write(iw,'(7x, a,21x,a,/)')"bond-breaking and bond-making
     Data-set", "Reference"
    1154     end if
    1155     write(ch,'(i2)')k*6
    1156     do i = 1, nsite
    1157       write(line,'(i12,10i6)')(ibonds_b(j, active_site(i)), j = 1, nbon
 ds_b(active_site(i)))
    1158       write(line(k*6 + 10:),'(i6,10i6)')(ibonds(j, active_site(i)), j =
  1, nbonds(active_site(i)))
    1159       if (pdb_label) then
    1160         write(iw,'(i4, 3x, a, i6, a, a)')i, " Atom:  "//elemnt(nat(acti
 ve_site(i))), active_site(i), &
    1161     "  PDB Label: ("//txtatm(active_site(i))(:maxtxt)//")", trim(line)
    1162       else
    1163          write(iw,'(i12, 3x, a, i6, 6x, a)')i, " Atom:  "//elemnt(nat(a
 ctive_site(i))), active_site(i), trim(line)
    1164       end if
    1165     end do
    1166     ninsite(1) = nsite
    1167 !
    1168 ! Select neighbors
    1169 !
 
 FORCHECK PC V13.5.13    BUILD_ACTIVE_SITE     2021-03-24 10:59:30   page:  1744
 big_swap.F90  /FF
 
    1170     ii = nsite
    1171     do jj = 1, ii
    1172       i = active_site(jj)
    1173       do j = 1, nbonds(i)
    1174         k = ibonds(j,i)
    1175         do l = 1, nsite
    1176           if (active_site(l) == k) exit
    1177         end do
    1178         if (l <= nsite) cycle
    1179         nsite = nsite + 1
    1180         active_site(nsite) = k
    1181       end do
    1182     end do
    1183     do jj = 1, ii
    1184       i = active_site(jj)
    1185       do j = 1, nbonds_b(i)
    1186         k = ibonds_b(j,i)
    1187         do l = 1, nsite
    1188           if (active_site(l) == k) exit
    1189         end do
    1190         if (l <= nsite) cycle
    1191         nsite = nsite + 1
    1192         active_site(nsite) = k
    1193       end do
    1194     end do
    1195     write(iw,'(/,a,/)')" Set 2 : Atoms involved in covalent bond-breaki
 ng "// &
    1196       "and bond-making, plus nearest neighbors"
    1197     if (pdb_label) then
    1198       write(iw,'(i4, 3x, a, i6, a)')(i, " Atom:  "//elemnt(nat(active_s
 ite(i))), active_site(i), &
    1199   "  PDB Label: ("//txtatm(active_site(i))//")", i = 1, nsite)
    1200     else
    1201       write(iw,'(i12, 3x, a, i6)')(i, " Atom:  "//elemnt(nat(active_sit
 e(i))), active_site(i), i = 1, nsite)
    1202     end if
    1203     ninsite(2) = nsite
    1204     return
    1205   end subroutine build_active_site
 
