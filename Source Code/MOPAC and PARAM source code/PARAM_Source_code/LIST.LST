     894   & f13.5, " ANG.**3")
     895     else
     896       write (iw, 10040) alpavg, alpavg*a0**3
     897 10040 format (/, "  ISOTROPIC AVERAGE ALPHA = ", 1 f13.5, " A.U. =", &
     898            & f13.5, " ANG.**3")
     899     end if
     900     call to_screen("To_file: POLAR")
     901 !
     902       return
     903       end subroutine alphaf
 
