     146 !
     147       subroutine tql2e(nm, n, d, e, z, ierr)
     148
     149       implicit none
     150       integer :: i, j, k, l, m, n, ii, nm, mml, ierr
     151       double precision :: d(n), e(n), z(nm, n)
     152       double precision :: b, c, f, g, h, p, r, s, machep
     153 !
     154 !     this subroutine is a translation of the algol procedure tql2,
     155 !     num. math. 11, 293 - 306(1968) by bowdler, martin, reinsch, and
     156 !     wilkinson.
     157 !     handbook for auto. comp., vol.ii - linear algebra, 227 - 240(1971
 ).
     158 !
     159 !     this subroutine finds the eigenvalues and eigenvectors
     160 !     of a symmetric tridiagonal matrix by the ql method.
     161 !     the eigenvectors of a full symmetric matrix can also
     162 !     be found if  tred2  has been used to reduce this
     163 !     full matrix to tridiagonal form.
     164 !
     165 !     on input -
     166 !
     167 !        nm must be set to the row dimension of two - dimensional
     168 !          array parameters as declared in the calling program
     169 !          dimension statement,
     170 !
     171 !        n is the order of the matrix,
     172 !
     173 !        d contains the diagonal elements of the input matrix,
     174 !
     175 !        e contains the subdiagonal elements of the input matrix
     176 !          in its last n - 1 positions.  e(1) is arbitrary,
     177 !
     178 !        z contains the transformation matrix produced in the
     179 !          reduction by  tred2, if performed.  if the eigenvectors
     180 !          of the tridiagonal matrix are desired, z must contain
     181 !          the identity matrix.
     182 !
     183 !      on output -
     184 !
     185 !        d contains the eigenvalues in ascending order.  if an
     186 !          error exit is made, the eigenvalues are correct but
     187 !          unordered for indices 1, 2, ..., ierr - 1,
     188 !
     189 !        e has been destroyed,
     190 !
     191 !        z contains orthonormal eigenvectors of the symmetric
     192 !          tridiagonal (or full) matrix.  if an error exit is made,
     193 !          z contains the eigenvectors associated with the stored
     194 !          eigenvalues,
     195 !
     196 !        ierr is set to
     197 !          zero       for normal return,
     198 !          j          if the j - th eigenvalue has not been
     199 !                     determined after 30 iterations.
 
 FORCHECK PC V13.5.13          TQL2E           2021-03-24 10:59:30   page:   817
 ddiag.F90  /FF
 
     200 !
     201 !     questions and comments should be directed to b. s. garbow,
     202 !     applied mathematics division, argonne national laboratory
     203 !
     204 !    - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
     205 !
     206 !     ********** machep is a machine dependent parameter specifying
     207 !                the relative precision of floating point arithmetic.
     208 !
     209 !                **********
     210       machep = 2.d0**(- 52)
     211
     212       ierr = 0
     213       if (n  ==  1) go to 1001
     214
     215       do 100 i = 2, n
     216   100 e(i - 1) = e(i)
     217
     218       f = 0.0
     219       b = 0.0
     220       e(n) = 0.0
     221
     222       do 240 l = 1, n
     223          j = 0
     224          h = machep * (abs(d(l)) + abs(e(l)))
     225          if (b  <  h) b = h
     226 !     ********** look for small sub - diagonal element **********
     227          do 110 m = l, n
     228             if (abs(e(m))  <=  b) go to 120
     229 !     ********** e(n) is always zero, so there is no exit
     230 !                through the bottom of the loop **********
     231   110    continue
     232
     233   120    if (m  ==  l) go to 220
     234   130    if (j  ==  30) go to 1000
     235          j = j + 1
     236 !     ********** form shift **********
     237          p = (d(l + 1) - d(l)) / (2.0 * e(l))
     238          r = sqrt(p*p + 1.d0)
     239          h = d(l) - e(l) / (p + sign(r, p))
     240
     241          do 140 i = l, n
     242   140    d(i) = d(i) - h
     243
     244          f = f + h
     245 !     ********** ql transformation **********
     246          p = d(m)
     247          c = 1.d0
     248          s = 0.0
     249          mml = m - l
     250 !     ********** for i = m - 1 step - 1 until l do - - **********
     251          do 200 ii = 1, mml
     252             i = m - ii
     253             g = c * e(i)
     254             h = c * p
     255             if (abs(p)  <  abs(e(i))) go to 150
     256             c = e(i) / p
     257             r = sqrt(c*c + 1.d0)
 
 FORCHECK PC V13.5.13          TQL2E           2021-03-24 10:59:30   page:   818
 ddiag.F90  /FF
 
     258             e(i + 1) = s * p * r
     259             s = c / r
     260             c = 1.0 / r
     261             go to 160
     262   150       c = p / e(i)
     263             r = sqrt(c*c + 1.d0)
     264             e(i + 1) = s * e(i) * r
     265             s = 1.0 / r
     266             c = c * s
     267   160       p = c * d(i) - s * g
     268             d(i + 1) = h + s * (c * g + s * d(i))
     269 !     ********** form vector **********
     270             do 180 k = 1, n
     271                h = z(k, i + 1)
     272                z(k, i + 1) = s * z(k, i) + c * h
     273                z(k, i) = c * z(k, i) - s * h
     274   180       continue
     275
     276   200    continue
     277
     278          e(l) = s * p
     279          d(l) = c * p
     280          if (abs(e(l))  >  b) go to 130
     281   220    d(l) = d(l) + f
     282   240 continue
     283 !     ********** order eigenvalues and eigenvectors **********
     284       do 300 ii = 2, n
     285          i = ii - 1
     286          k = i
     287          p = d(i)
     288
     289          do 260 j = ii, n
     290             if (d(j)  >=  p) go to 260
     291             k = j
     292             p = d(j)
     293   260    continue
     294
     295          if (k  ==  i) go to 300
     296          d(k) = d(i)
     297          d(i) = p
     298
     299          do 280 j = 1, n
     300             p = z(j, i)
     301             z(j, i) = z(j, k)
     302             z(j, k) = p
     303   280    continue
     304
     305   300 continue
     306
     307       go to 1001
     308 !     ********** set error - - no convergence to an
     309 !                eigenvalue after 30 iterations **********
     310  1000 ierr = l
     311  1001 return
     312 !     ********** last card of tql2 **********
     313       end subroutine tql2e
 
