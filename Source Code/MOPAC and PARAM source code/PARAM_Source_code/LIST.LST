      92       if (large) write (iw, '(/10X,''ALL ENERGIES ARE IN ELECTRON VOLTS
 '')')
      93       kl = 0
      94       k = kl + 1
      95       kl = kl + 10
      96       kl = min0(kl,numat)
      97       do while(numat > kl)
      98         k = kl + 1
      99         kl = kl + 10
     100         kl = min0(kl,numat)
     101       end do
     102       eau = 0.0D0
     103       eae = 0.0D0
