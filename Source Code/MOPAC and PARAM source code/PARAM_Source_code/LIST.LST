       1       subroutine frame(fmat, numat, mode)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use common_arrays_C, only : coord, atmass
       6       use molkst_C, only : id, n_trivial => itemp_2
       7 !-----------------------------------------------
       8 !   I n t e r f a c e   B l o c k s
       9 !-----------------------------------------------
      10       implicit none
      11 !-----------------------------------------------
      12 !   G l o b a l   P a r a m e t e r s
      13 !-----------------------------------------------
      14 !-----------------------------------------------
      15 !   D u m m y   A r g u m e n t s
      16 !-----------------------------------------------
      17       integer  :: numat
      18       integer  :: mode
      19       double precision , intent(inout) :: fmat(*)
      20 !-----------------------------------------------
      21 !   L o c a l   V a r i a b l e s
      22 !-----------------------------------------------
      23       integer :: i, j, k, n3, l
      24       double precision, dimension(6,3*numat) :: vib
      25       double precision, dimension(3,3) :: rot
      26       double precision :: shift(6)
      27       double precision, dimension(3,numat) :: coord1
      28       double precision :: sum, wtmass, x, y, z, sums(6)
      29 !-----------------------------------------------
      30 !**********************************************************************
      31 !
      32 !   FRAME APPLIES AN RIGID ORIENTATION TO THE MOLECULE IN A FORCE
      33 !         CALCULATION. THE TRANSLATIONS ARE GIVEN A 'FORCE CONSTANT'
      34 !         OF T(X)=500 MILLIDYNES/ANGSTROM
      35 !            T(Y)=600 MILLIDYNES/ANGSTROM
      36 !            T(Z)=700 MILLIDYNES/ANGSTROM
      37 !         AND THE ROTATIONS ARE GIVEN A 'FORCE CONSTANT' OF
      38 !            R(X)=800 MILLIDYNES/ANGSTROM
      39 !            R(Y)=900 MILLIDYNES/ANGSTROM
      40 !            R(Z)=1000 MILLIDYNES/ANGSTROM,
      41 !    THE ROTATIONS ARE MADE ABOUT AXES DETERMINED BY THE MOMENTS
      42 !    OF INERTIA, WHICH IN TURN DEPEND ON THE ISOTOPIC MASSES. FOR
      43 !    THE NORMAL FREQUENCY CALCULATION THESE ARE THE REAL MASSES,
      44 !    FOR THE FORCE CALCULATION THEY ARE ALL UNITY.
      45 !**********************************************************************
      46       call axis (x, y, z, rot)
      47       do i = 1, numat
      48         do j = 1, 3
      49           sum = 0.D0
      50           do k = 1, 3
      51             sum = sum + coord(k,i)*rot(k,j)
      52           end do
      53           coord1(j,i) = sum
      54         end do
      55       end do
      56       n3 = numat*3
      57       j = 0
      58       wtmass = 1.D0
 
 FORCHECK PC V13.5.13          FRAME           2021-03-24 10:59:30   page:  2436
 frame.F90  /FF
 
      59       if (mode == 1) then
      60         do i = 1, numat
      61           wtmass = sqrt(atmass(i))
      62           j = j + 1
      63           vib(1,j) = wtmass
      64           vib(2,j) = 0.D0
      65           vib(3,j) = 0.D0
      66           vib(4,j) = 0.D0
      67           vib(5,j) = coord1(3,i)*wtmass
      68           vib(6,j) = coord1(2,i)*wtmass
      69           j = j + 1
      70           vib(1,j) = 0.D0
      71           vib(2,j) = wtmass
      72           vib(3,j) = 0.D0
      73           vib(4,j) = coord1(3,i)*wtmass
      74           vib(5,j) = 0.D0
      75           vib(6,j) = -coord1(1,i)*wtmass
      76           j = j + 1
      77           vib(1,j) = 0.D0
      78           vib(2,j) = 0.D0
      79           vib(3,j) = wtmass
      80           vib(4,j) = -coord1(2,i)*wtmass
      81           vib(5,j) = -coord1(1,i)*wtmass
      82           vib(6,j) = 0.D0
      83         end do
      84       else
      85         vib(1,j+1:numat*3-2+j:3) = wtmass
      86         vib(2,j+1:numat*3-2+j:3) = 0.D0
      87         vib(3,j+1:numat*3-2+j:3) = 0.D0
      88         vib(4,j+1:numat*3-2+j:3) = 0.D0
      89         vib(5,j+1:numat*3-2+j:3) = coord1(3,:numat)*wtmass
      90         vib(6,j+1:numat*3-2+j:3) = coord1(2,:numat)*wtmass
      91         vib(1,j+2:numat*3-1+j:3) = 0.D0
      92         vib(2,j+2:numat*3-1+j:3) = wtmass
      93         vib(3,j+2:numat*3-1+j:3) = 0.D0
      94         vib(4,j+2:numat*3-1+j:3) = coord1(3,:numat)*wtmass
      95         vib(5,j+2:numat*3-1+j:3) = 0.D0
      96         vib(6,j+2:numat*3-1+j:3) = -coord1(1,:numat)*wtmass
      97         vib(1,j+3:numat*3+j:3) = 0.D0
      98         vib(2,j+3:numat*3+j:3) = 0.D0
      99         vib(3,j+3:numat*3+j:3) = wtmass
     100         vib(4,j+3:numat*3+j:3) = -coord1(2,:numat)*wtmass
     101         vib(5,j+3:numat*3+j:3) = -coord1(1,:numat)*wtmass
     102         vib(6,j+3:numat*3+j:3) = 0.D0
     103       end if
     104       j = 1
     105       do i = 1, numat
     106         do k = 4, 6
     107           x = vib(k,j)
     108           y = vib(k,j+1)
     109           z = vib(k,j+2)
     110           vib(k,j) = x*rot(1,1) + y*rot(1,2) + z*rot(1,3)
     111           vib(k,j+1) = x*rot(2,1) + y*rot(2,2) + z*rot(2,3)
     112           vib(k,j+2) = x*rot(3,1) + y*rot(3,2) + z*rot(3,3)
     113         end do
     114         j = j + 3
     115       end do
     116       sums = 0.D0
     117       do i = 1,n3
 
 FORCHECK PC V13.5.13          FRAME           2021-03-24 10:59:30   page:  2437
 frame.F90  /FF
 
     118         sums(:) = sums(:) + vib(:,i)**2
     119       end do
     120       if (n_trivial == 5) then
     121         sum = 0.01d0 + Min(sums(1), sums(2), sums(3), sums(4), sums(5),
  sums(6))  ! System is linear, so don't use one mode
     122         do i = 1,6
     123           if (sums(i) > sum) sums(i) = sqrt(1.D0/sums(i))
     124         end do
     125       else
     126         sums = sqrt(1.d0/sums)
     127       end if
     128
     129       if (id /= 0) sums(4:6) = 0.D0
     130
     131       do i = 1, 6
     132         vib(i,:n3) = vib(i,:n3)*sums(i)
     133         shift(i) = 40000.D0 + i*100.D0
     134       end do
     135       l = 0
     136       do i = 1, n3
     137         do j = 1, i
     138           l = l + 1
     139           sum = 0.D0
     140           do k = 1, 6
     141             sum = sum + vib(k,i)*shift(k)*vib(k,j)
     142           end do
     143           fmat(l) = fmat(l) + sum
     144         end do
     145       end do
     146       return
     147       end subroutine frame
 
