    1452 subroutine fill_overlap_matrix(overlap)
    1453 !
    1454 !  Set up an array to hold the overlap matrix
    1455 !
    1456   use parameters_C, only : betas, betap, betad, natorb
    1457   use molkst_C, only : norbs, numat
    1458   use common_arrays_C, only : nat, nfirst, h
    1459   implicit none
    1460   double precision, intent (out) :: overlap((norbs*(norbs + 1))/2)
    1461   integer :: i, im1, j, ii, jj, ij, if, jf, ni, nj, norbi, norbj, ifact
 (norbs + 1)
    1462   double precision :: bi(9), bj(9)
    1463     do i = 1, norbs
    1464       ifact(i) = (i*(i - 1))/2
    1465     end do
    1466     ifact(norbs+1) = (norbs*(norbs + 1))/2
    1467     overlap = 0.d0
    1468     do i = 1, numat
    1469       if = nfirst(i)
    1470       im1 = i - 1
    1471       bi = betas(nat(i))
    1472       ni = nat(i)
    1473       bi(1) = betas(ni)*0.5D0
    1474       bi(2) = betap(ni)*0.5D0
    1475       bi(3) = bi(2)
    1476       bi(4) = bi(2)
    1477       bi(5) = betad(ni)*0.5D0
    1478       bi(6) = bi(5)
    1479       bi(7) = bi(5)
    1480       bi(8) = bi(5)
    1481       bi(9) = bi(5)
    1482       norbi = natorb(ni)
    1483       do j = 1, im1
    1484         nj = nat(j)
    1485         bj(1) = betas(nj)*0.5D0
    1486         bj(2) = betap(nj)*0.5D0
    1487         bj(3) = bj(2)
    1488         bj(4) = bj(2)
    1489         bj(5) = betad(nj)*0.5D0
    1490         bj(6) = bj(5)
    1491         bj(7) = bj(5)
    1492         bj(8) = bj(5)
    1493         bj(9) = bj(5)
    1494         norbj = natorb(nj)
    1495         jf = nfirst(j)
    1496         do ii = 1, norbi
    1497           do jj = 1, norbj
    1498             ij = ((if + ii - 1)*(if + ii - 2))/2 + jf + jj - 1
    1499             overlap(ij) = h(ij)/(bi(ii) + bj(jj))
    1500           end do
    1501         end do
    1502       end do
    1503     end do
    1504     overlap(ifact(2:norbs+1)) = 1.D0
    1505   end subroutine fill_overlap_matrix
 
