     279   subroutine get_minus_point_five_overlap(s)
     280   use molkst_C, only : numat, norbs
     281   use common_arrays_C, only: nfirst, nlast, nat, h, &
     282                            & i1fact
     283   use parameters_C, only : betas, betap, betad
     284   implicit none
     285   double precision, dimension(norbs**2) :: s
     286   !
     287   !.. Local Scalars ..
     288   integer :: i, if, ii, ij, il, im1, j, jf, jj, jl, k, &
     289        & alloc_stat
     290   double precision :: bi, bj, sum
     291   !.. Local Arrays ..
     292   double precision, dimension (:), allocatable :: eigs, vecs
     293 !
     294
     295   !
     296   !
     297   !.. Intrinsic Functions ..
     298   intrinsic Abs, Sqrt
     299   !
     300   ! ... Executable Statements ...
     301   !
     302   !     PATAS
     303   !********************************************************************
 *
     304   !
     305   !  FIRST, RE-CALCULATE THE OVERLAP MATRIX
     306   !
     307   !********************************************************************
 *
     308   !
     309   !     PATAS
     310
     311   allocate (eigs(norbs), vecs(norbs**2), stat=alloc_stat)
     312   if (alloc_stat /= 0) return  !WARNING
     313   if (.not. allocated(i1fact)) then
     314
     315     allocate(i1fact(3 + norbs))
     316 !
     317 !   SET UP ARRAY OF LOWER HALF TRIANGLE INDICES (PASCAL'S TRIANGLE)
     318 !
     319     do i = 1, norbs
     320       i1fact(i) = (i*(i + 1))/2
     321     end do
     322   end if
     323   do i = 1, numat
     324       if = nfirst(i)
     325       il = nlast(i)
     326       if (il >= if) then
     327         eigs(if) = betas(nat(i))
     328         if (il > if) then
     329           eigs(if+1) = betap(nat(i))
     330           eigs(if+2) = eigs(if+1)
     331           eigs(if+3) = eigs(if+1)
     332           if (il > if+3) then
     333             eigs(if+4) = betad(nat(i))
     334             eigs(if+5) = eigs(if+4)
 
 FORCHECK PC V13.5.13                          2021-03-24 10:59:30   page:  1911
 esp_utilities.F90  /FF
 
     335             eigs(if+6) = eigs(if+4)
     336             eigs(if+7) = eigs(if+4)
     337             eigs(if+8) = eigs(if+4)
     338           end if
     339         end if
     340     else
     341       if = nfirst(i)
     342       il = nlast(i)
     343       if (il >= if) then
     344         eigs(if) = betas(nat(i))
     345         if (il > if) then
     346           eigs(if+1) = betap(nat(i))
     347           eigs(if+2) = eigs(if+1)
     348           eigs(if+3) = eigs(if+1)
     349           if (il > if+3) then
     350             eigs(if+4) = betad(nat(i))
     351             eigs(if+5) = eigs(if+4)
     352             eigs(if+6) = eigs(if+4)
     353             eigs(if+7) = eigs(if+4)
     354             eigs(if+8) = eigs(if+4)
     355           end if
     356         end if
     357       end if
     358     end if
     359     im1 = i - 1
     360     bi = betas(nat(i))
     361     do k = if, il
     362       bi = eigs(k)
     363       ii = (k*(k-1)) / 2
     364       do j = 1, im1
     365         jf = nfirst(j)
     366         jl = nlast(j)
     367         do jj = jf, jl
     368           bj = eigs(jj)
     369           ij = ii + jj
     370           h(ij) = 2.d0 * h(ij) / (bi+bj) + 1.d-14
     371           !  THE  +1.D-14 IS TO PREVENT POSSIBLE ERRORS IN THE DIAGONAL
 IZATION.
     372         end do
     373       end do
     374       do jj = if, k
     375         ij = ii + jj
     376         h(ij) = 0.d0
     377       end do
     378     end do
     379   end do
     380   do i = 1, norbs
     381     h(i1fact(i)) = 1.d0
     382   end do
     383   call rsp (h, norbs, eigs, vecs)
     384   do i = 1, norbs
     385     eigs(i) = 1.d0 / Sqrt (Abs (eigs(i)))
     386   end do
     387   ij = 0
     388   do i = 1, norbs
     389     do j = 1, i
     390       ij = ij + 1
     391       sum = 0.d0
     392       do k = 1, norbs
 
 FORCHECK PC V13.5.13                          2021-03-24 10:59:30   page:  1912
 esp_utilities.F90  /FF
 
     393         sum = sum + vecs(i+ (k-1)*norbs) * eigs(k) * vecs &
     394              & (j+ (k-1)*norbs)
     395       end do
     396       s(i+ (j-1)*norbs) = sum
     397       s(j+ (i-1)*norbs) = sum
     398     end do
     399   end do
     400   !
     401   end subroutine get_minus_point_five_overlap
 
