     257                   ij = ij + microa(jj, i) + microb(jj, i)
     258                 end do
     259               else
     260                 !
     261                 !   Two microstates differing in two BETA electrons
     262                 !
     263                 ii = ll(1)
     264                 !
     265                 !   Add in MICROB(II,I) to allow for the fact that M.O.
  LL(1)
     266                 !   is ALWAYS less than M.O. LL(2).
     267                 !
     268                 ij = microb(ii, i)
     269                 do jj = ii + 1, ll(2) - 1
     270                   ij = ij + microa(jj, i) + microb(jj, i)
     271                 end do
     272                     !
