     308 !
     309 !  Two center Coulomb and exchange terms
     310 !
     311 ! (All indices start over)
     312 !
     313       !     COULOMB (E(N,4)) AND EXCHANGE (EX(N)) TERMS
     314       n = 1
     315       ia = nfirst(1)
     316       ib = nlast(1)
     317       kk = (((ib-ia+1)*(ib-ia+2))/2) ** 2
     318       do ii = 2, numat
     319         e(n, 4) = 0.0d0
     320         ex(n, 1) = 0.0d0
     321         ia = nfirst(ii)
     322         ib = nlast(ii)
