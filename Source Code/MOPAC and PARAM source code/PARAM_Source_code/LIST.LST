       1       double precision function dot (x, y, n)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       implicit none
       6 !-----------------------------------------------
       7 !   D u m m y   A r g u m e n t s
       8 !-----------------------------------------------
       9       integer , intent(in) :: n
      10       double precision , intent(in) :: x(n)
      11       double precision , intent(in) :: y(n)
      12 !For MOPAC BLAS
      13       double precision, external :: ddot
      14 !
      15
      16 !-----------------------------------------------
      17 !**********************************************************************
 *
      18 !
      19 !   DOT FORMS THE SCALAR PRODUCT OF TWO VECTORS.
      20 !
      21 !   ON INPUT     X   =    FIRST VECTOR, OF LENGTH N.
      22 !                Y   =    SECOND VECTOR, OF LENGTH N.
      23 !
      24 !   ON RETURN    DOT =    DOT PRODUCT OF X AND Y.
      25 !
      26 !**********************************************************************
 *
      27 !For MOPAC BLAS
      28 !     dot = dot_product(x(:n),y(:n))
      29       dot = ddot(n,x(1:n),1,y(1:n),1)
      30 !
      31       return
      32       end function dot
 
