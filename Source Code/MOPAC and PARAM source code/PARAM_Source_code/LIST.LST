       1       subroutine molval(c, p, rhfuhf)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       USE molkst_C, only : numat, norbs, mpack
       6       USE chanel_C, only : iw
       7       use common_arrays_C, only : nfirst, nlast
       8 !**********************************************************************
 *
       9       implicit none
      10 !-----------------------------------------------
      11 !   G l o b a l   P a r a m e t e r s
      12 !-----------------------------------------------
      13 !-----------------------------------------------
      14 !   D u m m y   A r g u m e n t s
      15 !-----------------------------------------------
      16       double precision, dimension (norbs) :: val
      17       double precision , intent(in) :: rhfuhf
      18       double precision , intent(in) :: c(norbs,norbs)
      19       double precision , intent(in) :: p(mpack)
      20 !-----------------------------------------------
      21 !   L o c a l   P a r a m e t e r s
      22 !-----------------------------------------------
      23 !-----------------------------------------------
      24 !   L o c a l   V a r i a b l e s
      25 !-----------------------------------------------
      26       integer ::  i, jj, jl, ju, j, kk, kl, ku, k, l1, l2, l
      27       double precision :: sum
      28 !-----------------------------------------------
      29       do i = 1, norbs
      30         sum = 0.D0
      31         do jj = 1, numat
      32           jl = nfirst(jj)
      33           ju = nlast(jj)
      34           do j = jl, ju
      35             do kk = 1, numat
      36               if (kk == jj) cycle
      37               kl = nfirst(kk)
      38               ku = nlast(kk)
      39               do k = kl, ku
      40                 l1 = max(j,k)
      41                 l2 = j + k - l1
      42                 l = (l1*(l1 - 1))/2 + l2
      43                 sum = sum + c(j,i)*c(k,i)*p(l)
      44               end do
      45             end do
      46           end do
      47         end do
      48         val(i) = sum*rhfuhf
      49       end do
      50       write (iw, '(10F8.4)') (val(i),i=1,norbs)
      51       return
      52       end subroutine molval
 
