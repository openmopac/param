       1 !     *****************************************************************
 *
       2       double precision function digit (string, istart)
       3 !-----------------------------------------------
       4 !   M o d u l e s
       5 !-----------------------------------------------
       6       implicit none
       7 !-----------------------------------------------
       8 !   D u m m y   A r g u m e n t s
       9 !-----------------------------------------------
      10       integer , intent(in) :: istart
      11       character , intent(in) :: string*(*)
      12 !-----------------------------------------------
      13 !   L o c a l   V a r i a b l e s
      14 !-----------------------------------------------
      15       integer :: i0, i9, ineg, ipos, idot, ispc, l, idig, i, n, j
      16       double precision :: c1, c2, deciml
      17       logical :: sign
      18 !-----------------------------------------------
      19 !     FORTRAN FUNCTION TO CONVERT NUMERIC FIELD TO DOUBLE PRECISION
      20 !     NUMBER.  THE STRING IS ASSUMED TO BE CLEAN (NO INVALID DIGIT
      21 !     OR CHARACTER COMBINATIONS FROM ISTART TO THE FIRST NONSPACE,
      22 !     NONDIGIT, NONSIGN, AND NONDECIMAL POINT CHARACTER).
      23 !
      24 !
      25 !     DEFINE ASCII VALUES OF NUMERIC FIELD CHARACTERS
      26       i0 = ichar('0')
      27       i9 = ichar('9')
      28       ineg = ichar('-')
      29       ipos = ichar('+')
      30       idot = ichar('.')
      31       ispc = ichar(' ')
      32 !
      33       c1 = 0.D0
      34       c2 = 0.D0
      35       sign = .TRUE.
      36       l = len(string)
      37 !
      38 !     DETERMINE THE CONTRIBUTION TO THE NUMBER GREATER THAN ONE
      39       idig = 0
      40       do i = istart, l
      41         n = ichar(string(i:i))
      42         if (n>=i0 .and. n<=i9) then
      43           idig = idig + 1
      44           c1 = c1*1.D1 + n - i0
      45         else if (n==ineg .or. n==ipos .or. n==ispc) then
      46           if (n == ineg) sign = .FALSE.
      47         else if (n == idot) then
      48           exit
      49         else
      50           go to 40
      51         end if
      52       end do
      53 !
      54 !     DETERMINE THE CONTRIBUTION TO THE NUMBER LESS THAN THAN ONE
      55       deciml = 1.D0
      56       do j = i + 1, l
      57         n = ichar(string(j:j))
 
 FORCHECK PC V13.5.13          DIGIT           2021-03-24 10:59:30   page:    51
 digit.F90  /FF
 
      58         if (n>=i0 .and. n<=i9) then
      59           deciml = deciml/1.D1
      60           c2 = c2 + (n - i0)*deciml
      61         else if (n /= ispc) then
      62           exit
      63         end if
      64       end do
      65 !
      66 !     PUT THE PIECES TOGETHER
      67    40 continue
      68       digit = c1 + c2
      69       if (.not.sign) digit = -digit
      70       return
      71       end function digit
 
