     175 subroutine ciint (c34, pq34)
     176     use molkst_C, only : lm61
     177     use cosmo_C, only : nps, cmat
     178     implicit none
     179     double precision, dimension (lm61), intent (in) :: c34
     180     double precision, dimension (lm61), intent (inout) :: pq34
     181     integer :: i, i0, j
     182     i0 = 0
     183     do i = 1, lm61
     184       pq34(i) = 0.d0
     185     end do
     186     if (nps < 0) return
     187     do i = 1, lm61
     188       do j = 1, i - 1
     189         i0 = i0 + 1
     190         pq34(j) = pq34(j) + cmat(i0) * c34(i)
     191         pq34(i) = pq34(i) + cmat(i0) * c34(j)
     192       end do
     193       i0 = i0 + 1
     194       pq34(i) = pq34(i) + cmat(i0) * c34(i)
     195     end do
     196 end subroutine ciint
 
