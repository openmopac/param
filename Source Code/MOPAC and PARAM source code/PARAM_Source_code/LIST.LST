      54                 do ks = -l3u, l3u
      55                   do l = 1, 3
      56                     xjuc(l) = coord(l, j) + tvec(l, 1) * is_loc + tvec(
 l, &
      57                    & 2) * js + tvec(l, 3) * ks - coord(l, i)
      58                   end do
      59                   r = xjuc(1) ** 2 + xjuc(2) ** 2 + xjuc(3) ** 2
      60                   if (r < rmin) then
      61                     rmin = r
      62                     delx = xjuc(1)
      63                     dely = xjuc(2)
      64                     delz = xjuc(3)
      65                   end if
      66                 end do
      67               end do
      68             end do
      69           end if
      70           sum = 0.d0
      71           do ii = 1, io
      72             do jj = 1, jo
      73               ij = ij + 1
      74               sum = sum + p(ij) ** 2
      75               pab(ii, jj) = p(ij)
      76             end do
      77           end do
      78           if (sum >= 0.1d0) then
      79             call coe (delx, dely, delz, ipq, jpq, c, r)
      80             do i1 = 1, 4
