       1       subroutine dtrans(d, ioper, first, r)
       2 !
       3 !  Perform symmetry operation ioper on the "d" orbital set d
       4 !
       5 !  "r" holds the orientation matrix that rotates the system so that it
 is orientated
       6 !  along the principal axes
       7 !
       8       USE symmetry_C, only : nclass, elem
       9       implicit none
