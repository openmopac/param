       1       subroutine dimens(coord, iw)
       2 !
       3 !  Work out the three dimensions of a molecule.
       4 !
       5 !  Dimension 1: The largest distance between any two atoms.
       6 !  Dimension 2: The largest distance in the plane perpendicular to Dime
 nsion 1, between any two atoms.
       7 !  Dimension 3: The largest distance in the direction orthogonal to dim
 ensions 1 and 2, between any two atoms.
       8 !
       9       use molkst_C, only : numat
      10       use common_arrays_C, only : nat
      11       use elemts_C, only : elemnt
      12 !**********************************************************************
 *
      13       implicit none
      14       integer , intent(in) :: iw
      15       double precision  :: coord(3,numat)
      16 !-----------------------------------------------
      17 !   L o c a l   V a r i a b l e s
      18 !-----------------------------------------------
      19       integer , dimension(3,2) :: ij
      20       integer :: l, loop, j, k, kmax, lmax, i, kk, ll
      21       double precision, dimension(3,3) :: c
      22       double precision, dimension(3) :: dim
      23       double precision :: x1, y1, z1, rabmax, rmax, r, xy, ca, cb, sa,
 sb, ymin, &
      24         ymax, store_coords(3,numat), sum
      25 !-----------------------------------------------
      26     if (numat == 1) return
      27     store_coords(:,:numat) = coord(:,:numat)
      28     rmax = 0.d0
      29     kmax = 0
      30     lmax = 0
      31     do k = 1, numat
      32       x1 = coord(1, k)
      33       y1 = coord(2, k)
      34       z1 = coord(3, k)
      35       do l = 1, k - 1
      36         r = (x1-coord(1, l)) ** 2 + (y1-coord(2, l)) ** 2 + (z1-coord(3
 , l)) ** 2
      37         if (r > rmax) then
      38           rmax = r
      39           kmax = k
      40           lmax = l
      41         end if
      42       end do
      43     end do
      44     k = kmax
      45     l = lmax
      46    !
      47    !   Determine vector joining most distant atoms.
      48    !
      49     x1 = coord(1, k) - coord(1, l)
      50     y1 = coord(2, k) - coord(2, l)
      51     z1 = coord(3, k) - coord(3, l)
      52    !
      53    !  Rotate the system so that the most distant atoms have the same
 
 FORCHECK PC V13.5.13          DIMENS          2021-03-24 10:59:30   page:   377
 dimens.F90  /FF
 
      54    !  "Z" coordinates.
      55    !
      56     xy = x1 ** 2 + y1 ** 2
      57     r = Sqrt (xy+z1**2)
      58     xy = Sqrt (xy)
      59     if (xy < 1.d-10) then
      60       if (z1 < 0.0d0) then
      61         ca = -1.d0
      62         cb = -1.d0
      63         sa = 0.d0
      64         sb = 0.d0
      65       else if (z1 > 0.0d0) then
      66         ca = 1.d0
      67         cb = 1.d0
      68         sa = 0.d0
      69         sb = 0.d0
      70       else
      71         ca = 0.d0
      72         cb = 0.d0
      73         sa = 0.d0
      74         sb = 0.d0
      75       end if
      76     else
      77       ca = x1 / xy
      78       cb = z1 / r
      79       sa = y1 / xy
      80       sb = xy / r
      81     end if
      82     c(1, 3) = ca * cb
      83     c(1, 2) = -sa
      84     c(1, 1) = ca * sb
      85     c(2, 3) = sa * cb
      86     c(2, 2) = ca
      87     c(2, 1) = sa * sb
      88     c(3, 3) = -sb
      89     c(3, 2) = 0.d0
      90     c(3, 1) = cb
      91     call symopr (numat, coord, 1, c)
      92
      93     dim(1) = r
      94     ij(1, 1) = k
      95     ij(1, 2) = l
      96     dim_loop: do
      97      !
      98      !   The longest dimension is now "X"
      99      !   Find the most distant atom in "Y-Z" plane'
     100      !
     101       y1 = coord(2, l)
     102       z1 = coord(3, l)
     103       rabmax = 0.d0
     104       kk = 0
     105       ll = 0
     106       loop = 0
     107       do
     108         loop = loop + 1
     109         if (loop > 10) then
     110           k = kk
     111           l = ll
     112           exit
 
 FORCHECK PC V13.5.13          DIMENS          2021-03-24 10:59:30   page:   378
 dimens.F90  /FF
 
     113         else
     114          !
     115          !    Find the atom most distant from atom "L"
     116          !
     117           rmax = 0.d0
     118           do j = 1, numat
     119             r = (y1-coord(2, j)) ** 2 + (z1-coord(3, j)) ** 2
     120             if (r > rmax) then
     121               rmax = r
     122               k = j
     123             end if
     124           end do
     125          !
     126          !   Atom K is most distant from L in the Y-Z plane.
     127          !
     128           if (Abs (rmax-rabmax) < 1.d-5) exit
     129           if (rmax > rabmax) then
     130             rabmax = rmax
     131             kk = k
     132             ll = l
     133           end if
     134          !
     135          !   We don't know if RMAX is the maximum, therefore go to the
     136          !   mid-point, and repeat the test.
     137          !
     138          !   Now find the mid-point between the two atoms
     139          !
     140           y1 = 0.5d0 * (y1+coord(2, k))
     141           z1 = 0.5d0 * (z1+coord(3, k))
     142          !
     143          !    Find the atom most distant
     144          !
     145           rmax = 0.d0
     146           do j = 1, numat
     147             r = (y1-coord(2, j)) ** 2 + (z1-coord(3, j)) ** 2
     148             if (r > rmax) then
     149               rmax = r
     150               l = j
     151             end if
     152           end do
     153           y1 = coord(2, l)
     154           z1 = coord(3, l)
     155         end if
     156       end do
     157      !
     158      !   Determine vector joining most distant atoms (K and L).
     159      !
     160       y1 = coord(2, k) - coord(2, l)
     161       z1 = coord(3, k) - coord(3, l)
     162       r = Sqrt (y1**2 + z1**2 + 1.d-20)
     163       ca = y1 / r
     164       sa = z1 / r
     165      !
     166      !  Rotate system so that atoms K and L have the same Y coordinate.
     167      !
     168       do i = 1, numat
     169         sum         =  ca * coord(2, i) + sa * coord(3, i)
     170         coord(3, i) = -sa * coord(2, i) + ca * coord(3, i)
     171         coord(2, i) =  sum
 
 FORCHECK PC V13.5.13          DIMENS          2021-03-24 10:59:30   page:   379
 dimens.F90  /FF
 
     172       end do
     173       if (r > dim(1) + 1.d-10) then
     174         dim(1) = r
     175         ij(1, 1) = k
     176         ij(1, 2) = l
     177         cycle dim_loop
     178       else
     179         dim(2) = r
     180         ij(2, 1) = k
     181         ij(2, 2) = l
     182         exit dim_loop
     183       end if
     184     end do dim_loop
     185    !
     186    !   The longest dimension is now "X", the second longest dimension
     187    !   is "Y".
     188    !   Find the largest dimension in the "Z" direction
     189    !
     190     ymin = 1.d16
     191     ymax = -1.d16
     192     do i = 1, numat
     193       if (coord(3, i) > ymax) then
     194         k = i
     195         ymax = coord(3, i)
     196       end if
     197       if (coord(3, i) < ymin) then
     198         l = i
     199         ymin = coord(3, i)
     200       end if
     201     end do
     202     dim(3) = ymax - ymin
     203     ij(3, 1) = k
     204     if (k == l) then
     205       if (l == 1) then
     206         l = 2
     207       else
     208         l = 1
     209       end if
     210     end if
     211     ij(3, 2) = l
     212     write (iw, "(/,9X,A,/)") " MOLECULAR DIMENSIONS (Angstroms)"
     213     write (iw, "(9X,A)") "   Atom       Atom       Distance"
     214     write (iw, "(11X,A2,I6,3X,A2,I6,F12.5)") ((elemnt(nat(ij(j, i))), &
     215              & ij(j, i), i=1, 2), dim(j), j=1, 3)
     216     coord(:,:numat) =  store_coords(:,:numat)
     217 end subroutine dimens
 
