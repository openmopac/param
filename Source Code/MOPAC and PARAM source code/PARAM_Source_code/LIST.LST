     955 subroutine dvfill (nppa, dirvec)
     956    !*******************************************************************
 ****
     957    !
     958    !   DVFILL CALCULATES THE DIRECTION VECTORS.  THESE ARE PUT IN DIRVE
 C.
     959    !
     960    !  (THE VARIOUS SETS FORM ALMOST REGULAR POLYHEDRA WITH IH
     961    !   SYMMETRY.  A GOOD EXERCISE IS TO SKETCH THE POINTS USING,
     962    !   E.G. CHEM3D)
     963    !
     964    !*******************************************************************
 ****
     965     use chanel_C, only : iw
     966     use funcon_C, only : pi
     967     implicit none
     968     integer, intent (in) :: nppa
     969     double precision, dimension (4, nppa), intent (inout) :: dirvec
     970     integer :: i, ix, j, j1, j2, k, m, m2, na, nb, nc, nd
     971     double precision :: ar, beta, cphi, dist, dist2, h, r, sphi, sumar,
  t, &
     972    & xx, yy
     973     integer, dimension (2, 30) :: kset
     974     integer, dimension (3, 20) :: fset
     975     data kset / 1, 2, 1, 3, 1, 4, 1, 5, 1, 6, 12, 11, 12, 10, 12, 9, 12
 , 8, &
     976    & 12, 7, 2, 3, 3, 4, 4, 5, 5, 6, 6, 2, 7, 8, 8, 9, 9, 10, 10, 11, 11
 , 7, 2, &
     977    & 7, 7, 3, 3, 8, 8, 4, 4, 9, 9, 5, 5, 10, 10, 6, 6, 11, 11, 2 /
     978     data fset / 1, 2, 3, 1, 3, 4, 1, 4, 5, 1, 5, 6, 1, 6, 2, 12, 11, 10
 , 12, &
     979    & 10, 9, 12, 9, 8, 12, 8, 7, 12, 7, 11, 2, 3, 7, 3, 4, 8, 4, 5, 9, 5
 , 6, &
     980    & 10, 6, 2, 11, 7, 8, 3, 8, 9, 4, 9, 10, 5, 10, 11, 6, 11, 7, 2 /
     981     dirvec(1, 1) = -1.d0
     982     dirvec(2, 1) = 0.d0
     983     dirvec(3, 1) = 0.d0
     984     nd = 1
     985     r = Sqrt (0.8d0)
     986     h = Sqrt (0.2d0)
     987     do i = -1, 1, 2
     988       do j = 1, 5
     989         nd = nd + 1
     990         beta = 1.d0 + j * 0.4d0 * pi + (i + 1) * 0.1d0 * pi
     991         dirvec(2, nd) = r * Cos (beta)
     992         dirvec(3, nd) = r * Sin (beta)
     993         dirvec(1, nd) = i * h
     994       end do
     995     end do
     996     dirvec(1, 12) = 1.d0
     997     dirvec(2, 12) = 0.d0
     998     dirvec(3, 12) = 0.d0
     999     nd = 12
    1000     cphi = Cos (1.d0)
    1001     sphi = Sin (1.d0)
    1002     do i = 1, 12
    1003       xx = dirvec(1, i)
    1004       yy = dirvec(2, i)
 
 FORCHECK PC V13.5.13          DVFILL          2021-03-24 10:59:30   page:  1625
 cosmo.F90  /FF
 
    1005       dirvec(1, i) = cphi * xx + sphi * yy
    1006       dirvec(2, i) = -sphi * xx + cphi * yy
    1007     end do
    1008    !   NPPA = 10*3**K*M**2 + 2
    1009     m2 = (nppa - 2) / 10
    1010     m = Nint (Sqrt(m2 + 0.d0))
    1011     k = 0
    1012     if (m2 /= m*m) then
    1013       k = 1
    1014       m2 = m2 / 3
    1015       m = Nint (Sqrt(m2 + 0.d0))
    1016     end if
    1017     if (10*3**k*m**2 + 2 /= nppa) then
    1018       write (iw, *) "VALUE OF NPPA NOT ALLOWED: IT MUST BE 10*3**K*M**2
  + 2"
    1019       return
    1020     end if
    1021    ! CREATE ON EACH EDGE M - 1 NEW POINTS
    1022     do i = 1, 30
    1023       na = kset(1, i)
    1024       nb = kset(2, i)
    1025       do j = 1, m - 1
    1026         nd = nd + 1
    1027         do ix = 1, 3
    1028           dirvec(ix, nd) = dirvec(ix, na) * (m - j) + dirvec(ix, nb) *
 j
    1029         end do
    1030       end do
    1031     end do
    1032    ! CREATE POINTS WITHIN EACH TRIANGLE
    1033     do i = 1, 20
    1034       na = fset(1, i)
    1035       nb = fset(2, i)
    1036       nc = fset(3, i)
    1037       do j1 = 1, m - 1
    1038         do j2 = 1, m - j1 - 1
    1039           nd = nd + 1
    1040           do ix = 1, 3
    1041             dirvec(ix, nd) = dirvec(ix, na) * (m - j1 - j2) + dirvec(ix
 , nb) * &
    1042            & j1 + dirvec(ix, nc) * j2
    1043           end do
    1044         end do
    1045       end do
    1046       if (k /= 0) then
    1047          ! CREATE TWO ADDITIONAL SUBGRIDS
    1048         t = 1.d0 / 3
    1049         do j1 = 0, m - 1
    1050           do j2 = 0, m - j1 - 1
    1051             nd = nd + 1
    1052             do ix = 1, 3
    1053               dirvec(ix, nd) = dirvec(ix, na) * (m - j1 - j2 - 2*t) + d
 irvec(ix, &
    1054              & nb) * (j1 + t) + dirvec(ix, nc) * (j2 + t)
    1055             end do
    1056           end do
    1057         end do
    1058         t = 2.d0 / 3
    1059         do j1 = 0, m - 2
 
 FORCHECK PC V13.5.13          DVFILL          2021-03-24 10:59:30   page:  1626
 cosmo.F90  /FF
 
    1060           do j2 = 0, m - j1 - 2
    1061             nd = nd + 1
    1062             do ix = 1, 3
    1063               dirvec(ix, nd) = dirvec(ix, na) * (m - j1 - j2 - 2*t) + d
 irvec(ix, &
    1064              & nb) * (j1 + t) + dirvec(ix, nc) * (j2 + t)
    1065             end do
    1066           end do
    1067         end do
    1068       end if
    1069     end do
    1070    ! NORMALIZE ALL VECTORS
    1071     sumar = 0.d0
    1072     do i = 1, nppa
    1073       dist = 0.d0
    1074       do ix = 1, 3
    1075         dist = dist + dirvec(ix, i) ** 2
    1076       end do
    1077       dist = 1.d0 / Sqrt (dist)
    1078       dist2 = (m*dist) ** 2
    1079       do ix = 1, 3
    1080         dirvec(ix, i) = dirvec(ix, i) * dist
    1081       end do
    1082       if (i  <= 12) then
    1083         ar = 5.d0
    1084       else
    1085         ar = 6.d0 * dist2
    1086       end if
    1087       dirvec(4, i) = ar
    1088       sumar = sumar + ar
    1089     end do
    1090     sumar = 4 * pi / sumar
    1091     do i = 1, nppa
    1092       dirvec(4, i) = dirvec(4, i) * sumar
    1093     end do
    1094 end subroutine dvfill
 
