       1  subroutine init_filenames
       2     use molkst_C, only: jobnam, gui, line
       3     use chanel_C, only : output_fn, restart_fn, brillouin_fn, &
       4      & density_fn, log_fn, end_fn, archive_fn, esp_fn, ump_fn, &
       5      mep_fn, pol_fn, gpt_fn, esr_fn, input_fn, xyz_fn, syb_fn, &
       6      cosmo_fn
       7     implicit none
       8     integer :: text_length
       9     text_length = len_trim (jobnam)
      10     line = trim(jobnam)
      11     call upcase(line, len_trim(jobnam))
      12     if (text_length > 3) then
      13       if (jobnam(text_length - 3:text_length - 3) == ".") then
      14         if ((line(text_length - 3:text_length) == ".MOP") .or. &
      15             (line(text_length - 3:text_length) == ".DAT") .or. &
      16             (line(text_length - 3:text_length) == ".ARC") .or. &
      17             (line(text_length - 3:text_length) == ".PDB") .or. &
      18             (line(text_length - 3:text_length) == ".ENT") .or. &
      19             (line(text_length - 3:text_length) == ".NEW"))      &
      20         text_length = text_length - 4
      21       end if
      22     end if
      23 !
      24 !  Set up the name of the files that are related to the input file name
      25 !
      26     input_fn      = jobnam(1:text_length) // ".temp"
      27     output_fn     = jobnam(1:text_length) // ".out"
      28     restart_fn    = jobnam(1:text_length) // ".res"
      29     density_fn    = jobnam(1:text_length) // ".den"
      30     log_fn        = jobnam(1:text_length) // ".log"
      31     end_fn        = jobnam(1:text_length) // ".end"
      32     archive_fn    = jobnam(1:text_length) // ".arc"
      33     brillouin_fn  = jobnam(1:text_length) // ".brz"
      34     esp_fn        = jobnam(1:text_length) // ".esp"
      35     ump_fn        = jobnam(1:text_length) // ".ump"
      36     mep_fn        = jobnam(1:text_length) // ".mep"
      37     pol_fn        = jobnam(1:text_length) // ".pol"
      38     gpt_fn        = jobnam(1:text_length) // ".gpt"
      39     esr_fn        = jobnam(1:text_length) // ".esr"
      40     xyz_fn        = jobnam(1:text_length) // ".xyz"
      41     syb_fn        = jobnam(1:text_length) // ".syb"
      42     cosmo_fn      = jobnam(1:text_length) // ".cos"
      43     if (gui) output_fn     = "OUTPUT file"
      44   end subroutine init_filenames
 
