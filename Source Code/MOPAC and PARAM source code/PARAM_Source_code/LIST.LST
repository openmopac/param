      28       data s3, one/ 1.73205080756D0, 1.D0/
      29       r1 = r(2,1)*r(3,2) - r(3,1)*r(2,2)
      30       r2 = r(3,1)*r(1,2) - r(1,1)*r(3,2)
      31       r3 = r(1,1)*r(2,2) - r(2,1)*r(1,2)
      32       check = r1*r(1,3) + r2*r(2,3) + r3*r(3,3)
      33       right = check > 0.D0
