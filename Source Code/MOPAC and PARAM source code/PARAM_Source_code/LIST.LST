       1       subroutine supdot(s, h, g, n)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       implicit none
       6 !-----------------------------------------------
       7 !   D u m m y   A r g u m e n t s
       8 !-----------------------------------------------
       9       integer , intent(in) :: n
      10       double precision , intent(inout) :: s(*)
      11       double precision , intent(in) :: h(*)
      12       double precision , intent(in) :: g(*)
      13 !-----------------------------------------------
      14 !   L o c a l   V a r i a b l e s
      15 !-----------------------------------------------
      16       integer :: k, i, j
      17       double precision :: sum, gi
      18 !-----------------------------------------------
      19 !     (S)=(H)*(G) WITH  H  IN PACKED FORM (CANONICAL ORDER).
      20       k = 0
      21       do i = 1, n
      22         sum = 0.D0
      23         do j = 1, i
      24           sum = sum + g(j)*h(k+j)
      25         end do
      26         s(i) = sum
      27         k = k + i
      28       end do
      29       if (n == 1) return
      30       k = 1
      31       do i = 2, n
      32         gi = g(i)
      33         s(:i-1) = s(:i-1) + h(k+1:i-1+k)*gi
      34         k = k + i
      35       end do
      36       return
      37       end subroutine supdot
 
