     810             endfile (ilog)
     811             backspace (ilog)
     812           end if
     813           call to_screen(trim(line))
     814       end if
     815       if (mod(jcyc,30) == 0) then
     816         line = trim(input_fn)
     817         call add_path(line)
     818         i = len_trim(line) - 5
     819         call to_screen(line(:i))
     820       end if
     821       call to_screen("To_file: Geometry optimizing")
     822       if (tleft>sfact*cycmx .and. jcyc-icyc<maxcyc) go to 10
     823       write (iw, 460)
     824   460 format(20x,'THERE IS NOT ENOUGH TIME FOR ANOTHER CYCLE',/,30x,&
     825         'NOW GOING TO FINAL')
     826       totim = totime + seconds(1) - time0
     827       mdfp(9) = 1
     828       mdfp(5) = nscf
     829       call dfpsav (totim, xparam, gd, xlast, funct1, mdfp, xdfp)
     830       if (moperr) return
     831       iflepo = -1
     832       return
     833       end subroutine flepo
 
