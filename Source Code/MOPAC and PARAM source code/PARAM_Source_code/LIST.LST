     179           qr = 0.d0 !  This is an atom, therefore no vibrations
     180           cpr = 0.d0
     181           hr = cpr*T
     182           sr = 0.d0
     183 !   ***   NOW CALCULATE THE ROTATIONAL PARTS  (FIRST NON-LINEAR MOLECUL
 ES)
     184         else if (.not.linear) then
     185           e0 = pi/(a*b*c)
