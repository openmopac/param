    1150       ipose = iposg + 9
    1151       iposum = ipose + 9
    1152       if (iwflb == 0) then
    1153         write (iw, 10) omega
    1154    10   format(/,' +++++ BETA (STATIC) AT ',1f15.5,' EV.'/)
    1155       else if (iwflb == 2) then
    1156         write (iw, 20) omega
    1157    20   format(/,' +++++ BETA',' (ELECTROOPTIC POCKELS EFFECT) AT ',1f1
 5.5,&
    1158           ' EV.'/)
    1159       else
