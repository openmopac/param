      62         w4 = -ri(5) * x(3)
      63         e2a(2) = -w2 * tore(ni)
      64         e2a(3) = -w1 * tore(ni)
      65         e2a(4) = -w3 * tore(ni)
      66         e2a(6) = -w1 * tore(ni)
      67         e2a(7) = -w4 * tore(ni)
      68         e2a(10) = -w1 * tore(ni)
      69         if (natorb(nj) > 4) then
      70           e2a(15) = e2a(1)
      71           e2a(21) = e2a(1)
      72           e2a(28) = e2a(1)
      73           e2a(36) = e2a(1)
      74           e2a(45) = e2a(1)
      75         end if
      76         ki = 4
      77         if ( .not. direct) then
      78           w(2) = w2
      79           w(3) = w3
      80           w(4) = w4
      81         end if
      82       end if
      83 !
      84       if (si) then
      85         if (sj) then
      86           w5 = -ri(2) * x(1)
      87           w6 = -ri(2) * x(2)
      88           w7 = -ri(2) * x(3)
      89           ki = 7
      90           e1b(2) = -w5 * tore(nj)
      91           e1b(3) = -w1 * tore(nj)
      92           e1b(4) = -w6 * tore(nj)
      93           e1b(6) = -w1 * tore(nj)
      94           e1b(7) = -w7 * tore(nj)
      95           e1b(10) = -w1 * tore(nj)
