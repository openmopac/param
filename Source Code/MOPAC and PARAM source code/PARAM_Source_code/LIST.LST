     109             t = 3.0D0*vt(right) - 2.0D0*vt(center)
     110           else
     111             t = 3.0D0*vt(left) - 2.0D0*vt(center)
     112           end if
     113           s = t - tlast
     114           t = s + tlast
     115         else
     116           t = -beta/(2.0D0*alpha)
     117           s = t - tlast
     118           if (s <= 0.D0) then
