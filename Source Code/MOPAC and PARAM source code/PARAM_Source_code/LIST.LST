       1 ! RMG - subroutine added to control Reimers CI in MOPAC
       2       subroutine rci ()
       3
       4       USE chanel_C, only: iw
       5       USE reimers_C, only: beta, cc0, dd, n, nb2, nvh, nol, &
       6           ndtype, dm, x, y, z, xz, zcore, ion, ndump, gamma, &
       7           ci, tot, nbtmo, iconf, aocc, bocc, &
       8           spintr, cimatr, nstop, nconf, ic, id, dmci, &
       9           evalci, nptg, nspn, dtmp, nciout, nex, &
      10           nold, nvhd, nolc, nvhc, ncore, mrci, dbls
      11       USE molkst_C, only: norbs, keywrd, nopen, nclose
      12       USE overlaps_C, only: fact
      13
      14       implicit none
      15
      16       integer :: i, j, occ, vir, occd, vird, occc, virc, noh, nvl, &
      17                  ndoubl, nmos, nc2
      18       double precision, allocatable :: e(:)
      19       double precision, external :: reada
      20       logical :: sing
      21
      22       n = norbs
      23       nb2 = n*(n+1)/2
      24 !     ****        transform one-electron matrix in active CI space ****
      25       call ao2mo  (beta, cc0, dd, norbs, n, 1, n)
      26 !     ****        transform dipole matrices in active CI space ****
      27       j = nol
      28
      29 !     ****        get symmetry properties of gamma ****
      30       nptg = 1
      31       ion = 1
      32       call ptgrp(0)
      33       if(.not. allocated(ci)) allocate(ci(n, n))
      34
      35       call stgamm (gamma, ci)
      36
      37       if(.not. allocated(dm))     allocate(dm(nb2, 3))
      38
      39 ! Need to compute ground-state dipole to get proper dm matrix for CI
      40 ! dipoles
      41       do i = 1, nb2
      42         dd(i, 1) = dtmp(i, 1)
      43         dd(i, 2) = dtmp(i, 2)
      44       end do
      45       call dipol (x, y, z, dm)
      46
      47       call gsdip  (xz, dd, zcore, dm)
      48
      49       do i = 1, 3
      50         if (ndtype < 4) call ao2mo (dm(1, i), cc0, dd, n, n, 1, n)
      51       end do
      52
      53
      54 ! Read active space information
      55       noh = nopen
      56       nvl = nclose + 1
      57
      58
 
 FORCHECK PC V13.5.13           RCI            2021-03-24 10:59:30   page:   850
 rci.F90  /FF
 
      59       if (index(keywrd, ' MAXCI=') == 0) then
      60         nconf = 2000
      61       else
      62         nconf = nint(reada(keywrd, index(keywrd, ' MAXCI=')))
      63       end if
      64       if (index(keywrd, ' WRTCI=') == 0) then
      65         nciout = 500
      66       else
      67         nciout = nint(reada(keywrd, index(keywrd, ' WRTCI=')))
      68       end if
      69
      70 ! Single excitation active space
      71       occ = noh
      72       vir = norbs - nvl + 1
