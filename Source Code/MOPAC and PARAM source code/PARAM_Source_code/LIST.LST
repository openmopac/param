     166           write (iw, 10010) (line(n), n=1, ma)
     167           kk = 4
     168           ll = 0
     169         end if
     170 10030   format (' ',a2,1x,a2,i5,10f11.6)
     171         write (iw, 10030) itext(i), jtext(i), natom(i), (a(n), n=k, l)
 
 FORCHECK PC V13.5.13    VECPRT_FOR_MOZYME     2021-03-24 10:59:30   page:  2349
