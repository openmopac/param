     115             if (nat(ibonds(l,j)) == 6) m = m + 1
     116           end do
     117           if (m == 1) then
     118             l = inext(1)
     119             inext(1) = inext(2)
     120             inext(2) = j
     121           end if
     122
     123         end if
     124       end if
     125       call txtype (nnext, inext, types(jjj))
     126       !
     127       !  Copy current atoms into previous atoms
     128       !
     129        iprev(:ncurr) = icurr(:ncurr)
     130       !
     131       !  Copy next atoms into current atoms
     132       !
     133       icurr(:nnext) = inext(:nnext)
     134     end do
     135     return  ! go to 1020
     136 end subroutine greek
 
