     163   subroutine analyze_h_bonds
     164 !
     165 !  Using two geometries, compare the hydrogen bonds to find:
     166 !  (A) How many hydrogen bonds are the same.
     167 !  (B) Which hydrogen bonds are in the first geometry and not in the se
 cond.
     168 !  (C) Which hydrogen bonds are in the second geometry and not in the f
 irst.
     169     use molkst_C, only : numat,  P_Hbonds, numcal, geo_ref_name, geo_da
 t_name, &
     170     E_disp, E_hb, E_hh, line
     171 !
     172     use common_arrays_C, only : coord, geoa, H_energy, H_txt
     173 !
     174     use chanel_C, only : iw, job_fn
     175     implicit none
     176     double precision :: sum, E_1_disp, E_2_disp, E_1_hb, E_2_hb, E_1_hh
 , E_2_hh, sum_a
     177     integer :: set_1_P_Hbonds, set_2_P_Hbonds, i, j, k, l, n_common
     178     logical :: l_prt
     179     double precision, allocatable :: set_1_H_energy(:), set_2_H_energy(
 :)
     180     logical, allocatable :: l_used_1(:), l_used_2(:)
     181     character, allocatable :: set_1_H_txt(:)*62, set_2_H_txt(:)*62, set
 _1_H_dist(:)*5, set_2_H_dist(:)*5
     182       allocate(set_1_H_txt(numat), set_2_H_txt(numat), set_1_H_energy(n
 umat), set_2_H_energy(numat), &
     183         l_used_1(numat), l_used_2(numat), set_1_H_dist(numat), set_2_H_
 dist(numat))
     184       call l_control("PRT DISP(1.0) SILENT", len("PRT DISP(1.0) SILENT"
 ), 1)
     185       call get_H_bonds
     186       E_1_disp = E_disp
     187       E_1_hb = E_hb
     188       E_1_hh = E_hh
     189       set_1_P_Hbonds = P_Hbonds
     190       do i = 1, P_Hbonds
     191         set_1_H_txt(i) = H_txt(i)(:31)//trim(H_txt(i)(37:68))
     192         set_1_H_dist(i) = H_txt(i)(32:36)
     193       end do
     194       if (P_Hbonds > 0) set_1_H_energy(:P_Hbonds) = H_energy(:P_Hbonds)
     195       coord(:,:numat) = geoa(:,:numat)
     196       numcal = numcal + 1
     197       call get_H_bonds
     198       E_2_disp = E_disp
     199       E_2_hb = E_hb
     200       E_2_hh = E_hh
     201       set_2_P_Hbonds = P_Hbonds
     202       do i = 1, P_Hbonds
     203         set_2_H_txt(i) = H_txt(i)(:31)//trim(H_txt(i)(37:68))
     204         set_2_H_dist(i) = H_txt(i)(32:36)
     205       end do
     206       if (P_Hbonds > 0) set_2_H_energy(:P_Hbonds) = H_energy(:P_Hbonds)
     207       i = max(len_trim(geo_ref_name), len_trim(geo_dat_name))
     208       write(iw,'(//20x,a)')"Analysis of Non-Covalent Interactions"
     209 !
     210 !  How many hydrogen bonds are the same?
     211 !
 
 FORCHECK PC V13.5.13     ANALYZE_H_BONDS      2021-03-24 10:59:30   page:   363
 wrt_diffs.F90  /FF
 
     212       l_used_1 = .false.
     213       l_used_2 = .false.
     214       n_common = 0
     215       do i = 1, set_1_P_Hbonds
     216         do j = 1, set_2_P_Hbonds
     217           if (set_1_H_txt(i) == set_2_H_txt(j)) then
     218             l_used_1(i) = .true.
     219             l_used_2(j) = .true.
     220             n_common = n_common + 1
     221           end if
     222         end do
     223       end do
     224       if (trim(job_fn) == trim(geo_dat_name)) then
     225         line = "dataset"
     226       else
     227         line = "GEO_DAT"
     228       end if
     229       write(iw,'(/10x,a, f9.2, a)')"Total non-covalent energy of "//tri
 m(line)//" system: ", &
     230         E_1_disp + E_1_hb + E_1_hh, " Kcal/mol"
     231       write(iw,'(10x,a, f9.2, a)')"Total non-covalent energy of GEO_REF
  system: ", &
     232         E_2_disp + E_2_hb + E_2_hh, " Kcal/mol"
     233       sum = E_1_disp + E_1_hb + E_1_hh - E_2_disp - E_2_hb - E_2_hh
     234       write(iw,'(43x, a, f9.2, a)')"Difference: ", sum, " Kcal/mol"
     235       if (n_common > 0) write(iw,'(/10x,a, i5)')"Number of hydrogen bon
 ds common to both systems:", n_common
     236 !
     237 !  Which hydrogen bonds are in the data set but not in the reference?
     238 !
     239       j = 0
     240       l_prt = .true.
     241       do i = 1, set_1_P_Hbonds
     242         if (.not. l_used_1(i)) then
     243           j = j + 1
     244           set_1_H_txt(j) = set_1_H_txt(i)
     245           set_1_H_energy(j) = set_1_H_energy(i)
     246           set_1_H_dist(j) = set_1_H_dist(i)
     247         end if
     248       end do
     249       sum_a = 0.d0
     250       do l = 1, j
     251         k = 0
     252         sum = 10.d0
