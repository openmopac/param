      47       do j = 2, natoms
      48         if (na(j) /= 0) exit
      49       end do
      50       l_0SCF_HTML = (index(keywrd," 0SCF") /= 0 .and. index(keywrd, " H
 TML ") /= 0)
      51 !
      52 ! Force geometry to be Cartesian
      53 !
      54       call gmetry (geo, coord)
      55       geo(:,:numat) = coord(:,:numat)
      56       na(:natoms) = 0
      57       j = 0
      58       do i = 1, natoms - id
      59         if (labels(i) /= 99) then
      60           j = j + 1
      61           labels(j) = labels(i)
      62           txtatm(j) = txtatm(i)
      63         end if
      64       end do
