    2791 !  GET  UCD
    2792         call daread (us, msq, ju2rec + j34)
    2793 !  GET  USMD
    2794         call daread (usmd, msq, ju2mrc + j34)
    2795 !  GET  EPCD
    2796         call daread (eps, msq, jeprec + j34)
    2797 !
    2798 !
    2799 ! FIRST KIND
    2800 !
    2801         yy = yy + trsub(ud3,g1,us,nclose,norbs,norbs)
    2802         yy = yy - trsub(usmd,g1,ud3,nclose,norbs,norbs)
    2803         yy = yy - trsub(ud3,g1,us,norbs,nclose,norbs)
    2804         yy = yy + trsub(usmd,g1,ud3,norbs,nclose,norbs)
    2805 !
    2806 ! SECOND KIND
    2807 !
    2808         yy = yy + trsub(ud3,gs,u1,nclose,norbs,norbs)
    2809         yy = yy + trsub(u1,gs,ud3,nclose,norbs,norbs)
    2810         yy = yy - trsub(ud3,eps,u1,norbs,nclose,norbs)
    2811         yy = yy - trsub(u1,eps,ud3,norbs,nclose,norbs)
    2812 !
    2813 ! THIRD KIND
    2814 !
    2815         yy = yy + trsub(u1,gd3,us,nclose,norbs,norbs)
    2816         yy = yy - trsub(usmd,gd3,u1,nclose,norbs,norbs)
    2817         yy = yy - trsub(u1,gd3,us,norbs,nclose,norbs)
    2818         yy = yy + trsub(usmd,gd3,u1,norbs,nclose,norbs)
    2819 !
    2820         imove = imove + 1
    2821         if (imove <= 3) go to 30
    2822 !
    2823         gamma(ie) = yy
