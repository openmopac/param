      58     allocate( wk(n2elec), stat = i)
      59     j = j + i
      60   end if
      61   allocate (pold(mpack), pold2(1), pold3(1), pbold(1), pbold2(1), stat
 = i)
      62   j = j + i
      63   allocate (ncocc(noccupied+1), ncvir(nvirtual+1), nncf(noccupied+1), n
