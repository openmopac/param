     368                 coord(k,Si) = coord(k,Si) - del
     369                 dxyz(k,Si) = dxyz(k,Si) - sum
     370 !
     371 ! O
     372 !
     373                 coord(k,O) = coord(k,O) - del
     374                 sum = Si_O_H_bond_correction(coord, Si, O, H)
     375                 coord(k,O) = coord(k,O) + 2.d0*del
     376                 sum = (sum - Si_O_H_bond_correction(coord, Si, O, H))/(
