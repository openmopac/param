       1   subroutine gdisp(r0ab, rs6, alp6, c6ab, s6, s8, mxc, r2r4, rcov, rs8,
  alp8, dxyz_temp)
       2 !
       3 ! Calculates the derivative (gradient) of the D3 dispersion term,
       4 ! based on material provided by Stefan Grimme, University of Muenster,
 Germany
       5 ! v3.1 of the DFTD3 library
       6 !
       7   use common_arrays_C, only: nat, Vab
       8   use molkst_C, only : numat
       9   implicit none
      10   double precision, parameter :: k1 = 16.d0
      11   integer, parameter :: max_elem = 94, maxc = 5 ! maximum coordination
 number references per element
      12   double precision :: &
      13   c6ab(max_elem, max_elem, maxc, maxc, 3), & ! C6 for all element pairs
      14   dxyz_temp(3,numat),                      & ! Contribution to gradient
      15   rcov(max_elem),                          & ! covalent radii
      16   cn(numat),                               & ! coordination numbers of
 the atoms
      17   r0ab(max_elem, max_elem),                & ! cut  -  off radii for al
 l element pairs
      18   rs6, alp6, s6, s8, r2r4(max_elem), rs8, alp8
      19   integer :: mxc(max_elem)
      20 !
      21 !  Local variables
      22 !
      23   integer :: i, j, linij
      24   double precision :: R0, r2, damp6, damp8, c6, tmp1, tmp2, r, dc6_rest
 , rij(3), dc6iji, dc6ijj, r6, r7, t6, t8, &
      25   rcovij, expterm, dcn,x1, r42, r8, r9
      26   double precision, allocatable :: drij(:), dc6i(:)
      27   double precision, external :: distance
      28   integer, external :: lin
      29 !
      30 ! In this subroutine, array "coord" is in atomic units, not Angstroms.
      31 !
      32   i = (numat*(numat + 1))/2
      33   allocate(drij(i), dc6i(numat))
      34   call ncoord(numat, rcov, nat, cn)
      35   drij = 0.d0
      36   dc6i = 0.d0
      37   dc6_rest = 0.0d0
      38   do i = 2, numat
      39     do j = 1, i - 1
      40       r = distance(j,i)
      41       if (r < 0.1d0) cycle
      42       r2 = r**2
      43       if (r2 > 10000.d0) cycle
      44       linij = lin(i,j)
      45       r0 = r0ab(nat(j),nat(i))
      46       r42=r2r4(nat(i))*r2r4(nat(j))
      47       call get_dC6_dCNij(maxc, max_elem, c6ab, mxc(nat(i)), &
      48             mxc(nat(j)), cn(i), cn(j), nat(i), nat(j), &
      49             c6, dc6iji, dc6ijj)
      50       r6 = r2*r2*r2
      51       r7 = r6*r
      52       r8=r6*r2
 
 FORCHECK PC V13.5.13          GDISP           2021-03-24 10:59:30   page:  1092
 gdisp.F90  /FF
 
      53       r9=r8*r
      54 !
      55 !  Calculate damping functions
      56 !
      57       t6  =  (r/(rs6*R0))**( - alp6)
      58       damp6  = 1.d0/( 1.d0 + 6.d0*t6 )
      59       t8 = (r/(rs8*R0))**(-alp8)
      60           damp8 =1.d0/( 1.d0+6.d0*t8 )
      61       tmp1 = s6*6.d0*damp6*C6/r7
      62       tmp2=s8*6.d0*C6*r42*damp8/r9
      63       drij(linij) = drij(linij) - tmp1 - 4.d0*tmp2
      64       drij(linij) = drij(linij)  + tmp1*alp6*t6*damp6 +3.d0*tmp2*alp8*t
 8*damp8
      65       dc6_rest = s6/r6*damp6 +3.d0*s8*r42/r8*damp8
      66 !
      67 !     saving all f_dmp/r6*dC6(ij)/dCN(i) for each atom for later
      68 !
      69       dc6i(i) = dc6i(i) + dc6_rest*dc6iji
      70       dc6i(j) = dc6i(j) + dc6_rest*dc6ijj
      71     end do
      72   end do
      73 !
      74 ! After calculating all derivatives dE/dr_ij w.r.t. distances,
      75 ! the grad w.r.t. the coordinates is calculated dE/dr_ij * dr_ij/dxyz_i
      76 !
      77   do i = 2, numat
      78     do j = 1, i - 1
      79       linij = lin(i,j)
      80       r = distance(j,i)
      81       if (r < 0.1d0) cycle
      82       r2 = r**2
      83       rij = Vab
      84       r2 = sum(rij*rij)
      85       r = dsqrt(r2)
      86       if (r2 < 100.d0) then
      87         rcovij = rcov(nat(i)) + rcov(nat(j))
      88         expterm = exp( - k1*(rcovij/r - 1.d0))
      89         dcn =  - k1*rcovij*expterm/(r*r*(expterm + 1.d0)*(expterm + 1.d
 0))
      90       else
      91         dcn = 0.d0
      92       end if
      93       x1 = drij(linij) + dcn*(dc6i(i) + dc6i(j))
      94       dxyz_temp(:,i) = dxyz_temp(:,i) + x1*rij/r
      95       dxyz_temp(:,j) = dxyz_temp(:,j) - x1*rij/r
      96     end do
      97   end do
      98   return
      99   end subroutine gdisp
 
