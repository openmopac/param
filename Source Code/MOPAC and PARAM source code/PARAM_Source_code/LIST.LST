     153       subroutine pack_matrix(unpacked, packed, size)
     154         implicit none
     155         integer :: info
     156         integer , intent(in) :: size
     157         double precision , intent(in) :: unpacked(size, size)
     158         double precision , intent(out) :: packed(*)
     159   !-----------------------------------------------
     160   !********************************************************************
 ***
     161   !
     162   !   CONVERT UNPACKED SYMMETRIC MATRIX INTO A PACKED UPPER TRIANGLE
     163   !   (LAPACK DTRTTP CALL)
     164   !
     165   ! ARGUMENTS:-
     166   !         ON INPUT UNPACKED = UNPACKED SYMMETRIC MATRIX
     167   !                  SIZE     = DIMENSION OF MATRIX
     168   !      ON OUTPUT   PACKED   = PACKED UPPER TRIANGLE MATRIX
     169   !
     170   !********************************************************************
 ***
     171         call dtrttp( 'U', size, unpacked, size, packed, info )
     172         if (info /= 0) stop 'error in dtrttp'
     173         return
     174         end subroutine pack_matrix
 
