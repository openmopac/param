       1 module afmm_mod
       2   !
       3   !
       4   !       Adaptive multipole algorithm
       5   !       Based on the paper
       6   !       H. Cheng, L. Greengard, and V. Rokhlin
       7   !       "A fast adaptive multipole algorithm in three dimensions",
       8   !       J. Comp. Phys., 155, 468-498 (1999)
       9   !
      10   !       But use spherical harmonic addition theorem for
      11   !       Multipole -> Local transformation, no rotations
      12   !
      13   !       L1 list - modified
      14   !
      15   use chanel_C, only: iw
      16   implicit none
      17
      18   public :: afmm_ini, prepare_tesselations, set_tesselation, &
      19        & divide_box, afmm, simple_mm, get_legendre, &
      20        & count_short_ints
      21
      22   private
      23
      24   logical, parameter :: DEBUG = .false.
      25   logical, parameter :: PRINT = .false.
      26
      27   double precision, parameter ::  small = 1.d-3   ! Tolerance for
      28                                                   ! for box ident.
      29
      30   integer, parameter ::   p = 3         ! Multipole expansion level >=
 2
      31   integer, parameter :: dcmplx_kind = Kind ((1.d0, 1.d0))
      32
      33   type Box
      34      integer :: parent, level
      35      integer :: n_p, p_start
      36      integer :: n_childs, n_l1, n_l2
      37      integer :: n_up, n_down, n_north, n_south, n_east, n_west
      38      integer, dimension(8) :: childs
      39      integer, dimension(28) :: l1
      40      integer, dimension(189) :: l2
      41
      42      double precision :: x0, y0, z0
      43
      44      complex(kind=dcmplx_kind), dimension(-p:p, 0:p) :: phi, psi
      45   end type Box
      46
      47   type(Box), dimension(:), pointer :: b
      48   double precision, dimension(:), pointer :: d
      49   integer, dimension(:), pointer :: level, ind, ind1
      50
      51   integer :: nbox, nlev
      52   integer, dimension(:), allocatable :: points_index
      53
      54   double precision, dimension(-p:p, 0:p) :: pmn, y_norm, amn
      55   double precision, dimension(0:2*p) :: fact
      56
      57   type Tesselation
 
