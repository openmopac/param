    1253       subroutine write_pressure(iprt)
    1254       use common_arrays_C, only: loc, tvec, na
    1255       use molkst_C, only: nvar, pressure, line, press
    1256       use funcon_C, only: fpc_10
    1257       use common_arrays_C, only : grad, xparam, labels
    1258       implicit none
    1259       integer, intent(in) :: iprt
    1260       integer :: m, i1,i2, k, l, i, ndim
    1261       double precision :: xi
    1262       double precision, dimension (nvar) :: dsum, dsum1
    1263       double precision, external :: ddot, volume
    1264       if (iprt < 0) return
    1265         m = 0
    1266         i1 = 0
    1267         i2 = 0
    1268         ndim = 0
    1269         do i = 1, nvar
    1270           k = loc(1, i)
    1271           l = labels(k)
    1272           xi = xparam(i)
    1273           if (l == 107 .and. (m == 0 .or. k == i1)) then
    1274 !
    1275 !  Atom is a Tv
    1276 !
    1277             i1 = k
    1278             m = m + 1
    1279             dsum(m) = grad(i)
    1280             dsum1(m) = xparam(i)
    1281             if (m == 3) then
    1282               if (na(k) /= 0) then
    1283                 if (iprt == 0) then
    1284                   call to_screen("The pressure required to constrain tr
 anslation vectors")
    1285                   call to_screen("can only be calculated if Cartesian c
 oordinates are used.")
    1286                 else
    1287                   if (Abs(pressure) > 0.01d0) then
    1288                     write(iprt,'(/10x,a)')"The pressure required to con
 strain translation vectors"
    1289                     write(iprt,'(10x,a)')"can only be calculated if Car
 tesian coordinates are used."
    1290                   end if
    1291                 end if
    1292                 return
    1293               end if
    1294 !
    1295 !  Determine the scalar of the component of the gradient vector in the
    1296 !  direction of the translation vector
    1297 !
    1298               xi = ddot(3,dsum, 1,dsum1,1)
    1299 !
    1300 !  Convert this into a pressure = force per unit area
    1301 !
    1302               xi = -(4184.d0*10.d0**30)/fpc_10 * xi/volume (tvec, 3)
    1303               if (Abs(xi) < 1.d-20) cycle ! suppress printing if gradie
 nts are zero
    1304               if (i2 == 0) then
    1305                 write(line,'(a)') "          Pressure required to const
 
 FORCHECK PC V13.5.13      WRITE_PRESSURE      2021-03-24 10:59:30   page:  3878
 moldat.F90  /FF
 
 rain translation vectors"
    1306                 if (iprt == 0) then
    1307                   call to_screen(trim(line))
    1308                 else
    1309                   write(iprt,*)trim(line)
    1310                 end if
    1311                 i2 = 1
    1312               end if
    1313               xi = (xi - pressure * (4184.d0*10.d0**30)/ fpc_10)*1.d-9
    1314               ndim = ndim + 1
    1315               press(ndim) = xi
    1316               write(line,'(10x,a,i4,a,f7.2,a)')"Tv(", k,")  Pressure:",
 xi," GPa"
    1317                if (iprt == 0) then
    1318                   call to_screen(trim(line))
    1319                 else
    1320                   write(iprt,*)trim(line)
    1321                 end if
    1322               m = 0
    1323             end if
    1324           end if
    1325         end do
    1326   end subroutine write_pressure
 
