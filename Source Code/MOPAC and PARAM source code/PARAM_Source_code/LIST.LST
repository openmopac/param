       1       subroutine diag(fao, vector, nocc, eig, mdim, n)
       2       use molkst_C, only : norbs, mpack
       3       implicit none
       4       integer , intent(in) :: nocc
       5       integer , intent(in) :: mdim
       6       integer , intent(in) :: n
       7       double precision , intent(in) :: fao(mpack)
       8       double precision , intent(inout) :: vector(mdim,mdim)
       9       double precision , intent(in) :: eig(mdim)
      10 !
      11       integer :: lumo, ij, i, kk, j, k, j1, k2, m
      12       double precision, dimension(norbs) :: ws
      13       double precision ::  bigeps = 1.5d-007, tiny, sum, a, b, c, d, e,
  alpha, beta
      14       double precision, allocatable :: fmo(:)
      15 !**********************************************************************
 *
      16 !
      17 !   "FAST" DIAGONALISATION PROCEDURE.
      18 !
      19 !    ON INPUT FAO CONTAINS THE LOWER HALF TRIANGLE OF THE MATRIX TO BE
      20 !                         DIAGONALISED, PACKED.
      21 !             VECTOR  CONTAINS THE OLD EIGENVECTORS ON INPUT, THE NEW
      22 !             VECTORS ON EXITING.
      23 !             NOCC = NUMBER OF OCCUPIED MOLECULAR ORBITALS.
      24 !             EIG  = EIGENVALUES FROM AN EXACT DIAGONALISATION
      25 !             MDIM = DECLARED SIZE OF MATRIX "C".
      26 !             N = NUMBER OF ATOMIC ORBITALS IN BASIS SET
      27 !
      28 !  DIAG IS A PSEUDO-DIAGONALISATION PROCEDURE, IN THAT THE VECTORS THAT
      29 !       ARE GENERATED BY IT ARE MORE NEARLY ABLE TO BLOCK-DIAGONALISE
      30 !       THE FOCK MATRIX OVER MOLECULAR ORBITALS THAN THE STARTING
      31 !       VECTORS. IT MUST BE CONSIDERED PSEUDO FOR SEVERAL REASONS:
      32 !       (A) IT DOES NOT GENERATE EIGENVECTORS - THE SECULAR DETERMINANT
      33 !           IS NOT DIAGONALISED, ONLY THE OCCUPIED-VIRTUAL INTERSECTION
 .
      34 !       (B) MANY SMALL ELEMENTS IN THE SEC.DET. ARE IGNORED AS BEING TO
 O
      35 !           SMALL COMPARED WITH THE LARGEST ELEMENT.
      36 !       (C) WHEN ELEMENTS ARE ELIMINATED BY ROTATION, THE REST OF THE
      37 !           SEC. DET. IS ASSUMED NOT TO CHANGE, I.E. ELEMENTS CREATED
      38 !           ARE IGNORED.
      39 !       (D) THE ROTATION REQUIRED TO ELIMINATE THOSE ELEMENTS CONSIDERE
 D
      40 !           SIGNIFICANT IS APPROXIMATED TO USING THE EIGENVALUES OF THE
      41 !           EXACT DIAGONALISATION THROUGHOUT THE REST OF THE ITERATIVE
      42 !           PROCEDURE.
      43 !
      44 !  (NOTE:- IN AN ITERATIVE PROCEDURE ALL THE APPROXIMATIONS PRESENT IN
      45 !          DIAG BECOME VALID AT SELF-CONSISTENCY, SELF-CONSISTENCY IS
      46 !          NOT SLOWED DOWN BY USE OF THESE APPROXIMATIONS)
      47 !
      48 !    REFERENCE:
      49 !             "FAST SEMIEMPIRICAL CALCULATIONS",
      50 !             STEWART. J.J.P., CSASZAR, P., PULAY, P., J. COMP. CHEM.,
      51 !             3, 227, (1982)
      52 !
      53 !**********************************************************************
 
 FORCHECK PC V13.5.13           DIAG           2021-03-24 10:59:30   page:   705
 diag.F90  /FF
 
 *
      54 !
      55 !  FIRST, CONSTRUCT THAT PART OF A SECULAR DETERMINANT OVER MOLECULAR
      56 !  ORBITALS WHICH CONNECTS THE OCCUPIED AND VIRTUAL SETS.
      57 !
      58 !**********************************************************************
 *
      59 !
      60
      61
      62       allocate(fmo(mpack))
      63       tiny = 0.D0
      64       lumo = nocc + 1
      65       ij = 0
      66       do i = lumo, n
      67         kk = 0
      68         do j = 1, n
      69           sum = 0.D0
      70           do k = 1, j
      71             kk = kk + 1
      72             sum = sum + fao(kk)*vector(k,i)
      73           end do
      74           if (j /= n) then
      75             j1 = j + 1
      76             k2 = kk
      77             do k = j1, n
      78               k2 = k2 + k - 1
      79               sum = sum + fao(k2)*vector(k,i)
      80             end do
      81           end if
      82           ws(j) = sum
      83         end do
      84         do j = 1, nocc
      85           ij = ij + 1
      86           sum = 0.D0
      87           do k = 1, n
      88             sum = sum + ws(k)*vector(k,j)
      89           end do
      90           tiny = dmax1(abs(sum),tiny)
      91           fmo(ij) = sum
      92         end do
      93       end do
      94       tiny = 0.05D0*tiny
      95
      96
      97
      98 !**********************************************************************
 *
      99 !
     100 !   NOW DO A CRUDE 2 BY 2 ROTATION TO "ELIMINATE" SIGNIFICANT ELEMENTS
     101 !
     102 !**********************************************************************
 *
     103       ij = 0
     104 !      k = 0
     105
     106 !
     107       do i = lumo, n
     108         do j = 1, nocc
 
 FORCHECK PC V13.5.13           DIAG           2021-03-24 10:59:30   page:   706
 diag.F90  /FF
 
     109           ij = ij + 1
     110           if (abs(fmo(ij)) < tiny) cycle
     111 !
     112 !      BEGIN 2 X 2 ROTATIONS
     113 !
     114           a = eig(j)
     115           b = eig(i)
     116           c = fmo(ij)
     117           d = a - b
     118 !
     119 !    USE BIGEPS TO DETERMINE WHETHER TO DO A 2 BY 2 ROTATION
     120 !
     121           if (abs(c/d) < bigeps) cycle
     122 !
     123 !  AT THIS POINT WE KNOW THAT
     124           e = sign(sqrt(4.D0*c*c + d*d),d)
     125           alpha = sqrt(0.5D0*(1.D0 + d/e))
     126           beta = -sign(sqrt(1.D0 - alpha*alpha),c)
     127 !
     128 !      ROTATION OF PSEUDO-EIGENVECTORS
     129 !
     130 ! GBR test
     131 !          k = k + 1
     132 !
     133           do m = 1, n
     134             a = vector(m,j)
     135             b = vector(m,i)
     136             vector(m,j) = alpha*a + beta*b
     137             vector(m,i) = alpha*b - beta*a
     138           end do
     139           continue
     140         end do
     141       end do
     142
     143 ! GBR test
     144 !      write(iw,*) ' Number of Jacobi rotations in diag = ',k
     145 !
     146
     147       return
     148       end subroutine diag
 
