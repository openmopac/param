    1889       end do
    1890       if (dum1 > 0.1d0 .or. (dum1 > 0.003d0 .and. i < 11) .or. (precise
  .and. dum1 > 0.001d0)) then
    1891         if (prt .and. first) then
    1892           first = .false.
    1893           write(iw,'(/21x,a,//2x,a,/)')"Atoms that move a lot", &
    1894           "                   Atom Label             GEO_REF Coordinate
 s       Movement    Integral"
    1895         end if
    1896         if (prt) then
    1897           sum1 = sum1 + dum1
    1898           if (dum1 > 0.1d0) then
    1899             num = "12.2,2x"
    1900           else
    1901             num = "14.4   "
    1902           end if
    1903           if (txtatm(k) /= " ") then
    1904             if (prt) write(iw,'(8x,  4x, a, 3f8.3, f'//num//', f11.2)')
 "("//txtatm(k)(:txtmax)//")", geoa(:,k), dum1, sum1
    1905           else
    1906             if (prt) write(iw,'(1x, i5, 18x, a2, 14x, 3f8.3, f'//num//'
 , f11.2)')k, elemnt(nat(k)),  geoa(:,k), dum1, sum1
    1907           end if
    1908           move(k) = -2.d0
    1909         end if
    1910       else
    1911         exit
    1912       end if
    1913     end do
    1914     if (prt) then
    1915       do i = ires_l, ires_u
    1916         if (residue_motion(i) > 1.d-10) residue_motion(i) = residue_mot
 ion(i)/No_atoms_in_residue(i)
    1917       end do
    1918       line = " "
    1919       k = 0
    1920       do
    1921         k = k + 1
    1922         sum1 = 0.d0
    1923         j = 0
    1924         do i = ires_l, ires_u
    1925           if (residue_motion(i) > sum1) then
    1926             sum1 = residue_motion(i)
    1927             j = i
    1928           end if
    1929         end do
 
 FORCHECK PC V13.5.13         GEO_DIFF         2021-03-24 10:59:30   page:  3936
