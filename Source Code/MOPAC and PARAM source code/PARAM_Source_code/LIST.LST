       1       subroutine getdat(input, output)
       2 !-----------------------------------------------
       3 !   M o d u l e s
       4 !-----------------------------------------------
       5       use molkst_C, only : natoms, jobnam, run, ijulian, verson, backsl
 ash, &
       6       gui, line, ncomments, is_PARAM, keywrd, arc_hof_1, arc_hof_2
       7       use chanel_C, only : iw0, job_fn, input_fn, iw
       8       use common_arrays_C, only : all_comments
       9 !-----------------------------------------------
      10 !   I n t e r f a c e   B l o c k s
      11 !-----------------------------------------------
      12       implicit none
      13 !-----------------------------------------------
      14       integer, intent (in) :: input, output
      15 !-----------------------------------------------
      16 !   L o c a l   V a r i a b l e s
      17 !-----------------------------------------------
      18       integer, parameter :: from_data_set = 7
      19       integer :: i, j, io_stat, l, nlines, iargc
      20       logical :: exists, arc_file, comments = .true.
      21       character :: text*90, line1*1000, num1*1, num2*1
      22       character, allocatable :: tmp_comments(:)*120
      23       double precision, external :: reada
      24       save i
      25 !-----------------------------------------------
      26 !
      27 !**********************************************************************
 *
      28 !
      29 !   GETDAT READS IN ALL THE DATA USING CHANEL "from_data_set", AND WRIT
 ES IT
      30 !   TO SCRATCH CHANNEL "input".  THIS WAY THE ORIGINAL DATA-SET IS
      31 !   FREED UP AS SOON AS THE JOB STARTS.
      32 !********************************************************************
      33       natoms = 0
      34       call to_screen("To_file: getdat")
      35       if (gui) then
      36         jobnam = "MOPAC input"
      37         natoms = 1
      38       else
      39         if (run /= 2 .or.jobnam ==" ") then
      40           i = iargc()
      41           if (i >= run) then
      42             call getarg (run, jobnam)
      43             natoms = 1
      44             do i = len_trim(jobnam), 1, -1   !  Remove any unprintable
 characters from the end of the file-name
      45               if (ichar(jobnam(i:i)) > 39 .and. ichar(jobnam(i:i)) < 12
 6 .or. jobnam(i:i) =="'") exit
      46             end do
      47             jobnam(i + 1:) = " "
      48 !
      49 !  Replace backslash with forward-slash
      50 !
      51             do i = 1, len_trim(jobnam)
      52               if (jobnam(i:i) == backslash) jobnam(i:i) = "/"
      53             end do
 
 FORCHECK PC V13.5.13          GETDAT          2021-03-24 10:59:30   page:  1310
 getdat.F90  /FF
 
      54           else if (i == 0) then
      55             if (is_PARAM) then
      56               write(line,'(2a)')" PARAM is the parameter optimization p
 rogram for use with MOPAC"
      57               write(0,'(//10x,a,/)')trim(line)
      58               write(0,'(10x,a)')" It uses a single argument, the PARAM
 data-set"
      59               write(0,'(10x,a)')" The command to run PARAM is 'PARAM.ex
 e <data-set>.dat'"
      60              ! call web_message(0,"running_MOPAC.html")
      61               write(0,'(10x,a)')" Press (return) to continue"
      62               read(5,*, iostat=i)
      63               return
      64             else
      65               write(0,'(//10x,a,/)')" MOPAC is a semiempirical quantum
 chemistry program"
      66               write(0,'(10x,a)')" It uses a single argument, the MOPAC
 data-set"
      67               write(0,'(10x,a)')" The command to run MOPAC is 'MOPAC201
 6.exe <data-set>.mop'"
      68               call web_message(0,"running_MOPAC.html")
      69               write(0,'(10x,a)')" Press (return) to continue"
      70               read(5,*, iostat=i)
      71               return
      72             end if
      73           end if
      74         else
      75           natoms = 1
      76         end if
      77       end if
      78       if (natoms == 0) return
      79 !
      80 ! Check for the data set in the order: <file>.mop, <file>.dat, <file>
      81 !
      82       line = jobnam
      83       exists = .false.
      84       call upcase(line, len_trim(line))
      85       i = Index(line,".MOP") + Index(line,".DAT") + Index(line, ".ARC")
      86       arc_file = (Index(line, ".ARC") > 0)
      87       if (i > 0) then  ! User has supplied a suffix - use it
      88         line1 = trim(line)
      89         line = trim(jobnam)
