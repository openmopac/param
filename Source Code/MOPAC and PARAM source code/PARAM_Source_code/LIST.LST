      69 ! *** ONE-CENTER ENERGIES
      70 !
      71       k = 0
      72       do ii = 1, numat
      73         ia = nfirst(ii)
      74         ib = nlast(ii)
      75         ni = nat(ii)
      76         ea(ii,1) = 0.0D0
      77         go to (60,40,40,40,20,20,20,20,20) ib - ia + 1
      78    20   continue
      79         t = udd(ni)
      80         do j = ia + 4, ib
      81           ea(ii,1) = ea(ii,1) + p((j*(j+1))/2)*t
      82         end do
      83    40   continue
      84         t = upp(ni)
      85         do j = ia + 1, ia + 3
      86           ea(ii,1) = ea(ii,1) + p((j*(j+1))/2)*t
      87         end do
      88    60   continue
      89         ea(ii,1) = ea(ii,1) + p((ia*(ia+1))/2)*uss(ni)
      90       end do
