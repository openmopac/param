 ot(300))
      37       R = fpc_5
      38       h = fpc_6
      39       ak = fpc_7
      40       ac = fpc_8
      41       it1 = 200
      42       it2 = 400
      43       istep = 10
      44       tmpkey = trim(keywrd)
      45       i = index(tmpkey,'THERMO(') + index(tmpkey,'THERMO=(')
      46       if (i /= 0) then
