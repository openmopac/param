      93       subroutine nddo_to_point(wbits, e1bits, e2bits, enubit, r, ni, nj
 )
      94 !
      95 ! NDDO_to_point smoothly transitions the two center integrals from NDDO
  to point-charge
      96 ! as the distance increases.  This is done by steadily mixing more and
 more point-charge
      97 ! contribution as the distance increases.
      98 !
      99 !  Up to 3 Angstroms, use "exact" NDDO, beyond 3 Angstroms, use a Gauus
 ian mixture.
     100 !
     101       use molkst_C, only : l_feather
     102         implicit none
     103         double precision, dimension(45) :: e1bits, e2bits, e1bits_p = 0
 .d0, e2bits_p = 0.d0
     104         double precision, dimension(2025) :: wbits
     105         double precision, intent (inout):: r
     106         double precision, intent (inout):: enubit
     107         integer, intent (in) :: ni, nj
     108         integer :: kb
     109         double precision :: const, enubit_p, dummy
     110         double precision, dimension(2025) :: wbits_p
     111
     112         if (l_feather) then
     113           call to_point(r, dummy, const)
     114         else
     115           if (r < 3.0d0) return
     116           const = Exp (-0.025d0*(r - 3.d0)**2)
     117         end if
     118         call point (r, ni, nj, wbits_p, kb, e1bits_p, e2bits_p, enubit_
 p)
     119         wbits(1:kb) = const*wbits(1:kb) +(1.d0-const)*wbits_p(1:kb)
     120         e1bits = const*e1bits + (1.d0 - const)*e1bits_p
     121         e2bits = const*e2bits + (1.d0 - const)*e2bits_p
     122         enubit = const*enubit + (1.d0 - const)*enubit_p
     123       end subroutine nddo_to_point
 
