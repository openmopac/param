    1912   !
    1913     subroutine formt (m, wt, sy, ss, col, theta, info)
    1914       implicit none
    1915       double precision, parameter :: zero = 0.0d0
    1916       integer, intent (in) :: col, m
    1917       integer, intent (inout) :: info
    1918       double precision, intent (in) :: theta
    1919       double precision, dimension (m, m), intent (in) :: ss, sy
    1920       double precision, dimension (m, m), intent (inout) :: wt
    1921       integer :: i, j, k, k1
    1922       double precision :: ddum
    1923       intrinsic Min
    1924     !
    1925     !
    1926     !     Form the upper half of  T = theta*SS + L*D^(-1)*L',
    1927     !        store T in the upper triangle of the array wt.
    1928       do j = 1, col
    1929         wt(1, j) = theta * ss (1, j)
    1930       end do
    1931       do i = 2, col
    1932         do j = i, col
    1933           k1 = Min (i, j) - 1
    1934           ddum = zero
    1935           do k = 1, k1
    1936             ddum = ddum + sy(i, k) * sy(j, k) / sy(k, k)
    1937           end do
    1938           wt(i, j) = ddum + theta * ss (i, j)
    1939         end do
    1940       end do
    1941     !     Cholesky factorize T to J*J' with
    1942     !        J' stored in the upper triangle of wt.
    1943       call dpofa (wt, m, col, info)
    1944     !
    1945       if (info /= 0) then
    1946         info = -3
    1947       end if
    1948     !
    1949     end subroutine formt
 
