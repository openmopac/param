     302       subroutine renum (coord, na, nb, nc, ii, natoms)
     303       implicit none
     304       integer, intent (in) :: ii, natoms
     305       integer, dimension (natoms), intent (in) :: na, nb
     306       integer, dimension (natoms), intent (inout) :: nc
     307       double precision, dimension (3, natoms), intent (in) :: coord
     308       integer :: i, jj, nai, nbi
     309       double precision :: angle, rab, rmin, theta
     310       intrinsic Asin
     311  !*********************************************************************
 **
     312  !
     313  !  Renumber the NC of atom II.  On input, the angle NA(II)-NB(II)-NC(I
 I)
     314  !  is too near to 0 or 180 degrees.  Find a new atom for NC(II), so th
 at
     315  !  the angle will be acceptable (as large as possible)
     316  !*********************************************************************
 **
     317       nai = na(ii)
     318       nbi = nb(ii)
     319  !
     320  !   Theta = 45 degrees
     321  !
     322       theta = 0.7853d0
     323       jj = 0
     324       rmin = 1.d10
     325       do
     326         do i = 1, ii - 1
     327           if (i /= nai .and. i /= nbi) then
     328             call bangle (coord, nai, nbi, i, angle)
     329             if (angle > 1.5707963d0) then
     330               angle = 2.d0 * Asin (1.d0) - angle
     331             end if
     332             if (angle >= theta) then
     333              !
     334              !   Angle is OK.  Now find atom of lowest distance
     335              !
     336               rab = (coord(1, nbi)-coord(1, i)) ** 2 + (coord(2, &
     337              & nbi)-coord(2, i)) ** 2 + (coord(3, nbi)-coord(3, i)) **
 2
     338               if (rab < rmin) then
     339                 jj = i
     340                 rmin = rab
     341               end if
     342             end if
     343           end if
     344         end do
     345         if (jj /= 0) then
     346        !
     347        !  Best NC is JJ; best angle is THMIN
     348        !
     349           nc(ii) = jj
     350           exit
     351         end if
     352     !
     353     !   No atom inside the allowed angle - reduce the angle
     354     !
 
 FORCHECK PC V13.5.13          RENUM           2021-03-24 10:59:30   page:  1780
 gmetry.F90  /FF
 
     355         theta = theta * 0.5d0
     356         if (theta < 0.0174533d0) theta = 0.d0
     357       end do
     358    end subroutine renum
 
 FORCHECK PC V13.5.13          RENUM           2021-03-24 10:59:30   page:  1781
 gmetry.F90  /FF


