     397       subroutine search(xparam, alpha, sig, nvar, gmin, funct, amin, an
 ext )
     398       USE common_arrays_C, only : gmin1, gnext1
     399       use chanel_C, only : iw
     400       use molkst_C, only : numcal, keywrd
     401       implicit none
     402       integer  :: nvar
     403       double precision , intent(inout) :: alpha
     404       double precision , intent(inout) :: gmin
     405       double precision  :: funct, amin, anext
     406       double precision  :: xparam(*)
     407       double precision , intent(in) :: sig(*)
     408       integer :: looks, icalcn, i, itrys
     409       double precision, dimension(nvar) :: grad, xref, gref, xmin1
     410       double precision :: g, tiny, tolerg, gb, gstore, gminn, ta, tb, g
 a, sum, gtot
     411       logical :: debug
     412       double precision, external :: ddot
     413       save debug, g, tiny, looks, tolerg, icalcn
     414 !**********************************************************************
 *
     415 !
     416 ! SEARCH PERFORMS A LINE SEARCH FOR POWSQ. IT MINIMIZES THE NORM OF
     417 !        THE GRADIENT VECTOR IN THE DIRECTION SIG.
     418 !
     419 ! ON INPUT  XPARAM = CURRENT POINT IN NVAR DIMENSIONAL SPACE.
     420 !           ALPHA  = STEP SIZE (IN FACT ALPHA IS CALCULATED IN SEARCH).
     421 !           SIG    = SEARCH DIRECTION VECTOR.
     422 !           NVAR   = NUMBER OF PARAMETERS IN SIG (& XPARAM)
     423 !
     424 ! ON OUTPUT XPARAM = PARAMETERS OF MINIMUM.
     425 !           ALPHA  = DISTANCE TO MINIMUM.
     426 !           GMIN   = GRADIENT NORM AT MINIMUM.
     427 !**********************************************************************
 *
     428       data icalcn/ 0/
     429       if (icalcn /= numcal) then
     430         icalcn = numcal
     431 !
     432 !    TOLG   = CRITERION FOR EXIT BY RELATIVE CHANGE IN GRADIENT.
     433 !
     434         debug = index(keywrd,'LINMIN') /= 0
     435         looks = 0
     436         tiny = 0.1D0
     437         tolerg = 0.02D0
     438         g = 100.D0
     439         alpha = 0.1D0
     440       end if
     441       gref(:nvar) = gmin1(:nvar)
     442       gnext1(:nvar) = gmin1(:nvar)
     443       xmin1(:nvar) = xparam(:nvar)
     444       xref(:nvar) = xparam(:nvar)
     445       if (abs(alpha) > 0.2D0) alpha = sign(0.2D0,alpha)
     446       if (debug) then
     447         write (iw, '('' SEARCH DIRECTION VECTOR'')')
     448         write (iw, '(6F12.6)') (sig(i),i=1,nvar)
     449         write (iw, '('' INITIAL GRADIENT VECTOR'')')
     450         write (iw, '(6F12.6)') (gmin1(i),i=1,nvar)
 
 FORCHECK PC V13.5.13          SEARCH          2021-03-24 10:59:30   page:  2172
 powsq.F90  /FF
 
     451       end if
     452       gb = ddot(nvar,gmin1,1,gref,1)
     453       if (debug) write (iw, '('' GRADIENT AT START OF SEARCH:'',F16.6)'
 ) sqrt(gb)
     454       gstore = gb
     455       amin = 0.D0
     456       gminn = 1.D9
     457       ta = 0.D0
     458       tb = 0.D0
     459       ga = gb
     460       gb = 1.D9
     461       itrys = 0
     462       go to 30
     463    20 continue
     464       sum = ga/(ga - gb)
     465       itrys = itrys + 1
     466       if (abs(sum) > 3.D0) sum = sign(3.D0,sum)
     467       alpha = (tb - ta)*sum + ta
     468 !
     469 !         XPARAM IS THE GEOMETRY OF THE PREDICTED MINIMUM ALONG THE LIN
 E
     470 !
     471    30 continue
     472       xparam(:nvar) = xref(:nvar) + alpha*sig(:nvar)
     473 !
     474 !         CALCULATE GRADIENT NORM AND GRADIENTS AT THE PREDICTED MINIMU
 M
     475 !
     476    !   if (itrys == 1) then
     477         grad(:nvar) = 0.D0
     478    !   end if
     479       call compfg (xparam, .TRUE., funct, .TRUE., grad, .TRUE.)
     480       looks = looks + 1
     481 !
     482 !          G IS THE PROJECTION OF THE GRADIENT ALONG SIG.
     483 !
     484       g = ddot(nvar,gref,1,grad,1)
     485       gtot = dsqrt(ddot(nvar,grad,1,grad,1))
     486       if (debug) write (iw, &
     487       '('' LOOKS'',I3,'' ALPHA ='',F12.6,'' GRADIENT'',F12.3,  '' G  ='
 ',F16.6)') &
     488       looks, alpha, dsqrt(ddot(nvar,grad,1,grad,1)), g
     489       if (gtot < gminn) then
     490         gminn = gtot
     491         if (abs(amin - alpha) > 1.D-2) then
     492 !
     493 ! WE CAN MOVE ANEXT TO A POINT NEAR, BUT NOT TOO NEAR, AMIN, SO THAT TH
 E
     494 ! SECOND DERIVATIVESWILLBEREALISTIC(D2E/DX2=(GNEXT1-GMIN1)/(ANEXT-AMIN)
 )
     495 !
     496           anext = amin
     497           gnext1(:nvar) = gmin1(:nvar)
     498         end if
     499         amin = alpha
     500         if (gminn < gmin) then
     501           xmin1(:nvar) = xparam(:nvar)
     502           gmin1(:nvar) = grad(:nvar)
     503         else
 
 FORCHECK PC V13.5.13          SEARCH          2021-03-24 10:59:30   page:  2173
 powsq.F90  /FF
 
     504           gmin1(:nvar) = grad(:nvar)
     505         end if
     506         gmin = min(gminn,gmin)
     507       end if
     508       if (itrys > 8) go to 80
     509       if (abs(g/gstore)<tiny .or. abs(g)<tolerg) go to 80
     510       if (abs(g)<max(abs(ga),abs(gb)) .or. ga*gb>0.D0 .and. g*ga<0.D0)
 then
     511 !
     512 !   G IS AN IMPROVEMENT ON GA OR GB.
     513 !
     514         if (abs(gb) < abs(ga)) then
     515           ta = alpha
     516           ga = g
     517           go to 20
     518         else
     519           tb = alpha
     520           gb = g
     521           go to 20
     522         end if
     523       else
     524 !#         WRITE(IW,'(//10X,'' FAILED IN SEARCH, SEARCH CONTINUING'')')
     525         go to 80
     526       end if
     527    80 continue
     528       gminn = dsqrt(ddot(nvar,gmin1,1,gmin1,1))
     529       xparam(:nvar) = xmin1(:nvar)
     530       if (debug) then
     531         write (iw, '('' AT EXIT FROM SEARCH'')')
     532         write (iw, '('' XPARAM'',6F12.6)') (xparam(i),i=1,nvar)
     533         write (iw, '('' GNEXT1'',6F12.6)') (gnext1(i),i=1,nvar)
     534         write (iw, '('' GMIN1 '',6F12.6)') (gmin1(i),i=1,nvar)
     535         write (iw, '('' AMIN, ANEXT,GMIN'',4F12.6)') amin, anext, gmin
     536       end if
     537       if (gminn > gmin) then
     538         xparam(:nvar) = xref(:nvar)
     539       end if
     540       return
     541 !
     542       end subroutine search
 
