     579 !     *****************************************************************
 ********
     580
     581       subroutine beta1 (s, betao, beta)
     582
     583       use reimers_C, only : n
     584       USE molkst_C, ONLY: mpack, norbs
     585       implicit none
     586
     587       double precision ::  betao(norbs), beta(mpack), s(mpack)
     588       integer ::           i, j, nm
     589
     590 !     **** construction of the one - electron matrix ****
     591
     592       nm = 0
     593       do i = 1, n
     594         do j = 1, i
     595           nm = nm + 1
     596           if (i /= j) beta(nm) = (betao(i) + betao(j)) * s(nm) * 0.5d0
     597         end do
     598       end do
     599       return
     600
     601       end subroutine beta1
 
