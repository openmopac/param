     279       subroutine dopen(c, mdim, norbs, ndubl, nsingl, fract, sdm)
     280 !-----------------------------------------------
     281 !   M o d u l e s
     282 !-----------------------------------------------
     283       implicit none
     284 !-----------------------------------------------
     285 !   D u m m y   A r g u m e n t s
     286 !-----------------------------------------------
     287       integer , intent(in) :: mdim
     288       integer , intent(in) :: norbs
     289       integer , intent(in) :: ndubl
     290       integer , intent(in) :: nsingl
     291       double precision , intent(in) :: fract
     292       double precision , intent(in) :: c(mdim,mdim)
     293       double precision , intent(out) :: sdm((mdim*(mdim + 1))/2)
     294 !-----------------------------------------------
     295 !   L o c a l   V a r i a b l e s
     296 !-----------------------------------------------
     297       integer :: nl1, nu1, l, i, j
     298       double precision :: frac, sum1
     299 !-----------------------------------------------
     300 !**********************************************************************
     301 !
     302 !  DOPEN COMPUTES THE DENSITY MATRIX OF OPEN SHELL ROHF STATE FUNCTIONS
     303 !  FROM THE EIGENVECTOR MATRIX AND THE M.O'S OCCUPANCIES
     304 !
     305 !  INPUT:   C      = SQUARE EIGENVECTOR MATRIX C
     306 !           NORBS  = NUMBER OF ORBITALS
     307 !           NDUBL  = NUMBER OF DOUBLY OCCUPIED M.O'S (=0 IF UHF)
     308 !           NSINGL = NUMBER OF SINGLY OR FRACTIONALLY OCCUPIED M.O'S
     309 !
     310 !  EXIT:    SDM    = ROHF OPEN SHELL DENSITY MATRIX
     311 !
     312 !**********************************************************************
     313 !
     314 !  SET UP LIMITS FOR SUMS
     315 !    NL1 = BEGINNING OF ONE ELECTRON SUM
     316 !    NU1 = END OF THE SAME
     317 !
     318       frac = fract
     319       nl1 = ndubl + 1
     320       nu1 = nsingl
     321       l = 0
     322       do i = 1, norbs
     323         do j = 1, i
     324           l = l + 1
     325           sum1 = 0.D0
     326           sum1 = sum(c(i,nl1:nu1)*c(j,nl1:nu1))
     327           sdm(l) = sum1*frac
     328         end do
     329       end do
     330       return
     331       end subroutine dopen
 
 FORCHECK PC V13.5.13          DOPEN           2021-03-24 10:59:30   page:  3423
 bonds.F90  /FF


