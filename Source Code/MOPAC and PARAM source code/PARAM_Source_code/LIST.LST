     266       if (l_grad)then
     267 ! compute gradient (seems to be faster numerically than with
     268 ! longish maple code)
     269       g  =  0
     270       step  =  1.d-5
     271       do m  =  1, nhb
     272          A  =  nint(hbs(1, m))
     273          B  =  nint(hbs(2, m))
     274          H  =  nint(hbs(3, m))
     275          typa  =  hbpar(at(A))
     276          typb  =  hbpar(at(B))
     277          cab  =  0.50d0*(scalehb(typa)  +  scalehb(typb))
     278          shortcut  =  r0ab(hbpar(at(A)), hbpar(at(B)))
     279          do j  =  1, 3
     280          coord(j, A)  =  coord(j, A)  +  step
     281          call eabh(n, A, B, H, coord, shortcut, cab, er)
     282          coord(j, A)  =  coord(j, A)-step*2.
     283          call eabh(n, A, B, H, coord, shortcut, cab, el)
     284          coord(j, A)  =  coord(j, A)  +  step
     285          g(j, A)  =  g(j, A)  +  (er-el)/(2.0d0*step)
     286          end do
     287          do j  =  1, 3
     288          coord(j, B)  =  coord(j, B)  +  step
     289          call eabh(n, A, B, H, coord, shortcut, cab, er)
     290          coord(j, B)  =  coord(j, B)-step*2.
     291          call eabh(n, A, B, H, coord, shortcut, cab, el)
     292          coord(j, B)  =  coord(j, B)  +  step
     293          g(j, B)  =  g(j, B)  +  (er-el)/(2.0d0*step)
     294          end do
     295          do j  =  1, 3
     296          coord(j, H)  =  coord(j, H)  +  step
     297          call eabh(n, A, B, H, coord, shortcut, cab, er)
     298          coord(j, H)  =  coord(j, H)-step*2.
     299          call eabh(n, A, B, H, coord, shortcut, cab, el)
     300          coord(j, H)  =  coord(j, H)  +  step
     301          g(j, H)  =  g(j, H)  +  (er-el)/(2.0d0*step)
     302          end do
     303       end do
     304       end if
     305
     306       deallocate(hbs)
     307       end
 
