      58 !  create smaller, but more CPU intensive, arrays
      59 !
      60             lijbo = .false.
      61             allocate (iijj(ij_dim), ijall(ij_dim), iij(natoms), numij(n
 atoms), &
      62                & stat = i)
      63             if (i /= 0) then
      64               call mopend("There is not enough memory to create the ijb
 o-type arrays")
      65               return
      66             end if
      67             iijj(:) = 0
      68             ijall(:) = 0
      69             iij(:) = 0
      70             numij(:) = 0
      71           end if
      72         end if
      73       else
      74         lijbo = .true.
      75       end if
      76       !
      77       !   Set CUTOF values  CUTOF2 = First cutoff (NDDO-dipolar)
      78       !                     CUTOF1 = Second cutoff (dipolar-point charg
 e)
      79       !
      80
      81       cutof1 = 10.d0 ** 2
      82       if (cutofp < 100.d0) cutof1 = cutofp ** 2 + 1.d-4
      83       if (numat < 30)      cutof1 = 1.d6 + 10
      84       cutof2 = 9.9d0 ** 2
      85       if (cutofp < 100.d0) cutof2 = cutofp ** 2
      86       if (numat < 30)      cutof2 = 1.d6
      87       line = trim(keywrd)
      88       if (index(line," GEO_DAT") /= 0) then
      89         i = index(line," GEO_DAT") + 9
      90         j = index(line(i + 10:),'" ') + i + 9
      91         line(i:j) = " "
      92       end if
      93
      94       i = Index (line, " CUTOFF=")
      95       if (i /= 0) then
      96         cutof1 = reada (line, i+8)
      97         cutof2 = (cutof1 - 1.d-1)**2
      98         cutof1 = cutof1**2
      99       else
     100         i = Index (line, " CUTOF1=")
     101         if (i /= 0) cutof1 = reada (keywrd, i+8) ** 2
     102         i = Index (line, " CUTOF2=")
     103         if (i /= 0) cutof2 = reada (keywrd, i+8) ** 2
     104       end if
     105       !
     106       i = Index (line, " CUTOFS=")
     107       if (i /= 0) then
     108         cutofs = reada (line, i+8) ** 2
     109       else
 
 FORCHECK PC V13.5.13          FILLIJ          2021-03-24 10:59:30   page:  3595
