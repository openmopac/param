     325       subroutine dock (geoa, geo, dist)
     326    !*******************************************************************
 ****
     327    !
     328    !  DOCK rotates and translates the geometry in GEOA so that the root
     329    !       mean square difference between GEOA and GEO is a minimum.
     330    !
     331    !  On input  GEOA = Cartesian coordinate geometry of first system.
     332    !            GEO  = Cartesian coordinate geometry of second system.
     333    !            NUMAT= Number of atoms.
     334    !
     335    ! On output  GEOA = "best fit" Cartesian geometry of first system.
     336    !            GEO  = Unchanged
     337    !            DIST = Scalar of distance between the two systems.
     338    !
     339    !*******************************************************************
 ****
     340     use molkst_C, only : numat, id
     341     implicit none
     342     double precision, dimension (3, numat), intent (inout) :: geoa
     343     double precision, dimension (3, numat), intent (inout) :: geo
     344     double precision, intent (out) :: dist
     345     integer :: i, ir, j, jr, k, l
     346     double precision :: ca, sa, sum, summ, sum_b(3), x
     347     double precision, save :: sum_a(3) = 0.d0
     348     integer, dimension (2, 3), save :: irot
     349     logical, save :: first = .true.
     350     intrinsic Abs, Cos, Sqrt
     351     data irot / 1, 2, 1, 3, 2, 3 /
     352     if (first) then
     353       first = .false.
     354       do j = 1, numat - id
     355         sum_a(:) = sum_a(:) + geo(:,j)
     356       end do
     357       sum_a = sum_a/numat
     358     end if
     359     do j = 1, numat - id
     360         geo(:,j) = geo(:,j) - sum_a(:)
     361     end do
     362     sum_b = 0.d0
     363     do j = 1, numat - id
     364       sum_b(:) = sum_b(:) + geoa(:, j)
     365     end do
     366     sum = 0.d0
     367     sum_b = sum_b / numat
     368     do j = 1, numat - id
     369       geoa(:, j) = geoa(:, j) - sum_b(:)
     370       sum = sum + (geo(1, j)-geoa(1, j)) ** 2 + (geo(2, j)-geoa(2, j))
 ** 2 + &
     371      & (geo(3, j)-geoa(3, j)) ** 2
     372     end do
     373     do l = 3, -3, -1
     374       !
     375       !     DOCKING IS DONE IN STEPS OF 16, 4, AND 1 DEGREES AT A TIME.
     376       !
     377       ca = Cos (4.d0**(l-1)*0.0174532925199432957d0)
     378       sa = Sqrt (Abs (1.d0-ca**2))
     379       do j = 1, 3
 
 FORCHECK PC V13.5.13           DOCK           2021-03-24 10:59:30   page:  1682
 react1.F90  /FF
 
     380         ir = irot(1, j)
     381         jr = irot(2, j)
     382         do i = 1, 40
     383           summ = 0.d0
     384           do k = 1, numat
     385             x = ca * geoa(ir, k) + sa * geoa(jr, k)
     386             geoa(jr, k) = -sa * geoa(ir, k) + ca * geoa(jr, k)
     387             geoa(ir, k) = x
     388             summ = summ + (geo(1, k)-geoa(1, k)) ** 2 + &
     389                           (geo(2, k)-geoa(2, k)) ** 2 + &
     390                           (geo(3, k)-geoa(3, k)) ** 2
     391           end do
     392           if (summ > sum) then
     393             if (i > 1) go to 1000
     394             sa = -sa
     395           else
     396             sum = summ
     397           end if
     398           if (i == 1) sum = summ
     399         end do
     400         cycle
     401 1000    continue
     402         sa = -sa
     403         do k = 1, numat
     404           x = ca * geoa(ir, k) + sa * geoa(jr, k)
     405           geoa(jr, k) = -sa * geoa(ir, k) + ca * geoa(jr, k)
     406           geoa(ir, k) = x
     407         end do
     408       end do
     409     end do
     410     do j = 1, numat - id
     411       geo(:,j) = geo(:,j) + sum_a(:)
     412       geoa(:,j) = geoa(:,j) + sum_a(:)
     413     end do
     414     dist = sqrt(sum)
     415     return
     416 end subroutine dock
 
 FORCHECK PC V13.5.13           DOCK           2021-03-24 10:59:30   page:  1683
 react1.F90  /FF


