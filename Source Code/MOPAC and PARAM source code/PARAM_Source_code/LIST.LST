       1 subroutine rapid0 (loop)
       2 !
       3 !
       4     use param_global_C, only : valvar, numvar, xparamp, locvar
       5 !
       6 !
       7     implicit none
       8     integer, intent (in) :: loop
       9 !----------------------------------------------------------------
      10     integer :: i
      11     double precision :: funct1
      12 !----------------------------------------------------------------
      13   !
      14   !   DELTAS will hold the CHANGE IN VALUE of the parameters
      15   !
      16     do i = 1, numvar
      17       xparamp(i) = 0.d0
      18     end do
      19   !
      20   !  Optimize the parameters
      21   !
      22     call rapid1 (loop, xparamp, numvar, funct1)
      23   !
      24   !  Update the values of the parameters
      25   !
      26     do i = 1, numvar
      27       valvar(i) = valvar(i) - xparamp(i)
      28       if(locvar(1,i) > 3 .and. locvar(1,i) < 7) valvar(i) = max(0.05d0,
  valvar(i))
      29       call update (locvar(1, i), locvar(2, i), valvar(i), 0.d0)
      30     end do
      31 end subroutine rapid0
 
