     189             j12 = j12 + c(a, mu + k3) * c(j, mu + k2) * aa
     190
     191 !           **** terms (k1, k2|k4, k3) ****
     192             aa = c(i, mu + k1) * c(b, mu + k3) * gk
     193             k12 = k12 + c(a, mu + k2) * c(j, mu + k4) * aa
     194             j12 = j12 + c(a, mu + k4) * c(j, mu + k2) * aa
     195
     196 !           **** terms (k3, k4|k1, k2) ****
     197             aa = c(i, mu + k3) * c(b, mu + k2) * gk
