      53 !    NOTHING IS CHANGED ON EXIT.
      54 !
      55 !**********************************************************************
 *
      56 ! *** RECALCULATE THE DENSITY MATRICES IN THE UHF SCHEME
      57 !
      58       allocate (ea((numat*(numat + 1))/2,2), e((numat*(numat + 1))/2,4)
 , &
      59       ex((numat*(numat + 1))/2,3), w2(8100), stat = i)
      60       if (i /= 0) then
      61         write(iw,*)" A problem occurred during memory assignment in ENP
 ART. "
      62         call mopend("A problem occurred during memory assignment in ENP
 ART.")
