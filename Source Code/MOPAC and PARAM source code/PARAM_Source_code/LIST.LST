       1 subroutine modchg ()
       2    !*******************************************************************
 ****
       3    !
       4    !   MODGRA prints the charge due to (a) backbone residue atoms, and
       5    !   (b) all side-chain atoms in each residue.
       6    !
       7    !*******************************************************************
 ****
       8     use molkst_C, only: numat, id, maxtxt
       9     use MOZYME_C, only : nres, at_res, res_start
      10     use common_arrays_C, only : q, txtatm
      11     use chanel_C, only: iw
      12     implicit none
      13     double precision, allocatable :: work(:)
      14     logical, allocatable :: l_used(:)
      15     logical :: first = .true.
      16     character :: nam_het(600)*3, het_num(600)*4
      17     double precision :: total_charge = 0.d0, res_charge = 0.d0
      18     integer :: i, j, n_cat, n_ani, cations(50), anions(50), n_het = 0
      19    !
      20    ! ... Executable Statements ...
      21    !
      22     allocate (work(0:numat + id))
      23     call build_res_start_etc()
      24     work = 0.d0
      25     if (.not. allocated(q)) then
      26       write(iw,"(a)") "Density matrix is not available.  Run a 1SCF."
      27       return
      28     end if
      29     allocate(l_used(numat + id))
      30    !
      31    !    WORK collects charge contributions from atoms.  The negative
      32    !    addresses refer to the residue backbone, the positive addresses
      33    !    refer to the side-chain.
      34    !
      35    !    (Backbone atoms are -NH-CH-CO-)
      36    !
      37     work = 0.d0
      38     do i = 1, numat
      39       j = at_res(i)
      40       work(j) = work(j) + q(i)
      41       total_charge = total_charge + q(i)
      42       l_used(i) = (j > 0)
      43     end do
      44     write (iw,"(/9x,a,/)") " NET CHARGE ON RESIDUES"
      45     write (iw,"(a)")"      Residue         Charge  Anion or"
      46     write (iw,"(a)")"                              Cation?"
      47     n_cat = 0
      48     n_ani = 0
      49     do i = 1, nres
      50       if (res_start(i) < 1) cycle
      51       if (work(i) > 0.5d0) then
      52          write (iw, "(6x,a,SP,F13.3, a)") txtatm(res_start(i))(18:maxtx
 t), work(i), "  CATION"
      53          n_cat = min(50, n_cat + 1)
      54          cations(n_cat) = res_start(i)
      55       else if (work(i) < -0.5d0) then
 
 FORCHECK PC V13.5.13          MODCHG          2021-03-24 10:59:30   page:  2380
 modchg.F90  /FF
 
      56          write (iw, "(6x,a,F13.3, a)") txtatm(res_start(i))(18:maxtxt),
  work(i), "  ANION"
      57          n_ani = min(50, n_ani + 1)
      58          anions(n_ani) = res_start(i)
      59       else
      60         if (work(i) < 0.d0 .and. work(i) > -0.0005d0) work(i) = 0.d0
      61         if (txtatm(res_start(i))(18:20) /= "HOH" .or. abs(work(i)) > 0.
 1d0) &
      62          write (iw, "(6x,a,SP,F13.3)") txtatm(res_start(i))(18:maxtxt),
  work(i)
      63       end if
      64       res_charge = res_charge + work(i)
      65     end do
      66     work = 0.d0
      67     do i = 1, numat
      68       if (.not. l_used(i)) then
      69         do j = 1, n_het
      70           if (txtatm(i)(18:20) == nam_het(j) .and. txtatm(i)(23:26) ==
 het_num(j)) exit
      71         end do
      72         if (j > n_het) then
      73           n_het = n_het + 1
      74           if (n_het > 600) exit
      75           nam_het(j) = txtatm(i)(18:20)
      76           het_num(j) = txtatm(i)(23:26)
      77         end if
      78         work(j) = work(j) + q(i)
      79       end if
      80     end do
      81     if (n_het > 0) then
      82       do i = 1, n_het
      83         if (abs(work(i)) < 0.1d0) cycle
      84         if (first) then
      85           first = .false.
      86           write (iw,"(/6x,a,/2x,a,/)") "NET CHARGES ON HETERO-GROUPS  (
 |Charges| less than 0.1 not printed)"
      87           write (iw,"(a)")"    HETERO-GROUP      Charge "
      88           write (iw,"(a)")" "
      89         end if
      90         write (iw, "(6x,a,F14.3)") txtatm(res_start(i))(18:maxtxt), wor
 k(i)
      91       end do
      92     end if
      93     write(iw,*)
      94 !
      95 !  Print out salt bridges
      96 !
      97     if (n_cat > 0 .and. n_ani > 0) then
      98       call set_up_dentate()
      99       call find_salt_bridges(cations, anions, n_cat, n_ani)
     100     end if
     101     write(iw,'(/)')
     102     return
     103   end subroutine modchg
 
