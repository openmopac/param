    3578       double precision  :: u1x(norbs,norbs)
    3579       double precision  :: u1y(norbs,norbs)
    3580       double precision  :: u1z(norbs,norbs)
    3581       double precision  :: u2x(norbs,norbs)
    3582       double precision  :: u2y(norbs,norbs)
    3583       double precision  :: u2z(norbs,norbs)
    3584       double precision  :: g1x(norbs,norbs)
