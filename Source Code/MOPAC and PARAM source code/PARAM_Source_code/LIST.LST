     148             gamma(ib + 2, ib + 3) = gamma(ib + 1, ib + 2)
     149             gamma(ib + 1, ib + 3) = gamma(ib + 1, ib + 2)
     150           end if
     151
     152           if (nbf(i) == 9) then
     153             do j = 4, 8
     154 !             **** s - d exchange integrals ****
     155               gamma(ib + 0, ib + j) = fg(mg2sd, ia)
     156 !             **** d-d diagonal coulomb integrals ****
     157               gamma(ib + j, ib + j) = gamma(ib + j, ib + j) + 4*fg(mf2d
 d, ia) + &
 
