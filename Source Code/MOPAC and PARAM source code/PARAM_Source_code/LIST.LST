     557         write(iprt,"(2a)") " hide ADD "//trim(n_res)//";  "//l_res//" =
  FALSE; end if; ", &
     558         "if (lcenter); center {visible}; endif; if (lzoom); zoom 0; end
 if;')"" class=""auto-style5"">  "
     559         j = index(wrt_res, "^")
     560         if (j > 0) wrt_res = wrt_res(:j - 1)//wrt_res(j + 1:)
     561         if (index(wrt_res,":") /= 0) then
     562           j = index(wrt_res,":") + 1
     563           write(iprt,"(2a)")"<p class=""auto-style4"">"//wrt_res(1:1)//
 "<br>"//wrt_res(4:j - 2)//"</p> </a></TD>"
     564         else
