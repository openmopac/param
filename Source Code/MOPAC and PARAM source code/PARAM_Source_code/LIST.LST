    2117     !
    2118     !
    2119       if (task(1:5) /= "FG_LN") then
    2120        !
    2121         dtd = ddot (n, d, 1, d, 1)
    2122         dnorm = Sqrt (dtd)
    2123        !
    2124        !     Determine the maximum step length.
