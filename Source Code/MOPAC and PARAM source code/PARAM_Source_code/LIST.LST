       1 subroutine parfg (errors, ttype, nerr, loop, do_scf)
       2   !********************************************************************
 **
       3   !
       4   ! PARFG computes the values of the errors for molecule number LOOP
       5   !       using the current set of parameters.
       6   !
       7   !  On exit  ERRORS = Array of errors for reference functions
       8   !           NERR   = Number of errors in ERRORS
       9   !           TTYPE  = (text): name of the type of reference function.
      10   !
      11   !********************************************************************
 **
      12     use molkst_C, only : last, emin, escf, nclose, nopen, fract, &
      13     & nscf,  nvar, numat, rjkab1
      14     use param_global_C, only : ifiles_8, ihrefs, hofcal, refgeo, refher
 , &
      15      refder, refcer, refger, reftot, wtgeo, wthof, refhof, wtips, refip
 s, &
      16     & wtdip, refdip, wtz, refpKa, wtpKa, atom_pKa, atom_pKa_O, &
      17     spin_state, i_r, qn
      18     use parameters_C, only : uss, upp, udd, zs, tore
      19     use meci_C, only : eig, lab, ispin, nelec, labsiz
      20     use funcon_C, only : fpc_9
      21     use symmetry_C, only : namo, jndex
      22     use cosmo_C, only: useps, area
      23     use common_arrays_C, only :  nat, coord, nfirst, nlast,  uspd, &
      24     & xparam, grad, eigs, loc, p, c
      25     implicit none
      26     double precision, dimension (300), intent (out) :: errors
      27     character (len=20), dimension (300), intent (out) :: ttype
      28     integer, intent (out) :: nerr
      29     integer, intent (in) :: loop
      30     logical :: do_scf
      31     integer :: i, ndif, nopn, loop_ref, j, qn_temp(20,20), irep(20), m,
  l, k, &
      32       iloop = -10
      33     double precision :: caldip, calhof, calips, cerr, derr, gerr, herr,
  toterr, &
      34     & sum
      35     double precision, dimension (300) :: q
      36     character , dimension(10) :: tspin*8
      37     double precision, external :: parips, pardip, pargeo, meci
      38     character :: srep(1000)*4
      39     save :: ndif, nopn, loop_ref, iloop
      40     data tspin/ 'SINGLET ', 'DOUBLET ', 'TRIPLET ', 'QUARTET ', 'QUINTE
 T ', &
      41       'SEXTET  ', 'SEPTET  ', 'OCTET   ', 'NONET   ', '??????? '/
      42 !----------------------------------------------------------------------
 -
      43   !
      44   !  Need to fill USPD - this would normally be filled in MOLDAT...
      45   !
      46      call filusp (nat, nfirst, nlast, uspd)
      47   !********************************************************************
 ***
      48   !
      49   !  Compute the Function
 
 FORCHECK PC V13.5.13          PARFG           2021-03-24 10:59:30   page:  3479
 parfg.F90  /FF
 
      50   !
      51   !  set last to 3 to force MECI to calculate all roots. (Dataset must
 have
      52   !  keyword MECI in order for this to work)
      53   !
      54     last = 3
      55     emin = escf
      56     nscf=0
      57     if (do_scf) then
      58       grad(1:nvar) = 0.d0
      59       call compfg (xparam, .true., calhof, .true., grad, wtgeo > 1.d-4)
      60     else
      61       calhof = escf
      62     end if
      63     toterr = 0.d0
      64     nerr = 0
      65     gerr = 0.d0
      66 !
      67 !  wtz = 1.0 if not a solid.
      68 !  wtz = 1.0/N where N = number of stoichiometric units in cluster, if
 a solid.
      69 !
      70 !
      71     calhof = calhof*wtz
      72     if(loop /= 0) loop_ref = loop
      73   !********************************************************************
 ***
      74   !
      75   !                     Heat of Formation Error
      76   !
      77   !********************************************************************
 ***
      78     if (wthof > 1.d-8) then
      79       if(qn(loop_ref) /= 0)then
      80       if (labsiz == 11) sum = meci()
      81         call symtrz (c(1, nelec + 1), eig, 3, .TRUE.)
      82         qn_temp = 0
      83         j = 0
      84         l = 0
      85         do i = 1, lab
      86           if (i > 1) then
      87     !
      88     !  If part of a degenerate manifold, use previous quantum number
      89     !
      90             if (ispin(i) == ispin(i-1) .and. namo(i) == namo(i-1) .and.
  abs(eig(i) - eig(i - 1)) < 0.01d0) then
      91               jndex(i) = jndex(i-1)
      92               cycle
      93             end if
      94           end if
      95     !
      96     !  Find Irreducible Representation
      97     !
      98           do k = 1, j
      99             if (srep(k) == namo(i)) exit
     100           end do
     101           if (k > j) then
     102             j = j + 1
     103             srep(j) = namo(i)
 
 FORCHECK PC V13.5.13          PARFG           2021-03-24 10:59:30   page:  3480
 parfg.F90  /FF
 
     104           end if
     105   !
     106           do m = 1, l
     107             if (irep(m) == ispin(i)) exit
     108           end do
     109           if (m > l) then
     110             l = l + 1
     111             irep(l) = ispin(i)
     112           end if
     113           qn_temp(k, m) = qn_temp(k, m) + 1
     114           jndex(i) = qn_temp(k, m)
     115         end do
     116 !
     117 !  Use excited state relative energy.  First, identify desired state.
     118 !
     119         do i = 1,lab
     120           if( qn(loop_ref) /= jndex(i) ) cycle
     121           if( spin_state(loop_ref) /= ispin(i) ) cycle
     122           if( i_r(loop_ref) /= namo(i) ) cycle
     123 !
     124 !  State "i" is the one needed.
     125 !
     126            calhof = (eig(i) - eig(1))*fpc_9 + 1.d-15
     127 !
     128 !  Extra "1.d-15" to ensure that calhof is not zero
     129 !
     130           exit
     131         end do
     132         if(i > lab) then
     133           if (iloop /= loop .and. loop > 0) then
     134             write(ifiles_8,"(a,i1,a,i1,2a)") &
     135       & " Root requested not found: ", &
     136       & qn(loop_ref),",",spin_state(loop_ref),",",i_r(loop_ref)
     137             write(ifiles_8,"(/,a,/)")" Possible roots"
     138             write(ifiles_8,"(i5,2x,a,2x,a,f12.4)")(jndex(i), tspin(ispi
 n(i)), namo(i), eig(i), i = 1, lab)
     139             iloop = loop
     140           end if
     141 !
     142 !  Instead of stopping the run, set the calculated state energy to the
 observed
     143 !  state energy.  That will give rise to a zero error.  On the next cyc
 le,
     144 !  the failure should correct itself, or the user might see the error
     145 !  message and fix the problem.
     146 !
     147           calhof = refhof
     148         end if
     149       end if
     150       herr = calhof - refhof + 1.d-15 !(Ensure that the H.o.F. error is
  not exactly zero)
     151       nerr = nerr + 1
     152       errors(nerr) = herr * wthof
     153       ttype (nerr) = "HOF "
     154     else
     155       herr = 0.d0
     156     end if
     157     if (wtpKa > 1.d-8) then
     158 !
 
 FORCHECK PC V13.5.13          PARFG           2021-03-24 10:59:30   page:  3481
 parfg.F90  /FF
 
     159 !
     160 !   Use dummy atom parameters for parameters used in unconventional way
 s.
     161 !
     162 !  Here, pKa = (Charge on ionizable hydrogen)*(constant_1) + (constant_
 2)
     163       call chrge (p, q)
     164       if (useps) then
     165         if (atom_pKa_O == 0) then
     166           herr = 1.d6
     167           do i = 1, numat
     168             if (atom_pKa == i) cycle
     169             sum = (coord(1,i) - coord(1,atom_pKa))**2 + &
     170          & (coord(2,i) - coord(2,atom_pKa))**2 + &
     171          & (coord(3,i) - coord(3,atom_pKa))**2
     172             if (sum < herr) then
     173               herr = sum
     174               atom_pKa_O = i
     175             end if
     176           end do
     177         end if
     178         sum = Sqrt((coord(1,atom_pKa_O) - coord(1,atom_pKa))**2 + &
     179           &      (coord(2,atom_pKa_O) - coord(2,atom_pKa))**2 + &
     180           &      (coord(3,atom_pKa_O) - coord(3,atom_pKa))**2 )
     181     !    herr = (tore(nat(atom_pKa)) - q(atom_pKa))*uss(99) +  sum*upp(
 99) + zs(99) - refpKa
     182         herr = (tore(nat(atom_pKa)) - q(atom_pKa))*uss(99) + area*udd(9
 9) + sum*upp(99) + zs(99) - refpKa
     183     !  if (loop /= 0) write(ifiles_8,'(a,f8.4)')" Charge:", (tore(nat(a
 tom_pKa)) - q(atom_pKa))
     184       else
     185         herr = (tore(nat(atom_pKa)) - q(atom_pKa))*uss(99) + upp(99)  -
  refpKa
     186       end if
     187       nerr = nerr + 1
     188       errors(nerr) = herr * wtpKa
     189       ttype (nerr) = "pKa "
     190     end if
     191   !********************************************************************
 ***
     192   !
     193   !                     Ionization Potential Error
     194   !
     195   !********************************************************************
 ***
     196     if (wtips > 1.d-8) then
     197       i = nclose
     198       if (fract > 1.99d0) then
     199         i = nopen
     200       end if
     201       nopn = nopen - i
     202     !   CORRECTION TO I.P. OF DOUBLETS
     203       calips = parips(eigs, loop_ref)
     204       if (nopn == 1) then
     205         calips = calips + 0.5d0 * rjkab1
     206       end if
     207       if (Abs(calips) > 1.d-5) then
     208         cerr = calips - refips
     209         nerr = nerr + 1
 
 FORCHECK PC V13.5.13          PARFG           2021-03-24 10:59:30   page:  3482
 parfg.F90  /FF
 
     210         errors(nerr) = cerr * wtips
     211         ttype (nerr) = "I.P."
     212       else
     213         cerr = 0.d0
     214       end if
     215     else
     216       cerr = 0.d0
     217     end if
     218   !********************************************************************
 ***
     219   !
     220   !                       Dipole Moment Error
     221   !
     222   !********************************************************************
 ***
     223     if (wtdip > 1.d-8) then
     224       caldip = pardip(coord, nat)
     225       derr = caldip - refdip
     226       nerr = nerr + 1
     227       errors(nerr) = derr * wtdip
     228       ttype (nerr) = "DIPO"
     229     else
     230       derr = 0.d0
     231     end if
     232   !********************************************************************
 ***
     233   !
     234   !                 Geometry errors (grad)
     235   !
     236   !********************************************************************
 ***
     237     if (wtgeo > 1.d-8) then
     238       gerr = pargeo(grad, wtgeo / wtz**0.666d0, refgeo, loc, errors, nd
 if)
     239       nerr = nerr + ndif
     240       j = 0
     241       do i = 1, Min(nvar,30)
     242         if (refgeo(i) /= " ") then
     243           j = j + 1
     244           ttype (j) = "GEOM "//refgeo(i)
     245         end if
     246       end do
     247     else
     248       gerr = 0.d0
     249     end if
     250   !********************************************************************
 ***
     251       if (loop > 0) then
     252       hofcal(loop) = calhof
     253       refher = herr
     254       do i = 1, ihrefs(1, loop)
     255         refher = refher - hofcal(ihrefs(i+1, loop))
     256       end do
     257       refder = derr
     258       refcer = cerr
     259       refger = gerr
     260       reftot = toterr
     261     end if
     262 end subroutine parfg
 
